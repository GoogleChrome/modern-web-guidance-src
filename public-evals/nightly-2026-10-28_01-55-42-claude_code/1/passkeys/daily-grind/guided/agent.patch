+/**
+ * "My Account" UI controller: wires the account dialog to the passkey flows.
+ */
+import { REAUTH_MAX_AGE_MS } from './config.js';
+import { api, errorFromResponse } from './api.js';
+import {
+  PasskeyError,
+  abortConditionalSignIn,
+  getPasskeySupport,
+  reauthenticateWithPasskey,
+  registerPasskey,
+  signInWithPasskey,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+  startConditionalSignIn,
+} from './passkeys.js';
+
+// Easy JSON serialization + getClientCapabilities are Baseline newly available;
+// load the polyfill only where the native methods are missing.
+if (window.PublicKeyCredential && !PublicKeyCredential.parseRequestOptionsFromJSON) {
+  try {
+    await import('https://esm.sh/webauthn-polyfills@0.1.7');
+  } catch (err) {
+    console.warn('webauthn-polyfills failed to load:', err);
+  }
+}
+
+const $ = (id) => document.getElementById(id);
+
+const el = {
+  accountLink: $('account-link'),
+  sessionButton: $('session-button'),
+  dialog: $('account-dialog'),
+  title: $('account-title'),
+  status: $('account-status'),
+  signedOut: $('view-signed-out'),
+  signedIn: $('view-signed-in'),
+  unsupported: $('passkey-unsupported'),
+  signinForm: $('signin-form'),
+  signinEmail: $('signin-email'),
+  signupForm: $('signup-form'),
+  showSignup: $('show-signup'),
+  showSignin: $('show-signin'),
+  greetingName: $('greeting-name'),
+  profileForm: $('profile-form'),
+  profileName: $('profile-name'),
+  profileEmail: $('profile-email'),
+  addPasskey: $('add-passkey'),
+  passkeysHelp: $('passkeys-help'),
+  passkeyList: $('passkey-list'),
+  passkeyEmpty: $('passkey-empty'),
+  passkeyLastNote: $('passkey-last-note'),
+  rowTemplate: $('passkey-row-template'),
+  reauthState: $('reauth-state'),
+  verifyNow: $('verify-now'),
+  signOut: $('sign-out'),
+  renameDialog: $('rename-dialog'),
+  renameInput: $('rename-input'),
+  confirmDialog: $('confirm-dialog'),
+  confirmText: $('confirm-text'),
+  reauthDialog: $('reauth-dialog'),
+  reauthText: $('reauth-text'),
+  reauthError: $('reauth-error'),
+  reauthConfirm: $('reauth-confirm'),
+  reauthCancel: $('reauth-cancel'),
+};
+
+const state = {
+  user: null,
+  reauthAt: null,
+  credentials: [],
+  support: { supported: false, platformAuthenticator: false, conditionalGet: false },
+};
+
+/* ---------- small UI helpers ---------- */
+
+function setStatus(message, kind = 'info') {
+  el.status.textContent = message ?? '';
+  el.status.className = message ? `status status--${kind}` : 'status';
+}
+
+async function withBusy(button, task) {
+  button.disabled = true;
+  button.setAttribute('aria-busy', 'true');
+  try {
+    return await task();
+  } finally {
+    button.disabled = false;
+    button.removeAttribute('aria-busy');
+  }
+}
+
+const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const dateTimeFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+const relativeFormatter = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+function formatRelativeMinutes(timestamp) {
+  const minutes = Math.round((timestamp - Date.now()) / 60000);
+  return minutes === 0 ? 'just now' : relativeFormatter.format(minutes, 'minute');
+}
+
+/** Wait for a dialog to close and resolve with the button value that closed it ('' = dismissed). */
+function awaitDialogClose(dialog) {
+  return new Promise((resolve) => {
+    dialog.addEventListener(
+      'close',
+      () => {
+        const value = dialog.returnValue;
+        dialog.returnValue = '';
+        resolve(value);
+      },
+      { once: true },
+    );
+  });
+}
+
+function friendlyError(err, fallback) {
+  if (err instanceof PasskeyError) return err.message;
+  console.error(err);
+  return fallback;
+}
+
+/* ---------- rendering ---------- */
+
+function renderNav() {
+  el.sessionButton.textContent = state.user ? 'Logout' : 'Sign In';
+}
+
+function isReauthFresh() {
+  return Boolean(state.reauthAt) && Date.now() - state.reauthAt < REAUTH_MAX_AGE_MS;
+}
+
+function renderReauthState() {
+  if (!state.reauthAt) {
+    el.reauthState.textContent = 'Sensitive changes will ask for your passkey again.';
+    return;
+  }
+  el.reauthState.textContent = isReauthFresh()
+    ? `Identity verified ${formatRelativeMinutes(state.reauthAt)}. Sensitive changes are unlocked for a few minutes.`
+    : `Last verified ${dateTimeFormatter.format(state.reauthAt)}. Sensitive changes will ask for your passkey again.`;
+}
+
+function renderCredentials() {
+  const list = state.credentials;
+  el.passkeyList.replaceChildren();
+  el.passkeyEmpty.hidden = list.length > 0;
+  el.passkeyLastNote.hidden = list.length !== 1;
+
+  for (const cred of list) {
+    const row = el.rowTemplate.content.firstElementChild.cloneNode(true);
+    row.dataset.id = cred.id;
+
+    const icon = row.querySelector('.passkey-row__icon');
+    if (cred.providerIcon) icon.src = cred.providerIcon;
+    else icon.hidden = true;
+
+    row.querySelector('.passkey-row__name').textContent = cred.name;
+
+    const provider = row.querySelector('.passkey-row__provider');
+    if (cred.providerName && cred.providerName !== cred.name) provider.textContent = cred.providerName;
+    else provider.remove();
+
+    const created = row.querySelector('.passkey-row__created');
+    created.textContent = `Added ${dateFormatter.format(cred.registeredAt)}`;
+    created.dateTime = new Date(cred.registeredAt).toISOString();
+
+    const lastUsed = row.querySelector('.passkey-row__last-used');
+    if (cred.lastUsedAt) {
+      lastUsed.textContent = `Last used ${dateTimeFormatter.format(cred.lastUsedAt)}`;
+      lastUsed.dateTime = new Date(cred.lastUsedAt).toISOString();
+    } else {
+      lastUsed.textContent = 'Not used yet';
+    }
+
+    const deleteButton = row.querySelector('.delete');
+    deleteButton.setAttribute('aria-label', `Remove passkey ${cred.name}`);
+    if (list.length === 1) {
+      deleteButton.disabled = true;
+      deleteButton.setAttribute('aria-describedby', 'passkey-last-note');
+    }
+    row.querySelector('.rename').setAttribute('aria-label', `Rename passkey ${cred.name}`);
+    el.passkeyList.append(row);
+  }
+}
+
+async function loadCredentials() {
+  const response = await api.listCredentials();
+  if (!response.ok) {
+    if (response.status === 401) return handleSignedOut();
+    const { message } = await errorFromResponse(response, 'Could not load your passkeys.');
+    setStatus(message, 'error');
+    return;
+  }
+  state.credentials = await response.json();
+  renderCredentials();
+  // Keep the password manager's view of this account in sync with the server.
+  await signalAllAcceptedCredentials(state.user.id, state.credentials);
+}
+
+function renderSignedOutView() {
+  el.title.textContent = el.signupForm.hidden ? 'Sign in' : 'Create your account';
+  const { supported, platformAuthenticator, conditionalGet } = state.support;
+  el.unsupported.hidden = supported;
+  el.signinForm.querySelector('button[type=submit]').disabled = !supported;
+  // Creating a passkey needs a platform authenticator plus autofill support (per capability gating).
+  el.signupForm.querySelector('button[type=submit]').disabled = !(supported && platformAuthenticator && conditionalGet);
+}
+
+function renderSignedInView() {
+  el.title.textContent = 'My Account';
+  el.greetingName.textContent = state.user.displayName;
+  el.profileName.value = state.user.displayName;
+  el.profileEmail.value = state.user.name;
+  const canCreate = state.support.supported && state.support.platformAuthenticator && state.support.conditionalGet;
+  el.addPasskey.hidden = !canCreate;
+  el.passkeysHelp.textContent = canCreate
+    ? 'Passkeys let you sign in with your face, fingerprint, or device PIN. Add one on each device you use.'
+    : 'This browser cannot create passkeys. Use a device with a screen lock or a security key to add one.';
+  renderReauthState();
+}
+
+function renderView() {
+  el.signedOut.hidden = Boolean(state.user);
+  el.signedIn.hidden = !state.user;
+  if (state.user) renderSignedInView();
+  else renderSignedOutView();
+  renderNav();
+}
+
+/* ---------- session transitions ---------- */
+
+async function handleSignedIn(session, message) {
+  abortConditionalSignIn();
+  state.user = session.user;
+  state.reauthAt = session.reauthAt ?? null;
+  el.signinForm.reset();
+  el.signupForm.reset();
+  renderView();
+  setStatus(message, 'success');
+  if (!el.dialog.open) el.dialog.showModal();
+  await loadCredentials();
+}
+
+function handleSignedOut(message) {
+  state.user = null;
+  state.reauthAt = null;
+  state.credentials = [];
+  el.signupForm.hidden = true;
+  el.signinForm.hidden = false;
+  renderView();
+  if (message) setStatus(message, 'info');
+  armConditionalSignIn();
+}
+
+/** Offer saved passkeys through browser autofill while signed out. */
+function armConditionalSignIn() {
+  if (state.user) return;
+  startConditionalSignIn()
+    .then((session) => {
+      if (session) return handleSignedIn(session, `Welcome back, ${session.user.displayName}!`);
+    })
+    .catch((err) => setStatus(friendlyError(err, 'Sign-in failed. Please try again.'), 'error'));
+}
+
+/* ---------- reauthentication ---------- */
+
+/** Ask the signed-in user to confirm with a passkey. Resolves true when verified. */
+async function promptReauth(reason) {
+  el.reauthText.textContent = reason;
+  el.reauthError.textContent = '';
+  el.reauthDialog.showModal();
+  const result = await awaitDialogClose(el.reauthDialog);
+  return result === 'verified';
+}
+
+/**
+ * Run a sensitive request, verifying identity first when the last
+ * verification is stale, and again if the server still demands it.
+ * Returns the Response, or null when the user backed out.
+ */
+async function withReauth(reason, action) {
+  if (!isReauthFresh() && !(await promptReauth(reason))) return null;
+  let response = await action();
+  if (response.status === 401) {
+    const { code } = await errorFromResponse(response);
+    if (code === 'reauth_required') {
+      if (!(await promptReauth(reason))) return null;
+      response = await action();
+    } else if (code === 'unauthenticated') {
+      handleSignedOut('Your session ended. Please sign in again.');
+      return null;
+    }
+  }
+  return response;
+}
+
+el.reauthConfirm.addEventListener('click', () =>
+  withBusy(el.reauthConfirm, async () => {
+    el.reauthError.textContent = '';
+    try {
+      const result = await reauthenticateWithPasskey();
+      state.reauthAt = result.reauthAt;
+      renderReauthState();
+      el.reauthDialog.close('verified');
+    } catch (err) {
+      el.reauthError.textContent = friendlyError(err, 'Verification failed. Please try again.');
+    }
+  }),
+);
+el.reauthCancel.addEventListener('click', () => el.reauthDialog.close(''));
+
+/* ---------- signed-out actions ---------- */
+
+el.showSignup.addEventListener('click', () => {
+  el.signinForm.hidden = true;
+  el.signupForm.hidden = false;
+  setStatus('');
+  renderSignedOutView();
+  el.signupForm.elements.name.focus();
+});
+el.showSignin.addEventListener('click', () => {
+  el.signupForm.hidden = true;
+  el.signinForm.hidden = false;
+  setStatus('');
+  renderSignedOutView();
+  el.signinEmail.focus();
+});
+
+el.signinForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const button = el.signinForm.querySelector('button[type=submit]');
+  withBusy(button, async () => {
+    setStatus('');
+    try {
+      const session = await signInWithPasskey();
+      await handleSignedIn(session, `Welcome back, ${session.user.displayName}!`);
+    } catch (err) {
+      if (err instanceof PasskeyError && err.code === 'cancelled') {
+        setStatus('Sign-in cancelled. You can try again whenever you are ready.', 'info');
+      } else if (err instanceof PasskeyError && err.code === 'unknown_credential') {
+        setStatus(`${err.message} Create an account to get started.`, 'error');
+      } else {
+        setStatus(friendlyError(err, 'Sign-in failed. Please try again.'), 'error');
+      }
+      // Re-arm autofill suggestions after an explicit prompt ends without a session.
+      armConditionalSignIn();
+    }
+  });
+});
+
+el.signupForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  if (!el.signupForm.reportValidity()) return;
+  const button = el.signupForm.querySelector('button[type=submit]');
+  const details = {
+    name: el.signupForm.elements.name.value.trim(),
+    email: el.signupForm.elements.email.value.trim(),
+  };
+  withBusy(button, async () => {
+    setStatus('');
+    try {
+      const result = await registerPasskey({ flow: 'signup', details });
+      await handleSignedIn(
+        { user: result.user, reauthAt: Date.now() },
+        `Welcome to The Daily Grind, ${result.user.displayName}! Your passkey is ready for next time.`,
+      );
+    } catch (err) {
+      if (err instanceof PasskeyError && err.code === 'cancelled') {
+        setStatus('Passkey setup was cancelled, so no account was created yet.', 'info');
+      } else {
+        setStatus(friendlyError(err, 'We could not create your account. Please try again.'), 'error');
+      }
+      armConditionalSignIn();
+    }
+  });
+});
+
+/* ---------- signed-in actions ---------- */
+
+el.profileForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  if (!el.profileForm.reportValidity()) return;
+  const button = el.profileForm.querySelector('button[type=submit]');
+  const displayName = el.profileName.value.trim();
+  const name = el.profileEmail.value.trim();
+  withBusy(button, async () => {
+    setStatus('');
+    const response = await withReauth('Use your passkey to confirm these profile changes.', () =>
+      api.updateUser({ name, displayName }),
+    );
+    if (!response) return;
+    if (!response.ok) {
+      const { message } = await errorFromResponse(response, 'Could not update your profile.');
+      setStatus(message, 'error');
+      return;
+    }
+    state.user = await response.json();
+    renderSignedInView();
+    // Push the new username / display name to the passkey provider.
+    await signalCurrentUserDetails(state.user.id, state.user.name, state.user.displayName);
+    setStatus('Profile updated.', 'success');
+  });
+});
+
+el.addPasskey.addEventListener('click', () =>
+  withBusy(el.addPasskey, async () => {
+    setStatus('');
+    try {
+      const { credential } = await registerPasskey({ flow: 'manage' });
+      await loadCredentials();
+      setStatus(`Passkey saved with ${credential.name}.`, 'success');
+    } catch (err) {
+      if (err instanceof PasskeyError && err.code === 'cancelled') {
+        setStatus('Passkey creation was cancelled.', 'info');
+      } else if (err instanceof PasskeyError && err.code === 'unauthenticated') {
+        handleSignedOut('Your session ended. Please sign in again.');
+      } else {
+        setStatus(friendlyError(err, 'Could not add a passkey.'), 'error');
+      }
+    }
+  }),
+);
+
+async function renameCredential(cred) {
+  el.renameInput.value = cred.name;
+  el.renameDialog.showModal();
+  el.renameInput.select();
+  const result = await awaitDialogClose(el.renameDialog);
+  if (result !== 'save') return;
+  const newName = el.renameInput.value.trim();
+  if (!newName || newName === cred.name) return;
+  const response = await api.renameCredential(cred.id, newName);
+  if (!response.ok) {
+    const { message } = await errorFromResponse(response, 'Could not rename the passkey.');
+    setStatus(message, 'error');
+    return;
+  }
+  await loadCredentials();
+  setStatus(`Passkey renamed to “${newName}”.`, 'success');
+}
+
+async function deleteCredential(cred) {
+  el.confirmText.textContent = `“${cred.name}” will no longer sign you in. You should also delete it from your password manager.`;
+  el.confirmDialog.showModal();
+  if ((await awaitDialogClose(el.confirmDialog)) !== 'confirm') return;
+  const response = await withReauth('Use your passkey to confirm removing a passkey.', () =>
+    api.deleteCredential(cred.id),
+  );
+  if (!response) return;
+  if (!response.ok) {
+    const { message } = await errorFromResponse(response, 'Could not remove the passkey.');
+    setStatus(message, 'error');
+    return;
+  }
+  // loadCredentials() re-signals the remaining accepted credential IDs.
+  await loadCredentials();
+  setStatus('Passkey removed.', 'success');
+}
+
+el.passkeyList.addEventListener('click', (event) => {
+  const button = event.target.closest('button');
+  const row = event.target.closest('.passkey-row');
+  if (!button || !row) return;
+  const cred = state.credentials.find((c) => c.id === row.dataset.id);
+  if (!cred) return;
+  setStatus('');
+  withBusy(button, () => (button.classList.contains('rename') ? renameCredential(cred) : deleteCredential(cred)));
+});
+
+el.verifyNow.addEventListener('click', async () => {
+  setStatus('');
+  if (await promptReauth('Confirm it is really you with your passkey.')) setStatus('Thanks, your identity is verified.', 'success');
+});
+
+el.signOut.addEventListener('click', () =>
+  withBusy(el.signOut, async () => {
+    await api.logout();
+    handleSignedOut('You are signed out.');
+  }),
+);
+
+/* ---------- opening / closing the dialog ---------- */
+
+function openAccountDialog() {
+  if (el.dialog.open) return;
+  setStatus('');
+  renderView();
+  el.dialog.showModal();
+  if (state.user) loadCredentials();
+  else armConditionalSignIn();
+}
+
+el.accountLink.addEventListener('click', (event) => {
+  event.preventDefault();
+  openAccountDialog();
+});
+el.sessionButton.addEventListener('click', async () => {
+  if (!state.user) return openAccountDialog();
+  await api.logout();
+  handleSignedOut();
+  el.dialog.close();
+});
+el.dialog.addEventListener('close', () => {
+  el.dialog.returnValue = '';
+  if (location.hash === '#account') history.replaceState(null, '', location.pathname + location.search);
+});
+
+// closedby="any" is not yet supported everywhere (e.g. Safari): emulate light dismiss.
+if (!('closedBy' in HTMLDialogElement.prototype)) {
+  const outside = (e, dialog) => {
+    const r = dialog.getBoundingClientRect();
+    return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+  };
+  for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+    let pressedOutside = false;
+    dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
+    dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e, dialog)) dialog.close(); });
+  }
+}
+
+/* ---------- boot ---------- */
+
+async function init() {
+  state.support = await getPasskeySupport();
+  try {
+    const response = await api.getSession();
+    if (response.ok) {
+      const session = await response.json();
+      state.user = session.user;
+      state.reauthAt = session.reauthAt ?? null;
+    }
+  } catch (err) {
+    console.warn('Could not restore session:', err);
+  }
+  renderView();
+  if (state.user) {
+    // Sync accepted credentials with the password manager as soon as we know who is signed in.
+    loadCredentials();
+  } else {
+    armConditionalSignIn();
+  }
+  if (location.hash === '#account') openAccountDialog();
+}
+
+init();
