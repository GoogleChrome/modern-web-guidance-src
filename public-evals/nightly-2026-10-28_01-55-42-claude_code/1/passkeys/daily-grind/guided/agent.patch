@@ -0,0 +1,305 @@
+/* ===== My Account: dialog, forms, passkey list ===== */
+
+/* Nav buttons that should look like the existing links */
+nav .nav-button {
+  background: none;
+  border: 1px solid var(--accent);
+  border-radius: 4px;
+  color: white;
+  cursor: pointer;
+  font: inherit;
+  font-size: 0.9rem;
+  padding: 5px 12px;
+  transition: color 0.3s;
+}
+nav .nav-button:hover {
+  color: var(--accent);
+}
+
+/* --- Dialog shell --- */
+.account-dialog,
+.sub-dialog {
+  border: none;
+  border-radius: 12px;
+  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
+  color: var(--text);
+  padding: 0;
+  width: min(34rem, 92vw);
+  max-height: min(90dvh, 48rem);
+}
+.sub-dialog {
+  width: min(26rem, 92vw);
+}
+.account-dialog[open],
+.sub-dialog[open] {
+  display: flex;
+  flex-direction: column;
+}
+.account-dialog > *,
+.sub-dialog > * {
+  padding-inline: 1.5rem;
+}
+.account-dialog > :last-child,
+.sub-dialog > :last-child {
+  padding-block-end: 1.5rem;
+}
+
+/* MANDATORY: keep scroll gestures inside the dialog and off the page behind it */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+dialog::backdrop {
+  background: rgba(62, 39, 35, 0.55);
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+.account-dialog__header {
+  align-items: center;
+  background: var(--primary);
+  color: white;
+  display: flex;
+  justify-content: space-between;
+  padding-block: 1rem;
+}
+.account-dialog__header h2,
+.sub-dialog h2 {
+  font-size: 1.25rem;
+  margin: 0;
+}
+.sub-dialog h2 {
+  padding-block-start: 1.5rem;
+}
+.account-dialog__header form {
+  margin: 0;
+}
+.icon-button {
+  background: none;
+  border: none;
+  border-radius: 50%;
+  color: inherit;
+  cursor: pointer;
+  font-size: 1.5rem;
+  height: 2.25rem;
+  line-height: 1;
+  width: 2.25rem;
+}
+.icon-button:hover,
+.icon-button:focus-visible {
+  background: rgba(255, 255, 255, 0.15);
+}
+
+.account-dialog__body {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow-y: auto;
+  padding-block: 1rem 1.5rem;
+}
+
+/* --- Status + notices --- */
+.status {
+  border-radius: 6px;
+  font-size: 0.9rem;
+  margin: 0 0 1rem;
+  padding: 0.6rem 0.8rem;
+}
+.status:empty {
+  display: none;
+}
+.status--info {
+  background: #efebe9;
+}
+.status--success {
+  background: #e8f5e9;
+  color: #1b5e20;
+}
+.status--error {
+  background: #fdecea;
+  color: #b71c1c;
+}
+.notice {
+  background: #fff8e1;
+  border-left: 4px solid var(--accent);
+  border-radius: 4px;
+  font-size: 0.9rem;
+  margin-bottom: 1rem;
+  padding: 0.75rem 1rem;
+}
+.muted {
+  color: #6d4c41;
+  font-size: 0.9rem;
+}
+.error {
+  color: #b71c1c;
+  font-size: 0.9rem;
+  min-height: 1.4em;
+  margin: 0;
+}
+
+/* --- Forms --- */
+.account-form h3 {
+  color: var(--primary);
+  margin-bottom: 0.25rem;
+}
+.account-form p {
+  margin-bottom: 1rem;
+}
+.account-form label {
+  display: block;
+  font-size: 0.85rem;
+  font-weight: 600;
+  margin: 0.75rem 0 0.25rem;
+}
+.account-form input {
+  border: 1px solid #bcaaa4;
+  border-radius: 6px;
+  font: inherit;
+  padding: 0.6rem 0.75rem;
+  width: 100%;
+}
+.account-form input:focus-visible {
+  border-color: var(--primary);
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+.account-form input:user-invalid {
+  border-color: #b71c1c;
+}
+.account-form .btn {
+  margin-top: 1rem;
+}
+
+/* --- Buttons (extends the site's .btn) --- */
+.btn {
+  border: none;
+  cursor: pointer;
+  font: inherit;
+}
+.btn:disabled,
+.btn[aria-busy="true"] {
+  cursor: progress;
+  opacity: 0.6;
+}
+.btn--full {
+  display: block;
+  text-align: center;
+  width: 100%;
+}
+.btn--small {
+  font-size: 0.85rem;
+  padding: 6px 12px;
+}
+.btn--secondary {
+  background: var(--secondary);
+  color: var(--text);
+}
+.btn--secondary:hover {
+  background: #bcaaa4;
+}
+.btn--danger {
+  background: #c62828;
+}
+.btn--danger:hover {
+  background: #8e0000;
+}
+.link-button {
+  background: none;
+  border: none;
+  color: var(--primary);
+  cursor: pointer;
+  font: inherit;
+  padding: 0;
+  text-decoration: underline;
+}
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  justify-content: flex-end;
+  margin: 0;
+  padding-block-start: 1rem;
+}
+.actions .btn {
+  margin-top: 0;
+}
+
+/* --- Signed-in panels --- */
+.greeting {
+  font-size: 1.1rem;
+  margin-bottom: 1rem;
+}
+.panel {
+  border-top: 1px solid var(--secondary);
+  padding-block: 1rem;
+}
+.panel h3 {
+  color: var(--primary);
+  font-size: 1rem;
+  margin: 0;
+}
+.panel__header {
+  align-items: center;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  justify-content: space-between;
+}
+.panel__header .btn {
+  margin-top: 0;
+}
+
+/* --- Passkey list --- */
+.passkey-list {
+  display: grid;
+  gap: 0.75rem;
+  list-style: none;
+  margin-top: 0.75rem;
+}
+.passkey-row {
+  align-items: center;
+  background: #fff;
+  border: 1px solid var(--secondary);
+  border-radius: 8px;
+  display: grid;
+  gap: 0.75rem;
+  grid-template-columns: auto 1fr;
+  padding: 0.75rem;
+}
+.passkey-row__icon {
+  background: var(--light);
+  border-radius: 6px;
+  height: 2rem;
+  object-fit: contain;
+  width: 2rem;
+}
+.passkey-row__icon[hidden] {
+  display: none;
+}
+.passkey-row__body {
+  min-width: 0;
+}
+.passkey-row__name {
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+.passkey-row__meta {
+  color: #6d4c41;
+  font-size: 0.8rem;
+}
+.passkey-row__actions {
+  display: flex;
+  gap: 0.5rem;
+  grid-column: 1 / -1;
+  justify-content: flex-end;
+}
+.passkey-row__actions .btn {
+  margin-top: 0;
+}
+@media (min-width: 28rem) {
+  .passkey-row {
+    grid-template-columns: auto 1fr auto;
+  }
+  .passkey-row__actions {
+    grid-column: auto;
+  }
+}
