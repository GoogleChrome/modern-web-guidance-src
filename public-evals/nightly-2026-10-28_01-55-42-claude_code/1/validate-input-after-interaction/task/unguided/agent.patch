   </footer>
 
+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var message = document.getElementById('newsletter-message');
+      var fields = input.parentNode;
+      // Validation is only shown once the user has left the field (blur)
+      // or tried to submit. While they are still typing, nothing turns red.
+      var touched = false;
+
+      function isValidEmail(value) {
+        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
+      }
+
+      function setError(text) {
+        fields.classList.add('is-invalid');
+        input.setAttribute('aria-invalid', 'true');
+        message.textContent = text;
+        message.className = 'newsletter-message error';
+      }
+
+      function clearError() {
+        fields.classList.remove('is-invalid');
+        input.removeAttribute('aria-invalid');
+        if (message.classList.contains('error')) {
+          message.textContent = '';
+          message.className = 'newsletter-message';
+        }
+      }
+
+      function validate() {
+        var value = input.value.trim();
+        if (value === '') {
+          setError('Please enter your email address.');
+          return false;
+        }
+        if (!isValidEmail(value)) {
+          setError('That doesn\'t look like a valid email address.');
+          return false;
+        }
+        clearError();
+        return true;
+      }
+
+      input.addEventListener('blur', function () {
+        touched = true;
+        validate();
+      });
+
+      // Only re-check while typing if an error is already visible, so the
+      // red state clears as soon as the address becomes valid. It never
+      // appears for the first time mid-typing.
+      input.addEventListener('input', function () {
+        if (touched && fields.classList.contains('is-invalid')) {
+          validate();
+        }
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        touched = true;
+        if (!validate()) {
+          input.focus();
+          return;
+        }
+        // No backend wired up yet; show a confirmation and reset.
+        message.textContent = 'Thanks! You\'re on the list.';
+        message.className = 'newsletter-message success';
+        form.reset();
+        touched = false;
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
