+    }
+
+    .newsletter button {
+      padding: 10px 18px;
+      font: inherit;
+      border: none;
+      border-radius: 5px;
+      background: var(--primary);
+      color: white;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .newsletter button:hover {
+      background: #3e2723;
+    }
+
+    /* Error styling is applied only via the .is-invalid class, which the
+       script adds after the field has been blurred, never while typing.
+       Deliberately no :invalid selector here so the browser's own live
+       invalid state stays unstyled. */
+    .newsletter .is-invalid input[type="email"] {
+      border-color: #c62828;
+    }
+
+    .newsletter-message {
+      display: block;
+      min-height: 1.4em;
+      margin-top: 6px;
+      font-size: 0.85rem;
+      text-align: left;
+    }
+
+    .newsletter-message.error {
+      color: #c62828;
+    }
+
+    .newsletter-message.success {
+      color: #2e7d32;
+    }
   </style>
 </head>
 
 <body>
