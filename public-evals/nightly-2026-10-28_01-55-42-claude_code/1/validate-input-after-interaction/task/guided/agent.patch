+  <script>
+    // Keep aria-invalid in sync with the CSS :user-invalid state so screen
+    // readers get the error at the same moment sighted users see it.
+    (() => {
+      const input = document.getElementById('newsletter-email');
+      if (!input) return;
+
+      const syncAria = () => {
+        input.setAttribute('aria-invalid', input.matches(':user-invalid') ? 'true' : 'false');
+      };
+
+      input.addEventListener('blur', syncAria);
+      // A submit attempt counts as interaction, so :user-invalid applies then too.
+      input.addEventListener('invalid', syncAria);
+      input.addEventListener('input', () => {
+        if (input.getAttribute('aria-invalid') === 'true') syncAria();
+      });
+    })();
+  </script>
+
