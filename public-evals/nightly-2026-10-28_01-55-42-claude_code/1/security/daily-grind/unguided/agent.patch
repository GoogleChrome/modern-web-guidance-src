index 0000000..c5439e3
--- /dev/null
+++ b/test/markup.test.js
@@ -0,0 +1,63 @@
+'use strict';
+
+// Static lint of the shipped HTML/CSS. Keeps the markup compatible with the strict CSP in
+// security-headers.js so a future edit cannot silently reintroduce an inline style or script
+// that would be blocked once CSP_MODE=enforce.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { IMAGE_ORIGINS } = require('../security-headers');
+
+const ROOT = path.join(__dirname, '..');
+const html = fs.readFileSync(path.join(ROOT, 'index.html'), 'utf8');
+const css = fs.readFileSync(path.join(ROOT, 'public', 'styles.css'), 'utf8');
+const htmlNoComments = html.replace(/<!--[\s\S]*?-->/g, '');
+
+test('page contains no inline scripts or event handlers', () => {
+  assert.doesNotMatch(htmlNoComments, /<script\b/i, 'no <script> elements');
+  assert.doesNotMatch(htmlNoComments, /\son[a-z]+\s*=/i, 'no on*= handler attributes');
+  assert.doesNotMatch(htmlNoComments, /javascript:/i, 'no javascript: URLs');
+});
+
+test('page contains no inline styles (CSP style-src is self only)', () => {
+  assert.doesNotMatch(htmlNoComments, /<style\b/i, 'no <style> elements');
+  assert.doesNotMatch(htmlNoComments, /\sstyle\s*=/i, 'no style= attributes');
+  assert.match(htmlNoComments, /<link rel="stylesheet" href="\/styles\.css">/);
+});
+
+test('page has no <base>, embeds, or external links that open new windows unsafely', () => {
+  assert.doesNotMatch(htmlNoComments, /<base\b/i);
+  assert.doesNotMatch(htmlNoComments, /<(object|embed|iframe)\b/i);
+  const blank = [...htmlNoComments.matchAll(/<a\b[^>]*target="_blank"[^>]*>/gi)];
+  for (const [tag] of blank) {
+    assert.match(tag, /rel="[^"]*noopener/i, `target=_blank without noopener: ${tag}`);
+  }
+});
+
+test('all HTML links are same-origin relative paths', () => {
+  const hrefs = [...htmlNoComments.matchAll(/\b(?:href|action|src)="([^"]*)"/g)].map((m) => m[1]);
+  assert.ok(hrefs.length > 0);
+  for (const href of hrefs) {
+    assert.match(href, /^\/(?!\/)/, `unexpected non-relative URL: ${href}`);
+  }
+});
+
+test('state-changing logout is a POST form, not a GET link', () => {
+  assert.doesNotMatch(htmlNoComments, /<a\b[^>]*href="\/logout/i);
+  assert.match(htmlNoComments, /<form[^>]*method="post"[^>]*action="\/logout"/i);
+});
+
+test('every remote URL in the stylesheet is covered by the CSP img-src allowlist', () => {
+  const urls = [...css.matchAll(/url\(\s*['"]?(https?:\/\/[^'")\s]+)/gi)].map((m) => new URL(m[1]).origin);
+  assert.ok(urls.length > 0, 'expected the hero image URL');
+  for (const origin of urls) {
+    assert.ok(IMAGE_ORIGINS.includes(origin), `${origin} is not in IMAGE_ORIGINS`);
+  }
+  assert.doesNotMatch(css, /@import/i, 'no @import (would need extra style-src origins)');
+  assert.doesNotMatch(css, /expression\(|javascript:/i);
+});
+
+test('referrer policy meta tag mirrors the header value', () => {
+  assert.match(htmlNoComments, /<meta name="referrer" content="strict-origin-when-cross-origin">/);
+});
diff --git a/test/security-headers.test.js b/test/security-headers.test.js
new file mode 100644
index 0000000..1ccfd98
--- /dev/null
+++ b/test/security-headers.test.js
@@ -0,0 +1,111 @@
+'use strict';
+
+// Tests the pure policy module only; server.js is never imported, so no socket is opened.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {
+  buildSecurityHeaders,
+  normalizeCspMode,
+  requestIsHttps,
+  isSameOriginRequest,
+  CSP_REPORT_PATH,
+} = require('../security-headers');
+
+function directives(csp) {
+  return Object.fromEntries(
+    csp.split(';').map((d) => d.trim()).filter(Boolean).map((d) => {
+      const [name, ...values] = d.split(/\s+/);
+      return [name, values];
+    }),
+  );
+}
+
+test('defaults to report-only CSP so a rollout cannot break the page', () => {
+  const h = buildSecurityHeaders();
+  assert.ok(h['Content-Security-Policy-Report-Only']);
+  assert.equal(h['Content-Security-Policy'], undefined);
+});
+
+test('enforce mode sends the enforcing header only', () => {
+  const h = buildSecurityHeaders({ cspMode: 'enforce' });
+  assert.ok(h['Content-Security-Policy']);
+  assert.equal(h['Content-Security-Policy-Report-Only'], undefined);
+});
+
+test('off mode sends no CSP but keeps every other header', () => {
+  const h = buildSecurityHeaders({ cspMode: 'off' });
+  assert.equal(h['Content-Security-Policy'], undefined);
+  assert.equal(h['Content-Security-Policy-Report-Only'], undefined);
+  assert.equal(h['X-Frame-Options'], 'DENY');
+});
+
+test('unknown CSP_MODE values are rejected at startup', () => {
+  assert.throws(() => normalizeCspMode('enforcing'), /Unknown CSP_MODE/);
+  assert.equal(normalizeCspMode(undefined), 'report-only');
+  assert.equal(normalizeCspMode(' Enforce '), 'enforce');
+});
+
+test('CSP is strict: no unsafe keywords, no wildcards, scripts fully denied', () => {
+  const csp = buildSecurityHeaders({ cspMode: 'enforce' })['Content-Security-Policy'];
+  const d = directives(csp);
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|unsafe-hashes/);
+  assert.doesNotMatch(csp, /(^|\s)\*(\s|;|$)/);
+  assert.deepEqual(d['default-src'], ["'none'"]);
+  assert.equal(d['script-src'], undefined, 'script-src must fall through to default-src none');
+  assert.deepEqual(d['style-src'], ["'self'"]);
+  assert.deepEqual(d['frame-ancestors'], ["'none'"]);
+  assert.deepEqual(d['base-uri'], ["'none'"]);
+  assert.deepEqual(d['form-action'], ["'self'"]);
+  assert.deepEqual(d['object-src'], ["'none'"]);
+  assert.deepEqual(d['img-src'], ["'self'", 'https://images.unsplash.com']);
+});
+
+test('CSP reports are routed to the local collector via both mechanisms', () => {
+  const d = directives(buildSecurityHeaders()['Content-Security-Policy-Report-Only']);
+  assert.deepEqual(d['report-uri'], [CSP_REPORT_PATH]);
+  assert.deepEqual(d['report-to'], ['csp-endpoint']);
+  assert.equal(buildSecurityHeaders()['Reporting-Endpoints'], `csp-endpoint="${CSP_REPORT_PATH}"`);
+});
+
+test('HTTPS-only directives are gated on actually being served over TLS', () => {
+  const plain = buildSecurityHeaders({ cspMode: 'enforce' });
+  assert.equal(plain['Strict-Transport-Security'], undefined);
+  assert.doesNotMatch(plain['Content-Security-Policy'], /upgrade-insecure-requests/);
+
+  const tls = buildSecurityHeaders({ cspMode: 'enforce', https: true });
+  assert.equal(tls['Strict-Transport-Security'], 'max-age=31536000; includeSubDomains');
+  assert.match(tls['Content-Security-Policy'], /upgrade-insecure-requests/);
+  assert.doesNotMatch(tls['Strict-Transport-Security'], /preload/);
+});
+
+test('baseline hardening headers are always present', () => {
+  const h = buildSecurityHeaders();
+  assert.equal(h['X-Content-Type-Options'], 'nosniff');
+  assert.equal(h['X-Frame-Options'], 'DENY');
+  assert.equal(h['X-XSS-Protection'], '0');
+  assert.equal(h['Referrer-Policy'], 'strict-origin-when-cross-origin');
+  assert.equal(h['Cross-Origin-Opener-Policy'], 'same-origin');
+  assert.equal(h['Cross-Origin-Resource-Policy'], 'same-origin');
+  assert.match(h['Permissions-Policy'], /camera=\(\)/);
+  assert.match(h['Permissions-Policy'], /geolocation=\(\)/);
+});
+
+test('X-Forwarded-Proto is only trusted when TRUST_PROXY is set', () => {
+  const req = { headers: { 'x-forwarded-proto': 'https' }, socket: {} };
+  assert.equal(requestIsHttps(req), false);
+  assert.equal(requestIsHttps(req, { trustProxy: true }), true);
+  assert.equal(requestIsHttps({ headers: {}, socket: { encrypted: true } }), true);
+  assert.equal(requestIsHttps({ headers: { 'x-forwarded-proto': 'http, https' }, socket: {} }, { trustProxy: true }), false);
+});
+
+test('same-origin check rejects cross-site POSTs and accepts same-origin ones', () => {
+  const host = 'dailygrind.example';
+  assert.equal(isSameOriginRequest({ headers: { host, 'sec-fetch-site': 'same-origin', origin: `https://${host}` } }), true);
+  assert.equal(isSameOriginRequest({ headers: { host, 'sec-fetch-site': 'none' } }), true);
+  assert.equal(isSameOriginRequest({ headers: { host } }), true, 'legacy clients without either header are allowed');
+  assert.equal(isSameOriginRequest({ headers: { host, 'sec-fetch-site': 'cross-site', origin: 'https://evil.example' } }), false);
+  assert.equal(isSameOriginRequest({ headers: { host, 'sec-fetch-site': 'same-site' } }), false);
+  assert.equal(isSameOriginRequest({ headers: { host, origin: 'https://evil.example' } }), false);
+  assert.equal(isSameOriginRequest({ headers: { host, origin: 'null' } }), false);
+  assert.equal(isSameOriginRequest({ headers: { host, origin: 'not a url' } }), false);
+});
