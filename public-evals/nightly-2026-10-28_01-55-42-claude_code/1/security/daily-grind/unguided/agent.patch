new file mode 100644
index 0000000..dd7fcab
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,166 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  align-items: center;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+/* Logout is a POST form so it cannot be triggered by a cross-site GET link. */
+.logout-form {
+  display: inline;
+}
+
+.logout-link {
+  background: none;
+  border: 1px solid var(--accent);
+  color: white;
+  padding: 5px 12px;
+  border-radius: 4px;
+  font: inherit;
+  font-size: 0.9rem;
+  cursor: pointer;
+  transition: color 0.3s;
+}
+
+.logout-link:hover {
+  color: var(--accent);
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
diff --git a/security-headers.js b/security-headers.js
new file mode 100644
index 0000000..4350a92
--- /dev/null
+++ b/security-headers.js
@@ -0,0 +1,175 @@
+'use strict';
+
+/**
+ * Security policy for The Daily Grind.
+ *
+ * This module is deliberately free of side effects (no server, no I/O) so it can be
+ * unit-tested and reviewed without starting the application.
+ *
+ * Rollout model for Content-Security-Policy:
+ *   1. CSP_MODE=report-only (default): browsers evaluate the policy and POST violation
+ *      reports to /csp-report, but nothing is blocked. Watch the server logs.
+ *   2. CSP_MODE=enforce: once the logs are quiet, switch to the enforcing header.
+ *   3. CSP_MODE=off: emergency escape hatch; sends no CSP header at all.
+ */
+
+const CSP_REPORT_PATH = '/csp-report';
+const CSP_REPORT_GROUP = 'csp-endpoint';
+
+// Origins the page legitimately loads sub-resources from. Keep this list short and
+// explicit; every entry widens the policy.
+const IMAGE_ORIGINS = ['https://images.unsplash.com'];
+
+/**
+ * Directive list for the page. The site has no client-side JavaScript, so scripts are
+ * disallowed entirely via default-src 'none' (no script-src is needed; nothing falls
+ * through). Styles are served from /styles.css so style-src can be 'self' with no
+ * 'unsafe-inline' and no hashes to keep in sync.
+ */
+function cspDirectives({ https = false } = {}) {
+  const directives = [
+    ["default-src", ["'none'"]],
+    ["base-uri", ["'none'"]],
+    ["form-action", ["'self'"]],
+    ["frame-ancestors", ["'none'"]],
+    ["object-src", ["'none'"]],
+    ["img-src", ["'self'", ...IMAGE_ORIGINS]],
+    ["style-src", ["'self'"]],
+    ["font-src", ["'self'"]],
+    ["manifest-src", ["'self'"]],
+    // report-to is the modern mechanism; report-uri is deprecated but still the only
+    // one honoured by some browsers and over plain HTTP, so send both.
+    ["report-to", [CSP_REPORT_GROUP]],
+    ["report-uri", [CSP_REPORT_PATH]],
+  ];
+  if (https) {
+    directives.push(["upgrade-insecure-requests", []]);
+  }
+  return directives;
+}
+
+function serializeCsp(directives) {
+  return directives
+    .map(([name, values]) => (values.length ? `${name} ${values.join(' ')}` : name))
+    .join('; ');
+}
+
+const CSP_MODES = new Set(['report-only', 'enforce', 'off']);
+
+function normalizeCspMode(mode) {
+  const value = String(mode || 'report-only').trim().toLowerCase();
+  if (!CSP_MODES.has(value)) {
+    throw new Error(`Unknown CSP_MODE "${mode}". Expected one of: ${[...CSP_MODES].join(', ')}`);
+  }
+  return value;
+}
+
+/**
+ * Build the full set of security response headers.
+ *
+ * @param {object} opts
+ * @param {'report-only'|'enforce'|'off'} [opts.cspMode]
+ * @param {boolean} [opts.https]  true when the request reached us over TLS (directly or via a
+ *                                trusted proxy). Enables HSTS and upgrade-insecure-requests.
+ * @returns {Record<string,string>}
+ */
+function buildSecurityHeaders({ cspMode = 'report-only', https = false } = {}) {
+  const mode = normalizeCspMode(cspMode);
+  const headers = {
+    // Stop MIME sniffing so a mis-typed response can't be executed as script/HTML.
+    'X-Content-Type-Options': 'nosniff',
+    // Clickjacking: legacy header for browsers that predate frame-ancestors.
+    'X-Frame-Options': 'DENY',
+    // Explicitly disable the legacy XSS auditor; it introduced its own side-channel bugs.
+    'X-XSS-Protection': '0',
+    // Only leak the origin (never the path) on cross-origin navigations; nothing on downgrade.
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    // The page uses none of these powerful features, so deny them to every origin.
+    'Permissions-Policy': [
+      'accelerometer=()',
+      'camera=()',
+      'geolocation=()',
+      'gyroscope=()',
+      'magnetometer=()',
+      'microphone=()',
+      'payment=()',
+      'usb=()',
+      'interest-cohort=()',
+      'browsing-topics=()',
+    ].join(', '),
+    // Isolate our browsing context group from cross-origin openers (Spectre/XS-Leaks mitigations).
+    'Cross-Origin-Opener-Policy': 'same-origin',
+    // Our responses may only be embedded by same-origin documents.
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    // Where browsers that implement the Reporting API should send CSP reports.
+    'Reporting-Endpoints': `${CSP_REPORT_GROUP}="${CSP_REPORT_PATH}"`,
+  };
+
+  if (https) {
+    // Browsers ignore HSTS over plain HTTP, so this is only meaningful (and only sent)
+    // when the request arrived over TLS. Start without `preload`; add it only once the
+    // whole domain, including subdomains, is confirmed HTTPS-only.
+    headers['Strict-Transport-Security'] = 'max-age=31536000; includeSubDomains';
+  }
+
+  if (mode !== 'off') {
+    const headerName = mode === 'enforce'
+      ? 'Content-Security-Policy'
+      : 'Content-Security-Policy-Report-Only';
+    headers[headerName] = serializeCsp(cspDirectives({ https }));
+  }
+
+  return headers;
+}
+
+/**
+ * Decide whether a request arrived over HTTPS. Only honours X-Forwarded-Proto when the
+ * operator has told us a TLS-terminating proxy sits in front (TRUST_PROXY=1), otherwise
+ * a direct client could set the header itself.
+ */
+function requestIsHttps(req, { trustProxy = false } = {}) {
+  if (req.socket && req.socket.encrypted) return true;
+  if (!trustProxy) return false;
+  const forwarded = req.headers['x-forwarded-proto'];
+  if (!forwarded) return false;
+  return String(forwarded).split(',')[0].trim().toLowerCase() === 'https';
+}
+
+/**
+ * Cheap CSRF guard for state-changing requests on a site without sessions/tokens:
+ * reject anything the browser itself labels as cross-site, or whose Origin header does
+ * not match the Host we were reached on. Requests with neither header (old clients,
+ * curl) are allowed through so the endpoint remains usable; strengthen with a real
+ * token once sessions exist.
+ */
+function isSameOriginRequest(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') return false;
+
+  const origin = req.headers.origin;
+  if (origin && origin !== 'null') {
+    let originHost;
+    try {
+      originHost = new URL(origin).host;
+    } catch {
+      return false;
+    }
+    const host = req.headers.host;
+    if (!host || originHost.toLowerCase() !== String(host).toLowerCase()) return false;
+  } else if (origin === 'null') {
+    return false;
+  }
+  return true;
+}
+
+module.exports = {
+  CSP_REPORT_PATH,
+  CSP_REPORT_GROUP,
+  IMAGE_ORIGINS,
+  cspDirectives,
+  serializeCsp,
+  normalizeCspMode,
+  buildSecurityHeaders,
+  requestIsHttps,
+  isSameOriginRequest,
+};
