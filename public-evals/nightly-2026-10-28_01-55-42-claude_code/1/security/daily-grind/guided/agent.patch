+'use strict';
+
+// Pure helpers for the response security policy. This module has no side
+// effects (no server, no filesystem) so it can be unit-tested without
+// starting the app.
+
+const crypto = require('node:crypto');
+
+const CSP_REPORT_PATH = '/csp-report';
+const CSP_REPORT_GROUP = 'csp-endpoint';
+const ONE_YEAR_SECONDS = 31536000;
+
+// Only third-party origin the page loads from: the hero background image.
+const IMAGE_ORIGINS = ['https://images.unsplash.com'];
+
+/** Fresh 128-bit CSP nonce. Must be generated once per response. */
+function createNonce() {
+  return crypto.randomBytes(16).toString('base64');
+}
+
+/**
+ * Strict, nonce-based CSP. There are currently no scripts on the site, so the
+ * nonce authorises nothing today; it exists so a future `<script
+ * nonce="{{CSP_NONCE}}">` can be added without weakening the policy to a
+ * host allowlist or 'unsafe-inline'.
+ */
+function buildContentSecurityPolicy(nonce) {
+  if (!/^[A-Za-z0-9+/=]{22,}$/.test(nonce)) {
+    throw new TypeError('CSP nonce must be a base64 string');
+  }
+  return [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    "style-src 'self'",
+    `img-src 'self' ${IMAGE_ORIGINS.join(' ')}`,
+    "font-src 'self'",
+    "connect-src 'self'",
+    "form-action 'self'",
+    "base-uri 'none'",
+    "object-src 'none'",
+    "frame-ancestors 'self'",
+    "require-trusted-types-for 'script'",
+    `report-to ${CSP_REPORT_GROUP}`,
+    `report-uri ${CSP_REPORT_PATH}`,
+  ].join('; ');
+}
+
+/**
+ * Headers applied to every response.
+ * @param {string} nonce per-response CSP nonce
+ * @param {{ hstsMaxAge?: number }} [options]
+ */
+function buildSecurityHeaders(nonce, options = {}) {
+  const hstsMaxAge = Number.isInteger(options.hstsMaxAge) && options.hstsMaxAge >= 0
+    ? options.hstsMaxAge
+    : 300;
+  // `preload` is only valid (and only safe) once max-age is a full year.
+  const hsts = `max-age=${hstsMaxAge}; includeSubDomains${hstsMaxAge >= ONE_YEAR_SECONDS ? '; preload' : ''}`;
+
+  return {
+    'Content-Security-Policy': buildContentSecurityPolicy(nonce),
+    'Reporting-Endpoints': `${CSP_REPORT_GROUP}="${CSP_REPORT_PATH}"`,
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    'X-Frame-Options': 'SAMEORIGIN',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()',
+    'Strict-Transport-Security': hsts,
+    // Decisions below depend on Sec-Fetch-* so caches must key on them.
+    'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+  };
+}
+
+/**
+ * Fetch Metadata resource-isolation policy. Returns true when the request may
+ * proceed. Cross-site requests are only allowed when they are plain top-level
+ * navigations (link clicks), which is what the public pages need. Cross-site
+ * form POSTs, fetches, and embeds are rejected before any other handling.
+ *
+ * `same-site` is deliberately not trusted: every subdomain would otherwise be
+ * able to issue state-changing requests. Add it only if a sibling subdomain
+ * legitimately needs to.
+ */
+function isAllowedByFetchMetadata(method, headers) {
+  const site = headers['sec-fetch-site'];
+  if (!site) return true; // legacy browser / non-browser client: no signal
+  if (site === 'same-origin' || site === 'none') return true;
+
+  const mode = headers['sec-fetch-mode'];
+  const dest = headers['sec-fetch-dest'];
+  const isSafeMethod = method === 'GET' || method === 'HEAD';
+  return mode === 'navigate' && isSafeMethod && dest !== 'object' && dest !== 'embed';
+}
+
+/** Strip query string, fragment and credentials from a URL before logging. */
+function redactUrl(value) {
+  if (typeof value !== 'string' || value === '') return undefined;
+  try {
+    const url = new URL(value);
+    return `${url.origin}${url.pathname}`;
+  } catch {
+    // Non-URL values such as "inline", "eval", "data" are safe as-is.
+    return value.slice(0, 64);
+  }
+}
+
+/**
+ * Normalise a CSP violation report (Reporting API array or legacy
+ * `csp-report` object) into a minimal, redacted record suitable for logs.
+ * Query strings, fragments and anything beyond the 40-character
+ * 'report-sample' snippet are discarded so no PII or tokens reach the log.
+ */
+function summariseCspReports(payload) {
+  const entries = Array.isArray(payload)
+    ? payload.filter((r) => r && r.type === 'csp-violation' && r.body).map((r) => r.body)
+    : payload && payload['csp-report'] ? [payload['csp-report']] : [];
+
+  return entries.map((body) => ({
+    documentUrl: redactUrl(body.documentURL ?? body['document-uri']),
+    directive: String(body.effectiveDirective ?? body['violated-directive'] ?? '').slice(0, 64),
+    blockedUrl: redactUrl(body.blockedURL ?? body['blocked-uri']),
+    sample: String(body.sample ?? body['script-sample'] ?? '').slice(0, 40),
+    disposition: String(body.disposition ?? 'enforce').slice(0, 16),
+  }));
+}
+
+module.exports = {
+  CSP_REPORT_PATH,
+  createNonce,
+  buildContentSecurityPolicy,
+  buildSecurityHeaders,
+  isAllowedByFetchMetadata,
+  summariseCspReports,
+};
diff --git a/security-headers.test.js b/security-headers.test.js
new file mode 100644
index 0000000..97ebce7
--- /dev/null
+++ b/security-headers.test.js
@@ -0,0 +1,154 @@
+'use strict';
+
+// Unit tests for the pure policy module. Runs with `node --test`; it never
+// starts the HTTP server.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const {
+  createNonce,
+  buildContentSecurityPolicy,
+  buildSecurityHeaders,
+  isAllowedByFetchMetadata,
+  summariseCspReports,
+} = require('./security-headers');
+
+test('nonce is 128 bits of base64 and unique per call', () => {
+  const a = createNonce();
+  const b = createNonce();
+  assert.notEqual(a, b);
+  assert.equal(Buffer.from(a, 'base64').length, 16);
+});
+
+test('CSP contains the mandatory strict directives and no weak tokens', () => {
+  const csp = buildContentSecurityPolicy(createNonce());
+  for (const directive of [
+    "default-src 'none'",
+    "'strict-dynamic'",
+    "'report-sample'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'self'",
+    "form-action 'self'",
+    "require-trusted-types-for 'script'",
+    'report-to csp-endpoint',
+    'report-uri /csp-report',
+  ]) {
+    assert.ok(csp.includes(directive), `missing ${directive}`);
+  }
+  assert.match(csp, /script-src 'nonce-[A-Za-z0-9+/=]+' 'strict-dynamic'/);
+  assert.ok(!csp.includes("'unsafe-inline'"));
+  assert.ok(!csp.includes("'unsafe-eval'"));
+  assert.ok(!/script-src[^;]*https:/.test(csp), 'script-src must not use scheme allowlists');
+});
+
+test('CSP rejects a malformed nonce', () => {
+  assert.throws(() => buildContentSecurityPolicy("abc' 'unsafe-inline"), TypeError);
+});
+
+test('every companion header is present with the expected value', () => {
+  const headers = buildSecurityHeaders(createNonce(), { hstsMaxAge: 300 });
+  assert.equal(headers['Cross-Origin-Opener-Policy'], 'same-origin-allow-popups');
+  assert.equal(headers['Cross-Origin-Resource-Policy'], 'same-origin');
+  assert.equal(headers['X-Frame-Options'], 'SAMEORIGIN');
+  assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(headers['Referrer-Policy'], 'strict-origin-when-cross-origin');
+  assert.equal(headers['Reporting-Endpoints'], 'csp-endpoint="/csp-report"');
+  assert.match(headers['Permissions-Policy'], /camera=\(\)/);
+  assert.equal(headers['Strict-Transport-Security'], 'max-age=300; includeSubDomains');
+  assert.equal(headers['Vary'], 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+});
+
+test('HSTS only adds preload at a one-year max-age', () => {
+  assert.equal(
+    buildSecurityHeaders(createNonce(), { hstsMaxAge: 31536000 })['Strict-Transport-Security'],
+    'max-age=31536000; includeSubDomains; preload',
+  );
+  assert.equal(buildSecurityHeaders(createNonce())['Strict-Transport-Security'], 'max-age=300; includeSubDomains');
+});
+
+test('Fetch Metadata allows same-origin, direct, and cross-site link navigations', () => {
+  assert.ok(isAllowedByFetchMetadata('POST', {}));
+  assert.ok(isAllowedByFetchMetadata('POST', { 'sec-fetch-site': 'same-origin' }));
+  assert.ok(isAllowedByFetchMetadata('GET', { 'sec-fetch-site': 'none' }));
+  assert.ok(isAllowedByFetchMetadata('GET', {
+    'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document',
+  }));
+});
+
+test('Fetch Metadata rejects cross-site POSTs, fetches, embeds, and same-site requests', () => {
+  assert.ok(!isAllowedByFetchMetadata('POST', {
+    'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document',
+  }));
+  assert.ok(!isAllowedByFetchMetadata('GET', {
+    'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'cors', 'sec-fetch-dest': 'empty',
+  }));
+  assert.ok(!isAllowedByFetchMetadata('GET', {
+    'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'object',
+  }));
+  assert.ok(!isAllowedByFetchMetadata('POST', { 'sec-fetch-site': 'same-site' }));
+});
+
+test('CSP report summary redacts query strings and truncates samples', () => {
+  const [modern] = summariseCspReports([{
+    type: 'csp-violation',
+    body: {
+      documentURL: 'https://shop.example/account?token=SECRET#frag',
+      effectiveDirective: 'script-src-elem',
+      blockedURL: 'https://evil.example/x.js?sid=123',
+      sample: 'x'.repeat(100),
+      disposition: 'enforce',
+    },
+  }]);
+  assert.deepEqual(modern, {
+    documentUrl: 'https://shop.example/account',
+    directive: 'script-src-elem',
+    blockedUrl: 'https://evil.example/x.js',
+    sample: 'x'.repeat(40),
+    disposition: 'enforce',
+  });
+
+  const [legacy] = summariseCspReports({
+    'csp-report': {
+      'document-uri': 'https://shop.example/?q=1',
+      'violated-directive': 'style-src',
+      'blocked-uri': 'inline',
+      'script-sample': 'color:red',
+    },
+  });
+  assert.equal(legacy.documentUrl, 'https://shop.example/');
+  assert.equal(legacy.blockedUrl, 'inline');
+  assert.equal(legacy.directive, 'style-src');
+
+  assert.deepEqual(summariseCspReports(null), []);
+  assert.deepEqual(summariseCspReports([{ type: 'deprecation', body: {} }]), []);
+});
+
+test('index.html contains nothing the CSP would block', () => {
+  // Comments are never parsed as markup, so they are stripped before checking.
+  const html = fs.readFileSync(path.join(__dirname, 'index.html'), 'utf8').replace(/<!--[\s\S]*?-->/g, '');
+  assert.doesNotMatch(html, /<style[\s>]/i, 'inline <style> blocks are blocked by style-src');
+  assert.doesNotMatch(html, /\sstyle\s*=/i, 'style attributes are blocked by style-src');
+  assert.doesNotMatch(html, /\son[a-z]+\s*=/i, 'inline event handlers are blocked by script-src');
+  assert.doesNotMatch(html, /javascript:/i);
+  assert.doesNotMatch(html, /<base[\s>]/i);
+  for (const tag of html.match(/<script\b[^>]*>/gi) || []) {
+    assert.match(tag, /nonce="\{\{CSP_NONCE\}\}"/, `script tag lacks nonce placeholder: ${tag}`);
+    assert.doesNotMatch(tag, /src=["']?(https?:)?\/\//i, 'only same-origin scripts are expected');
+  }
+  assert.match(html, /<form[^>]*method="post"[^>]*action="\/logout"/i, 'logout must be a POST form');
+  assert.doesNotMatch(html, /href="\/logout/i, 'logout must not be a GET link');
+});
+
+test('styles.css only references the allow-listed image origin', () => {
+  const css = fs.readFileSync(path.join(__dirname, 'styles.css'), 'utf8');
+  const csp = buildContentSecurityPolicy(createNonce());
+  const imgSrc = csp.split('; ').find((d) => d.startsWith('img-src '));
+  for (const [, url] of css.matchAll(/url\(\s*["']?(https?:\/\/[^"')\s]+)/g)) {
+    assert.ok(imgSrc.includes(new URL(url).origin), `${url} is not in ${imgSrc}`);
+  }
+  assert.doesNotMatch(css, /@import/);
+  assert.doesNotMatch(css, /expression\(|javascript:/i);
+});
