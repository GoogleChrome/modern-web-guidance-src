+  <script>
+    // Fallback for browsers without Declarative Shadow DOM: upgrade the inert
+    // <template shadowrootmode> elements into real shadow roots so the cards
+    // still render with their styles. Modern browsers skip this entirely.
+    if (!Object.prototype.hasOwnProperty.call(HTMLTemplateElement.prototype, 'shadowRootMode')) {
+      document.querySelectorAll('template[shadowrootmode]').forEach(function (template) {
+        var host = template.parentNode;
+        if (!host || host.shadowRoot) return;
+        var root = host.attachShadow({ mode: template.getAttribute('shadowrootmode') });
+        root.appendChild(template.content);
+        template.remove();
+      });
+    }
+  </script>
+
+  <script type="module">
+    const STORAGE_KEY = 'daily-grind:favorites';
+
+    const readFavorites = () => {
+      try {
+        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        return new Set(Array.isArray(stored) ? stored : []);
+      } catch {
+        return new Set();
+      }
+    };
+
+    const writeFavorites = (favorites) => {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+      } catch {
+        // Storage unavailable (private mode, quota) - the toggle still works for this page view.
+      }
+    };
+
+    /**
+     * <drink-card> is server-rendered via a declarative shadow root. On upgrade
+     * the element adopts the existing shadow root and attaches behaviour to the
+     * nodes already on the page; nothing is re-rendered.
+     */
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['favorite', 'open'];
+      }
+
+      #favButton = null;
+      #detailsButton = null;
+      #detailsPanel = null;
+      #hydrated = false;
+
+      connectedCallback() {
+        if (this.#hydrated) return;
+
+        const root = this.shadowRoot;
+        if (!root) {
+          // No server-rendered shadow root (and the fallback could not build one).
+          // Leave the light DOM as-is rather than render a second copy.
+          return;
+        }
+
+        this.#favButton = root.querySelector('.fav');
+        this.#detailsButton = root.querySelector('.details-toggle');
+        this.#detailsPanel = root.querySelector('.details');
+
+        this.#favButton?.addEventListener('click', () => {
+          this.favorite = !this.favorite;
+        });
+        this.#detailsButton?.addEventListener('click', () => {
+          this.open = !this.open;
+        });
+
+        // Restore persisted state. Setting the attribute routes through
+        // attributeChangedCallback, which only patches aria/text in place.
+        if (this.drinkId && readFavorites().has(this.drinkId)) {
+          this.favorite = true;
+        }
+
+        this.#hydrated = true;
+        this.#syncFavorite();
+        this.#syncOpen();
+        this.setAttribute('hydrated', '');
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || !this.#hydrated) return;
+        if (name === 'favorite') {
+          this.#syncFavorite();
+          this.#persistFavorite();
+          this.dispatchEvent(new CustomEvent('favorite-change', {
+            bubbles: true,
+            composed: true,
+            detail: { drinkId: this.drinkId, favorite: this.favorite },
+          }));
+        } else if (name === 'open') {
+          this.#syncOpen();
+        }
+      }
+
+      get drinkId() {
+        return this.getAttribute('drink-id');
+      }
+
+      get name() {
+        return this.querySelector('[slot="title"]')?.textContent.trim() ?? this.drinkId ?? 'this drink';
+      }
+
+      get favorite() {
+        return this.hasAttribute('favorite');
+      }
+
+      set favorite(value) {
+        this.toggleAttribute('favorite', Boolean(value));
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(value) {
+        this.toggleAttribute('open', Boolean(value));
+      }
+
+      #syncFavorite() {
+        const button = this.#favButton;
+        if (!button) return;
+        const on = this.favorite;
+        button.setAttribute('aria-pressed', String(on));
+        button.setAttribute(
+          'aria-label',
+          on ? `Remove ${this.name} from favorites` : `Save ${this.name} to favorites`,
+        );
+        const icon = button.querySelector('.icon');
+        if (icon) icon.textContent = on ? '\u2665' : '\u2661';
+      }
+
+      #syncOpen() {
+        const on = this.open;
+        this.#detailsButton?.setAttribute('aria-expanded', String(on));
+        if (this.#detailsPanel) this.#detailsPanel.hidden = !on;
+      }
+
+      #persistFavorite() {
+        if (!this.drinkId) return;
+        const favorites = readFavorites();
+        if (this.favorite) favorites.add(this.drinkId);
+        else favorites.delete(this.drinkId);
+        writeFavorites(favorites);
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
