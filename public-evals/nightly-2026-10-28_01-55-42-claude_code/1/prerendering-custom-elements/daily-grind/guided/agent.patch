+  <script type="module">
+    // Hydrates the pre-rendered <drink-card> elements above. The shadow roots
+    // already exist (attached by the parser from <template shadowrootmode>), so
+    // this only wires behaviour onto the existing markup; it never re-renders.
+    const STORAGE_KEY = 'daily-grind:favorites';
+
+    function readFavorites() {
+      try {
+        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        return new Set(Array.isArray(stored) ? stored : []);
+      } catch {
+        return new Set();
+      }
+    }
+
+    function writeFavorites(favorites) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+      } catch {
+        // Storage unavailable (private mode, quota); state still lives on the element.
+      }
+    }
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['favorite'];
+
+      #button = null;
+
+      constructor() {
+        super();
+        this.#hydrate();
+      }
+
+      connectedCallback() {
+        // Idempotent: a no-op if the constructor already hydrated.
+        this.#hydrate();
+        // Restore a persisted favorite; server markup may also set it via the attribute.
+        if (this.drink && readFavorites().has(this.drink)) this.favorite = true;
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (name === 'favorite' && oldValue !== newValue) this.#syncButton();
+      }
+
+      /** Stable key for this drink, e.g. "cold-brew". */
+      get drink() {
+        return this.getAttribute('drink') ?? '';
+      }
+
+      /** Boolean attribute: present means favorited. */
+      get favorite() {
+        return this.hasAttribute('favorite');
+      }
+
+      set favorite(on) {
+        this.toggleAttribute('favorite', Boolean(on));
+      }
+
+      toggleFavorite() {
+        this.favorite = !this.favorite;
+
+        const favorites = readFavorites();
+        if (this.favorite) favorites.add(this.drink);
+        else favorites.delete(this.drink);
+        writeFavorites(favorites);
+
+        this.dispatchEvent(new CustomEvent('change', {
+          bubbles: true,
+          composed: true,
+          detail: { drink: this.drink, favorite: this.favorite },
+        }));
+      }
+
+      #hydrate() {
+        if (this.#button) return;
+
+        let root = this.shadowRoot;
+        if (!root) {
+          // Engine without Declarative Shadow DOM support: the template is still an
+          // inert child, so attach the same markup imperatively instead.
+          const template = this.querySelector(':scope > template[shadowrootmode]');
+          if (!template) return;
+          root = this.attachShadow({ mode: 'open' });
+          root.append(template.content.cloneNode(true));
+          template.remove();
+        }
+
+        this.#button = root.querySelector('.favorite');
+        if (!this.#button) return;
+        this.#button.addEventListener('click', () => this.toggleFavorite());
+        this.#syncButton();
+      }
+
+      #syncButton() {
+        this.#button?.setAttribute('aria-pressed', String(this.favorite));
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
