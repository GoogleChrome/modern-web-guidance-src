+    /*
+     * Progressive enhancements
+     * ------------------------
+     * The at-rules below are ignored by browsers that don't understand them.
+     * The rules and declarations that depend on them are gated further down
+     * with `@supports at-rule(@name)`, so they only apply when the at-rule
+     * is actually supported.
+     */
+
+    /* Cross-document view transitions between pages of the site */
+    @view-transition {
+      navigation: auto;
+    }
+
+    /* A brand-tinted overlay for image backgrounds (used by the hero) */
+    @function --scrim(--color, --alpha: 0.5) {
+      result: linear-gradient(
+        rgb(from var(--color) r g b / var(--alpha)),
+        rgb(from var(--color) r g b / calc(var(--alpha) * 1.5))
+      );
+    }
+
+    /* Layered shadow scaled by an elevation level (used by the cards) */
+    @function --elevation(--level: 1) {
+      result: 0 calc(var(--level) * 2px) calc(var(--level) * 6px)
+        rgb(0 0 0 / calc(var(--level) * 0.06));
+    }
+
