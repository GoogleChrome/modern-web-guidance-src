+  <!-- Polite live region so screen readers hear busy-state changes -->
+  <div id="status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
+
+  <script>
+    (function () {
+      var status = document.getElementById('status');
+      var buttons = Array.prototype.slice.call(document.querySelectorAll('.btn[data-loading-label]'));
+      var RESET_AFTER_MS = 15000; // safety net if navigation is cancelled or stalls
+
+      function setBusy(btn, busy) {
+        var text = btn.querySelector('.btn__text');
+        if (busy) {
+          // Lock the width so swapping the label does not shift layout.
+          btn.style.minWidth = btn.getBoundingClientRect().width + 'px';
+          btn.dataset.idleLabel = text.textContent;
+          text.textContent = btn.dataset.loadingLabel;
+          btn.setAttribute('aria-busy', 'true');
+          btn.setAttribute('aria-disabled', 'true');
+          var card = btn.closest('.card');
+          if (card) card.setAttribute('aria-busy', 'true');
+          status.textContent = btn.dataset.loadingAnnounce;
+          clearTimeout(btn._resetTimer);
+          btn._resetTimer = setTimeout(function () { setBusy(btn, false); }, RESET_AFTER_MS);
+        } else {
+          clearTimeout(btn._resetTimer);
+          if (btn.dataset.idleLabel) text.textContent = btn.dataset.idleLabel;
+          btn.style.minWidth = '';
+          btn.removeAttribute('aria-busy');
+          btn.removeAttribute('aria-disabled');
+          var card2 = btn.closest('.card');
+          if (card2) card2.removeAttribute('aria-busy');
+          status.textContent = '';
+        }
+      }
+
+      function resetAll() {
+        buttons.forEach(function (b) { setBusy(b, false); });
+      }
+
+      buttons.forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          // Let new-tab / new-window activations (modifier keys, middle click) behave normally.
+          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+          if (btn.getAttribute('aria-busy') === 'true') {
+            event.preventDefault(); // ignore repeat activations while busy
+            return;
+          }
+          setBusy(btn, true); // navigation proceeds; spinner shows until the next page loads
+        });
+      });
+
+      // Restore idle state when returning via back/forward cache or a cancelled navigation.
+      window.addEventListener('pageshow', resetAll);
+    })();
+  </script>
+
