+  <script>
+    (() => {
+      const LINK_SELECTOR = 'a.btn[data-loading]';
+
+      function setBusy(link, busy) {
+        const spinner = link.querySelector('.loading-spinner');
+        const region = link.closest('.card, .hero');
+
+        if (busy) {
+          link.setAttribute('aria-busy', 'true');
+          // aria-disabled keeps the link focusable while activation is blocked below.
+          link.setAttribute('aria-disabled', 'true');
+          region?.setAttribute('aria-busy', 'true');
+        } else {
+          link.removeAttribute('aria-busy');
+          link.removeAttribute('aria-disabled');
+          region?.removeAttribute('aria-busy');
+        }
+
+        if (spinner) spinner.hidden = !busy;
+      }
+
+      function resetAll() {
+        document
+          .querySelectorAll(`${LINK_SELECTOR}[aria-busy="true"]`)
+          .forEach((link) => setBusy(link, false));
+      }
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest(LINK_SELECTOR);
+        if (!link) return;
+
+        // Already navigating: swallow repeat clicks and Enter presses.
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        // Modified clicks open a new tab/window, so this page is not actually busy.
+        if (
+          event.defaultPrevented ||
+          event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
+          link.target === '_blank'
+        ) {
+          return;
+        }
+
+        setBusy(link, true);
+      });
+
+      // Clear the busy state if the page is kept alive or restored from the
+      // back/forward cache, so a returning user never sees a stuck spinner.
+      window.addEventListener('pagehide', resetAll);
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) resetAll();
+      });
+    })();
+  </script>
+
