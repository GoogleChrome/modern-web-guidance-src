+
+    /* ---------- Shaped elements (CSS masking) ---------- */
+
+    /* 1) Featured barista: image masked to an organic paint-splat SVG shape.
+       The mask uses maskContentUnits="objectBoundingBox", so it scales with
+       whatever width/height the image is rendered at. */
+    .featured-barista {
+      display: grid;
+      grid-template-columns: auto 1fr;
+      gap: 32px;
+      align-items: center;
+      margin-top: 60px;
+    }
+
+    .shaped-avatar {
+      width: 240px;
+      height: 240px;
+      object-fit: cover;
+      display: block;
+
+      -webkit-mask-image: url(#splat-mask);
+      -webkit-mask-size: 100% 100%;
+      -webkit-mask-repeat: no-repeat;
+      mask-image: url(#splat-mask);
+      mask-size: 100% 100%;
+      mask-repeat: no-repeat;
+    }
+
+    .featured-barista h2 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .featured-barista .role {
+      color: var(--accent);
+      font-weight: 600;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      font-size: 0.8rem;
+      margin-bottom: 12px;
+    }
+
+    /* 2) Loyalty banner: unmasked text block + adjacent masked accent.
+       Both share a background so they read as one card. The shadow is a
+       filter on the parent so it follows the masked curve instead of a
+       rectangular box. */
+    .unified-card {
+      display: flex;
+      max-width: 520px;
+      margin: 60px auto 0;
+      filter: drop-shadow(0 10px 18px rgba(62, 39, 35, 0.3));
+    }
+
+    .card-body {
+      flex: 1;
+      background-color: var(--primary);
+      color: var(--light);
+      padding: 28px 8px 28px 28px;
+      border-top-left-radius: 16px;
+      border-bottom-left-radius: 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .card-body .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .card-body .btn:hover {
+      background: #ffc46b;
+    }
+
+    .card-accent {
+      width: 72px;
+      background-color: var(--primary);
+      border-top-right-radius: 16px;
+      border-bottom-right-radius: 16px;
+
+      -webkit-mask-image: url(#accent-stencil);
+      -webkit-mask-size: 100% 100%;
+      -webkit-mask-repeat: no-repeat;
+      mask-image: url(#accent-stencil);
+      mask-size: 100% 100%;
+      mask-repeat: no-repeat;
+    }
+
+    /* 3) Promo card: circular notch cut from the top edge with a radial
+       gradient mask (no SVG needed for a simple geometric cutout). */
+    .gradient-masked-card {
+      max-width: 420px;
+      margin: 60px auto 0;
+      background: linear-gradient(135deg, var(--accent), #ff7a00);
+      color: var(--text);
+      padding: 48px 24px 24px; /* extra top padding clears the notch */
+      border-radius: 16px;
+      text-align: center;
+
+      -webkit-mask-image: radial-gradient(circle at 50% 0%, transparent 22px, black 23px);
+      mask-image: radial-gradient(circle at 50% 0%, transparent 22px, black 23px);
+    }
+
+    .gradient-masked-card h3 {
+      margin-bottom: 8px;
+    }
+
+    .gradient-masked-card .code {
+      display: inline-block;
+      margin-top: 14px;
+      padding: 6px 14px;
+      border: 2px dashed var(--text);
+      border-radius: 6px;
+      font-weight: bold;
+      letter-spacing: 2px;
+    }
+
+    /* Fallback: no mask support -> give the avatar a soft rounded crop.
+       The card pieces already degrade to a plain rectangle on their own. */
+    @supports (not (mask-image: url(x))) and (not (-webkit-mask-image: url(x))) {
+      .shaped-avatar {
+        clip-path: inset(0 round 24px);
+      }
+    }
+
+    @media (max-width: 640px) {
+      .featured-barista {
+        grid-template-columns: 1fr;
+        justify-items: center;
+        text-align: center;
+      }
+    }
   </style>
