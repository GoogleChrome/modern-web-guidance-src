+// Browser glue: origin migration hand-off, service worker, and reinstall prompt.
+(function () {
+  const cfg = globalThis.DAILY_GRIND_CONFIG;
+  const M = globalThis.DailyGrindMigration;
+  const prefix = cfg.storagePrefix;
+  const metaFrom = prefix + M.META_KEYS.from;
+  const metaAt = prefix + M.META_KEYS.at;
+
+  const role = M.determineRole(location.origin, cfg);
+
+  if (role === "sender" && sendToNewOrigin()) {
+    return; // the page is about to unload; skip SW registration on the retired origin
+  }
+
+  receiveFromOldOrigin();
+  registerServiceWorker();
+  setupReinstallBanner();
+
+  // ---- old origin -----------------------------------------------------------
+
+  function sendToNewOrigin() {
+    // Guard against a misconfigured newOrigin that bounces back here.
+    const hopsKey = prefix + "handoffs";
+    const hops = Number(sessionStorage.getItem(hopsKey) || 0) + 1;
+    sessionStorage.setItem(hopsKey, String(hops));
+    if (hops > 3) {
+      console.error("[migration] aborting hand-off: redirect loop between", location.origin, "and", cfg.newOrigin);
+      return;
+    }
+
+    let encoded = "";
+    try {
+      encoded = M.encodePayload({
+        from: location.origin,
+        config: M.collectConfig(localStorage, prefix),
+      });
+    } catch (err) {
+      console.warn("[migration] hand-off without configuration:", err);
+    }
+    const target = encoded
+      ? M.buildHandoffUrl(cfg.newOrigin, location, encoded)
+      : M.normalizeOrigin(cfg.newOrigin) + location.pathname + location.search;
+    location.replace(target);
+    return true;
+  }
+
+  // ---- new origin -----------------------------------------------------------
+
+  function receiveFromOldOrigin() {
+    const encoded = M.parseHandoffHash(location.hash);
+    if (!encoded) return;
+
+    // Always drop the payload from the address bar, even if we reject it.
+    history.replaceState(null, "", location.pathname + location.search);
+
+    const payload = M.decodePayload(encoded);
+    if (!payload) return;
+
+    const trusted = M.isTrustedReferrer(document.referrer, cfg.previousOrigins);
+    if (!trusted) {
+      const ok = confirm(
+        "Import your saved Daily Grind settings from " + payload.from + "?"
+      );
+      if (!ok) return;
+    }
+
+    const result = M.applyConfig(localStorage, payload.config, prefix);
+    localStorage.setItem(metaFrom, payload.from);
+    localStorage.setItem(metaAt, new Date().toISOString());
+    console.info("[migration] imported", result.imported.length, "setting(s) from", payload.from);
+  }
+
+  // ---- installability -------------------------------------------------------
+
+  function registerServiceWorker() {
+    if (!("serviceWorker" in navigator)) return;
+    navigator.serviceWorker.register("/sw.js").catch((err) => {
+      console.warn("[sw] registration failed:", err);
+    });
+  }
+
+  function isStandalone() {
+    return (
+      matchMedia("(display-mode: standalone)").matches ||
+      matchMedia("(display-mode: window-controls-overlay)").matches ||
+      navigator.standalone === true
+    );
+  }
+
+  // After a migration the install on the old origin still exists, but it now just
+  // forwards here. Offer a fresh install so the app icon and its OS-level shortcuts
+  // (jump list / long-press menu, declared in manifest.json) point at this origin.
+  function setupReinstallBanner() {
+    const migratedFrom = localStorage.getItem(metaFrom);
+    const dismissedKey = prefix + "reinstallDismissed";
+    if (!migratedFrom || isStandalone() || localStorage.getItem(dismissedKey)) return;
+
+    let deferredPrompt = null;
+
+    addEventListener("beforeinstallprompt", (event) => {
+      event.preventDefault();
+      deferredPrompt = event;
+      showBanner();
+    });
+
+    addEventListener("appinstalled", () => {
+      localStorage.setItem(dismissedKey, "installed");
+      removeBanner();
+    });
+
+    function showBanner() {
+      if (document.getElementById("dg-reinstall")) return;
+      const banner = document.createElement("div");
+      banner.id = "dg-reinstall";
+      banner.className = "reinstall-banner";
+      banner.setAttribute("role", "status");
+      banner.innerHTML =
+        '<span>The Daily Grind has moved to <strong></strong>. ' +
+        "Reinstall to put the app and its shortcuts back on your device.</span>" +
+        '<span class="reinstall-actions">' +
+        '<button type="button" class="btn" data-action="install">Reinstall app</button>' +
+        '<button type="button" class="btn btn-quiet" data-action="dismiss">Not now</button>' +
+        "</span>";
+      banner.querySelector("strong").textContent = location.host;
+      banner.addEventListener("click", async (event) => {
+        const action = event.target.closest("[data-action]");
+        if (!action) return;
+        if (action.dataset.action === "install" && deferredPrompt) {
+          deferredPrompt.prompt();
+          const choice = await deferredPrompt.userChoice;
+          deferredPrompt = null;
+          if (choice.outcome === "accepted") removeBanner();
+        } else if (action.dataset.action === "dismiss") {
+          localStorage.setItem(dismissedKey, "1");
+          removeBanner();
+        }
+      });
+      document.body.prepend(banner);
+    }
+
+    function removeBanner() {
+      const banner = document.getElementById("dg-reinstall");
+      if (banner) banner.remove();
+    }
+  }
+})();
