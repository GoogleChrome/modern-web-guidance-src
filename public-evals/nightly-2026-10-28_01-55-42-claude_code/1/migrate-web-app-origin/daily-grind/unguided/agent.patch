@@ -0,0 +1,25 @@
+// Deployment configuration for The Daily Grind web app.
+//
+// Origin migration: deploy this SAME build to both the old and the new origin.
+// The code decides its role from location.origin:
+//   - on an origin that is NOT newOrigin  -> "sender": packages user configuration
+//     and hands the visitor off to newOrigin (nothing happens while newOrigin is "").
+//   - on newOrigin                        -> "receiver": imports the hand-off payload
+//     and offers to reinstall the app so OS-level shortcuts come back.
+//
+// Example:
+//   newOrigin: "https://app.thedailygrind.coffee",
+//   previousOrigins: ["https://www.dailygrind.example"],
+globalThis.DAILY_GRIND_CONFIG = {
+  // Fill in the new origin (scheme + host, no trailing slash) to start the migration.
+  newOrigin: "",
+
+  // Origins the receiver trusts to import configuration from without asking the user.
+  previousOrigins: [],
+
+  // Only localStorage keys with this prefix are treated as user configuration.
+  storagePrefix: "dg:",
+
+  // Bump to force the service worker to refresh its app-shell cache.
+  cacheVersion: "v1",
+};
