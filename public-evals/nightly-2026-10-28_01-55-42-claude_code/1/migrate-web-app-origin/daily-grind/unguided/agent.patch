+  "/icons/icon-512.png",
+  "/icons/icon-maskable-192.png",
+  "/icons/icon-maskable-512.png",
+];
+
+self.addEventListener("install", (event) => {
+  event.waitUntil(
+    caches.open(CACHE).then((cache) => cache.addAll(APP_SHELL)).then(() => self.skipWaiting())
+  );
+});
+
+self.addEventListener("activate", (event) => {
+  event.waitUntil(
+    caches
+      .keys()
+      .then((keys) => Promise.all(keys.filter((k) => k !== CACHE).map((k) => caches.delete(k))))
+      .then(() => self.clients.claim())
+  );
+});
+
+// Network first, cache fallback, for everything on this origin. The app shell is tiny,
+// and this guarantees a freshly deployed config.js (which may switch on the origin
+// migration) is picked up on the next launch instead of being served stale.
+self.addEventListener("fetch", (event) => {
+  const { request } = event;
+  if (request.method !== "GET" || new URL(request.url).origin !== self.location.origin) return;
+
+  event.respondWith(
+    fetch(request)
+      .then((response) => {
+        if (response.ok) {
+          const copy = response.clone();
+          caches.open(CACHE).then((cache) => cache.put(request, copy));
+        }
+        return response;
+      })
+      .catch(() =>
+        caches.match(request).then((hit) => {
+          if (hit) return hit;
+          if (request.mode === "navigate") return caches.match("/index.html");
+          return Response.error();
+        })
+      )
+  );
+});
diff --git a/test/migration.test.mjs b/test/migration.test.mjs
new file mode 100644
index 0000000..c4261f9
--- /dev/null
+++ b/test/migration.test.mjs
@@ -0,0 +1,108 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+
+const require = createRequire(import.meta.url);
+const M = require("../migration.js");
+
+class MemoryStorage {
+  #map = new Map();
+  get length() { return this.#map.size; }
+  key(i) { return [...this.#map.keys()][i] ?? null; }
+  getItem(k) { return this.#map.has(k) ? this.#map.get(k) : null; }
+  setItem(k, v) { this.#map.set(k, String(v)); }
+  removeItem(k) { this.#map.delete(k); }
+}
+
+const cfg = {
+  newOrigin: "https://app.thedailygrind.coffee",
+  previousOrigins: ["https://www.dailygrind.example"],
+  storagePrefix: "dg:",
+};
+
+test("determineRole picks sender on the old origin and receiver on the new one", () => {
+  assert.equal(M.determineRole("https://www.dailygrind.example", cfg), "sender");
+  assert.equal(M.determineRole("https://app.thedailygrind.coffee", cfg), "receiver");
+  assert.equal(M.determineRole("https://app.thedailygrind.coffee", { newOrigin: "https://app.thedailygrind.coffee/" }), "receiver", "trailing slash is normalized");
+  assert.equal(M.determineRole("https://anything.example", { newOrigin: "" }), "none", "migration is off until newOrigin is set");
+  assert.equal(M.determineRole("https://anything.example", { newOrigin: "not a url" }), "none");
+});
+
+test("collectConfig only snapshots keys under the app prefix", () => {
+  const s = new MemoryStorage();
+  s.setItem("dg:theme", "dark");
+  s.setItem("dg:favoriteDrink", "Maple Oat Latte");
+  s.setItem("other:thing", "ignored");
+  assert.deepEqual(M.collectConfig(s, "dg:"), { "dg:theme": "dark", "dg:favoriteDrink": "Maple Oat Latte" });
+});
+
+test("payload round-trips through base64url, including unicode", () => {
+  const config = { "dg:name": "Zoë ☕ café", "dg:store": "Ünïcode/+=?" };
+  const encoded = M.encodePayload({ from: "https://www.dailygrind.example/path", config, at: "2026-10-28T00:00:00.000Z" });
+  assert.match(encoded, /^[A-Za-z0-9_-]+$/, "URL-safe alphabet, no padding");
+  const decoded = M.decodePayload(encoded);
+  assert.deepEqual(decoded, { v: 1, from: "https://www.dailygrind.example", at: "2026-10-28T00:00:00.000Z", config });
+});
+
+test("decodePayload rejects malformed or hostile input", () => {
+  assert.equal(M.decodePayload(""), null);
+  assert.equal(M.decodePayload("!!!not-base64!!!"), null);
+  assert.equal(M.decodePayload(btoa("null")), null);
+  assert.equal(M.decodePayload(btoa(JSON.stringify({ v: 2, from: "https://x.example", config: {} }))), null, "unknown version");
+  assert.equal(M.decodePayload(btoa(JSON.stringify({ v: 1, from: "garbage", config: {} }))), null, "bad origin");
+  assert.equal(M.decodePayload(btoa(JSON.stringify({ v: 1, from: "https://x.example", config: [] }))), null, "array config");
+  assert.equal(M.decodePayload(btoa(JSON.stringify({ v: 1, from: "https://x.example", config: { "dg:a": { nested: true } } }))), null, "non-string value");
+  assert.equal(M.decodePayload("a".repeat(300 * 1024)), null, "oversized");
+});
+
+test("encodePayload refuses payloads too large for a URL", () => {
+  assert.throws(() => M.encodePayload({ from: "https://x.example", config: { "dg:big": "x".repeat(400 * 1024) } }), /too large/);
+});
+
+test("applyConfig imports new keys, keeps existing values, and ignores foreign keys", () => {
+  const s = new MemoryStorage();
+  s.setItem("dg:theme", "light");
+  const result = M.applyConfig(s, { "dg:theme": "dark", "dg:favoriteDrink": "Cold Brew", "evil:key": "x" }, "dg:");
+  assert.deepEqual(result, { imported: ["dg:favoriteDrink"], skipped: ["dg:theme", "evil:key"] });
+  assert.equal(s.getItem("dg:theme"), "light");
+  assert.equal(s.getItem("dg:favoriteDrink"), "Cold Brew");
+  assert.equal(s.getItem("evil:key"), null);
+
+  M.applyConfig(s, { "dg:theme": "dark" }, "dg:", { overwrite: true });
+  assert.equal(s.getItem("dg:theme"), "dark");
+});
+
+test("hand-off URL keeps path and query on the new origin and carries the payload in the fragment", () => {
+  const location = { pathname: "/menu/seasonal", search: "?source=pwa", hash: "#ignored" };
+  const url = M.buildHandoffUrl("https://app.thedailygrind.coffee/", location, "PAYLOAD");
+  assert.equal(url, "https://app.thedailygrind.coffee/menu/seasonal?source=pwa#dg-migrate=PAYLOAD");
+  const parsed = new URL(url);
+  assert.equal(M.parseHandoffHash(parsed.hash), "PAYLOAD");
+  assert.equal(M.parseHandoffHash("#section-2"), null);
+  assert.equal(M.parseHandoffHash(""), null);
+  assert.equal(M.parseHandoffHash("#dg-migrate="), null);
+});
+
+test("full sender -> receiver flow preserves configuration", () => {
+  const oldStorage = new MemoryStorage();
+  oldStorage.setItem("dg:theme", "dark");
+  oldStorage.setItem("dg:favoriteLocation", "Downtown");
+  oldStorage.setItem("analytics:id", "not-config");
+
+  const encoded = M.encodePayload({ from: "https://www.dailygrind.example", config: M.collectConfig(oldStorage, "dg:") });
+  const url = M.buildHandoffUrl(cfg.newOrigin, { pathname: "/", search: "?source=pwa" }, encoded);
+
+  const newStorage = new MemoryStorage();
+  const payload = M.decodePayload(M.parseHandoffHash(new URL(url).hash));
+  const result = M.applyConfig(newStorage, payload.config, "dg:");
+  assert.deepEqual(result.imported.sort(), ["dg:favoriteLocation", "dg:theme"]);
+  assert.equal(newStorage.getItem("analytics:id"), null);
+});
+
+test("isTrustedReferrer accepts only listed previous origins", () => {
+  assert.equal(M.isTrustedReferrer("https://www.dailygrind.example/", cfg.previousOrigins), true);
+  assert.equal(M.isTrustedReferrer("https://www.dailygrind.example/some/page?x=1", cfg.previousOrigins), true);
+  assert.equal(M.isTrustedReferrer("https://evil.example/", cfg.previousOrigins), false);
+  assert.equal(M.isTrustedReferrer("", cfg.previousOrigins), false);
+  assert.equal(M.isTrustedReferrer("https://www.dailygrind.example/", undefined), false);
+});
