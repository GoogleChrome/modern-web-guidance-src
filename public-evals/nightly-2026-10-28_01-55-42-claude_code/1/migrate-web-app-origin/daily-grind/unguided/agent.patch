new file mode 100644
index 0000000..7e960ac
--- /dev/null
+++ b/migration.js
@@ -0,0 +1,144 @@
+// Origin-migration logic for The Daily Grind.
+// Pure functions only (no DOM access) so they run in the browser and under node:test.
+(function (root, factory) {
+  const api = factory();
+  root.DailyGrindMigration = api;
+  if (typeof module === "object" && module.exports) module.exports = api;
+})(typeof globalThis !== "undefined" ? globalThis : this, function () {
+  const PAYLOAD_VERSION = 1;
+  const HASH_KEY = "dg-migrate";
+  const MAX_PAYLOAD_CHARS = 200 * 1024; // keep well inside browser URL limits
+  const META_KEYS = { from: "migratedFrom", at: "migratedAt" };
+
+  function normalizeOrigin(value) {
+    if (typeof value !== "string" || value === "") return "";
+    try {
+      return new URL(value).origin;
+    } catch {
+      return "";
+    }
+  }
+
+  function determineRole(currentOrigin, cfg) {
+    const target = normalizeOrigin(cfg && cfg.newOrigin);
+    const here = normalizeOrigin(currentOrigin);
+    if (!target || !here) return "none";
+    return here === target ? "receiver" : "sender";
+  }
+
+  // Snapshot every localStorage entry that belongs to the app.
+  function collectConfig(storage, prefix) {
+    const out = {};
+    for (let i = 0; i < storage.length; i++) {
+      const key = storage.key(i);
+      if (key && key.startsWith(prefix)) out[key] = storage.getItem(key);
+    }
+    return out;
+  }
+
+  // Write imported entries; existing values on the new origin win unless overwrite is set.
+  function applyConfig(storage, config, prefix, options) {
+    const overwrite = Boolean(options && options.overwrite);
+    const result = { imported: [], skipped: [] };
+    for (const key of Object.keys(config)) {
+      if (!key.startsWith(prefix) || typeof config[key] !== "string") {
+        result.skipped.push(key);
+        continue;
+      }
+      if (!overwrite && storage.getItem(key) !== null) {
+        result.skipped.push(key);
+        continue;
+      }
+      storage.setItem(key, config[key]);
+      result.imported.push(key);
+    }
+    return result;
+  }
+
+  function toBase64Url(text) {
+    const bytes = new TextEncoder().encode(text);
+    let binary = "";
+    for (let i = 0; i < bytes.length; i += 0x8000) {
+      binary += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+    }
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+  }
+
+  function fromBase64Url(text) {
+    const b64 = text.replace(/-/g, "+").replace(/_/g, "/");
+    const padded = b64 + "=".repeat((4 - (b64.length % 4)) % 4);
+    const binary = atob(padded);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+    return new TextDecoder().decode(bytes);
+  }
+
+  function encodePayload(payload) {
+    const body = {
+      v: PAYLOAD_VERSION,
+      from: normalizeOrigin(payload.from),
+      at: payload.at || new Date().toISOString(),
+      config: payload.config || {},
+    };
+    const encoded = toBase64Url(JSON.stringify(body));
+    if (encoded.length > MAX_PAYLOAD_CHARS) {
+      throw new Error("Migration payload too large for a URL hand-off");
+    }
+    return encoded;
+  }
+
+  function decodePayload(encoded) {
+    if (typeof encoded !== "string" || encoded === "" || encoded.length > MAX_PAYLOAD_CHARS) {
+      return null;
+    }
+    let body;
+    try {
+      body = JSON.parse(fromBase64Url(encoded));
+    } catch {
+      return null;
+    }
+    if (!body || body.v !== PAYLOAD_VERSION) return null;
+    if (!normalizeOrigin(body.from)) return null;
+    if (!body.config || typeof body.config !== "object" || Array.isArray(body.config)) return null;
+    for (const value of Object.values(body.config)) {
+      if (typeof value !== "string") return null;
+    }
+    return { v: body.v, from: normalizeOrigin(body.from), at: String(body.at || ""), config: body.config };
+  }
+
+  // Same path and query on the new origin; the payload rides in the fragment,
+  // which browsers never send to the server.
+  function buildHandoffUrl(newOrigin, location, encodedPayload) {
+    const base = normalizeOrigin(newOrigin);
+    return base + location.pathname + location.search + "#" + HASH_KEY + "=" + encodedPayload;
+  }
+
+  function parseHandoffHash(hash) {
+    if (typeof hash !== "string") return null;
+    const raw = hash.startsWith("#") ? hash.slice(1) : hash;
+    const params = new URLSearchParams(raw);
+    const value = params.get(HASH_KEY);
+    return value && value !== "" ? value : null;
+  }
+
+  function isTrustedReferrer(referrer, previousOrigins) {
+    const origin = normalizeOrigin(referrer);
+    if (!origin || !Array.isArray(previousOrigins)) return false;
+    return previousOrigins.some((candidate) => normalizeOrigin(candidate) === origin);
+  }
+
+  return {
+    PAYLOAD_VERSION,
+    HASH_KEY,
+    META_KEYS,
+    normalizeOrigin,
+    determineRole,
+    collectConfig,
+    applyConfig,
+    encodePayload,
+    decodePayload,
+    buildHandoffUrl,
+    parseHandoffHash,
+    isTrustedReferrer,
+  };
+});
