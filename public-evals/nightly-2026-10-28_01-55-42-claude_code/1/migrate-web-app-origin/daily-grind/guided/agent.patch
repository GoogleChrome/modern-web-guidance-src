index 0000000..e054834
--- /dev/null
+++ b/app/migration.js
@@ -0,0 +1,161 @@
+// Carries per-device preferences from the legacy origin to the new origin.
+//
+// The browser's Web App Origin Migration (manifest `migrate_from` /
+// `migrate_to` + /.well-known/web-app-origin-association) moves the
+// *installation* — taskbar / home-screen shortcuts and the app identity.
+// It does NOT move storage, so this module does the data handoff:
+//
+//   new origin  ──(hidden iframe)──►  legacy origin /migrate-export.html
+//               ◄──── postMessage { type: 'dg:prefs', prefs } ────
+//               ───── postMessage { type: 'dg:prefs-imported' } ──►
+//
+// Both origins are same-site (shared registrable domain), so the framed
+// legacy document reads its own unpartitioned localStorage.
+
+import { config } from './config.js';
+import { hasPrefs, loadPrefs, sanitizePrefs, savePrefs, PREFS_VERSION } from './prefs.js';
+import { isSameOrigin } from './origins.js';
+
+export const EXPORT_PATH = '/migrate-export.html';
+export const MESSAGE_PREFS = 'dg:prefs';
+export const MESSAGE_IMPORTED = 'dg:prefs-imported';
+
+const STATE_KEY = 'dg:migration';
+const MAX_ATTEMPTS = 3;
+const HANDSHAKE_TIMEOUT_MS = 8000;
+const IFRAME_LINGER_MS = 1000;
+
+function readState() {
+  try {
+    const raw = localStorage.getItem(STATE_KEY);
+    const state = raw ? JSON.parse(raw) : {};
+    return state && typeof state === 'object' ? state : {};
+  } catch {
+    return {};
+  }
+}
+
+function writeState(state) {
+  try {
+    localStorage.setItem(STATE_KEY, JSON.stringify(state));
+  } catch {
+    // Non-fatal: without storage we simply retry next launch.
+  }
+}
+
+export function initMigration() {
+  if (config.role === 'legacy') {
+    showMoveNotice();
+  } else {
+    importFromLegacy();
+  }
+}
+
+/* ---------- legacy origin ---------- */
+
+function showMoveNotice() {
+  const notice = document.getElementById('move-notice');
+  const text = document.getElementById('move-notice-text');
+  const link = document.getElementById('move-notice-link');
+  if (!notice || !text || !link) return;
+
+  const target = new URL('/', config.nextOrigin);
+  link.href = target.href;
+
+  const { exportedAt } = readState();
+  text.textContent = exportedAt
+    ? `${config.appName} now lives at ${target.host}. Your preferences have already been moved there.`
+    : `${config.appName} is moving to ${target.host}. Open it once and your preferences come with you.`;
+  notice.hidden = false;
+}
+
+/** Called by the framed export page once the new origin acknowledges receipt. */
+export function markExported() {
+  writeState({ ...readState(), exportedAt: new Date().toISOString() });
+}
+
+/* ---------- new origin ---------- */
+
+async function importFromLegacy() {
+  const state = readState();
+  if (state.status === 'done') return;
+
+  const attempts = Number(state.attempts) || 0;
+  if (attempts >= MAX_ATTEMPTS) return;
+
+  // Preferences already set on this origin win; never clobber them.
+  if (hasPrefs(loadPrefs())) {
+    writeState({ status: 'done', reason: 'local-prefs-present', attempts });
+    return;
+  }
+
+  writeState({ ...state, status: 'pending', attempts: attempts + 1 });
+
+  const prefs = await fetchLegacyPrefs();
+  if (prefs === null) return; // No answer: leave pending and retry next launch.
+
+  if (hasPrefs(prefs)) {
+    savePrefs(prefs);
+    document.dispatchEvent(new CustomEvent('dg:prefs-imported', { detail: prefs }));
+    showImportToast();
+  }
+  writeState({ status: 'done', importedAt: new Date().toISOString(), attempts: attempts + 1 });
+}
+
+function fetchLegacyPrefs() {
+  return new Promise((resolve) => {
+    const iframe = document.createElement('iframe');
+    iframe.hidden = true;
+    iframe.tabIndex = -1;
+    iframe.setAttribute('aria-hidden', 'true');
+    iframe.referrerPolicy = 'strict-origin';
+
+    let settled = false;
+    let timer = 0;
+
+    const finish = (value) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      window.removeEventListener('message', onMessage);
+      // Keep the frame alive briefly so the acknowledgement is delivered.
+      setTimeout(() => iframe.remove(), IFRAME_LINGER_MS);
+      resolve(value);
+    };
+
+    const onMessage = (event) => {
+      if (event.source !== iframe.contentWindow) return;
+      if (!isSameOrigin(event, config.legacyOrigin)) return;
+
+      const data = event.data;
+      if (!data || data.type !== MESSAGE_PREFS) return;
+      if (data.version !== PREFS_VERSION) {
+        finish({});
+        return;
+      }
+
+      const prefs = sanitizePrefs(data.prefs);
+      event.source.postMessage({ type: MESSAGE_IMPORTED }, config.legacyOrigin);
+      finish(prefs);
+    };
+
+    window.addEventListener('message', onMessage);
+    timer = setTimeout(() => finish(null), HANDSHAKE_TIMEOUT_MS);
+
+    iframe.src = new URL(EXPORT_PATH, config.legacyOrigin).href;
+    document.body.append(iframe);
+  });
+}
+
+function showImportToast() {
+  const toast = document.getElementById('import-toast');
+  if (!toast) return;
+  if (typeof toast.showPopover === 'function') {
+    toast.showPopover();
+    setTimeout(() => toast.hidePopover(), 8000);
+  } else {
+    toast.removeAttribute('popover');
+    toast.style.position = 'fixed';
+    setTimeout(() => toast.remove(), 8000);
+  }
+}
diff --git a/app/origins.js b/app/origins.js
new file mode 100644
index 0000000..086711d
--- /dev/null
+++ b/app/origins.js
@@ -0,0 +1,41 @@
+// Origin comparison for cross-document messages, following the Origin API
+// (Origin.from / isSameOrigin) with a URL-based fallback where it is missing.
+
+function extractOrigin(candidate) {
+  try {
+    return Origin.from(candidate);
+  } catch (err) {
+    // Synthetic MessageEvents (tests) carry only the serialized origin string.
+    if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+      return Origin.from(candidate.origin);
+    }
+    throw err;
+  }
+}
+
+function extractUrlString(candidate) {
+  if (typeof candidate === 'string') return candidate;
+  if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+    return candidate.origin;
+  }
+  if (candidate === globalThis) return globalThis.location?.href ?? '';
+  return candidate?.href ?? '';
+}
+
+/**
+ * True when `candidate` (a MessageEvent, URL string, or URL-bearing object)
+ * is exactly same-origin with `trustedUrl`. Opaque ("null") origins,
+ * unparsable input, and any thrown error all yield `false`.
+ */
+export function isSameOrigin(candidate, trustedUrl) {
+  try {
+    if ('Origin' in globalThis) {
+      return extractOrigin(candidate).isSameOrigin(Origin.from(trustedUrl));
+    }
+    const candidateUrl = new URL(extractUrlString(candidate));
+    const trusted = new URL(trustedUrl);
+    return candidateUrl.origin !== 'null' && candidateUrl.origin === trusted.origin;
+  } catch {
+    return false;
+  }
+}
diff --git a/app/prefs.js b/app/prefs.js
new file mode 100644
index 0000000..c21f979
--- /dev/null
+++ b/app/prefs.js
@@ -0,0 +1,60 @@
+// Per-device user configuration. Storage is origin-bound, so this is the
+// payload that migration.js carries from the legacy origin to the new one.
+
+const STORAGE_KEY = 'dg:prefs';
+export const PREFS_VERSION = 1;
+
+const ALLOWED = {
+  location: new Set(['downtown', 'riverside', 'campus']),
+  milk: new Set(['whole', 'oat', 'almond', 'none']),
+};
+const CUP_NAME_MAX = 40;
+
+/**
+ * Reduce any untrusted object to a well-formed preferences record.
+ * Unknown keys and invalid values are dropped rather than rejected wholesale.
+ */
+export function sanitizePrefs(input) {
+  const out = {};
+  if (!input || typeof input !== 'object') return out;
+
+  for (const [key, allowed] of Object.entries(ALLOWED)) {
+    const value = input[key];
+    if (typeof value === 'string' && allowed.has(value)) out[key] = value;
+  }
+
+  if (typeof input.cupName === 'string') {
+    const name = input.cupName.trim().slice(0, CUP_NAME_MAX);
+    if (name) out.cupName = name;
+  }
+
+  return out;
+}
+
+export function hasPrefs(prefs) {
+  return Boolean(prefs) && Object.keys(prefs).length > 0;
+}
+
+export function loadPrefs() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    return raw ? sanitizePrefs(JSON.parse(raw)) : {};
+  } catch {
+    return {};
+  }
+}
+
+export function savePrefs(prefs) {
+  const clean = sanitizePrefs(prefs);
+  try {
+    if (hasPrefs(clean)) {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(clean));
+    } else {
+      localStorage.removeItem(STORAGE_KEY);
+    }
+  } catch {
+    // Storage may be unavailable (private mode, quota). Preferences simply
+    // won't persist; the UI keeps working.
+  }
+  return clean;
+}
