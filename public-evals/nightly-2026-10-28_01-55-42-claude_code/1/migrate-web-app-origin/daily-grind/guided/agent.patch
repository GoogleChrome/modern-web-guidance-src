+import { loadPrefs, savePrefs } from './prefs.js';
+import { initMigration } from './migration.js';
+
+const form = document.getElementById('prefs-form');
+
+function fillForm(prefs) {
+  for (const field of form.elements) {
+    if (field.name && field.name in prefs) field.value = prefs[field.name];
+  }
+}
+
+fillForm(loadPrefs());
+
+form.addEventListener('submit', (event) => {
+  event.preventDefault();
+  savePrefs(Object.fromEntries(new FormData(form)));
+  form.elements.status.value = 'Preferences saved on this device.';
+});
+
+// Reflect preferences that arrive from the legacy origin after first paint.
+document.addEventListener('dg:prefs-imported', (event) => fillForm(event.detail));
+
+initMigration();
