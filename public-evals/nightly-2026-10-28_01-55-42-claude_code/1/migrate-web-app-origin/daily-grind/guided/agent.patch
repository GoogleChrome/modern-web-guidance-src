@@ -0,0 +1,37 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <title>Moving your preferences…</title>
+  <meta name="robots" content="noindex, nofollow">
+  <script type="module">
+    // Served only from the legacy origin. When framed by the new origin it
+    // hands over this device's preferences; any other embedder gets nothing
+    // because postMessage is pinned to config.nextOrigin.
+    import { config } from '/config.js';
+    import { loadPrefs, PREFS_VERSION } from '/prefs.js';
+    import { isSameOrigin } from '/origins.js';
+    import { markExported, MESSAGE_PREFS, MESSAGE_IMPORTED } from '/migration.js';
+
+    if (window.parent === window) {
+      // Opened directly: this page has no UI, send the user to the new app.
+      location.replace(new URL('/', config.nextOrigin).href);
+    } else {
+      window.addEventListener('message', (event) => {
+        if (event.source !== window.parent) return;
+        if (!isSameOrigin(event, config.nextOrigin)) return;
+        if (event.data?.type === MESSAGE_IMPORTED) markExported();
+      });
+
+      window.parent.postMessage(
+        { type: MESSAGE_PREFS, version: PREFS_VERSION, prefs: loadPrefs() },
+        config.nextOrigin,
+      );
+    }
+  </script>
+</head>
+
+<body></body>
+
+</html>
