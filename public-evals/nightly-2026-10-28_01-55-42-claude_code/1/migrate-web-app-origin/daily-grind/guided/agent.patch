new file mode 100644
index 0000000..580ecdd
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,134 @@
+// Builds two deployable static sites from one shared app:
+//   dist/legacy → the origin users installed from (authorises the move)
+//   dist/next   → the new origin (claims the legacy install)
+// Origins come from site.config.json so manifests, the .well-known
+// association file, and the runtime config can never drift apart.
+
+import { cp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const config = JSON.parse(await readFile(path.join(root, 'site.config.json'), 'utf8'));
+
+const legacyOrigin = normalizeOrigin(config.legacyOrigin, 'legacyOrigin');
+const nextOrigin = normalizeOrigin(config.nextOrigin, 'nextOrigin');
+assertSameSite(legacyOrigin, nextOrigin);
+
+const ICONS = [
+  { src: '/icons/icon.svg', sizes: 'any', type: 'image/svg+xml' },
+  { src: '/icons/icon-192.png', sizes: '192x192', type: 'image/png' },
+  { src: '/icons/icon-512.png', sizes: '512x512', type: 'image/png' },
+  { src: '/icons/icon-maskable-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' },
+];
+const SHORTCUT_ICON = [{ src: '/icons/icon-96.png', sizes: '96x96', type: 'image/png' }];
+
+function manifestFor(role) {
+  const manifest = {
+    name: config.appName,
+    short_name: config.shortName,
+    description: 'Ethically sourced, locally roasted, delivered to your cup.',
+    // `id` is what the browser uses to recognise this app across updates and
+    // across the origin move. Keep it stable.
+    id: '/',
+    start_url: '/',
+    scope: '/',
+    display: 'standalone',
+    background_color: '#fafafa',
+    theme_color: '#4e342e',
+    icons: ICONS,
+    // OS-level jump-list / long-press shortcuts. Identical on both origins so
+    // the migrated install keeps the same entries.
+    shortcuts: [
+      { name: 'Order Now', short_name: 'Order', url: '/order-online', icons: SHORTCUT_ICON },
+      { name: 'Menu', url: '/menu', icons: SHORTCUT_ICON },
+      { name: 'Rewards', url: '/rewards', icons: SHORTCUT_ICON },
+    ],
+  };
+
+  if (role === 'legacy') {
+    // Hint to browsers that an installed legacy app should move now, rather
+    // than waiting for the user to visit the new origin.
+    manifest.migrate_to = [{ id: `${nextOrigin}/`, install_url: `${nextOrigin}/` }];
+  } else {
+    const from = { id: `${legacyOrigin}/` };
+    if (config.forceMigration) from.behavior = 'force';
+    manifest.migrate_from = [from];
+  }
+  return manifest;
+}
+
+async function buildSite(role) {
+  const out = path.join(root, 'dist', role);
+  await rm(out, { recursive: true, force: true });
+  await mkdir(out, { recursive: true });
+
+  await cp(path.join(root, 'app'), out, { recursive: true });
+  const overlay = path.join(root, 'origins', role);
+  await cp(overlay, out, { recursive: true }).catch((err) => {
+    if (err.code !== 'ENOENT') throw err;
+  });
+
+  await writeFile(
+    path.join(out, 'config.js'),
+    `// Generated by scripts/build.mjs — edit site.config.json instead.\n` +
+      `export const config = Object.freeze(${JSON.stringify(
+        { role, appName: config.appName, legacyOrigin, nextOrigin },
+        null,
+        2,
+      )});\n`,
+  );
+
+  await writeFile(
+    path.join(out, 'manifest.webmanifest'),
+    JSON.stringify(manifestFor(role), null, 2) + '\n',
+  );
+
+  if (role === 'legacy') {
+    // The legacy origin must explicitly authorise the new origin, otherwise
+    // any same-site origin could claim the installation.
+    await mkdir(path.join(out, '.well-known'), { recursive: true });
+    await writeFile(
+      path.join(out, '.well-known', 'web-app-origin-association'),
+      JSON.stringify({ [nextOrigin]: { allow_migration: true } }, null, 2) + '\n',
+    );
+  }
+
+  console.log(`built dist/${role}  (${role === 'legacy' ? legacyOrigin : nextOrigin})`);
+}
+
+await buildSite('legacy');
+await buildSite('next');
+
+/* ---------- helpers ---------- */
+
+function normalizeOrigin(value, name) {
+  let url;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error(`site.config.json: ${name} is not a valid URL: ${value}`);
+  }
+  if (url.origin !== value) {
+    throw new Error(`site.config.json: ${name} must be a bare origin (no path/trailing slash): got ${value}, expected ${url.origin}`);
+  }
+  if (url.protocol !== 'https:' && url.hostname !== 'localhost') {
+    throw new Error(`site.config.json: ${name} must use https (installable apps require a secure context)`);
+  }
+  return url.origin;
+}
+
+// Origin migration is only permitted between same-site origins (shared
+// registrable domain). Node has no Public Suffix List, so this is a cheap
+// guard against obvious mistakes, not a full eTLD+1 check.
+function assertSameSite(a, b) {
+  const ua = new URL(a);
+  const ub = new URL(b);
+  if (ua.hostname === 'localhost' || ub.hostname === 'localhost') return;
+  const site = (h) => h.split('.').slice(-2).join('.');
+  if (ua.protocol !== ub.protocol || site(ua.hostname) !== site(ub.hostname)) {
+    throw new Error(
+      `legacyOrigin (${a}) and nextOrigin (${b}) are not same-site; browsers refuse to migrate an install across registrable domains.`,
+    );
+  }
+}
