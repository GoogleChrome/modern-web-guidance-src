+      font-weight: 600;
+    }
+
+    #alert-dismiss {
+      position: absolute;
+      inset-block-start: 50%;
+      inset-inline-end: 5%;
+      translate: 0 -50%;
+      display: grid;
+      place-items: center;
+      inline-size: 2rem;
+      block-size: 2rem;
+      border-radius: 50%;
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+      list-style: none;
+      transition: background 0.3s;
+    }
+
+    #alert-dismiss::-webkit-details-marker {
