+        }
+      }
+
+      /* ---------- Temperature model (runs on the interval) ---------- */
+      function profile(t) {
+        if (t < ROAST_SECONDS) {
+          var p = t / ROAST_SECONDS;
+          var eased = 1 - Math.pow(1 - p, 2.2);       // fast initial climb, tapering off
+          var turning = Math.sin(Math.min(p * 6, Math.PI)) * -12; // charge dip / turning point
+          return T_START + (T_END - T_START) * eased + turning;
+        }
