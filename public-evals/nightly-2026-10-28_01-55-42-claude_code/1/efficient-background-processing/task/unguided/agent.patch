+      }
+
+      function drumRadius() { return Math.min(W, H) * 0.42; }
+
+      function initBeans() {
+        beans = [];
+        var R = drumRadius();
+        for (var i = 0; i < BEAN_COUNT; i++) {
+          var a = Math.random() * Math.PI * 2;
+          var r = Math.random() * R * 0.7;
+          beans.push({
+            x: Math.cos(a) * r, y: Math.sin(a) * r,
+            vx: 0, vy: 0,
+            rot: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 4,
+            size: 7 + Math.random() * 4
