+
+      /* ---------- Simulation constants ---------- */
+      var TICK_MS = 500;           // temperature update interval
+      var ROAST_SECONDS = 48;      // charge -> drop
+      var COOL_SECONDS = 10;       // cooling tray
+      var REST_SECONDS = 2;        // pause before the next batch
+      var CYCLE_SECONDS = ROAST_SECONDS + COOL_SECONDS + REST_SECONDS;
+      var T_START = 180, T_END = 430;
+      var BEAN_COUNT = 30;
+
+      /* ---------- State ---------- */
+      var roastClock = 0;          // seconds of *active* simulation time (does not advance while paused)
+      var temp = T_START;
+      var roastLevel = 0;          // 0 = green, 1 = fully developed (drives bean colour)
+      var inView = false;
+      var pageVisible = true;
+      var rafId = null;
+      var intervalId = null;
+      var lastFrame = 0;
+      var drumAngle = 0;
+      var beans = [];
+      var smoke = [];
+      var W = 0, H = 0, dpr = 1;
+
+      /* ---------- Canvas sizing ---------- */
+      function resizeCanvas() {
+        dpr = window.devicePixelRatio || 1;
+        var rect = canvas.getBoundingClientRect();
+        var w = Math.max(1, Math.floor(rect.width));
+        var h = Math.max(1, Math.floor(rect.height));
+        if (w === W && h === H && canvas.width === Math.floor(w * dpr)) { return; }
+        W = w; H = h;
+        canvas.width = Math.floor(w * dpr);
+        canvas.height = Math.floor(h * dpr);
