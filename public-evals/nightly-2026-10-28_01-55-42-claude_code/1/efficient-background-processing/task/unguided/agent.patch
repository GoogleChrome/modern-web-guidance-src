+      }
+
+      function stageFor(t, temperature) {
+        if (t >= ROAST_SECONDS + COOL_SECONDS) { return 'Loading Next Batch'; }
+        if (t >= ROAST_SECONDS) { return 'Cooling'; }
+        if (temperature < 300) { return 'Drying Phase'; }
+        if (temperature < 385) { return 'Maillard / Browning'; }
+        if (temperature < 405) { return 'First Crack'; }
+        return 'Development'; 
+      }
+
+      function tick() {
+        roastClock += TICK_MS / 1000;
+        if (roastClock >= CYCLE_SECONDS) { roastClock = 0; roastLevel = 0; }
+        var jitter = (Math.random() - 0.5) * 2.5;
+        temp = profile(roastClock) + jitter;
+        if (roastClock < ROAST_SECONDS) {
