@@ -151,13 +151,44 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll Progress Indicator */
+    .scroll-progress {
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      transform: scaleX(0);
+      transform-origin: left center;
+      z-index: 1001; /* above the sticky nav */
+      pointer-events: none;
+      will-change: transform;
+    }
+
+    /* Progressive enhancement: let the browser drive the bar directly from
+       the scroll position when scroll-driven animations are supported. */
+    @supports (animation-timeline: scroll()) {
+      @keyframes scroll-progress-grow {
+        from { transform: scaleX(0); }
+        to   { transform: scaleX(1); }
+      }
+
+      .scroll-progress {
+        animation: scroll-progress-grow linear both;
+        animation-timeline: scroll(root block);
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroll-progress" role="progressbar" aria-label="Page scroll progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +237,55 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var bar = document.querySelector('.scroll-progress');
+      if (!bar) return;
+
+      var supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('animation-timeline: scroll()');
+
+      var root = document.documentElement;
+
+      function progress() {
+        var scrollable = root.scrollHeight - window.innerHeight;
+        if (scrollable <= 0) return 0;
+        var scrolled = window.pageYOffset || root.scrollTop || 0;
+        return Math.min(1, Math.max(0, scrolled / scrollable));
+      }
+
+      function updateAria(p) {
+        bar.setAttribute('aria-valuenow', String(Math.round(p * 100)));
+      }
+
+      // Fallback for browsers without CSS scroll-driven animations:
+      // update the bar's scale from JavaScript, throttled to one paint per frame.
+      var ticking = false;
+      function update() {
+        var p = progress();
+        if (!supportsScrollTimeline) {
+          bar.style.transform = 'scaleX(' + p + ')';
+        }
+        updateAria(p);
+        ticking = false;
+      }
+
+      function requestUpdate() {
+        if (ticking) return;
+        ticking = true;
+        (window.requestAnimationFrame || function (cb) { setTimeout(cb, 16); })(update);
+      }
+
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate, { passive: true });
+      window.addEventListener('load', requestUpdate);
+      update();
+    })();
+  </script>
+
 </body>
 
 </html>
