+  <script type="module">
+    // Coffee Rituals: a daily pickup reminder time and a coffee anniversary date.
+    //
+    // Both values are *location-agnostic*. A reminder at 07:30 means 07:30 on
+    // whatever clock the user is looking at, and an anniversary on 2023-01-14
+    // is that calendar day everywhere. We therefore never touch the legacy
+    // `Date` object (which always models a single instant and re-projects it
+    // into the viewer's current time zone, shifting values after travel).
+    // Instead we use Temporal's Plain types and persist their canonical ISO
+    // strings ("HH:MM" and "YYYY-MM-DD"), which carry no offset at all.
+
+    const STORAGE_KEY = 'daily-grind:rituals';
+
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal === 'undefined') {
+        const mod = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = mod.Temporal;
+      }
+    }
+
+    function loadRituals() {
+      try {
+        const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}');
+        return parsed && typeof parsed === 'object' ? parsed : {};
+      } catch {
+        return {};
+      }
+    }
+
+    function saveRituals(rituals) {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(rituals));
+    }
+
+    // Parse user input into Plain types. Returns null for empty/invalid input.
+    function parsePickupTime(value) {
+      if (!value) return null;
+      try {
+        return Temporal.PlainTime.from(value);
+      } catch {
+        return null;
+      }
+    }
+
+    function parseAnniversary(value) {
+      if (!value) return null;
+      try {
+        return Temporal.PlainDate.from(value);
+      } catch {
+        return null;
+      }
+    }
+
+    function describeAnniversary(anniversary) {
+      // "Today" is the calendar date currently on the user's clock. The
+      // anniversary itself never moves; only the countdown is relative.
+      const today = Temporal.Now.plainDateISO();
+      const monthDay = anniversary.toPlainMonthDay();
+
+      // PlainMonthDay has no arithmetic; convert to a PlainDate in a concrete
+      // year first. For a Feb 29 anniversary the default overflow 'constrain'
+      // yields Feb 28 in non-leap years.
+      let next = monthDay.toPlainDate({ year: today.year });
+      if (Temporal.PlainDate.compare(next, today) < 0) {
+        next = monthDay.toPlainDate({ year: today.year + 1 });
+      }
+
+      const daysUntil = today.until(next, { largestUnit: 'days' }).days;
+      const yearsTogether = Temporal.PlainDate.compare(anniversary, today) <= 0
+        ? anniversary.until(today, { largestUnit: 'years' }).years
+        : 0;
+
+      let countdown;
+      if (daysUntil === 0) {
+        countdown = 'That is today. Happy coffee anniversary!';
+      } else if (daysUntil === 1) {
+        countdown = 'Next one is tomorrow.';
+      } else {
+        countdown = `Next one in ${daysUntil} days.`;
+      }
+
+      const years = yearsTogether === 1 ? '1 year with us.' : `${yearsTogether} years with us.`;
+      return `${years} ${countdown}`;
+    }
+
+    function renderSummary(rituals) {
+      const pickupEl = document.getElementById('summary-pickup');
+      const anniversaryEl = document.getElementById('summary-anniversary');
+
+      const pickupTime = parsePickupTime(rituals.pickupTime);
+      pickupEl.replaceChildren();
+      if (pickupTime) {
+        // Formatting a PlainTime performs no time zone conversion.
+        const timeEl = document.createElement('time');
+        timeEl.dateTime = pickupTime.toString({ smallestUnit: 'minute' });
+        timeEl.textContent = pickupTime.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' });
+        const sub = document.createElement('span');
+        sub.className = 'sub';
+        sub.textContent = 'Every day, local clock time wherever you are.';
+        pickupEl.append(timeEl, sub);
+      } else {
+        pickupEl.innerHTML = '<span class="muted">Not set yet</span>';
+      }
+
+      const anniversary = parseAnniversary(rituals.anniversary);
+      anniversaryEl.replaceChildren();
+      if (anniversary) {
+        const timeEl = document.createElement('time');
+        timeEl.dateTime = anniversary.toString();
+        timeEl.textContent = anniversary.toLocaleString(undefined, { dateStyle: 'long' });
+        const sub = document.createElement('span');
+        sub.className = 'sub';
+        sub.textContent = describeAnniversary(anniversary);
+        anniversaryEl.append(timeEl, sub);
+      } else {
+        anniversaryEl.innerHTML = '<span class="muted">Not set yet</span>';
+      }
+    }
+
+    function setStatus(message, tone = 'ok') {
+      const status = document.getElementById('rituals-status');
+      status.textContent = message;
+      status.dataset.tone = tone;
+    }
+
+    function init() {
+      const form = document.getElementById('rituals-form');
+      const pickupInput = document.getElementById('pickup-time');
+      const anniversaryInput = document.getElementById('anniversary-date');
+
+      // An anniversary cannot be in the future; cap at today's calendar date.
+      anniversaryInput.max = Temporal.Now.plainDateISO().toString();
+
+      // Prefill from storage. The stored strings are already in the exact
+      // format the native inputs expect, so no conversion is needed.
+      const stored = loadRituals();
+      const storedTime = parsePickupTime(stored.pickupTime);
+      const storedDate = parseAnniversary(stored.anniversary);
+      if (storedTime) pickupInput.value = storedTime.toString({ smallestUnit: 'minute' });
+      if (storedDate) anniversaryInput.value = storedDate.toString();
+      renderSummary(stored);
+
+      for (const input of [pickupInput, anniversaryInput]) {
+        input.addEventListener('input', () => {
+          input.setCustomValidity('');
+          setStatus('');
+        });
+        input.addEventListener('blur', () => {
+          input.checkValidity();
+        });
+      }
+
+      pickupInput.addEventListener('invalid', () => {
+        pickupInput.setCustomValidity('Please choose a reminder time, like 07:30.');
+      });
+      anniversaryInput.addEventListener('invalid', () => {
+        anniversaryInput.setCustomValidity(
+          anniversaryInput.validity.rangeOverflow
+            ? 'Your anniversary cannot be in the future.'
+            : 'Please choose the date of your first cup with us.'
+        );
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        if (!form.reportValidity()) {
+          setStatus('Please fix the highlighted fields.', 'error');
+          return;
+        }
+
+        const pickupTime = parsePickupTime(pickupInput.value);
+        const anniversary = parseAnniversary(anniversaryInput.value);
+        if (!pickupTime || !anniversary) {
+          setStatus('Those values could not be read. Please re-enter them.', 'error');
+          return;
+        }
+
+        const rituals = {
+          // Canonical offset-free ISO strings: "07:30" and "2023-01-14".
+          pickupTime: pickupTime.toString({ smallestUnit: 'minute' }),
+          anniversary: anniversary.toString(),
+        };
+        saveRituals(rituals);
+        renderSummary(rituals);
+        setStatus('Saved. Your reminder time and anniversary will stay exactly as chosen, wherever you go.');
+      });
+    }
+
+    await ensureTemporal();
+    init();
+  </script>
+
 </body>
 
