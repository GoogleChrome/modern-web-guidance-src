+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var sidebar = document.querySelector('.toc-sidebar');
+      if (!panel || !sidebar) return;
+
+      var links = Array.prototype.slice.call(sidebar.querySelectorAll('.toc-link'));
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var linkById = {};
+      links.forEach(function (link) {
+        var id = (link.getAttribute('href') || '').replace(/^#/, '');
+        if (id) linkById[id] = link;
+      });
+
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var activeId = null;
+
+      function setActive(id) {
+        if (!id || id === activeId) return;
+        activeId = id;
+        links.forEach(function (link) {
+          var isActive = link === linkById[id];
+          link.classList.toggle('is-active', isActive);
+          if (isActive) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+        sections.forEach(function (section) {
+          if (section.id === id) {
+            section.setAttribute('aria-current', 'true');
+          } else {
+            section.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function scrollPanelTo(section, smooth) {
+        var top = section.offsetTop - panel.offsetTop;
+        var behavior = smooth && !reduceMotion.matches ? 'smooth' : 'auto';
+        if (typeof panel.scrollTo === 'function') {
+          panel.scrollTo({ top: top, behavior: behavior });
+        } else {
+          panel.scrollTop = top;
+        }
+      }
+
+      /* Clicking a TOC link smoothly scrolls the panel (not the page) to that section */
+      sidebar.addEventListener('click', function (event) {
+        var link = event.target.closest ? event.target.closest('.toc-link') : null;
+        if (!link) return;
+        var id = (link.getAttribute('href') || '').replace(/^#/, '');
+        var section = id && document.getElementById(id);
+        if (!section || !panel.contains(section)) return;
+
+        event.preventDefault();
+        setActive(id);
+        scrollPanelTo(section, true);
+        if (window.history && history.replaceState) {
+          history.replaceState(null, '', '#' + id);
+        }
+        var header = section.querySelector('header');
+        if (header) header.focus({ preventScroll: true });
+      });
+
+      /* Highlight the link for whichever section is snapped into view */
+      if ('IntersectionObserver' in window) {
+        var ratios = {};
+        var observer = new IntersectionObserver(function (entries) {
+          entries.forEach(function (entry) {
+            ratios[entry.target.id] = entry.isIntersecting ? entry.intersectionRatio : 0;
+          });
+          var bestId = null;
+          var bestRatio = 0;
+          sections.forEach(function (section) {
+            var r = ratios[section.id] || 0;
+            if (r > bestRatio) {
+              bestRatio = r;
+              bestId = section.id;
+            }
+          });
+          if (bestId) setActive(bestId);
+        }, {
+          root: panel,
+          threshold: [0, 0.25, 0.5, 0.75, 1]
+        });
+        sections.forEach(function (section) { observer.observe(section); });
+      } else {
+        var ticking = false;
+        panel.addEventListener('scroll', function () {
+          if (ticking) return;
+          ticking = true;
+          window.requestAnimationFrame(function () {
+            ticking = false;
+            var scrollTop = panel.scrollTop;
+            var current = sections[0];
+            sections.forEach(function (section) {
+              if (section.offsetTop - panel.offsetTop <= scrollTop + 1) current = section;
+            });
+            if (current) setActive(current.id);
+          });
+        });
+      }
+
+      /* Honor a deep link such as /#cold-brew on load, otherwise mark the first drink */
+      var initialId = (location.hash || '').replace(/^#/, '');
+      var initialSection = initialId && document.getElementById(initialId);
+      if (initialSection && panel.contains(initialSection)) {
+        setActive(initialId);
+        scrollPanelTo(initialSection, false);
+      } else if (sections.length) {
+        setActive(sections[0].id);
+      }
+    })();
+  </script>
+
