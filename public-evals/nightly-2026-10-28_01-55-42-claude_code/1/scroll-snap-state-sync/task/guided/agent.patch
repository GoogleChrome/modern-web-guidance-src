+  <script>
+    (() => {
+      const panel = document.getElementById('seasonal-panel');
+      const sidebar = document.querySelector('.toc-sidebar');
+      if (!panel || !sidebar) return;
+
+      const links = Array.from(sidebar.querySelectorAll('a[href^="#"]'));
+      const sections = Array.from(panel.querySelectorAll('.drink-section'));
+      const headers = sections.map((section) => section.querySelector('header'));
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const setActive = (id) => {
+        links.forEach((link) => {
+          const isActive = link.getAttribute('href') === `#${id}`;
+          if (isActive) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      };
+
+      const scrollPanelTo = (section, behavior) => {
+        // offsetTop is relative to the panel because the panel is position: relative
+        panel.scrollTo({ top: section.offsetTop, behavior });
+      };
+
+      // Clicking a TOC link smoothly scrolls the panel (not the page) to that section
+      links.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const id = link.getAttribute('href').slice(1);
+          const section = document.getElementById(id);
+          if (!section || !panel.contains(section)) return;
+          event.preventDefault();
+          setActive(id);
+          section.focus({ preventScroll: true });
+          scrollPanelTo(section, reducedMotion.matches ? 'auto' : 'smooth');
+          history.replaceState(null, '', `#${id}`);
+        });
+      });
+
+      // Keep the sidebar in sync with whichever header the panel has snapped to
+      if ('onscrollsnapchange' in panel) {
+        panel.addEventListener('scrollsnapchange', (event) => {
+          const snapped = event.snapTargetBlock;
+          const section = snapped && snapped.closest('.drink-section');
+          if (section) setActive(section.id);
+        });
+      } else {
+        // Fallback: pick the topmost header visible inside the panel
+        const observer = new IntersectionObserver(() => {
+          const panelTop = panel.getBoundingClientRect().top;
+          const top = headers.reduce((current, header) => {
+            const { bottom } = header.getBoundingClientRect();
+            if (bottom < panelTop) return current;
+            if (!current) return header;
+            return bottom < current.getBoundingClientRect().bottom ? header : current;
+          }, undefined);
+          if (top) setActive(top.closest('.drink-section').id);
+        }, { root: panel, threshold: [0, 0.5, 1] });
+        headers.forEach((header) => observer.observe(header));
+      }
+
+      // Honour a matching hash on load without animating
+      const initial = location.hash && document.getElementById(location.hash.slice(1));
+      if (initial && panel.contains(initial)) {
+        scrollPanelTo(initial, 'auto');
+        setActive(initial.id);
+      }
+    })();
+  </script>
+
