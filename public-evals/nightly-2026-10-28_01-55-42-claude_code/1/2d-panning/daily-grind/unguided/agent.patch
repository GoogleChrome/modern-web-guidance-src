+  <script>
+    (function () {
+      var viewport = document.getElementById('cafe-map');
+      if (!viewport) return;
+
+      var surface = viewport.querySelector('.map-surface');
+      var activePointer = null;
+      var startX = 0, startY = 0, startLeft = 0, startTop = 0;
+      var moved = false;
+
+      function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
+
+      function maxScrollX() { return viewport.scrollWidth - viewport.clientWidth; }
+      function maxScrollY() { return viewport.scrollHeight - viewport.clientHeight; }
+
+      // Pan so that surface coordinate (x, y) is centered in the viewport.
+      function centerOn(x, y, smooth) {
+        var left = clamp(x - viewport.clientWidth / 2, 0, maxScrollX());
+        var top = clamp(y - viewport.clientHeight / 2, 0, maxScrollY());
+        if (smooth && 'scrollTo' in viewport) {
+          viewport.scrollTo({ left: left, top: top, behavior: 'smooth' });
+        } else {
+          viewport.scrollLeft = left;
+          viewport.scrollTop = top;
+        }
+      }
+
+      // Pointer-driven panning: mouse, touch, and pen all go through the same path.
+      // Both axes are updated from the same pointer delta on every move, so diagonal
+      // drags and mid-gesture direction changes are followed without any axis locking.
+      viewport.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'mouse' && e.button !== 0) return;
+        activePointer = e.pointerId;
+        startX = e.clientX;
+        startY = e.clientY;
+        startLeft = viewport.scrollLeft;
+        startTop = viewport.scrollTop;
+        moved = false;
+        viewport.classList.add('is-panning');
+        if (viewport.setPointerCapture) viewport.setPointerCapture(e.pointerId);
+      });
+
+      viewport.addEventListener('pointermove', function (e) {
+        if (e.pointerId !== activePointer) return;
+        var dx = e.clientX - startX;
+        var dy = e.clientY - startY;
+        if (!moved && (Math.abs(dx) > 3 || Math.abs(dy) > 3)) moved = true;
+        viewport.scrollLeft = clamp(startLeft - dx, 0, maxScrollX());
+        viewport.scrollTop = clamp(startTop - dy, 0, maxScrollY());
+        e.preventDefault();
+      });
+
+      function endPan(e) {
+        if (e.pointerId !== activePointer) return;
+        activePointer = null;
+        viewport.classList.remove('is-panning');
+        if (viewport.releasePointerCapture && viewport.hasPointerCapture && viewport.hasPointerCapture(e.pointerId)) {
+          viewport.releasePointerCapture(e.pointerId);
+        }
+      }
+      viewport.addEventListener('pointerup', endPan);
+      viewport.addEventListener('pointercancel', endPan);
+
+      // If the user dragged, don't treat the release over a pin as a click.
+      viewport.addEventListener('click', function (e) {
+        if (moved) {
+          e.preventDefault();
+          e.stopPropagation();
+          moved = false;
+        }
+      }, true);
+
+      // Keyboard panning: arrow keys move on either axis; holding two arrows at
+      // once (e.g. Up + Right) pans diagonally.
+      var held = {};
+      var rafId = null;
+      var KEYS = { ArrowLeft: 1, ArrowRight: 1, ArrowUp: 1, ArrowDown: 1 };
+
+      function step() {
+        var dx = (held.ArrowRight ? 1 : 0) - (held.ArrowLeft ? 1 : 0);
+        var dy = (held.ArrowDown ? 1 : 0) - (held.ArrowUp ? 1 : 0);
+        if (dx || dy) {
+          viewport.scrollLeft = clamp(viewport.scrollLeft + dx * 12, 0, maxScrollX());
+          viewport.scrollTop = clamp(viewport.scrollTop + dy * 12, 0, maxScrollY());
+          rafId = requestAnimationFrame(step);
+        } else {
+          rafId = null;
+        }
+      }
+
+      viewport.addEventListener('keydown', function (e) {
+        if (!KEYS[e.key]) return;
+        e.preventDefault();
+        held[e.key] = true;
+        if (rafId === null) rafId = requestAnimationFrame(step);
+      });
+      viewport.addEventListener('keyup', function (e) {
+        if (KEYS[e.key]) held[e.key] = false;
+      });
+      viewport.addEventListener('blur', function () { held = {}; });
+
+      // Jump-to buttons.
+      var buttons = document.querySelectorAll('.map-controls [data-map-x]');
+      Array.prototype.forEach.call(buttons, function (btn) {
+        btn.addEventListener('click', function () {
+          centerOn(parseFloat(btn.getAttribute('data-map-x')), parseFloat(btn.getAttribute('data-map-y')), true);
+        });
+      });
+
+      // Start centered on the flagship cafe rather than the top-left corner.
+      centerOn(1200, 760, false);
+    })();
+  </script>
