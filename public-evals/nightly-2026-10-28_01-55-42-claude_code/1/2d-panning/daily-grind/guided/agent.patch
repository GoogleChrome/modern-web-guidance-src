+  <script>
+    (() => {
+      const viewport = document.querySelector('.map-viewport');
+      const surface = document.querySelector('.map-surface');
+      if (!viewport || !surface) return;
+
+      // Start centered on the map so there is room to pan in every direction.
+      const centerOn = (x, y, behavior) => {
+        viewport.scrollTo({
+          left: x - viewport.clientWidth / 2,
+          top: y - viewport.clientHeight / 2,
+          behavior,
+        });
+      };
+      centerOn(surface.offsetWidth / 2, surface.offsetHeight / 2, 'instant');
+
+      // Legend buttons pan the map to the matching pin.
+      document.querySelectorAll('.map-legend [data-jump]').forEach((button) => {
+        button.addEventListener('click', () => {
+          const pin = surface.querySelector(`[data-cafe="${button.dataset.jump}"]`);
+          if (!pin) return;
+          const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+          centerOn(pin.offsetLeft, pin.offsetTop - pin.offsetHeight / 2, reduceMotion ? 'instant' : 'smooth');
+        });
+      });
+
+      // Browsers with scroll-axis-lock pan natively in 2D; the rest get a
+      // main-thread wheel + pointer fallback that drives scrollLeft/scrollTop.
+      if (CSS.supports('scroll-axis-lock', 'none')) return;
+
+      let lastPointer = null;
+      let moved = false;
+
+      viewport.addEventListener(
+        'wheel',
+        (e) => {
+          e.preventDefault();
+          viewport.scrollLeft += e.deltaX;
+          viewport.scrollTop += e.deltaY;
+        },
+        { passive: false },
+      );
+
+      viewport.addEventListener('pointerdown', (e) => {
+        const rect = viewport.getBoundingClientRect();
+        // Ignore non-primary buttons and presses on the native scrollbars.
+        if (
+          !e.isPrimary ||
+          e.button !== 0 ||
+          e.clientX - rect.left - viewport.clientLeft >= viewport.clientWidth ||
+          e.clientY - rect.top - viewport.clientTop >= viewport.clientHeight
+        ) {
+          return;
+        }
+        lastPointer = { x: e.clientX, y: e.clientY };
+        moved = false;
+        viewport.setPointerCapture(e.pointerId);
+        viewport.classList.add('is-panning');
+      });
+
+      viewport.addEventListener('pointermove', (e) => {
+        if (!lastPointer) return;
+        const dx = e.clientX - lastPointer.x;
+        const dy = e.clientY - lastPointer.y;
+        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true;
+        viewport.scrollLeft -= dx;
+        viewport.scrollTop -= dy;
+        lastPointer = { x: e.clientX, y: e.clientY };
+      });
+
+      const endPointerPan = () => {
+        lastPointer = null;
+        viewport.classList.remove('is-panning');
+      };
+      viewport.addEventListener('pointerup', endPointerPan);
+      viewport.addEventListener('pointercancel', endPointerPan);
+
+      // A drag that started on a pin should pan, not navigate.
+      viewport.addEventListener('click', (e) => {
+        if (moved && e.target.closest('.map-pin')) {
+          e.preventDefault();
+          moved = false;
+        }
+      });
+    })();
+  </script>
+
