+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var errorEl = document.getElementById('newsletter-error');
+      // The field is "touched" once the user has focused it and left, or has
+      // tried to submit. No error is shown before that.
+      var touched = false;
+
+      function validate() {
+        if (!touched) return true;
+        var value = input.value.trim();
+        var message = '';
+        if (value === '') {
+          message = 'Please enter your email address.';
+        } else if (!input.checkValidity()) {
+          message = 'Please enter a valid email address.';
+        }
+        errorEl.textContent = message;
+        form.classList.toggle('show-error', message !== '');
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+        return message === '';
+      }
+
+      input.addEventListener('blur', function () {
+        touched = true;
+        validate();
+      });
+
+      // Once an error is visible, clear it as soon as they fix it.
+      input.addEventListener('input', function () {
+        if (touched) validate();
+      });
+
+      form.addEventListener('submit', function (event) {
+        touched = true;
+        if (!validate()) {
+          event.preventDefault();
+          input.focus();
+          return;
+        }
+        // No backend exists yet for /subscribe, so show confirmation in place.
+        event.preventDefault();
+        form.classList.add('is-subscribed');
+      });
+    })();
+  </script>
+
 </body>
 
