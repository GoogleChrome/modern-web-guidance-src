+  <script>
+    // Mirror the CSS :user-invalid state for assistive tech. The browser owns the
+    // "has the user interacted yet" flag, so there's no touched/dirty tracking here.
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-email-error');
+
+      const sync = (isInvalid) => {
+        if (isInvalid) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+        error.lastChild.textContent = input.validity.valueMissing
+          ? ' Please enter your email address.'
+          : ' Please enter a valid email address, like you@example.com.';
+      };
+
+      // Blur shows the error (if the browser now considers it user-invalid);
+      // input clears it as soon as the value becomes valid.
+      input.addEventListener('blur', () => sync(input.matches(':user-invalid')));
+      input.addEventListener('input', () => sync(input.matches(':user-invalid')));
+      // A blocked submit attempt counts as interaction too.
+      input.addEventListener('invalid', () => sync(true));
+      form.addEventListener('reset', () => input.removeAttribute('aria-invalid'));
+    })();
+  </script>
+
 </body>
 
