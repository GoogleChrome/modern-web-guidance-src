diff --git a/scripts/selftest.mjs b/scripts/selftest.mjs
new file mode 100644
index 0000000..6c5126f
--- /dev/null
+++ b/scripts/selftest.mjs
@@ -0,0 +1,140 @@
+// Offline self-test for server/evp-verify.mjs.
+//
+// Mints an EVT+KB token the way a browser + email issuer would (throwaway
+// Ed25519 keys), then drives the verifier with injected DNS / HTTP stubs.
+// No network, no server. Run:  npm test
+import { generateKeyPairSync, sign, createHash } from 'node:crypto';
+import assert from 'node:assert/strict';
+import {
+  EvpError,
+  createIssuerClient,
+  verifyEmailVerificationToken,
+} from '../server/evp-verify.mjs';
+
+const b64u = (x) => Buffer.from(typeof x === 'string' ? x : x).toString('base64url');
+const sha256b64u = (s) => b64u(createHash('sha256').update(s).digest());
+
+function signJwt(header, payload, privateKey) {
+  const input = `${b64u(JSON.stringify(header))}.${b64u(JSON.stringify(payload))}`;
+  const sig = sign(null, Buffer.from(input), privateKey); // Ed25519
+  return `${input}.${b64u(sig)}`;
+}
+
+const ORIGIN = 'https://dailygrind.example';
+const ISSUER = 'https://issuer.example';
+const DOMAIN = 'mail.example';
+const EMAIL = `Barista@${DOMAIN}`;
+const NONCE = 'test-nonce-' + 'x'.repeat(22);
+const nowSec = Math.floor(Date.now() / 1000);
+
+// Issuer key (published in JWKS) and browser ephemeral key (bound via cnf).
+const issuerKeys = generateKeyPairSync('ed25519');
+const browserKeys = generateKeyPairSync('ed25519');
+const issuerJwk = { ...issuerKeys.publicKey.export({ format: 'jwk' }), kid: 'k1', alg: 'Ed25519', use: 'sig' };
+const browserJwk = { ...browserKeys.publicKey.export({ format: 'jwk' }), alg: 'Ed25519' };
+
+function mint({ email = EMAIL, iss = ISSUER, aud = ORIGIN, nonce = NONCE, evtIat = nowSec, kbIat = nowSec,
+  emailVerified = true, kbKey = browserKeys.privateKey, evtKey = issuerKeys.privateKey, tamperHash = false } = {}) {
+  const evt = signJwt(
+    { alg: 'Ed25519', kid: 'k1', typ: 'evt+jwt' },
+    { iss, iat: evtIat, cnf: { jwk: browserJwk }, email, email_verified: emailVerified },
+    evtKey,
+  ) + '~';
+  const kb = signJwt(
+    { alg: 'Ed25519', typ: 'kb+jwt' },
+    { aud, nonce, iat: kbIat, sd_hash: tamperHash ? sha256b64u(evt + 'x') : sha256b64u(evt) },
+    kbKey,
+  );
+  return evt + kb;
+}
+
+// Stubs standing in for DNS and the issuer's HTTPS endpoints.
+const fetched = [];
+const deps = {
+  resolveTxt: async (name) => {
+    assert.equal(name, `_email-verification.${DOMAIN}`);
+    return [['iss=', 'issuer.example']]; // split TXT chunks are joined
+  },
+  lookup: async () => [{ address: '203.0.113.10', family: 4 }],
+  fetchJson: async (url) => {
+    fetched.push(url);
+    if (url === `${ISSUER}/.well-known/email-verification`) {
+      return { issuer: ISSUER, issuance_endpoint: `${ISSUER}/issue`, jwks_uri: `${ISSUER}/keys`, signing_alg_values_supported: ['Ed25519'] };
+    }
+    if (url === `${ISSUER}/keys`) return { keys: [issuerJwk] };
+    throw new Error('unexpected fetch ' + url);
+  },
+};
+
+async function verify(token, extra = {}) {
+  const issuerClient = createIssuerClient({ fetchJson: deps.fetchJson, lookup: deps.lookup });
+  return verifyEmailVerificationToken(token, {
+    expectedOrigin: ORIGIN, expectedNonce: NONCE, issuerClient, resolveTxt: deps.resolveTxt, ...extra,
+  });
+}
+
+async function expectError(promise, code) {
+  try {
+    await promise;
+  } catch (err) {
+    assert.ok(err instanceof EvpError, `expected EvpError, got ${err}`);
+    assert.equal(err.code, code, `expected ${code}, got ${err.code}: ${err.message}`);
+    return;
+  }
+  assert.fail(`expected failure ${code}`);
+}
+
+const cases = [
+  ['valid token verifies and normalises the email', async () => {
+    const r = await verify(mint());
+    assert.equal(r.email, EMAIL.toLowerCase());
+    assert.equal(r.issuer, ISSUER);
+    assert.equal(r.isPrivateEmail, false);
+  }],
+  ['wrong audience is rejected', () => expectError(verify(mint({ aud: 'https://evil.example' })), 'audience_mismatch')],
+  ['wrong nonce is rejected', () => expectError(verify(mint({ nonce: 'other' })), 'nonce_mismatch')],
+  ['sd_hash mismatch is rejected', () => expectError(verify(mint({ tamperHash: true })), 'binding_mismatch')],
+  ['stale KB-JWT is rejected', () => expectError(verify(mint({ kbIat: nowSec - 3600 })), 'token_expired')],
+  ['stale EVT is rejected', () => expectError(verify(mint({ evtIat: nowSec - 3600 })), 'token_expired')],
+  ['email_verified=false is rejected', () => expectError(verify(mint({ emailVerified: false })), 'email_not_verified')],
+  ['issuer not authorised for the email domain is rejected',
+    () => expectError(verify(mint({ iss: 'https://rogue.example' })), 'issuer_mismatch')],
+  ['EVT signed by an unknown key is rejected', () => {
+    const rogue = generateKeyPairSync('ed25519');
+    return expectError(verify(mint({ evtKey: rogue.privateKey })), 'bad_signature');
+  }],
+  ['KB-JWT not signed by the cnf key is rejected (stolen token replay)', () => {
+    const thief = generateKeyPairSync('ed25519');
+    return expectError(verify(mint({ kbKey: thief.privateKey })), 'bad_signature');
+  }],
+  ['garbage input is rejected', () => expectError(verify('not~a~token'), 'malformed_token')],
+  ['domain without a TXT record is rejected', () =>
+    expectError(verify(mint(), { resolveTxt: async () => { const e = new Error('ENODATA'); e.code = 'ENODATA'; throw e; } }),
+      'issuer_discovery_failed')],
+  ['issuer overrides bypass DNS for testing', async () => {
+    const r = await verify(mint(), { resolveTxt: async () => { throw new Error('should not be called'); },
+      issuerOverrides: { [DOMAIN]: ISSUER } });
+    assert.equal(r.email, EMAIL.toLowerCase());
+  }],
+  ['issuer metadata and JWKS are cached per client', async () => {
+    fetched.length = 0;
+    const issuerClient = createIssuerClient({ fetchJson: deps.fetchJson, lookup: deps.lookup });
+    const opts = { expectedOrigin: ORIGIN, expectedNonce: NONCE, issuerClient, resolveTxt: deps.resolveTxt };
+    await verifyEmailVerificationToken(mint(), opts);
+    await verifyEmailVerificationToken(mint(), opts);
+    assert.equal(fetched.length, 2, 'metadata + jwks fetched exactly once');
+  }],
+];
+
+let failed = 0;
+for (const [name, fn] of cases) {
+  try {
+    await fn();
+    console.log(`  ok   ${name}`);
+  } catch (err) {
+    failed += 1;
+    console.log(`  FAIL ${name}\n       ${err.message}`);
+  }
+}
+console.log(failed ? `\n${failed} of ${cases.length} checks failed` : `\nAll ${cases.length} checks passed`);
+process.exit(failed ? 1 : 0);
