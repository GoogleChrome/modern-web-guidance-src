diff --git a/README.md b/README.md
new file mode 100644
index 0000000..ca58b3e
--- /dev/null
+++ b/README.md
@@ -0,0 +1,53 @@
+# The Daily Grind
+
+Static marketing site plus a small dependency-free Node server that powers the
+**Rewards sign-up form** on the homepage.
+
+```sh
+npm start          # node server/index.mjs  (PORT, PUBLIC_ORIGIN optional)
+npm test           # offline self-test of the token verifier, no network needed
+```
+
+## Browser-assisted email ownership verification
+
+The rewards form verifies that a customer owns their email address **without
+sending a one-time passcode or magic link**. It uses the Email Verification
+Protocol (WICG Email Verification API + IETF `draft-hardt-email-verification`):
+
+1. `GET /` renders `index.html` with a fresh, single-use, session-bound nonce
+   substituted for `__EVP_NONCE__` on the email input and on the hidden
+   `autocomplete="email-verification-token"` input.
+2. When the user picks an address from the browser's autofill suggestions, a
+   supporting browser asks the user's email provider (the *issuer*) for a signed
+   Email Verification Token and key-binds it to our origin and nonce
+   (`EVT~KB-JWT`, an SD-JWT+KB).
+3. The browser hands the token to the page either by filling the hidden input at
+   submit time (spec behaviour) or via the `emailverified` event on the email
+   input (`e.presentationToken`, Chrome Canary 145+ with
+   `chrome://flags/#email-verification-protocol`). `assets/rewards-signup.js`
+   handles both.
+4. `POST /api/rewards/verify-email` (JSON) or `POST /api/rewards/signup`
+   (no-JS form post, HTML response) runs `server/evp-verify.mjs`:
+   - KB-JWT: `typ=kb+jwt`, `aud` = our origin, `nonce` = one we issued to this
+     session (consumed on use), `iat` fresh, `sd_hash` = SHA-256 of the EVT.
+   - EVT: `typ=evt+jwt`, required claims, `email_verified: true`, freshness.
+   - Issuer discovery: DNS TXT `_email-verification.<email-domain>` must say
+     `iss=<EVT.iss>`.
+   - Issuer keys: `<iss>/.well-known/email-verification` → `jwks_uri` → key by
+     `kid` → EVT signature (Ed25519/ECDSA/RSA via `node:crypto`).
+   - Key binding: KB-JWT signature verified with `EVT.cnf.jwk`.
+   Only then is the member created. Without a token the request is rejected
+   with `verification_token_missing`; no fallback email is sent.
+
+### Configuration
+
+| Variable | Purpose |
+| --- | --- |
+| `PORT` | Listen port (default `11222`). |
+| `PUBLIC_ORIGIN` | Exact page origin, e.g. `https://dailygrind.example`. Set this in production; it is what the token's `aud` must equal. Falls back to the `Host` / `X-Forwarded-*` headers. |
+| `EVP_ISSUER_OVERRIDES` | JSON map `{"email-domain":"https://issuer"}` that bypasses DNS discovery for local testing. Never set in production. |
+
+Notes: do not deliver a `Content-Security-Policy` *header* on the homepage
+without re-checking the flow — header-delivered CSP makes browsers hide `nonce`
+content attributes from script. Member, nonce and rate-limit state is in-memory;
+swap `server/index.mjs` maps for a datastore before scaling out.
diff --git a/assets/rewards-signup.js b/assets/rewards-signup.js
new file mode 100644
index 0000000..d8e94c9
--- /dev/null
+++ b/assets/rewards-signup.js
@@ -0,0 +1,141 @@
+/*
+ * Daily Grind Rewards sign-up: browser-assisted email ownership verification.
+ *
+ * How it works (no passcode / magic-link email is ever sent):
+ *   1. The page is rendered with a single-use server nonce on the email field
+ *      and on the hidden "email-verification-token" field.
+ *   2. When the user picks their address from the browser's autofill
+ *      suggestions, a supporting browser (Email Verification Protocol) asks the
+ *      user's email provider for a signed proof of ownership and key-binds it to
+ *      our origin + nonce.
+ *   3. The browser hands us that proof either by filling the hidden field at
+ *      submit time (declarative spec) or by dispatching an "emailverified" event
+ *      with e.presentationToken on the email input (Chrome Canary 145+ with
+ *      #email-verification-protocol enabled).
+ *   4. We POST the proof to /api/rewards/verify-email, which validates it
+ *      against the issuer's published keys before creating the account.
+ */
+(function () {
+  'use strict';
+
+  var form = document.getElementById('rewards-signup-form');
+  if (!form) return;
+
+  var emailInput = form.elements.email;
+  var tokenInput = form.elements.email_verification_token;
+  var submitBtn = form.querySelector('button[type="submit"]');
+  var status = document.getElementById('rewards-status');
+  var verifiedBadge = document.getElementById('rewards-email-badge');
+  var successPanel = document.getElementById('rewards-success');
+  var PLACEHOLDER = '__EVP_NONCE__';
+  var eventToken = null;
+
+  function setStatus(message, kind) {
+    status.textContent = message || '';
+    status.className = 'form-status' + (kind ? ' form-status--' + kind : '');
+    status.hidden = !message;
+  }
+
+  function applyNonce(nonce) {
+    // setAttribute keeps the content attribute *and* the nonce IDL slot in sync.
+    emailInput.setAttribute('nonce', nonce);
+    tokenInput.setAttribute('nonce', nonce);
+    form.dataset.nonceReady = 'true';
+  }
+
+  // The server injects the nonce when it renders the page. If the page was
+  // served by a plain static host, fetch one from the API instead.
+  var nonceReady;
+  var current = tokenInput.getAttribute('nonce') || '';
+  if (current && current !== PLACEHOLDER) {
+    applyNonce(current);
+    nonceReady = Promise.resolve();
+  } else {
+    nonceReady = fetch('/api/rewards/nonce', { credentials: 'same-origin', headers: { accept: 'application/json' } })
+      .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
+      .then(function (data) { applyNonce(data.nonce); })
+      .catch(function () {
+        setStatus('We could not prepare secure sign-up right now. Please reload the page.', 'error');
+      });
+  }
+
+  // Chrome prototype surface: the browser dispatches "emailverified" on the
+  // email input once the provider has issued a key-bound proof.
+  emailInput.addEventListener('emailverified', function (e) {
+    if (e && typeof e.presentationToken === 'string' && e.presentationToken) {
+      eventToken = e.presentationToken;
+      tokenInput.value = eventToken;
+      verifiedBadge.hidden = false;
+      setStatus('');
+    }
+  });
+
+  // If the user edits the address after a proof was obtained, the proof no
+  // longer applies to what they typed.
+  emailInput.addEventListener('input', function () {
+    if (eventToken) {
+      eventToken = null;
+      tokenInput.value = '';
+      verifiedBadge.hidden = true;
+    }
+  });
+
+  function renderSuccess(member) {
+    form.hidden = true;
+    successPanel.hidden = false;
+    successPanel.querySelector('[data-first-name]').textContent = member.firstName;
+    successPanel.querySelector('[data-email]').textContent = member.email;
+  }
+
+  form.addEventListener('submit', function (e) {
+    var token = tokenInput.value || eventToken;
+    if (!token) {
+      // No proof is available to script. A spec-compliant browser fills the
+      // hidden field during native submission, so let the form post normally;
+      // the server answers with an HTML page either way.
+      if (form.dataset.nativeAttempt === 'true') {
+        e.preventDefault();
+        setStatus('Your browser has not confirmed that you own this address. Click into the email field and choose your address from the browser\'s suggestions (you need to be signed in to your email provider), then try again.', 'error');
+        return;
+      }
+      form.dataset.nativeAttempt = 'true';
+      return;
+    }
+
+    e.preventDefault();
+    submitBtn.disabled = true;
+    setStatus('Checking your email proof…', 'info');
+
+    nonceReady.then(function () {
+      return fetch('/api/rewards/verify-email', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'content-type': 'application/json', accept: 'application/json' },
+        body: JSON.stringify({
+          first_name: form.elements.first_name.value,
+          email: emailInput.value,
+          marketing_opt_in: form.elements.marketing_opt_in.checked,
+          email_verification_token: token
+        })
+      });
+    }).then(function (res) {
+      return res.json().then(function (data) { return { res: res, data: data }; });
+    }).then(function (out) {
+      if (out.res.ok && out.data.ok) {
+        renderSuccess(out.data.member);
+        return;
+      }
+      setStatus(out.data.message || 'We could not verify your email address. Please try again.', 'error');
+      if (out.data.code === 'nonce_invalid') {
+        // Nonces are single-use; get a fresh one so the next attempt can succeed.
+        nonceReady = fetch('/api/rewards/nonce', { credentials: 'same-origin' })
+          .then(function (r) { return r.json(); })
+          .then(function (d) { applyNonce(d.nonce); eventToken = null; tokenInput.value = ''; verifiedBadge.hidden = true; });
+      }
+    }).catch(function () {
+      setStatus('Network error while verifying your email. Please try again.', 'error');
+    }).then(function () {
+      submitBtn.disabled = false;
+    });
+  });
+})();
