+// Email Verification Protocol (EVP) token verifier.
+//
+// Verifies an "EVT+KB" presentation token produced by a browser that supports
+// browser-assisted email ownership verification (WICG Email Verification API /
+// draft-hardt-email-verification). The token proves that the user controls the
+// email address *without* the site sending a one-time passcode or magic link.
+//
+// Token shape:   <issuer-signed EVT>~[<disclosure>~...]<KB-JWT>
+//   - EVT     : JWT signed by the email issuer (e.g. the mail provider). Claims:
+//               iss, iat, cnf.jwk (browser's ephemeral public key), email,
+//               email_verified (must be true), optional is_private_email.
+//   - KB-JWT  : JWT signed by the browser's ephemeral key. Claims:
+//               aud (our origin), nonce (our per-page nonce), iat,
+//               sd_hash (SHA-256 of everything before the KB-JWT, incl. the '~').
+//
+// Verification (per draft section 2.8 / 5.3 / 6.5):
+//   1. Parse, check KB-JWT typ/aud/nonce/iat/sd_hash.
+//   2. Parse EVT, check header + required claims (+ any disclosures).
+//   3. Discover the issuer for the email's domain via DNS TXT
+//      _email-verification.<domain> -> "iss=<issuer>", confirm it equals EVT.iss.
+//   4. Fetch <issuer>/.well-known/email-verification -> jwks_uri -> JWKS,
+//      select key by kid, verify EVT signature.
+//   5. Verify KB-JWT signature with EVT.cnf.jwk (key binding).
+//
+// No third-party dependencies: node:crypto handles Ed25519/ECDSA/RSA.
+
+import {
+  createHash,
+  createPublicKey,
+  timingSafeEqual,
+  verify as cryptoVerify,
+  constants as cryptoConstants,
+} from 'node:crypto';
+import { promises as dns } from 'node:dns';
+import { isIP } from 'node:net';
+
+export class EvpError extends Error {
+  constructor(code, message, status = 400) {
+    super(message);
+    this.name = 'EvpError';
+    this.code = code;
+    this.status = status;
+  }
+}
+
+const MAX_TOKEN_LENGTH = 8192;
+const TOKEN_CHARSET = /^[A-Za-z0-9_.~-]+$/;
+const ACCEPTED_EVT_TYPES = new Set(['evt+jwt', 'evp-sd-jwt', 'dc+sd-jwt', 'vc+sd-jwt']);
+const KB_JWT_TYPE = 'kb+jwt';
+
+// --- base64url helpers -----------------------------------------------------
+
+export const b64u = {
+  decode(str) {
+    if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+      throw new EvpError('malformed_token', 'Invalid base64url segment');
+    }
+    return Buffer.from(str, 'base64url');
+  },
+  encode(buf) {
+    return Buffer.from(buf).toString('base64url');
+  },
+};
+
+export function sha256b64u(input) {
+  return b64u.encode(createHash('sha256').update(input, 'utf8').digest());
+}
+
+function safeEqual(a, b) {
+  if (typeof a !== 'string' || typeof b !== 'string') return false;
+  const ab = Buffer.from(a, 'utf8');
+  const bb = Buffer.from(b, 'utf8');
+  if (ab.length !== bb.length) return false;
+  return timingSafeEqual(ab, bb);
+}
+
+function parseJsonObject(buf, what) {
+  let value;
+  try {
+    value = JSON.parse(buf.toString('utf8'));
+  } catch {
+    throw new EvpError('malformed_token', `${what} is not valid JSON`);
+  }
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new EvpError('malformed_token', `${what} must be a JSON object`);
+  }
+  return value;
+}
+
+export function decodeJwt(compact, what = 'JWT') {
+  if (typeof compact !== 'string') throw new EvpError('malformed_token', `${what} missing`);
+  const parts = compact.split('.');
+  if (parts.length !== 3 || parts.some((p) => p.length === 0)) {
+    throw new EvpError('malformed_token', `${what} must have three segments`);
+  }
+  const header = parseJsonObject(b64u.decode(parts[0]), `${what} header`);
+  const payload = parseJsonObject(b64u.decode(parts[1]), `${what} payload`);
+  const signature = b64u.decode(parts[2]);
+  return { header, payload, signature, signingInput: `${parts[0]}.${parts[1]}` };
+}
+
+// --- JWS signature verification -------------------------------------------
+
+const ALGS = {
+  EdDSA: { kty: 'OKP', crv: ['Ed25519', 'Ed448'], digest: null },
+  Ed25519: { kty: 'OKP', crv: ['Ed25519'], digest: null },
+  ES256: { kty: 'EC', crv: ['P-256'], digest: 'sha256', dsaEncoding: 'ieee-p1363' },
+  ES384: { kty: 'EC', crv: ['P-384'], digest: 'sha384', dsaEncoding: 'ieee-p1363' },
+  ES512: { kty: 'EC', crv: ['P-521'], digest: 'sha512', dsaEncoding: 'ieee-p1363' },
+  RS256: { kty: 'RSA', digest: 'sha256', padding: cryptoConstants.RSA_PKCS1_PADDING },
+  RS384: { kty: 'RSA', digest: 'sha384', padding: cryptoConstants.RSA_PKCS1_PADDING },
+  RS512: { kty: 'RSA', digest: 'sha512', padding: cryptoConstants.RSA_PKCS1_PADDING },
+  PS256: { kty: 'RSA', digest: 'sha256', padding: cryptoConstants.RSA_PKCS1_PSS_PADDING, saltLength: 32 },
+  PS384: { kty: 'RSA', digest: 'sha384', padding: cryptoConstants.RSA_PKCS1_PSS_PADDING, saltLength: 48 },
+  PS512: { kty: 'RSA', digest: 'sha512', padding: cryptoConstants.RSA_PKCS1_PSS_PADDING, saltLength: 64 },
+};
+
+// Only the public members of a JWK are imported; private members are rejected.
+const PUBLIC_JWK_MEMBERS = new Set(['kty', 'crv', 'x', 'y', 'n', 'e']);
+const PRIVATE_JWK_MEMBERS = ['d', 'p', 'q', 'dp', 'dq', 'qi', 'k'];
+
+export function importPublicJwk(jwk, alg) {
+  if (!jwk || typeof jwk !== 'object') throw new EvpError('invalid_key', 'JWK missing');
+  for (const m of PRIVATE_JWK_MEMBERS) {
+    if (m in jwk) throw new EvpError('invalid_key', 'JWK contains private key material');
+  }
+  const spec = ALGS[alg];
+  if (!spec) throw new EvpError('unsupported_alg', `Unsupported JWS algorithm "${alg}"`);
+  if (jwk.kty !== spec.kty) throw new EvpError('invalid_key', `JWK kty "${jwk.kty}" does not match alg ${alg}`);
+  if (spec.crv && !spec.crv.includes(jwk.crv)) {
+    throw new EvpError('invalid_key', `JWK crv "${jwk.crv}" does not match alg ${alg}`);
+  }
+  if (jwk.alg && jwk.alg !== alg) throw new EvpError('invalid_key', `JWK alg "${jwk.alg}" does not match ${alg}`);
+  const clean = {};
+  for (const [k, v] of Object.entries(jwk)) if (PUBLIC_JWK_MEMBERS.has(k)) clean[k] = v;
+  let key;
+  try {
+    key = createPublicKey({ key: clean, format: 'jwk' });
+  } catch (err) {
+    throw new EvpError('invalid_key', `JWK could not be imported: ${err.message}`);
+  }
+  if (spec.kty === 'RSA' && key.asymmetricKeyDetails?.modulusLength < 2048) {
+    throw new EvpError('invalid_key', 'RSA key too small');
+  }
+  return { key, spec };
+}
+
+export function verifyJws(alg, jwk, signingInput, signature) {
+  const { key, spec } = importPublicJwk(jwk, alg);
+  const keyOpts = { key };
+  if (spec.dsaEncoding) keyOpts.dsaEncoding = spec.dsaEncoding;
+  if (spec.padding !== undefined) keyOpts.padding = spec.padding;
+  if (spec.saltLength !== undefined) keyOpts.saltLength = spec.saltLength;
+  try {
+    return cryptoVerify(spec.digest, Buffer.from(signingInput, 'utf8'), keyOpts, signature);
+  } catch {
+    return false;
+  }
+}
+
+// --- Issuer discovery & metadata ------------------------------------------
+
+export function normalizeIssuer(value) {
+  if (typeof value !== 'string' || value.length === 0 || value.length > 253 + 8) {
+    throw new EvpError('issuer_invalid', 'Issuer identifier missing');
+  }
+  const withScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(value) ? value : `https://${value}`;
+  let url;
+  try {
+    url = new URL(withScheme);
+  } catch {
+    throw new EvpError('issuer_invalid', 'Issuer identifier is not a valid URL');
+  }
+  if (url.protocol !== 'https:') throw new EvpError('issuer_invalid', 'Issuer must use https');
+  if (url.username || url.password || url.search || url.hash || (url.pathname && url.pathname !== '/')) {
+    throw new EvpError('issuer_invalid', 'Issuer must be a bare https origin');
+  }
+  return url.origin;
+}
+
+export function emailDomain(email) {
+  if (typeof email !== 'string') throw new EvpError('invalid_email', 'Email missing');
+  const trimmed = email.trim();
+  const at = trimmed.lastIndexOf('@');
+  if (at <= 0 || at === trimmed.length - 1 || trimmed.length > 254 || /\s/.test(trimmed)) {
+    throw new EvpError('invalid_email', 'Email address is malformed');
+  }
+  const domainRaw = trimmed.slice(at + 1);
+  let host;
+  try {
+    host = new URL(`https://${domainRaw}/`).hostname;
+  } catch {
+    throw new EvpError('invalid_email', 'Email domain is malformed');
+  }
+  if (host !== domainRaw.toLowerCase() || isIP(host) || !host.includes('.')) {
+    throw new EvpError('invalid_email', 'Email domain is not a valid host name');
+  }
+  return host;
+}
+
+// Guard outbound fetches derived from untrusted input (issuer URLs) against
+// hitting loopback / link-local / private networks (basic SSRF protection).
+function isPrivateAddress(addr) {
+  if (isIP(addr) === 4) {
+    const [a, b] = addr.split('.').map(Number);
+    return (
+      a === 0 || a === 10 || a === 127 || (a === 169 && b === 254) ||
+      (a === 172 && b >= 16 && b <= 31) || (a === 192 && b === 168) ||
+      (a === 100 && b >= 64 && b <= 127) || a >= 224
+    );
+  }
+  const v6 = addr.toLowerCase();
+  if (v6 === '::' || v6 === '::1') return true;
+  if (v6.startsWith('fe8') || v6.startsWith('fe9') || v6.startsWith('fea') || v6.startsWith('feb')) return true;
+  if (v6.startsWith('fc') || v6.startsWith('fd')) return true;
+  if (v6.startsWith('::ffff:')) return isPrivateAddress(v6.slice(7));
+  return false;
+}
+
+export async function assertPublicHttpsUrl(urlString, lookup = dns.lookup) {
+  let url;
+  try {
+    url = new URL(urlString);
+  } catch {
+    throw new EvpError('issuer_invalid', 'Issuer URL is malformed');
+  }
+  if (url.protocol !== 'https:') throw new EvpError('issuer_invalid', 'Issuer URLs must use https');
+  const host = url.hostname.replace(/^\[|\]$/g, '');
+  if (isIP(host) || host === 'localhost' || host.endsWith('.localhost') || host.endsWith('.local') ||
+      host.endsWith('.internal') || !host.includes('.')) {
+    throw new EvpError('issuer_invalid', 'Issuer host is not a public host name');
+  }
+  const addrs = await lookup(host, { all: true });
+  if (!addrs.length || addrs.some((a) => isPrivateAddress(a.address))) {
+    throw new EvpError('issuer_invalid', 'Issuer host resolves to a non-public address');
+  }
+  return url;
+}
+
+export async function discoverIssuerForDomain(domain, deps) {
+  if (deps.issuerOverrides && Object.hasOwn(deps.issuerOverrides, domain)) {
+    return normalizeIssuer(deps.issuerOverrides[domain]);
+  }
+  let records;
+  try {
+    records = await deps.resolveTxt(`_email-verification.${domain}`);
+  } catch (err) {
+    throw new EvpError('issuer_discovery_failed',
+      `No email verification issuer is published for ${domain} (${err.code || err.message})`, 422);
+  }
+  const issValues = records
+    .map((chunks) => (Array.isArray(chunks) ? chunks.join('') : String(chunks)).trim())
+    .filter((r) => r.startsWith('iss='));
+  if (issValues.length !== 1) {
+    throw new EvpError('issuer_discovery_failed',
+      `Expected exactly one iss= TXT record for ${domain}, found ${issValues.length}`, 422);
+  }
+  return normalizeIssuer(issValues[0].slice(4).trim());
+}
+
+export function createIssuerClient({
+  fetchJson,
+  lookup = dns.lookup,
+  cacheTtlMs = 60 * 60 * 1000,
+  now = Date.now,
+} = {}) {
+  const metadataCache = new Map();
+  const jwksCache = new Map();
+
+  async function getMetadata(issuer) {
+    const cached = metadataCache.get(issuer);
+    if (cached && cached.expires > now()) return cached.value;
+    const url = await assertPublicHttpsUrl(`${issuer}/.well-known/email-verification`, lookup);
+    const meta = await fetchJson(url.href);
+    if (!meta || typeof meta !== 'object') throw new EvpError('issuer_metadata_invalid', 'Issuer metadata is not an object', 502);
+    if (meta.issuer !== undefined && normalizeIssuer(meta.issuer) !== issuer) {
+      throw new EvpError('issuer_metadata_invalid', 'Issuer metadata "issuer" does not match', 502);
+    }
+    if (typeof meta.jwks_uri !== 'string') throw new EvpError('issuer_metadata_invalid', 'Issuer metadata lacks jwks_uri', 502);
+    if (Array.isArray(meta.signing_alg_values_supported)) {
+      for (const alg of meta.signing_alg_values_supported) {
+        if (alg === 'none' || /^HS/.test(alg)) throw new EvpError('issuer_metadata_invalid', 'Issuer advertises forbidden alg', 502);
+      }
+    }
+    metadataCache.set(issuer, { value: meta, expires: now() + cacheTtlMs });
+    return meta;
+  }
+
+  async function getJwks(issuer, jwksUri, { force = false } = {}) {
+    const cached = jwksCache.get(issuer);
+    if (!force && cached && cached.expires > now()) return cached.value;
+    const url = await assertPublicHttpsUrl(jwksUri, lookup);
+    const jwks = await fetchJson(url.href);
+    if (!jwks || !Array.isArray(jwks.keys)) throw new EvpError('issuer_jwks_invalid', 'JWKS lacks keys array', 502);
+    jwksCache.set(issuer, { value: jwks, expires: now() + cacheTtlMs });
+    return jwks;
+  }
+
+  async function findSigningKey(issuer, kid) {
+    const meta = await getMetadata(issuer);
+    let jwks = await getJwks(issuer, meta.jwks_uri);
+    let key = jwks.keys.find((k) => k && k.kid === kid);
+    if (!key) {
+      // Key may have rotated since we cached the JWKS; refetch once.
+      jwks = await getJwks(issuer, meta.jwks_uri, { force: true });
+      key = jwks.keys.find((k) => k && k.kid === kid);
+    }
+    if (!key) throw new EvpError('unknown_signing_key', `Issuer has no key with kid "${kid}"`);
+    if (key.use && key.use !== 'sig') throw new EvpError('invalid_key', 'Key is not a signing key');
+    return { key, metadata: meta };
+  }
+
+  return { getMetadata, getJwks, findSigningKey };
+}
+
+export function createHttpJsonFetcher({ timeoutMs = 5000, maxBytes = 256 * 1024 } = {}) {
+  return async function fetchJson(url) {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), timeoutMs);
+    try {
+      const res = await fetch(url, {
+        signal: controller.signal,
+        redirect: 'error',
+        headers: { accept: 'application/json' },
+      });
+      if (!res.ok) throw new EvpError('issuer_fetch_failed', `GET ${url} -> HTTP ${res.status}`, 502);
+      const len = Number(res.headers.get('content-length') || 0);
+      if (len > maxBytes) throw new EvpError('issuer_fetch_failed', 'Issuer document too large', 502);
+      const text = await res.text();
+      if (text.length > maxBytes) throw new EvpError('issuer_fetch_failed', 'Issuer document too large', 502);
+      return JSON.parse(text);
+    } catch (err) {
+      if (err instanceof EvpError) throw err;
+      throw new EvpError('issuer_fetch_failed', `Could not fetch ${url}: ${err.message}`, 502);
+    } finally {
+      clearTimeout(timer);
+    }
+  };
+}
+
+// --- Selective disclosure (defensive; the draft does not use it) -----------
+
+function applyDisclosures(payload, disclosures) {
+  if (disclosures.length === 0) return payload;
+  const alg = payload._sd_alg ?? 'sha-256';
+  if (alg !== 'sha-256') throw new EvpError('unsupported_alg', `Unsupported _sd_alg "${alg}"`);
+  const digests = new Set(Array.isArray(payload._sd) ? payload._sd : []);
+  const claims = { ...payload };
+  delete claims._sd;
+  delete claims._sd_alg;
+  for (const disclosure of disclosures) {
+    if (!digests.has(sha256b64u(disclosure))) {
+      throw new EvpError('malformed_token', 'Disclosure digest is not referenced by the issuer JWT');
+    }
+    let decoded;
+    try {
+      decoded = JSON.parse(b64u.decode(disclosure).toString('utf8'));
+    } catch {
+      throw new EvpError('malformed_token', 'Disclosure is not valid JSON');
+    }
+    if (!Array.isArray(decoded) || decoded.length !== 3 || typeof decoded[1] !== 'string') {
+      throw new EvpError('malformed_token', 'Disclosure must be [salt, name, value]');
+    }
+    const [, name, value] = decoded;
+    if (name.startsWith('_sd') || name === '...' || Object.hasOwn(claims, name)) {
+      throw new EvpError('malformed_token', `Disclosure for "${name}" is not permitted`);
+    }
+    claims[name] = value;
+  }
+  return claims;
+}
+
+// --- Main entry point -------------------------------------------------------
+
+function requireNumber(value, what) {
+  if (typeof value !== 'number' || !Number.isFinite(value)) throw new EvpError('malformed_token', `${what} must be a number`);
+  return value;
+}
+
+/**
+ * Verify an EVT+KB presentation token.
+ *
+ * @param {string} token
+ * @param {object} opts
+ * @param {string} opts.expectedOrigin   Our origin, e.g. "https://dailygrind.example"
+ * @param {string} opts.expectedNonce    The nonce we issued for this page render
+ * @param {object} opts.issuerClient     From createIssuerClient()
+ * @param {function} [opts.resolveTxt]   DNS TXT resolver (default node:dns)
+ * @param {object} [opts.issuerOverrides] { "domain": "https://issuer" } for testing
+ * @param {number} [opts.nowMs]
+ * @param {number} [opts.maxAgeSeconds]  Max token age (both EVT and KB-JWT)
+ * @param {number} [opts.clockSkewSeconds]
+ * @returns {Promise<{email:string, issuer:string, isPrivateEmail:boolean, evtIssuedAt:number, kbIssuedAt:number}>}
+ */
+export async function verifyEmailVerificationToken(token, opts) {
+  const {
+    expectedOrigin,
+    expectedNonce,
+    issuerClient,
+    resolveTxt = dns.resolveTxt,
+    issuerOverrides,
+    nowMs = Date.now(),
+    maxAgeSeconds = 10 * 60,
+    clockSkewSeconds = 60,
+  } = opts ?? {};
+  if (!expectedOrigin || !expectedNonce || !issuerClient) {
+    throw new Error('verifyEmailVerificationToken: expectedOrigin, expectedNonce and issuerClient are required');
+  }
+
+  // 1. Structural checks -----------------------------------------------------
+  if (typeof token !== 'string' || token.length === 0) throw new EvpError('malformed_token', 'Token missing');
+  if (token.length > MAX_TOKEN_LENGTH) throw new EvpError('malformed_token', 'Token too long');
+  if (!TOKEN_CHARSET.test(token)) throw new EvpError('malformed_token', 'Token contains invalid characters');
+
+  const segments = token.split('~');
+  if (segments.length < 2) throw new EvpError('malformed_token', 'Token must contain an issuer JWT and a KB-JWT separated by "~"');
+  const kbCompact = segments[segments.length - 1];
+  if (!kbCompact) throw new EvpError('malformed_token', 'Key-binding JWT missing');
+  const evtString = segments.slice(0, -1).join('~') + '~';
+  const disclosures = segments.slice(1, -1).filter((d) => d.length > 0);
+  const nowSec = Math.floor(nowMs / 1000);
+
+  // 2. KB-JWT claims -----------------------------------------------------------
+  const kb = decodeJwt(kbCompact, 'KB-JWT');
+  if (kb.header.typ !== KB_JWT_TYPE) throw new EvpError('malformed_token', `KB-JWT typ must be "${KB_JWT_TYPE}"`);
+  if (typeof kb.header.alg !== 'string' || kb.header.alg === 'none') throw new EvpError('unsupported_alg', 'KB-JWT alg invalid');
+  if (typeof kb.payload.aud !== 'string' || kb.payload.aud !== expectedOrigin) {
+    throw new EvpError('audience_mismatch', 'Token was not issued for this site');
+  }
+  if (!safeEqual(kb.payload.nonce, expectedNonce)) throw new EvpError('nonce_mismatch', 'Token nonce does not match this session');
+  const kbIat = requireNumber(kb.payload.iat, 'KB-JWT iat');
+  if (kbIat > nowSec + clockSkewSeconds) throw new EvpError('token_not_yet_valid', 'KB-JWT issued in the future');
+  if (nowSec - kbIat > maxAgeSeconds) throw new EvpError('token_expired', 'KB-JWT is too old');
+  if (!safeEqual(kb.payload.sd_hash, sha256b64u(evtString))) {
+    throw new EvpError('binding_mismatch', 'KB-JWT sd_hash does not match the issuer token');
+  }
+
+  // 3. EVT claims ----------------------------------------------------------------
+  const evt = decodeJwt(segments[0], 'EVT');
+  if (!ACCEPTED_EVT_TYPES.has(evt.header.typ)) throw new EvpError('malformed_token', `Unexpected EVT typ "${evt.header.typ}"`);
+  if (typeof evt.header.alg !== 'string' || evt.header.alg === 'none' || /^HS/.test(evt.header.alg)) {
+    throw new EvpError('unsupported_alg', 'EVT alg invalid');
+  }
+  if (typeof evt.header.kid !== 'string' || !evt.header.kid) throw new EvpError('malformed_token', 'EVT kid missing');
+  const claims = applyDisclosures(evt.payload, disclosures);
+  if (typeof claims.iss !== 'string') throw new EvpError('malformed_token', 'EVT iss missing');
+  const evtIat = requireNumber(claims.iat, 'EVT iat');
+  if (evtIat > nowSec + clockSkewSeconds) throw new EvpError('token_not_yet_valid', 'EVT issued in the future');
+  if (nowSec - evtIat > maxAgeSeconds) throw new EvpError('token_expired', 'EVT is too old');
+  if (claims.exp !== undefined && requireNumber(claims.exp, 'EVT exp') <= nowSec - clockSkewSeconds) {
+    throw new EvpError('token_expired', 'EVT has expired');
+  }
+  if (!claims.cnf || typeof claims.cnf !== 'object' || !claims.cnf.jwk || typeof claims.cnf.jwk !== 'object') {
+    throw new EvpError('malformed_token', 'EVT cnf.jwk missing');
+  }
+  if (typeof claims.email !== 'string') throw new EvpError('malformed_token', 'EVT email missing');
+  if (claims.email_verified !== true) throw new EvpError('email_not_verified', 'Issuer did not assert email_verified');
+  const email = claims.email.trim();
+  const domain = emailDomain(email);
+  const tokenIssuer = normalizeIssuer(claims.iss);
+
+  // 4. Issuer discovery + EVT signature --------------------------------------
+  const discoveredIssuer = await discoverIssuerForDomain(domain, { resolveTxt, issuerOverrides });
+  if (discoveredIssuer !== tokenIssuer) {
+    throw new EvpError('issuer_mismatch', `Issuer ${tokenIssuer} is not authorised for ${domain}`);
+  }
+  const { key: issuerJwk, metadata } = await issuerClient.findSigningKey(tokenIssuer, evt.header.kid);
+  if (Array.isArray(metadata.signing_alg_values_supported) && metadata.signing_alg_values_supported.length &&
+      !metadata.signing_alg_values_supported.includes(evt.header.alg)) {
+    throw new EvpError('unsupported_alg', 'EVT alg is not advertised by the issuer');
+  }
+  if (!verifyJws(evt.header.alg, issuerJwk, evt.signingInput, evt.signature)) {
+    throw new EvpError('bad_signature', 'EVT signature is invalid');
+  }
+
+  // 5. Key binding: KB-JWT signed by the key the issuer bound into the EVT -------
+  const cnfJwk = claims.cnf.jwk;
+  if (cnfJwk.alg !== undefined && cnfJwk.alg !== kb.header.alg) {
+    throw new EvpError('binding_mismatch', 'KB-JWT alg does not match cnf.jwk alg');
+  }
+  if (!verifyJws(kb.header.alg, cnfJwk, kb.signingInput, kb.signature)) {
+    throw new EvpError('bad_signature', 'KB-JWT signature is invalid');
+  }
+
+  return {
+    email: email.toLowerCase(),
+    issuer: tokenIssuer,
+    isPrivateEmail: claims.is_private_email === true,
+    evtIssuedAt: evtIat,
+    kbIssuedAt: kbIat,
+  };
+}
diff --git a/server/index.mjs b/server/index.mjs
new file mode 100644
index 0000000..7e048ff
--- /dev/null
+++ b/server/index.mjs
@@ -0,0 +1,351 @@
+// The Daily Grind web server.
+//
+// Serves the static homepage and exposes the rewards sign-up API. The sign-up
+// flow relies on browser-assisted email ownership verification (Email
+// Verification Protocol): the page carries a per-render nonce, the browser
+// obtains a signed token from the user's email provider, and
+// POST /api/rewards/verify-email validates that token. No passcode or magic
+// link email is ever sent.
+//
+// Run with:  npm start      (PORT and PUBLIC_ORIGIN are optional env vars)
+
+import { createServer } from 'node:http';
+import { createReadStream, promises as fs } from 'node:fs';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { extname, join, normalize, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  EvpError,
+  createHttpJsonFetcher,
+  createIssuerClient,
+  decodeJwt,
+  verifyEmailVerificationToken,
+} from './evp-verify.mjs';
+
+const ROOT = resolve(fileURLToPath(new URL('..', import.meta.url)));
+const PORT = Number(process.env.PORT || 11222);
+// Set PUBLIC_ORIGIN in production (e.g. https://dailygrind.example). It must be
+// the exact origin of the page, because the token's "aud" claim is bound to it.
+const PUBLIC_ORIGIN = process.env.PUBLIC_ORIGIN || null;
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const SESSION_COOKIE = 'dg_sid';
+const NONCE_PLACEHOLDER = '__EVP_NONCE__';
+const MAX_BODY_BYTES = 32 * 1024;
+// Optional dev/testing hook: {"example.com":"https://issuer.example"} skips DNS
+// discovery for the listed email domains. Never set this in production.
+const ISSUER_OVERRIDES = process.env.EVP_ISSUER_OVERRIDES ? JSON.parse(process.env.EVP_ISSUER_OVERRIDES) : undefined;
+
+const issuerClient = createIssuerClient({ fetchJson: createHttpJsonFetcher() });
+
+// --- In-memory state (swap for a database / cache in production) -----------
+const nonces = new Map();   // nonce -> { sid, expires }
+const members = new Map();  // email -> { id, firstName, email, issuer, createdAt }
+const rateBuckets = new Map(); // ip -> { count, resetAt }
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [n, v] of nonces) if (v.expires <= now) nonces.delete(n);
+  for (const [ip, b] of rateBuckets) if (b.resetAt <= now) rateBuckets.delete(ip);
+}, 60 * 1000).unref();
+
+// --- Helpers ------------------------------------------------------------------
+
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+};
+
+function parseCookies(header = '') {
+  const out = {};
+  for (const part of header.split(';')) {
+    const i = part.indexOf('=');
+    if (i > 0) out[part.slice(0, i).trim()] = decodeURIComponent(part.slice(i + 1).trim());
+  }
+  return out;
+}
+
+function requestOrigin(req) {
+  if (PUBLIC_ORIGIN) return PUBLIC_ORIGIN;
+  const proto = (req.headers['x-forwarded-proto'] || '').split(',')[0].trim() || 'http';
+  const host = req.headers['x-forwarded-host'] || req.headers.host || `localhost:${PORT}`;
+  return `${proto}://${host}`;
+}
+
+function ensureSession(req, res) {
+  const cookies = parseCookies(req.headers.cookie);
+  let sid = cookies[SESSION_COOKIE];
+  if (!sid || !/^[A-Za-z0-9_-]{32,64}$/.test(sid)) {
+    sid = randomBytes(32).toString('base64url');
+    const secure = requestOrigin(req).startsWith('https://') ? '; Secure' : '';
+    res.setHeader('Set-Cookie', `${SESSION_COOKIE}=${sid}; Path=/; HttpOnly; SameSite=Lax; Max-Age=86400${secure}`);
+  }
+  return sid;
+}
+
+function issueNonce(sid) {
+  const nonce = randomBytes(32).toString('base64url'); // 256 bits of entropy
+  nonces.set(nonce, { sid, expires: Date.now() + NONCE_TTL_MS });
+  return nonce;
+}
+
+// Consumes the nonce (single use) and confirms it belongs to this session.
+function consumeNonce(nonce, sid) {
+  if (typeof nonce !== 'string') return false;
+  const entry = nonces.get(nonce);
+  if (!entry) return false;
+  nonces.delete(nonce);
+  return entry.sid === sid && entry.expires > Date.now();
+}
+
+function rateLimited(req, limit = 30) {
+  const ip = req.socket.remoteAddress || 'unknown';
+  const now = Date.now();
+  let b = rateBuckets.get(ip);
+  if (!b || b.resetAt <= now) {
+    b = { count: 0, resetAt: now + 60 * 1000 };
+    rateBuckets.set(ip, b);
+  }
+  b.count += 1;
+  return b.count > limit;
+}
+
+function readBody(req) {
+  return new Promise((resolvePromise, reject) => {
+    const chunks = [];
+    let size = 0;
+    req.on('data', (c) => {
+      size += c.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(new EvpError('payload_too_large', 'Request body too large', 413));
+        req.destroy();
+        return;
+      }
+      chunks.push(c);
+    });
+    req.on('end', () => resolvePromise(Buffer.concat(chunks)));
+    req.on('error', reject);
+  });
+}
+
+function parseBody(req, raw) {
+  const type = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+  if (type === 'application/json') {
+    try {
+      const v = JSON.parse(raw.toString('utf8'));
+      if (!v || typeof v !== 'object' || Array.isArray(v)) throw new Error();
+      return v;
+    } catch {
+      throw new EvpError('bad_request', 'Body must be a JSON object');
+    }
+  }
+  if (type === 'application/x-www-form-urlencoded') {
+    return Object.fromEntries(new URLSearchParams(raw.toString('utf8')));
+  }
+  throw new EvpError('unsupported_media_type', 'Send JSON or form-encoded data', 415);
+}
+
+function wantsHtml(req) {
+  const accept = req.headers.accept || '';
+  return accept.includes('text/html') && !accept.includes('application/json');
+}
+
+function escapeHtml(s) {
+  return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+}
+
+function sendJson(res, status, body) {
+  res.writeHead(status, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' });
+  res.end(JSON.stringify(body));
+}
+
+function sendHtml(res, status, title, message, extra = '') {
+  res.writeHead(status, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' });
+  res.end(`<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+<title>${escapeHtml(title)} | The Daily Grind</title>
+<style>body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;color:#3e2723;background:#fafafa;margin:0;padding:40px 20px}
+main{max-width:560px;margin:0 auto;background:#fff;border-radius:8px;padding:32px;box-shadow:0 2px 5px rgba(0,0,0,.1)}
+h1{color:#4e342e;margin-top:0}a.btn{display:inline-block;background:#4e342e;color:#fff;padding:10px 20px;border-radius:5px;text-decoration:none;margin-top:16px}</style></head>
+<body><main><h1>${escapeHtml(title)}</h1><p>${escapeHtml(message)}</p>${extra}<a class="btn" href="/#rewards-signup">Back to The Daily Grind</a></main></body></html>`);
+}
+
+function sameOriginOrReject(req, origin) {
+  const o = req.headers.origin;
+  if (o && o !== origin) throw new EvpError('forbidden', 'Cross-origin requests are not allowed', 403);
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') throw new EvpError('forbidden', 'Cross-site requests are not allowed', 403);
+}
+
+function cleanName(value) {
+  const name = typeof value === 'string' ? value.trim().replace(/\s+/g, ' ') : '';
+  if (name.length < 1 || name.length > 80) throw new EvpError('invalid_name', 'Please enter your first name (1-80 characters)');
+  return name;
+}
+
+// --- Route handlers ------------------------------------------------------------
+
+async function serveHomepage(req, res) {
+  const sid = ensureSession(req, res);
+  const nonce = issueNonce(sid);
+  const html = await fs.readFile(join(ROOT, 'index.html'), 'utf8');
+  res.writeHead(200, {
+    'content-type': MIME['.html'],
+    // The page embeds a single-use nonce, so it must not be cached.
+    'cache-control': 'no-store',
+    'referrer-policy': 'strict-origin-when-cross-origin',
+    'x-content-type-options': 'nosniff',
+  });
+  res.end(html.replaceAll(NONCE_PLACEHOLDER, nonce));
+}
+
+async function serveStatic(req, res, pathname) {
+  // Only files under /assets are served statically; everything else is explicit.
+  const rel = normalize(decodeURIComponent(pathname)).replace(/^(\.\.[/\\])+/, '');
+  const file = resolve(ROOT, '.' + rel);
+  if (!file.startsWith(join(ROOT, 'assets') + sep)) return notFound(res);
+  let stat;
+  try {
+    stat = await fs.stat(file);
+  } catch {
+    return notFound(res);
+  }
+  if (!stat.isFile()) return notFound(res);
+  res.writeHead(200, {
+    'content-type': MIME[extname(file).toLowerCase()] || 'application/octet-stream',
+    'content-length': stat.size,
+    'cache-control': 'public, max-age=300',
+    'x-content-type-options': 'nosniff',
+  });
+  createReadStream(file).pipe(res);
+}
+
+function notFound(res) {
+  res.writeHead(404, { 'content-type': 'text/plain; charset=utf-8' });
+  res.end('Not found');
+}
+
+function handleNonce(req, res) {
+  // Fallback for environments where the HTML is served statically and the
+  // placeholder nonce could not be injected server-side.
+  if (rateLimited(req, 60)) return sendJson(res, 429, { ok: false, code: 'rate_limited' });
+  const sid = ensureSession(req, res);
+  sendJson(res, 200, { nonce: issueNonce(sid), expiresInSeconds: NONCE_TTL_MS / 1000 });
+}
+
+async function handleSignup(req, res) {
+  const origin = requestOrigin(req);
+  const html = wantsHtml(req);
+  const fail = (err) => {
+    const e = err instanceof EvpError ? err : new EvpError('server_error', 'Something went wrong on our end', 500);
+    if (!(err instanceof EvpError)) console.error(err);
+    if (html) return sendHtml(res, e.status, 'We could not finish your sign-up', e.message);
+    return sendJson(res, e.status, { ok: false, code: e.code, message: e.message });
+  };
+
+  try {
+    if (rateLimited(req, 20)) throw new EvpError('rate_limited', 'Too many attempts, please try again in a minute', 429);
+    sameOriginOrReject(req, origin);
+    const sid = ensureSession(req, res);
+    const body = parseBody(req, await readBody(req));
+
+    const firstName = cleanName(body.first_name ?? body.firstName);
+    const typedEmail = typeof body.email === 'string' ? body.email.trim().toLowerCase() : '';
+    const token = body.email_verification_token ?? body.token;
+    const marketing = body.marketing_opt_in === 'on' || body.marketing_opt_in === true || body.marketing_opt_in === 'true';
+
+    if (typeof token !== 'string' || token.length === 0) {
+      throw new EvpError(
+        'verification_token_missing',
+        'Your browser did not provide proof that you own this email address. Choose your address from your browser\'s suggestions in the email field, then try again.',
+        422,
+      );
+    }
+
+    // The nonce travels inside the KB-JWT. Look it up (unverified) so we can
+    // bind the verification to a nonce we issued to *this* session.
+    let kbNonce;
+    try {
+      const kbCompact = token.slice(token.lastIndexOf('~') + 1);
+      kbNonce = decodeJwt(kbCompact, 'KB-JWT').payload.nonce;
+    } catch {
+      throw new EvpError('malformed_token', 'The verification token is malformed');
+    }
+    if (!consumeNonce(kbNonce, sid)) {
+      throw new EvpError('nonce_invalid', 'This sign-up form has expired. Please reload the page and try again.', 422);
+    }
+
+    const result = await verifyEmailVerificationToken(token, {
+      expectedOrigin: origin,
+      expectedNonce: kbNonce,
+      issuerClient,
+      issuerOverrides: ISSUER_OVERRIDES,
+    });
+
+    if (typedEmail && typedEmail !== result.email) {
+      throw new EvpError('email_mismatch', 'The verified address does not match the one in the form. Please pick the address again.', 422);
+    }
+    if (members.has(result.email)) {
+      throw new EvpError('already_registered', 'A rewards account already exists for this email address.', 409);
+    }
+
+    const member = {
+      id: randomUUID(),
+      firstName,
+      email: result.email,
+      issuer: result.issuer,
+      isPrivateEmail: result.isPrivateEmail,
+      marketingOptIn: marketing,
+      emailVerifiedAt: new Date().toISOString(),
+      createdAt: new Date().toISOString(),
+    };
+    members.set(member.email, member);
+    console.log(`[rewards] new member ${member.id} (${member.email}) verified via ${member.issuer}`);
+
+    if (html) {
+      return sendHtml(res, 201, `Welcome to Daily Grind Rewards, ${firstName}!`,
+        `Your email address ${member.email} was verified by your browser. Your first free drink is waiting.`);
+    }
+    return sendJson(res, 201, {
+      ok: true,
+      member: { id: member.id, firstName: member.firstName, email: member.email, emailVerified: true },
+      verification: { method: 'browser_email_verification', issuer: member.issuer, isPrivateEmail: member.isPrivateEmail },
+    });
+  } catch (err) {
+    return fail(err);
+  }
+}
+
+// --- Router -----------------------------------------------------------------------
+
+const server = createServer(async (req, res) => {
+  const url = new URL(req.url, 'http://localhost');
+  const { pathname } = url;
+  try {
+    if (req.method === 'GET' || req.method === 'HEAD') {
+      if (pathname === '/' || pathname === '/index.html') return await serveHomepage(req, res);
+      if (pathname === '/api/rewards/nonce') return handleNonce(req, res);
+      if (pathname.startsWith('/assets/')) return await serveStatic(req, res, pathname);
+      if (pathname === '/healthz') return sendJson(res, 200, { ok: true });
+      return notFound(res);
+    }
+    if (req.method === 'POST') {
+      if (pathname === '/api/rewards/verify-email' || pathname === '/api/rewards/signup') return await handleSignup(req, res);
+      return notFound(res);
+    }
+    res.writeHead(405, { allow: 'GET, HEAD, POST' });
+    res.end();
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) sendJson(res, 500, { ok: false, code: 'server_error' });
+    else res.end();
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on http://localhost:${PORT} (expected origin: ${PUBLIC_ORIGIN || 'derived from Host header'})`);
+});
