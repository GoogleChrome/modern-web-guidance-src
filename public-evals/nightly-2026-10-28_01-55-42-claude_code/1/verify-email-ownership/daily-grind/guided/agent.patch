+/**
+ * The Daily Grind — request handler (framework-free, node:http).
+ *
+ *  GET  /                          homepage, rendered with a fresh per-request
+ *                                  Email Verification nonce (Cache-Control: no-store)
+ *  POST /api/rewards/verify-email  rewards sign-up: verifies the browser-issued
+ *                                  Email Verification Token, otherwise falls back
+ *                                  to a traditional confirmation e-mail
+ *  GET  /<static file>             everything else in the project root
+ *
+ * `createApp()` returns the handler so tests can run it on an ephemeral port
+ * with injected dependencies. `server.mjs` is the thin entrypoint.
+ */
+import { readFile, stat } from 'node:fs/promises';
+import { randomBytes, scrypt as scryptCb } from 'node:crypto';
+import { promisify } from 'node:util';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { NonceStore } from './nonce-store.mjs';
+import { verifyEmailVerificationToken } from './email-verification.mjs';
+
+const scrypt = promisify(scryptCb);
+const DEFAULT_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const SESSION_COOKIE = 'dg_sid';
+const NONCE_PLACEHOLDER = '__EMAIL_VERIFICATION_NONCE__';
+const MAX_BODY_BYTES = 64 * 1024;
+
+const STATIC_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.mjs': 'text/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+  '.txt': 'text/plain; charset=utf-8',
+  '.woff2': 'font/woff2',
+};
+const PRIVATE_PATHS = ['/server.mjs', '/package.json', '/pnpm-lock.yaml', '/lib/', '/test/', '/node_modules/', '/.'];
+
+
+// --------------------------------------------------------------------------
+// helpers
+// --------------------------------------------------------------------------
+const escapeHtml = (value) =>
+  String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+function parseCookies(header = '') {
+  const out = {};
+  for (const part of header.split(';')) {
+    const idx = part.indexOf('=');
+    if (idx === -1) continue;
+    out[part.slice(0, idx).trim()] = decodeURIComponent(part.slice(idx + 1).trim());
+  }
+  return out;
+}
+
+function requestOrigin(req, env) {
+  if (env.RP_ORIGIN) return env.RP_ORIGIN;
+  const proto = (req.headers['x-forwarded-proto'] || '').split(',')[0].trim() || (req.socket.encrypted ? 'https' : 'http');
+  const host = req.headers['x-forwarded-host'] || req.headers.host || 'localhost';
+  return `${proto}://${host}`;
+}
+
+/** Returns the session id, creating one (and a Set-Cookie header) when missing. */
+function ensureSession(req, res, env) {
+  const existing = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  if (existing && /^[A-Za-z0-9_-]{32,64}$/.test(existing)) return existing;
+  const sid = NonceStore.newSessionId();
+  // Secure is kept on for localhost too: browsers treat http://localhost as a secure context.
+  // INSECURE_COOKIES=1 drops it for plain-http access over a LAN IP during development.
+  const secure = env.INSECURE_COOKIES === '1' ? '' : ' Secure;';
+  res.setHeader('Set-Cookie', `${SESSION_COOKIE}=${sid}; Path=/; HttpOnly;${secure} SameSite=Lax; Max-Age=${60 * 60 * 24}`);
+  return sid;
+}
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { 'Content-Length': Buffer.byteLength(body), ...headers });
+  res.end(body);
+}
+
+const sendJson = (res, status, data, headers = {}) =>
+  send(res, status, JSON.stringify(data), { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store', ...headers });
+
+function wantsJson(req) {
+  const accept = req.headers.accept || '';
+  return accept.includes('application/json') && !accept.includes('text/html');
+}
+
+async function readBody(req) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > MAX_BODY_BYTES) throw Object.assign(new Error('Request body too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+async function hashPassword(password) {
+  const salt = randomBytes(16);
+  const derived = await scrypt(password, salt, 64);
+  return `scrypt$${salt.toString('base64url')}$${Buffer.from(derived).toString('base64url')}`;
+}
+
+
+/**
+ * @param {object} [options]
+ * @param {string} [options.root]        directory to serve (defaults to the project root)
+ * @param {object} [options.env]         environment (RP_ORIGIN, ORIGIN_TRIAL_TOKEN, INSECURE_COOKIES)
+ * @param {Function} [options.verifyToken] override for verifyEmailVerificationToken (tests)
+ * @param {NonceStore} [options.nonces]  nonce session store
+ * @param {Map} [options.accounts]       account store (demo: in-memory, keyed by lower-cased e-mail)
+ */
+export function createApp({
+  root = DEFAULT_ROOT,
+  env = process.env,
+  verifyToken = verifyEmailVerificationToken,
+  nonces = new NonceStore(),
+  accounts = new Map(),
+} = {}) {
+  // --------------------------------------------------------------------------
+  // GET /  — render homepage with a fresh nonce
+  // --------------------------------------------------------------------------
+  async function renderHomepage(req, res) {
+    const template = await readFile(path.join(root, 'index.html'), 'utf8');
+    const sid = ensureSession(req, res, env);
+    const nonce = nonces.issue(sid);
+    const html = template.replaceAll(NONCE_PLACEHOLDER, nonce);
+    const headers = {
+      'Content-Type': 'text/html; charset=utf-8',
+      // MANDATORY: never cache a page that embeds a single-use nonce.
+      'Cache-Control': 'no-store',
+      'Referrer-Policy': 'strict-origin-when-cross-origin',
+      'X-Content-Type-Options': 'nosniff',
+    };
+    if (env.ORIGIN_TRIAL_TOKEN) headers['Origin-Trial'] = env.ORIGIN_TRIAL_TOKEN;
+    send(res, 200, html, headers);
+  }
+
+  // --------------------------------------------------------------------------
+  // POST /api/rewards/verify-email
+  // --------------------------------------------------------------------------
+  function validateSignup(fields) {
+    const errors = {};
+    const name = String(fields.get('name') || '').trim();
+    const email = String(fields.get('email') || '').trim();
+    const password = String(fields.get('password') || '');
+    if (!name || name.length > 100) errors.name = 'Please tell us your name (up to 100 characters).';
+    // Mirrors the permissive HTML type="email" check; the EVT/e-mail step is the real proof.
+    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254) errors.email = 'Please enter a valid email address.';
+    if (password.length < 8 || password.length > 256) errors.password = 'Your password must be at least 8 characters.';
+    return { errors, name, email, password };
+  }
+
+  /**
+   * Fallback path: we could not prove ownership in-browser, so send a standard
+   * confirmation e-mail. No mail provider is wired up in this demo, so we log it.
+   */
+  async function sendTraditionalVerificationEmail(account) {
+    const code = randomBytes(3).readUIntBE(0, 3).toString().padStart(6, '0').slice(-6);
+    account.pendingCode = code;
+    console.log(`[rewards] would e-mail confirmation code ${code} to ${account.email}`);
+  }
+
+  async function handleRewardsSignup(req, res) {
+    const rpOrigin = requestOrigin(req, env);
+
+    // CSRF layering on top of the SameSite=Lax cookie: reject cross-site posts outright.
+    const origin = req.headers.origin;
+    if ((origin && origin !== rpOrigin) || req.headers['sec-fetch-site'] === 'cross-site') {
+      return sendJson(res, 403, { status: 'error', message: 'Cross-origin form submissions are not accepted.' });
+    }
+
+    const contentType = (req.headers['content-type'] || '').split(';')[0].trim();
+    if (contentType !== 'application/x-www-form-urlencoded') {
+      return sendJson(res, 415, { status: 'error', message: 'Send the form as application/x-www-form-urlencoded.' });
+    }
+
+    let fields;
+    try {
+      fields = new URLSearchParams(await readBody(req));
+    } catch (err) {
+      return sendJson(res, err.status || 400, { status: 'error', message: err.message });
+    }
+
+    // Atomically read + delete the single-use nonce the moment the POST arrives.
+    const sid = ensureSession(req, res, env);
+    const expectedNonce = nonces.consume(sid);
+    // Any response other than success re-arms the form with a fresh nonce.
+    const reissue = () => ({ nextNonce: nonces.issue(sid) });
+
+    const { errors, name, email, password } = validateSignup(fields);
+    if (Object.keys(errors).length > 0) {
+      return respond(req, res, 400, { status: 'invalid', message: 'Please fix the highlighted fields.', errors, ...reissue() });
+    }
+    const key = email.toLowerCase();
+    if (accounts.has(key)) {
+      return respond(req, res, 409, {
+        status: 'exists',
+        message: 'There is already a rewards account for that email. Try signing in instead.',
+        errors: { email: 'This email already has a rewards account.' },
+        ...reissue(),
+      });
+    }
+
+    const rawToken = String(fields.get('token') || '').trim();
+    let verifiedByBrowser = false;
+    let issuer = null;
+    if (rawToken && expectedNonce) {
+      try {
+        ({ issuer } = await verifyToken(
+          { rawToken, submittedEmail: email, expectedNonce, expectedAudience: rpOrigin },
+        ));
+        verifiedByBrowser = true;
+      } catch (err) {
+        // Log, then degrade gracefully to the e-mail confirmation path.
+        console.error(`[rewards] email verification token check failed (${err.code ?? 'unknown'}):`, err.message);
+      }
+    }
+
+    const account = {
+      id: randomBytes(8).toString('hex'),
+      name,
+      email,
+      passwordHash: await hashPassword(password),
+      emailVerified: verifiedByBrowser,
+      verificationMethod: verifiedByBrowser ? 'email-verification-protocol' : 'email-confirmation',
+      issuer,
+      createdAt: new Date().toISOString(),
+    };
+    accounts.set(key, account);
+
+    if (verifiedByBrowser) {
+      console.log(`[rewards] account ${account.id} created; ${email} verified via ${issuer}`);
+      return respond(req, res, 201, {
+        status: 'verified',
+        email,
+        message: `Welcome to Daily Grind Rewards, ${name}! Your email was verified instantly by your browser — your 50 welcome points are ready.`,
+      });
+    }
+
+    await sendTraditionalVerificationEmail(account);
+    return respond(req, res, 202, {
+      status: 'pending_email',
+      email,
+      message: `Thanks, ${name}! We've sent a confirmation link to ${email}. Open it to activate your rewards account.`,
+    });
+  }
+
+  /** JSON for the fetch()-enhanced form, a small HTML page for plain form posts. */
+  function respond(req, res, status, data) {
+    if (wantsJson(req)) return sendJson(res, status, data);
+    const ok = data.status === 'verified' || data.status === 'pending_email';
+    const html = `<!DOCTYPE html>
+  <html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${ok ? 'Rewards sign-up' : 'Something needs attention'} | The Daily Grind</title>
+  <style>body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;color:#3e2723;background:#fafafa;margin:0;padding:3rem 1.25rem;line-height:1.6}
+  main{max-width:34rem;margin:auto;background:#fff;padding:2rem;border-radius:8px;box-shadow:0 2px 5px rgba(0,0,0,.1)}
+  h1{color:#4e342e;margin-top:0}a{color:#4e342e}ul{padding-left:1.25rem}</style></head>
+  <body><main><h1>${ok ? 'Daily Grind Rewards' : 'Please check your details'}</h1>
+  <p>${escapeHtml(data.message)}</p>
+  ${data.errors ? `<ul>${Object.values(data.errors).map((m) => `<li>${escapeHtml(m)}</li>`).join('')}</ul>` : ''}
+  <p><a href="/#rewards-signup">${ok ? 'Back to the homepage' : 'Back to the sign-up form'}</a></p></main></body></html>`;
+    send(res, status, html, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
+  }
+
+  // --------------------------------------------------------------------------
+  // static files
+  // --------------------------------------------------------------------------
+  async function serveStatic(req, res, pathname) {
+    if (PRIVATE_PATHS.some((p) => pathname === p || pathname.startsWith(p)) || pathname.includes('/.')) {
+      return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+    }
+    const filePath = path.normalize(path.join(root, decodeURIComponent(pathname)));
+    if (!filePath.startsWith(root + path.sep)) return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+    const type = STATIC_TYPES[path.extname(filePath).toLowerCase()];
+    try {
+      const info = await stat(filePath);
+      if (!info.isFile() || !type) throw new Error('not a file');
+      const body = await readFile(filePath);
+      send(res, 200, body, { 'Content-Type': type, 'Cache-Control': 'public, max-age=300', 'X-Content-Type-Options': 'nosniff' });
+    } catch {
+      send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+    }
+  }
+
+  // --------------------------------------------------------------------------
+  // router
+  // --------------------------------------------------------------------------
+  async function handle(req, res) {
+    const url = new URL(req.url, 'http://placeholder');
+    try {
+      if (req.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) return await renderHomepage(req, res);
+      if (url.pathname === '/api/rewards/verify-email') {
+        if (req.method !== 'POST') return send(res, 405, 'Method Not Allowed', { Allow: 'POST', 'Content-Type': 'text/plain; charset=utf-8' });
+        return await handleRewardsSignup(req, res);
+      }
+      if (req.method === 'GET' || req.method === 'HEAD') return await serveStatic(req, res, url.pathname);
+      return send(res, 405, 'Method Not Allowed', { 'Content-Type': 'text/plain; charset=utf-8' });
+    } catch (err) {
+      console.error(err);
+      if (!res.headersSent) send(res, 500, 'Internal Server Error', { 'Content-Type': 'text/plain; charset=utf-8' });
+      else res.end();
+    }
+  }
+
+  return handle;
+}
diff --git a/lib/email-verification.mjs b/lib/email-verification.mjs
new file mode 100644
index 0000000..e5fe9ca
--- /dev/null
+++ b/lib/email-verification.mjs
@@ -0,0 +1,244 @@
+/**
+ * Server-side verification of an Email Verification Token (EVT) presentation
+ * produced by the browser's Email Verification API
+ * (hidden <input autocomplete="email-verification-token" nonce="...">).
+ *
+ * The presentation is an SD-JWT: `<issuer EVT>~<disclosures...>~<KB-JWT>`.
+ * We verify, in order:
+ *   1. structure + `email_verified === true` + e-mail matches the form (case-insensitive)
+ *   2. the e-mail domain delegates to `iss` via `_email-verification.<domain>` DNS TXT
+ *   3. `${iss}/.well-known/email-verification` metadata + JWKS
+ *   4. EVT signature (issuer key) and KB-JWT signature (browser's ephemeral key),
+ *      including nonce, audience, freshness and sd_hash binding.
+ *
+ * All parsing/signature work is delegated to @sd-jwt/core and jose; nothing is
+ * hand-rolled. Everything here is untrusted input until `sdJwt.verify` resolves.
+ */
+import { createHash } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// TODO: Remove 'EdDSA' once live issuers (e.g. Gmail) and Chrome Origin Trial builds finish
+// transitioning from 'EdDSA' (with crv: 'Ed25519') to 'Ed25519'.
+export const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const EVT_TYP = 'ev+sd-jwt';
+const MAX_TOKEN_AGE = '5m';
+const CLOCK_TOLERANCE = '1m';
+const KB_MAX_AGE_SECONDS = 300;
+const SKEW_SECONDS = 60;
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+export class EmailVerificationError extends Error {
+  constructor(message, code) {
+    super(message);
+    this.name = 'EmailVerificationError';
+    this.code = code;
+  }
+}
+
+const fail = (message, code) => {
+  throw new EmailVerificationError(message, code);
+};
+
+/** The KB-JWT audience is the RP origin; it must be a secure origin. */
+function isAcceptableAudience(origin) {
+  if (typeof origin !== 'string') return false;
+  let url;
+  try {
+    url = new URL(origin);
+  } catch {
+    return false;
+  }
+  if (url.origin !== origin) return false; // no path, query or trailing slash
+  if (url.protocol === 'https:') return true;
+  return url.protocol === 'http:' && ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname);
+}
+
+/** Small in-memory cache for issuer discovery so every sign-up does not re-fetch the JWKS. */
+const issuerCache = new Map();
+const ISSUER_CACHE_TTL_MS = 10 * 60 * 1000;
+
+/**
+ * Confirms that `domain` delegates e-mail verification to exactly `iss`
+ * via a `_email-verification.<domain>` TXT record of the form `iss=<host>`.
+ */
+export async function assertDnsDelegation(domain, iss, resolveTxt = dns.resolveTxt) {
+  let records;
+  try {
+    records = (await resolveTxt(`_email-verification.${domain}`)).map((chunks) => chunks.join(''));
+  } catch (err) {
+    fail(`No _email-verification DNS record for "${domain}" (${err?.code ?? err?.message ?? err}).`, 'dns');
+  }
+  const delegated = records.some((txt) => {
+    const value = txt.trim();
+    return value.startsWith('iss=') && `https://${value.slice(4).trim()}` === iss;
+  });
+  if (!delegated) fail(`Issuer "${iss}" is not delegated via DNS for "${domain}".`, 'dns');
+}
+
+/**
+ * Fetches `${iss}/.well-known/email-verification`, validates it and returns a
+ * jose key-set function for the issuer's JWKS.
+ */
+export async function loadIssuerKeySet(iss, { fetch: fetchImpl = globalThis.fetch, now = Date.now } = {}) {
+  const cached = issuerCache.get(iss);
+  if (cached && cached.expiresAt > now()) return cached.keySet;
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') fail('Issuer must use HTTPS.', 'issuer');
+
+  const metadataResponse = await fetchImpl(discoveryUrl, { headers: { accept: 'application/json' } });
+  if (!metadataResponse.ok) fail(`Issuer metadata request failed (${metadataResponse.status}).`, 'issuer');
+  const metadata = await metadataResponse.json();
+  if (metadata?.issuer !== iss || typeof metadata.jwks_uri !== 'string' || !metadata.jwks_uri.startsWith('https://')) {
+    fail('Invalid issuer metadata or non-HTTPS jwks_uri.', 'issuer');
+  }
+
+  const jwksResponse = await fetchImpl(new URL(metadata.jwks_uri), { headers: { accept: 'application/json' } });
+  if (!jwksResponse.ok) fail(`Issuer JWKS request failed (${jwksResponse.status}).`, 'issuer');
+  const jwks = await jwksResponse.json();
+  if (!Array.isArray(jwks?.keys) || jwks.keys.length === 0) fail('Issuer JWKS is empty.', 'issuer');
+
+  const keySet = createLocalJWKSet(jwks);
+  issuerCache.set(iss, { keySet, expiresAt: now() + ISSUER_CACHE_TTL_MS });
+  return keySet;
+}
+
+/** Test hook: drop cached issuer metadata. */
+export function clearIssuerCache() {
+  issuerCache.clear();
+}
+
+/**
+ * Verifies an `EVT~KB-JWT` presentation submitted from the sign-up form.
+ *
+ * @param {object} params
+ * @param {string} params.rawToken        value of the hidden `token` field (untrusted)
+ * @param {string} params.submittedEmail  e-mail typed into the form (untrusted)
+ * @param {string} params.expectedNonce   single-use nonce consumed from server-side session state
+ * @param {string} params.expectedAudience public origin of this relying party, e.g. https://dailygrind.example
+ * @param {object} [deps]                 injectable `resolveTxt`, `fetch`, `now` (used by tests)
+ * @returns {Promise<{ email: string, issuer: string, payload: object }>}
+ */
+export async function verifyEmailVerificationToken(
+  { rawToken, submittedEmail, expectedNonce, expectedAudience },
+  deps = {},
+) {
+  if (typeof rawToken !== 'string' || rawToken.length === 0) fail('No email verification token submitted.', 'missing-token');
+  if (typeof expectedNonce !== 'string' || expectedNonce.length === 0) fail('No pending nonce for this session.', 'missing-nonce');
+  if (typeof submittedEmail !== 'string' || !submittedEmail.includes('@')) fail('Submitted e-mail is malformed.', 'email');
+  if (!isAcceptableAudience(expectedAudience)) fail('Relying-party origin must be an https origin (or http://localhost for development).', 'config');
+
+  // ---- Step 1: parse the SD-JWT and check the e-mail claims ----------------
+  let decoded;
+  try {
+    decoded = decodeSdJwtSync(rawToken, hasher);
+  } catch (err) {
+    fail(`Token is not a well-formed SD-JWT (${err?.message ?? err}).`, 'format');
+  }
+  const evtPayload = decoded.jwt.payload;
+  const iss = evtPayload.iss;
+
+  if (!decoded.kbJwt) fail('Presentation is missing the Key Binding JWT.', 'format');
+  if (typeof iss !== 'string' || !iss.startsWith('https://')) fail('EVT is missing an https issuer claim.', 'format');
+  if (decoded.jwt.header.typ !== EVT_TYP) fail(`EVT typ must be "${EVT_TYP}".`, 'format');
+  if (evtPayload.email_verified !== true) fail('EVT does not assert email_verified === true.', 'claims');
+  // MANDATORY: compare e-mail addresses case-insensitively, but keep the submitted string.
+  if (typeof evtPayload.email !== 'string' || evtPayload.email.toLowerCase() !== submittedEmail.trim().toLowerCase()) {
+    fail('Submitted email does not match the EVT email claim.', 'claims');
+  }
+
+  // ---- Step 2: DNS delegation, then issuer discovery + JWKS -----------------
+  const domain = submittedEmail.trim().split('@').pop().toLowerCase();
+  await assertDnsDelegation(domain, iss, deps.resolveTxt);
+  const issuerJwks = await loadIssuerKeySet(iss, deps);
+
+  // ---- Step 3: verify EVT signature and KB-JWT binding ---------------------
+  const currentDate = deps.now ? Math.floor(deps.now() / 1000) : undefined;
+  const evtOptions = {
+    typ: EVT_TYP,
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: MAX_TOKEN_AGE,
+    clockTolerance: CLOCK_TOLERANCE,
+    ...(currentDate ? { currentDate: new Date(currentDate * 1000) } : {}),
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and several JWKS keys match the header,
+        // jose throws JWKSMultipleMatchingKeys, which yields each candidate key.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {
+            /* try next key */
+          }
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderJwk ||
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new EmailVerificationError('Missing, disallowed, or mismatched KB-JWT algorithm.', 'kb-alg');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: MAX_TOKEN_AGE,
+        clockTolerance: CLOCK_TOLERANCE,
+        ...(currentDate ? { currentDate: new Date(currentDate * 1000) } : {}),
+      });
+      return true;
+    },
+  });
+
+  let verified;
+  try {
+    // `keyBindingNonce` MUST be supplied: @sd-jwt/core only runs kbVerifier and checks
+    // nonce / aud / iat / sd_hash when it is present.
+    verified = await sdJwt.verify(rawToken, {
+      requiredClaimKeys: ['email', 'email_verified'],
+      keyBindingNonce: expectedNonce,
+      expectedKeyBindingAudience: expectedAudience,
+      keyBindingMaxAgeSeconds: KB_MAX_AGE_SECONDS,
+      allowedIssuerAlgorithms: ALLOWED_ALGS,
+      allowedKeyBindingAlgorithms: ALLOWED_ALGS,
+      skewSeconds: SKEW_SECONDS,
+      ...(currentDate ? { currentDate } : {}),
+    });
+  } catch (err) {
+    if (err instanceof EmailVerificationError) throw err;
+    fail(`Token verification failed: ${err?.message ?? err}`, 'signature');
+  }
+
+  return { email: evtPayload.email, issuer: iss, payload: verified.payload };
+}
diff --git a/lib/nonce-store.mjs b/lib/nonce-store.mjs
new file mode 100644
index 0000000..a0f06ee
--- /dev/null
+++ b/lib/nonce-store.mjs
@@ -0,0 +1,65 @@
+/**
+ * Server-side session state for Email Verification nonces.
+ *
+ * Each form render gets a fresh >=128-bit nonce. The nonce is stored here,
+ * keyed by an opaque session id that lives in an HttpOnly cookie, so the client
+ * never holds the expected value itself. `consume()` reads and deletes in one
+ * step so a captured token cannot be replayed.
+ *
+ * This is an in-memory Map, which is fine for a single-process deployment.
+ * Swap it for Redis (or similar) if the site runs on more than one instance.
+ */
+import { randomBytes } from 'node:crypto';
+
+const DEFAULT_TTL_MS = 30 * 60 * 1000; // user has 30 minutes to finish the form
+const SWEEP_INTERVAL_MS = 60 * 1000;
+
+export class NonceStore {
+  #entries = new Map();
+  #ttlMs;
+  #timer;
+
+  constructor({ ttlMs = DEFAULT_TTL_MS, sweepIntervalMs = SWEEP_INTERVAL_MS } = {}) {
+    this.#ttlMs = ttlMs;
+    if (sweepIntervalMs > 0) {
+      this.#timer = setInterval(() => this.sweep(), sweepIntervalMs);
+      this.#timer.unref?.();
+    }
+  }
+
+  /** Creates a new opaque session id for the HttpOnly cookie. */
+  static newSessionId() {
+    return randomBytes(32).toString('base64url');
+  }
+
+  /** Generates and stores a fresh nonce for `sessionId`, replacing any previous one. */
+  issue(sessionId) {
+    const nonce = randomBytes(32).toString('base64url'); // 256 bits of entropy
+    this.#entries.set(sessionId, { nonce, expiresAt: Date.now() + this.#ttlMs });
+    return nonce;
+  }
+
+  /** Atomically reads and deletes the pending nonce. Returns `null` when none is pending. */
+  consume(sessionId) {
+    if (!sessionId) return null;
+    const entry = this.#entries.get(sessionId);
+    this.#entries.delete(sessionId);
+    if (!entry || entry.expiresAt <= Date.now()) return null;
+    return entry.nonce;
+  }
+
+  sweep() {
+    const now = Date.now();
+    for (const [sid, entry] of this.#entries) {
+      if (entry.expiresAt <= now) this.#entries.delete(sid);
+    }
+  }
+
+  get size() {
+    return this.#entries.size;
+  }
+
+  close() {
+    if (this.#timer) clearInterval(this.#timer);
+  }
+}
