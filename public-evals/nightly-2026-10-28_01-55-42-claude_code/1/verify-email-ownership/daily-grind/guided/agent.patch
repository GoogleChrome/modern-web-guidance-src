@@ -0,0 +1,22 @@
+/**
+ * The Daily Grind — server entrypoint.
+ *
+ * Environment:
+ *  PORT                 listen port (default 11222)
+ *  RP_ORIGIN            public origin of this site, e.g. https://dailygrind.example
+ *                       (defaults to the origin of the incoming request)
+ *  ORIGIN_TRIAL_TOKEN   Chrome Origin Trial token for the Email Verification API;
+ *                       sent as the `Origin-Trial` response header when set
+ *  INSECURE_COOKIES=1   drop the Secure cookie flag for plain-http LAN development
+ */
+import { createServer } from 'node:http';
+import { createApp } from './lib/app.mjs';
+
+const PORT = Number(process.env.PORT) || 11222;
+
+createServer(createApp()).listen(PORT, () => {
+  console.log(`The Daily Grind listening on http://localhost:${PORT}`);
+  if (!process.env.ORIGIN_TRIAL_TOKEN) {
+    console.log('ORIGIN_TRIAL_TOKEN not set — the Email Verification API stays dormant in Chrome until it is.');
+  }
+});
diff --git a/test/app.test.mjs b/test/app.test.mjs
new file mode 100644
index 0000000..df8d6ac
--- /dev/null
+++ b/test/app.test.mjs
@@ -0,0 +1,183 @@
+/**
+ * End-to-end checks for the rewards sign-up endpoint using the app handler on
+ * an ephemeral port with an injected token verifier (no network, no real issuer).
+ */
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { createApp } from '../lib/app.mjs';
+import { NonceStore } from '../lib/nonce-store.mjs';
+
+const RP_ORIGIN = 'https://dailygrind.example';
+const calls = [];
+const nonces = new NonceStore({ sweepIntervalMs: 0 });
+const accounts = new Map();
+
+const app = createApp({
+  env: { RP_ORIGIN },
+  nonces,
+  accounts,
+  verifyToken: async (params) => {
+    calls.push(params);
+    if (params.rawToken === 'GOOD') return { email: params.submittedEmail, issuer: 'https://issuer.example', payload: {} };
+    throw Object.assign(new Error('bad token'), { code: 'signature' });
+  },
+});
+
+let server;
+let base;
+before(async () => {
+  server = createServer(app);
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+after(() => new Promise((resolve) => server.close(resolve)));
+
+const cookieOf = (res) => (res.headers.get('set-cookie') || '').split(';')[0];
+const nonceOf = (html) => html.match(/name="token" nonce="([^"]+)"/)[1];
+
+async function loadForm() {
+  const res = await fetch(`${base}/`);
+  const html = await res.text();
+  return { res, html, cookie: cookieOf(res), nonce: nonceOf(html) };
+}
+
+async function signup({ cookie, body, accept = 'application/json' }) {
+  const res = await fetch(`${base}/api/rewards/verify-email`, {
+    method: 'POST',
+    headers: {
+      'content-type': 'application/x-www-form-urlencoded',
+      accept,
+      origin: RP_ORIGIN,
+      ...(cookie ? { cookie } : {}),
+    },
+    body: new URLSearchParams(body),
+  });
+  return { res, data: accept === 'application/json' ? await res.json() : await res.text() };
+}
+
+test('homepage renders a fresh nonce per request, no-store, with a session cookie', async () => {
+  const a = await loadForm();
+  const b = await loadForm();
+  assert.equal(a.res.status, 200);
+  assert.equal(a.res.headers.get('cache-control'), 'no-store');
+  assert.match(a.res.headers.get('set-cookie'), /^dg_sid=[A-Za-z0-9_-]+; Path=\/; HttpOnly; Secure; SameSite=Lax/);
+  assert.match(a.html, /autocomplete="email-verification-token"/);
+  assert.match(a.html, /<form id="rewards-form" method="POST" action="\/api\/rewards\/verify-email">/);
+  assert.ok(a.nonce.length >= 43, 'nonce should carry >= 256 bits');
+  assert.notEqual(a.nonce, b.nonce);
+  assert.doesNotMatch(a.html, /__EMAIL_VERIFICATION_NONCE__/);
+});
+
+test('sends the Origin-Trial header only when configured', async () => {
+  const plain = await fetch(`${base}/`);
+  assert.equal(plain.headers.get('origin-trial'), null);
+  const trialApp = createApp({ env: { RP_ORIGIN, ORIGIN_TRIAL_TOKEN: 'OT-TOKEN' }, nonces: new NonceStore({ sweepIntervalMs: 0 }) });
+  const s2 = createServer(trialApp);
+  await new Promise((resolve) => s2.listen(0, '127.0.0.1', resolve));
+  try {
+    const res = await fetch(`http://127.0.0.1:${s2.address().port}/`);
+    assert.equal(res.headers.get('origin-trial'), 'OT-TOKEN');
+  } finally {
+    await new Promise((resolve) => s2.close(resolve));
+  }
+});
+
+test('fast path: valid token + matching session nonce creates a verified account', async () => {
+  const { cookie, nonce } = await loadForm();
+  calls.length = 0;
+  const { res, data } = await signup({ cookie, body: { name: 'Jordan', email: 'Jordan@mail.example', password: 'longenough', token: 'GOOD' } });
+  assert.equal(res.status, 201);
+  assert.equal(data.status, 'verified');
+  assert.equal(calls.length, 1);
+  assert.deepEqual(calls[0], { rawToken: 'GOOD', submittedEmail: 'Jordan@mail.example', expectedNonce: nonce, expectedAudience: RP_ORIGIN });
+  const account = accounts.get('jordan@mail.example');
+  assert.equal(account.emailVerified, true);
+  assert.equal(account.verificationMethod, 'email-verification-protocol');
+  assert.notEqual(account.passwordHash, 'longenough');
+  assert.match(account.passwordHash, /^scrypt\$/);
+});
+
+test('nonce is single-use: a second POST on the same session skips verification and falls back', async () => {
+  const { cookie } = await loadForm();
+  await signup({ cookie, body: { name: 'A', email: 'first@mail.example', password: 'longenough', token: 'GOOD' } });
+  calls.length = 0;
+  const { res, data } = await signup({ cookie, body: { name: 'B', email: 'second@mail.example', password: 'longenough', token: 'GOOD' } });
+  assert.equal(res.status, 202);
+  assert.equal(data.status, 'pending_email');
+  assert.equal(calls.length, 0, 'verifier must not run without a pending nonce');
+  assert.equal(accounts.get('second@mail.example').emailVerified, false);
+});
+
+test('fallback path: empty token (unsupported browser) still creates an unverified account', async () => {
+  const { cookie } = await loadForm();
+  const { res, data } = await signup({ cookie, body: { name: 'Sam', email: 'sam@mail.example', password: 'longenough', token: '' } });
+  assert.equal(res.status, 202);
+  assert.equal(data.status, 'pending_email');
+  assert.match(data.message, /confirmation link/);
+});
+
+test('fallback path: a token that fails verification degrades to e-mail confirmation', async () => {
+  const { cookie } = await loadForm();
+  const { res, data } = await signup({ cookie, body: { name: 'Pat', email: 'pat@mail.example', password: 'longenough', token: 'FORGED' } });
+  assert.equal(res.status, 202);
+  assert.equal(data.status, 'pending_email');
+  assert.equal(accounts.get('pat@mail.example').emailVerified, false);
+});
+
+test('validation errors return field messages and a replacement nonce', async () => {
+  const { cookie, nonce } = await loadForm();
+  const { res, data } = await signup({ cookie, body: { name: '', email: 'nope', password: 'short', token: '' } });
+  assert.equal(res.status, 400);
+  assert.equal(data.status, 'invalid');
+  assert.deepEqual(Object.keys(data.errors).sort(), ['email', 'name', 'password']);
+  assert.ok(data.nextNonce && data.nextNonce !== nonce);
+  // The replacement nonce is live: the next POST on this session is verified against it.
+  calls.length = 0;
+  await signup({ cookie, body: { name: 'Retry', email: 'retry@mail.example', password: 'longenough', token: 'GOOD' } });
+  assert.equal(calls[0].expectedNonce, data.nextNonce);
+});
+
+test('duplicate e-mail is rejected with 409', async () => {
+  const { cookie } = await loadForm();
+  const { res, data } = await signup({ cookie, body: { name: 'Again', email: 'JORDAN@mail.example', password: 'longenough', token: '' } });
+  assert.equal(res.status, 409);
+  assert.equal(data.status, 'exists');
+});
+
+test('plain (no-JS) form post gets an HTML confirmation page', async () => {
+  const { cookie } = await loadForm();
+  const { res, data } = await signup({ cookie, accept: 'text/html,application/xhtml+xml', body: { name: 'Robin', email: 'robin@mail.example', password: 'longenough', token: 'GOOD' } });
+  assert.equal(res.status, 201);
+  assert.match(res.headers.get('content-type'), /text\/html/);
+  assert.match(data, /Daily Grind Rewards/);
+  assert.match(data, /verified instantly/);
+});
+
+test('rejects cross-origin posts, wrong content types and wrong methods', async () => {
+  const { cookie } = await loadForm();
+  const cross = await fetch(`${base}/api/rewards/verify-email`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/x-www-form-urlencoded', accept: 'application/json', origin: 'https://evil.example', cookie },
+    body: 'name=x',
+  });
+  assert.equal(cross.status, 403);
+  const json = await fetch(`${base}/api/rewards/verify-email`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json', accept: 'application/json', origin: RP_ORIGIN, cookie },
+    body: '{}',
+  });
+  assert.equal(json.status, 415);
+  const get = await fetch(`${base}/api/rewards/verify-email`);
+  assert.equal(get.status, 405);
+});
+
+test('static serving hides server code and blocks traversal', async () => {
+  for (const p of ['/lib/app.mjs', '/server.mjs', '/package.json', '/test/app.test.mjs', '/node_modules/jose/package.json', '/..%2fpackage.json']) {
+    const res = await fetch(`${base}${p}`);
+    assert.equal(res.status, 404, p);
+  }
+  const html = await fetch(`${base}/index.html`);
+  assert.equal(html.status, 200);
+  assert.equal(html.headers.get('cache-control'), 'no-store');
+});
diff --git a/test/email-verification.test.mjs b/test/email-verification.test.mjs
new file mode 100644
index 0000000..19d275a
--- /dev/null
+++ b/test/email-verification.test.mjs
@@ -0,0 +1,172 @@
+/**
+ * Exercises verifyEmailVerificationToken() against a fake issuer:
+ * the EVT + KB-JWT fixtures are built with jose directly (not @sd-jwt/core),
+ * and DNS / HTTPS discovery are injected.
+ */
+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { SignJWT, exportJWK, generateKeyPair } from 'jose';
+import {
+  EmailVerificationError,
+  clearIssuerCache,
+  verifyEmailVerificationToken,
+} from '../lib/email-verification.mjs';
+
+const ISSUER = 'https://issuer.example';
+const RP_ORIGIN = 'https://dailygrind.example';
+const EMAIL = 'Jordan.Barista@mail.example';
+const NONCE = 'test-nonce-with-plenty-of-entropy-0123456789';
+
+const issuerKeys = await generateKeyPair('ES256');
+const otherIssuerKeys = await generateKeyPair('ES256');
+const holderKeys = await generateKeyPair('ES256');
+const holderJwk = { ...(await exportJWK(holderKeys.publicKey)), alg: 'ES256' };
+
+const sdHash = (evt) => createHash('sha256').update(`${evt}~`).digest('base64url');
+
+async function buildPresentation({
+  email = EMAIL,
+  emailVerified = true,
+  iss = ISSUER,
+  aud = RP_ORIGIN,
+  nonce = NONCE,
+  issuerKey = issuerKeys.privateKey,
+  holderKey = holderKeys.privateKey,
+  cnfJwk = holderJwk,
+  evtTyp = 'ev+sd-jwt',
+  kbTyp = 'kb+jwt',
+  kbAlg = 'ES256',
+  iat = Math.floor(Date.now() / 1000),
+  kid,
+} = {}) {
+  const evt = await new SignJWT({ email, email_verified: emailVerified, cnf: { jwk: cnfJwk } })
+    .setProtectedHeader({ alg: 'ES256', typ: evtTyp, ...(kid ? { kid } : {}) })
+    .setIssuer(iss)
+    .setIssuedAt(iat)
+    .setExpirationTime(iat + 300)
+    .sign(issuerKey);
+  const kb = await new SignJWT({ aud, nonce, sd_hash: sdHash(evt) })
+    .setProtectedHeader({ alg: kbAlg, typ: kbTyp })
+    .setIssuedAt(iat)
+    .sign(holderKey);
+  return `${evt}~${kb}`;
+}
+
+function fakeDeps({ txt = [[`iss=issuer.example`]], issuer = ISSUER, jwks } = {}) {
+  const keys = jwks ?? [{ ...(exportedIssuerJwk), use: 'sig', alg: 'ES256' }];
+  return {
+    resolveTxt: async (name) => {
+      assert.equal(name, '_email-verification.mail.example');
+      return txt;
+    },
+    fetch: async (url) => {
+      const href = String(url);
+      if (href === `${ISSUER}/.well-known/email-verification`) {
+        return { ok: true, json: async () => ({ issuer, jwks_uri: `${ISSUER}/jwks.json` }) };
+      }
+      if (href === `${ISSUER}/jwks.json`) return { ok: true, json: async () => ({ keys }) };
+      return { ok: false, status: 404, json: async () => ({}) };
+    },
+  };
+}
+const exportedIssuerJwk = await exportJWK(issuerKeys.publicKey);
+
+const verify = (rawToken, overrides = {}, deps = fakeDeps()) =>
+  verifyEmailVerificationToken(
+    { rawToken, submittedEmail: EMAIL.toLowerCase(), expectedNonce: NONCE, expectedAudience: RP_ORIGIN, ...overrides },
+    deps,
+  );
+
+const rejectsWith = async (promise, code) => {
+  await assert.rejects(promise, (err) => {
+    assert.ok(err instanceof EmailVerificationError, `expected EmailVerificationError, got ${err}`);
+    assert.equal(err.code, code, err.message);
+    return true;
+  });
+};
+
+beforeEach(() => clearIssuerCache());
+
+test('accepts a valid EVT + KB-JWT presentation (case-insensitive e-mail match)', async () => {
+  const result = await verify(await buildPresentation());
+  assert.equal(result.email, EMAIL);
+  assert.equal(result.issuer, ISSUER);
+  assert.equal(result.payload.email_verified, true);
+});
+
+test('accepts a presentation when kid is omitted and the JWKS has several keys', async () => {
+  const otherJwk = { ...(await exportJWK(otherIssuerKeys.publicKey)), use: 'sig', alg: 'ES256' };
+  const deps = fakeDeps({ jwks: [otherJwk, { ...exportedIssuerJwk, use: 'sig', alg: 'ES256' }] });
+  const result = await verify(await buildPresentation(), {}, deps);
+  assert.equal(result.email, EMAIL);
+});
+
+test('rejects a token for a different e-mail than the one submitted', async () => {
+  await rejectsWith(verify(await buildPresentation(), { submittedEmail: 'someone.else@mail.example' }), 'claims');
+});
+
+test('rejects when email_verified is not true', async () => {
+  await rejectsWith(verify(await buildPresentation({ emailVerified: false })), 'claims');
+});
+
+test('rejects a stale nonce (replay)', async () => {
+  await rejectsWith(verify(await buildPresentation({ nonce: 'an-old-nonce' })), 'signature');
+});
+
+test('rejects a KB-JWT bound to a different relying party origin', async () => {
+  await rejectsWith(verify(await buildPresentation({ aud: 'https://evil.example' })), 'signature');
+});
+
+test('rejects when the e-mail domain does not delegate to the issuer', async () => {
+  await rejectsWith(verify(await buildPresentation(), {}, fakeDeps({ txt: [['iss=someone-else.example']] })), 'dns');
+  await rejectsWith(verify(await buildPresentation(), {}, fakeDeps({ txt: [] })), 'dns');
+});
+
+test('rejects when issuer metadata does not match iss', async () => {
+  await rejectsWith(verify(await buildPresentation(), {}, fakeDeps({ issuer: 'https://other.example' })), 'issuer');
+});
+
+test('rejects an EVT signed by a key that is not in the issuer JWKS', async () => {
+  await rejectsWith(verify(await buildPresentation({ issuerKey: otherIssuerKeys.privateKey })), 'signature');
+});
+
+test('rejects a KB-JWT signed by a key other than cnf.jwk', async () => {
+  const rogue = await generateKeyPair('ES256');
+  await rejectsWith(verify(await buildPresentation({ holderKey: rogue.privateKey })), 'signature');
+});
+
+test('rejects a tampered sd_hash (KB-JWT bound to a different EVT)', async () => {
+  const good = await buildPresentation();
+  const other = await buildPresentation({ email: 'x@mail.example' });
+  const spliced = `${other.split('~')[0]}~${good.split('~')[1]}`;
+  await rejectsWith(verify(spliced, { submittedEmail: 'x@mail.example' }), 'signature');
+});
+
+test('rejects an expired presentation', async () => {
+  const iat = Math.floor(Date.now() / 1000) - 60 * 60;
+  await rejectsWith(verify(await buildPresentation({ iat })), 'signature');
+});
+
+test('rejects a presentation without a Key Binding JWT', async () => {
+  const [evt] = (await buildPresentation()).split('~');
+  await rejectsWith(verify(`${evt}~`), 'format');
+});
+
+test('rejects wrong typ headers', async () => {
+  await rejectsWith(verify(await buildPresentation({ evtTyp: 'JWT' })), 'format');
+  await rejectsWith(verify(await buildPresentation({ kbTyp: 'JWT' })), 'signature');
+});
+
+test('rejects an empty token or missing nonce without touching the network', async () => {
+  const noNetwork = { resolveTxt: async () => assert.fail('dns'), fetch: async () => assert.fail('fetch') };
+  await rejectsWith(verify('', {}, noNetwork), 'missing-token');
+  await rejectsWith(verify(await buildPresentation(), { expectedNonce: '' }, noNetwork), 'missing-nonce');
+});
+
+test('rejects a non-https relying-party audience except localhost', async () => {
+  await rejectsWith(verify(await buildPresentation(), { expectedAudience: 'http://dailygrind.example' }), 'config');
+  const local = await buildPresentation({ aud: 'http://localhost:11222' });
+  const result = await verify(local, { expectedAudience: 'http://localhost:11222' });
+  assert.equal(result.email, EMAIL);
+});
