+  <script>
+    (() => {
+      const form = document.getElementById('rewards-form');
+      const status = document.getElementById('form-status');
+      const submit = document.getElementById('signup-submit');
+      const tokenInput = form.elements.token;
+      const fields = ['name', 'email', 'password'].map((n) => form.elements[n]);
+
+      // --- Show / hide password ------------------------------------------------
+      const toggle = document.getElementById('toggle-password');
+      const password = form.elements.password;
+      toggle.addEventListener('click', () => {
+        const show = toggle.getAttribute('aria-pressed') !== 'true';
+        password.type = show ? 'text' : 'password';
+        toggle.setAttribute('aria-pressed', String(show));
+        toggle.textContent = show ? 'Hide' : 'Show';
+        password.focus({ preventScroll: true });
+      });
+
+      // --- Keep aria-invalid in step with the :user-invalid visual state --------
+      const syncAria = (el) => {
+        if (!fields.includes(el)) return;
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      };
+      form.addEventListener('blur', (e) => syncAria(e.target), true);
+      form.addEventListener('input', (e) => {
+        // Typing clears any server-supplied message so the field can re-validate natively.
+        e.target.setCustomValidity?.('');
+        if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+        if (status.classList.contains('is-error')) setStatus('', '');
+      });
+      form.addEventListener('invalid', (e) => syncAria(e.target), true);
+
+      const setStatus = (text, kind) => {
+        status.textContent = text;
+        status.className = 'form-status' + (kind ? ' is-' + kind : '');
+      };
+
+      // A failed submission consumed the server-side nonce; re-arm the hidden input
+      // with the replacement the server returned so a retry can still be verified.
+      const rearm = (nextNonce) => {
+        if (!nextNonce) return;
+        tokenInput.setAttribute('nonce', nextNonce);
+        tokenInput.nonce = nextNonce;
+        tokenInput.value = '';
+      };
+
+      const showServerErrors = (errors = {}) => {
+        for (const field of fields) {
+          const message = errors[field.name];
+          if (message) {
+            field.setCustomValidity(message);
+            field.setAttribute('aria-invalid', 'true');
+            const msg = document.getElementById(field.getAttribute('aria-errormessage'));
+            if (msg) msg.lastChild.textContent = ' ' + message;
+          }
+        }
+        const first = fields.find((f) => errors[f.name]);
+        if (first) first.focus();
+      };
+
+      // --- Progressive enhancement: post with fetch(), fall back to full navigation
+      form.addEventListener('submit', async (event) => {
+        if (!window.fetch || !window.URLSearchParams) return; // plain form post
+        event.preventDefault();
+        fields.forEach(syncAria);
+        if (!form.reportValidity()) return;
+
+        submit.disabled = true; // prevent double-posts after a valid click
+        setStatus('Creating your account…', 'info');
+
+        try {
+          const response = await fetch(form.action, {
+            method: 'POST',
+            headers: { Accept: 'application/json' },
+            body: new URLSearchParams(new FormData(form)),
+            credentials: 'same-origin',
+          });
+          const data = await response.json();
+
+          if (data.status === 'verified') {
+            setStatus(data.message, 'success');
+            form.hidden = true;
+            return;
+          }
+          if (data.status === 'pending_email') {
+            setStatus(data.message, 'info');
+            form.hidden = true;
+            return;
+          }
+          rearm(data.nextNonce);
+          setStatus(data.message || 'Something went wrong. Please try again.', 'error');
+          showServerErrors(data.errors);
+        } catch (err) {
+          setStatus('We could not reach the server. Check your connection and try again.', 'error');
+        } finally {
+          submit.disabled = false;
+        }
+      });
+    })();
+  </script>
