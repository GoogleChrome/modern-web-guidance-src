diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,118 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Mixed Fonts &amp; Independent Theme</title>
+  <style>
+    :root {
+      --bg: #f7f7f9;
+      --fg: #1d1f24;
+      --code-bg: #e9ebf0;
+      --accent: #3b5bdb;
+    }
+
+    body {
+      margin: 0;
+      padding: 2rem;
+      font-family: Georgia, "Times New Roman", serif;
+      font-size: 1.125rem;
+      line-height: 1.6;
+      color: var(--fg);
+      background: var(--bg);
+    }
+
+    main {
+      max-width: 48rem;
+      margin-inline: auto;
+      display: grid;
+      gap: 2rem;
+    }
+
+    /*
+     * Mixed font families: serif body text with monospace inline code.
+     * `font-size-adjust` normalizes the visual x-height across the
+     * different families automatically. The `ex-height from-font`
+     * form reads the aspect value from the paragraph's primary font
+     * so every nested font is scaled to match it without hardcoding
+     * a number.
+     */
+    #mixed-fonts-container {
+      font-size-adjust: ex-height from-font;
+      /* Trim leading/trailing half-leading so the box hugs the glyphs */
+      text-box: trim-both cap alphabetic;
+    }
+
+    #mixed-fonts-container code {
+      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+      /* inherits font-size-adjust, so code x-height matches the serif text */
+      background: var(--code-bg);
+      padding: 0.1em 0.35em;
+      border-radius: 0.3em;
+    }
+
+    #mixed-fonts-container strong {
+      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
+      /* a third family, also normalized by the inherited font-size-adjust */
+    }
+
+    /*
+     * Independent theme container: scoped custom properties plus
+     * `aspect-ratio` with a specific numeric override. The ratio locks
+     * the visual proportions regardless of width; inline-size is
+     * constrained so height derives from the ratio automatically.
+     */
+    #independent-theme-container {
+      --bg: #11131a;
+      --fg: #f1f3f8;
+      --accent: #ffb347;
+
+      aspect-ratio: 16 / 9;
+      inline-size: min(100%, 40rem);
+      container-type: inline-size;
+
+      display: grid;
+      place-content: center;
+      gap: 0.5rem;
+      padding: 2rem;
+      box-sizing: border-box;
+      overflow: hidden;
+
+      color: var(--fg);
+      background:
+        radial-gradient(circle at 20% 20%, color-mix(in oklch, var(--accent) 35%, transparent), transparent 60%),
+        var(--bg);
+      border: 1px solid color-mix(in oklch, var(--accent) 40%, var(--bg));
+      border-radius: 1rem;
+      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
+    }
+
+    #independent-theme-container h2 {
+      margin: 0;
+      font-size: clamp(1.25rem, 6cqi, 2.5rem);
+      color: var(--accent);
+      text-box: trim-both cap alphabetic;
+    }
+
+    #independent-theme-container p {
+      margin: 0;
+      opacity: 0.85;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <p id="mixed-fonts-container">
+      Modern CSS can keep mixed families looking even. This serif text sits next to
+      inline code like <code>font-size-adjust</code> and <code>text-box: trim-both</code>,
+      plus a <strong>sans-serif emphasis</strong>, and all three share the same visual
+      x-height because the paragraph sets <code>font-size-adjust: ex-height from-font</code>.
+    </p>
+
+    <div id="independent-theme-container">
+      <h2>Independent Theme</h2>
+      <p>This container carries its own colour tokens and is locked to a 16 / 9 aspect ratio.</p>
+    </div>
+  </main>
+</body>
+</html>
