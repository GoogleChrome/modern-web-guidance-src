+    /* Promo badge */
+    .promo-badge {
+      display: block;
+      margin-inline: auto;
+      margin-block-end: 10px;
+      padding-block: 4px;
+      padding-inline: 10px;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      text-align: center;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+      border-radius: 999px;
+      /* Fallback for browsers without calc-size() */
+      inline-size: max-content;
+      max-inline-size: 100%;
+      /*
+        1.2x the badge's max-content size, clamped between 100px and the
+        full inline-size of the parent card (the 100% resolves against the
+        container, which is exactly what we want here).
+      */
+      inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+    }
+
+    /* Our Sourcing accordion */
+    .accordion {
+      margin-block-start: 40px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding-block: 16px;
+      padding-inline: 20px;
+      background: var(--primary);
+      color: white;
+      border: 0;
+      font: inherit;
+      font-size: 1.25rem;
+      font-weight: 700;
+      text-align: start;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    #accordion-toggle:hover,
+    #accordion-toggle:focus-visible {
+      background: #3e2723;
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .accordion-icon {
+      display: inline-block;
+      transition: rotate 0.4s ease-out;
+    }
+
+    #accordion-toggle[aria-expanded="true"] .accordion-icon {
+      rotate: 180deg;
+    }
+
+    .accordion-content {
+      /* Collapsed: zero block-size, clipped. Animates thanks to interpolate-size. */
+      block-size: 0;
+      overflow: hidden;
+      opacity: 0;
+      transition: block-size 0.4s ease-out, opacity 0.4s ease-out;
+    }
+
+    .accordion-content > .accordion-inner {
+      padding-block: 20px;
+      padding-inline: 20px;
+    }
+
+    .accordion-content > .accordion-inner p + p {
+      margin-block-start: 12px;
+    }
+
+    .accordion.is-open .accordion-content {
+      opacity: 1;
+      /* Fallback for browsers without calc-size() */
+      block-size: auto;
+      /*
+        Expanded: natural height plus 2rem of breathing room.
+        calc-size() lets us do math on the intrinsic `auto` basis while keeping
+        the value interpolable, so block-size animates smoothly from 0.
+
+        Note: directly transitioning between two different intrinsic keyword
+        sizes (e.g. min-content -> max-content, or auto -> fit-content) is NOT
+        supported. One end of the transition must always be a fixed length or
+        percentage, which is why the collapsed state here is `block-size: 0`.
+      */
+      block-size: calc-size(auto, size + 2rem);
+    }
+
+    /* Reduced motion: no size animation, just a quick fade instead. */
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content {
+        transition: opacity 0.2s ease-out;
+      }
+
+      .accordion-icon {
+        transition: none;
+      }
+    }
+
