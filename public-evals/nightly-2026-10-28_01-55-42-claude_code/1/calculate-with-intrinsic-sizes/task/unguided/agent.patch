+      inline-size: 100%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      font-size: 1.25rem;
+      font-weight: bold;
+      border: 0;
+      padding: 16px 20px;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    #accordion-toggle:hover,
+    #accordion-toggle:focus-visible {
+      background: #3e2723;
+    }
+
+    #accordion-toggle .accordion-icon {
+      display: inline-block;
+      transition: transform 0.4s ease;
+    }
+
+    #accordion-toggle[aria-expanded="true"] .accordion-icon {
+      transform: rotate(180deg);
+    }
+
+    /*
+     * Note on intrinsic sizing: with interpolate-size: allow-keywords the
+     * browser can interpolate between a fixed length (e.g. 0) and an
+     * intrinsic keyword (auto, max-content, min-content, fit-content…).
+     * Directly transitioning between two *different* intrinsic keyword
+     * sizes (e.g. min-content -> max-content, or auto -> fit-content) is
+     * NOT supported; the value simply snaps. Always animate from a fixed
+     * length to a single keyword (or a calc-size() built on that keyword).
+     */
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      padding-inline: 20px;
+      transition: block-size 0.4s ease;
+    }
+
+    .accordion-content.is-open {
+      /* Browsers without calc-size() fall back to plain auto. */
+      block-size: auto;
+      /* Natural height plus 2rem of breathing room below the text. */
+      block-size: calc-size(auto, size + 2rem);
+    }
+
+    .accordion-content p {
+      margin-block-start: 1rem;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content,
+      #accordion-toggle .accordion-icon {
+        transition: none;
+      }
+    }
