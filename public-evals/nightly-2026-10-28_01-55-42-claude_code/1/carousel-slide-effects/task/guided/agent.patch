+    /* Product carousel */
+    .carousel h2 {
+      text-align: center;
+    }
+
+    .carousel-hint {
+      text-align: center;
+      font-size: 0.9rem;
+      opacity: 0.75;
+    }
+
+    .scroller {
+      --card-size: 260px;
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      /* Lets the first and last cards reach the centre of the scrollport */
+      padding-inline: calc(50% - var(--card-size) / 2);
+      /* Room for card shadows and focus rings so they are not clipped */
+      padding-block: 24px;
+      margin-top: 16px;
+      scrollbar-width: thin;
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    .product-card {
+      flex: 0 0 var(--card-size);
+      display: flex;
+      flex-direction: column;
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 12px;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
+      overflow: clip;
+      text-align: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .card-body {
+      padding: 16px 16px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .product-card .price {
+      margin-top: 8px;
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .product-card .btn {
+      margin-top: 12px;
+    }
+
+    /* Cards grow as they approach the centre of the scroller and shrink
+       as they leave it. Pure CSS: the animation is driven by the card's
+       position inside the scroller (view timeline), not by JavaScript. */
+    @keyframes scale-to-center {
+      0%,
+      100% {
+        scale: 0.82;
+        opacity: 0.7;
+      }
+
+      50% {
+        scale: 1;
+        opacity: 1;
+      }
+    }
+
+    @supports (animation-timeline: view()) and (animation-range: entry) {
+      @media (prefers-reduced-motion: no-preference) {
+        .product-card {
+          animation: scale-to-center auto linear both;
+          /* Must come after the shorthand so it is not reset */
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
+    /* Hides content visually but keeps it in the accessibility tree. */
+    .visually-hidden:where(:not(:focus-within, :active)) {
+      position: absolute !important;
+      clip-path: inset(50%) !important;
+      overflow: hidden !important;
+      width: 1px !important;
+      height: 1px !important;
+      margin: -1px !important;
+      padding: 0 !important;
+      border: 0 !important;
+      white-space: nowrap !important;
+    }
+
     footer {
