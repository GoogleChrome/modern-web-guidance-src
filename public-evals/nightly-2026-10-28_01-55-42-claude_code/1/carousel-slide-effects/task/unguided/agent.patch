+    .scroller {
+      --card-width: 260px;
+      --card-gap: 24px;
+      --scale-min: 0.84;
+      /* Inline padding lets the first and last cards reach the center. */
+      --edge-padding: max(16px, calc(50% - var(--card-width) / 2));
+      margin-top: 20px;
+      padding: 24px var(--edge-padding) 32px;
+      overflow-x: auto;
+      overflow-y: hidden;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      scroll-padding-inline: var(--edge-padding);
+      scrollbar-color: var(--primary) var(--secondary);
+      border-radius: 8px;
+    }
+
+    /* The scroller is keyboard-focusable so arrow keys can scroll it. */
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .product-list {
+      display: grid;
+      grid-auto-flow: column;
+      grid-auto-columns: var(--card-width);
+      gap: var(--card-gap);
+      list-style: none;
+      margin: 0;
+      padding: 0;
+    }
+
+    .product-card {
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 10px;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
+      overflow: hidden;
+      display: flex;
+      flex-direction: column;
+      text-align: center;
+      /* Browsers without scroll-driven animations simply show cards at full size. */
+      transform: scale(1);
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .product-body {
+      padding: 16px 18px 20px;
+      display: flex;
+      flex-direction: column;
+      flex: 1;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+      font-size: 1.1rem;
+    }
+
+    .product-card p {
+      font-size: 0.9rem;
+      flex: 1;
+    }
+
+    .product-card .price {
+      display: block;
+      font-weight: bold;
+      color: var(--text);
+      margin-top: 10px;
+      font-size: 1.05rem;
+    }
+
+    .product-card .unit {
+      font-weight: normal;
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    .product-card .btn {
+      margin-top: 12px;
+      align-self: center;
+    }
+
+    .product-card .btn:focus-visible,
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Scale cards toward the center of the scrollport using a CSS view timeline (no JavaScript). */
+    @supports (animation-timeline: view()) {
+      .product-card {
+        animation: scale-toward-center linear both;
+        animation-timeline: view(inline);
+        /* Map 0% -> card fully off the left edge, 50% -> centered, 100% -> fully off the right edge. */
+        animation-range: cover 0% cover 100%;
+      }
+    }
+
+    @keyframes scale-toward-center {
+      0% {
+        transform: scale(var(--scale-min));
+        opacity: 0.7;
+      }
+
+      50% {
+        transform: scale(1);
+        opacity: 1;
+      }
+
+      100% {
+        transform: scale(var(--scale-min));
+        opacity: 0.7;
+      }
+    }
+
+    /* Respect users who prefer reduced motion: cards stay full size with no scaling. */
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        animation: none;
+        transform: none;
+        opacity: 1;
+      }
+    }
