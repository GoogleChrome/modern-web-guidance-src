+  <script>
+    (() => {
+      // Scoped view transitions: `element.startViewTransition()` snapshots and
+      // animates only that element's subtree. Unlike document.startViewTransition,
+      // it does not freeze rendering or block input on the rest of the page, and
+      // several scoped transitions can run at the same time on different roots.
+      const supportsScoped = typeof Element.prototype.startViewTransition === 'function';
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      /**
+       * Apply `update()` inside `scope` with an animation confined to that element.
+       * Returns a promise that settles when the animation finishes.
+       */
+      function transitionWithin(scope, update) {
+        if (reduceMotion.matches) {
+          update();
+          return Promise.resolve();
+        }
+
+        if (supportsScoped) {
+          // A new transition on the same scope skips the one in flight, so
+          // rapid clicks stay responsive and never queue up.
+          return scope.startViewTransition(update).finished.catch(() => { });
+        }
+
+        // Fallback: a FLIP-style height tween plus a fade, driven by the Web
+        // Animations API on the scope element itself. Still non-blocking and
+        // still independent per element.
+        const before = scope.getBoundingClientRect().height;
+        update();
+        const after = scope.getBoundingClientRect().height;
+        const options = { duration: 250, easing: 'cubic-bezier(0.2, 0, 0, 1)' };
+        const animations = [scope.animate([{ opacity: 0.45 }, { opacity: 1 }], options)];
+        if (before !== after) {
+          animations.push(scope.animate([{ height: `${before}px` }, { height: `${after}px` }], options));
+        }
+        return Promise.all(animations.map((a) => a.finished)).catch(() => { });
+      }
+
+      const money = (n) => `$${Number(n).toFixed(2)}`;
+
+      // --- Order badge in the nav: its own scoped transition root -------------
+      const cartLink = document.getElementById('cart-link');
+      const cartCount = document.getElementById('cart-count');
+      let cartTotal = 0;
+
+      function addToCart() {
+        cartTotal += 1;
+        transitionWithin(cartLink, () => {
+          cartCount.textContent = String(cartTotal);
+          cartCount.setAttribute('aria-label', `${cartTotal} item${cartTotal === 1 ? '' : 's'}`);
+        });
+      }
+
+      // --- Menu cards: each one is an independent scoped transition root ------
+      document.querySelectorAll('.menu-card').forEach((card) => {
+        const price = card.querySelector('.price');
+        const sizes = Array.from(card.querySelectorAll('.size'));
+        const toggle = card.querySelector('.details-toggle');
+        const details = card.querySelector('.details');
+        const addBtn = card.querySelector('.add');
+        const qty = card.querySelector('.qty');
+        let count = 0;
+
+        // Size picker: the selected pill morphs across and the price ticks.
+        sizes.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            if (btn.getAttribute('aria-pressed') === 'true') return;
+            transitionWithin(card, () => {
+              sizes.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+              price.textContent = money(btn.dataset.price);
+            });
+          });
+        });
+
+        // Tasting notes: the card grows/shrinks and the panel slides in/out.
+        toggle.addEventListener('click', () => {
+          const open = toggle.getAttribute('aria-expanded') === 'true';
+          transitionWithin(card, () => {
+            toggle.setAttribute('aria-expanded', String(!open));
+            details.hidden = open;
+            toggle.textContent = open ? 'Tasting notes' : 'Hide notes';
+          });
+        });
+
+        // Add to order: kicks off two transitions at once, one on this card and
+        // one on the nav badge, while every other card stays clickable.
+        addBtn.addEventListener('click', () => {
+          count += 1;
+          transitionWithin(card, () => {
+            card.classList.add('in-order');
+            qty.textContent = String(count);
+            addBtn.setAttribute('aria-label', `Add ${card.dataset.item} to order, ${count} in order`);
+          });
+          addToCart();
+        });
+      });
+    })();
+  </script>
+
