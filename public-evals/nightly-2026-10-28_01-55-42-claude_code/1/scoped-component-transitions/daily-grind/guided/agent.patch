+  <script>
+    // --------------------------------------------------------------
+    // Scoped view transitions
+    // --------------------------------------------------------------
+    // Feature-detect element-scoped transitions on Element.prototype.
+    // Deliberately NOT falling back to document.startViewTransition():
+    // a document-level transition would block pointer events on the
+    // whole page, cover the sticky nav, and prevent concurrent
+    // transitions, which is exactly what this component avoids.
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+      const transition = scopeEl.startViewTransition(updateDOM);
+      // Re-triggering on the same scope skips the active transition and
+      // rejects `ready`; swallow it to avoid unhandled rejections.
+      transition.ready.catch(() => {});
+    }
+
+    // --------------------------------------------------------------
+    // Shared order state
+    // --------------------------------------------------------------
+    const order = new Map(); // id -> { name, price, qty }
+    const orderPanel = document.getElementById('order');
+    const orderList = document.getElementById('order-list');
+    const orderEmpty = document.getElementById('order-empty');
+    const orderTotal = document.getElementById('order-total');
+    const navCount = document.getElementById('nav-count');
+
+    const money = (n) => `$${n.toFixed(2)}`;
+
+    // --------------------------------------------------------------
+    // Card component (one scope per card)
+    // --------------------------------------------------------------
+    document.querySelectorAll('.card').forEach((card) => {
+      const id = card.dataset.id;
+      const details = card.querySelector('.details');
+      const toggleBtn = card.querySelector('[data-action="toggle-details"]');
+      const addBtn = card.querySelector('[data-action="add"]');
+
+      toggleBtn.addEventListener('click', () => {
+        const expand = details.hidden;
+        runScopedTransition(card, () => {
+          details.hidden = !expand;
+          toggleBtn.setAttribute('aria-expanded', String(expand));
+          toggleBtn.textContent = expand ? 'Hide Details' : 'View Details';
+        });
+      });
+
+      addBtn.addEventListener('click', () => {
+        const entry = order.get(id) ?? {
+          name: card.dataset.name,
+          price: Number(card.dataset.price),
+          qty: 0,
+        };
+        entry.qty += 1;
+        order.set(id, entry);
+
+        // 1) Card scope: show / update the "in order" badge.
+        runScopedTransition(card, () => {
+          let badge = card.querySelector('.in-order');
+          if (!badge) {
+            badge = document.createElement('span');
+            badge.className = 'in-order';
+            card.insertBefore(badge, card.querySelector('.actions'));
+          }
+          badge.textContent = `In your order ×${entry.qty}`;
+        });
+
+        // 2) Order panel scope: runs concurrently with the card above.
+        runScopedTransition(orderPanel, () => {
+          let li = orderList.querySelector(`[data-id="${id}"]`);
+          if (!li) {
+            li = createOrderItem(id, entry);
+            orderList.appendChild(li);
+          } else {
+            li.querySelector('.qty').textContent = `× ${entry.qty}`;
+            li.querySelector('.line-total').textContent = money(entry.qty * entry.price);
+          }
+          syncOrderChrome();
+        });
+
+        // Outside any scope: the sticky nav updates immediately and
+        // stays clickable while both transitions play.
+        updateNavCount();
+      });
+    });
+
+    // --------------------------------------------------------------
+    // Order panel component
+    // --------------------------------------------------------------
+    function createOrderItem(id, entry) {
+      const li = document.createElement('li');
+      li.dataset.id = id;
+      li.innerHTML = `
+        <span class="name">${entry.name}
+          <span class="qty">× ${entry.qty}</span>
+        </span>
+        <span class="line-total">${money(entry.qty * entry.price)}</span>
+        <button type="button" class="icon-btn" data-action="move-up" aria-label="Move ${entry.name} up">↑</button>
+        <button type="button" class="icon-btn" data-action="remove" aria-label="Remove ${entry.name}">✕</button>
+      `;
+      return li;
+    }
+
+    orderList.addEventListener('click', (event) => {
+      const btn = event.target.closest('button[data-action]');
+      if (!btn) return;
+      const li = btn.closest('li');
+      const id = li.dataset.id;
+
+      if (btn.dataset.action === 'move-up') {
+        const prev = li.previousElementSibling;
+        if (!prev) return;
+        // Move the existing node (match-element tracks node identity).
+        runScopedTransition(orderPanel, () => {
+          orderList.insertBefore(li, prev);
+          syncOrderChrome();
+          btn.focus();
+        });
+      }
+
+      if (btn.dataset.action === 'remove') {
+        order.delete(id);
+        const hadFocus = li.contains(document.activeElement);
+        const nextFocus =
+          li.nextElementSibling?.querySelector('[data-action="remove"]') ??
+          li.previousElementSibling?.querySelector('[data-action="remove"]') ??
+          document.querySelector(`.card[data-id="${id}"] [data-action="add"]`);
+
+        runScopedTransition(orderPanel, () => {
+          li.remove();
+          syncOrderChrome();
+          if (hadFocus) nextFocus?.focus();
+        });
+
+        // Concurrently clear the badge inside the matching card scope.
+        const card = document.querySelector(`.card[data-id="${id}"]`);
+        const badge = card?.querySelector('.in-order');
+        if (badge) runScopedTransition(card, () => badge.remove());
+
+        updateNavCount();
+      }
+    });
+
+    function syncOrderChrome() {
+      const items = [...order.values()];
+      const total = items.reduce((sum, e) => sum + e.qty * e.price, 0);
+      orderEmpty.hidden = items.length > 0;
+      orderTotal.hidden = items.length === 0;
+      orderTotal.textContent = `Total: ${money(total)}`;
+      orderList.querySelectorAll('li').forEach((li, i) => {
+        li.querySelector('[data-action="move-up"]').disabled = i === 0;
+      });
+    }
+
+    function updateNavCount() {
+      const count = [...order.values()].reduce((sum, e) => sum + e.qty, 0);
+      navCount.textContent = String(count);
+    }
+  </script>
+
 </body>
 
