diff --git a/src/components/ReadingListDialog.tsx b/src/components/ReadingListDialog.tsx
new file mode 100644
index 0000000..ba18c7a
--- /dev/null
+++ b/src/components/ReadingListDialog.tsx
@@ -0,0 +1,91 @@
+import React, { useEffect, useState } from 'react';
+
+interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image: string;
+}
+
+interface Props {
+  articles: Article[];
+}
+
+/**
+ * Contents of the reading list <dialog>. Mounted only while the dialog is open
+ * so the reading list is fetched fresh each time it is shown.
+ */
+export default function ReadingListDialog({ articles }: Props) {
+  const [readingList, setReadingList] = useState<string[]>([]);
+
+  const fetchReadingList = async () => {
+    const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`);
+    const data = await response.json();
+    setReadingList(data.readingList);
+  };
+
+  useEffect(() => {
+    fetchReadingList();
+  }, []);
+
+  const handleRemove = async (slug: string) => {
+    await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify({ slug }),
+    });
+    fetchReadingList();
+  };
+
+  const readingListArticles = articles.filter(article => readingList.includes(article.slug));
+
+  return (
+    <div className="relative">
+      <form method="dialog" className="absolute -top-2 -right-2 z-10">
+        <button
+          type="submit"
+          aria-label="Close reading list"
+          className="bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-400 hover:scale-110 transition-transform"
+        >
+          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+            <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+          </svg>
+        </button>
+      </form>
+
+      <div className="p-4">
+        <h2 id="reading-list-title" className="text-lg font-semibold text-gray-800">Your Reading List</h2>
+      </div>
+
+      <div className="p-4 max-h-[60vh] overflow-y-auto">
+        {readingListArticles.length === 0 && (
+          <p role="status" className="text-gray-500 text-center py-8">Your reading list is empty.</p>
+        )}
+        {readingListArticles.length > 0 && (
+          <ul className="space-y-2">
+            {readingListArticles.map(article => (
+              <li key={article.slug} className="flex items-center">
+                <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block hover:bg-gray-100 p-4 rounded-md transition-colors flex-grow">
+                  <h3 className="font-bold text-lg text-gray-800">{article.title}</h3>
+                  <p className="text-sm text-gray-600">{article.summary}</p>
+                </a>
+                <button
+                  type="button"
+                  onClick={() => handleRemove(article.slug)}
+                  aria-label={`Remove "${article.title}" from reading list`}
+                  className="p-2 text-gray-500 hover:text-amber-400"
+                >
+                  <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
+                  </svg>
+                </button>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </div>
+  );
+}
