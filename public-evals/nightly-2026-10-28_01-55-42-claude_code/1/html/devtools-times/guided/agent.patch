diff --git a/src/components/SearchDialog.tsx b/src/components/SearchDialog.tsx
new file mode 100644
index 0000000..3b8bfcc
--- /dev/null
+++ b/src/components/SearchDialog.tsx
@@ -0,0 +1,133 @@
+import React, { useState, useMemo, useEffect } from 'react';
+
+interface Article {
+    slug: string;
+    title: string;
+    summary: string;
+    image?: string;
+}
+
+interface Props {
+    articles: Article[];
+}
+
+// Function to shuffle an array and get the first N items
+const getShuffledItems = <T,>(arr: T[], count: number): T[] => {
+    return [...arr].sort(() => 0.5 - Math.random()).slice(0, count);
+};
+
+/**
+ * Contents of the search <dialog>. Mounted only while the dialog is open.
+ */
+export default function SearchDialog({ articles }: Props) {
+    const [searchTerm, setSearchTerm] = useState('');
+    const [suggestions, setSuggestions] = useState<Article[]>([]);
+
+    useEffect(() => {
+        // Bug: Redundant fetch for suggestions
+        const fetchSuggestions = async () => {
+            try {
+                const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`);
+                const data = await response.json();
+                setSuggestions(getShuffledItems(data, 3));
+            } catch (error) {
+                console.error('Failed to fetch suggestions:', error);
+            }
+        };
+
+        fetchSuggestions();
+    }, []);
+
+    const filteredArticles = useMemo(() => {
+        if (!searchTerm) {
+            return [];
+        }
+        return articles.filter(article =>
+            article.title.toLowerCase().includes(searchTerm.toLowerCase()) ||
+            article.summary.toLowerCase().includes(searchTerm.toLowerCase())
+        );
+    }, [articles, searchTerm]);
+
+    return (
+        <div className="relative">
+            <form method="dialog" className="absolute -top-2 -right-2 z-10">
+                <button
+                    type="submit"
+                    aria-label="Close search"
+                    className="bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-400 hover:scale-110 transition-transform"
+                >
+                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+                        <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+                    </svg>
+                </button>
+            </form>
+
+            <div className="p-4">
+                <h2 id="search-dialog-title" className="text-sm font-semibold text-gray-500 mb-3">Search</h2>
+                <search>
+                    <form role="search" onSubmit={e => e.preventDefault()}>
+                        <label htmlFor="site-search" className="sr-only">Search for articles</label>
+                        <input
+                            type="search"
+                            id="site-search"
+                            name="q"
+                            placeholder="Search for articles..."
+                            className="w-full p-2 text-base border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400 focus:border-transparent transition"
+                            value={searchTerm}
+                            onChange={e => setSearchTerm(e.target.value)}
+                            autoFocus
+                            autoCapitalize="off"
+                            autoCorrect="off"
+                            spellCheck={false}
+                            enterKeyHint="search"
+                        />
+                    </form>
+                </search>
+
+                {!searchTerm && suggestions.length > 0 && (
+                    <section className="mt-4">
+                        <h3 className="text-sm font-semibold text-gray-500 mb-3">Featured</h3>
+                        <ul className="grid grid-cols-3 gap-4">
+                            {suggestions.map(article => {
+                                const imagePath = article.image ? article.image.replace(/^\//, '') : '';
+                                return (
+                                    <li key={article.slug}>
+                                        <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block hover:bg-gray-100 p-2 rounded-md transition-colors">
+                                            <img
+                                                src={`${import.meta.env.BASE_URL}${imagePath}`}
+                                                alt=""
+                                                width={320}
+                                                height={180}
+                                                decoding="async"
+                                                className="w-full h-20 object-cover rounded-md mb-2"
+                                            />
+                                            <span className="block font-bold text-sm text-gray-800">{article.title}</span>
+                                        </a>
+                                    </li>
+                                );
+                            })}
+                        </ul>
+                    </section>
+                )}
+            </div>
+
+            <div className="p-4 max-h-[60vh] overflow-y-auto" aria-live="polite">
+                {searchTerm && filteredArticles.length === 0 && (
+                    <p className="text-gray-500 text-center py-8">No results found for "{searchTerm}".</p>
+                )}
+                {searchTerm && filteredArticles.length > 0 && (
+                    <ul className="space-y-2">
+                        {filteredArticles.map(article => (
+                            <li key={article.slug}>
+                                <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block hover:bg-gray-100 p-4 rounded-md transition-colors">
+                                    <h3 className="font-bold text-lg text-gray-800">{article.title}</h3>
+                                    <p className="text-sm text-gray-600">{article.summary}</p>
+                                </a>
+                            </li>
+                        ))}
+                    </ul>
+                )}
+            </div>
+        </div>
+    );
+}
