\ No newline at end of file
+}
+
+/* Skip link: visually hidden until focused, then shown at the top of the page. */
+.skip-link {
+  position: absolute;
+  inset-block-start: 0;
+  inset-inline-start: 0;
+  z-index: 100;
+  padding: 0.75rem 1rem;
+  background: #111827;
+  color: #fff;
+  font-weight: 600;
+  translate: 0 -100%;
+  transition: translate 150ms ease-out;
+}
+
+.skip-link:focus-visible {
+  translate: 0 0;
+  outline: 2px solid #fbbf24;
+  outline-offset: 2px;
+}
+
+/* Native modal dialogs: contain scroll gestures so the page behind never scrolls.
+   Do not lock scrolling with overflow:hidden on html/body. */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  overflow: hidden;
+  overscroll-behavior: contain;
+  background-color: rgb(255 255 255 / 0.3);
+  backdrop-filter: blur(4px);
+}
+
+/* Popovers: override the UA centering. Positions are supplied as custom
+   properties from the invoking component. The .\:popover-open class is what the
+   popover polyfill applies where :popover-open is unsupported. */
+.flyout-menu[popover] {
+  position: fixed;
+  inset: auto;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  top: var(--flyout-top, 0px);
+  left: var(--flyout-left, 0px);
+  width: var(--flyout-width, 100%);
+  max-width: 100vw;
+  max-height: calc(100vh - var(--flyout-top, 0px));
+  overflow: auto;
+  overscroll-behavior: contain;
+  color: inherit;
+}
+
+.flyout-menu[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
+}
+
+/* Stretched-link card pattern: the heading link covers the whole card while
+   other controls stay operable above the overlay. */
+.card:has(a.card-link) {
+  position: relative;
+}
+
+.card a.card-link::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+}
+
+.card:has(a.card-link) :is(a:not(.card-link), button, input) {
+  position: relative;
+  z-index: 1;
+}
+
+.card a.card-link:focus-visible {
+  outline: none;
+}
+
+.card:has(a.card-link:focus-visible) {
+  outline: 2px solid #fbbf24;
+  outline-offset: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .skip-link {
+    transition: none;
+  }
+}
