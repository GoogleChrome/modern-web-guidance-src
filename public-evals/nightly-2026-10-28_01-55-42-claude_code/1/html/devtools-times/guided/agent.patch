diff --git a/src/components/useModalDialog.ts b/src/components/useModalDialog.ts
new file mode 100644
index 0000000..217afa7
--- /dev/null
+++ b/src/components/useModalDialog.ts
@@ -0,0 +1,79 @@
+import { useCallback, useEffect, useRef, useState, type RefObject } from 'react';
+
+/**
+ * Manages a native <dialog> opened with showModal().
+ *
+ * - `isOpen` mirrors the dialog's open state so content can be rendered lazily.
+ * - showModal() runs in an effect after the content has committed, so
+ *   `autofocus` inside the dialog is honoured.
+ * - Adds the light-dismiss fallback for browsers without `closedby` support.
+ *
+ * Focus trapping, Escape handling, backdrop and focus restoration to the
+ * invoking button are provided by the browser; nothing here re-implements them.
+ */
+export function useModalDialog(): {
+  dialogRef: RefObject<HTMLDialogElement | null>;
+  isOpen: boolean;
+  open: () => void;
+  close: () => void;
+  onClose: () => void;
+} {
+  const dialogRef = useRef<HTMLDialogElement | null>(null);
+  const [isOpen, setIsOpen] = useState(false);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog || !isOpen || dialog.open) return;
+    dialog.showModal();
+  }, [isOpen]);
+
+  useLightDismissFallback(dialogRef);
+
+  const open = useCallback(() => setIsOpen(true), []);
+  const close = useCallback(() => dialogRef.current?.close(), []);
+  // Fired by the native `close` event (Esc, light dismiss, form method="dialog", close()).
+  const onClose = useCallback(() => setIsOpen(false), []);
+
+  return { dialogRef, isOpen, open, close, onClose };
+}
+
+/**
+ * `closedby="any"` is not supported everywhere (notably Safari). Where it is
+ * missing, close the dialog when a pointer press and release both land outside
+ * the dialog's box. The pointer position is tested rather than event.target,
+ * because the <dialog> is also the target for clicks on its own padding.
+ */
+function useLightDismissFallback(dialogRef: RefObject<HTMLDialogElement | null>) {
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (typeof HTMLDialogElement === 'undefined' || 'closedBy' in HTMLDialogElement.prototype) return;
+    if (dialog.getAttribute('closedby') !== 'any') return;
+
+    const outside = (event: PointerEvent) => {
+      const rect = dialog.getBoundingClientRect();
+      return (
+        event.clientX < rect.left ||
+        event.clientX > rect.right ||
+        event.clientY < rect.top ||
+        event.clientY > rect.bottom
+      );
+    };
+
+    let pressedOutside = false;
+    const onPointerDown = (event: PointerEvent) => {
+      pressedOutside = outside(event);
+    };
+    const onPointerUp = (event: PointerEvent) => {
+      if (pressedOutside && outside(event)) dialog.close();
+      pressedOutside = false;
+    };
+
+    dialog.addEventListener('pointerdown', onPointerDown);
+    dialog.addEventListener('pointerup', onPointerUp);
+    return () => {
+      dialog.removeEventListener('pointerdown', onPointerDown);
+      dialog.removeEventListener('pointerup', onPointerUp);
+    };
+  }, [dialogRef]);
+}
