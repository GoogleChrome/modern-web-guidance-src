diff --git a/src/components/ArticleImage.astro b/src/components/ArticleImage.astro
new file mode 100644
index 0000000..43aa85f
--- /dev/null
+++ b/src/components/ArticleImage.astro
@@ -0,0 +1,68 @@
+---
+/**
+ * Responsive article image.
+ *
+ * Local images (imported from /public/images/articles via getArticleImage) are
+ * optimised through astro:assets with a `constrained` layout, so they receive a
+ * `srcset` built from the configured breakpoints plus the `sizes` hint supplied
+ * by the caller. Remote images that are not on the optimisation allow-list are
+ * passed through untouched with explicit dimensions to reserve layout space.
+ *
+ * `priority` marks the page's Largest Contentful Paint candidate: it is loaded
+ * eagerly with a high fetch priority and decoded synchronously.
+ */
+import type { ImageMetadata } from 'astro';
+import { Image } from 'astro:assets';
+
+export interface Props {
+    src: ImageMetadata | string;
+    alt: string;
+    width: number;
+    height: number;
+    /** The `sizes` attribute describing the rendered width of the image. */
+    sizes?: string;
+    priority?: boolean;
+    /** Override the lazy default for images that are in the initial viewport but are not the LCP element. */
+    loading?: 'eager' | 'lazy';
+    quality?: number;
+    class?: string;
+}
+
+const {
+    src,
+    alt,
+    width,
+    height,
+    sizes = '100vw',
+    priority = false,
+    loading,
+    quality,
+    class: className,
+} = Astro.props;
+---
+{typeof src === 'string' ? (
+    <Image
+        src={src}
+        alt={alt}
+        width={width}
+        height={height}
+        layout="none"
+        priority={priority}
+        loading={loading}
+        class={className}
+    />
+) : (
+    <Image
+        src={src}
+        alt={alt}
+        width={width}
+        height={height}
+        sizes={sizes}
+        format="webp"
+        quality={quality}
+        layout="constrained"
+        priority={priority}
+        loading={loading}
+        class={className}
+    />
+)}
