+}
+
+/* Skip link: visually hidden until it receives keyboard focus. */
+.skip-link {
+  position: absolute;
+  left: 0.5rem;
+  top: 0.5rem;
+  z-index: 100;
+  padding: 0.5rem 1rem;
+  background: var(--color-gray-900);
+  color: white;
+  font-weight: 600;
+  border-radius: 0.25rem;
+  transform: translateY(-200%);
+  transition: transform 150ms ease-out;
+}
+
+.skip-link:focus-visible {
+  transform: translateY(0);
+  outline: 2px solid var(--color-amber-400);
+  outline-offset: 2px;
+}
+
+/* The main landmark is a programmatic focus target for the skip link; no ring needed. */
+main:focus {
+  outline: none;
+}
+
+/*
+ * Primary navigation flyout.
+ * The flyout is a native popover, so it lives in the top layer and is no longer
+ * positioned relative to the header box. CSS anchor positioning pins it to the
+ * navigation bar; browsers without anchor support receive inline coordinates
+ * from BottomNav.tsx instead.
+ */
+.primary-nav-bar {
+  anchor-name: --primary-nav;
+}
+
+.primary-nav-flyout {
+  /* Reset the popover UA stylesheet (inset: 0, margin: auto, border, padding). */
+  position: absolute;
+  inset: auto;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  width: 100%;
+  max-width: none;
+  max-height: none;
+  overflow: visible;
+  color: inherit;
+  background: transparent;
+}
+
+@supports (anchor-name: --a) {
+  .primary-nav-flyout {
+    position-anchor: --primary-nav;
+    top: anchor(bottom);
+    left: anchor(left);
+    width: anchor-size(width);
+  }
+}
+
+/* Modal overlays share a backdrop treatment through ::backdrop. */
+.overlay-dialog::backdrop {
+  background: rgb(255 255 255 / 0.3);
+  backdrop-filter: blur(4px);
+}
