+    /* Rewards popover card */
+    .rewards-card {
+      /* Reset UA popover defaults so positioning rules below take over */
+      inset: auto;
+      margin: 0.5rem 0 0;
+      padding: 0;
+      border: 0;
+      width: min(22rem, calc(100vw - 2rem));
+      overflow: hidden;
+      background: white;
+      color: var(--text);
+      border-radius: 12px;
+      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
+
+      /* Fallback placement (no anchor positioning): pin under the sticky nav, top-right. */
+      position: fixed;
+      top: 4.5rem;
+      right: 5%;
+    }
+
+    /* Anchor positioning: tether to the trigger button and flip at viewport edges. */
+    @supports (position-area: block-end) {
+      .rewards-card {
+        top: auto;
+        right: auto;
+        position-area: block-end span-inline-start;
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      }
+    }
+
+    /* The polyfill cannot define :popover-open, so it toggles a .\:popover-open class.
+       Combining both in :is() keeps the rule valid in browsers lacking the pseudo-class. */
+    .rewards-card:is(:popover-open, .\:popover-open) {
+      display: block;
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .rewards-card {
+        opacity: 0;
+        translate: 0 -0.5rem;
+        transition: opacity 0.2s ease, translate 0.2s ease, display 0.2s allow-discrete, overlay 0.2s allow-discrete;
+      }
+
+      @starting-style {
+        .rewards-card:is(:popover-open, .\:popover-open) {
+          opacity: 0;
+          translate: 0 -0.5rem;
+        }
+      }
+    }
