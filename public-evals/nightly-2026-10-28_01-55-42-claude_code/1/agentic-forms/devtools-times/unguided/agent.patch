@@ -0,0 +1,62 @@
+/**
+ * Thin wrapper around the WebMCP imperative API so React islands can expose
+ * their functionality as tools to AI agents.
+ *
+ * Usage inside a component:
+ *
+ *   useEffect(() => registerWebMCPTool({ name, description, inputSchema, execute }), [deps]);
+ *
+ * The returned cleanup unregisters the tool, which keeps the browser's tool
+ * list in sync with what is actually mounted (including across view
+ * transitions driven by Astro's ClientRouter).
+ */
+
+export type WebMCPTool<Args = Record<string, unknown>> = ModelContextTool<Args>;
+
+export function getModelContext(): ModelContext | undefined {
+  if (typeof document !== 'undefined' && document.modelContext) {
+    return document.modelContext;
+  }
+  if (typeof navigator !== 'undefined' && navigator.modelContext) {
+    return navigator.modelContext;
+  }
+  return undefined;
+}
+
+export function isWebMCPSupported(): boolean {
+  return getModelContext() !== undefined;
+}
+
+/**
+ * Registers a tool with the browser's model context. Returns a cleanup
+ * function that unregisters it. A no-op when the browser lacks WebMCP, so
+ * callers never need to feature-detect themselves.
+ */
+export function registerWebMCPTool<Args>(tool: WebMCPTool<Args>): () => void {
+  const modelContext = getModelContext();
+  if (!modelContext) {
+    return () => {};
+  }
+
+  const controller = new AbortController();
+
+  try {
+    Promise.resolve(modelContext.registerTool(tool, { signal: controller.signal })).catch((error) => {
+      console.warn(`WebMCP: failed to register tool "${tool.name}"`, error);
+    });
+  } catch (error) {
+    console.warn(`WebMCP: failed to register tool "${tool.name}"`, error);
+    return () => {};
+  }
+
+  return () => {
+    // Current Chrome removes the tool when the signal aborts; older previews
+    // expose unregisterTool(name) instead. Do both, ignoring "not found".
+    controller.abort();
+    try {
+      modelContext.unregisterTool?.(tool.name);
+    } catch {
+      /* already removed via the signal */
+    }
+  };
+}
