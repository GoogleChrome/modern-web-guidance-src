@@ -0,0 +1,57 @@
+/**
+ * Client-side auth requests shared by the sign-in / sign-up forms and the
+ * WebMCP tools that expose them to AI agents.
+ */
+
+const AUTH_API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface AuthResult {
+  ok: boolean;
+  /** Human-readable outcome, suitable for both the UI banner and a tool response. */
+  message: string;
+}
+
+async function postCredentials(
+  path: '/login' | '/register',
+  username: string,
+  password: string,
+  failurePrefix: string,
+  successMessage: string,
+): Promise<AuthResult> {
+  try {
+    const response = await fetch(`${AUTH_API_BASE}${path}`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify({ username, password }),
+    });
+
+    const data = await response.json();
+
+    if (!response.ok) {
+      // TODO: Handle specific error codes (APP_ERR_1001, APP_ERR_1002, APP_ERR_2001, APP_ERR_2002, ...) properly.
+      // For now, we return a generic error message including the code.
+      return { ok: false, message: `${failurePrefix}: ${data.error || 'Unknown error'}` };
+    }
+
+    return { ok: true, message: successMessage };
+  } catch (err) {
+    return { ok: false, message: 'An unexpected error occurred. Please try again later.' };
+  }
+}
+
+export function signIn(username: string, password: string): Promise<AuthResult> {
+  // You might store the token here if needed, e.g., localStorage.setItem('token', data.token);
+  return postCredentials('/login', username, password, 'Login failed', 'Login successful!');
+}
+
+export function signUp(username: string, password: string): Promise<AuthResult> {
+  return postCredentials(
+    '/register',
+    username,
+    password,
+    'Registration failed',
+    'User registered successfully! You can now sign in.',
+  );
+}
