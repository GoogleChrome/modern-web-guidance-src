+}
+/*
+ * WebMCP agent activity.
+ * `:tool-form-active` matches a form while an AI agent is filling it in;
+ * `:tool-submit-active` matches the submit button while the browser pauses for
+ * the user to review an agent-filled form before it is sent.
+ * Each pseudo-class gets its own rule: a browser that does not know one would
+ * otherwise drop the whole selector list.
+ */
+form:tool-form-active {
+  outline: 2px dashed var(--color-amber-400);
+  outline-offset: 0.75rem;
+  background-color: color-mix(in oklab, var(--color-amber-400) 8%, transparent);
+}
+
+button:tool-submit-active {
+  outline: 2px dashed var(--color-amber-400);
+  outline-offset: 2px;
+  animation: webmcp-review-pulse 2s ease-in-out infinite;
+}
+
+@keyframes webmcp-review-pulse {
+  50% {
+    outline-color: transparent;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  button:tool-submit-active {
+    animation: none;
+  }
+}
