new file mode 100644
index 0000000..6f5d39a
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,72 @@
+/**
+ * Helpers for exposing forms to AI agents through the WebMCP declarative API.
+ *
+ * A `<form>` carrying `toolname` / `tooldescription` attributes is surfaced to
+ * browser agents as a tool: the browser builds the tool's input schema from the
+ * form controls, fills them in on the agent's behalf and dispatches a normal
+ * `submit` event. That event carries two extras: `agentInvoked` and
+ * `respondWith()`, which hands a result back to the agent without navigating.
+ *
+ * Browsers without WebMCP ignore the attributes and the forms keep working as
+ * ordinary HTML forms, so no feature detection is required.
+ *
+ * Spec: https://webmachinelearning.github.io/webmcp/
+ */
+
+import type { FormEvent } from 'react';
+
+/** `SubmitEvent` as dispatched by a WebMCP-capable browser. */
+export interface AgentSubmitEvent extends SubmitEvent {
+  /** `true` when an AI agent, rather than the user, triggered the submission. */
+  readonly agentInvoked?: boolean;
+  /** Returns the eventual tool result to the agent. Must be called synchronously. */
+  respondWith?(result: Promise<unknown>): void;
+}
+
+interface ToolFormOptions {
+  /** Unique, verb-first tool name, e.g. `sign-in`. */
+  name: string;
+  /** What the tool does and when an agent should use it. */
+  description: string;
+  /**
+   * Let the agent submit without waiting for the user to click the submit
+   * button. Leave off for consequential actions so the user reviews first.
+   */
+  autoSubmit?: boolean;
+}
+
+/**
+ * Attributes that declare a `<form>` as a WebMCP tool. Spread the result onto
+ * the form element; the attributes are not in React's JSX typings yet.
+ */
+export function toolFormAttributes({ name, description, autoSubmit = false }: ToolFormOptions) {
+  const attributes: Record<string, string> = {
+    toolname: name,
+    tooldescription: description,
+  };
+  if (autoSubmit) {
+    attributes.toolautosubmit = '';
+  }
+  return attributes;
+}
+
+/**
+ * Attribute that describes one form control in the tool's generated schema.
+ * Describe what the value means; types and limits already come from the control.
+ */
+export function toolParamAttributes(description: string) {
+  return { toolparamdescription: description } as Record<string, string>;
+}
+
+/**
+ * Routes a submission's outcome back to the agent when the submit came from a
+ * WebMCP tool call. A no-op for ordinary user submissions. Returns `result` so
+ * callers can keep awaiting it.
+ */
+export function respondToAgent<T>(event: FormEvent<HTMLFormElement>, result: Promise<T>): Promise<T> {
+  const native = event.nativeEvent as AgentSubmitEvent;
+  if (native.agentInvoked && typeof native.respondWith === 'function') {
+    native.respondWith(result);
+  }
+  return result;
+}
