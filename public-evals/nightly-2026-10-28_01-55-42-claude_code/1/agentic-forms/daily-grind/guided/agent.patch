+  <script>
+    (() => {
+      const form = document.getElementById('quick-order-form');
+      const status = document.getElementById('order-status');
+      const list = document.getElementById('order-list');
+      const order = [];
+
+      const labelFor = (name, value) => {
+        const control = form.elements[name];
+        if (control instanceof HTMLSelectElement) {
+          return control.options[control.selectedIndex]?.text ?? value;
+        }
+        const radio = form.querySelector(`input[name="${name}"][value="${CSS.escape(value)}"]`);
+        return radio?.parentElement?.textContent.trim() ?? value;
+      };
+
+      const renderOrder = () => {
+        list.replaceChildren(...order.map((item) => {
+          const li = document.createElement('li');
+          li.textContent = `${item.quantity} × ${item.size} ${item.drink} (${item.milk}) · ${item.location} · for ${item.name}`;
+          return li;
+        }));
+      };
+
+      const setStatus = (state, message) => {
+        status.dataset.state = state;
+        status.textContent = message;
+      };
+
+      const validationErrors = () => {
+        const errors = [];
+        for (const control of form.elements) {
+          if (!control.name || control.willValidate === false) continue;
+          if (!control.checkValidity()) {
+            errors.push({ field: control.name, message: control.validationMessage });
+          }
+        }
+        const qty = Number(form.elements.quantity.value);
+        if (!Number.isInteger(qty) || qty < 1 || qty > 10) {
+          errors.push({ field: 'quantity', message: 'must be a whole number between 1 and 10' });
+        }
+        return errors;
+      };
+
+      // Simulates sending the line item to the ordering backend.
+      const addLineItem = async (data) => {
+        const item = {
+          drink: labelFor('drink', data.get('drink')),
+          size: labelFor('size', data.get('size')).replace(/\s*\(.*\)$/, ''),
+          milk: labelFor('milk', data.get('milk')),
+          quantity: Number(data.get('quantity')),
+          location: labelFor('location', data.get('location')),
+          name: String(data.get('pickup_name')).trim(),
+        };
+        await new Promise((resolve) => setTimeout(resolve, 150));
+        order.push(item);
+        renderOrder();
+        const total = order.reduce((sum, i) => sum + i.quantity, 0);
+        return `Added ${item.quantity} × ${item.size} ${item.drink} with ${item.milk} to the order for ${item.name}, ` +
+          `pickup at ${item.location}. The order now has ${total} drink${total === 1 ? '' : 's'}.`;
+      };
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const errors = validationErrors();
+        if (errors.length > 0) {
+          const message = 'Validation failed: ' +
+            errors.map((err) => `${err.field} (${err.message})`).join(', ');
+          setStatus('error', message);
+          if (event.agentInvoked) {
+            event.respondWith(Promise.resolve(message));
+          } else {
+            form.reportValidity();
+          }
+          return;
+        }
+
+        const submitButton = form.querySelector('button[type="submit"]');
+        submitButton.disabled = true;
+        setStatus('ok', 'Adding to your order…');
+
+        const result = addLineItem(new FormData(form))
+          .then((message) => {
+            setStatus('ok', message);
+            return message;
+          })
+          .catch((error) => {
+            const message = `Could not add the drink: ${error.message}`;
+            setStatus('error', message);
+            return message;
+          })
+          .finally(() => {
+            submitButton.disabled = false;
+          });
+
+        if (event.agentInvoked) {
+          event.respondWith(result);
+        }
+      });
+
+      // Clear stale status as soon as the user starts editing again.
+      form.addEventListener('input', () => {
+        if (status.dataset.state === 'error') setStatus('', '');
+      });
+
+      // WebMCP lifecycle events: Chrome 156+ dispatches on document.modelContext, older on window.
+      const toolEventTarget = (type) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window);
+
+      toolEventTarget('toolactivated').addEventListener('toolactivated', (event) => {
+        if (event.toolName === 'add-coffee-to-order') {
+          setStatus('ok', 'Your assistant is filling in the quick order form…');
+        }
+      });
+
+      toolEventTarget('toolcancel').addEventListener('toolcancel', (event) => {
+        if (event.toolName === 'add-coffee-to-order') {
+          setStatus('', '');
+        }
+      });
+    })();
+  </script>
+
