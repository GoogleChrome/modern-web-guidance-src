+  <script>
+    (function () {
+      var form = document.getElementById('quick-order-form');
+      var totalEl = document.getElementById('order-total');
+      var errorEl = document.getElementById('form-error');
+      var banner = document.getElementById('agent-banner');
+      var confirmation = document.getElementById('order-confirmation');
+      var confirmationLede = document.getElementById('confirmation-lede');
+      var confirmationDetails = document.getElementById('confirmation-details');
+
+      var SHOT_PRICE = 1.0;
+      var TAX_RATE = 0.0875;
+      var PICKUP_LABELS = { asap: 'about 10 minutes', '15': '15 minutes', '30': '30 minutes', '60': '1 hour' };
+
+      function selectedOption(name) {
+        var el = form.elements[name];
+        return el && el.options ? el.options[el.selectedIndex] : null;
+      }
+
+      function optionLabel(name) {
+        var opt = selectedOption(name);
+        return opt ? opt.textContent.replace(/\s*\(\+\$[\d.]+\)\s*$/, '').trim() : '';
+      }
+
+      function clampInt(value, min, max, fallback) {
+        var n = parseInt(value, 10);
+        if (isNaN(n)) return fallback;
+        return Math.min(max, Math.max(min, n));
+      }
+
+      function priceOrder() {
+        var drink = selectedOption('drink');
+        var base = drink && drink.dataset.price ? parseFloat(drink.dataset.price) : 0;
+        if (!base) return null;
+        var size = selectedOption('size');
+        var milk = selectedOption('milk');
+        var shots = clampInt(form.elements.extra_shots.value, 0, 4, 0);
+        var qty = clampInt(form.elements.quantity.value, 1, 12, 1);
+        var unit = base
+          + (size ? parseFloat(size.dataset.surcharge || 0) : 0)
+          + (milk ? parseFloat(milk.dataset.surcharge || 0) : 0)
+          + shots * SHOT_PRICE;
+        var subtotal = unit * qty;
+        var tax = subtotal * TAX_RATE;
+        return {
+          unitPrice: round2(unit),
+          quantity: qty,
+          extraShots: shots,
+          subtotal: round2(subtotal),
+          tax: round2(tax),
+          total: round2(subtotal + tax)
+        };
+      }
+
+      function round2(n) { return Math.round(n * 100) / 100; }
+      function money(n) { return '$' + n.toFixed(2); }
+
+      function updateTotal() {
+        var p = priceOrder();
+        totalEl.textContent = p ? money(p.total) : '$0.00';
+      }
+
+      function validate() {
+        var errors = [];
+        if (!form.elements.drink.value) errors.push('Choose a drink.');
+        if (!form.elements.pickup_location.value) errors.push('Choose a pickup café.');
+        if (!form.elements.customer_name.value.trim()) errors.push('Enter a name for the order.');
+        var qty = parseInt(form.elements.quantity.value, 10);
+        if (isNaN(qty) || qty < 1 || qty > 12) errors.push('Quantity must be between 1 and 12.');
+        var shots = parseInt(form.elements.extra_shots.value || '0', 10);
+        if (isNaN(shots) || shots < 0 || shots > 4) errors.push('Extra shots must be between 0 and 4.');
+        return errors;
+      }
+
+      function buildOrder() {
+        var pricing = priceOrder();
+        var pickupKey = form.elements.pickup_time.value;
+        var minutes = pickupKey === 'asap' ? 10 : parseInt(pickupKey, 10);
+        var ready = new Date(Date.now() + minutes * 60000);
+        var orderId = 'DG-' + ready.getTime().toString(36).toUpperCase().slice(-6);
+        var milk = form.elements.milk.value;
+        return {
+          status: 'confirmed',
+          orderId: orderId,
+          customerName: form.elements.customer_name.value.trim(),
+          item: {
+            drink: optionLabel('drink'),
+            drinkId: form.elements.drink.value,
+            size: form.elements.size.value,
+            milk: milk,
+            temperature: form.elements.temperature.value,
+            extraShots: pricing.extraShots,
+            quantity: pricing.quantity,
+            notes: form.elements.notes.value.trim() || null
+          },
+          pickup: {
+            location: optionLabel('pickup_location'),
+            locationId: form.elements.pickup_location.value,
+            readyIn: PICKUP_LABELS[pickupKey] || pickupKey,
+            readyAt: ready.toISOString()
+          },
+          pricing: { currency: 'USD', unitPrice: pricing.unitPrice, subtotal: pricing.subtotal, tax: pricing.tax, total: pricing.total },
+          summary: pricing.quantity + ' × ' + form.elements.size.value + ' ' + form.elements.temperature.value + ' '
+            + optionLabel('drink') + (milk !== 'none' ? ' with ' + milk + ' milk' : '')
+            + (pricing.extraShots ? ', ' + pricing.extraShots + ' extra shot' + (pricing.extraShots > 1 ? 's' : '') : '')
+            + ' for ' + form.elements.customer_name.value.trim() + ' at ' + optionLabel('pickup_location')
+            + ', ready in ' + (PICKUP_LABELS[pickupKey] || pickupKey) + '. Total ' + money(pricing.total) + '.'
+        };
+      }
+
+      function showConfirmation(order) {
+        confirmationLede.textContent = 'Thanks, ' + order.customerName + '! Order ' + order.orderId
+          + ' will be ready at the ' + order.pickup.location + ' café in ' + order.pickup.readyIn + '.';
+        var rows = [
+          ['Drink', order.item.quantity + ' × ' + order.item.drink],
+          ['Details', order.item.size + ', ' + order.item.temperature
+            + (order.item.milk !== 'none' ? ', ' + order.item.milk + ' milk' : '')
+            + (order.item.extraShots ? ', +' + order.item.extraShots + ' shot(s)' : '')],
+          ['Notes', order.item.notes || '—'],
+          ['Subtotal', money(order.pricing.subtotal)],
+          ['Tax', money(order.pricing.tax)],
+          ['Total', money(order.pricing.total)]
+        ];
+        confirmationDetails.innerHTML = '';
+        rows.forEach(function (row) {
+          var dt = document.createElement('dt');
+          dt.textContent = row[0];
+          var dd = document.createElement('dd');
+          dd.textContent = row[1];
+          confirmationDetails.appendChild(dt);
+          confirmationDetails.appendChild(dd);
+        });
+        confirmation.classList.add('is-visible');
+        confirmation.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+      }
+
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+      form.addEventListener('reset', function () {
+        setTimeout(updateTotal, 0);
+        errorEl.textContent = '';
+        confirmation.classList.remove('is-visible');
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        var agentInvoked = !!event.agentInvoked;
+        var canRespond = agentInvoked && typeof event.respondWith === 'function';
+        var errors = validate();
+
+        if (errors.length) {
+          errorEl.textContent = errors.join(' ');
+          if (canRespond) {
+            event.respondWith(Promise.resolve({ status: 'error', errors: errors }));
+          }
+          return;
+        }
+
+        errorEl.textContent = '';
+        var order = buildOrder();
+        showConfirmation(order);
+        banner.classList.remove('is-visible');
+
+        if (canRespond) {
+          event.respondWith(Promise.resolve(order));
+        }
+      });
+
+      // WebMCP lifecycle events: let the user see when an assistant is working the form.
+      var modelContext = document.modelContext || navigator.modelContext;
+      if (modelContext && typeof modelContext.addEventListener === 'function') {
+        modelContext.addEventListener('toolactivated', function (e) {
+          if (e.toolName && e.toolName !== 'place_quick_order') return;
+          updateTotal();
+          banner.textContent = 'Your assistant has filled in this order. Review it below, then it will be placed.';
+          banner.classList.add('is-visible');
+        });
+        modelContext.addEventListener('toolcancel', function (e) {
+          if (e.toolName && e.toolName !== 'place_quick_order') return;
+          banner.textContent = 'Assistant order cancelled. You can finish the form yourself.';
+          banner.classList.add('is-visible');
+        });
+      }
+
+      updateTotal();
+    })();
+  </script>
+
 </body>
 
 </html>
