+    // Read `validity.valid` rather than calling checkValidity(), which would
+    // dispatch another `invalid` event and recurse through our listener.
+    const invalid = this.#touched && this.#internals?.validity.valid === false;
+    const states = this.#internals?.states;
+    if (states) {
+      states[invalid ? 'add' : 'delete']('user-invalid');
+    }
+    this.toggleAttribute('data-user-invalid', invalid);
+    this.#group.setAttribute('aria-invalid', String(invalid));
