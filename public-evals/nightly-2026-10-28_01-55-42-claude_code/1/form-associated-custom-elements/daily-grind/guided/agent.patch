--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,376 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Usage:
+ *   <label for="rating">Overall rating</label>
+ *   <star-rating id="rating" name="rating" required label="Overall rating"></star-rating>
+ *
+ * Attributes: name, value (1–5), required, disabled, max (default 5), label
+ * Events: input (bubbles, composed), change (bubbles)
+ * Form integration: submits its own value, supports required constraint
+ * validation, reset, <fieldset disabled>, and browser state restoration.
+ */
+
+const STAR_PATH =
+  'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-block;
+      --_filled: var(--star-filled, #ffab40);
+      --_empty: var(--star-empty, #c9bdb8);
+      --_size: var(--star-size, 2.25rem);
+    }
+    :host([hidden]) { display: none; }
+
+    .group {
+      display: inline-flex;
+      gap: 0.125rem;
+      border-radius: 0.5rem;
+    }
+
+    button {
+      all: unset;
+      box-sizing: border-box;
+      display: inline-grid;
+      place-items: center;
+      inline-size: var(--_size);
+      block-size: var(--_size);
+      min-inline-size: 44px;
+      min-block-size: 44px;
+      border-radius: 0.375rem;
+      color: var(--_empty);
+      cursor: pointer;
+      transition: color 120ms ease, transform 120ms ease;
+    }
+    svg {
+      inline-size: 85%;
+      block-size: 85%;
+      fill: currentColor;
+      pointer-events: none;
+    }
+    button[data-filled] { color: var(--_filled); }
+
+    /* Hover preview: fill up to the hovered star, empty the rest. */
+    @media (hover: hover) {
+      .group:not([aria-disabled="true"]):hover button { color: var(--_filled); }
+      .group:not([aria-disabled="true"]):hover button:hover ~ button { color: var(--_empty); }
+      .group:not([aria-disabled="true"]) button:hover { transform: scale(1.12); }
+    }
+
+    button:focus-visible {
+      outline: 3px solid var(--star-focus, #4e342e);
+      outline-offset: 2px;
+    }
+
+    /* The host matches :disabled automatically when form-associated. */
+    :host(:disabled) button {
+      cursor: not-allowed;
+      opacity: 0.45;
+      transform: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      button { transition: none; }
+    }
+  </style>
+  <div class="group" part="group" role="radiogroup"></div>
+`;
+
+const supportsFACE =
+  'attachInternals' in HTMLElement.prototype &&
+  typeof ElementInternals !== 'undefined' &&
+  'setFormValue' in ElementInternals.prototype;
+
+export class StarRating extends HTMLElement {
+  // MANDATORY: opts the element into form participation.
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'max', 'label', 'name'];
+
+  #internals = null;
+  #group;
+  #buttons = [];
+  #value = '';
+  #touched = false;
+  #fallbackInput = null; // only used where FACE is unsupported
+
+  constructor() {
+    super();
+    if (supportsFACE) this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+    this.#group = root.querySelector('.group');
+
+    this.#group.addEventListener('click', this.#onClick);
+    this.#group.addEventListener('keydown', this.#onKeydown);
+    // A failed form submit / reportValidity() dispatches `invalid` on the host.
+    this.addEventListener('invalid', () => {
+      this.#touched = true;
+      this.#reflectUserInvalid();
+    });
+  }
+
+  connectedCallback() {
+    this.#renderStars();
+    if (!supportsFACE) this.#ensureFallbackInput();
+    // Attributes such as `required`/`value` are available now.
+    if (this.hasAttribute('value') && !this.#value) {
+      this.#setValue(this.getAttribute('value'), { silent: true });
+    } else {
+      this.#syncFormValue();
+      this.#validate();
+    }
+    this.#reflectUserInvalid();
+    this.#wireDescription();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    switch (name) {
+      case 'value':
+        // The attribute is the *default* value; only adopt it before user interaction.
+        if (!this.#touched) this.#setValue(newValue ?? '', { silent: true });
+        break;
+      case 'required':
+        this.#validate();
+        this.#group.setAttribute('aria-required', String(this.required));
+        break;
+      case 'max':
+        if (this.isConnected) this.#renderStars();
+        break;
+      case 'label':
+        this.#group.setAttribute('aria-label', newValue || 'Rating');
+        break;
+      case 'name':
+        if (this.#fallbackInput) this.#fallbackInput.name = newValue ?? '';
+        break;
+    }
+  }
+
+  /* ---------- Public API (mirrors native controls) ---------- */
+
+  get value() { return this.#value; }
+  set value(v) { this.#setValue(v, { silent: true }); }
+
+  get valueAsNumber() { return this.#value === '' ? NaN : Number(this.#value); }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.setAttribute('name', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get max() {
+    const n = Number.parseInt(this.getAttribute('max') ?? '5', 10);
+    return Number.isFinite(n) && n >= 1 && n <= 10 ? n : 5;
+  }
+
+  get type() { return 'star-rating'; }
+  get form() { return this.#internals?.form ?? this.closest('form'); }
+  get labels() { return this.#internals?.labels ?? []; }
+  get validity() { return this.#internals?.validity; }
+  get validationMessage() { return this.#internals?.validationMessage ?? ''; }
+  get willValidate() { return this.#internals?.willValidate ?? false; }
+  checkValidity() { return this.#internals?.checkValidity() ?? true; }
+  reportValidity() { return this.#internals?.reportValidity() ?? true; }
+
+  /* ---------- Form-associated lifecycle callbacks ---------- */
+
+  formResetCallback() {
+    this.#touched = false;
+    this.#setValue(this.getAttribute('value') ?? '', { silent: true });
+    this.#reflectUserInvalid();
+  }
+
+  formDisabledCallback(disabled) {
+    // Disable the internal controls only. Do NOT toggle `disabled` on the host:
+    // that would leave it stuck disabled after a <fieldset> is re-enabled.
+    this.#group.setAttribute('aria-disabled', String(disabled));
+    for (const btn of this.#buttons) btn.disabled = disabled;
+    if (!disabled) this.#updateTabStops();
+  }
+
+  formStateRestoreCallback(state /*, mode: 'restore' | 'autocomplete' */) {
+    if (typeof state === 'string') this.#setValue(state, { silent: true });
+  }
+
+  /* ---------- Internals ---------- */
+
+  #renderStars() {
+    const max = this.max;
+    this.#group.replaceChildren();
+    this.#buttons = [];
+    for (let i = 1; i <= max; i++) {
+      const btn = document.createElement('button');
+      btn.type = 'button';
+      btn.setAttribute('role', 'radio');
+      btn.setAttribute('aria-checked', 'false');
+      btn.setAttribute('aria-label', i === 1 ? '1 star' : `${i} stars`);
+      btn.dataset.value = String(i);
+      btn.tabIndex = -1;
+      btn.setAttribute('part', 'star');
+      btn.innerHTML =
+        `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="${STAR_PATH}"/></svg>`;
+      this.#buttons.push(btn);
+    }
+    this.#group.append(...this.#buttons);
+    this.#group.setAttribute('aria-label', this.getAttribute('label') || 'Rating');
+    this.#group.setAttribute('aria-required', String(this.required));
+    if (this.matches(':disabled')) this.formDisabledCallback(true);
+    this.#paint();
+    this.#validate(); // re-anchor the validation message to the new first star
+  }
+
+  #onClick = (event) => {
+    const btn = event.target.closest('button');
+    if (!btn || btn.disabled) return;
+    this.#commit(btn.dataset.value);
+  };
+
+  #onKeydown = (event) => {
+    const btn = event.target.closest('button');
+    if (!btn || btn.disabled) return;
+    const current = this.#value ? Number(this.#value) : 0;
+    let next = null;
+    switch (event.key) {
+      case 'ArrowRight':
+      case 'ArrowUp':
+        next = Math.min(this.max, current + 1);
+        break;
+      case 'ArrowLeft':
+      case 'ArrowDown':
+        next = Math.max(1, current - 1);
+        break;
+      case 'Home':
+        next = 1;
+        break;
+      case 'End':
+        next = this.max;
+        break;
+      case ' ':
+      case 'Enter':
+        event.preventDefault();
+        this.#commit(btn.dataset.value);
+        return;
+      default:
+        return;
+    }
+    event.preventDefault();
+    this.#commit(String(next));
+    this.#buttons[next - 1]?.focus();
+  };
+
+  /** Called for user-driven changes: updates value and fires input/change. */
+  #commit(next) {
+    this.#touched = true;
+    if (next === this.#value) {
+      this.#reflectUserInvalid();
+      return;
+    }
+    this.#setValue(next, { silent: false });
+  }
+
+  #setValue(raw, { silent }) {
+    const n = Number.parseInt(raw, 10);
+    const normalized = Number.isFinite(n) && n >= 1 && n <= this.max ? String(n) : '';
+    const changed = normalized !== this.#value;
+    this.#value = normalized;
+    this.#syncFormValue();
+    this.#validate();
+    this.#paint();
+    this.#reflectUserInvalid();
+    if (!silent && changed) {
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    }
+  }
+
+  #syncFormValue() {
+    if (this.#internals) {
+      // Second argument is the state handed back to formStateRestoreCallback.
+      this.#internals.setFormValue(this.#value === '' ? null : this.#value, this.#value);
+    } else if (this.#fallbackInput) {
+      this.#fallbackInput.value = this.#value;
+    }
+  }
+
+  #validate() {
+    if (!this.#internals) return;
+    if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please choose a star rating.',
+        this.#buttons[0] ?? this.#group,
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+
+  #paint() {
+    const current = this.#value ? Number(this.#value) : 0;
+    this.#buttons.forEach((btn, idx) => {
+      const n = idx + 1;
+      btn.toggleAttribute('data-filled', n <= current);
+      btn.setAttribute('aria-checked', String(n === current));
+    });
+    this.#updateTabStops();
+  }
+
+  /** Roving tabindex: only the selected star (or the first) is in the tab order. */
+  #updateTabStops() {
+    const current = this.#value ? Number(this.#value) : 1;
+    this.#buttons.forEach((btn, idx) => {
+      btn.tabIndex = idx + 1 === current ? 0 : -1;
+    });
+  }
+
+  /**
+   * :user-invalid isn't reliably applied to form-associated custom elements,
+   * so expose an equivalent custom state (with an attribute fallback).
+   */
