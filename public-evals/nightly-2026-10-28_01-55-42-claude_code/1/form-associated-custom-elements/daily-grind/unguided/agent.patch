diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..5f8fe09
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,397 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Behaves like a native radio group of stars. Because it is form-associated
+ * (via ElementInternals), it takes part in:
+ *   - form submission      → its value appears in FormData under its `name`
+ *   - constraint validation → `required` blocks submission until a star is chosen
+ *   - form reset           → formResetCallback() restores the default value
+ *   - disabled fieldsets   → formDisabledCallback() fires for ancestor <fieldset disabled>
+ *   - state restoration    → formStateRestoreCallback() on back/forward navigation
+ *
+ * Attributes: name, value (default value), required, disabled, max (default 5), label
+ * Properties: value, name, required, disabled, max, form, labels, validity,
+ *             validationMessage, willValidate, checkValidity(), reportValidity()
+ * Events:     input, change (bubble + composed, like native controls)
+ */
+(function () {
+  'use strict';
+
+  if (customElements.get('star-rating')) return;
+
+  const template = document.createElement('template');
+  template.innerHTML = `
+    <style>
+      :host {
+        display: inline-block;
+        --star-size: 2.25rem;
+        --star-color: var(--star-rating-color, #ffab40);
+        --star-empty: var(--star-rating-empty-color, #d7ccc8);
+        --star-focus: var(--star-rating-focus-color, #4e342e);
+      }
+      :host([hidden]) { display: none; }
+
+      .stars {
+        display: inline-flex;
+        gap: 0.15rem;
+        padding: 0.15rem;
+        border-radius: 6px;
+      }
+
+      button {
+        all: unset;
+        cursor: pointer;
+        width: var(--star-size);
+        height: var(--star-size);
+        line-height: 1;
+        font-size: var(--star-size);
+        color: var(--star-empty);
+        text-align: center;
+        border-radius: 4px;
+        transition: color 0.12s ease, transform 0.12s ease;
+      }
+
+      button::before { content: "\\2605"; }
+
+      button[aria-checked="true"],
+      button.filled { color: var(--star-color); }
+
+      /* Hover preview: fill every star up to the hovered one */
+      .stars:hover button { color: var(--star-color); }
+      .stars button:hover ~ button { color: var(--star-empty); }
+      button:hover { transform: scale(1.12); }
+
+      button:focus-visible {
+        outline: 2px solid var(--star-focus);
+        outline-offset: 2px;
+      }
+
+      :host([aria-disabled="true"]) button,
+      :host(:disabled) button {
+        cursor: not-allowed;
+        opacity: 0.45;
+        transform: none;
+      }
+      :host([aria-disabled="true"]) .stars:hover button,
+      :host(:disabled) .stars:hover button { color: var(--star-empty); }
+      :host([aria-disabled="true"]) button[aria-checked="true"],
+      :host(:disabled) button[aria-checked="true"] { color: var(--star-color); }
+
+      :host(:user-invalid) .stars,
+      :host(.invalid) .stars {
+        outline: 2px solid #c62828;
+        outline-offset: 2px;
+      }
+
+      .sr-only {
+        position: absolute;
+        width: 1px; height: 1px;
+        padding: 0; margin: -1px;
+        overflow: hidden;
+        clip: rect(0, 0, 0, 0);
+        white-space: nowrap;
+        border: 0;
+      }
+    </style>
+    <div class="stars" part="stars"></div>
+    <span class="sr-only" aria-live="polite" id="status"></span>
+  `;
+
+  class StarRating extends HTMLElement {
+    static formAssociated = true;
+
+    static get observedAttributes() {
+      return ['value', 'required', 'disabled', 'max', 'label'];
+    }
+
+    #internals;
+    #value = '';
+    #dirty = false;      // true once the user (or script) sets .value; then the `value` attribute no longer drives it
+    #disabled = false;   // reflects own `disabled` attr OR a disabled ancestor fieldset
+    #starsEl;
+    #statusEl;
+
+    constructor() {
+      super();
+      this.#internals = this.attachInternals();
+      const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+      root.appendChild(template.content.cloneNode(true));
+      this.#starsEl = root.querySelector('.stars');
+      this.#statusEl = root.querySelector('#status');
+
+      if ('role' in this.#internals) {
+        this.#internals.role = 'radiogroup';
+      } else if (!this.hasAttribute('role')) {
+        this.setAttribute('role', 'radiogroup');
+      }
+
+      this.#starsEl.addEventListener('click', this.#onClick);
+      this.#starsEl.addEventListener('keydown', this.#onKeydown);
+      // Fired by the form when submission is blocked by this element's constraint.
+      this.addEventListener('invalid', () => this.classList.add('invalid'));
+    }
+
+    connectedCallback() {
+      if (!this.#dirty) this.#value = this.getAttribute('value') ?? '';
+      this.#renderStars();
+      this.#syncFormValue();
+      this.#syncValidity();
+      this.#syncLabel();
+    }
+
+    attributeChangedCallback(name, oldVal, newVal) {
+      if (oldVal === newVal) return;
+      switch (name) {
+        case 'value':
+          if (!this.#dirty) {
+            this.#value = this.#normalize(newVal ?? '');
+            this.#update();
+          }
+          break;
+        case 'max':
+          this.#value = this.#normalize(this.#value);
+          this.#renderStars();
+          this.#update();
+          break;
+        case 'required':
+          this.#syncValidity();
+          break;
+        case 'label':
+          this.#syncLabel();
+          break;
+        case 'disabled':
+          // formDisabledCallback handles this (and ancestor fieldsets).
+          break;
+      }
+    }
+
+    /* ---------- Form-associated lifecycle callbacks ---------- */
+
+    formAssociatedCallback(/* form */) {
+      this.#syncValidity();
+    }
+
+    /** Fired for own `disabled` attribute AND for any ancestor <fieldset disabled>. */
+    formDisabledCallback(disabled) {
+      this.#disabled = disabled;
+      this.toggleAttribute('aria-disabled', disabled);
+      this.#starsEl.setAttribute('aria-disabled', String(disabled));
+      this.#updateTabStops();
+      this.#syncValidity();
+    }
+
+    /** <form>.reset() or a reset button: go back to the default (`value` attribute). */
+    formResetCallback() {
+      this.#dirty = false;
+      this.#value = this.#normalize(this.getAttribute('value') ?? '');
+      this.classList.remove('invalid');
+      this.#update();
+    }
+
+    /** Browser restoring state after navigation (mode "restore") or autofill ("autocomplete"). */
+    formStateRestoreCallback(state, /* mode */) {
+      if (state == null) return;
+      this.#dirty = true;
+      this.#value = this.#normalize(state);
+      this.#update();
+    }
+
+    /* ---------- Public API (mirrors native form controls) ---------- */
+
+    get value() { return this.#value; }
+    set value(v) {
+      this.#dirty = true;
+      this.#value = this.#normalize(v);
+      this.#update();
+    }
+
+    get name() { return this.getAttribute('name') ?? ''; }
+    set name(v) { this.setAttribute('name', v); }
+
+    get max() {
+      const n = parseInt(this.getAttribute('max') ?? '5', 10);
+      return Number.isFinite(n) && n > 0 ? n : 5;
+    }
+    set max(v) { this.setAttribute('max', String(v)); }
+
+    get required() { return this.hasAttribute('required'); }
+    set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+    get disabled() { return this.hasAttribute('disabled'); }
+    set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+    get type() { return 'star-rating'; }
+    get form() { return this.#internals.form; }
+    get labels() { return this.#internals.labels; }
+    get validity() { return this.#internals.validity; }
+    get validationMessage() { return this.#internals.validationMessage; }
+    get willValidate() { return this.#internals.willValidate; }
+    checkValidity() { return this.#internals.checkValidity(); }
+    reportValidity() { return this.#internals.reportValidity(); }
+    setCustomValidity(message) {
+      if (message) {
+        this.#internals.setValidity({ customError: true }, message, this.#anchor());
+      } else {
+        this.#syncValidity();
+      }
+    }
+
+    /* ---------- Internals ---------- */
+
+    #normalize(v) {
+      if (v === '' || v == null) return '';
+      const n = parseInt(v, 10);
+      if (!Number.isFinite(n) || n < 1) return '';
+      return String(Math.min(n, this.max));
+    }
+
+    #renderStars() {
+      const max = this.max;
+      this.#starsEl.textContent = '';
+      for (let i = 1; i <= max; i++) {
+        const btn = document.createElement('button');
+        btn.type = 'button';
+        btn.setAttribute('role', 'radio');
+        btn.setAttribute('aria-label', `${i} star${i === 1 ? '' : 's'}`);
+        btn.setAttribute('aria-posinset', String(i));
+        btn.setAttribute('aria-setsize', String(max));
+        btn.dataset.value = String(i);
+        btn.setAttribute('part', 'star');
+        this.#starsEl.appendChild(btn);
+      }
+      this.#paint();
+      this.#updateTabStops();
+    }
+
+    #paint() {
+      const current = Number(this.#value) || 0;
+      for (const btn of this.#starsEl.children) {
+        const v = Number(btn.dataset.value);
+        btn.setAttribute('aria-checked', String(v === current));
+        btn.classList.toggle('filled', v <= current);
+      }
+      this.#updateTabStops();
+      const states = this.#internals.states;
+      if (states) {
+        try {
+          if (current > 0) states.add('rated'); else states.delete('rated');
+        } catch (_) { /* CustomStateSet unsupported — ignore */ }
+      }
+    }
+
+    /** Roving tabindex: only the checked star (or the first) is in the tab order. */
+    #updateTabStops() {
+      const current = Number(this.#value) || 0;
+      const buttons = Array.from(this.#starsEl.children);
+      buttons.forEach((btn, idx) => {
+        const isStop = current > 0 ? Number(btn.dataset.value) === current : idx === 0;
+        btn.tabIndex = this.#disabled ? -1 : (isStop ? 0 : -1);
+        if (this.#disabled) btn.setAttribute('aria-disabled', 'true');
+        else btn.removeAttribute('aria-disabled');
+      });
+    }
+
+    #anchor() {
+      const current = Number(this.#value) || 0;
+      return this.#starsEl.children[Math.max(current - 1, 0)] ?? this.#starsEl;
+    }
+
+    #syncFormValue() {
+      // Second argument is the *state* the browser hands back to formStateRestoreCallback.
+      this.#internals.setFormValue(this.#value, this.#value);
+    }
+
+    #syncValidity() {
+      if (this.required && this.#value === '') {
+        this.#internals.setValidity(
+          { valueMissing: true },
+          'Please choose a star rating.',
+          this.#anchor()
+        );
+      } else {
+        this.#internals.setValidity({});
+        this.classList.remove('invalid');
+      }
+    }
+
+    #syncLabel() {
+      const label = this.getAttribute('label');
+      if ('ariaLabel' in this.#internals) {
+        this.#internals.ariaLabel = label;
+      } else if (label) {
+        this.setAttribute('aria-label', label);
+      }
+    }
+
+    #update() {
+      this.#paint();
+      this.#syncFormValue();
+      this.#syncValidity();
+    }
+
+    #commit(newValue, { fromUser = true } = {}) {
+      const normalized = this.#normalize(newValue);
+      if (normalized === this.#value) return;
+      this.#dirty = true;
+      this.#value = normalized;
+      this.#update();
+      if (fromUser) {
+        this.#statusEl.textContent = normalized ? `${normalized} of ${this.max} stars` : 'No rating';
+        this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+      }
+    }
+
+    #onClick = (e) => {
+      if (this.#disabled) return;
+      const btn = e.target.closest('button');
+      if (!btn) return;
+      this.#commit(btn.dataset.value);
+      btn.focus();
+    };
+
+    #onKeydown = (e) => {
+      if (this.#disabled) return;
+      const btn = e.target.closest('button');
+      if (!btn) return;
+      const current = Number(this.#value) || 0;
+      const max = this.max;
+      let next = null;
+
+      switch (e.key) {
+        case 'ArrowRight':
+        case 'ArrowUp':
+          next = current >= max ? 1 : current + 1;
+          break;
+        case 'ArrowLeft':
+        case 'ArrowDown':
+          next = current <= 1 ? max : current - 1;
+          break;
+        case 'Home':
+          next = 1;
+          break;
+        case 'End':
+          next = max;
+          break;
+        case ' ':
+        case 'Enter':
+          next = Number(btn.dataset.value);
+          break;
+        case 'Backspace':
+        case 'Delete':
+          if (!this.required) next = 0;
+          break;
+        default:
+          return;
+      }
+
+      e.preventDefault();
+      if (next === null) return;
+      this.#commit(next === 0 ? '' : next);
+      const target = this.#starsEl.children[Math.max((next || 1) - 1, 0)];
+      if (target) target.focus();
+    };
+  }
+
+  customElements.define('star-rating', StarRating);
+})();
