+  <script src="star-rating.js" defer></script>
+  <script>
+    document.addEventListener('DOMContentLoaded', function () {
+      var form = document.getElementById('feedback-form');
+      var ratingFieldset = document.getElementById('rating-fieldset');
+      var skipRating = document.getElementById('skip-rating');
+      var status = form.querySelector('.form-status');
+
+      // Disabling the whole fieldset disables the <star-rating> inside it too
+      // (formDisabledCallback fires), which also lifts its `required` constraint.
+      function syncRatingFieldset() {
+        ratingFieldset.disabled = skipRating.checked;
+      }
+      skipRating.addEventListener('change', syncRatingFieldset);
+      syncRatingFieldset();
+
+      form.addEventListener('reset', function () {
+        status.textContent = '';
+        // The checkbox resets after this event; sync once that has happened.
+        setTimeout(syncRatingFieldset, 0);
+      });
+
+      // The site has no backend yet, so we intercept the (already constraint-validated)
+      // submission and echo back what the browser would have sent.
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        var data = new FormData(form);
+        var rating = data.get('rating');
+        var name = (data.get('name') || '').trim();
+        var drinkLabel = form.elements.drink.selectedOptions[0].textContent;
+        var who = name ? name : 'friend';
+        var ratingText = rating ? rating + ' out of 5 stars' : 'no star rating';
+        form.reset();
+        status.textContent = 'Thanks, ' + who + '! We logged ' + ratingText + ' for your ' + drinkLabel + '.';
+      });
+    });
+  </script>
+
