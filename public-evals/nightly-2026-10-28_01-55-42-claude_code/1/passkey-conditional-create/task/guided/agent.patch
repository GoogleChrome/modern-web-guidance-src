+  <script type="module">
+    // Ensure getClientCapabilities / parseCreationOptionsFromJSON / toJSON exist on
+    // older browsers. Loaded best-effort; a failed load must not break sign-in.
+    if ('PublicKeyCredential' in window) {
+      try {
+        await import('https://cdn.jsdelivr.net/npm/webauthn-polyfills/+esm');
+      } catch { /* ignore: fall back to native support only */ }
+    }
+
+    const form = document.getElementById('signin-form');
+    const button = document.getElementById('signin-button');
+    const status = document.getElementById('signin-status');
+    const welcome = document.getElementById('welcome');
+    const welcomeMessage = document.getElementById('welcome-message');
+    const passwordInput = document.getElementById('current-password');
+    const toggle = document.getElementById('toggle-password');
+
+    toggle.addEventListener('click', () => {
+      const show = passwordInput.type === 'password';
+      passwordInput.type = show ? 'text' : 'password';
+      toggle.textContent = show ? 'Hide' : 'Show';
+      toggle.setAttribute('aria-pressed', String(show));
+    });
+
+    function setStatus(message, kind = '') {
+      status.textContent = message;
+      status.className = 'form-status' + (kind ? ' ' + kind : '');
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+
+      const email = form.elements.email.value.trim();
+      const password = form.elements.password.value;
+
+      button.disabled = true;
+      setStatus('Signing in…');
+
+      let result;
+      try {
+        result = await signInWithPassword(email, password);
+      } catch (err) {
+        button.disabled = false;
+        setStatus(err.message || 'Sign-in failed. Please try again.', 'error');
+        return;
+      }
+
+      button.disabled = false;
+      setStatus('');
+      form.hidden = true;
+      welcomeMessage.textContent = `Signed in as ${result.email || email}. Head to your account to see your rewards.`;
+      welcome.hidden = false;
+
+      // Successful *password* sign-in is the right trigger for silent passkey
+      // promotion. Fire-and-forget: it never surfaces UI or errors to the user.
+      promotePasskeyInBackground();
+    });
+
+    async function signInWithPassword(email, password) {
+      const response = await fetch(form.action, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify({ email, password }),
+      });
+      if (!response.ok) {
+        throw new Error(response.status === 401 || response.status === 403
+          ? 'Incorrect email or password.'
+          : 'Sign-in failed. Please try again.');
+      }
+      try { return await response.json(); } catch { return {}; }
+    }
+
+    // --- Automatic passkey promotion (WebAuthn conditional create) ---------
+
+    async function promotePasskeyInBackground() {
+      try {
+        await conditionalCreatePasskey();
+      } catch (err) {
+        // Never show any UI for this flow; log unexpected failures only.
+        console.debug('Passkey promotion skipped:', err);
+      }
+    }
+
+    async function conditionalCreatePasskey() {
+      if (!window.PublicKeyCredential ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+        return;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities?.conditionalCreate !== true) {
+        return; // Platform cannot create a passkey silently.
+      }
+
+      // Ask the server for creation options, flagging this as a conditional
+      // request so it can relax user-presence checks only for this flow.
+      const optionsResponse = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify({ conditional: true }),
+      });
+      if (!optionsResponse.ok) return;
+
+      const optionsJSON = await optionsResponse.json();
+      const rpId = optionsJSON?.rp?.id || location.hostname;
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+      } catch (err) {
+        // Expected outcomes (already registered, no password manager consent,
+        // aborted) are swallowed silently with no error UI.
+        if (['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(err?.name)) {
+          return;
+        }
+        console.debug('Unexpected conditional create error:', err);
+        return;
+      }
+      if (!credential) return;
+
+      const encoded = credential.toJSON();
+      let verified = false;
+      try {
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ ...encoded, conditional: true }),
+        });
+        verified = verifyResponse.ok;
+      } catch (err) {
+        console.debug('Passkey verification network failure:', err);
+      }
+
+      if (!verified) {
+        // Keep the passkey provider in sync so an orphaned credential does not
+        // linger on the device after a failed server-side verification.
+        if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encoded.id,
+            });
+          } catch { /* best-effort */ }
+        }
+      }
+    }
+  </script>
