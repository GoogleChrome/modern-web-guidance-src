+  <script>
+    (function () {
+      var picker = document.getElementById('roast-picker');
+      var trigger = document.getElementById('roast-trigger');
+      var menu = document.getElementById('roast-menu');
+      var valueEl = document.getElementById('roast-value');
+      var thumb = document.getElementById('roast-thumb');
+      var orderBtn = document.getElementById('order-btn');
+      var options = Array.prototype.slice.call(menu.querySelectorAll('[role="option"]'));
+
+      function selectedIndex() {
+        for (var i = 0; i < options.length; i++) {
+          if (options[i].getAttribute('aria-selected') === 'true') return i;
+        }
+        return 0;
+      }
+
+      function open() {
+        menu.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        options[selectedIndex()].focus();
+      }
+
+      function close(refocus) {
+        if (menu.hidden) return;
+        menu.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (refocus) trigger.focus();
+      }
+
+      function select(opt) {
+        options.forEach(function (o) { o.setAttribute('aria-selected', String(o === opt)); });
+        trigger.setAttribute('aria-activedescendant', opt.id);
+        valueEl.textContent = opt.getAttribute('data-label');
+        thumb.src = opt.getAttribute('data-img');
+        var url = new URL(orderBtn.getAttribute('href'), location.href);
+        url.searchParams.set('roast', opt.getAttribute('data-value'));
+        orderBtn.setAttribute('href', url.pathname + url.search);
+        close(true);
+      }
+
+      trigger.addEventListener('click', function () {
+        menu.hidden ? open() : close(false);
+      });
+
+      trigger.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === ' ' || e.key === 'Enter') {
+          e.preventDefault();
+          open();
+        }
+      });
+
+      options.forEach(function (opt, i) {
+        opt.addEventListener('click', function () { select(opt); });
+        opt.addEventListener('keydown', function (e) {
+          var next = null;
+          switch (e.key) {
+            case 'ArrowRight':
+            case 'ArrowDown': next = options[(i + 1) % options.length]; break;
+            case 'ArrowLeft':
+            case 'ArrowUp': next = options[(i - 1 + options.length) % options.length]; break;
+            case 'Home': next = options[0]; break;
+            case 'End': next = options[options.length - 1]; break;
+            case 'Enter':
+            case ' ': e.preventDefault(); select(opt); return;
+            case 'Escape': e.preventDefault(); close(true); return;
+            case 'Tab': close(false); return;
+            default: return;
+          }
+          e.preventDefault();
+          next.focus();
+        });
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!picker.contains(e.target)) close(false);
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape') close(true);
+      });
+
+      trigger.setAttribute('aria-activedescendant', options[selectedIndex()].id);
+    })();
+  </script>
+
