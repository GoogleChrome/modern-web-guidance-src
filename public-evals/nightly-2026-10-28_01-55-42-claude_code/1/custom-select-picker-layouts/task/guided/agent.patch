+  <script>
+    (() => {
+      const select = document.getElementById('roast');
+      const orderLink = document.querySelector('.hero .btn');
+      if (!select || !orderLink) return;
+
+      // Carry the chosen roast through to the order page.
+      const syncOrderLink = () => {
+        const url = new URL(orderLink.getAttribute('href'), location.href);
+        url.searchParams.set('roast', select.value);
+        orderLink.setAttribute('href', url.pathname + url.search);
+      };
+      select.addEventListener('change', syncOrderLink);
+      syncOrderLink();
+
+      // Grid-aware arrow keys: the native picker only knows Up/Down, so map
+      // Left/Right to the neighbouring card in the same row (by geometry).
+      if (!CSS.supports('appearance', 'base-select')) return;
+      select.addEventListener('keydown', (event) => {
+        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
+        if (!select.matches(':open')) return;
+        const options = Array.from(select.options);
+        const active = document.activeElement;
+        const current = options.includes(active) ? active : select.selectedOptions[0];
+        if (!current) return;
+        const rect = current.getBoundingClientRect();
+        const forward = event.key === 'ArrowRight';
+        let best = null;
+        let bestDistance = Infinity;
+        for (const option of options) {
+          if (option === current) continue;
+          const r = option.getBoundingClientRect();
+          const sameRow = r.bottom > rect.top && r.top < rect.bottom;
+          const distance = forward ? r.left - rect.right : rect.left - r.right;
+          if (sameRow && distance >= 0 && distance < bestDistance) {
+            best = option;
+            bestDistance = distance;
+          }
+        }
+        if (best) {
+          event.preventDefault();
+          best.focus();
+        }
+      });
+    })();
+  </script>
