diff --git a/src/scripts/view-transitions.js b/src/scripts/view-transitions.js
new file mode 100644
index 0000000..0385542
--- /dev/null
+++ b/src/scripts/view-transitions.js
@@ -0,0 +1,34 @@
+/**
+ * Cross-document view transition hooks.
+ *
+ * Layout.astro loads this file with `blocking="render"`. That guarantees it has
+ * run before the browser's first rendering opportunity for the incoming page,
+ * which is exactly when `pagereveal` fires. A listener registered any later
+ * (from a deferred script, a module script without `blocking="render"`, or a
+ * hydrated island) misses the event and can no longer customise the
+ * transition. Keep this file small: everything in it delays first paint.
+ *
+ * Both listeners tag the transition with a `back` or `forward` type so that
+ * global.css can pick the matching slide direction.
+ */
+
+/**
+ * @param {NavigationActivation | null | undefined} activation
+ * @returns {'back' | 'forward'}
+ */
+function directionFor(activation) {
+  if (activation?.navigationType === 'traverse' && activation.from) {
+    return activation.entry.index < activation.from.index ? 'back' : 'forward';
+  }
+  return 'forward';
+}
+
+// Outgoing page: fires right before the browser snapshots the old state.
+window.addEventListener('pageswap', (event) => {
+  event.viewTransition?.types?.add(directionFor(event.activation));
+});
+
+// Incoming page: fires right before the first frame of the new page renders.
+window.addEventListener('pagereveal', (event) => {
+  event.viewTransition?.types?.add(directionFor(window.navigation?.activation));
+});
diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..7727306 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,52 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+/*
+ * Cross-document (MPA) view transitions.
+ *
+ * Layout.astro links this stylesheet with blocking="render". That matters for
+ * the opt-in below: the browser checks for @view-transition when it unblocks
+ * rendering of the new page, so the rule has to be applied by then or the
+ * navigation falls back to a plain page load.
+ */
+@view-transition {
+  navigation: auto;
+}
+
+/* Direction-aware crossfade. The `back`/`forward` types are added by
+   src/scripts/view-transitions.js before the transition starts. */
+@keyframes vt-fade-in {
+  from { opacity: 0; }
+}
+@keyframes vt-fade-out {
+  to { opacity: 0; }
+}
+@keyframes vt-slide-from-right {
+  from { transform: translateX(1.5rem); }
+}
+@keyframes vt-slide-from-left {
+  from { transform: translateX(-1.5rem); }
+}
+
+::view-transition-old(root) {
+  animation: 150ms ease-in both vt-fade-out;
+}
+::view-transition-new(root) {
+  animation:
+    220ms ease-out both vt-fade-in,
+    220ms ease-out both vt-slide-from-right;
+}
+html:active-view-transition-type(back)::view-transition-new(root) {
+  animation:
+    220ms ease-out both vt-fade-in,
+    220ms ease-out both vt-slide-from-left;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
