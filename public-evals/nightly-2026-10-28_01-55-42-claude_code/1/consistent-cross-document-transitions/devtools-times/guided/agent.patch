+}
+/*
+  Cross-document view transitions.
+  Every page that participates must opt in; this stylesheet is loaded by the
+  shared layout, so all pages do. Render-blocking hints in Layout.astro make
+  sure the new page is styled and parsed before the transition starts.
+*/
+@view-transition {
+  navigation: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
