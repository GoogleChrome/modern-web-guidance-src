+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+
+  <!-- See index.html for a full explanation of the render-blocking sequence below. -->
+
+  <!-- 1. Critical styles (identical to the homepage so the transition matches both ways). -->
+  <style blocking="render">
+    :root {
+      --primary: #4e342e;
+      --primary-hover: #3e2723;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+      --surface: #ffffff;
+      color-scheme: light;
+    }
+
+    :root[data-theme="dark"] {
+      --primary: #3e2723;
+      --primary-hover: #4e342e;
+      --secondary: #241816;
+      --accent: #ffab40;
+      --text: #efebe9;
+      --light: #1b1210;
+      --surface: #2a1e1b;
+      color-scheme: dark;
+    }
+
+    @view-transition {
+      navigation: auto;
+    }
+
+    nav {
+      view-transition-name: site-nav;
+    }
+
+    .hero {
+      view-transition-name: hero;
+    }
+
+    ::view-transition-old(root) {
+      animation: 220ms ease-out both vt-fade-out;
+    }
+
+    ::view-transition-new(root) {
+      animation: 260ms ease-in both vt-fade-in;
+    }
+
+    ::view-transition-group(hero) {
+      animation-duration: 320ms;
+    }
+
+    @keyframes vt-fade-out {
+      to { opacity: 0; }
+    }
+
+    @keyframes vt-fade-in {
+      from { opacity: 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    html {
+      background: var(--light);
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+  </style>
+
+  <!-- 2. Initial theme/layout script. -->
+  <script blocking="render">
+    (function () {
+      var root = document.documentElement;
+      var stored = null;
+      try { stored = localStorage.getItem('dg-theme'); } catch (e) { /* storage unavailable */ }
+      root.dataset.theme = (stored === 'dark' || stored === 'light')
+        ? stored
+        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
+      root.dataset.layout = matchMedia('(max-width: 47.99em)').matches ? 'narrow' : 'wide';
+    })();
+  </script>
+
+  <!-- 3. Shared stylesheet, explicitly render-blocking. -->
+  <link rel="stylesheet" href="/assets/site.css" blocking="render">
+
+  <!-- 4. Hero image preload. -->
+  <link rel="preload" as="image" fetchpriority="high"
+        href="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80">
+
+  <!-- 5. Wait for the hero and the locations grid; the footer is not waited on. -->
+  <link rel="expect" href="#locations" blocking="render">
+
+  <script src="/assets/site.js" defer></script>
+</head>
+
+<body>
+
+  <nav aria-label="Primary">
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/">Menu</a></li>
+      <li><a href="/locations/" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+    <button type="button" class="theme-toggle" aria-pressed="false" aria-label="Toggle dark theme">&#9681;</button>
+  </nav>
+
+  <header class="hero hero--compact hero--locations">
+    <h1>Find a Café</h1>
+    <p>Three neighbourhood roasteries, one obsession with the perfect cup.</p>
+  </header>
+
+  <main class="container">
+    <section id="locations" aria-labelledby="locations-title">
+      <p class="eyebrow">Now pouring</p>
+      <h2 id="locations-title" class="section-title">Our Locations</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown Roastery</h3>
+          <address>128 Market Street<br>Portland, OR 97209</address>
+          <p class="hours">Mon–Fri 6:30am–7pm<br>Sat–Sun 7am–6pm</p>
+          <a href="/order-online" class="btn">Order Ahead</a>
+        </div>
+        <div class="card">
+          <h3>Riverside Café</h3>
+          <address>4410 Willamette Avenue<br>Portland, OR 97214</address>
+          <p class="hours">Daily 7am–5pm</p>
+          <a href="/order-online" class="btn">Order Ahead</a>
+        </div>
+        <div class="card">
+          <h3>Hawthorne Corner</h3>
