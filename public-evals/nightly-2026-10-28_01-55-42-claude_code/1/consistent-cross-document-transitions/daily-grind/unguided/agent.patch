diff --git a/assets/site.css b/assets/site.css
new file mode 100644
index 0000000..640a7ac
--- /dev/null
+++ b/assets/site.css
@@ -0,0 +1,240 @@
+/* The Daily Grind – shared site styles.
+   Loaded with <link rel="stylesheet" blocking="render"> from every page so layout is
+   fully applied before the cross-document view transition captures the new page.
+   Design tokens, theme overrides and the @view-transition opt-in live in each page's
+   inline critical <style blocking="render"> block so they are available even earlier. */
+
+/* ---------- Navigation (shared chrome; view-transition-name: site-nav) ---------- */
+nav {
+  background: var(--primary);
+  color: #fff;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 1rem;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  color: #fff;
+  text-decoration: none;
+}
+
+nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav ul a {
+  color: #fff;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav ul a:hover,
+nav ul a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+.theme-toggle {
+  background: transparent;
+  border: 1px solid rgba(255, 255, 255, 0.5);
+  color: #fff;
+  border-radius: 999px;
+  width: 2rem;
+  height: 2rem;
+  cursor: pointer;
+  font-size: 1rem;
+  line-height: 1;
+}
+
+.theme-toggle:hover {
+  border-color: var(--accent);
+  color: var(--accent);
+}
+
+/* Narrow layout. data-layout is set by the inline init script before first paint
+   (so the transition never snapshots a half-laid-out nav) and kept in sync by site.js. */
+[data-layout="narrow"] nav {
+  flex-wrap: wrap;
+}
+
+[data-layout="narrow"] nav ul {
+  width: 100%;
+  order: 3;
+  margin-top: 0.5rem;
+}
+
+[data-layout="narrow"] nav ul li {
+  margin: 0 16px 0 0;
+}
+
+/* ---------- Hero (view-transition-name: hero; morphs between page sizes) ---------- */
+.hero {
+  min-height: 60vh;
+  background:
+    linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    var(--hero-image) center / cover no-repeat;
+  background-color: var(--primary);
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: #fff;
+  text-align: center;
+  padding: 40px 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+.hero--compact {
+  min-height: 36vh;
+}
+
+.hero--compact h1 {
+  font-size: 2.4rem;
+  margin-bottom: 0.5rem;
+}
+
+[data-layout="narrow"] .hero h1 {
+  font-size: 2.2rem;
+}
+
+/* Stock photography (Unsplash). Each page preloads its own hero image in <head>. */
+.hero--home {
+  --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+}
+
+.hero--menu {
+  --hero-image: url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80');
+}
+
+.hero--locations {
+  --hero-image: url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80');
+}
+
+/* ---------- Content ---------- */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.eyebrow {
+  text-align: center;
+  color: var(--accent);
+  text-transform: uppercase;
+  letter-spacing: 2px;
+  font-size: 0.8rem;
+  font-weight: bold;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: var(--surface);
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+:root[data-theme="dark"] .card h3 {
+  color: var(--accent);
+}
+
+.price {
+  display: block;
+  margin-top: 10px;
+  font-weight: bold;
+  color: var(--accent);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: #fff;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: var(--primary-hover);
+}
+
+/* Menu page: each drink family is its own section so the homepage cards can deep-link to it. */
+.menu-section {
+  scroll-margin-top: 90px; /* clear the sticky nav when arriving via #fragment */
+}
+
+.menu-section + .menu-section {
+  margin-top: 60px;
+}
+
+/* Locations page */
+.card address {
+  font-style: normal;
+  margin-bottom: 10px;
+}
+
+.hours {
+  font-size: 0.9rem;
+  opacity: 0.85;
+}
+
+/* ---------- Footer (deliberately NOT a render-blocking target) ---------- */
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
diff --git a/assets/site.js b/assets/site.js
new file mode 100644
index 0000000..b5a660f
--- /dev/null
+++ b/assets/site.js
@@ -0,0 +1,26 @@
+// Non-critical behaviour for The Daily Grind.
+// Loaded with `defer`, so it never delays first paint or an incoming view transition.
+// The theme/layout *initialisation* happens in the inline render-blocking script in
+// each page's <head>; this file only wires up interaction and keeps state in sync.
+(() => {
+  const root = document.documentElement;
+  const toggle = document.querySelector('.theme-toggle');
+
+  const syncToggle = () => {
+    if (toggle) toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
+  };
+  syncToggle();
+
+  toggle?.addEventListener('click', () => {
+    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
+    root.dataset.theme = next;
+    try { localStorage.setItem('dg-theme', next); } catch { /* storage unavailable */ }
+    syncToggle();
+  });
+
+  // Keep data-layout current if the viewport crosses the breakpoint after load.
+  const narrow = matchMedia('(max-width: 47.99em)');
+  narrow.addEventListener('change', () => {
+    root.dataset.layout = narrow.matches ? 'narrow' : 'wide';
+  });
+})();
