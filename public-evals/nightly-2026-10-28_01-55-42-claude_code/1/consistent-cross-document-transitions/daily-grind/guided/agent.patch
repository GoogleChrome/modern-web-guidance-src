diff --git a/css/styles.css b/css/styles.css
new file mode 100644
index 0000000..2af5f7b
--- /dev/null
+++ b/css/styles.css
@@ -0,0 +1,252 @@
+/* The Daily Grind — shared critical styles.
+   Loaded from <head> on every page, so it is render-blocking by default and
+   is guaranteed to be applied before any cross-document view transition runs. */
+
+:root {
+  color-scheme: light;
+  --primary: #4e342e;
+  --primary-dark: #3e2723;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --surface: #ffffff;
+  --shadow: rgba(0, 0, 0, 0.1);
+}
+
+:root[data-theme="dark"] {
+  color-scheme: dark;
+  --primary: #2b1a16;
+  --primary-dark: #1b100d;
+  --secondary: #3e2f2a;
+  --accent: #ffab40;
+  --text: #efe6e1;
+  --light: #171110;
+  --surface: #241a17;
+  --shadow: rgba(0, 0, 0, 0.5);
+}
+
+/* Cross-document view transitions: every page that links to another opts in. */
+@view-transition {
+  navigation: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+/* Default root cross-fade, slightly quicker than the UA default. */
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation-duration: 0.3s;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation — persists in place across pages instead of cross-fading. */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  view-transition-name: site-nav;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  color: white;
+  text-decoration: none;
+}
+
+nav ul {
+  display: flex;
+  align-items: center;
+  list-style: none;
+  flex-wrap: wrap;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover,
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+.theme-toggle {
+  background: transparent;
+  color: white;
+  border: 1px solid rgba(255, 255, 255, 0.5);
+  border-radius: 999px;
+  padding: 4px 10px;
+  font: inherit;
+  font-size: 0.85rem;
+  cursor: pointer;
+}
+
+.theme-toggle:hover {
+  border-color: var(--accent);
+  color: var(--accent);
+}
+
+/* Hero — shares one view-transition-name across pages so the homepage hero
+   morphs into the shorter page banner on Menu / Locations and back. */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), var(--hero-image);
+  background-color: var(--primary-dark);
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+  view-transition-name: hero;
+}
+
+.hero--compact {
+  height: 36vh;
+  min-height: 220px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+.hero--compact h1 {
+  font-size: 2.25rem;
+  margin-bottom: 0.5rem;
+}
+
+/* Content sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.section + .section {
+  margin-top: 48px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: var(--surface);
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px var(--shadow);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+:root[data-theme="dark"] .card h3 {
+  color: var(--accent);
+}
+
+.card .price {
+  display: block;
+  margin-top: 8px;
+  font-weight: bold;
+}
+
+.card address {
+  font-style: normal;
+  margin-bottom: 8px;
+}
+
+.card .hours {
+  font-size: 0.9rem;
+  opacity: 0.85;
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: var(--primary-dark);
+}
+
+:root[data-theme="dark"] .btn {
+  background: var(--accent);
+  color: var(--primary-dark);
+}
+
+/* Footer is below the fold on every page and is deliberately NOT part of the
+   render-blocking set, so it carries no view-transition-name. */
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
