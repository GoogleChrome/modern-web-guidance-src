diff --git a/js/theme-toggle.js b/js/theme-toggle.js
new file mode 100644
index 0000000..e5acee9
--- /dev/null
+++ b/js/theme-toggle.js
@@ -0,0 +1,26 @@
+// Non-critical: wires up the theme toggle after the page is interactive.
+// The initial theme is applied by the inline blocking="render" script in <head>,
+// so this file never needs to block rendering or a view transition.
+(() => {
+  const button = document.getElementById('theme-toggle');
+  if (!button) return;
+
+  const label = () => {
+    const dark = document.documentElement.dataset.theme === 'dark';
+    button.textContent = dark ? 'Light mode' : 'Dark mode';
+    button.setAttribute('aria-pressed', String(dark));
+  };
+
+  button.addEventListener('click', () => {
+    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
+    document.documentElement.dataset.theme = next;
+    try {
+      localStorage.setItem('theme', next);
+    } catch {
+      /* storage unavailable (private mode, blocked) — theme still applies for this page */
+    }
+    label();
+  });
+
+  label();
+})();
