+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+
+  <!-- Banner image participates in the "hero" morph; preload so the snapshot is not blank. -->
+  <link rel="preload" as="image" fetchpriority="high"
+    href="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80">
+
+  <!-- Critical styles (render-blocking by default from <head>). -->
+  <link rel="stylesheet" href="/css/styles.css">
+
+  <!-- Initial theme script: must run before the incoming transition snapshot. -->
+  <script type="module" blocking="render">
+    let theme = null;
+    try { theme = localStorage.getItem('theme'); } catch {}
+    if (theme !== 'light' && theme !== 'dark') {
+      theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+    }
+    document.documentElement.dataset.theme = theme;
+  </script>
+
+  <!-- Wait for nav + banner + the locations grid. The footer is not blocked on. -->
+  <link rel="expect" href="#our-cafes" blocking="render">
+
+  <script type="speculationrules">
+    { "prerender": [ { "urls": ["/", "/menu/"], "eagerness": "moderate" } ] }
+  </script>
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/">Menu</a></li>
+      <li><a href="/locations/" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+      <li><button type="button" class="theme-toggle" id="theme-toggle">Dark mode</button></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--compact"
+    style="--hero-image: url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80')">
+    <h1>Find a Café</h1>
+    <p>Three neighbourhood cafés, one obsession with great coffee.</p>
+  </header>
+
+  <main class="container">
+    <section class="section" id="our-cafes" aria-labelledby="cafes-heading">
+      <h2 class="section-title" id="cafes-heading">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown Roastery</h3>
+          <address>112 Market Street<br>Portland, OR 97209</address>
+          <p class="hours">Mon–Fri 6:30am–7pm · Sat–Sun 7am–6pm</p>
+          <a href="/order-online" class="btn">Order Ahead</a>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <address>48 Waterfront Avenue<br>Portland, OR 97204</address>
+          <p class="hours">Daily 7am–6pm</p>
+          <a href="/order-online" class="btn">Order Ahead</a>
+        </div>
+        <div class="card">
+          <h3>Hawthorne Corner</h3>
+          <address>3310 SE Hawthorne Blvd<br>Portland, OR 97214</address>
+          <p class="hours">Mon–Sat 6:30am–8pm · Sun 7am–6pm</p>
+          <a href="/order-online" class="btn">Order Ahead</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script src="/js/theme-toggle.js" defer></script>
+</body>
+
+</html>
