+    /*
+      Theming
+      -------
+      Every themed colour is a token defined ONCE with light-dark(light, dark).
+      Which side wins is decided purely by the `color-scheme` property:
+        - default: `light dark` -> follows the OS prefers-color-scheme setting
+        - <html data-theme="dark"> or <html class="dark">  -> forces dark
+        - <html data-theme="light"> or <html class="light"> -> forces light
+      Component rules (nav, hero, cards) only reference tokens, so no rule is
+      written twice for the two themes.
+    */
     :root {
-      --primary: #4e342e;
-      --secondary: #d7ccc8;
-      --accent: #ffab40;
-      --text: #3e2723;
-      --light: #fafafa;
+      color-scheme: light dark;
+
+      /* Page */
+      --page-bg: light-dark(#fafafa, #171110);
+      --text: light-dark(#3e2723, #e8ddd7);
+
+      /* Navigation bar */
+      --nav-bg: light-dark(#4e342e, #1b1311);
+      --nav-text: light-dark(#ffffff, #f3ebe6);
+      --nav-link-hover: light-dark(#ffab40, #ffc46b);
+      --nav-border: light-dark(transparent, #3a2b26);
+      --nav-shadow: light-dark(rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.6));
+
+      /* Hero banner */
+      --hero-overlay: light-dark(rgba(0, 0, 0, 0.5), rgba(10, 6, 4, 0.7));
+      --hero-text: #ffffff;
+      --hero-text-shadow: light-dark(0 1px 3px rgba(0, 0, 0, 0.4), 0 1px 4px rgba(0, 0, 0, 0.8));
+
+      /* Seasonal Favorites cards */
+      --card-bg: light-dark(#ffffff, #241a16);
+      --card-text: light-dark(#3e2723, #e8ddd7);
+      --card-title: light-dark(#4e342e, #ffcc80);
+      --card-border: light-dark(transparent, #3d2e28);
+      --card-shadow: light-dark(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.5));
+
+      /* Buttons (used in hero + cards) */
+      --btn-bg: light-dark(#4e342e, #ffab40);
+      --btn-text: light-dark(#ffffff, #2a1a14);
+      --btn-bg-hover: light-dark(#3e2723, #ffc46b);
+
+      /* Footer */
+      --footer-bg: light-dark(#d7ccc8, #1f1613);
+      --footer-text: light-dark(#3e2723, #cdbfb8);
+    }
+
+    /* Explicit overrides via root attribute or class win over the OS preference. */
+    :root[data-theme="light"],
+    :root.light {
+      color-scheme: light;
+    }
+
+    :root[data-theme="dark"],
+    :root.dark {
+      color-scheme: dark;
     }
 
