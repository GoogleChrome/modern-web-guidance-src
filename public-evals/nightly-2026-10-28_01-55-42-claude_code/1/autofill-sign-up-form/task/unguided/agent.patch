+  <script>
+    (function () {
+      var form = document.getElementById('signup-form');
+      var message = document.getElementById('signup-message');
+
+      function showMessage(text, type) {
+        message.textContent = text;
+        message.className = 'form-message ' + type;
+      }
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        var name = form.name.value.trim();
+        var email = form.email.value.trim();
+        var password = form.password.value;
+        var confirm = form.confirm_password.value;
+
+        if (!name) {
+          showMessage('Please enter your full name.', 'error');
+          form.name.focus();
+          return;
+        }
+        if (!form.email.checkValidity() || !email) {
+          showMessage('Please enter a valid email address.', 'error');
+          form.email.focus();
+          return;
+        }
+        if (password.length < 8) {
+          showMessage('Your password must be at least 8 characters long.', 'error');
+          form.password.focus();
+          return;
+        }
+        if (password !== confirm) {
+          showMessage('Passwords do not match.', 'error');
+          form.confirm_password.focus();
+          return;
+        }
+
+        showMessage('Welcome to The Daily Grind, ' + name + '! Your account is ready.', 'success');
+        form.reset();
+      });
+    })();
+  </script>
+
