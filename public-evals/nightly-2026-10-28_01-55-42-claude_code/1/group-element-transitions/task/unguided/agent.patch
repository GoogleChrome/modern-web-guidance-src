+  <script>
+    (function () {
+      var shelf = document.getElementById('bean-shelf');
+      var box = document.getElementById('bean-box');
+      var empty = document.getElementById('bean-box-empty');
+      var count = document.getElementById('bean-box-count');
+      var total = document.getElementById('bean-box-total');
+      var checkout = document.getElementById('bean-checkout');
+      var status = document.getElementById('bean-status');
+      var builder = document.getElementById('bean-builder');
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function beanName(card) {
+        return card.querySelector('h4').textContent;
+      }
+
+      // Returning a bean to the shelf puts it back in its original slot.
+      function insertByOrder(card) {
+        var order = Number(card.dataset.order);
+        var siblings = shelf.querySelectorAll('.bean-card');
+        for (var i = 0; i < siblings.length; i++) {
+          if (Number(siblings[i].dataset.order) > order) {
+            shelf.insertBefore(card, siblings[i]);
+            return;
+          }
+        }
+        shelf.appendChild(card);
+      }
+
+      function syncState() {
+        var selected = box.querySelectorAll('.bean-card');
+        var sum = 0;
+        selected.forEach(function (card) { sum += Number(card.dataset.price); });
+
+        count.textContent = selected.length;
+        count.setAttribute('aria-label', selected.length + (selected.length === 1 ? ' item' : ' items'));
+        total.textContent = '$' + sum;
+        empty.hidden = selected.length > 0;
+        checkout.setAttribute('aria-disabled', selected.length ? 'false' : 'true');
+
+        builder.querySelectorAll('.bean-card').forEach(function (card) {
+          var inBox = card.parentElement === box;
+          var btn = card.querySelector('.bean-toggle');
+          btn.textContent = inBox ? 'Remove' : 'Add';
+          btn.setAttribute('aria-label', (inBox ? 'Remove ' : 'Add ') + beanName(card) + (inBox ? ' from your box' : ' to your box'));
+        });
+      }
+
+      function moveBean(card) {
+        var toBox = card.parentElement !== box;
+        var update = function () {
+          if (toBox) {
+            box.appendChild(card);
+          } else {
+            insertByOrder(card);
+          }
+          syncState();
+          status.textContent = beanName(card) + (toBox ? ' added to your box.' : ' removed from your box.');
+        };
+
+        // One shared transition: every .bean-card captured before and after the
+        // DOM change is animated to its new position by the same CSS rules.
+        if (!document.startViewTransition || reduceMotion.matches) {
+          update();
+          return;
+        }
+        var transition = document.startViewTransition(update);
+        transition.finished.then(function () {
+          // Keep keyboard focus on the button the user activated.
+          var btn = card.querySelector('.bean-toggle');
+          if (btn && document.activeElement === document.body) btn.focus();
+        });
+      }
+
+      builder.addEventListener('click', function (event) {
+        var btn = event.target.closest('.bean-toggle');
+        if (!btn) return;
+        var card = btn.closest('.bean-card');
+        if (card) moveBean(card);
+      });
+
+      syncState();
+    })();
+  </script>
+
 </body>
 
