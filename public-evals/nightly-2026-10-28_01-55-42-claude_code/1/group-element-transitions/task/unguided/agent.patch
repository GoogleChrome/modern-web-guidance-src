+
+    /* View transition choreography.
+       Rules keyed on the shared `.bean` class apply to every bean card at
+       once, so adding or removing one item slides the whole group into
+       its new positions in a single, consistent animation. */
+    ::view-transition-group(.bean) {
+      animation-duration: 450ms;
+      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
+    }
+
+    ::view-transition-old(.bean),
+    ::view-transition-new(.bean) {
+      height: 100%;
+      object-fit: cover;
+      overflow: clip;
+      animation-duration: 450ms;
+    }
+
+    ::view-transition-group(bean-box-empty) {
+      animation-duration: 300ms;
+    }
+
+    /* Keep the rest of the page still while the cards move. */
+    ::view-transition-old(root),
+    ::view-transition-new(root) {
+      animation: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
