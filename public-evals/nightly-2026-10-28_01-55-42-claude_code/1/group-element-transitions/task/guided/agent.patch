+  <script>
+    (() => {
+      const catalog = document.getElementById('bean-catalog');
+      const selection = document.getElementById('bean-selection');
+      const countEl = document.getElementById('bean-count');
+      const totalEl = document.getElementById('bean-total');
+      const statusEl = document.getElementById('bean-status');
+
+      const beanName = (bean) => bean.querySelector('strong').textContent;
+      const beanPrice = (bean) => Number(bean.querySelector('.price').textContent.match(/\d+/)[0]);
+
+      function moveBean(bean, target) {
+        // moveBefore keeps the button's focus/state; append is the fallback
+        if (typeof target.moveBefore === 'function') {
+          target.moveBefore(bean, null);
+        } else {
+          target.append(bean);
+        }
+      }
+
+      function updateBean(bean, isSelected) {
+        const button = bean.querySelector('[data-bean-toggle]');
+        const name = beanName(bean);
+        button.textContent = isSelected ? 'Remove' : 'Add to Box';
+        button.setAttribute('aria-label', isSelected ? `Remove ${name} from your box` : `Add ${name} to your box`);
+      }
+
+      function updateSummary() {
+        const beans = selection.querySelectorAll('.bean');
+        const total = [...beans].reduce((sum, bean) => sum + beanPrice(bean), 0);
+        countEl.textContent = `${beans.length} ${beans.length === 1 ? 'bean' : 'beans'}`;
+        totalEl.textContent = `$${total}`;
+      }
+
+      function toggleBean(bean) {
+        const isSelected = bean.parentElement === selection;
+        const target = isSelected ? catalog : selection;
+        const button = bean.querySelector('[data-bean-toggle]');
+
+        const updateDOM = () => {
+          moveBean(bean, target);
+          updateBean(bean, !isSelected);
+          updateSummary();
+          button.focus({ preventScroll: true });
+        };
+
+        const name = beanName(bean);
+        statusEl.textContent = isSelected ? `${name} removed from your box.` : `${name} added to your box.`;
+
+        // Progressive enhancement: update instantly where view transitions are unsupported
+        if (!document.startViewTransition) {
+          updateDOM();
+          return;
+        }
+        document.startViewTransition(updateDOM);
+      }
+
+      document.querySelector('.bean-box').addEventListener('click', (event) => {
+        const button = event.target.closest('[data-bean-toggle]');
+        if (!button) return;
+        toggleBean(button.closest('.bean'));
+      });
+    })();
+  </script>
