+  <script>
+    (function () {
+      'use strict';
+
+      // ---- Task definitions ------------------------------------------------
+      // Lower rank runs first. `work` is total simulated CPU time in ms.
+      var PRIORITIES = {
+        urgent:     { rank: 1, label: 'Urgent',     work: 400,  names: ['Checkout #', 'Payment auth #', 'Receipt #'] },
+        standard:   { rank: 2, label: 'Standard',   work: 900,  names: ['Menu price sync', 'Seasonal menu publish', 'Inventory refresh'] },
+        background: { rank: 3, label: 'Background', work: 1600, names: ['Telemetry flush', 'Analytics rollup', 'Log compaction'] }
+      };
+
+      var SLICE_BUDGET_MS = 6; // max synchronous work per slice before yielding
+
+      // ---- DOM references --------------------------------------------------
+      var $ = function (sel) { return document.querySelector(sel); };
+      var lanes = {
+        urgent: $('[data-lane="urgent"]'),
+        standard: $('[data-lane="standard"]'),
+        background: $('[data-lane="background"]')
+      };
+      var stateEl = $('#ops-state');
+      var pulseEl = $('#ops-pulse');
+      var lagEl = $('#ops-lag');
+      var countsEl = $('#ops-counts');
+      var yieldsEl = $('#ops-yields');
+      var logEl = $('#ops-log');
+
+      // ---- Scheduler state -------------------------------------------------
+      var queues = { urgent: [], standard: [], background: [] };
+      var nextId = 1;
+      var running = false;
+      var current = null;
+      var doneCount = 0;
+      var yieldCount = 0;
+
+      function log(msg, cls) {
+        var line = document.createElement('div');
+        var t = new Date();
+        var stamp = t.toLocaleTimeString([], { hour12: false }) + '.' + String(t.getMilliseconds()).padStart(3, '0');
+        line.textContent = '[' + stamp + '] ' + msg;
+        if (cls) line.className = 'log-' + cls;
+        logEl.appendChild(line);
+        while (logEl.childElementCount > 200) logEl.removeChild(logEl.firstChild);
+        logEl.scrollTop = logEl.scrollHeight;
+      }
+
+      // Yield control back to the event loop so input, rendering and other
+      // tasks can run. Prefer the native Prioritized Task Scheduling API.
+      function yieldToMain() {
+        yieldCount++;
+        yieldsEl.textContent = yieldCount;
+        if (window.scheduler && typeof window.scheduler.yield === 'function') {
+          return window.scheduler.yield();
+        }
+        return new Promise(function (resolve) {
+          var ch = new MessageChannel();
+          ch.port1.onmessage = function () { resolve(); };
+          ch.port2.postMessage(null);
+        });
+      }
+
+      // Burn CPU for roughly `ms` milliseconds (simulated synchronous work).
+      function busyWork(ms) {
+        var end = performance.now() + ms;
+        var x = 0;
+        while (performance.now() < end) {
+          x = (x * 1103515245 + 12345) & 0x7fffffff;
+        }
+        return x;
+      }
+
+      function pendingCount() {
+        return queues.urgent.length + queues.standard.length + queues.background.length;
+      }
+
+      function updateCounts() {
+        countsEl.textContent = (pendingCount() + (current ? 1 : 0)) + ' / ' + doneCount;
+      }
+
+      function pickNext() {
+        if (queues.urgent.length) return queues.urgent.shift();
+        if (queues.standard.length) return queues.standard.shift();
+        if (queues.background.length) return queues.background.shift();
+        return null;
+      }
+
+      function hasHigherPriorityWaiting(task) {
+        var r = PRIORITIES[task.priority].rank;
+        return (r > 1 && queues.urgent.length > 0) || (r > 2 && queues.standard.length > 0);
+      }
+
+      // ---- Task rendering --------------------------------------------------
+      function renderTask(task) {
+        var li = document.createElement('li');
+        li.className = 'ops-task';
+        li.innerHTML =
+          '<div class="ops-task-row"><span class="ops-task-name"></span><span class="ops-task-state">queued</span></div>' +
+          '<div class="ops-progress"><div class="ops-progress-bar"></div></div>';
+        li.querySelector('.ops-task-name').textContent = task.name;
+        task.el = li;
+        task.stateEl = li.querySelector('.ops-task-state');
+        task.barEl = li.querySelector('.ops-progress-bar');
+        var lane = lanes[task.priority];
+        var empty = lane.querySelector('.ops-lane-empty');
+        if (empty) empty.remove();
+        lane.appendChild(li);
+      }
+
+      function setTaskState(task, state) {
+        task.state = state;
+        task.el.classList.toggle('is-running', state === 'running');
+        task.el.classList.toggle('is-done', state === 'done');
+        task.stateEl.textContent = state;
+      }
+
+      function renderEmptyLanes() {
+        Object.keys(lanes).forEach(function (key) {
+          var lane = lanes[key];
+          if (!lane.querySelector('.ops-task') && !lane.querySelector('.ops-lane-empty')) {
+            var p = document.createElement('li');
+            p.className = 'ops-lane-empty';
+            p.textContent = 'No tasks';
+            lane.appendChild(p);
+          }
+        });
+      }
+
+      // ---- Enqueue / run ---------------------------------------------------
+      function enqueue(priority, nameOverride) {
+        var def = PRIORITIES[priority];
+        var base = def.names[Math.floor(Math.random() * def.names.length)];
+        var name = nameOverride || (base.slice(-1) === '#' ? base + (1000 + nextId) : base);
+        var task = {
+          id: nextId++,
+          priority: priority,
+          name: name,
+          work: def.work,
+          done: 0,
+          state: 'queued'
+        };
+        queues[priority].push(task);
+        renderTask(task);
+        log('Queued ' + def.label.toLowerCase() + ' task: ' + name + ' (' + def.work + 'ms of work)', priority);
+        updateCounts();
+        schedule();
+        return task;
+      }
+
+      function schedule() {
+        if (running) return;
+        running = true;
+        stateEl.firstChild.textContent = 'Running';
+        runLoop().then(function () {
+          running = false;
+          current = null;
+          stateEl.firstChild.textContent = 'Idle';
+          updateCounts();
+          log('Queue drained. UI stayed interactive throughout.', 'system');
+        });
+      }
+
+      async function runLoop() {
+        var task;
+        while ((task = pickNext())) {
+          current = task;
+          if (task.state !== 'paused') {
+            log('Started ' + task.name, task.priority);
+          } else {
+            log('Resumed ' + task.name, task.priority);
+          }
+          setTaskState(task, 'running');
+          updateCounts();
+
+          while (task.done < task.work) {
+            var slice = Math.min(SLICE_BUDGET_MS, task.work - task.done);
+            busyWork(slice);
+            task.done += slice;
+            task.barEl.style.width = Math.round((task.done / task.work) * 100) + '%';
+
+            await yieldToMain();
+
+            // Preemption: if something more important arrived while we were
+            // working, put this task back at the front of its lane and switch.
+            if (task.done < task.work && hasHigherPriorityWaiting(task)) {
+              queues[task.priority].unshift(task);
+              setTaskState(task, 'paused');
+              log('Paused ' + task.name + ' at ' + Math.round((task.done / task.work) * 100) + '% for higher-priority work', task.priority);
+              current = null;
+              task = null;
+              break;
+            }
+          }
+
+          if (task) {
+            setTaskState(task, 'done');
+            doneCount++;
+            current = null;
+            log('Finished ' + task.name, task.priority);
+            updateCounts();
+          }
+        }
+      }
+
+      // ---- Batch -----------------------------------------------------------
+      function runBatch() {
+        // Deliberately interleaved submission order: the scheduler reorders by priority.
+        var mix = [
+          ['background', 'Telemetry flush'],
+          ['standard', 'Seasonal menu publish'],
+          ['background', 'Analytics rollup'],
+          ['urgent', 'Checkout #' + (1000 + nextId)],
+          ['standard', 'Inventory refresh'],
+          ['urgent', 'Payment auth #' + (1001 + nextId)]
+        ];
+        log('Batch submitted in order: ' + mix.map(function (m) { return m[0]; }).join(' > ') + '. Executing by priority.', 'system');
+        mix.forEach(function (m) { enqueue(m[0], m[1]); });
+      }
+
+      function clearCompleted() {
+        var removed = 0;
+        document.querySelectorAll('.ops-task.is-done').forEach(function (el) { el.remove(); removed++; });
+        renderEmptyLanes();
+        if (removed) log('Cleared ' + removed + ' completed task' + (removed === 1 ? '' : 's') + '.', 'system');
+      }
+
+      // ---- Responsiveness monitor -----------------------------------------
+      // A ticking interval measures how late the main thread wakes up. A
+      // blocked thread shows large lag; the sliced scheduler keeps it small.
+      var TICK_MS = 50;
+      var expected = performance.now() + TICK_MS;
+      var worstLag = 0;
+      var lastReport = performance.now();
+      setInterval(function () {
+        var now = performance.now();
+        var lag = Math.max(0, now - expected);
+        expected = now + TICK_MS;
+        if (lag > worstLag) worstLag = lag;
+        if (now - lastReport >= 500) {
+          var v = Math.round(worstLag);
+          lagEl.textContent = v + ' ms';
+          lagEl.className = 'ops-stat-value ' + (v < 20 ? 'is-good' : v < 60 ? 'is-warn' : 'is-bad');
+          worstLag = 0;
+          lastReport = now;
+        }
+      }, TICK_MS);
+
+      // JS-driven pulse: if the main thread were blocked, this would freeze.
+      var phase = 0;
+      (function pulse() {
+        phase += 0.08;
+        var s = 0.8 + 0.3 * Math.abs(Math.sin(phase));
+        pulseEl.style.transform = 'scale(' + s.toFixed(3) + ')';
+        requestAnimationFrame(pulse);
+      })();
+
+      // ---- Wire up ---------------------------------------------------------
+      document.querySelectorAll('[data-enqueue]').forEach(function (btn) {
+        btn.addEventListener('click', function () { enqueue(btn.getAttribute('data-enqueue')); });
+      });
+      $('#ops-batch').addEventListener('click', runBatch);
+      $('#ops-clear').addEventListener('click', clearCompleted);
+
+      renderEmptyLanes();
+      log('Scheduler ready. Slice budget ' + SLICE_BUDGET_MS + 'ms; yielding via ' +
+        (window.scheduler && window.scheduler.yield ? 'scheduler.yield()' : 'MessageChannel') + '.', 'system');
+    })();
+  </script>
+
 </body>
 
