+  <script>
+    (() => {
+      'use strict';
+
+      // ---------- Task catalog ----------
+      // `units` is the number of work slices; each slice burns ~3 ms of CPU.
+      const TASK_TYPES = {
+        checkout: {
+          label: 'Urgent checkout',
+          priority: 'user-blocking',
+          units: 20,
+          detail: 'Authorize card, reserve stock, print receipt'
+        },
+        menu: {
+          label: 'Menu update',
+          priority: 'user-visible',
+          units: 40,
+          detail: 'Re-render seasonal board and price cards'
+        },
+        telemetry: {
+          label: 'Telemetry logging',
+          priority: 'background',
+          units: 80,
+          detail: 'Aggregate POS metrics and flush to analytics'
+        }
+      };
+
+      const SLICE_MS = 3;      // CPU time burned per unit of simulated work
+      const YIELD_BUDGET = 50; // 50 ms is the long-task threshold
+
+      const PRIORITY_CLASS = {
+        'user-blocking': 'p-ub',
+        'user-visible': 'p-uv',
+        'background': 'p-bg'
+      };
+
+      // ---------- DOM ----------
+      const $ = (id) => document.getElementById(id);
+      const listEl = $('ops-list');
+      const logEl = $('ops-log');
+      const statusEl = $('ops-status');
+      const fpsEl = $('ops-fps');
+      const gapEl = $('ops-gap');
+      const tapsEl = $('ops-taps');
+      const yieldToggle = $('ops-yield');
+      const engineEl = $('ops-engine');
+
+      const t0 = performance.now();
+      const stamp = () => ((performance.now() - t0) / 1000).toFixed(3).padStart(7, ' ');
+
+      function log(message, priority) {
+        const p = document.createElement('p');
+        const time = document.createElement('span');
+        time.className = 't';
+        time.textContent = `[${stamp()}s] `;
+        p.append(time);
+        if (priority) {
+          const tag = document.createElement('span');
+          tag.className = PRIORITY_CLASS[priority];
+          tag.textContent = `${priority.padEnd(13, ' ')} `;
+          p.append(tag);
+        }
+        p.append(document.createTextNode(message));
+        logEl.append(p);
+        logEl.scrollTop = logEl.scrollHeight;
+      }
+
+      // ---------- Responsiveness monitor ----------
+      // A requestAnimationFrame loop measures real frame gaps. If the main
+      // thread is blocked, the gap grows and the fps readout drops.
+      let frames = 0;
+      let lastFrame = performance.now();
+      let lastReport = lastFrame;
+      let worstGap = 0;
+
+      function monitor(now) {
+        frames++;
+        worstGap = Math.max(worstGap, now - lastFrame);
+        lastFrame = now;
+        if (now - lastReport >= 1000) {
+          const fps = Math.round((frames * 1000) / (now - lastReport));
+          fpsEl.textContent = `${fps} fps`;
+          gapEl.textContent = `${Math.round(worstGap)} ms`;
+          gapEl.style.color = worstGap > 100 ? '#b71c1c' : '';
+          frames = 0;
+          worstGap = 0;
+          lastReport = now;
+        }
+        requestAnimationFrame(monitor);
+      }
+      requestAnimationFrame(monitor);
+
+      let taps = 0;
+      $('ops-tap').addEventListener('click', () => {
+        taps++;
+        tapsEl.textContent = String(taps);
+      });
+
+      // ---------- Scheduler access ----------
+      // Prefer the native Prioritized Task Scheduling API. If it is missing,
+      // load the official polyfill. If that cannot load (offline), fall back to
+      // a tiny in-page priority queue so the simulator still works.
+      let schedulerImpl = null;
+      let engineName = '';
+
+      function makeFallbackScheduler() {
+        const order = ['user-blocking', 'user-visible', 'background'];
+        const queues = { 'user-blocking': [], 'user-visible': [], 'background': [] };
+        let draining = false;
+
+        function drain() {
+          draining = false;
+          for (const p of order) {
+            const next = queues[p].shift();
+            if (next) {
+              next();
+              schedule();
+              return;
+            }
+          }
+        }
+        function schedule() {
+          if (!draining) {
+            draining = true;
+            setTimeout(drain, 0);
+          }
+        }
+        return {
+          postTask(callback, { priority = 'user-visible' } = {}) {
+            return new Promise((resolve, reject) => {
+              queues[priority].push(() => {
+                try {
+                  resolve(callback());
+                } catch (err) {
+                  reject(err);
+                }
+              });
+              schedule();
+            });
+          },
+          yield() {
+            return new Promise((resolve) => setTimeout(resolve, 0));
+          }
+        };
+      }
+
+      function hasNativeScheduler() {
+        return 'scheduler' in window && typeof window.scheduler.postTask === 'function';
+      }
+
+      const schedulerReady = new Promise((resolve) => {
+        if (hasNativeScheduler()) {
+          schedulerImpl = window.scheduler;
+          engineName = 'native scheduler.postTask';
+          resolve();
+          return;
+        }
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = () => {
+          schedulerImpl = window.scheduler;
+          engineName = 'scheduler-polyfill';
+          resolve();
+        };
+        script.onerror = () => {
+          schedulerImpl = makeFallbackScheduler();
+          engineName = 'in-page fallback queue (setTimeout)';
+          resolve();
+        };
+        document.head.appendChild(script);
+      });
+
+      schedulerReady.then(() => {
+        engineEl.textContent = engineName;
+        log(`Scheduler ready: ${engineName}`);
+        if (typeof schedulerImpl.yield !== 'function') {
+          log('scheduler.yield() unavailable; continuations use setTimeout(0).');
+        }
+      });
+
+      async function yieldToMain() {
+        if (typeof schedulerImpl.yield === 'function') {
+          // Native yield() continuations inherit the posting task's priority,
+          // so a yielding background task still lets urgent work jump ahead.
+          await schedulerImpl.yield();
+        } else {
+          await new Promise((resolve) => setTimeout(resolve, 0));
+        }
+      }
+
+      // ---------- Queue state ----------
+      let nextId = 1;
+      const tasks = new Map();
+
+      function burnCpu(ms) {
+        const end = performance.now() + ms;
+        let x = 0;
+        while (performance.now() < end) {
+          x = (x * 1664525 + 1013904223) % 4294967296;
+        }
+        return x;
+      }
+
+      function updateStatus() {
+        let queued = 0, running = 0, done = 0;
+        for (const t of tasks.values()) {
+          if (t.state === 'queued') queued++;
+          else if (t.state === 'running') running++;
+          else done++;
+        }
+        statusEl.textContent = tasks.size === 0
+          ? 'Queue idle.'
+          : `${queued} queued · ${running} running · ${done} finished`;
+      }
+
+      function renderTask(task) {
+        const li = document.createElement('li');
+        li.className = 'ops-task';
+        li.dataset.priority = task.priority;
+        li.dataset.id = task.id;
+
+        const badge = document.createElement('span');
+        badge.className = 'ops-badge';
+        badge.textContent = task.priority;
+
+        const name = document.createElement('span');
+        name.className = 'ops-task-name';
+        name.textContent = `#${task.id} ${task.label}`;
+
+        const state = document.createElement('span');
+        state.className = 'ops-task-state';
+        state.textContent = 'queued';
+
+        const bar = document.createElement('progress');
+        bar.max = task.units;
+        bar.value = 0;
+        bar.setAttribute('aria-label', `${task.label} progress`);
+
+        li.append(badge, name, state, bar);
+        listEl.append(li);
+        task.el = { li, state, bar };
+      }
+
+      function setState(task, state, text) {
+        task.state = state;
+        task.el.li.classList.remove('queued', 'running', 'done');
+        task.el.li.classList.add(state);
+        task.el.state.textContent = text;
+        updateStatus();
+      }
+
+      async function runTask(task) {
+        task.startedAt = performance.now();
+        const waited = task.startedAt - task.queuedAt;
+        setState(task, 'running', `running · waited ${Math.round(waited)} ms`);
+        log(`▶ #${task.id} ${task.label} started (waited ${Math.round(waited)} ms)`, task.priority);
+
+        let deadline = performance.now() + YIELD_BUDGET;
+        let yields = 0;
+
+        for (let i = 1; i <= task.units; i++) {
+          burnCpu(SLICE_MS);
+          task.el.bar.value = i;
+
+          if (yieldToggle.checked && performance.now() >= deadline) {
+            yields++;
+            await yieldToMain();
+            deadline = performance.now() + YIELD_BUDGET;
+          }
+        }
+
+        const elapsed = performance.now() - task.startedAt;
+        setState(task, 'done', `done in ${Math.round(elapsed)} ms · ${yields} yields`);
+        log(`✔ #${task.id} ${task.label} finished in ${Math.round(elapsed)} ms after ${yields} yield(s)`, task.priority);
+      }
+
+      function enqueue(kind) {
+        const type = TASK_TYPES[kind];
+        const task = {
+          id: nextId++,
+          kind,
+          label: type.label,
+          priority: type.priority,
+          units: type.units,
+          state: 'queued',
+          queuedAt: performance.now()
+        };
+        tasks.set(task.id, task);
+        renderTask(task);
+        updateStatus();
+        log(`+ #${task.id} ${task.label} queued — ${type.detail}`, task.priority);
+
+        schedulerReady
+          .then(() => schedulerImpl.postTask(() => runTask(task), { priority: task.priority }))
+          .catch((err) => {
+            setState(task, 'done', 'failed');
+            log(`✖ #${task.id} ${task.label} failed: ${err && err.message ? err.message : err}`, task.priority);
+          });
+        return task;
+      }
+
+      // ---------- Controls ----------
+      document.querySelectorAll('.ops-btn[data-kind]').forEach((btn) => {
+        btn.addEventListener('click', () => enqueue(btn.dataset.kind));
+      });
+
+      $('ops-batch').addEventListener('click', () => {
+        // Deliberately submitted in the "wrong" order. The scheduler starts
+        // them by priority: checkouts first, then menu updates, then telemetry.
+        const mixed = ['telemetry', 'menu', 'checkout', 'telemetry', 'checkout', 'menu'];
+        log(`Batch submitted in order: ${mixed.map((k) => TASK_TYPES[k].label).join(' → ')}`);
+        mixed.forEach(enqueue);
+      });
+
+      $('ops-clear').addEventListener('click', () => {
+        for (const [id, task] of tasks) {
+          if (task.state === 'done') {
+            task.el.li.remove();
+            tasks.delete(id);
+          }
+        }
+        updateStatus();
+      });
+    })();
+  </script>
+
