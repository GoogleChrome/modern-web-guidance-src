+      -webkit-mask-repeat: var(--ink-mask-repeat);
+      mask-repeat: var(--ink-mask-repeat);
+      -webkit-mask-position: left center;
+      mask-position: left center;
+      /* Hidden until revealed: clipped away from the far end. */
+      clip-path: inset(0 100% 0 0);
+      transition:
+        clip-path var(--ink-duration) var(--ink-ease) var(--ink-delay),
+        transform var(--ink-duration) var(--ink-ease) var(--ink-delay),
+        background-color 0.3s ease,
