+      --ink-mask-size: 100% 100%;
+      --ink-mask-repeat: no-repeat;
+      --ink-duration: 0.5s;
+      --ink-delay: 0s;
+      --ink-ease: cubic-bezier(0.65, 0, 0.35, 1);
+      --ink-origin: left;
+
+      position: relative;
+      isolation: isolate;
+      text-decoration: none;
+      /* Ink skipping: tight horizontal shadows in the background colour lift
+         the line away from any glyph it crosses. */
+      text-shadow:
+        0.035em 0 var(--ink-skip), -0.035em 0 var(--ink-skip),
+        0.07em 0 var(--ink-skip), -0.07em 0 var(--ink-skip),
+        0.105em 0 var(--ink-skip), -0.105em 0 var(--ink-skip);
+    }
+
+    .ink::after {
+      content: "";
+      position: absolute;
+      z-index: -1;
+      left: var(--ink-inset-start);
+      right: var(--ink-inset-end);
+      height: var(--ink-thickness);
+      background-color: var(--ink-color);
+      border-radius: calc(var(--ink-thickness) / 2);
+      pointer-events: none;
+      -webkit-mask-image: var(--ink-mask);
+      mask-image: var(--ink-mask);
+      -webkit-mask-size: var(--ink-mask-size);
