+    /* Sticky section headers
+       ----------------------------------------------------------------
+       `.sticky-container` is the sticky element and a *named* scroll-state
+       container ("section-header"). The `.sticky-header` inside it is
+       restyled via `@container section-header scroll-state(stuck: top)`.
+       Naming the container means the query is never resolved against any
+       other scroll-state container (such as the site <nav>), and the
+       viewport/document is the scroll root the "stuck" state is measured
+       against. */
+    .sticky-container {
+      position: sticky;
+      /* Pin just below the site navigation so the two never overlap. */
+      top: var(--nav-height);
+      z-index: 10; /* Below nav (1000) so the nav always stays on top. */
+      container-type: scroll-state;
+      container-name: section-header;
+    }
+
+    .sticky-header {
+      margin: 0;
+      padding: 1rem 1.25rem;
+      background: var(--light);
+      color: var(--primary);
+      font-size: 1.75rem;
+      line-height: 1.3;
+      text-align: center;
+      border-radius: 8px;
+      box-shadow: none;
+      transition:
+        background-color 0.25s ease,
+        color 0.25s ease,
+        padding 0.25s ease,
+        box-shadow 0.25s ease,
+        font-size 0.25s ease;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: var(--stuck-blue);
+        color: white;
+        padding: 0.4rem 1.25rem;
+        font-size: 1.25rem;
+        border-radius: 0 0 8px 8px;
+        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
+      }
+    }
+
     footer {
