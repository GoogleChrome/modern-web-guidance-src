+  <script>
+    // Fallback for browsers without CSS scroll-state queries: toggle .is-stuck
+    // via IntersectionObserver. The document/viewport is the scroll root.
+    (function () {
+      if (CSS.supports('container-type: scroll-state')) return;
+
+      document.querySelectorAll('.sticky-container').forEach(function (container) {
+        var topOffset = parseFloat(getComputedStyle(container).top) || 0;
+
+        var observer = new IntersectionObserver(function (entries) {
+          var entry = entries[0];
+          // Stuck when the element is clipped by the shrunken root at its top edge,
+          // i.e. it is pinned at (or pushed above) its sticky offset.
+          var stuck = entry.intersectionRatio < 1 &&
+            entry.boundingClientRect.top <= topOffset + 1;
+          entry.target.classList.toggle('is-stuck', stuck);
+        }, {
+          root: null,
+          threshold: [1],
+          rootMargin: '-' + (topOffset + 1) + 'px 0px 0px 0px'
+        });
+
+        observer.observe(container);
+      });
+    })();
+  </script>
