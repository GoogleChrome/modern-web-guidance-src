+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var button = scroller.querySelector('.back-to-top');
+      var sentinel = scroller.querySelector('.scroller__top-sentinel');
+      var SHOW_AFTER_PX = 300;
+
+      function setVisible(visible) {
+        button.classList.toggle('is-visible', visible);
+        // Keep the hidden button out of the tab order and accessibility tree.
+        if (visible) {
+          button.removeAttribute('tabindex');
+          button.removeAttribute('aria-hidden');
+        } else {
+          button.setAttribute('tabindex', '-1');
+          button.setAttribute('aria-hidden', 'true');
+          if (document.activeElement === button) {
+            button.blur();
+          }
+        }
+      }
+
+      if ('IntersectionObserver' in window) {
+        // The sentinel sits at the top of the scroller. Extending the root's top
+        // edge by SHOW_AFTER_PX means it stops "intersecting" once the user has
+        // scrolled more than that distance. The browser only calls back on
+        // state changes, so there is no per-frame scroll handler.
+        var observer = new IntersectionObserver(function (entries) {
+          setVisible(!entries[0].isIntersecting);
+        }, {
+          root: scroller,
+          rootMargin: SHOW_AFTER_PX + 'px 0px 0px 0px',
+          threshold: 0
+        });
+        observer.observe(sentinel);
+      } else {
+        // Very old browsers: always show the button rather than never.
+        setVisible(true);
+      }
+
+      button.addEventListener('click', function () {
+        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        scroller.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
+        // Move keyboard focus to the top of the page so it does not stay on the
+        // button, which hides itself once the top is reached.
+        var nav = scroller.querySelector('nav');
+        if (nav) {
+          nav.setAttribute('tabindex', '-1');
+          nav.focus({ preventScroll: true });
+          nav.addEventListener('blur', function onBlur() {
+            nav.removeAttribute('tabindex');
+            nav.removeEventListener('blur', onBlur);
+          });
+        }
+      });
+    })();
+  </script>
