       margin: 2rem auto;
       text-align: center;
       color: #64748b;
     }
+
+    /*
+     * Cards below the initial fold: the browser skips layout + paint for them
+     * until they scroll near the viewport. contain-intrinsic-size keeps a
+     * placeholder box so the scrollbar/page height don't jump. 'auto' lets the
+     * browser remember the real size once the card has rendered.
+     */
+    .off-screen-card {
+      content-visibility: auto;
+      contain-intrinsic-size: auto none auto 380px;
+    }
+
+    @supports not (content-visibility: auto) {
+      .off-screen-card {
+        contain: layout style paint;
+      }
+    }
+
+    /*
+     * Debug panel: hidden with content-visibility: hidden rather than
+     * display: none. The box stays in the layout (placeholder height) and
+     * the rendering state is cached, so toggling is a single class flip
+     * with no re-layout of the 500 cards above it.
+     */
+    .debug-panel {
+      max-width: 800px;
+      margin: 0 auto 2rem;
+      padding: 0 1rem;
+      display: none;
+    }
+
+    @supports (content-visibility: hidden) {
+      .debug-panel {
+        display: block;
+        content-visibility: hidden;
+        contain-intrinsic-size: auto none auto 220px;
+      }
+    }
+
+    .debug-panel.is-open {
+      display: block;
+      content-visibility: visible;
+    }
+
+    .debug-panel-inner {
+      background: #0f172a;
+      color: #e2e8f0;
+      border-radius: 1rem;
+      padding: 1.25rem 1.5rem;
+      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+      font-size: 0.85rem;
+    }
+
+    .debug-panel-inner h2 {
+      margin: 0 0 0.75rem;
+      font-size: 0.95rem;
+      color: #93c5fd;
+    }
+
+    .debug-panel-inner dl {
+      display: grid;
+      grid-template-columns: max-content 1fr;
+      gap: 0.35rem 1.25rem;
+      margin: 0;
+    }
+
+    .debug-panel-inner dt {
+      color: #94a3b8;
+    }
+
+    .debug-panel-inner dd {
+      margin: 0;
+      font-weight: bold;
+    }
   </style>
