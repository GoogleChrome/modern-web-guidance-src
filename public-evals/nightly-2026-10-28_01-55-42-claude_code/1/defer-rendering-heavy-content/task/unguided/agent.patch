+    // Fired by the browser whenever a content-visibility: auto card starts or
+    // stops being rendered. Lets us count rendered cards without any
+    // layout-forcing DOM queries.
+    feed.addEventListener('contentvisibilityautostatechange', (event) => {
+      if (!event.target.classList.contains('off-screen-card')) return;
+      renderedCardCount += event.skipped ? -1 : 1;
+      scheduleDebugUpdate();
+    });
+
+    // ---- Debug panel ----
+    // Updates are rAF-coalesced and only run while the panel is visible, so a
+    // hidden panel costs nothing and a visible one never does more than one
+    // DOM write per frame.
+    let debugUpdateQueued = false;
+
+    function scheduleDebugUpdate() {
+      if (debugPanel.hidden || debugUpdateQueued) return;
+      debugUpdateQueued = true;
+      requestAnimationFrame(() => {
+        debugUpdateQueued = false;
+        updateDebugPanel();
+      });
+    }
+
+    function updateDebugPanel() {
+      dbgTotal.textContent = String(cardCount);
+      dbgRendered.textContent = String(Math.max(0, renderedCardCount));
+      dbgRenderTime.textContent = lastRenderDuration === null ? '-' : `${lastRenderDuration}ms`;
+      dbgScroll.textContent = `${Math.round(window.scrollY)}px`;
+      dbgViewport.textContent = `${window.innerWidth} x ${window.innerHeight}`;
+      dbgCv.textContent = CSS.supports('content-visibility', 'auto') ? 'yes' : 'no';
+    }
+
+    function setDebugPanelVisible(visible) {
+      // Toggling `hidden` on a fixed, contained element only affects the
+      // panel's own layer; the 500-card feed is left untouched.
+      debugPanel.hidden = !visible;
+      debugToggleBtn.setAttribute('aria-expanded', String(visible));
+      debugToggleBtn.classList.toggle('off', !visible);
+      if (visible) scheduleDebugUpdate();
+    }
+
+    function toggleDebugPanel() {
+      setDebugPanelVisible(debugPanel.hidden);
+    }
+
+    debugToggleBtn.addEventListener('click', toggleDebugPanel);
+    debugCloseBtn.addEventListener('click', () => setDebugPanelVisible(false));
+
+    // Keyboard shortcut: press "d" (outside of inputs) to toggle the panel.
+    document.addEventListener('keydown', (event) => {
+      if (event.key !== 'd' || event.ctrlKey || event.metaKey || event.altKey) return;
+      const tag = event.target.tagName;
+      if (tag === 'INPUT' || tag === 'TEXTAREA' || event.target.isContentEditable) return;
+      toggleDebugPanel();
+    });
+
+    window.addEventListener('scroll', scheduleDebugUpdate, { passive: true });
+    window.addEventListener('resize', scheduleDebugUpdate, { passive: true });
