+  <script>
+    (function () {
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('feedback-detect');
+      const statusEl = document.getElementById('feedback-status');
+      const resultEl = document.getElementById('feedback-result');
+      const languageEl = document.getElementById('feedback-language');
+      const confidenceEl = document.getElementById('feedback-confidence');
+      const progressWrap = document.getElementById('feedback-progress');
+      const progressBar = document.getElementById('feedback-progress-bar');
+      const progressText = document.getElementById('feedback-progress-text');
+
+      let detectorPromise = null;
+
+      function setStatus(message, isError) {
+        statusEl.textContent = message;
+        statusEl.classList.toggle('error', Boolean(isError));
+      }
+
+      function showProgress(percent) {
+        progressWrap.hidden = false;
+        progressBar.value = percent;
+        progressText.textContent = 'Downloading language model: ' + percent + '%';
+      }
+
+      function hideProgress() {
+        progressWrap.hidden = true;
+      }
+
+      function languageName(code) {
+        try {
+          const names = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+          return names.of(code) || code;
+        } catch (e) {
+          return code;
+        }
+      }
+
+      async function getDetector() {
+        if (detectorPromise) return detectorPromise;
+
+        detectorPromise = (async () => {
+          const availability = await LanguageDetector.availability();
+
+          if (availability === 'unavailable') {
+            throw new Error('Language detection is not available on this device.');
+          }
+
+          if (availability !== 'available') {
+            showProgress(0);
+            setStatus('The language model needs to be downloaded first. This only happens once.');
+          }
+
+          const detector = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const total = e.total || 1;
+                const percent = Math.min(100, Math.round((e.loaded / total) * 100));
+                showProgress(percent);
+              });
+            }
+          });
+
+          hideProgress();
+          return detector;
+        })();
+
+        detectorPromise.catch(() => { detectorPromise = null; });
+        return detectorPromise;
+      }
+
+      async function detectLanguage() {
+        const text = textarea.value.trim();
+        resultEl.hidden = true;
+
+        if (!text) {
+          setStatus('Please enter a message before detecting its language.', true);
+          return;
+        }
+
+        if (!('LanguageDetector' in self)) {
+          setStatus('Your browser does not support built-in language detection.', true);
+          return;
+        }
+
+        button.disabled = true;
+        setStatus('Detecting language...');
+
+        try {
+          const detector = await getDetector();
+          const results = await detector.detect(text);
+          const best = results && results[0];
+
+          if (!best || best.detectedLanguage === 'und') {
+            setStatus('We could not determine the language of that message. Try writing a bit more.', true);
+            return;
+          }
+
+          languageEl.textContent = languageName(best.detectedLanguage) + ' (' + best.detectedLanguage + ')';
+          confidenceEl.textContent = (best.confidence * 100).toFixed(1) + '%';
+          resultEl.hidden = false;
+          setStatus('');
+        } catch (err) {
+          hideProgress();
+          setStatus(err && err.message ? err.message : 'Something went wrong while detecting the language.', true);
+        } finally {
+          button.disabled = false;
+        }
+      }
+
+      button.addEventListener('click', detectLanguage);
+    })();
+  </script>
+
