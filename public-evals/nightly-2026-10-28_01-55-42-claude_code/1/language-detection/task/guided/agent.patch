+  <script>
+    (() => {
+      const form = document.getElementById('feedback-form');
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const status = document.getElementById('feedback-status');
+      const progressWrap = document.getElementById('feedback-progress');
+      const progressBar = document.getElementById('feedback-progress-bar');
+      const progressText = document.getElementById('feedback-progress-text');
+      const result = document.getElementById('feedback-result');
+      const resultLanguage = document.getElementById('result-language');
+      const resultConfidence = document.getElementById('result-confidence');
+
+      let detector = null;
+
+      const setStatus = (message) => { status.textContent = message; };
+
+      const showProgress = (fraction) => {
+        const percent = Math.round(Math.min(Math.max(fraction, 0), 1) * 100);
+        progressBar.value = percent;
+        progressText.textContent = `${percent}%`;
+        progressWrap.hidden = false;
+      };
+
+      const hideProgress = () => { progressWrap.hidden = true; };
+
+      const disableFeature = (message) => {
+        button.disabled = true;
+        setStatus(message);
+      };
+
+      const languageName = (code) => {
+        if (!code || code === 'und') return 'Unknown';
+        try {
+          const names = new Intl.DisplayNames([navigator.language, 'en'], { type: 'language' });
+          return names.of(code) || code;
+        } catch {
+          return code;
+        }
+      };
+
+      const formatConfidence = (confidence) =>
+        new Intl.NumberFormat(navigator.language, { style: 'percent', maximumFractionDigits: 1 }).format(confidence);
+
+      // 1. Feature detection: bail out early if the API is not in this browser.
+      if (!('LanguageDetector' in self)) {
+        disableFeature('On-device language detection is not supported in this browser.');
+        return;
+      }
+
+      // 2. Check whether the model is usable or can be downloaded.
+      (async () => {
+        try {
+          const availability = await LanguageDetector.availability();
+          if (availability === 'unavailable') {
+            disableFeature('Language detection is unavailable on this device.');
+          } else if (availability === 'available') {
+            setStatus('Ready to detect.');
+          } else {
+            setStatus('The language model will be downloaded the first time you click Detect.');
+          }
+        } catch (err) {
+          disableFeature('Could not check language detection availability.');
+          console.error(err);
+        }
+      })();
+
+      // 3. Create the detector inside a user gesture (required to start a download).
+      const getDetector = async () => {
+        if (detector) return detector;
+        let sawDownload = false;
+        detector = await LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              sawDownload = true;
+              setStatus('Downloading language model…');
+              showProgress(e.loaded);
+            });
+          },
+        });
+        if (sawDownload) showProgress(1);
+        return detector;
+      };
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const text = textarea.value.trim();
+        result.hidden = true;
+
+        if (!text) {
+          setStatus('Please enter a message first.');
+          textarea.focus();
+          return;
+        }
+
+        button.disabled = true;
+        try {
+          const instance = await getDetector();
+          hideProgress();
+          setStatus('Detecting…');
+
+          const results = await instance.detect(text);
+          const best = results[0];
+          if (!best) {
+            setStatus('Could not detect a language.');
+            return;
+          }
+
+          resultLanguage.textContent = `${languageName(best.detectedLanguage)} (${best.detectedLanguage})`;
+          resultConfidence.textContent = formatConfidence(best.confidence);
+          result.hidden = false;
+          setStatus(text.split(/\s+/).length < 3
+            ? 'Done. Tip: longer messages give more accurate results.'
+            : 'Done.');
+        } catch (err) {
+          console.error(err);
+          hideProgress();
+          detector = null;
+          setStatus(err && err.name === 'NotAllowedError'
+            ? 'The model download was blocked. Please click Detect again to retry.'
+            : 'Something went wrong while detecting the language. Please try again.');
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
