diff --git a/site.js b/site.js
new file mode 100644
index 0000000..ee445b2
--- /dev/null
+++ b/site.js
@@ -0,0 +1,159 @@
+import { createOriginGuard } from './origin-guard.js';
+
+// Deployment configuration. The ordering app lives on its own origin and is
+// the only window allowed to push order updates into this page.
+const TRUSTED_ORDERING_ORIGIN = 'https://order.thedailygrind.com';
+const SITE_REGISTRABLE_DOMAIN = 'thedailygrind.com';
+const RETURN_TO_PARAM = 'returnTo';
+const WIDGET_MAX_HEIGHT = 480;
+
+const guard = createOriginGuard({
+  trustedOrderingOrigin: TRUSTED_ORDERING_ORIGIN,
+  siteUrl: location.href,
+  siteRegistrableDomain: SITE_REGISTRABLE_DOMAIN,
+});
+
+const widgetPin = guard.createSandboxPin({ initType: 'init' });
+
+const $ = (selector) => document.querySelector(selector);
+
+function logMessage(kind, text) {
+  const list = $('#message-log');
+  if (!list) return;
+  const item = document.createElement('li');
+  item.dataset.kind = kind;
+  item.textContent = `${kind === 'accepted' ? '✓' : '✕'} ${text}`;
+  list.prepend(item);
+  while (list.children.length > 8) list.lastElementChild.remove();
+}
+
+function setStatus(selector, text) {
+  const el = $(selector);
+  if (!el) return;
+  el.textContent = text; // textContent only: message payloads are untrusted
+  el.hidden = text === '';
+}
+
+/* ---------------------------------------------------------------------------
+ * 1. Cross-window messages from the ordering app (exact origin match)
+ * ------------------------------------------------------------------------- */
+
+function handleOrderingMessage(event) {
+  const data = event.data;
+  if (!data || typeof data !== 'object') return;
+
+  switch (data.type) {
+    case 'order:status': {
+      const orderId = String(data.orderId ?? '').slice(0, 32);
+      const status = String(data.status ?? '').slice(0, 80);
+      setStatus('#order-status', `Order ${orderId}: ${status}`);
+      logMessage('accepted', `order:status from ${event.origin}`);
+      // Reply to the verified sender only, and pin the target origin so the
+      // acknowledgement cannot leak if the window has since navigated away.
+      event.source?.postMessage({ type: 'order:ack', orderId }, guard.trustedOrderingOrigin);
+      break;
+    }
+    default:
+      logMessage('rejected', `unknown ordering message type "${String(data.type).slice(0, 40)}"`);
+  }
+}
+
+/* ---------------------------------------------------------------------------
+ * 3. Sandboxed brew-timer widget (identity pinned on init)
+ * ------------------------------------------------------------------------- */
+
+function widgetWindow() {
+  return $('#brew-widget')?.contentWindow ?? null;
+}
+
+function handleWidgetMessage(event) {
+  const data = event.data;
+  if (!data || typeof data !== 'object') return;
+
+  switch (data.type) {
+    case 'init': {
+      logMessage('accepted', 'brew-timer widget pinned');
+      // The widget's origin is opaque, so "*" is the only usable targetOrigin.
+      // Only send it non-sensitive configuration.
+      event.source.postMessage({ type: 'init:ack', theme: 'light' }, '*');
+      break;
+    }
+    case 'widget:resize': {
+      const height = Number(data.height);
+      if (Number.isFinite(height) && height > 0) {
+        $('#brew-widget').style.height = `${Math.min(Math.round(height), WIDGET_MAX_HEIGHT)}px`;
+      }
+      break;
+    }
+    case 'widget:brew-complete': {
+      const method = String(data.method ?? 'your brew').slice(0, 40);
+      setStatus('#brew-status', `Timer finished: ${method} is ready to pour.`);
+      logMessage('accepted', `widget:brew-complete (${method})`);
+      break;
+    }
+    default:
+      logMessage('rejected', `unknown widget message type "${String(data.type).slice(0, 40)}"`);
+  }
+}
+
+window.addEventListener('message', (event) => {
+  if (guard.isTrustedOrderingOrigin(event)) {
+    handleOrderingMessage(event);
+    return;
+  }
+
+  if (widgetPin.accept(event, widgetWindow())) {
+    handleWidgetMessage(event);
+    return;
+  }
+
+  // Everything else: wrong origin, an unrelated sandboxed iframe (also
+  // origin "null"), or the widget before it has initialised. Ignore it.
+  logMessage('rejected', `message from ${event.origin || 'unknown origin'}`);
+});
+
+/* ---------------------------------------------------------------------------
+ * 2. Same-site redirects and external-link classification
+ * ------------------------------------------------------------------------- */
+
+function renderReturnToBanner() {
+  const target = new URLSearchParams(location.search).get(RETURN_TO_PARAM);
+  if (target === null) return;
+
+  const banner = $('#return-to-banner');
+  const link = $('#return-to-link');
+  if (!banner || !link) return;
+
+  const safeHref = guard.resolveSameSiteRedirect(target);
+  if (!safeHref) {
+    // Off-site or malformed target: drop it rather than send the user there.
+    logMessage('rejected', `returnTo target not same-site`);
+    return;
+  }
+
+  link.href = safeHref;
+  link.textContent = `Continue to ${new URL(safeHref).pathname}`;
+  banner.hidden = false;
+}
+
+function classifyLinks() {
+  for (const anchor of document.querySelectorAll('a[href]')) {
+    if (anchor.protocol !== 'https:' && anchor.protocol !== 'http:') continue;
+    if (guard.isSameSite(anchor)) continue;
+
+    anchor.classList.add('external');
+    anchor.target = '_blank';
+    const rel = new Set(anchor.rel.split(/\s+/).filter(Boolean));
+    rel.add('noopener');
+    rel.add('noreferrer');
+    anchor.rel = [...rel].join(' ');
+
+    const hint = document.createElement('span');
+    hint.className = 'visually-hidden';
+    hint.textContent = ' (external site, opens in a new tab)';
+    anchor.append(hint);
+  }
+}
+
+renderReturnToBanner();
+classifyLinks();
diff --git a/test/origin-guard.test.mjs b/test/origin-guard.test.mjs
new file mode 100644
index 0000000..279bbea
--- /dev/null
+++ b/test/origin-guard.test.mjs
@@ -0,0 +1,226 @@
+import { test, describe, beforeEach, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { createOriginGuard } from '../origin-guard.js';
+
+const CONFIG = {
+  trustedOrderingOrigin: 'https://order.thedailygrind.com',
+  siteUrl: 'https://www.thedailygrind.com/',
+  siteRegistrableDomain: 'thedailygrind.com',
+};
+
+const fakeWindow = (name) => ({ name });
+
+/**
+ * Build something that passes `instanceof MessageEvent` (as browser-dispatched
+ * events do) without going through Node's constructor, which refuses a plain
+ * object as `source`.
+ */
+function msg(origin, source, data, extra = {}) {
+  const e = Object.create(MessageEvent.prototype);
+  for (const [key, value] of Object.entries({ type: 'message', origin, source, data, ...extra })) {
+    Object.defineProperty(e, key, { value, writable: true, configurable: true, enumerable: true });
+  }
+  return e;
+}
+
+/**
+ * Minimal stand-in for the browser `Origin` API so the Origin-backed code path
+ * can be exercised in Node. Opaque identity is modelled with a unique token;
+ * a fake MessageEvent carries its sender origin in `__origin`.
+ */
+class FakeOrigin {
+  constructor(parsed = null) {
+    this.parsed = parsed; // { protocol, hostname, port } or null for opaque
+    this.token = Symbol('opaque');
+  }
+  get opaque() {
+    return this.parsed === null;
+  }
+  static from(candidate) {
+    if (candidate instanceof FakeOrigin) return candidate;
+    if (candidate && candidate.__origin instanceof FakeOrigin) return candidate.__origin;
+    const href = typeof candidate === 'string' ? candidate : candidate?.href;
+    if (typeof href !== 'string') throw new TypeError('unsupported');
+    const url = new URL(href); // throws on 'null' and garbage, like the real API
+    if (url.origin === 'null') return new FakeOrigin(null);
+    return new FakeOrigin({ protocol: url.protocol, hostname: url.hostname, port: url.port });
+  }
+  isSameOrigin(other) {
+    if (!(other instanceof FakeOrigin)) throw new TypeError('not an Origin');
+    if (this.opaque || other.opaque) return this.token === other.token;
+    return (
+      this.parsed.protocol === other.parsed.protocol &&
+      this.parsed.hostname === other.parsed.hostname &&
+      this.parsed.port === other.parsed.port
+    );
+  }
+  isSameSite(other) {
+    if (this.opaque || other.opaque) return this.isSameOrigin(other);
+    if (this.parsed.protocol !== other.parsed.protocol) return false;
+    const site = (h) => h.split('.').slice(-2).join('.'); // test-only PSL stand-in
+    return site(this.parsed.hostname) === site(other.parsed.hostname);
+  }
+}
+
+for (const mode of ['url-fallback', 'origin-api']) {
+  describe(`createOriginGuard (${mode})`, () => {
+    let guard;
+
+    beforeEach(() => {
+      if (mode === 'origin-api') globalThis.Origin = FakeOrigin;
+      guard = createOriginGuard(CONFIG);
+    });
+    afterEach(() => {
+      delete globalThis.Origin;
+    });
+
+    const event = (origin, source, data) => {
+      const e = msg(origin, source, data);
+      if (mode === 'origin-api') {
+        // Browser-dispatched events carry an internal origin; invalid strings
+        // leave it unset so Origin.from(event) throws like it would for a
+        // synthetic event, exercising the `event.origin` fallback.
+        try {
+          e.__origin = origin === 'null' ? new FakeOrigin(null) : FakeOrigin.from(origin);
+        } catch {
+          /* leave unset */
+        }
+      }
+      return e;
+    };
+
+    describe('isTrustedOrderingOrigin', () => {
+      test('accepts the exact ordering origin, with or without default port', () => {
+        assert.equal(guard.isTrustedOrderingOrigin('https://order.thedailygrind.com'), true);
+        assert.equal(guard.isTrustedOrderingOrigin('https://order.thedailygrind.com:443/x?y'), true);
+        assert.equal(guard.isTrustedOrderingOrigin(event('https://order.thedailygrind.com', fakeWindow('o'), {})), true);
+      });
+
+      test('rejects look-alikes, siblings, downgrades, ports and opaque origins', () => {
+        for (const bad of [
+          'https://order.thedailygrind.com.attacker.example',
+          'https://attacker.example/?u=https://order.thedailygrind.com',
+          'https://www.thedailygrind.com',
+          'http://order.thedailygrind.com',
+          'https://order.thedailygrind.com:8443',
+          'null',
+          '',
+          'not a url',
+        ]) {
+          assert.equal(guard.isTrustedOrderingOrigin(bad), false, bad);
+          assert.equal(guard.isTrustedOrderingOrigin(event(bad, fakeWindow('x'), {})), false, bad);
+        }
+      });
+    });
+
+    describe('isSameSite / resolveSameSiteRedirect', () => {
+      test('accepts subdomains and ports on the same scheme and registrable domain', () => {
+        assert.equal(guard.isSameSite('https://www.thedailygrind.com/menu'), true);
+        assert.equal(guard.isSameSite('https://rewards.thedailygrind.com:8443/'), true);
+        assert.equal(guard.isSameSite('https://thedailygrind.com'), true);
+        assert.equal(guard.resolveSameSiteRedirect('/account?tab=orders'), 'https://www.thedailygrind.com/account?tab=orders');
+        assert.equal(guard.resolveSameSiteRedirect('https://rewards.thedailygrind.com/points'), 'https://rewards.thedailygrind.com/points');
+      });
+
+      test('rejects suffix spoofing, scheme downgrades and other sites', () => {
+        for (const bad of [
+          'https://thedailygrind.com.attacker.example/',
+          'https://evilthedailygrind.com/',
+          'https://attacker.example/thedailygrind.com',
+          'http://www.thedailygrind.com/',
+          'https://attacker.example/',
+        ]) {
+          assert.equal(guard.isSameSite(bad), false, bad);
+          assert.equal(guard.resolveSameSiteRedirect(bad), null, bad);
+        }
+      });
+
+      test('rejects protocol-relative, scheme-less and non-http redirect targets', () => {
+        for (const bad of [
+          '//attacker.example/',
+          '\\\\attacker.example',
+          'javascript:alert(1)',
+          'data:text/html,hi',
+          'mailto:hello@thedailygrind.com',
+          '',
+          '   ',
+          null,
+          undefined,
+          42,
+        ]) {
+          assert.equal(guard.resolveSameSiteRedirect(bad), null, String(bad));
+        }
+      });
+
+      test('classifies anchor-like objects by href', () => {
+        assert.equal(guard.isSameSite({ href: 'https://www.thedailygrind.com/about' }), true);
+        assert.equal(guard.isSameSite({ href: 'https://www.instagram.com/thedailygrind' }), false);
+      });
+    });
+
+    describe('createSandboxPin', () => {
+      let pin;
+      let widget;
+      let other;
+
+      beforeEach(() => {
+        pin = guard.createSandboxPin();
+        widget = fakeWindow('widget');
+        other = fakeWindow('other-sandbox');
+      });
+
+      test('pins on init from the expected iframe, then accepts only that sender', () => {
+        const init = event('null', widget, { type: 'init' });
+        assert.equal(pin.accept(init, widget), true);
+        assert.equal(pin.isPinned, true);
+
+        const later = event('null', widget, { type: 'widget:resize', height: 200 });
+        if (mode === 'origin-api') later.__origin = init.__origin; // same document
+        assert.equal(pin.accept(later, widget), true);
+
+        // A different sandboxed iframe also reports origin "null"; rejected.
+        assert.equal(pin.accept(event('null', other, { type: 'widget:resize', height: 1 }), widget), false);
+        // Another sandbox trying to re-run the init handshake is rejected too.
+        assert.equal(pin.accept(event('null', other, { type: 'init' }), widget), false);
+        assert.equal(pin.isPinned, true);
+      });
+
+      test('ignores non-init messages before the pin is established', () => {
+        assert.equal(pin.accept(event('null', widget, { type: 'widget:resize', height: 1 }), widget), false);
+        assert.equal(pin.isPinned, false);
+      });
+
+      test('does not pin an init message from a window other than the expected iframe', () => {
+        assert.equal(pin.accept(event('null', other, { type: 'init' }), widget), false);
+        assert.equal(pin.isPinned, false);
+      });
+
+      test('rejects senders with a real (non-opaque) origin on this channel', () => {
+        assert.equal(pin.accept(event('https://www.thedailygrind.com', widget, { type: 'init' }), widget), false);
+        assert.equal(pin.accept(event('https://attacker.example', widget, { type: 'init' }), widget), false);
+      });
+
+      test('rejects malformed events', () => {
+        assert.equal(pin.accept(null, widget), false);
+        assert.equal(pin.accept(event('null', null, { type: 'init' }), widget), false);
+        assert.equal(pin.accept(event('null', widget, { type: 'init' }), null), false);
+        assert.equal(pin.accept(event('null', widget, 'init'), widget), false);
+      });
+
+      if (mode === 'origin-api') {
+        test('rejects the pinned window after it navigates to a new opaque document', () => {
+          assert.equal(pin.accept(event('null', widget, { type: 'init' }), widget), true);
+          // Same WindowProxy, but a fresh opaque origin (new document).
+          assert.equal(pin.accept(event('null', widget, { type: 'widget:resize', height: 1 }), widget), false);
+        });
+      }
+
+      test('reset() clears the pin', () => {
+        assert.equal(pin.accept(event('null', widget, { type: 'init' }), widget), true);
+        pin.reset();
+        assert.equal(pin.isPinned, false);
+        assert.equal(pin.accept(event('null', widget, { type: 'widget:resize', height: 1 }), widget), false);
+      });
+    });
+  });
+}
