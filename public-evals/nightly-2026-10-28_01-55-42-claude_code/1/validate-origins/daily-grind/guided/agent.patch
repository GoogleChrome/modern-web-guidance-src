index 0000000..8de7f00
--- /dev/null
+++ b/origin-guard.js
@@ -0,0 +1,208 @@
+/**
+ * Origin and site validation helpers for The Daily Grind.
+ *
+ * Uses the `Origin` API (`Origin.from()`, `isSameOrigin()`, `isSameSite()`,
+ * `opaque`) when the browser supports it, and falls back to `new URL()`
+ * parsing elsewhere. Nothing in here uses `startsWith`, `includes`, or
+ * `split('.')` on hostnames, which is where prefix-spoofing and
+ * public-suffix bugs usually come from.
+ */
+
+const hasOriginApi = () => typeof globalThis.Origin === 'function';
+
+function isMessageEvent(candidate) {
+  return typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent;
+}
+
+/**
+ * Extract an `Origin` from a URL string, URL, anchor element, Window, or
+ * MessageEvent. Browser-dispatched MessageEvents carry an internal origin
+ * (which preserves opaque identity); synthetic ones only have the
+ * `event.origin` string, so fall back to parsing that.
+ */
+function extractOrigin(candidate) {
+  try {
+    return Origin.from(candidate);
+  } catch (err) {
+    if (isMessageEvent(candidate)) {
+      return Origin.from(candidate.origin);
+    }
+    throw err;
+  }
+}
+
+/** Fallback path: turn a candidate into a URL string for `new URL()`. */
+function extractUrlString(candidate) {
+  if (typeof candidate === 'string') return candidate;
+  if (candidate instanceof URL) return candidate.href;
+  if (isMessageEvent(candidate)) return candidate.origin;
+  if (candidate === globalThis) return globalThis.location?.href ?? '';
+  return candidate?.href ?? '';
+}
+
+/**
+ * Build a guard bound to this deployment's trusted origins.
+ *
+ * @param {object} config
+ * @param {string} config.trustedOrderingOrigin  Exact origin allowed to send
+ *   privileged cross-window messages (e.g. the online-ordering app).
+ * @param {string} config.siteUrl  Any URL on the current site; used as the
+ *   reference for same-site checks (normally `location.href`).
+ * @param {string} config.siteRegistrableDomain  The registrable domain this
+ *   site owns (e.g. `thedailygrind.com`). Only consulted by the `URL`
+ *   fallback, which has no Public Suffix List of its own.
+ * @param {string} [config.baseUrl]  Base used to resolve relative redirect
+ *   targets. Defaults to `siteUrl`.
+ */
+export function createOriginGuard({
+  trustedOrderingOrigin,
+  siteUrl,
+  siteRegistrableDomain,
+  baseUrl = siteUrl,
+}) {
+  const trustedOrderingUrl = new URL(trustedOrderingOrigin);
+  const siteReferenceUrl = new URL(siteUrl);
+  const registrableDomain = String(siteRegistrableDomain).toLowerCase();
+
+  /**
+   * Exact (scheme, host, port) match against the ordering origin. Used as the
+   * privilege boundary for cross-window messages; sibling subdomains are
+   * rejected on purpose.
+   */
+  function isTrustedOrderingOrigin(candidate) {
+    try {
+      if (hasOriginApi()) {
+        return extractOrigin(candidate).isSameOrigin(Origin.from(trustedOrderingUrl.href));
+      }
+      const candidateUrl = new URL(extractUrlString(candidate));
+      return candidateUrl.origin !== 'null' && candidateUrl.origin === trustedOrderingUrl.origin;
+    } catch {
+      return false;
+    }
+  }
+
+  /**
+   * Schemeful same-site check against this site. Accepts any subdomain or
+   * port on the same scheme and registrable domain; rejects http: downgrades,
+   * opaque origins (data:, javascript:, blob: from sandboxes), and look-alike
+   * hosts such as `thedailygrind.com.attacker.example`.
+   */
+  function isSameSite(candidate) {
+    try {
+      if (hasOriginApi()) {
+        const candidateOrigin = extractOrigin(candidate);
+        if (candidateOrigin.opaque) return false;
+        return candidateOrigin.isSameSite(Origin.from(siteReferenceUrl.href));
+      }
+      const candidateUrl = new URL(extractUrlString(candidate));
+      if (candidateUrl.origin === 'null') return false;
+      if (candidateUrl.protocol !== siteReferenceUrl.protocol) return false;
+      const host = candidateUrl.hostname.toLowerCase();
+      // The URL fallback cannot consult the Public Suffix List, so only match
+      // the exact host we are running on, or the domain we know we own
+      // (exact or dot-prefixed, never a bare suffix match).
+      return (
+        host === siteReferenceUrl.hostname.toLowerCase() ||
+        host === registrableDomain ||
+        host.endsWith(`.${registrableDomain}`)
+      );
+    } catch {
+      return false;
+    }
+  }
+
+  /**
+   * Validate a redirect target (e.g. `?returnTo=`). Relative paths are
+   * resolved against `baseUrl`. Returns the normalized absolute URL string
+   * when it is a same-site http(s) URL, otherwise `null`.
+   */
+  function resolveSameSiteRedirect(target) {
+    if (typeof target !== 'string' || target.trim() === '') return null;
+    let resolved;
+    try {
+      resolved = new URL(target, baseUrl);
+    } catch {
+      return null;
+    }
+    if (resolved.protocol !== 'https:' && resolved.protocol !== 'http:') return null;
+    if (!isSameSite(resolved)) return null;
+    return resolved.href;
+  }
+
+  /**
+   * Pin the identity of one sandboxed iframe widget on its `init` message.
+   *
+   * Sandboxed iframes (`sandbox="allow-scripts"` without
+   * `allow-same-origin`) serialize `event.origin` as the string "null", so
+   * two unrelated sandboxes are indistinguishable by string comparison. We
+   * therefore pin two things on init: the sender `Window` (`event.source`,
+   * which must be the expected iframe's `contentWindow`) and, where the
+   * `Origin` API exists, the sender's underlying opaque `Origin`. Later
+   * messages are accepted only when both still match; any other sandboxed
+   * iframe, or the same iframe after navigating to a new document, is
+   * rejected.
+   */
+  function createSandboxPin({ initType = 'init' } = {}) {
+    let pinnedSource = null;
+    let pinnedOrigin = hasOriginApi() ? new Origin() : null;
+    let pinned = false;
+
+    function senderOrigin(event) {
+      if (!hasOriginApi()) return null;
+      try {
+        return Origin.from(event);
+      } catch {
+        return null;
+      }
+    }
+
+    return {
+      get isPinned() {
+        return pinned;
+      },
+
+      /**
+       * @param {MessageEvent} event
+       * @param {Window | null | undefined} expectedWidgetWindow  The iframe's
+       *   current `contentWindow`.
+       * @returns {boolean} whether the message may be trusted as the widget's.
+       */
+      accept(event, expectedWidgetWindow) {
+        if (!event || !event.source || !expectedWidgetWindow) return false;
+        // Only opaque-origin senders are eligible: this channel is for the
+        // sandboxed widget, not for arbitrary same-origin or remote windows.
+        if (event.origin !== 'null') return false;
+
+        const origin = senderOrigin(event);
+        if (hasOriginApi() && (!origin || !origin.opaque)) return false;
+
+        if (!pinned) {
+          const isInit = event.data && typeof event.data === 'object' && event.data.type === initType;
+          if (!isInit || event.source !== expectedWidgetWindow) return false;
+          pinnedSource = event.source;
+          if (origin) pinnedOrigin = origin;
+          pinned = true;
+          return true;
+        }
+
+        if (event.source !== pinnedSource || event.source !== expectedWidgetWindow) return false;
+        if (origin && !origin.isSameOrigin(pinnedOrigin)) return false;
+        return true;
+      },
+
+      reset() {
+        pinnedSource = null;
+        pinnedOrigin = hasOriginApi() ? new Origin() : null;
+        pinned = false;
+      },
+    };
+  }
+
+  return {
+    trustedOrderingOrigin: trustedOrderingUrl.origin,
+    isTrustedOrderingOrigin,
+    isSameSite,
+    resolveSameSiteRedirect,
+    createSandboxPin,
+  };
+}
