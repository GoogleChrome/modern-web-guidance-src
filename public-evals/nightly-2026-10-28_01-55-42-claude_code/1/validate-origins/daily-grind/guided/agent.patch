+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <title>Brew Timer</title>
+  <style>
+    body {
+      margin: 0;
+      padding: 16px;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      color: #3e2723;
+      background: #fff;
+      text-align: center;
+    }
+
+    h3 {
+      margin: 0 0 8px;
+      color: #4e342e;
+    }
+
+    select,
+    button {
+      font: inherit;
+      padding: 6px 10px;
+      margin: 4px;
+    }
+
+    button {
+      background: #4e342e;
+      color: #fff;
+      border: 0;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+
+    output {
+      display: block;
+      font-size: 2rem;
+      font-variant-numeric: tabular-nums;
+      margin: 8px 0;
+    }
+  </style>
+</head>
+
+<body>
+  <h3>Brew Timer</h3>
+  <label>
+    Method
+    <select id="method">
+      <option value="Pour-over" data-seconds="210">Pour-over (3:30)</option>
+      <option value="French press" data-seconds="240">French press (4:00)</option>
+      <option value="AeroPress" data-seconds="90">AeroPress (1:30)</option>
+    </select>
+  </label>
+  <output id="clock" aria-live="polite">0:00</output>
+  <button id="start" type="button">Start</button>
+
+  <script>
+    // This document runs inside <iframe sandbox="allow-scripts">, so its
+    // origin is opaque and the parent sees event.origin === "null". The
+    // parent pins this window on the "init" message below; every later
+    // message is only honoured because it comes from the same pinned sender.
+    const methodEl = document.getElementById('method');
+    const clockEl = document.getElementById('clock');
+    const startEl = document.getElementById('start');
+    let timer = null;
+
+    const send = (message) => parent.postMessage(message, '*');
+
+    function format(total) {
+      const m = Math.floor(total / 60);
+      const s = total % 60;
+      return `${m}:${String(s).padStart(2, '0')}`;
+    }
+
+    startEl.addEventListener('click', () => {
+      clearInterval(timer);
+      const option = methodEl.selectedOptions[0];
+      let remaining = Number(option.dataset.seconds);
+      clockEl.value = format(remaining);
+      timer = setInterval(() => {
+        remaining -= 1;
+        clockEl.value = format(Math.max(remaining, 0));
+        if (remaining <= 0) {
+          clearInterval(timer);
+          send({ type: 'widget:brew-complete', method: option.value });
+        }
+      }, 1000);
+    });
+
+    window.addEventListener('message', (event) => {
+      // Only the embedding page may configure this widget.
+      if (event.source !== parent) return;
+      if (event.data?.type === 'init:ack' && event.data.theme === 'dark') {
+        document.body.style.background = '#3e2723';
+        document.body.style.color = '#fafafa';
+      }
+    });
+
+    send({ type: 'init' });
+    send({ type: 'widget:resize', height: document.documentElement.scrollHeight });
+  </script>
+</body>
+
+</html>
