diff --git a/js/origin-guard.js b/js/origin-guard.js
new file mode 100644
index 0000000..74611ad
--- /dev/null
+++ b/js/origin-guard.js
@@ -0,0 +1,181 @@
+/*
+ * Origin / site validation helpers for The Daily Grind.
+ *
+ * Loaded by index.html in the browser (exposed as window.DailyGrindGuard) and
+ * importable from Node for unit tests (module.exports). Every check here goes
+ * through the WHATWG URL parser instead of splitting or searching strings, so
+ * the usual bypasses do not apply:
+ *
+ *   - "https://thedailygrind.com.evil.com"  (prefix match on the host)
+ *   - "https://evilthedailygrind.com"       (endsWith without a dot boundary)
+ *   - "https://thedailygrind.com@evil.com"  (userinfo before the real host)
+ *   - "//evil.com/x", "/\\evil.com"         (protocol-relative / backslash tricks)
+ *   - "javascript:...", "data:..."          (non-web schemes)
+ *   - "https://order.thedailygrind.com.evil.com" posting a message whose origin
+ *     merely *contains* the trusted origin string.
+ */
+(function (root, factory) {
+  if (typeof module === 'object' && module.exports) {
+    module.exports = factory();
+  } else {
+    root.DailyGrindGuard = factory();
+  }
+})(typeof self !== 'undefined' ? self : this, function () {
+  'use strict';
+
+  /** Registrable domain of this site. Subdomains are same-site. */
+  var SITE_DOMAIN = 'thedailygrind.com';
+
+  /** The only cross-window sender whose messages are trusted. */
+  var ORDERING_ORIGIN = 'https://order.thedailygrind.com';
+
+  var WEB_PROTOCOLS = { 'http:': true, 'https:': true };
+  var CONTACT_PROTOCOLS = { 'mailto:': true, 'tel:': true };
+
+  /**
+   * Parse a URL string, optionally relative to a base. Returns null instead of
+   * throwing so callers can treat "unparseable" as "untrusted".
+   */
+  function parseUrl(input, base) {
+    if (typeof input !== 'string' || input.length === 0) return null;
+    try {
+      return base ? new URL(input, base) : new URL(input);
+    } catch (e) {
+      return null;
+    }
+  }
+
+  /**
+   * True when `hostname` is `siteDomain` or a subdomain of it. The comparison
+   * is on a dot boundary, so "evilthedailygrind.com" does not match, and a
+   * trailing dot (FQDN form) is normalised away.
+   */
+  function hostMatchesSite(hostname, siteDomain) {
+    if (typeof hostname !== 'string' || typeof siteDomain !== 'string') return false;
+    var host = hostname.toLowerCase().replace(/\.$/, '');
+    var site = siteDomain.toLowerCase().replace(/\.$/, '');
+    if (!host || !site) return false;
+    return host === site || host.slice(-(site.length + 1)) === '.' + site;
+  }
+
+  /**
+   * Exact comparison against the trusted ordering origin. Origins are opaque
+   * identifiers: never use startsWith / includes / indexOf on them.
+   */
+  function isTrustedOrigin(origin) {
+    return typeof origin === 'string' && origin === ORDERING_ORIGIN;
+  }
+
+  /**
+   * Decide whether an already-parsed URL is same-site.
+   *
+   * opts.siteDomain     registrable domain (defaults to SITE_DOMAIN)
+   * opts.currentOrigin  origin of the running page, e.g. location.origin.
+   *                     Used to (a) permit the exact current host when the page
+   *                     is served from somewhere else, such as localhost during
+   *                     development, and (b) refuse https -> http downgrades.
+   */
+  function isSameSiteUrl(url, opts) {
+    opts = opts || {};
+    if (!(url instanceof URL)) return false;
+    if (!WEB_PROTOCOLS[url.protocol]) return false;
+    if (url.username || url.password) return false;
+
+    var current = opts.currentOrigin ? parseUrl(opts.currentOrigin) : null;
+    var siteDomain = opts.siteDomain || SITE_DOMAIN;
+
+    // Never send a user from an https page to a plain-http one.
+    if (url.protocol === 'http:' && (!current || current.protocol !== 'http:')) {
+      return false;
+    }
+
+    if (hostMatchesSite(url.hostname, siteDomain)) return true;
+
+    // Same origin as the running page (covers local dev hosts).
+    return !!current && url.protocol === current.protocol && url.host === current.host;
+  }
+
+  /**
+   * Resolve a user- or message-supplied redirect target and return an absolute
+   * URL string only if it is same-site; otherwise return opts.fallback (null by
+   * default). opts.base is the URL relative paths resolve against (normally
+   * location.href).
+   */
+  function toSafeRedirect(input, opts) {
+    opts = opts || {};
+    var fallback = Object.prototype.hasOwnProperty.call(opts, 'fallback') ? opts.fallback : null;
+    var url = parseUrl(input, opts.base);
+    if (!url || !isSameSiteUrl(url, opts)) return fallback;
+    return url.href;
+  }
+
+  /**
+   * Classify an anchor href:
+   *   'same-site'  navigates within this site
+   *   'external'   http(s) link to another site
+   *   'contact'    mailto: / tel:
+   *   'blocked'    anything else (javascript:, data:, unparseable, ...)
+   */
+  function classifyLink(href, opts) {
+    opts = opts || {};
+    var url = parseUrl(href, opts.base);
+    if (!url) return 'blocked';
+    if (CONTACT_PROTOCOLS[url.protocol]) return 'contact';
+    if (!WEB_PROTOCOLS[url.protocol]) return 'blocked';
+    return isSameSiteUrl(url, opts) ? 'same-site' : 'external';
+  }
+
+  /**
+   * Gate for messages from a sandboxed iframe widget.
+   *
+   * A sandboxed frame without allow-same-origin has an opaque origin, which
+   * postMessage reports as the string "null". Every sandboxed frame on the
+   * page therefore looks identical by origin, so identity has to come from
+   * event.source instead. On the first well-formed 'widget:init' message whose
+   * source is the expected frame's window, that WindowProxy is pinned. From
+   * then on only messages whose source is the pinned window are accepted; init
+   * or data messages from any other frame are rejected.
+   *
+   * getExpectedWindow  returns the widget iframe's contentWindow (evaluated
+   *                    lazily so the gate can be created before the frame
+   *                    has loaded).
+   */
+  function createWidgetGate(getExpectedWindow) {
+    var pinned = null;
+
+    function accept(event) {
+      if (!event || event.origin !== 'null' || !event.source) return false;
+
+      if (pinned !== null) {
+        return event.source === pinned;
+      }
+
+      var data = event.data;
+      if (!data || typeof data !== 'object' || data.type !== 'widget:init') return false;
+
+      var expected = typeof getExpectedWindow === 'function' ? getExpectedWindow() : null;
+      if (!expected || event.source !== expected) return false;
+
+      pinned = event.source;
+      return true;
+    }
+
+    return {
+      accept: accept,
+      isPinned: function () { return pinned !== null; },
+      reset: function () { pinned = null; }
+    };
+  }
+
+  return {
+    SITE_DOMAIN: SITE_DOMAIN,
+    ORDERING_ORIGIN: ORDERING_ORIGIN,
+    parseUrl: parseUrl,
+    hostMatchesSite: hostMatchesSite,
+    isTrustedOrigin: isTrustedOrigin,
+    isSameSiteUrl: isSameSiteUrl,
+    toSafeRedirect: toSafeRedirect,
+    classifyLink: classifyLink,
+    createWidgetGate: createWidgetGate
+  };
+});
