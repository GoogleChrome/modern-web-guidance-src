diff --git a/test/origin-guard.test.js b/test/origin-guard.test.js
new file mode 100644
index 0000000..11d09e7
--- /dev/null
+++ b/test/origin-guard.test.js
@@ -0,0 +1,143 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const guard = require('../js/origin-guard.js');
+
+const PROD = {
+  siteDomain: guard.SITE_DOMAIN,
+  currentOrigin: 'https://www.thedailygrind.com',
+  base: 'https://www.thedailygrind.com/'
+};
+const DEV = {
+  siteDomain: guard.SITE_DOMAIN,
+  currentOrigin: 'http://localhost:11222',
+  base: 'http://localhost:11222/'
+};
+
+test('hostMatchesSite requires a dot boundary', () => {
+  assert.equal(guard.hostMatchesSite('thedailygrind.com', 'thedailygrind.com'), true);
+  assert.equal(guard.hostMatchesSite('menu.thedailygrind.com', 'thedailygrind.com'), true);
+  assert.equal(guard.hostMatchesSite('MENU.TheDailyGrind.COM.', 'thedailygrind.com'), true);
+  assert.equal(guard.hostMatchesSite('evilthedailygrind.com', 'thedailygrind.com'), false);
+  assert.equal(guard.hostMatchesSite('thedailygrind.com.evil.com', 'thedailygrind.com'), false);
+  assert.equal(guard.hostMatchesSite('thedailygrind.co', 'thedailygrind.com'), false);
+  assert.equal(guard.hostMatchesSite('', 'thedailygrind.com'), false);
+  assert.equal(guard.hostMatchesSite(undefined, 'thedailygrind.com'), false);
+});
+
+test('isTrustedOrigin is an exact match', () => {
+  assert.equal(guard.isTrustedOrigin('https://order.thedailygrind.com'), true);
+  assert.equal(guard.isTrustedOrigin('https://order.thedailygrind.com.evil.com'), false);
+  assert.equal(guard.isTrustedOrigin('https://evil.com/?https://order.thedailygrind.com'), false);
+  assert.equal(guard.isTrustedOrigin('http://order.thedailygrind.com'), false);
+  assert.equal(guard.isTrustedOrigin('https://www.thedailygrind.com'), false);
+  assert.equal(guard.isTrustedOrigin('null'), false);
+  assert.equal(guard.isTrustedOrigin(undefined), false);
+});
+
+test('toSafeRedirect accepts same-site targets', () => {
+  assert.equal(guard.toSafeRedirect('/account', PROD), 'https://www.thedailygrind.com/account');
+  assert.equal(guard.toSafeRedirect('rewards?tab=1#top', PROD), 'https://www.thedailygrind.com/rewards?tab=1#top');
+  assert.equal(guard.toSafeRedirect('https://menu.thedailygrind.com/seasonal', PROD),
+    'https://menu.thedailygrind.com/seasonal');
+  assert.equal(guard.toSafeRedirect('https://thedailygrind.com/', PROD), 'https://thedailygrind.com/');
+});
+
+test('toSafeRedirect rejects off-site and malformed targets', () => {
+  const bad = [
+    '//evil.com/account',
+    '/\\evil.com/account',
+    '\\\\evil.com',
+    'https://evil.com/?next=https://www.thedailygrind.com',
+    'https://thedailygrind.com.evil.com/',
+    'https://evilthedailygrind.com/',
+    'https://thedailygrind.com@evil.com/',
+    'https://user:pw@www.thedailygrind.com/',
+    'http://www.thedailygrind.com/',           // downgrade from an https page
+    'javascript:alert(1)',
+    'data:text/html,<script>alert(1)</script>',
+    'vbscript:msgbox',
+    'ftp://www.thedailygrind.com/',
+    '',
+    null,
+    undefined,
+    42,
+    { href: '/account' }
+  ];
+  for (const input of bad) {
+    assert.equal(guard.toSafeRedirect(input, PROD), null, `should reject ${JSON.stringify(input)}`);
+    assert.equal(guard.toSafeRedirect(input, Object.assign({ fallback: '/account' }, PROD)), '/account');
+  }
+});
+
+test('toSafeRedirect allows the exact current host during local development', () => {
+  assert.equal(guard.toSafeRedirect('/rewards', DEV), 'http://localhost:11222/rewards');
+  assert.equal(guard.toSafeRedirect('http://localhost:11222/menu', DEV), 'http://localhost:11222/menu');
+  assert.equal(guard.toSafeRedirect('http://localhost:9999/menu', DEV), null);
+  assert.equal(guard.toSafeRedirect('http://localhost.evil.com/', DEV), null);
+  assert.equal(guard.toSafeRedirect('https://menu.thedailygrind.com/', DEV), 'https://menu.thedailygrind.com/');
+});
+
+test('classifyLink distinguishes same-site, external, contact and blocked', () => {
+  assert.equal(guard.classifyLink('/menu', PROD), 'same-site');
+  assert.equal(guard.classifyLink('https://menu.thedailygrind.com/espresso', PROD), 'same-site');
+  assert.equal(guard.classifyLink('https://www.instagram.com/thedailygrind', PROD), 'external');
+  assert.equal(guard.classifyLink('https://thedailygrind.com.evil.com/', PROD), 'external');
+  assert.equal(guard.classifyLink('//cdn.example.com/x', PROD), 'external');
+  assert.equal(guard.classifyLink('mailto:hello@thedailygrind.com', PROD), 'contact');
+  assert.equal(guard.classifyLink('tel:+15555550100', PROD), 'contact');
+  assert.equal(guard.classifyLink('javascript:void(0)', PROD), 'blocked');
+  assert.equal(guard.classifyLink('data:text/html,hi', PROD), 'blocked');
+  assert.equal(guard.classifyLink('', PROD), 'blocked');
+});
+
+test('widget gate pins the expected frame on init and rejects every other sender', () => {
+  const widgetWindow = { name: 'brew-widget' };
+  const otherSandboxedWindow = { name: 'promo' };
+  const gate = guard.createWidgetGate(() => widgetWindow);
+  const msg = (source, data, origin = 'null') => ({ origin, source, data });
+
+  // Nothing is accepted before init, not even from the right frame.
+  assert.equal(gate.accept(msg(widgetWindow, { type: 'widget:tick', seconds: 10 })), false);
+  assert.equal(gate.isPinned(), false);
+
+  // Another sandboxed frame cannot claim the widget slot first.
+  assert.equal(gate.accept(msg(otherSandboxedWindow, { type: 'widget:init' })), false);
+  assert.equal(gate.isPinned(), false);
+
+  // Malformed init does not pin.
+  assert.equal(gate.accept(msg(widgetWindow, 'widget:init')), false);
+  assert.equal(gate.accept(msg(widgetWindow, null)), false);
+  assert.equal(gate.isPinned(), false);
+
+  // Init from the expected frame pins it.
+  assert.equal(gate.accept(msg(widgetWindow, { type: 'widget:init' })), true);
+  assert.equal(gate.isPinned(), true);
+
+  // Subsequent messages from the pinned frame are accepted...
+  assert.equal(gate.accept(msg(widgetWindow, { type: 'widget:tick', seconds: 9 })), true);
+  assert.equal(gate.accept(msg(widgetWindow, { type: 'widget:init' })), true);
+
+  // ...and the same messages from any other sandboxed frame are rejected.
+  assert.equal(gate.accept(msg(otherSandboxedWindow, { type: 'widget:tick', seconds: 9 })), false);
+  assert.equal(gate.accept(msg(otherSandboxedWindow, { type: 'widget:init' })), false);
+
+  // Reset drops the pin.
+  gate.reset();
+  assert.equal(gate.isPinned(), false);
+  assert.equal(gate.accept(msg(widgetWindow, { type: 'widget:tick' })), false);
+});
+
+test('widget gate only considers opaque-origin senders', () => {
+  const widgetWindow = {};
+  const gate = guard.createWidgetGate(() => widgetWindow);
+  assert.equal(gate.accept({ origin: 'https://evil.com', source: widgetWindow, data: { type: 'widget:init' } }), false);
+  assert.equal(gate.accept({ origin: 'https://www.thedailygrind.com', source: widgetWindow, data: { type: 'widget:init' } }), false);
+  assert.equal(gate.accept({ origin: 'null', source: null, data: { type: 'widget:init' } }), false);
+  assert.equal(gate.accept(undefined), false);
+  // The frame may not have loaded yet (contentWindow is null): nothing pins.
+  const lazy = guard.createWidgetGate(() => null);
+  assert.equal(lazy.accept({ origin: 'null', source: {}, data: { type: 'widget:init' } }), false);
+  assert.equal(lazy.isPinned(), false);
+});
