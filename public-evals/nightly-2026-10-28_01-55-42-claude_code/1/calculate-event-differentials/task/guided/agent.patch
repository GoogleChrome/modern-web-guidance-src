+  <script type="module">
+    // Temporal is not yet available in every browser (Safari in particular),
+    // so feature-detect it and load the polyfill only when needed.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const timer = document.querySelector('.promo-timer');
+    const remainingEl = timer.querySelector('.promo-remaining');
+    const elapsedEl = timer.querySelector('.promo-elapsed');
+
+    // All math happens in the visitor's own time zone, so "midnight" is their
+    // local midnight and DST shifts inside the window are accounted for.
+    const timeZone = Temporal.Now.timeZoneId();
+    const now = Temporal.Now.zonedDateTimeISO(timeZone);
+    // PlainDate -> ZonedDateTime with no time resolves to the start of that day
+    // (even if local midnight is skipped by a DST change).
+    const start = Temporal.PlainDate.from(timer.dataset.promoStart).toZonedDateTime(timeZone);
+    const end = Temporal.PlainDate.from(timer.dataset.promoEnd).toZonedDateTime(timeZone);
+
+    // Balance into whole days + hours; truncate so we never show a full hour
+    // that has not actually been reached yet.
+    const daysAndHours = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' };
+
+    function formatDuration(duration) {
+      if (duration.blank) return 'less than an hour';
+      if ('DurationFormat' in Intl) {
+        return duration.toLocaleString(undefined, { style: 'long' });
+      }
+      // Minimal fallback for browsers without Intl.DurationFormat.
+      const parts = [];
+      if (duration.days) parts.push(`${duration.days} day${duration.days === 1 ? '' : 's'}`);
+      if (duration.hours) parts.push(`${duration.hours} hour${duration.hours === 1 ? '' : 's'}`);
+      return parts.join(', ');
+    }
+
+    function durationNode(duration) {
+      const time = document.createElement('time');
+      time.dateTime = duration.toString(); // ISO 8601, e.g. P12DT5H
+      time.textContent = formatDuration(duration);
+      return time;
+    }
+
+    function dateNode(zdt) {
+      const time = document.createElement('time');
+      time.dateTime = zdt.toPlainDate().toString();
+      time.textContent = zdt.toLocaleString(undefined, { dateStyle: 'long' });
+      return time;
+    }
+
+    if (Temporal.ZonedDateTime.compare(now, start) < 0) {
+      timer.dataset.state = 'upcoming';
+      remainingEl.replaceChildren('Coming ', dateNode(start), '. Starts in ', durationNode(now.until(start, daysAndHours)), '.');
+      elapsedEl.hidden = true;
+    } else if (Temporal.ZonedDateTime.compare(now, end) >= 0) {
+      timer.dataset.state = 'ended';
+      remainingEl.replaceChildren('This offer ended ', dateNode(end), '.');
+      elapsedEl.replaceChildren('The promotion ran for ', durationNode(start.until(end, daysAndHours)), '.');
+      elapsedEl.hidden = false;
+    } else {
+      timer.dataset.state = 'active';
+      remainingEl.replaceChildren('Offer ends in ', durationNode(now.until(end, daysAndHours)), ' (', dateNode(end), ').');
+      elapsedEl.replaceChildren('Running for ', durationNode(now.since(start, daysAndHours)), ' so far.');
+      elapsedEl.hidden = false;
+    }
+  </script>
+
