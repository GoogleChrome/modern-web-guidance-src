+  <script>
+    (function () {
+      var KEY = 'color-scheme';
+      var meta = document.querySelector('meta[name="color-scheme"]');
+      var toggle = document.getElementById('theme-toggle');
+      var systemDark = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function systemScheme() {
+        return systemDark.matches ? 'dark' : 'light';
+      }
+
+      // The scheme the user currently sees: the override if set, else the system preference.
+      function renderedScheme() {
+        var c = meta.content;
+        return (c === 'light' || c === 'dark') ? c : systemScheme();
+      }
+
+      function applyStored(value) {
+        meta.content = (value === 'light' || value === 'dark') ? value : 'light dark';
+      }
+
+      toggle.addEventListener('click', function () {
+        var target = renderedScheme() === 'dark' ? 'light' : 'dark';
+        var pin = target !== systemScheme();
+
+        // Only pin a scheme when it diverges from the system; otherwise return to "system".
+        try {
+          if (pin) {
+            localStorage.setItem(KEY, target);
+          } else {
+            localStorage.removeItem(KEY);
+          }
+        } catch (e) { /* storage unavailable: still apply for this page */ }
+
+        meta.content = pin ? target : 'light dark';
+      });
+
+      // Keep in sync when the override changes in another tab.
+      window.addEventListener('storage', function (e) {
+        if (e.key === KEY || e.key === null) {
+          applyStored(e.newValue);
+        }
+      });
+    })();
+  </script>
+
