+import { useEffect, useRef, useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStory {
+  id: string;
+  title: string;
+  href: string;
+  /** Pre-formatted on the server so markup matches between SSR and hydration. */
+  date: string;
+}
+
+interface Props {
+  stories: TopStory[];
+}
+
+type Direction = 'next' | 'prev';
+
+interface OutgoingSlide {
+  index: number;
+  direction: Direction;
+  /** Monotonic id so React remounts the element (and restarts its animation) on every move. */
+  key: number;
+}
+
+const ANIMATION_MS = 300;
+
+function usePrefersReducedMotion() {
+  const [reduced, setReduced] = useState(false);
+
+  useEffect(() => {
+    const mql = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const update = () => setReduced(mql.matches);
+    update();
+    mql.addEventListener('change', update);
+    return () => mql.removeEventListener('change', update);
+  }, []);
+
+  return reduced;
+}
+
+function Slide({ story }: { story: TopStory }) {
+  return (
+    <>
+      <a href={story.href} className="block">
+        <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{story.title}</h3>
+      </a>
+      <span className="text-xs text-gray-500">{story.date}</span>
+    </>
+  );
+}
+
+export default function TopStoriesSlider({ stories }: Props) {
+  const [current, setCurrent] = useState(0);
+  const [direction, setDirection] = useState<Direction | null>(null);
+  const [outgoing, setOutgoing] = useState<OutgoingSlide | null>(null);
+  const moveCount = useRef(0);
+  const reducedMotion = usePrefersReducedMotion();
+  const count = stories.length;
+
+  // Safety net: if `animationend` never fires (e.g. the tab is hidden), still drop the outgoing slide.
+  useEffect(() => {
+    if (!outgoing) return;
+    const timer = window.setTimeout(() => setOutgoing(null), ANIMATION_MS + 100);
+    return () => window.clearTimeout(timer);
+  }, [outgoing]);
+
+  if (count === 0) return null;
+
+  const go = (dir: Direction) => {
+    const next = dir === 'next' ? (current + 1) % count : (current - 1 + count) % count;
+    if (next === current) return;
+
+    moveCount.current += 1;
+    setDirection(dir);
+    // With reduced motion there is no exit animation, so never render the outgoing slide.
+    setOutgoing(reducedMotion ? null : { index: current, direction: dir, key: moveCount.current });
+    setCurrent(next);
+  };
+
+  const enterClass =
+    direction === null || reducedMotion
+      ? ''
+      : direction === 'next'
+        ? 'motion-safe:animate-slide-in-from-right'
+        : 'motion-safe:animate-slide-in-from-left';
+
+  const exitClass =
+    outgoing?.direction === 'next'
+      ? 'motion-safe:animate-slide-out-to-left'
+      : 'motion-safe:animate-slide-out-to-right';
+
+  const story = stories[current];
+
+  return (
+    <div
+      role="region"
+      aria-roledescription="carousel"
+      aria-label="Top stories"
+      className="flex items-center gap-3 sm:gap-4"
+    >
+      <button
+        type="button"
+        onClick={() => go('prev')}
+        aria-label="Previous story"
+        disabled={count < 2}
+        className="shrink-0 rounded-full border border-gray-300 p-1.5 text-gray-700 hover:border-amber-400 hover:text-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 disabled:opacity-40 disabled:hover:border-gray-300 disabled:hover:text-gray-700 transition-colors"
+      >
+        <ChevronLeftIcon className="h-5 w-5" aria-hidden="true" />
+      </button>
+
+      <div className="relative flex-1 min-w-0 overflow-hidden" aria-live="polite" aria-atomic="true">
+        {outgoing && (
+          <div
+            key={`out-${outgoing.key}`}
+            aria-hidden="true"
+            onAnimationEnd={() => setOutgoing(null)}
+            className={`pointer-events-none absolute inset-0 ${exitClass}`}
+          >
+            <Slide story={stories[outgoing.index]} />
+          </div>
+        )}
+        <div
+          key={`in-${current}-${moveCount.current}`}
+          role="group"
+          aria-roledescription="slide"
+          aria-label={`${current + 1} of ${count}`}
+          className={enterClass}
+        >
+          <Slide story={story} />
+        </div>
+      </div>
+
+      <span className="shrink-0 text-xs tabular-nums text-gray-500" aria-hidden="true">
+        {current + 1} / {count}
+      </span>
+
+      <button
+        type="button"
+        onClick={() => go('next')}
+        aria-label="Next story"
+        disabled={count < 2}
+        className="shrink-0 rounded-full border border-gray-300 p-1.5 text-gray-700 hover:border-amber-400 hover:text-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 disabled:opacity-40 disabled:hover:border-gray-300 disabled:hover:text-gray-700 transition-colors"
+      >
+        <ChevronRightIcon className="h-5 w-5" aria-hidden="true" />
+      </button>
+    </div>
+  );
+}
