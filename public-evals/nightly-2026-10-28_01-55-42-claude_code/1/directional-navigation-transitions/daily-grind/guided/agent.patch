+  <script>
+    (function () {
+      const carousel = document.querySelector('.carousel');
+      const slides = Array.from(carousel.querySelectorAll('.carousel-slide'));
+      const status = carousel.querySelector('.carousel-status');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let current = slides.findIndex((slide) => !slide.hidden);
+
+      function show(index) {
+        slides[current].hidden = true;
+        current = (index + slides.length) % slides.length;
+        slides[current].hidden = false;
+        status.textContent = (current + 1) + ' of ' + slides.length;
+      }
+
+      // Swap the visible slide, sliding it in from the direction of travel.
+      // 'forward' (Next) enters from the right; 'backward' (Previous) from the left.
+      function navigate(index, direction) {
+        const update = () => show(index);
+
+        // No animation for browsers without View Transitions, or for users
+        // who prefer reduced motion: just swap the content immediately.
+        if (!document.startViewTransition || reducedMotion.matches) {
+          update();
+          return;
+        }
+
+        try {
+          document.startViewTransition({ update, types: [direction] });
+        } catch (err) {
+          // Older implementations only accept a bare callback; still swap the slide.
+          update();
+        }
+      }
+
+      carousel.querySelector('[data-carousel-prev]').addEventListener('click', () => {
+        navigate(current - 1, 'backward');
+      });
+
+      carousel.querySelector('[data-carousel-next]').addEventListener('click', () => {
+        navigate(current + 1, 'forward');
+      });
+    })();
+  </script>
