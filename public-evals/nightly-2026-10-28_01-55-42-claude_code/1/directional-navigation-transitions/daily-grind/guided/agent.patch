+      view-transition-name: seasonal-card;
+    }
+
+    .carousel-slide[hidden] {
+      display: none;
+    }
+
+    .carousel-controls {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 12px;
+      margin-top: 15px;
+    }
+
+    .carousel-btn {
+      font: inherit;
+      cursor: pointer;
+      background: var(--primary);
+      color: white;
+      border: 0;
+      padding: 10px 20px;
+      border-radius: 5px;
+      transition: background 0.3s;
+    }
+
+    .carousel-btn:hover {
+      background: #3e2723;
+    }
+
+    .carousel-btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-status {
+      font-size: 0.9rem;
+    }
+
+    /* Directional slide animations (performant: transform only) */
+    @keyframes slide-to-left {
+      to { transform: translateX(-100%); }
+    }
+
+    @keyframes slide-from-right {
+      from { transform: translateX(100%); }
+    }
+
+    @keyframes slide-to-right {
+      to { transform: translateX(100%); }
+    }
+
+    @keyframes slide-from-left {
+      from { transform: translateX(-100%); }
+    }
+
+    ::view-transition-group(seasonal-card) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+    }
+
+    /* Clip the sliding snapshots to the card's box so they don't
+       sweep across the rest of the page. */
+    ::view-transition-image-pair(seasonal-card) {
+      overflow: clip;
+    }
+
+    ::view-transition-old(seasonal-card),
+    ::view-transition-new(seasonal-card) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+      animation-fill-mode: both;
+    }
+
+    /* Next: new card enters from the right, old one leaves to the left */
+    html:active-view-transition-type(forward)::view-transition-old(seasonal-card) {
+      animation-name: slide-to-left;
+    }
+
+    html:active-view-transition-type(forward)::view-transition-new(seasonal-card) {
+      animation-name: slide-from-right;
+    }
+
+    /* Previous: new card enters from the left, old one leaves to the right */
+    html:active-view-transition-type(backward)::view-transition-old(seasonal-card) {
+      animation-name: slide-to-right;
+    }
+
+    html:active-view-transition-type(backward)::view-transition-new(seasonal-card) {
+      animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(seasonal-card),
+      ::view-transition-old(seasonal-card),
+      ::view-transition-new(seasonal-card) {
+        animation: none !important;
+      }
     }
 
