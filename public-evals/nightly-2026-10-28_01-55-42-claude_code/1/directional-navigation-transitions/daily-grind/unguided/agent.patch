+  <script>
+    (function () {
+      var carousel = document.getElementById('seasonal-carousel');
+      var slides = carousel.querySelectorAll('.card');
+      var status = carousel.querySelector('.carousel-status');
+      var buttons = carousel.querySelectorAll('.carousel-btn');
+      var current = 0;
+
+      function show(nextIndex, direction) {
+        var outgoing = slides[current];
+        var incoming = slides[nextIndex];
+
+        outgoing.hidden = true;
+        incoming.classList.remove('slide-from-right', 'slide-from-left');
+        incoming.hidden = false;
+        // Force a reflow so the animation restarts even if the same class is re-applied.
+        void incoming.offsetWidth;
+        incoming.classList.add(direction > 0 ? 'slide-from-right' : 'slide-from-left');
+
+        current = nextIndex;
+        status.textContent = (current + 1) + ' / ' + slides.length;
+      }
+
+      Array.prototype.forEach.call(buttons, function (button) {
+        button.addEventListener('click', function () {
+          var direction = Number(button.getAttribute('data-dir'));
+          var nextIndex = (current + direction + slides.length) % slides.length;
+          show(nextIndex, direction);
+        });
+      });
+
+      Array.prototype.forEach.call(slides, function (slide) {
+        slide.addEventListener('animationend', function () {
+          slide.classList.remove('slide-from-right', 'slide-from-left');
+        });
+      });
+    })();
+  </script>
