+++ b/app.js
@@ -0,0 +1,362 @@
+/*
+ * The Daily Grind – client-side views.
+ *
+ * Routing is hash based (#/menu, #/locations/…) so it works from a plain
+ * static file server with no rewrite rules and gets back/forward for free.
+ *
+ * View switching strategy:
+ *   - Home is server-rendered in index.html.
+ *   - Every other view is mounted from its <template> the first time it is
+ *     visited and then kept in the DOM permanently.
+ *   - Inactive views get `content-visibility: hidden` (see index.html CSS),
+ *     which skips their layout/paint but keeps the rendered state cached, so
+ *     switching back is near-instant and all in-view state (filters, typed
+ *     text, counters, scroll position) survives.
+ *
+ * With a fixed set of five views the memory cost of keeping them all mounted
+ * is negligible; if views ever become dynamic/unbounded an eviction policy
+ * (e.g. LRU) should be added to `mounted`.
+ */
+
+const BRAND = 'The Daily Grind';
+
+const VIEWS = {
+  home: { title: `${BRAND} | Artisanal Coffee` },
+  menu: { title: `Menu | ${BRAND}`, template: 'tpl-menu', init: initMenu },
+  locations: { title: `Locations | ${BRAND}`, template: 'tpl-locations', init: initLocations },
+  rewards: { title: `Rewards | ${BRAND}`, template: 'tpl-rewards', init: initRewards },
+  account: { title: `My Account | ${BRAND}`, template: 'tpl-account', init: initAccount },
+};
+
+const DEFAULT_VIEW = 'home';
+
+/* ------------------------------------------------------------------ */
+/* Router                                                              */
+/* ------------------------------------------------------------------ */
+
+const sections = new Map(
+  [...document.querySelectorAll('.spa-view')].map((el) => [el.dataset.view, el]),
+);
+const navLinks = [...document.querySelectorAll('[data-nav]')];
+
+/** name -> controller returned by the view's init(). Presence == mounted. */
+const mounted = new Map();
+/** name -> window.scrollY when the user last left that view. */
+const scrollPositions = new Map();
+
+let currentView = null;
+
+function parseHash(hash = location.hash) {
+  // "#/menu/seasonal" -> { name: "menu", params: ["seasonal"] }
+  const parts = hash.replace(/^#\/?/, '').split('/').filter(Boolean);
+  const [name = DEFAULT_VIEW, ...params] = parts;
+  return VIEWS[name] ? { name, params } : { name: DEFAULT_VIEW, params: [] };
+}
+
+function ensureMounted(name) {
+  if (mounted.has(name)) return mounted.get(name);
+
+  const section = sections.get(name);
+  const def = VIEWS[name];
+  if (def.template) {
+    const template = document.getElementById(def.template);
+    section.append(template.content.cloneNode(true));
+  }
+  const controller = def.init ? def.init(section) : {};
+  mounted.set(name, controller);
+  return controller;
+}
+
+function setActive(name) {
+  for (const [viewName, section] of sections) {
+    const active = viewName === name;
+    section.classList.toggle('is-active', active);
+    section.setAttribute('aria-hidden', String(!active));
+    section.toggleAttribute('inert', !active);
+  }
+  for (const link of navLinks) {
+    if (link.dataset.nav === name) link.setAttribute('aria-current', 'page');
+    else link.removeAttribute('aria-current');
+  }
+  document.title = VIEWS[name].title;
+}
+
+function navigate({ moveFocus }) {
+  const { name, params } = parseHash();
+  const switching = name !== currentView;
+
+  performance.mark(`view:${name}:start`);
+
+  if (switching && currentView) scrollPositions.set(currentView, window.scrollY);
+
+  const controller = ensureMounted(name);
+  setActive(name);
+  controller.update?.(params);
+
+  if (switching) {
+    // Restore where the user left off in this view (0 for a first visit).
+    window.scrollTo({ top: scrollPositions.get(name) ?? 0, behavior: 'instant' });
+    if (moveFocus) sections.get(name).focus({ preventScroll: true });
+  }
+
+  currentView = name;
+  performance.measure(`view:${name}`, `view:${name}:start`);
+}
+
+// We handle scroll position per view ourselves.
+if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+window.addEventListener('hashchange', () => navigate({ moveFocus: true }));
+navigate({ moveFocus: false });
+
+/* ------------------------------------------------------------------ */
+/* Helpers                                                             */
+/* ------------------------------------------------------------------ */
+
+const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+function img(id, width = 600) {
+  return `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${width}&q=70`;
+}
+
+function el(tag, attrs = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [key, value] of Object.entries(attrs)) {
+    if (key === 'class') node.className = value;
+    else if (key === 'dataset') Object.assign(node.dataset, value);
+    else if (key.startsWith('on')) node.addEventListener(key.slice(2), value);
+    else node.setAttribute(key, value);
+  }
+  node.append(...children);
+  return node;
+}
+
+/* ------------------------------------------------------------------ */
+/* Menu                                                                */
+/* ------------------------------------------------------------------ */
+
+const MENU_ITEMS = [
+  { id: 'maple-oat-latte', name: 'Maple Oat Latte', category: 'seasonal', price: 5.75, photo: '1541167760496-1628856ab772', blurb: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+  { id: 'spiced-cortado', name: 'Spiced Cortado', category: 'seasonal', price: 4.95, photo: '1509042239860-f550ce710b93', blurb: 'A double ristretto cut with warm cinnamon milk.' },
+  { id: 'dark-roast-espresso', name: 'Dark Roast Espresso', category: 'espresso', price: 3.25, photo: '1461023058943-07fcbe16d735', blurb: 'Bold, smokey, and perfect for a morning boost.' },
+  { id: 'cappuccino', name: 'Cappuccino', category: 'espresso', price: 4.25, photo: '1511920170033-f8396924c348', blurb: 'Equal parts espresso, steamed milk, and velvety foam.' },
+  { id: 'flat-white', name: 'Flat White', category: 'espresso', price: 4.5, photo: '1514432324607-a09d9b4aefdd', blurb: 'Silky microfoam over two shots of our house blend.' },
+  { id: 'cold-brew', name: 'Cold Brew', category: 'cold-brew', price: 4.75, photo: '1517487881594-2787fef5ebf7', blurb: 'Steeped for 18 hours for maximum smoothness.' },
+  { id: 'nitro-cold-brew', name: 'Nitro Cold Brew', category: 'cold-brew', price: 5.25, photo: '1497935586351-b67a49e012bf', blurb: 'Nitrogen-infused for a cascading, creamy pour.' },
+  { id: 'butter-croissant', name: 'Butter Croissant', category: 'pastries', price: 3.5, photo: '1555507036-ab1f4038808a', blurb: 'Laminated by hand with cultured French butter.' },
+  { id: 'morning-bun', name: 'Cardamom Morning Bun', category: 'pastries', price: 3.75, photo: '1559925393-8be0ec4767c8', blurb: 'Sticky, citrusy, and dusted with cardamom sugar.' },
+];
+
+function initMenu(root) {
+  const chips = [...root.querySelectorAll('.chip')];
+  const categories = new Set(chips.map((c) => c.dataset.category));
+  const grid = root.querySelector('[data-items]');
+  const summary = root.querySelector('[data-order-summary]');
+
+  const quantities = new Map();
+  const cards = new Map();
+  let category = 'all';
+
+  for (const item of MENU_ITEMS) {
+    const count = el('output', { 'aria-label': `${item.name} quantity` }, '0');
+    const card = el(
+      'article',
+      { class: 'item-card', dataset: { category: item.category } },
+      el('img', { src: img(item.photo), alt: '', loading: 'lazy', width: '600', height: '450' }),
+      el(
+        'div',
+        { class: 'item-body' },
+        el('h3', {}, el('span', {}, item.name), el('span', {}, money.format(item.price))),
+        el('p', {}, item.blurb),
+        el(
+          'div',
+          { class: 'stepper' },
+          el('button', { type: 'button', 'aria-label': `Remove one ${item.name}`, onclick: () => adjust(item, -1) }, '−'),
+          count,
+          el('button', { type: 'button', 'aria-label': `Add one ${item.name}`, onclick: () => adjust(item, 1) }, '+'),
+        ),
+      ),
+    );
+    cards.set(item.id, { card, count });
+    grid.append(card);
+  }
+
+  function adjust(item, delta) {
+    const next = Math.max(0, (quantities.get(item.id) ?? 0) + delta);
+    quantities.set(item.id, next);
+    cards.get(item.id).count.textContent = String(next);
+    renderSummary();
+  }
+
+  function renderSummary() {
+    let items = 0;
+    let total = 0;
+    for (const item of MENU_ITEMS) {
+      const qty = quantities.get(item.id) ?? 0;
+      items += qty;
+      total += qty * item.price;
+    }
+    summary.textContent = items
+      ? `Your order: ${items} item${items === 1 ? '' : 's'} · ${money.format(total)}`
+      : 'Your order is empty';
+  }
+
+  function setCategory(next) {
+    category = next;
+    for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.category === next));
+    for (const { card } of cards.values()) {
+      card.hidden = next !== 'all' && card.dataset.category !== next;
+    }
+  }
+
+  for (const chip of chips) {
+    chip.addEventListener('click', () => {
+      setCategory(chip.dataset.category);
+      // Keep the URL shareable without triggering a navigation.
+      const hash = chip.dataset.category === 'all' ? '#/menu' : `#/menu/${chip.dataset.category}`;
+      history.replaceState(null, '', hash);
+    });
+  }
+
+  return {
+    // Only a category present in the URL overrides the user's current filter;
+    // plain "#/menu" leaves whatever they last picked intact.
+    update([requested]) {
+      if (requested && categories.has(requested) && requested !== category) setCategory(requested);
+    },
+  };
+}
+
+/* ------------------------------------------------------------------ */
+/* Locations                                                           */
+/* ------------------------------------------------------------------ */
+
+const LOCATIONS = [
+  { id: 'downtown', name: 'Downtown Roastery', address: '112 Market Street', hours: 'Mon–Fri 6am–7pm · Sat–Sun 7am–6pm', photo: '1554118811-1e0d58224f24' },
+  { id: 'riverside', name: 'Riverside', address: '48 Bank Street', hours: 'Daily 6:30am–6pm', photo: '1501339847302-ac426a4a7cbb' },
+  { id: 'university', name: 'University Commons', address: '9 College Avenue', hours: 'Mon–Fri 6am–9pm · Sat–Sun 8am–8pm', photo: '1445116572660-236099ec97a0' },
+  { id: 'northside', name: 'Northside Kiosk', address: '300 Maple Lane', hours: 'Mon–Fri 6am–3pm', photo: '1453614512568-c4024d13c247' },
+];
+
+function initLocations(root) {
+  const search = root.querySelector('[data-search]');
+  const list = root.querySelector('[data-locations]');
+  const empty = root.querySelector('[data-empty]');
+  const summary = root.querySelector('[data-store-summary]');
+
+  const cards = new Map();
+  let selected = null;
+
+  for (const loc of LOCATIONS) {
+    const button = el('button', { type: 'button', class: 'btn btn-outline', 'aria-pressed': 'false', onclick: () => select(loc.id) }, 'Make this my store');
+    const card = el(
+      'article',
+      { class: 'location-card' },
+      el('img', { src: img(loc.photo, 400), alt: '', loading: 'lazy', width: '400', height: '300' }),
+      el(
+        'div',
+        { class: 'location-body' },
+        el('h3', {}, loc.name),
+        el('address', {}, loc.address),
+        el('p', {}, loc.hours),
+        button,
+      ),
+    );
+    cards.set(loc.id, { card, button, loc });
+    list.append(card);
+  }
+
+  function select(id) {
+    selected = id;
+    for (const { card, button, loc } of cards.values()) {
+      const isSelected = loc.id === id;
+      card.classList.toggle('is-selected', isSelected);
+      button.textContent = isSelected ? 'Your store' : 'Make this my store';
+      button.setAttribute('aria-pressed', String(isSelected));
+    }
+    summary.textContent = `Your store: ${cards.get(id).loc.name}`;
+  }
+
+  function filter() {
+    const query = search.value.trim().toLowerCase();
+    let visible = 0;
+    for (const { card, loc } of cards.values()) {
+      const match = !query || `${loc.name} ${loc.address}`.toLowerCase().includes(query);
+      card.hidden = !match;
+      if (match) visible++;
+    }
+    empty.hidden = visible > 0;
+  }
+
+  search.addEventListener('input', filter);
+
+  return {
+    update([requested]) {
+      if (requested && cards.has(requested) && requested !== selected) select(requested);
+    },
+  };
+}
+
+/* ------------------------------------------------------------------ */
+/* Rewards                                                             */
+/* ------------------------------------------------------------------ */
+
+const TIER_SIZE = 500;
+
+function initRewards(root) {
+  const pointsEl = root.querySelector('[data-points]');
+  const tierLabel = root.querySelector('[data-tier-label]');
+  const progress = root.querySelector('[data-progress]');
+  const rewards = [...root.querySelectorAll('.reward')];
+
+  let points = Number(pointsEl.textContent);
+
+  function render() {
+    pointsEl.textContent = String(points);
+    const remaining = TIER_SIZE - (points % TIER_SIZE);
+    progress.value = points % TIER_SIZE;
+    tierLabel.textContent = `${remaining} points to the next tier`;
+    for (const reward of rewards) {
+      if (reward.classList.contains('is-redeemed')) continue;
+      reward.querySelector('button').disabled = Number(reward.dataset.cost) > points;
+    }
+  }
+
+  for (const reward of rewards) {
+    const button = reward.querySelector('button');
+    button.addEventListener('click', () => {
+      const cost = Number(reward.dataset.cost);
+      if (cost > points) return;
+      points -= cost;
+      reward.classList.add('is-redeemed');
+      button.disabled = true;
+      button.textContent = 'Redeemed';
+      render();
+    });
+  }
+
+  render();
+  return {};
+}
+
+/* ------------------------------------------------------------------ */
+/* Account                                                             */
+/* ------------------------------------------------------------------ */
+
+function initAccount(root) {
+  const form = root.querySelector('[data-account-form]');
+  const status = root.querySelector('[data-status]');
+  const time = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' });
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    if (!form.reportValidity()) return;
+    status.textContent = `Saved at ${time.format(new Date())}`;
+  });
+
+  form.addEventListener('input', () => {
+    status.textContent = 'Unsaved changes';
+  });
+
+  return {};
+}
