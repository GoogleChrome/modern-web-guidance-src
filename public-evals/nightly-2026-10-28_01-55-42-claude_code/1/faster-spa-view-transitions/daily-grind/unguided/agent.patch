+      category: 'pastries',
+      price: 3.25,
+      description: 'Bursting with wild blueberries and a crunchy sugar top.',
+      image: 'https://images.unsplash.com/photo-1607958996333-41aef7caefaa',
+    },
+  ];
+
+  const LOCATIONS = [
+    {
+      name: 'Downtown Roastery',
+      address: '112 Market Street',
+      city: 'Portland, OR 97209',
+      hours: 'Mon–Fri 6am–7pm · Sat–Sun 7am–6pm',
+      features: ['Roastery tours', 'Mobile ordering', 'Patio'],
+    },
+    {
+      name: 'Pearl District',
+      address: '840 NW Lovejoy Street',
+      city: 'Portland, OR 97209',
+      hours: 'Daily 6:30am–6pm',
+      features: ['Mobile ordering', 'Drive-thru'],
+    },
+    {
+      name: 'Hawthorne',
+      address: '3521 SE Hawthorne Boulevard',
+      city: 'Portland, OR 97214',
+      hours: 'Daily 7am–8pm',
+      features: ['Mobile ordering', 'Live music Fridays'],
+    },
+    {
+      name: 'Capitol Hill',
+      address: '1501 E Pine Street',
+      city: 'Seattle, WA 98122',
+      hours: 'Mon–Fri 6am–6pm · Sat–Sun 7am–5pm',
+      features: ['Mobile ordering', 'Patio'],
+    },
+    {
+      name: 'Fremont',
+      address: '3401 Fremont Avenue N',
+      city: 'Seattle, WA 98103',
+      hours: 'Daily 6:30am–7pm',
+      features: ['Drive-thru', 'Dog friendly'],
+    },
+    {
+      name: 'Mission District',
+      address: '2890 24th Street',
+      city: 'San Francisco, CA 94110',
+      hours: 'Daily 7am–6pm',
+      features: ['Mobile ordering', 'Cupping classes'],
+    },
+  ];
+
+  const REWARD_OPTIONS = [
+    { name: 'Free Pastry', cost: 100, description: 'Any pastry from the case.' },
+    { name: 'Free Drink', cost: 150, description: 'Any handcrafted drink, any size.' },
+    { name: 'Bag of Beans', cost: 300, description: '12 oz of our house roast to take home.' },
+    { name: 'Cupping Class', cost: 500, description: 'A seat at our monthly tasting class.' },
+  ];
+
+  // ---------------------------------------------------------------------------
+  // Views
+  //
+  // Each factory is called at most once and returns:
+  //   { el: HTMLElement, title: string, onShow?(params: string[]), onHide?() }
+  // ---------------------------------------------------------------------------
+
+  function viewHeader(title, subtitle) {
+    return h('header', { class: 'view-header' },
+      h('h1', { tabindex: -1 }, title),
+      subtitle && h('p', null, subtitle),
+    );
+  }
+
+  /** Home view: already in the HTML, so just adopt the existing element. */
+  function createHomeView() {
+    return {
+      el: document.querySelector('#app [data-view="home"]'),
+      title: 'The Daily Grind | Artisanal Coffee',
+    };
+  }
+
+  /** Menu view with category filter tabs. Supports #/menu/<category>. */
+  function createMenuView() {
+    let activeCategory = 'all';
+
+    const tabButtons = new Map();
+    const cards = MENU_ITEMS.map((item) =>
+      h('article', { class: 'card', 'data-category': item.category },
+        img(item.image, item.name),
+        h('span', { class: 'tag' }, MENU_CATEGORIES.find((c) => c.id === item.category).label),
+        h('h3', null, item.name),
+        h('p', null, item.description),
+        h('span', { class: 'price' }, formatMoney(item.price)),
+      ),
+    );
+
+    const grid = h('div', { class: 'grid' }, cards);
+    const emptyState = h('p', { class: 'empty-state', hidden: true }, 'Nothing in this category right now.');
+    const liveRegion = h('p', { class: 'sr-only', 'aria-live': 'polite' });
+
+    const tabs = h('div', { class: 'tabs', role: 'tablist', 'aria-label': 'Menu categories' },
+      MENU_CATEGORIES.map((cat) => {
+        const btn = h('button', {
+          type: 'button',
+          class: 'tab',
+          role: 'tab',
+          'aria-selected': 'false',
+          onclick: () => setCategory(cat.id),
+        }, cat.label);
+        tabButtons.set(cat.id, btn);
+        return btn;
+      }),
+    );
+
+    function setCategory(id) {
+      if (!tabButtons.has(id)) id = 'all';
+      activeCategory = id;
+      let visible = 0;
+      for (const card of cards) {
+        const show = id === 'all' || card.dataset.category === id;
+        card.hidden = !show;
+        if (show) visible++;
+      }
+      emptyState.hidden = visible > 0;
+      for (const [catId, btn] of tabButtons) {
+        btn.setAttribute('aria-selected', String(catId === id));
+      }
+      liveRegion.textContent = `Showing ${visible} item${visible === 1 ? '' : 's'}.`;
+    }
+
+    setCategory('all');
+
+    const el = h('div', null,
+      viewHeader('Our Menu', 'Roasted in small batches. Poured with care.'),
+      h('main', { class: 'container' },
+        tabs,
+        liveRegion,
+        grid,
+        emptyState,
+      ),
+    );
+
+    return {
+      el,
+      title: 'Menu | The Daily Grind',
+      onShow(params) {
+        // Only a deep link (#/menu/seasonal) changes the filter; a plain
+        // #/menu keeps whatever the user last selected.
+        if (params[0] && params[0] !== activeCategory) setCategory(params[0]);
+      },
+    };
+  }
+
+  /** Locations view with a live search box and a "my store" selection. */
+  function createLocationsView() {
+    let selectedName = null;
+
+    const items = LOCATIONS.map((loc) => {
+      const selectBtn = h('button', { type: 'button', class: 'btn btn-secondary' }, 'Set as my store');
+      const li = h('li', { class: 'location' },
+        h('h3', null, loc.name),
+        h('address', null, loc.address, h('br'), loc.city),
+        h('p', { class: 'hours' }, loc.hours),
+        h('p', null, loc.features.join(' · ')),
+        selectBtn,
+      );
+      selectBtn.addEventListener('click', () => select(loc.name));
+      return { loc, li, selectBtn, haystack: `${loc.name} ${loc.address} ${loc.city} ${loc.features.join(' ')}`.toLowerCase() };
+    });
+
+    const list = h('ul', { class: 'location-list' }, items.map((i) => i.li));
+    const emptyState = h('p', { class: 'empty-state', hidden: true }, 'No locations match your search.');
+    const resultCount = h('p', { class: 'sr-only', 'aria-live': 'polite' });
+
+    const search = h('input', {
+      type: 'search',
+      id: 'location-search',
+      placeholder: 'City, neighborhood, or feature…',
+      autocomplete: 'off',
+      oninput: () => filter(search.value),
+    });
+
+    function filter(query) {
+      const q = query.trim().toLowerCase();
+      let visible = 0;
+      for (const item of items) {
+        const show = !q || item.haystack.includes(q);
+        item.li.hidden = !show;
+        if (show) visible++;
+      }
+      emptyState.hidden = visible > 0;
+      resultCount.textContent = `${visible} location${visible === 1 ? '' : 's'} found.`;
+    }
+
+    function select(name) {
+      selectedName = name;
+      for (const item of items) {
+        const isSelected = item.loc.name === name;
+        item.li.classList.toggle('selected', isSelected);
+        item.selectBtn.textContent = isSelected ? '✓ My store' : 'Set as my store';
+        item.selectBtn.disabled = isSelected;
+      }
+    }
+
+    filter('');
+
+    const el = h('div', null,
+      viewHeader('Find a Café', 'Six neighborhoods and counting.'),
+      h('main', { class: 'container' },
+        h('div', { class: 'field location-search' },
+          h('label', { for: 'location-search' }, 'Search locations'),
+          search,
+        ),
+        resultCount,
+        list,
+        emptyState,
+      ),
+    );
+
+    return { el, title: 'Locations | The Daily Grind' };
+  }
+
+  /** Rewards view: points balance, redeemable perks and an activity log. */
+  function createRewardsView() {
+    const NEXT_TIER = 500;
+    let points = 340;
+
+    const pointsEl = h('span', { class: 'points' }, String(points));
+    const progressBar = h('div', { class: 'progress-bar' });
+    const progressHint = h('small');
+    const activity = h('ul', { class: 'activity' },
+      activityItem('Oct 26 · Downtown Roastery', '+15', 'gain'),
+      activityItem('Oct 24 · Pearl District', '+12', 'gain'),
+      activityItem('Oct 20 · Redeemed Free Pastry', '-100', 'spend'),
+    );
+
+    function activityItem(label, delta, kind) {
+      return h('li', null, h('span', null, label), h('span', { class: kind }, delta));
+    }
+
+    const rewardButtons = [];
+
+    function render() {
+      pointsEl.textContent = String(points);
+      const pct = Math.min(100, Math.round((points / NEXT_TIER) * 100));
+      progressBar.style.width = pct + '%';
+      progressBar.parentElement.setAttribute('aria-valuenow', String(Math.min(points, NEXT_TIER)));
+      progressHint.textContent = points >= NEXT_TIER
+        ? 'You’ve reached Gold status this month!'
+        : `${NEXT_TIER - points} points to Gold status`;
+      for (const { btn, reward } of rewardButtons) {
+        btn.disabled = points < reward.cost;
+      }
+    }
+
+    function redeem(reward) {
+      if (points < reward.cost) return;
+      points -= reward.cost;
+      activity.prepend(activityItem(`Today · Redeemed ${reward.name}`, `-${reward.cost}`, 'spend'));
+      render();
+    }
+
+    const rewardCards = REWARD_OPTIONS.map((reward) => {
+      const btn = h('button', { type: 'button', class: 'btn', onclick: () => redeem(reward) }, 'Redeem');
+      rewardButtons.push({ btn, reward });
+      return h('article', { class: 'card reward-card' },
+        h('h3', null, reward.name),
+        h('p', null, reward.description),
+        h('p', { class: 'cost' }, `${reward.cost} pts`),
+        btn,
+      );
+    });
+
+    const el = h('div', null,
+      viewHeader('Grind Rewards', 'Every cup gets you closer to the next one.'),
+      h('main', { class: 'container' },
+        h('section', { class: 'points-card' },
+          h('p', null, 'Your balance'),
+          pointsEl,
+          h('p', null, 'points'),
+          h('div', {
+            class: 'progress',
+            role: 'progressbar',
+            'aria-label': 'Progress to Gold status',
+            'aria-valuemin': '0',
+            'aria-valuemax': String(NEXT_TIER),
+          }, progressBar),
+          progressHint,
+        ),
+        h('section', null,
+          h('h2', { style: 'text-align:center' }, 'Redeem your points'),
+          h('div', { class: 'grid' }, rewardCards),
+        ),
+        h('section', null,
+          h('h2', { style: 'text-align:center; margin-top:40px' }, 'Recent activity'),
+          activity,
+        ),
+      ),
+    );
+
+    render();
+
+    return { el, title: 'Rewards | The Daily Grind' };
+  }
+
+  /** Account view: profile form. Unsaved edits survive navigating away. */
+  function createAccountView() {
+    const status = h('p', { class: 'status', role: 'status' });
+
+    function field(labelText, input) {
+      return h('div', { class: 'field' }, h('label', { for: input.id }, labelText), input);
+    }
+
+    const name = h('input', { type: 'text', id: 'acct-name', value: 'Jordan Rivera', autocomplete: 'name' });
+    const email = h('input', { type: 'email', id: 'acct-email', value: 'jordan@example.com', autocomplete: 'email' });
+    const phone = h('input', { type: 'tel', id: 'acct-phone', value: '', placeholder: '(555) 555-0123', autocomplete: 'tel' });
+    const favorite = h('select', { id: 'acct-favorite' },
+      MENU_ITEMS.map((item) => h('option', { value: item.name }, item.name)),
+    );
+    favorite.value = 'Cold Brew';
+    const newsletter = h('input', { type: 'checkbox', id: 'acct-newsletter', checked: true });
+    const smsAlerts = h('input', { type: 'checkbox', id: 'acct-sms' });
+
+    const form = h('form', {
+      class: 'form-card',
+      novalidate: true,
+      onsubmit: (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+        const time = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+        status.textContent = `Changes saved at ${time}.`;
+      },
+      oninput: () => { status.textContent = ''; },
+    },
+      h('h2', { style: 'margin-bottom:20px' }, 'Profile'),
+      field('Full name', name),
+      field('Email', email),
+      field('Phone (optional)', phone),
+      field('Favorite drink', favorite),
+      h('div', { class: 'field field-inline' }, newsletter, h('label', { for: newsletter.id }, 'Send me the weekly newsletter')),
+      h('div', { class: 'field field-inline' }, smsAlerts, h('label', { for: smsAlerts.id }, 'Text me when my mobile order is ready')),
+      h('button', { type: 'submit', class: 'btn' }, 'Save changes'),
+      status,
+    );
+
+    const el = h('div', null,
+      viewHeader('My Account', 'Manage your profile and preferences.'),
+      h('main', { class: 'container' }, form),
+    );
+
+    return { el, title: 'My Account | The Daily Grind' };
+  }
+
+  function createNotFoundView() {
+    const el = h('div', null,
+      viewHeader('Page not found', 'That page seems to have been drunk already.'),
+      h('main', { class: 'container', style: 'text-align:center' },
+        h('a', { href: '#/', class: 'btn' }, 'Back to home'),
+      ),
+    );
+    return { el, title: 'Not Found | The Daily Grind' };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Router
+  // ---------------------------------------------------------------------------
+
+  const VIEW_FACTORIES = {
+    home: createHomeView,
+    menu: createMenuView,
+    locations: createLocationsView,
+    rewards: createRewardsView,
+    account: createAccountView,
+    404: createNotFoundView,
+  };
+
+  const appRoot = document.getElementById('app');
+  const navLinks = Array.from(document.querySelectorAll('nav a[data-route]'));
+
+  /** name -> view instance. Once created, a view is never removed. */
+  const viewCache = new Map();
+  /** name -> last window.scrollY while that view was active. */
+  const scrollPositions = new Map();
+  let currentName = null;
+
+  function parseHash() {
+    const path = location.hash.replace(/^#\/?/, '').split('?')[0];
+    const segments = path.split('/').filter(Boolean).map(decodeURIComponent);
+    const name = segments[0] || 'home';
+    return {
+      name: Object.prototype.hasOwnProperty.call(VIEW_FACTORIES, name) ? name : '404',
+      params: segments.slice(1),
+    };
+  }
+
+  function getOrCreateView(name) {
+    let view = viewCache.get(name);
+    if (!view) {
+      view = VIEW_FACTORIES[name]();
+      view.el.classList.add('view');
+      view.el.dataset.view = name;
+      if (!view.el.isConnected) {
+        view.el.hidden = true;
+        appRoot.appendChild(view.el);
+      }
+      viewCache.set(name, view);
+    }
+    return view;
+  }
+
+  function updateNav(activeName) {
+    for (const link of navLinks) {
+      if (link.dataset.route === activeName) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+  }
+
+  function navigate({ initial = false } = {}) {
+    const { name, params } = parseHash();
+    const next = getOrCreateView(name);
+    const switched = name !== currentName;
+
+    if (switched) {
+      const prev = currentName && viewCache.get(currentName);
+      if (prev) {
+        scrollPositions.set(currentName, window.scrollY);
+        if (prev.onHide) prev.onHide();
+        prev.el.hidden = true;
+      }
+      next.el.hidden = false;
+      currentName = name;
+    }
+
+    if (next.onShow) next.onShow(params);
+    document.title = next.title;
+    updateNav(name);
+
+    if (switched) {
+      // A deep link with parameters (e.g. #/menu/seasonal) starts at the top;
+      // a plain revisit resumes where the user left off.
+      const restoreTo = params.length ? 0 : (scrollPositions.get(name) || 0);
+      window.scrollTo(0, restoreTo);
+
+      if (!initial) {
+        const heading = next.el.querySelector('h1');
+        if (heading) heading.focus({ preventScroll: true });
+      }
+    }
+  }
+
+  // Let the router own scroll position across back/forward navigation.
+  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+  // The home view is already rendered in the HTML, so it starts as the active
+  // view; a deep link (e.g. #/menu) then switches away from it like any other
+  // navigation would.
+  getOrCreateView('home');
+  currentName = 'home';
+
+  window.addEventListener('hashchange', () => navigate());
+  navigate({ initial: true });
+})();
