+/*
+ * The Daily Grind — client-side router and views.
+ *
+ * Routing uses the URL hash (#/menu, #/locations, ...) so the app works on a
+ * plain static file server with no rewrite rules, and deep links / refreshes
+ * land on the right view.
+ *
+ * View switching is optimised for revisits: each view's DOM is built exactly
+ * once, on first visit, and then kept in the document. Navigating away simply
+ * hides it (the `hidden` attribute), and coming back un-hides it. Nothing is
+ * torn down or rebuilt, so any state the user left behind — a selected menu
+ * filter, text typed in a search box, half-filled form fields, scroll
+ * position — is still there when they return.
+ */
+(function () {
+  'use strict';
+
+  // ---------------------------------------------------------------------------
+  // Small DOM helper
+  // ---------------------------------------------------------------------------
+
+  /**
+   * h('div', { class: 'card', onclick: fn, 'data-x': 1 }, child, 'text', ...)
+   * Children may be nodes, strings, arrays, or null/false (ignored).
+   */
+  function h(tag, props, ...children) {
+    const node = document.createElement(tag);
+    if (props) {
+      for (const [key, value] of Object.entries(props)) {
+        if (value == null || value === false) continue;
+        if (key === 'class') node.className = value;
+        else if (key === 'html') node.innerHTML = value;
+        else if (key.startsWith('on') && typeof value === 'function') {
+          node.addEventListener(key.slice(2).toLowerCase(), value);
+        } else if (key in node && typeof value !== 'string' && key !== 'style') {
+          node[key] = value;
+        } else {
+          node.setAttribute(key, value === true ? '' : value);
+        }
+      }
+    }
+    append(node, children);
+    return node;
+  }
+
+  function append(parent, children) {
+    for (const child of children) {
+      if (child == null || child === false) continue;
+      if (Array.isArray(child)) append(parent, child);
+      else parent.append(child);
+    }
+  }
+
+  function formatMoney(n) {
+    return '$' + n.toFixed(2);
+  }
+
+  function img(src, alt) {
+    return h('img', {
+      src: src + '?auto=format&fit=crop&w=600&q=70',
+      alt,
+      loading: 'lazy',
+      decoding: 'async',
+      width: 600,
+      height: 450,
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Data
+  // ---------------------------------------------------------------------------
+
+  const MENU_CATEGORIES = [
+    { id: 'all', label: 'All' },
+    { id: 'espresso', label: 'Espresso' },
+    { id: 'seasonal', label: 'Seasonal' },
+    { id: 'cold-brew', label: 'Cold Brew' },
+    { id: 'pastries', label: 'Pastries' },
+  ];
+
+  const MENU_ITEMS = [
+    {
+      name: 'Maple Oat Latte',
+      category: 'seasonal',
+      price: 5.75,
+      description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+      image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735',
+    },
+    {
+      name: 'Pumpkin Spice Cappuccino',
+      category: 'seasonal',
+      price: 5.5,
+      description: 'Our fall classic with real pumpkin and warm spices.',
+      image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93',
+    },
+    {
+      name: 'Dark Roast Espresso',
+      category: 'espresso',
+      price: 3.25,
+      description: 'Bold, smokey, and perfect for a morning boost.',
+      image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04',
+    },
+    {
+      name: 'Classic Cappuccino',
+      category: 'espresso',
+      price: 4.5,
+      description: 'Double shot topped with velvety steamed milk foam.',
+      image: 'https://images.unsplash.com/photo-1572442388796-11668a67e53d',
+    },
+    {
+      name: 'Mocha',
+      category: 'espresso',
+      price: 5.0,
+      description: 'Espresso, single-origin dark chocolate and whipped cream.',
+      image: 'https://images.unsplash.com/photo-1578314675249-a6910f80cc4e',
+    },
+    {
+      name: 'Cold Brew',
+      category: 'cold-brew',
+      price: 4.75,
+      description: 'Steeped for 18 hours for maximum smoothness.',
+      image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c',
+    },
+    {
+      name: 'Nitro Cold Brew',
+      category: 'cold-brew',
+      price: 5.25,
+      description: 'Nitrogen-infused for a creamy, cascading pour.',
+      image: 'https://images.unsplash.com/photo-1521017432531-fbd92d768814',
+    },
+    {
+      name: 'Butter Croissant',
+      category: 'pastries',
+      price: 3.5,
+      description: 'Laminated by hand each morning. Flaky, buttery, gone by noon.',
+      image: 'https://images.unsplash.com/photo-1555507036-ab1f4038808a',
+    },
+    {
