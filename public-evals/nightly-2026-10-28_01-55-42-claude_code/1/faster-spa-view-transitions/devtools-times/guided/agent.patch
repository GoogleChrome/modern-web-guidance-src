+
+/*
+ * Cached SPA views (see src/scripts/view-cache.ts).
+ * Inactive views stay in the DOM but are made `inert`; content-visibility: hidden
+ * skips their layout and paint while keeping the cached rendering state, so
+ * switching back is near-instant. position: absolute keeps the empty box out of flow.
+ */
+[data-view][inert] {
+  content-visibility: hidden;
+  position: absolute;
+}
+
+@supports not (content-visibility: hidden) {
+  [data-view][inert] {
+    display: none;
+  }
+}
+
+/* The view container only receives programmatic focus after navigation. */
+[data-view]:focus {
+  outline: none;
+}
