+}
+/*
+ * Views parked by the client-side view cache (src/scripts/view-cache.ts).
+ * `content-visibility: hidden` skips rendering while preserving the subtree's
+ * rendering state, so re-showing a parked view is cheaper than display: none.
+ */
+[data-view-cache-store] {
+  position: fixed;
+  top: 0;
+  left: 0;
+  width: 0;
+  height: 0;
+  overflow: hidden;
+  pointer-events: none;
+  content-visibility: hidden;
+}
+
+@supports not (content-visibility: hidden) {
+  [data-view-cache-store] {
+    display: none;
+  }
+}
