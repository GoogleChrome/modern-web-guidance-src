+  <script>
+    (() => {
+      'use strict';
+
+      // ---------- DOM ----------
+      const $ = (id) => document.getElementById(id);
+      const form = $('lab-form');
+      const sizeSelect = $('lab-batch-size');
+      const methodSelect = $('lab-method');
