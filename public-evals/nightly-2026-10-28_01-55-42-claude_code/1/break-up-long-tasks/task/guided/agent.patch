+
+      // ---------- Yielding to the main thread ----------
+      // 50 ms is the long-task threshold; each slice stops at that budget and yields.
+      const SLICE_BUDGET_MS = 50;
+      const hasSchedulerYield = 'scheduler' in window && 'yield' in window.scheduler;
+
+      function yieldToMain() {
+        if (hasSchedulerYield) {
+          // Continuation goes to the front of the queue, so input still gets handled
+          // first but the batch does not starve behind other queued tasks.
+          return window.scheduler.yield();
+        }
+        // Fallback: a macrotask at the back of the queue.
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      noteEl.textContent = hasSchedulerYield
+        ? 'Yielding with scheduler.yield(). Each work slice is capped at 50 ms before control returns to the browser.'
+        : 'scheduler.yield() is not available in this browser; falling back to setTimeout-based yielding every 50 ms.';
+
+      // ---------- Responsiveness probes ----------
+      let taps = 0;
+      tapBtn.addEventListener('click', () => {
+        taps += 1;
+        tapCount.value = String(taps);
+      });
+
+      let longTaskCount = 0;
+      let longTaskObserver = null;
+      const supportsLongTask =
+        'PerformanceObserver' in window &&
+        Array.isArray(PerformanceObserver.supportedEntryTypes) &&
+        PerformanceObserver.supportedEntryTypes.includes('longtask');
+
+      // ---------- Deterministic data ----------
+      function mulberry32(seed) {
+        let a = seed >>> 0;
+        return () => {
+          a = (a + 0x6D2B79F5) >>> 0;
+          let t = a;
+          t = Math.imul(t ^ (t >>> 15), t | 1);
+          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+      }
+
+      // Base flavor tendencies per origin, on a 0-1 scale.
+      const ORIGINS = [
+        { name: 'Ethiopia Yirgacheffe', acidity: 0.90, body: 0.40, sweetness: 0.70, bitterness: 0.20, aroma: 0.95 },
+        { name: 'Colombia Huila', acidity: 0.65, body: 0.60, sweetness: 0.75, bitterness: 0.30, aroma: 0.70 },
+        { name: 'Sumatra Mandheling', acidity: 0.25, body: 0.95, sweetness: 0.45, bitterness: 0.55, aroma: 0.50 },
+        { name: 'Brazil Cerrado', acidity: 0.35, body: 0.70, sweetness: 0.80, bitterness: 0.35, aroma: 0.55 },
+        { name: 'Kenya AA', acidity: 0.95, body: 0.55, sweetness: 0.60, bitterness: 0.25, aroma: 0.85 },
+        { name: 'Guatemala Antigua', acidity: 0.60, body: 0.70, sweetness: 0.65, bitterness: 0.40, aroma: 0.75 },
+      ];
+      const ROASTS = ['Light', 'Medium', 'Medium-Dark', 'Dark'];
+      const METHODS = {
+        'Espresso': { ratioMin: 1.8, ratioMax: 2.5, tempMin: 90, tempMax: 96, timeMin: 22, timeMax: 36, grind: 0.95 },
+        'Pour Over': { ratioMin: 14, ratioMax: 17, tempMin: 90, tempMax: 96, timeMin: 150, timeMax: 240, grind: 0.55 },
+        'French Press': { ratioMin: 12, ratioMax: 16, tempMin: 90, tempMax: 95, timeMin: 210, timeMax: 300, grind: 0.25 },
+        'Cold Brew': { ratioMin: 5, ratioMax: 9, tempMin: 4, tempMax: 22, timeMin: 43200, timeMax: 72000, grind: 0.20 },
+        'AeroPress': { ratioMin: 10, ratioMax: 15, tempMin: 80, tempMax: 94, timeMin: 60, timeMax: 150, grind: 0.70 },
+      };
+      const METHOD_NAMES = Object.keys(METHODS);
+
+      function pickOrigins(rand) {
+        const count = rand() < 0.4 ? 2 : 3;
+        const picked = [];
+        while (picked.length < count) {
+          const idx = Math.floor(rand() * ORIGINS.length);
+          if (!picked.some((p) => p.origin === ORIGINS[idx])) {
+            picked.push({ origin: ORIGINS[idx], weight: 0.5 + rand() });
+          }
+        }
+        const total = picked.reduce((s, p) => s + p.weight, 0);
+        for (const p of picked) p.weight /= total;
+        return picked;
+      }
+
+      function makeBlend(index, rand, methodFilter) {
+        const method = methodFilter === 'all'
+          ? METHOD_NAMES[Math.floor(rand() * METHOD_NAMES.length)]
+          : methodFilter;
+        const spec = METHODS[method];
+        return {
+          index,
+          origins: pickOrigins(rand),
+          roast: Math.floor(rand() * ROASTS.length),
+          method,
+          ratio: spec.ratioMin + rand() * (spec.ratioMax - spec.ratioMin),
+          tempC: spec.tempMin + rand() * (spec.tempMax - spec.tempMin),
+          timeSec: spec.timeMin + rand() * (spec.timeMax - spec.timeMin),
+          grind: Math.min(1, Math.max(0, spec.grind + (rand() - 0.5) * 0.2)),
+        };
+      }
+
+      // ---------- Extraction model ----------
+      // Integrates a first-order extraction curve for each flavor compound family
+      // over a fixed number of steps. Acids dissolve fastest, sugars next, and
+      // bitter compounds slowest, which is why under- and over-extraction taste
+      // the way they do. This is intentionally compute-heavy per blend.
+      const STEPS = 160;
+
+      function simulateBlend(blend) {
+        const roastFactor = 0.6 + blend.roast * 0.25;        // darker roast: more soluble, more bitter
+        const tempFactor = blend.tempC < 40
+          ? 0.015 + blend.tempC * 0.0004                       // cold brew regime
+          : 0.35 + (blend.tempC - 80) * 0.03;
+        const grindFactor = 0.4 + blend.grind * 1.2;           // finer grind: larger surface area
+        const strength = 1 / blend.ratio;                      // more coffee per water: stronger
+        const k = tempFactor * grindFactor * roastFactor;
+
+        // Normalise time so cold brew and espresso share the same curve scale.
+        const tEnd = blend.tempC < 40 ? blend.timeSec / 36000 : blend.timeSec / 60;
+        const dt = tEnd / STEPS;
+
+        let acid = 0, sugar = 0, bitter = 0, oils = 0, volatiles = 0;
+        for (let s = 1; s <= STEPS; s++) {
+          const t = s * dt;
+          const fast = 1 - Math.exp(-k * 2.2 * t);
+          const mid = 1 - Math.exp(-k * 1.1 * t);
+          const slow = 1 - Math.exp(-k * 0.45 * t);
+          acid += (fast - (acid / s)) * dt;
+          sugar += (mid - (sugar / s)) * dt;
+          bitter += (slow - (bitter / s)) * dt;
+          oils += (slow * (1 - blend.grind) + mid * 0.2) * dt;
+          volatiles += Math.max(0, fast - slow * 0.6) * Math.exp(-0.002 * t) * dt;
+        }
+        const norm = 1 / tEnd;
+        acid *= norm; sugar *= norm; bitter *= norm; oils *= norm; volatiles *= norm;
+
+        let acidity = 0, body = 0, sweetness = 0, bitterness = 0, aroma = 0;
+        for (const { origin, weight } of blend.origins) {
+          acidity += origin.acidity * weight;
+          body += origin.body * weight;
+          sweetness += origin.sweetness * weight;
+          bitterness += origin.bitterness * weight;
+          aroma += origin.aroma * weight;
+        }
+
+        const roastShift = blend.roast / (ROASTS.length - 1);
+        acidity = clamp01(acidity * (1.1 - roastShift * 0.6) * (0.5 + acid * 1.2) * (0.8 + strength));
+        body = clamp01(body * (0.7 + roastShift * 0.5) * (0.5 + oils * 1.4) * (0.7 + strength * 2));
+        sweetness = clamp01(sweetness * (1.05 - Math.abs(roastShift - 0.4)) * (0.3 + sugar * 1.05));
+        bitterness = clamp01(bitterness * (0.6 + roastShift) * (0.4 + bitter * 1.6) * (0.8 + strength));
+        aroma = clamp01(aroma * (1.1 - roastShift * 0.4) * (0.5 + volatiles * 1.1));
+
+        // Balance score: reward sweetness and aroma, penalise bitterness that
+        // overtakes sweetness, and penalise extremes in acidity.
+        const balance = 1 - Math.abs(acidity - 0.55) * 0.8;
+        const harmony = 1 - Math.max(0, bitterness - sweetness) * 1.5;
+        const score = clamp01(
+          0.30 * sweetness + 0.25 * aroma + 0.15 * body + 0.15 * balance + 0.15 * harmony
+        );
+
+        return { acidity, body, sweetness, bitterness, aroma, score };
+      }
+
+      function clamp01(v) {
+        return v < 0 ? 0 : v > 1 ? 1 : v;
+      }
