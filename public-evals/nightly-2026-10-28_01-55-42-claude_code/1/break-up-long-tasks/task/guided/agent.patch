+            [describeBlend(blend), ''],
+            [ROASTS[blend.roast], ''],
+            [blend.method, ''],
+            [describeRecipe(blend), ''],
+            [fmt10(profile.acidity), 'num'],
+            [fmt10(profile.body), 'num'],
+            [fmt10(profile.sweetness), 'num'],
+            [fmt10(profile.bitterness), 'num'],
+            [fmt10(profile.aroma), 'num'],
+            [fmt10(profile.score), 'num'],
+          ];
+          for (const [text, cls] of cells) {
+            const td = document.createElement('td');
+            td.textContent = text;
+            if (cls) td.className = cls;
+            tr.appendChild(td);
+          }
+          frag.appendChild(tr);
+        });
+        resultsBody.replaceChildren(frag);
+
+        const avg = result.processed ? result.scoreSum / result.processed : 0;
+        const bestMethod = Object.entries(result.methodTotals)
+          .map(([name, t]) => [name, t.sum / t.n])
+          .sort((a, b) => b[1] - a[1])[0];
+        const roastMix = ROASTS
+          .map((name, i) => `${name} ${Math.round((result.roastCounts[i] / Math.max(1, result.processed)) * 100)}%`)
+          .join(', ');
+
+        summaryEl.textContent =
+          `${result.cancelled ? 'Cancelled after' : 'Processed'} ${fmtInt.format(result.processed)} blends ` +
+          `in ${fmtMs(result.elapsed)} across ${fmtInt.format(result.slices)} slices. ` +
+          `Average balance score ${fmt10(avg)} / 10` +
+          (bestMethod ? `; best-performing method: ${bestMethod[0]} (${fmt10(bestMethod[1])}).` : '.') +
+          ` Roast mix: ${roastMix}.`;
+        resultsEl.hidden = false;
+      }
+
+      // ---------- Wiring ----------
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        if (activeController) return;
+
+        const total = Number(sizeSelect.value);
+        const methodFilter = methodSelect.value;
+        activeController = new AbortController();
+
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        sizeSelect.disabled = true;
+        methodSelect.disabled = true;
+        metricsEl.hidden = false;
+        resultsEl.hidden = true;
+        progress.value = 0;
+        statusEl.textContent = `Starting ${fmtInt.format(total)} blends…`;
+
+        try {
+          const result = await runBatch(total, methodFilter, activeController.signal);
+          statusEl.textContent = result.cancelled
+            ? `Cancelled at ${fmtInt.format(result.processed)} of ${fmtInt.format(total)} blends.`
+            : `Done. ${fmtInt.format(total)} blends simulated in ${fmtMs(result.elapsed)}.`;
+          renderResults(result);
+        } catch (err) {
+          statusEl.textContent = 'The simulation hit an error: ' + (err && err.message ? err.message : err);
+        } finally {
+          activeController = null;
+          runBtn.disabled = false;
+          cancelBtn.disabled = true;
+          sizeSelect.disabled = false;
+          methodSelect.disabled = false;
+        }
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        if (activeController) {
+          activeController.abort();
+          cancelBtn.disabled = true;
+          statusEl.textContent = 'Cancelling after the current slice…';
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
