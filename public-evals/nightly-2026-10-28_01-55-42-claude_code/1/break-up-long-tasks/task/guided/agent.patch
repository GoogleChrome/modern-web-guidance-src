+        try {
+          let sliceStart = performance.now();
+          let deadline = sliceStart + SLICE_BUDGET_MS;
+          slices = 1;
+
+          while (processed < total) {
+            const blend = makeBlend(processed, rand, methodFilter);
+            const profile = simulateBlend(blend);
+            processed += 1;
+
+            scoreSum += profile.score;
+            roastCounts[blend.roast] += 1;
+            const mt = methodTotals[blend.method] || (methodTotals[blend.method] = { sum: 0, n: 0 });
+            mt.sum += profile.score;
+            mt.n += 1;
+            insertTop(top, { blend, profile });
+
+            // Yield once the slice budget is spent, then update the UI in one batch
+            // of writes before starting the next slice.
+            const now = performance.now();
+            if (now >= deadline) {
+              longestSlice = Math.max(longestSlice, now - sliceStart);
+              yields += 1;
+              await yieldToMain();
+              if (signal.aborted) {
+                cancelled = true;
+                break;
+              }
