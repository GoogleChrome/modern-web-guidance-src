+      // ---------- Batch runner ----------
+      const TOP_N = 8;
+      let activeController = null;
+
+      async function runBatch(total, methodFilter, signal) {
+        const rand = mulberry32(0xC0FFEE ^ total);
+        const top = [];
+        const roastCounts = new Array(ROASTS.length).fill(0);
+        const methodTotals = Object.create(null);
+        let scoreSum = 0;
+        let processed = 0;
+
+        let slices = 0;
+        let yields = 0;
+        let longestSlice = 0;
+        let frames = 0;
+        const start = performance.now();
+
+        // Count painted frames during the run. If the main thread were blocked,
+        // this would stall, so it doubles as evidence the page stayed responsive.
+        let rafId = 0;
+        const tick = () => {
+          frames += 1;
+          clockEl.value = ((performance.now() - start) / 1000).toFixed(1) + ' s';
+          rafId = requestAnimationFrame(tick);
+        };
+        rafId = requestAnimationFrame(tick);
+
+        longTaskCount = 0;
+        if (supportsLongTask) {
+          longTaskObserver = new PerformanceObserver((list) => {
+            longTaskCount += list.getEntries().length;
+          });
