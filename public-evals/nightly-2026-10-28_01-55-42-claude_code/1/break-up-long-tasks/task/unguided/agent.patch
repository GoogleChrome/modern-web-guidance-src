+    (function () {
+      'use strict';
+
+      // ---------- Yielding helpers ----------
+      // Returns a promise that resolves once the browser has had a chance to
+      // handle input, paint, and run other queued tasks.
+      var strategyName;
+      var yieldToMain = (function () {
+        if (typeof scheduler !== 'undefined' && typeof scheduler.yield === 'function') {
+          strategyName = 'scheduler.yield()';
+          return function () { return scheduler.yield(); };
+        }
+        var viaTimeout = function () {
+          return new Promise(function (resolve) { setTimeout(resolve, 0); });
+        };
+        if (typeof MessageChannel !== 'undefined') {
+          // A MessageChannel macrotask resumes sooner than setTimeout(0), which
+          // browsers clamp to >= 4ms once nested, while still giving the browser
+          // a chance to handle input and paint in between.
+          strategyName = 'MessageChannel + setTimeout';
+          var channel = new MessageChannel();
+          var pending = [];
+          channel.port1.onmessage = function () {
+            var resolve = pending.shift();
+            if (resolve) resolve();
+          };
+          var viaChannel = function () {
+            return new Promise(function (resolve) {
+              pending.push(resolve);
+              channel.port2.postMessage(null);
+            });
+          };
+          var count = 0;
+          return function () {
+            // A steady stream of message tasks can crowd out timers, so every
+            // fourth yield goes through setTimeout to let timer callbacks run.
+            return (++count % 4 === 0) ? viaTimeout() : viaChannel();
+          };
+        }
+        strategyName = 'setTimeout(0)';
+        return viaTimeout;
+      })();
+
+      function inputIsPending() {
+        return !!(navigator.scheduling &&
+          typeof navigator.scheduling.isInputPending === 'function' &&
+          navigator.scheduling.isInputPending());
+      }
+
+      // ---------- Deterministic recipe generation ----------
+      function mulberry32(seed) {
+        return function () {
+          seed |= 0; seed = seed + 0x6D2B79F5 | 0;
+          var t = Math.imul(seed ^ seed >>> 15, 1 | seed);
+          t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
+          return ((t ^ t >>> 14) >>> 0) / 4294967296;
+        };
+      }
+
+      var ORIGINS = [
+        { name: 'Ethiopia Yirgacheffe', acidity: 0.9, body: 0.4, sweetness: 0.7, floral: 0.9 },
+        { name: 'Colombia Huila', acidity: 0.6, body: 0.6, sweetness: 0.8, floral: 0.4 },
+        { name: 'Brazil Cerrado', acidity: 0.3, body: 0.8, sweetness: 0.7, floral: 0.2 },
+        { name: 'Sumatra Mandheling', acidity: 0.2, body: 0.95, sweetness: 0.4, floral: 0.1 },
+        { name: 'Guatemala Antigua', acidity: 0.6, body: 0.7, sweetness: 0.6, floral: 0.4 },
+        { name: 'Kenya AA', acidity: 0.95, body: 0.5, sweetness: 0.6, floral: 0.6 },
+        { name: 'Costa Rica Tarrazu', acidity: 0.7, body: 0.6, sweetness: 0.7, floral: 0.5 },
+        { name: 'Honduras Marcala', acidity: 0.5, body: 0.6, sweetness: 0.8, floral: 0.3 }
+      ];
+      var ROASTS = ['Light', 'Medium-Light', 'Medium', 'Medium-Dark', 'Dark'];
+      var BREWS = [
+        { name: 'Pour Over', extraction: 0.20, agitation: 0.3 },
+        { name: 'Espresso', extraction: 0.22, agitation: 0.9 },
+        { name: 'French Press', extraction: 0.18, agitation: 0.4 },
+        { name: 'Cold Brew', extraction: 0.15, agitation: 0.1 },
+        { name: 'AeroPress', extraction: 0.21, agitation: 0.7 }
+      ];
+
+      function makeBlend(index, rand) {
+        var a = ORIGINS[Math.floor(rand() * ORIGINS.length)];
+        var b = ORIGINS[Math.floor(rand() * ORIGINS.length)];
+        var split = 0.5 + rand() * 0.4; // 50-90% of origin A
+        return {
+          id: index + 1,
+          originA: a,
+          originB: b,
+          split: split,
+          roast: Math.floor(rand() * ROASTS.length),
+          brew: BREWS[Math.floor(rand() * BREWS.length)],
+          ratio: 14 + rand() * 4,        // grams water per gram coffee
+          tempC: 85 + rand() * 11,
+          seconds: 30 + rand() * 300
+        };
+      }
+
+      // Deliberately CPU-heavy: integrates a simple extraction curve over
+      // many small time steps for each blend.
+      function simulateBlend(blend) {
+        var mix = function (key) {
+          return blend.originA[key] * blend.split + blend.originB[key] * (1 - blend.split);
+        };
+        var roastFactor = blend.roast / (ROASTS.length - 1); // 0 light .. 1 dark
+        var steps = 3000;
+        var dt = blend.seconds / steps;
+        var maxSolubles = 0.30; // fraction of the dose that can ever dissolve
+        var solubles = 0, acids = 0, sugars = 0, bitters = 0;
+        // Arrhenius-style temperature factor (~0.8 at 85C, ~1.2 at 96C) scaled so
+        // a typical brew lands near 20% extraction by the end of its contact time.
+        var tempFactor = Math.exp(4200 * (1 / 362 - 1 / (blend.tempC + 273.15)));
+        var k = (1.2 / blend.seconds) * tempFactor * (blend.brew.extraction / 0.2)
+          * (1 + blend.brew.agitation * 0.5) * (0.85 + roastFactor * 0.3);
+
+        for (var i = 0; i < steps; i++) {
+          var t = i * dt;
+          var progress = t / blend.seconds;
+          var remaining = maxSolubles - solubles;
+          var rate = k * remaining / (1 + progress * 0.5);
+          var dissolved = rate * dt;
+          solubles += dissolved;
+          // Acids come out first, sugars mid-brew, bitter compounds last.
+          acids += dissolved * (1 - roastFactor * 0.7) * mix('acidity') * Math.exp(-progress * 2);
+          sugars += dissolved * mix('sweetness') * Math.sin(progress * Math.PI);
+          bitters += dissolved * (0.3 + roastFactor * 0.9) * Math.pow(progress, 1.5);
+        }
+
+        var norm = function (v, max) { return Math.max(0, Math.min(10, (v / max) * 10)); };
+        var acidity = norm(acids, 0.08);
+        var sweetness = norm(sugars, 0.11);
+        var bitterness = norm(bitters, 0.11);
+        var body = norm(mix('body') * (0.6 + roastFactor * 0.6) * (18 / blend.ratio), 1.2);
+        var aroma = norm(mix('floral') * (1 - roastFactor * 0.5) + sweetness / 20, 1.1);
+
+        // Balance rewards a mid-range extraction and penalises any attribute
+        // dominating the cup.
+        var extractionPenalty = Math.abs(solubles - 0.2) * 40;
+        var spread = Math.max(acidity, sweetness, bitterness, body) - Math.min(acidity, sweetness, bitterness, body);
+        var score = (acidity * 0.9 + sweetness * 1.4 + body * 1.0 + aroma * 1.1 - bitterness * 0.8)
+          - extractionPenalty - spread * 0.4 + 5;
+
+        return {
+          id: blend.id,
+          name: blend.originA.name === blend.originB.name
+            ? blend.originA.name
+            : blend.originA.name.split(' ')[0] + ' / ' + blend.originB.name.split(' ')[0]
+              + ' (' + Math.round(blend.split * 100) + '/' + Math.round((1 - blend.split) * 100) + ')',
+          roast: ROASTS[blend.roast],
+          brew: blend.brew.name,
+          acidity: acidity, body: body, sweetness: sweetness, bitterness: bitterness,
+          score: Math.max(0, score)
+        };
+      }
+
+      // ---------- Batch runner with time slicing ----------
+      function runBatch(options) {
+        var total = options.total;
+        var budgetMs = options.budgetMs;
+        var signal = options.signal;
+        var onProgress = options.onProgress;
+        var rand = mulberry32(options.seed || 20261028);
+        var TOP_N = 5;
+        var top = [];
+        var processed = 0;
+        var slices = 0;
+        var longestSlice = 0;
+        var started = performance.now();
+
+        function recordTop(result) {
+          if (top.length < TOP_N || result.score > top[top.length - 1].score) {
+            top.push(result);
+            top.sort(function (a, b) { return b.score - a.score; });
+            if (top.length > TOP_N) top.pop();
+          }
+        }
+
+        return new Promise(function (resolve, reject) {
+          function processSlice() {
+            if (signal.aborted) {
+              reject(new DOMException('Simulation cancelled', 'AbortError'));
+              return;
+            }
+            var sliceStart = performance.now();
+            var deadline = sliceStart + budgetMs;
+            slices++;
+
+            // Work until the time budget is spent, input is waiting, or we
+            // run out of blends. Each iteration is short so overshoot is small.
+            do {
+              recordTop(simulateBlend(makeBlend(processed, rand)));
+              processed++;
+            } while (processed < total && performance.now() < deadline && !inputIsPending());
+
+            var sliceMs = performance.now() - sliceStart;
+            if (sliceMs > longestSlice) longestSlice = sliceMs;
+
+            onProgress({
+              processed: processed,
+              total: total,
+              slices: slices,
+              longestSlice: longestSlice,
+              elapsed: performance.now() - started
+            });
+
+            if (processed >= total) {
+              resolve({
+                top: top,
+                processed: processed,
+                slices: slices,
+                longestSlice: longestSlice,
+                elapsed: performance.now() - started
+              });
+              return;
+            }
+
+            // Hand control back to the browser before the next slice.
+            yieldToMain().then(processSlice, reject);
+          }
+          processSlice();
+        });
+      }
+
