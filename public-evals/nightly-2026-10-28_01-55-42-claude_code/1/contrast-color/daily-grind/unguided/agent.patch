+  <script>
+    // Fallback for browsers without CSS relative color syntax: compute the
+    // contrast colors in JS and keep them in sync when the theme changes.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('color', 'oklch(from red calc(l) c h)')) {
+        return; // CSS handles it natively.
+      }
+
+      var root = document.documentElement;
+      var probe = document.createElement('span');
+      probe.style.display = 'none';
+      document.body.appendChild(probe);
+
+      function toRgb(value) {
+        probe.style.color = '';
+        probe.style.color = value;
+        var m = /rgba?\(([^)]+)\)/.exec(getComputedStyle(probe).color);
+        if (!m) return null;
+        var parts = m[1].split(/[\s,\/]+/).map(parseFloat);
+        return parts.length >= 3 ? parts.slice(0, 3) : null;
+      }
+
+      function luminance(rgb) {
+        var c = rgb.map(function (v) {
+          v /= 255;
+          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+        });
+        return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
+      }
+
+      function contrastFor(varName) {
+        var raw = getComputedStyle(root).getPropertyValue(varName).trim();
+        var rgb = raw && toRgb(raw);
+        if (!rgb) return null;
+        // Pick whichever of black / white has the higher WCAG contrast ratio.
+        var L = luminance(rgb);
+        return (1.05 / (L + 0.05)) >= ((L + 0.05) / 0.05) ? '#ffffff' : '#111111';
+      }
+
+      function setIfChanged(name, value) {
+        // Only write when the value differs, so our own writes never
+        // retrigger the observer and cause a loop.
+        if (value && root.style.getPropertyValue(name).trim() !== value) {
+          root.style.setProperty(name, value);
+        }
+      }
+
+      function update() {
+        setIfChanged('--primary-contrast', contrastFor('--primary'));
+        setIfChanged('--secondary-contrast', contrastFor('--secondary'));
+      }
+
+      update();
+
+      // Re-run whenever inline styles or stylesheets change.
+      var observer = new MutationObserver(function () { update(); });
+      observer.observe(root, { attributes: true, attributeFilter: ['style', 'class'] });
+      observer.observe(document.head, { childList: true, subtree: true, characterData: true });
+      window.addEventListener('load', update);
+    })();
+  </script>
