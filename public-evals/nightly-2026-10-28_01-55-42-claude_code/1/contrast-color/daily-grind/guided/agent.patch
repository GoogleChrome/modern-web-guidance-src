       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /*
+       * Foreground colors derived from the theme backgrounds.
+       * Change --primary or --secondary and these resolve to whichever of
+       * black / white has the higher contrast against the new background.
+       * Static values below are only a last resort for very old browsers.
+       */
+      --primary-contrast: white;
+      --secondary-contrast: black;
+    }
+
+    /* Fallback: relative color syntax picks black or white by OKLCH lightness. */
+    @supports (color: oklch(from red max(0, sign(0.5 - l)) 0 h)) {
+      :root {
+        /* 0.623 is the highest lightness threshold that still passes WCAG AA. */
+        --contrast-threshold: 0.623;
+        --primary-contrast: oklch(from var(--primary) max(0, sign(var(--contrast-threshold) - l)) 0 h);
+        --secondary-contrast: oklch(from var(--secondary) max(0, sign(var(--contrast-threshold) - l)) 0 h);
+      }
+    }
+
+    /* Preferred: let the browser compute the contrasting color. */
+    @supports (color: contrast-color(red)) {
+      :root {
+        --primary-contrast: contrast-color(var(--primary));
+        --secondary-contrast: contrast-color(var(--secondary));
+      }
     }
 
