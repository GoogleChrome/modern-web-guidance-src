+  <script>
+    // ---- Offscreen media: defer poster + media requests until the player nears the viewport ----
+    (() => {
+      const lazyMedia = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"]');
+
+      // Move the deferred URLs into place and kick off resource selection.
+      const hydrate = (media) => {
+        if (media.dataset.poster) {
+          media.poster = media.dataset.poster;
+          delete media.dataset.poster;
+        }
+        if (media.dataset.src) {
+          media.src = media.dataset.src;
+          delete media.dataset.src;
+        }
+        for (const source of media.querySelectorAll('source[data-src]')) {
+          source.src = source.dataset.src;
+          delete source.dataset.src;
+        }
+        media.load();
+      };
+
+      // Native lazy media (Chrome/Edge 150+) gates every fetch on viewport distance itself,
+      // so the URLs can be applied right away.
+      if (Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+        lazyMedia.forEach(hydrate);
+        return;
+      }
+
+      // Everyone else: hold the URLs back until the player is within ~300px of the viewport.
+      const mediaObserver = new IntersectionObserver((entries, observer) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          hydrate(entry.target);
+          observer.unobserve(entry.target);
+        }
+      }, { rootMargin: '300px 0px' });
+
+      lazyMedia.forEach((media) => mediaObserver.observe(media));
+    })();
+
+    // ---- Hero video: respect reduced motion and offer a pause control ----
+    (() => {
+      const heroVideo = document.querySelector('.hero-video');
+      const toggle = document.querySelector('.hero-toggle');
+      if (!heroVideo || !toggle) return;
+
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const syncReducedMotion = (prefersReducedMotion) => {
+        if (prefersReducedMotion) {
+          heroVideo.removeAttribute('autoplay');
+          heroVideo.pause();
+        }
+      };
+      syncReducedMotion(reducedMotionQuery.matches);
+      reducedMotionQuery.addEventListener('change', (event) => syncReducedMotion(event.matches));
+
+      const syncToggle = () => {
+        toggle.hidden = false;
+        toggle.textContent = heroVideo.paused ? 'Play video' : 'Pause video';
+      };
+      heroVideo.addEventListener('play', syncToggle);
+      heroVideo.addEventListener('pause', syncToggle);
+      toggle.addEventListener('click', () => {
+        if (heroVideo.paused) {
+          heroVideo.play();
+        } else {
+          heroVideo.pause();
+        }
+      });
+    })();
+  </script>
+
