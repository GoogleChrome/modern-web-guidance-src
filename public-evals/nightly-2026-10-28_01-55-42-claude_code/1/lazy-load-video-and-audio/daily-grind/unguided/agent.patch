+  <script>
+    (function () {
+      // Below-the-fold media is authored with data-poster / data-src and preload="none",
+      // so the browser requests nothing for it on page load. When a player comes within
+      // the rootMargin of the viewport we move the data-* values onto the real
+      // attributes and let the browser fetch poster + metadata.
+      var ROOT_MARGIN = '600px 0px';
+      var lazyMedia = Array.prototype.slice.call(document.querySelectorAll('.lazy-media'));
+
+      function hydrate(el) {
+        if (el.getAttribute('data-hydrated') === 'true') { return; }
+        el.setAttribute('data-hydrated', 'true');
+
+        var poster = el.getAttribute('data-poster');
+        if (poster) {
+          el.setAttribute('poster', poster);
+          el.removeAttribute('data-poster');
+        }
+
+        var sources = el.querySelectorAll('source[data-src]');
+        Array.prototype.forEach.call(sources, function (source) {
+          source.setAttribute('src', source.getAttribute('data-src'));
+          source.removeAttribute('data-src');
+        });
+
+        var src = el.getAttribute('data-src');
+        if (src) {
+          el.setAttribute('src', src);
+          el.removeAttribute('data-src');
+        }
+
+        // Now that it is about to be seen, allow the browser to grab duration/first frame.
+        el.setAttribute('preload', 'metadata');
+        el.load();
+      }
+
+      if (lazyMedia.length) {
+        if ('IntersectionObserver' in window) {
+          var observer = new IntersectionObserver(function (entries, io) {
+            entries.forEach(function (entry) {
+              if (entry.isIntersecting || entry.intersectionRatio > 0) {
+                hydrate(entry.target);
+                io.unobserve(entry.target);
+              }
+            });
+          }, { rootMargin: ROOT_MARGIN, threshold: 0 });
+          lazyMedia.forEach(function (el) { observer.observe(el); });
+        } else {
+          // Very old browsers: load everything rather than leave players empty.
+          lazyMedia.forEach(hydrate);
+        }
+      }
+
+      // Respect reduced-motion: the CSS already hides the hero video; also stop it
+      // from downloading/playing so the still image is all the user gets.
+      var hero = document.getElementById('hero-video');
+      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
+      if (hero && reduceMotion && reduceMotion.matches) {
+        hero.removeAttribute('autoplay');
+        hero.pause();
+        hero.removeAttribute('src');
+        Array.prototype.forEach.call(hero.querySelectorAll('source'), function (s) { s.remove(); });
+        hero.load();
+      }
+    })();
+  </script>
