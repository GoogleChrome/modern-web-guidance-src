+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-title" aria-describedby="tour-desc">
+    <div class="tour-content">
+      <h2 id="tour-title">Earn Rewards</h2>
+      <p id="tour-desc">Earn points on every purchase and redeem them for free drinks. Check your balance here.</p>
+      <button type="button" id="tour-close" popovertarget="tour-step" popovertargetaction="hide">Got it</button>
+    </div>
+  </div>
+
+  <script type="module">
+    const tourStep = document.getElementById('tour-step');
+    const feature = document.getElementById('feature');
+
+    // Feature-detect and load polyfills only where native support is missing.
+    if (!('popover' in HTMLElement.prototype)) {
+      await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+    if (!CSS.supports('anchor-name: --foo')) {
+      try {
+        await import('https://unpkg.com/@oddbird/css-anchor-positioning');
+      } catch {
+        // Polyfill unavailable: pin the step to the viewport corner instead.
+        tourStep.classList.add('tour-fallback');
+      }
+    }
+
+    const isTourOpen = () => tourStep.matches(':is(:popover-open, .\\:popover-open)');
+
+    // Keep the highlighted link from navigating away while the tour is showing.
+    feature.addEventListener('click', (event) => {
+      if (isTourOpen()) event.preventDefault();
+    });
+
+    // Explicit close via Escape (manual popovers do not light-dismiss).
+    tourStep.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') tourStep.hidePopover();
+    });
+
+    // Open by default and move focus into the non-modal popover.
+    tourStep.showPopover();
+    document.getElementById('tour-close').focus();
+  </script>
+
 </body>
 
