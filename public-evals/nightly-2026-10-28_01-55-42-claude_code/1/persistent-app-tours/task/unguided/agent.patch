+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var step = document.getElementById('tour-step');
+      var closeBtn = document.getElementById('tour-step-close');
+      if (!link || !step || !closeBtn) return;
+
+      var tourOpen = true;
+
+      // Block navigation on the rewards link while the tour is open.
+      link.addEventListener('click', function (event) {
+        if (tourOpen) {
+          event.preventDefault();
+        }
+      });
+
+      // Position fallback for browsers without CSS anchor positioning.
+      var supportsAnchor = window.CSS && CSS.supports &&
+        CSS.supports('anchor-name: --a') && CSS.supports('top: anchor(bottom)');
+      var frame = null;
+
+      function position() {
+        frame = null;
+        if (!tourOpen) return;
+        var rect = link.getBoundingClientRect();
+        var gap = 14;
+        var margin = 12;
+        var width = step.offsetWidth;
+        var centerX = rect.left + rect.width / 2;
+        var left = centerX - width / 2;
+        var maxLeft = window.innerWidth - width - margin;
+        left = Math.max(margin, Math.min(left, maxLeft));
+        step.style.top = (rect.bottom + gap) + 'px';
+        step.style.left = left + 'px';
+        step.style.right = 'auto';
+        step.style.setProperty('--arrow-offset', (centerX - left) + 'px');
+      }
+
+      function schedule() {
+        if (frame === null) {
+          frame = window.requestAnimationFrame(position);
+        }
+      }
+
+      function startTracking() {
+        position();
+        window.addEventListener('resize', schedule);
+        window.addEventListener('scroll', schedule, true);
+        if (window.visualViewport) {
+          window.visualViewport.addEventListener('resize', schedule);
+          window.visualViewport.addEventListener('scroll', schedule);
+        }
+        if (window.ResizeObserver) {
+          var ro = new ResizeObserver(schedule);
+          ro.observe(link);
+          ro.observe(document.body);
+          if (link.closest('nav')) ro.observe(link.closest('nav'));
+        }
+        if (document.fonts && document.fonts.ready) {
+          document.fonts.ready.then(schedule);
+        }
+        window.addEventListener('load', schedule);
+      }
+
+      if (!supportsAnchor) {
+        startTracking();
+      }
+
+      // Only the close button dismisses the tour; outside clicks and Escape are ignored.
+      closeBtn.addEventListener('click', function () {
+        tourOpen = false;
+        step.hidden = true;
+        link.classList.remove('tour-active');
+        link.focus();
+      });
+    })();
+  </script>
+
