+  <script>
+    (() => {
+      const target = document.getElementById('action-target');
+      const toggleClass = (className) => (el, source) => {
+        const isOn = el.classList.toggle(className);
+        source?.setAttribute('aria-pressed', String(isOn));
+      };
+
+      const commandRegistry = {
+        '--spin': toggleClass('is-spun'),
+        '--grow': toggleClass('is-grown'),
+        '--round': toggleClass('is-rounded'),
+        '--reset': (el) => {
+          el.classList.remove('is-spun', 'is-grown', 'is-rounded');
+          document
+            .querySelectorAll(`button[commandfor="${el.id}"][aria-pressed]`)
+            .forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
+        },
+      };
+
+      // The native 'command' event does not bubble, so listen on the target itself.
+      target.addEventListener('command', (event) => {
+        const action = commandRegistry[event.command];
+        if (action) action(event.target, event.source);
+      });
+
+      // Fallback for browsers without the Invoker Commands API:
+      // dispatch a synthetic 'command' event from a delegated click handler.
+      const hasNativeSupport = 'commandForElement' in HTMLButtonElement.prototype;
+      if (!hasNativeSupport) {
+        if (!globalThis.CommandEvent) {
+          globalThis.CommandEvent = class CommandEvent extends Event {
+            constructor(type, { source, command, ...options } = {}) {
+              super(type, options);
+              this.source = source;
+              this.command = command;
+            }
+          };
+        }
+
+        document.addEventListener('click', (event) => {
+          const button = event.composedPath().find((el) => el.matches?.('button[commandfor]'));
+          if (!button) return;
+          const el = document.getElementById(button.getAttribute('commandfor'));
+          const command = button.getAttribute('command');
+          if (el && command) {
+            el.dispatchEvent(new CommandEvent('command', { command, source: button }));
+          }
+        });
+      }
+    })();
+  </script>
