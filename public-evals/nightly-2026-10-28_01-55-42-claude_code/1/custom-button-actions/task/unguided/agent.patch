+  <script>
+    (function () {
+      var target = document.getElementById('action-target');
+      var commandClasses = {
+        '--spin': 'is-spun',
+        '--grow': 'is-grown',
+        '--round': 'is-rounded'
+      };
+
+      target.addEventListener('command', function (event) {
+        if (event.command === '--reset') {
+          target.classList.remove('is-spun', 'is-grown', 'is-rounded');
+          return;
+        }
+        var className = commandClasses[event.command];
+        if (className) {
+          target.classList.toggle(className);
+        }
+      });
+    })();
+  </script>
+
