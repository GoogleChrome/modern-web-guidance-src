+  <script>
+    const drawer = document.getElementById('drawer');
+    const openBtn = document.getElementById('drawer-open');
+    const closeBtn = document.getElementById('drawer-close');
+    const page = document.getElementById('page');
+    const scroller = drawer.querySelector('.Drawer-scroller');
+    const sheet = drawer.querySelector('.Drawer-sheet');
+    let isOpen = false;
+
+    async function openDrawer() {
+      // Promote to the top layer first; scroll-initial-target places the
+      // scroller at the closed stop so the sheet starts off-screen.
+      drawer.showPopover();
+
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        // Jump to the closed stop so the scroll below animates the sheet in.
+        scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'instant' });
+        // Two frames: a single rAF isn't enough for the jump to commit.
+        await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
+      }
+
+      // behavior: 'auto' defers to CSS scroll-behavior (smooth unless the
+      // user prefers reduced motion); snap locks it fully open at the end.
+      scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (!drawer.matches(':popover-open')) return;
+      // Don't hidePopover() here: the IntersectionObserver hides it once the
+      // sheet has actually left the viewport, so the slide-out is visible.
+      scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'auto' });
+    }
+
+    function onDrawerOpened() {
+      isOpen = true;
+      page.inert = true;
+      openBtn.setAttribute('aria-expanded', 'true');
+      sheet.focus();
+    }
+
+    function onDrawerClosed() {
+      if (!isOpen) return;
+      isOpen = false;
+      drawer.hidePopover();
+      page.inert = false;
+      openBtn.setAttribute('aria-expanded', 'false');
+      openBtn.focus();
+    }
+
+    // The sheet's visibility inside the popover is the source of truth, so
+    // swipe, backdrop tap, Escape and the close button all converge here.
+    const visibleThreshold = 1 / window.innerWidth;
+    const observer = new IntersectionObserver(
+      (entries) => {
+        const entry = entries.at(-1);
+        if (entry.intersectionRatio < visibleThreshold) onDrawerClosed();
+        if (entry.intersectionRatio === 1) onDrawerOpened();
+      },
+      { root: drawer, threshold: [visibleThreshold, 1] },
+    );
+    observer.observe(sheet);
+
+    openBtn.addEventListener('click', openDrawer);
+    closeBtn.addEventListener('click', closeDrawer);
+
+    // Light dismiss: a tap anywhere in the popover outside the sheet.
+    drawer.addEventListener('click', (event) => {
+      if (!sheet.contains(event.target)) closeDrawer();
+    });
+
+    // Escape: listen on document since focus may be inside the drawer.
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') closeDrawer();
+    });
+
+    // Backdrop fade fallback for browsers without scroll-driven animations.
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      scroller.addEventListener('scroll', () => {
+        const ratio = 1 - scroller.scrollLeft / sheet.offsetWidth;
+        drawer.style.setProperty('--drawer-backdrop', Math.min(1, Math.max(0, ratio)));
+      }, { passive: true });
+    }
+  </script>
