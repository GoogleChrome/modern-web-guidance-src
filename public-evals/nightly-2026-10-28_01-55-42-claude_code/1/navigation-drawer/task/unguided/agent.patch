+  <script>
+    (() => {
+      const drawer = document.getElementById('nav-drawer');
+
+      // Fallback for browsers without the Invoker Commands API (commandfor/command).
+      if (!('command' in HTMLButtonElement.prototype)) {
+        document.querySelectorAll('[commandfor="nav-drawer"]').forEach((button) => {
+          button.addEventListener('click', () => {
+            if (button.getAttribute('command') === 'close') drawer.close();
+            else drawer.showModal();
+          });
+        });
+      }
+
+      // Fallback for browsers without closedby="any": a click whose target is the
+      // dialog element itself landed on the ::backdrop.
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        drawer.addEventListener('click', (event) => {
+          if (event.target === drawer) drawer.close();
+        });
+      }
+
+      // Always start with the panel in view when the drawer opens.
+      drawer.addEventListener('toggle', (event) => {
+        if (event.newState === 'open') drawer.scrollLeft = 0;
+      });
+
+      // Native swipe-to-dismiss: the dialog is a mandatory scroll-snap container.
+      // When scrolling settles on the empty dismiss slot, close the drawer.
+      const closeIfDismissed = () => {
+        if (drawer.open && drawer.scrollLeft >= drawer.clientWidth - 1) drawer.close();
+      };
+      const settleEvent = 'onscrollsnapchange' in drawer ? 'scrollsnapchange'
+        : 'onscrollend' in drawer ? 'scrollend'
+        : 'scroll';
+      drawer.addEventListener(settleEvent, closeIfDismissed);
+    })();
+  </script>
+
