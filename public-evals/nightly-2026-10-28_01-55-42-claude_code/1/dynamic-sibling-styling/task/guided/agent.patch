+  <script>
+    /* Fallback for browsers without sibling-index()/sibling-count().
+       MANDATORY feature detection: does nothing where the native functions exist. */
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const containers = document.querySelectorAll('.grid, .fan-container, .circle-container');
+
+      const apply = (container) => {
+        const items = container.children;
+        for (let i = 0; i < items.length; i++) {
+          /* 1-based index to match the native functions */
+          items[i].style.setProperty('--sibling-index', i + 1);
+          items[i].style.setProperty('--sibling-count', items.length);
+        }
+      };
+
+      containers.forEach((container) => {
+        apply(container);
+        /* Keep values correct if items are added or removed later */
+        new MutationObserver(() => apply(container))
+          .observe(container, { childList: true });
+      });
+    }
+  </script>
+
