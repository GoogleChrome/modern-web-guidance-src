+          hsl(var(--fan-hue) 55% 18%));
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
+      transform-origin: 50% 160%;
+      transform: rotate(calc(var(--spread) * var(--offset)));
+      /* Cards nearer the centre sit on top */
+      /* abs(offset) is a whole or half number, so *20 always yields an integer */
+      z-index: calc(100 - abs(var(--offset)) * 20);
+      transition: transform 0.3s, z-index 0s;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+    }
+
+    .fan-card:hover {
+      transform: rotate(calc(var(--spread) * var(--offset))) translateY(-20px);
+      z-index: 200;
+    }
+
+    .fan-card strong {
