+    }
+
+    .fan-card {
+      /* Midpoint of the list, e.g. 3 for 5 cards; cards left of it get negative angles */
+      --center: calc((var(--count) + 1) / 2);
+      --offset: calc(var(--index) - var(--center));
+      --spread: 12deg;
+      --fan-hue: calc(30deg + 25deg * (var(--index) - 1));
+
+      grid-area: 1 / 1; /* stack every card in the same cell */
+      width: 170px;
+      aspect-ratio: 5 / 3;
+      padding: 16px;
+      border-radius: 12px;
+      color: white;
+      background: linear-gradient(135deg,
