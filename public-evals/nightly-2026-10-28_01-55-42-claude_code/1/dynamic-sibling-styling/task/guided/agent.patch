+    /* =========================================================
+       Dynamic sibling styling
+       Every spectrum/fan/circle rule below derives its values from
+       --index / --count, which come from native sibling-index() and
+       sibling-count() where supported, otherwise from the JS fallback
+       (--sibling-index / --sibling-count). Adding or removing items
+       re-flows colours, angles and positions automatically.
+       ========================================================= */
+    .spectrum-card,
+    .fan-card,
+    .circle-orb {
+      /* 1. Base values from the JS fallback (1-based, like the native functions) */
+      --index: var(--sibling-index, 1);
+      --count: var(--sibling-count, 1);
+    }
+
+    @supports (top: calc(sibling-index() * 1px)) {
+      .spectrum-card,
+      .fan-card,
+      .circle-orb {
+        /* 2. Override with native functions only where supported */
+        --index: sibling-index();
+        --count: sibling-count();
+      }
