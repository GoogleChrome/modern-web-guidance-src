+  <script>
+    // Fallback for browsers without sibling-index() / sibling-count().
+    // Writes the same --i / --n variables the CSS expects and keeps them
+    // in sync when items are added, removed or reordered.
+    (function () {
+      if (window.CSS && CSS.supports('width', 'calc(sibling-index() * 1px)')) return;
+
+      var containers = document.querySelectorAll('.grid, .fan-container, .circle-container');
+
+      function index(container) {
+        var kids = container.children;
+        for (var i = 0; i < kids.length; i++) {
+          kids[i].style.setProperty('--i', i + 1);
+          kids[i].style.setProperty('--n', kids.length);
+        }
+      }
+
+      containers.forEach(function (container) {
+        index(container);
+        new MutationObserver(function () { index(container); })
+          .observe(container, { childList: true });
+      });
+    })();
+  </script>
