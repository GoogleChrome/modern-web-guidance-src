+  <script type="module">
+    // Polyfills PublicKeyCredential.parseRequestOptionsFromJSON, PublicKeyCredential.prototype.toJSON,
+    // getClientCapabilities and the signal* methods in browsers that do not ship them yet.
+    import 'https://esm.sh/webauthn-polyfills@0.1.7';
+
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const saveButton = document.getElementById('save-email-button');
+    const statusEl = document.getElementById('reauth-status');
+
+    function setStatus(message, state = 'info') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    // WebAuthn requires a secure context (https:// or http://localhost) and PublicKeyCredential support.
+    const webauthnAvailable = window.isSecureContext && 'PublicKeyCredential' in window;
+    if (!webauthnAvailable) {
+      reauthButton.disabled = true;
+      setStatus('Passkey verification is not available in this browser or context.', 'error');
+    }
+
+    // Any in-flight WebAuthn ceremony (e.g. a conditional-mediation prompt) must be aborted before
+    // starting a new one, otherwise the browser rejects the second request.
+    let reauthAbortController = null;
+
+    async function reauthenticate() {
+      reauthAbortController?.abort();
+      reauthAbortController = new AbortController();
+
+      reauthButton.disabled = true;
+      saveButton.disabled = true;
+      setStatus('Waiting for your passkey…');
+
+      try {
+        // 1. Ask the server for a challenge scoped to this signed-in user's registered credentials.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Accept': 'application/json' },
+        });
+        if (!optionsResponse.ok) {
+          throw new Error(`Could not start verification (HTTP ${optionsResponse.status}).`);
+        }
+        const optionsBody = await optionsResponse.json();
+        const optionsJSON = optionsBody.publicKey ?? optionsBody;
+
+        // Re-authentication must be constrained to the current user's passkeys. An empty or missing
+        // allowCredentials list would fall back to any discoverable credential on the device, which
+        // could verify a different account. Refuse to continue in that case.
+        if (!Array.isArray(optionsJSON.allowCredentials) || optionsJSON.allowCredentials.length === 0) {
+          setStatus('No passkey is registered to this account, so we cannot verify your identity this way.', 'error');
+          return;
+        }
+
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+        // 2. Run the assertion ceremony in the browser.
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) {
+          setStatus('Verification was cancelled.', 'error');
+          return;
+        }
+
+        // 3. Send the signed assertion back to the server for verification.
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: {
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+          },
+          body: JSON.stringify(encodedCredential),
+        });
+
+        if (verifyResponse.ok) {
+          saveButton.disabled = false;
+          setStatus('Identity verified. You can now save your changes.', 'success');
+          saveButton.focus();
+          return;
+        }
+
+        if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+          // The server no longer knows this credential; tell the passkey provider so it can remove it.
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: optionsJSON.rpId ?? location.hostname,
+            credentialId: encodedCredential.id,
+          });
+          setStatus('That passkey is no longer registered to this account.', 'error');
+          return;
+        }
+
+        setStatus('We could not verify your identity. Please try again.', 'error');
+      } catch (err) {
+        if (err.name === 'AbortError') {
+          return; // superseded by a newer ceremony
+        }
+        if (err.name === 'NotAllowedError') {
+          setStatus('Verification was cancelled or timed out.', 'error');
+          return;
+        }
+        console.error('Passkey re-authentication failed', err);
+        setStatus('Something went wrong while verifying your identity. Please try again.', 'error');
+      } finally {
+        reauthButton.disabled = !webauthnAvailable;
+      }
+    }
+
+    reauthButton.addEventListener('click', reauthenticate);
+  </script>
