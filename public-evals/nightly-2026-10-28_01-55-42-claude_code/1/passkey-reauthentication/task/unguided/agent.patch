+  <script>
+    (function () {
+      'use strict';
+
+      var OPTIONS_URL = '/api/reauth/options';
+      var VERIFY_URL = '/api/reauth/verify';
+
+      var button = document.querySelector('[data-testid="reauth-button"]');
+      var status = document.getElementById('reauth-status');
+      var form = document.getElementById('change-email-form');
+      var emailInput = document.getElementById('new-email');
+      var submitButton = document.getElementById('change-email-submit');
+      var tokenInput = document.getElementById('reauth-token');
+
+      if (!button) {
+        return;
+      }
+
+      function setStatus(message, state) {
+        status.textContent = message;
+        status.setAttribute('data-state', state);
+      }
+
+      function setSensitiveActionEnabled(enabled) {
+        emailInput.disabled = !enabled;
+        submitButton.disabled = !enabled;
+        if (!enabled) {
+          tokenInput.value = '';
+        }
+      }
+
+      /* ---- base64url <-> ArrayBuffer helpers ---- */
+
+      function base64urlToBuffer(value) {
+        if (typeof value !== 'string') {
+          throw new TypeError('Expected a base64url string');
+        }
+        var base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        var pad = base64.length % 4;
+        if (pad) {
+          base64 += '===='.slice(pad);
+        }
+        var binary = atob(base64);
+        var bytes = new Uint8Array(binary.length);
+        for (var i = 0; i < binary.length; i++) {
+          bytes[i] = binary.charCodeAt(i);
+        }
+        return bytes.buffer;
+      }
+
+      function bufferToBase64url(buffer) {
+        var bytes = new Uint8Array(buffer);
+        var binary = '';
+        for (var i = 0; i < bytes.length; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      /* ---- Server option handling ---- */
+
+      function unwrapOptions(payload) {
+        if (payload && typeof payload === 'object' && payload.publicKey && typeof payload.publicKey === 'object') {
+          return payload.publicKey;
+        }
+        return payload;
+      }
+
+      // Turn the JSON challenge from the server into PublicKeyCredentialRequestOptions,
+      // enforcing the properties that make this step phishing-resistant and
+      // not satisfiable by a password:
+      //   * the challenge is server-issued (never derived client-side),
+      //   * the ceremony is restricted to the user's pre-registered credentials,
+      //   * the authenticator must verify the user (PIN / biometric), not just presence.
+      function buildRequestOptions(json) {
+        if (!json || typeof json !== 'object' || !json.challenge) {
+          throw new Error('The server did not return a valid re-authentication challenge.');
+        }
+
+        var allowList = Array.isArray(json.allowCredentials) ? json.allowCredentials : [];
+        if (allowList.length === 0) {
+          throw new Error('No security key or passkey is registered for this account. Add one in your account settings before making this change.');
+        }
+
+        var publicKey;
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(json);
+        } else {
+          publicKey = {
+            challenge: base64urlToBuffer(json.challenge),
+            allowCredentials: allowList.map(function (cred) {
+              var entry = {
+                type: cred.type || 'public-key',
+                id: base64urlToBuffer(cred.id)
+              };
+              if (Array.isArray(cred.transports)) {
+                entry.transports = cred.transports;
+              }
+              return entry;
+            })
+          };
+          if (json.rpId) {
+            publicKey.rpId = json.rpId;
+          }
+          if (typeof json.timeout === 'number') {
+            publicKey.timeout = json.timeout;
+          }
+          if (json.extensions && typeof json.extensions === 'object') {
+            publicKey.extensions = json.extensions;
+          }
+          if (json.userVerification) {
+            publicKey.userVerification = json.userVerification;
+          }
+        }
+
+        // Never downgrade below user verification, regardless of what the server sent.
+        publicKey.userVerification = 'required';
+
+        // The rpId must match this origin's domain; WebAuthn rejects mismatches, which
+        // is what defeats look-alike phishing domains. Default to our own host.
+        if (!publicKey.rpId) {
+          publicKey.rpId = window.location.hostname;
+        }
+
+        return publicKey;
+      }
+
+      /* ---- Assertion serialisation ---- */
+
+      function serializeAssertion(credential) {
+        if (typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+        var response = credential.response;
+        return {
+          id: credential.id,
+          rawId: bufferToBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || null,
+          clientExtensionResults: typeof credential.getClientExtensionResults === 'function'
+            ? credential.getClientExtensionResults()
+            : {},
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64url(response.userHandle) : null
+          }
+        };
+      }
+
+      /* ---- Network ---- */
+
+      function postJson(url, body) {
+        return fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: {
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+            'X-Requested-With': 'fetch'
+          },
+          body: JSON.stringify(body)
+        }).then(function (res) {
+          return res.text().then(function (text) {
+            var data = null;
+            if (text) {
+              try {
+                data = JSON.parse(text);
+              } catch (e) {
+                data = null;
+              }
+            }
+            if (!res.ok) {
+              var message = (data && (data.error || data.message)) ||
+                ('Request failed (' + res.status + ')');
+              var err = new Error(message);
+              err.status = res.status;
+              throw err;
+            }
+            return data;
+          });
+        });
+      }
+
+      /* ---- Error messaging ---- */
+
+      function describeError(err) {
+        if (!err) {
+          return 'Re-authentication failed.';
+        }
+        switch (err.name) {
+          case 'NotAllowedError':
+            return 'The request was cancelled or timed out. Please try again and approve the prompt on your authenticator.';
+          case 'InvalidStateError':
+            return 'This authenticator is not registered to your account.';
+          case 'SecurityError':
+            return 'This page is not allowed to use the registered credential. Make sure you are on the correct site.';
+          case 'AbortError':
+            return 'Re-authentication was interrupted.';
+          default:
+            return err.message || 'Re-authentication failed.';
+        }
+      }
+
+      /* ---- Ceremony ---- */
+
+      var inFlight = false;
+
+      function reauthenticate() {
+        if (inFlight) {
+          return;
+        }
+
+        if (!window.isSecureContext) {
+          setStatus('Passkey verification requires a secure (HTTPS) connection.', 'error');
+          return;
+        }
+        if (!window.PublicKeyCredential || !navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          setStatus('This browser does not support security keys or passkeys.', 'error');
+          return;
+        }
+
+        inFlight = true;
+        button.disabled = true;
+        button.setAttribute('aria-busy', 'true');
+        setSensitiveActionEnabled(false);
+        setStatus('Requesting a challenge from the server...', 'pending');
+
+        var abortController = typeof AbortController === 'function' ? new AbortController() : null;
+
+        // 1. Ask the server for a challenge. The session cookie identifies the user,
+        //    so the server scopes allowCredentials to that user's registered keys.
+        postJson(OPTIONS_URL, { purpose: 'sensitive-account-change' })
+          .then(function (payload) {
+            var publicKey = buildRequestOptions(unwrapOptions(payload));
+            setStatus('Touch your security key or approve the passkey prompt...', 'pending');
+
+            // 2. Run the assertion ceremony in the browser.
+            var getOptions = { publicKey: publicKey };
+            if (abortController) {
+              getOptions.signal = abortController.signal;
+            }
+            return navigator.credentials.get(getOptions).then(function (credential) {
+              if (!credential) {
+                throw new Error('No credential was returned by the authenticator.');
+              }
+              return { credential: credential, payload: payload };
+            });
+          })
+          .then(function (result) {
+            setStatus('Verifying with the server...', 'pending');
+
+            // 3. Send the signed assertion back for verification.
+            var body = serializeAssertion(result.credential);
+            // Some servers key the pending challenge by an opaque id; forward it if given.
+            if (result.payload && result.payload.sessionId) {
+              body.sessionId = result.payload.sessionId;
+            }
+            return postJson(VERIFY_URL, body);
+          })
+          .then(function (verification) {
+            if (verification && verification.verified === false) {
+              throw new Error(verification.error || verification.message || 'The server rejected the assertion.');
+            }
+            if (verification && typeof verification.token === 'string') {
+              tokenInput.value = verification.token;
+            }
+            setSensitiveActionEnabled(true);
+            setStatus('Identity confirmed. You can now update your email.', 'success');
+            button.textContent = 'Identity confirmed';
+            if (typeof button.dispatchEvent === 'function') {
+              button.dispatchEvent(new CustomEvent('reauth:success', { bubbles: true, detail: verification }));
+            }
+            emailInput.focus();
+          })
+          .catch(function (err) {
+            setSensitiveActionEnabled(false);
+            setStatus(describeError(err), 'error');
+            button.disabled = false;
+            if (typeof button.dispatchEvent === 'function') {
+              button.dispatchEvent(new CustomEvent('reauth:error', { bubbles: true, detail: err }));
+            }
+          })
+          .then(function () {
+            inFlight = false;
+            button.removeAttribute('aria-busy');
+          });
+      }
+
+      button.addEventListener('click', function (event) {
+        event.preventDefault();
+        reauthenticate();
+      });
+
+      // Belt and braces: refuse to submit the sensitive form without a fresh re-auth.
+      if (form) {
+        form.addEventListener('submit', function (event) {
+          if (emailInput.disabled || submitButton.disabled) {
+            event.preventDefault();
+            setStatus('Please confirm your identity with your passkey first.', 'error');
+          }
+        });
+      }
+    })();
+  </script>
