diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -134,8 +134,82 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Contact Form */
+    .contact {
+      max-width: 600px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .contact h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .contact form {
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .field {
+      border: 2px solid transparent;
+      border-radius: 6px;
+      padding: 10px;
+      margin-bottom: 15px;
+      transition: border-color 0.3s;
+    }
+
+    .field label {
+      display: block;
+      font-weight: bold;
+      margin-bottom: 5px;
+      color: var(--primary);
+    }
+
+    .field input,
+    .field textarea {
+      width: 100%;
+      padding: 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      font: inherit;
+      color: var(--text);
+    }
+
+    .field textarea {
+      min-height: 120px;
+      resize: vertical;
+    }
+
+    .field input:focus,
+    .field textarea:focus {
+      outline: none;
+      border-color: var(--accent);
+    }
+
+    /* Pure-CSS validation: highlight the wrapper once the user has
+       interacted with (or tried to submit) an invalid field. */
+    .field:has(:user-invalid) {
+      border-color: #d32f2f;
+    }
+
+    /* Fallback for browsers without :user-invalid support — only fires
+       once the field has content, so it won't flag untouched fields. */
+    .field:has(:invalid:not(:placeholder-shown)) {
+      border-color: #d32f2f;
+    }
+
+    .contact .btn {
+      border: none;
+      cursor: pointer;
+      font: inherit;
+      margin-top: 5px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
@@ -196,8 +270,27 @@
       </div>
