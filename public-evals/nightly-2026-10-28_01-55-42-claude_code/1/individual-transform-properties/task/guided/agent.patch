diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -134,8 +134,75 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Seasonal Favorites header + featured promo badge */
+    .section-header {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 24px;
+      flex-wrap: wrap;
+    }
+
+    .target {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      width: 84px;
+      height: 84px;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      text-align: center;
+      line-height: 1.2;
+      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
+      cursor: default;
+
+      /* Identity transforms on the base element: the badge owns a stacking
+         context at rest, so hover (scale) and the running animations never
+         create or destroy one. No will-change needed. */
+      translate: 0px;
+      rotate: 0deg;
+      scale: 1;
+      isolation: isolate;
+      position: relative;
+      z-index: 1;
+
+      /* Two independent, simultaneous animations on separate individual
+         transform properties: spin drives `rotate`, slide drives `translate`. */
+      animation:
+        badge-spin 6s linear infinite,
+        badge-slide 2.4s ease-in-out infinite alternate;
+
+      /* Only `scale` transitions on hover, so the animations above keep
+         running untouched. */
+      transition: scale 0.3s ease;
+
+      @media (prefers-reduced-motion: reduce) {
+        animation: none;
+        transition: none;
+      }
+    }
+
+    .target:hover {
+      scale: 1.2;
+    }
+
+    @keyframes badge-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes badge-slide {
+      from { translate: -16px 0; }
+      to { translate: 16px 0; }
+    }
+
     footer {
