+    /* Weathered / rustic grunge treatment.
+       The repeating SVG tile is used as an alpha mask, so the distress
+       pattern punches real transparency into the hero rather than
+       sitting on top of it as an overlay. Browsers without mask support
+       simply render the clean, solid hero (progressive enhancement). */
+    .weathered-bg {
+      -webkit-mask-image: url('grunge-texture.svg');
+      -webkit-mask-repeat: repeat;
+      -webkit-mask-size: 400px 400px;
+      -webkit-mask-position: center;
+      mask-image: url('grunge-texture.svg');
+      mask-mode: alpha;
+      mask-repeat: repeat;
+      mask-size: 400px 400px;
+      mask-position: center;
+    }
+
