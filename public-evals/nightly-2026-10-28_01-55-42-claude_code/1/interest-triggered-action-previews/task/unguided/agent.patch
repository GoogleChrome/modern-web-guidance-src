+  <script>
+    // All "View Details" buttons point at #seasonal-preview via the
+    // declarative `interestfor` attribute, so the browser handles hover,
+    // focus, delays and touch for us. We only listen on the single target
+    // for the `interest` / `loseinterest` events it dispatches.
+    (() => {
+      const preview = document.getElementById('seasonal-preview');
+      const DEFAULT_TEXT = 'Select a drink to preview';
+
+      preview.addEventListener('interest', (event) => {
+        // `event.source` is the invoker element that gained interest.
+        const drink = event.source?.dataset.drink;
+        preview.textContent = drink || DEFAULT_TEXT;
+      });
+
+      preview.addEventListener('loseinterest', () => {
+        preview.textContent = DEFAULT_TEXT;
+      });
+    })();
+  </script>
+
