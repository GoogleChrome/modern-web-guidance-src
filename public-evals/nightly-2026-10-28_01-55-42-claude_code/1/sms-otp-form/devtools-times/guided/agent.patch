@@ -0,0 +1,69 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_MAX_ATTEMPTS,
+  OTP_RESEND_COOLDOWN_MS,
+  OTP_SESSION_KEY,
+  OTP_TTL_MS,
+  createChallenge,
+  formatOtpSms,
+  generateCode,
+  maskPhone,
+  normalizePhone,
+  type OtpChallenge,
+} from '../../../utils/otp';
+import { readBody } from '../../../utils/request-body';
+import { sendSms } from '../../../utils/sms';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+/**
+ * POST { phone } → sends a one-time passcode to the phone and stores a hashed challenge in the session.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) {
+    return json({ error: 'Sessions are not available.' }, 500);
+  }
+
+  const payload = await readBody(request);
+  if (!payload) {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(payload.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid mobile number, including the country code.', field: 'phone' }, 400);
+  }
+
+  const now = Date.now();
+  const previous = await session.get<OtpChallenge>(OTP_SESSION_KEY);
+  if (previous && now - previous.sentAt < OTP_RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((OTP_RESEND_COOLDOWN_MS - (now - previous.sentAt)) / 1000);
+    return json(
+      { error: `Please wait ${retryAfter} seconds before requesting another code.`, retryAfter },
+      429,
+    );
+  }
+
+  const code = generateCode();
+  const challenge = createChallenge(phone, code, now);
+
+  try {
+    await sendSms(phone, formatOtpSms(code, url.hostname));
+  } catch (err) {
+    console.error('[sms] delivery failed', err);
+    return json({ error: 'We could not send a text message right now. Please try again.' }, 502);
+  }
+
+  session.set(OTP_SESSION_KEY, challenge);
+
+  return json({
+    ok: true,
+    maskedPhone: maskPhone(phone),
+    expiresInSeconds: OTP_TTL_MS / 1000,
+    resendAfterSeconds: OTP_RESEND_COOLDOWN_MS / 1000,
+    maxAttempts: OTP_MAX_ATTEMPTS,
+    // Never leak the code outside local development.
+    ...(import.meta.env.DEV ? { devCode: code } : {}),
+  });
+};
diff --git a/src/pages/api/signup/verify.ts b/src/pages/api/signup/verify.ts
new file mode 100644
index 0000000..d7b6c33
--- /dev/null
+++ b/src/pages/api/signup/verify.ts
@@ -0,0 +1,89 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_MAX_ATTEMPTS,
+  OTP_SESSION_KEY,
+  codeMatches,
+  isValidCodeFormat,
+  type OtpChallenge,
+} from '../../../utils/otp';
+import { readBody } from '../../../utils/request-body';
+
+const REGISTER_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+/**
+ * POST { code, username, password } → checks the one-time passcode against the session challenge
+ * and, only if it matches, completes registration with the account service.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'Sessions are not available.' }, 500);
+  }
+
+  const payload = await readBody(request);
+  if (!payload) {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const { code, username, password } = payload;
+  if (!isValidCodeFormat(code)) {
+    return json({ error: 'Enter the 6-digit code from your text message.', field: 'code' }, 400);
+  }
+  if (typeof username !== 'string' || !username || typeof password !== 'string' || !password) {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+
+  const challenge = await session.get<OtpChallenge>(OTP_SESSION_KEY);
+  if (!challenge) {
+    return json({ error: 'No verification code is pending. Request a new code.', expired: true }, 400);
+  }
+
+  if (Date.now() > challenge.expiresAt) {
+    session.delete(OTP_SESSION_KEY);
+    return json({ error: 'That code has expired. Request a new code.', expired: true }, 400);
+  }
+
+  if (!codeMatches(challenge, code)) {
+    const attempts = challenge.attempts + 1;
+    if (attempts >= OTP_MAX_ATTEMPTS) {
+      session.delete(OTP_SESSION_KEY);
+      return json({ error: 'Too many incorrect attempts. Request a new code.', expired: true }, 400);
+    }
+    session.set(OTP_SESSION_KEY, { ...challenge, attempts });
+    const remaining = OTP_MAX_ATTEMPTS - attempts;
+    return json(
+      {
+        error: `That code is incorrect. ${remaining} ${remaining === 1 ? 'attempt' : 'attempts'} remaining.`,
+        field: 'code',
+        attemptsRemaining: remaining,
+      },
+      400,
+    );
+  }
+
+  // The phone number is verified; the challenge is single-use.
+  session.delete(OTP_SESSION_KEY);
+
+  try {
+    const response = await fetch(REGISTER_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+    const data = (await response.json().catch(() => ({}))) as { error?: string };
+
+    if (!response.ok) {
+      // TODO: Handle specific error codes (APP_ERR_1001, APP_ERR_1002, etc.) properly.
+      // The phone is verified but the account was not created; the client returns to the details step.
+      return json({ error: `Registration failed: ${data.error || 'Unknown error'}`, stage: 'registration' }, response.status);
+    }
+
+    session.set('verifiedPhone', challenge.phone);
+    return json({ ok: true, phone: challenge.phone });
+  } catch (err) {
+    console.error('[signup] registration request failed', err);
+    return json({ error: 'An unexpected error occurred. Please try again later.', stage: 'registration' }, 502);
+  }
+};
diff --git a/src/utils/otp.ts b/src/utils/otp.ts
new file mode 100644
index 0000000..32974d4
--- /dev/null
+++ b/src/utils/otp.ts
@@ -0,0 +1,82 @@
+import { createHash, randomBytes, randomInt, timingSafeEqual } from 'node:crypto';
+
+/** Number of digits in the one-time passcode. Keep in sync with the client `pattern`/`maxlength`. */
+export const OTP_LENGTH = 6;
+/** How long a code remains valid after it is sent. */
+export const OTP_TTL_MS = 5 * 60 * 1000;
+/** Minimum delay between two "send code" requests for the same session. */
+export const OTP_RESEND_COOLDOWN_MS = 30 * 1000;
+/** Wrong guesses allowed before the code is invalidated and must be re-sent. */
+export const OTP_MAX_ATTEMPTS = 5;
+
+/** Session key under which the pending verification challenge is stored. */
+export const OTP_SESSION_KEY = 'signupOtp';
+
+export interface OtpChallenge {
+  /** Phone number in E.164 form that the code was sent to. */
+  phone: string;
+  /** Hex SHA-256 of `${salt}:${code}`; the plain code is never stored. */
+  hash: string;
+  salt: string;
+  sentAt: number;
+  expiresAt: number;
+  attempts: number;
+}
+
+export function generateCode(length = OTP_LENGTH): string {
+  // randomInt is cryptographically secure; pad so codes like 012345 keep their leading zero.
+  return String(randomInt(0, 10 ** length)).padStart(length, '0');
+}
+
+export function hashCode(code: string, salt: string): string {
+  return createHash('sha256').update(`${salt}:${code}`).digest('hex');
+}
+
+export function createChallenge(phone: string, code: string, now = Date.now()): OtpChallenge {
+  const salt = randomBytes(16).toString('hex');
+  return {
+    phone,
+    salt,
+    hash: hashCode(code, salt),
+    sentAt: now,
+    expiresAt: now + OTP_TTL_MS,
+    attempts: 0,
+  };
+}
+
+export function codeMatches(challenge: OtpChallenge, code: string): boolean {
+  const expected = Buffer.from(challenge.hash, 'hex');
+  const actual = Buffer.from(hashCode(code, challenge.salt), 'hex');
+  return expected.length === actual.length && timingSafeEqual(expected, actual);
+}
+
+export function isValidCodeFormat(code: unknown): code is string {
+  return typeof code === 'string' && new RegExp(`^\\d{${OTP_LENGTH}}$`).test(code);
+}
+
+/**
+ * Normalise a user-entered phone number to E.164 (`+14155550123`).
+ * Returns `null` when the input cannot be a valid subscriber number.
+ */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const trimmed = input.trim();
+  const digits = trimmed.replace(/\D/g, '');
+  // E.164: 7–15 digits, no leading zero on the country code.
+  if (digits.length < 7 || digits.length > 15 || digits.startsWith('0')) return null;
+  return '+' + digits;
+}
+
+/** Mask everything except the last two digits for on-screen confirmation. */
+export function maskPhone(phone: string): string {
+  return phone.replace(/\d(?=\d{2})/g, '•');
+}
+
+/**
+ * Build the SMS body in the origin-bound format that the WebOTP API and
+ * Safari's `autocomplete="one-time-code"` autofill understand:
+ * a human-readable first line, then `@<host> #<code>` as the very last line.
+ */
+export function formatOtpSms(code: string, host: string): string {
+  return `Your DevTools Times verification code is ${code}. It expires in ${OTP_TTL_MS / 60000} minutes.\n\n@${host} #${code}`;
+}
diff --git a/src/utils/request-body.ts b/src/utils/request-body.ts
new file mode 100644
index 0000000..2d89b46
--- /dev/null
+++ b/src/utils/request-body.ts
@@ -0,0 +1,16 @@
+/** Read a JSON or form-encoded request body into a plain object; returns `null` when unparsable. */
+export async function readBody(request: Request): Promise<Record<string, unknown> | null> {
+  const type = request.headers.get('content-type') ?? '';
+  try {
+    if (type.includes('application/json')) {
+      const parsed: unknown = await request.json();
+      return parsed && typeof parsed === 'object' ? (parsed as Record<string, unknown>) : null;
+    }
+    if (type.includes('form')) {
+      return Object.fromEntries(await request.formData());
+    }
+  } catch {
+    /* fall through */
+  }
+  return null;
+}
