new file mode 100644
index 0000000..ae6cca1
--- /dev/null
+++ b/src/utils/sms.ts
@@ -0,0 +1,29 @@
+/**
+ * Outbound SMS delivery.
+ *
+ * Set `SMS_WEBHOOK_URL` (and optionally `SMS_WEBHOOK_TOKEN`) to forward messages to a
+ * provider relay as `{ to, body }`. Without it, messages are logged to the server console,
+ * which is enough for local development and DevTools demos.
+ */
+export async function sendSms(to: string, body: string): Promise<void> {
+  const webhookUrl = import.meta.env.SMS_WEBHOOK_URL as string | undefined;
+
+  if (!webhookUrl) {
+    console.info(`[sms] (not configured, logging only) to=${to}\n${body}`);
+    return;
+  }
+
+  const headers: Record<string, string> = { 'Content-Type': 'application/json' };
+  const token = import.meta.env.SMS_WEBHOOK_TOKEN as string | undefined;
+  if (token) headers.Authorization = `Bearer ${token}`;
+
+  const response = await fetch(webhookUrl, {
+    method: 'POST',
+    headers,
+    body: JSON.stringify({ to, body }),
+  });
+
+  if (!response.ok) {
+    throw new Error(`SMS provider responded with ${response.status}`);
+  }
+}
