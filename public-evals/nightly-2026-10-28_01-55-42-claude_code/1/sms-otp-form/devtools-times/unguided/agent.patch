@@ -0,0 +1,52 @@
+import { useEffect, useRef } from 'react';
+
+export interface UseWebOtpOptions {
+  /** Start listening for an incoming SMS. */
+  enabled: boolean;
+  /** Called with the extracted code once the browser receives a matching SMS. */
+  onCode: (code: string) => void;
+  /** Expected number of digits; anything else is ignored. */
+  length?: number;
+}
+
+/** True when the current browser can extract codes from SMS via WebOTP. */
+export function supportsWebOtp(): boolean {
+  return (
+    typeof window !== 'undefined' &&
+    'OTPCredential' in window &&
+    typeof navigator !== 'undefined' &&
+    !!navigator.credentials?.get
+  );
+}
+
+/**
+ * Listens for an origin-bound SMS (`@host #code`) using the WebOTP API and
+ * hands the code to `onCode`. Falls back silently where unsupported; pairing
+ * this with `autocomplete="one-time-code"` covers iOS Safari and others.
+ */
+export function useWebOtp({ enabled, onCode, length = 6 }: UseWebOtpOptions): void {
+  const onCodeRef = useRef(onCode);
+  onCodeRef.current = onCode;
+
+  useEffect(() => {
+    if (!enabled || !supportsWebOtp()) return;
+
+    const controller = new AbortController();
+
+    navigator.credentials
+      .get({ otp: { transport: ['sms'] }, signal: controller.signal })
+      .then((credential) => {
+        const otp = credential as OTPCredential | null;
+        const code = otp?.code?.replace(/\D/g, '') ?? '';
+        if (code.length === length) onCodeRef.current(code);
+      })
+      .catch((err: unknown) => {
+        // AbortError is expected on unmount / step change; anything else is
+        // non-fatal because the user can still type the code manually.
+        if (err instanceof DOMException && err.name === 'AbortError') return;
+        console.warn('[web-otp] automatic code retrieval failed', err);
+      });
+
+    return () => controller.abort();
+  }, [enabled, length]);
+}
