+++ b/src/lib/otp.ts
@@ -0,0 +1,187 @@
+/**
+ * Server-side helpers for SMS one-time passcodes (OTP).
+ *
+ * Codes are never stored in plain text: we keep a salted SHA-256 hash in the
+ * visitor's session together with an expiry and an attempt counter.
+ */
+
+export const OTP_LENGTH = 6;
+export const OTP_TTL_MS = 5 * 60 * 1000; // 5 minutes
+export const OTP_RESEND_COOLDOWN_MS = 30 * 1000; // 30 seconds
+export const OTP_MAX_ATTEMPTS = 5;
+
+export const OTP_SESSION_KEY = 'phoneOtp';
+export const VERIFIED_PHONE_SESSION_KEY = 'verifiedPhone';
+
+export interface OtpChallenge {
+  phone: string;
+  hash: string;
+  salt: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+export interface VerifiedPhone {
+  phone: string;
+  verifiedAt: number;
+}
+
+/**
+ * Normalises user input to E.164 (`+14155550123`).
+ * Returns `null` when the input cannot be a valid phone number.
+ */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const trimmed = input.trim();
+  if (!trimmed) return null;
+
+  // Keep a leading "+" and strip everything that is not a digit.
+  const hasPlus = trimmed.startsWith('+');
+  const digits = trimmed.replace(/\D/g, '');
+  if (!digits) return null;
+
+  // Without a country code we assume a 10-digit North American number.
+  const normalized = hasPlus
+    ? `+${digits}`
+    : digits.length === 10
+      ? `+1${digits}`
+      : digits.length === 11 && digits.startsWith('1')
+        ? `+${digits}`
+        : null;
+
+  if (!normalized) return null;
+  // E.164: "+" followed by 8–15 digits, never starting with 0.
+  if (!/^\+[1-9]\d{7,14}$/.test(normalized)) return null;
+  return normalized;
+}
+
+/** Masks a phone number for display, e.g. `+1 ••• ••• 0123`. */
+export function maskPhone(phone: string): string {
+  const last4 = phone.slice(-4);
+  return `•••• •••• ${last4}`;
+}
+
+export function generateCode(length = OTP_LENGTH): string {
+  const bytes = new Uint32Array(length);
+  crypto.getRandomValues(bytes);
+  return Array.from(bytes, (n) => String(n % 10)).join('');
+}
+
+function randomSalt(): string {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+async function sha256Hex(value: string): Promise<string> {
+  const data = new TextEncoder().encode(value);
+  const digest = await crypto.subtle.digest('SHA-256', data);
+  return Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+export async function hashCode(code: string, salt: string): Promise<string> {
+  return sha256Hex(`${salt}:${code}`);
+}
+
+/** Constant-time comparison of two equal-length hex strings. */
+function timingSafeEqual(a: string, b: string): boolean {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) {
+    diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
+  }
+  return diff === 0;
+}
+
+export async function createChallenge(phone: string): Promise<{ challenge: OtpChallenge; code: string }> {
+  const code = generateCode();
+  const salt = randomSalt();
+  const now = Date.now();
+  const challenge: OtpChallenge = {
+    phone,
+    salt,
+    hash: await hashCode(code, salt),
+    sentAt: now,
+    expiresAt: now + OTP_TTL_MS,
+    attempts: 0,
+  };
+  return { challenge, code };
+}
+
+export type VerifyResult =
+  | { ok: true }
+  | { ok: false; reason: 'expired' | 'mismatch' | 'locked' | 'missing'; attemptsLeft?: number };
+
+export async function verifyChallenge(
+  challenge: OtpChallenge | undefined,
+  code: string,
+): Promise<{ result: VerifyResult; challenge?: OtpChallenge }> {
+  if (!challenge) return { result: { ok: false, reason: 'missing' } };
+  if (Date.now() > challenge.expiresAt) return { result: { ok: false, reason: 'expired' } };
+  if (challenge.attempts >= OTP_MAX_ATTEMPTS) return { result: { ok: false, reason: 'locked' } };
+
+  const updated: OtpChallenge = { ...challenge, attempts: challenge.attempts + 1 };
+  const candidate = await hashCode(code, challenge.salt);
+
+  if (timingSafeEqual(candidate, challenge.hash)) {
+    return { result: { ok: true }, challenge: updated };
+  }
+
+  const attemptsLeft = Math.max(0, OTP_MAX_ATTEMPTS - updated.attempts);
+  return {
+    result: { ok: false, reason: attemptsLeft === 0 ? 'locked' : 'mismatch', attemptsLeft },
+    challenge: updated,
+  };
+}
+
+/**
+ * Builds the SMS body. The last line follows the WebOTP origin-bound format
+ * (`@host #code`) so that supporting browsers can hand the code straight to
+ * the page via `navigator.credentials.get({ otp: ... })`.
+ * See https://web.dev/articles/web-otp
+ */
+export function buildSmsMessage(code: string, host: string): string {
+  return `Your DevTools Times verification code is ${code}. It expires in 5 minutes.\n\n@${host} #${code}`;
+}
+
+export interface SmsSender {
+  send(to: string, body: string): Promise<void>;
+}
+
+/** Sends via Twilio's REST API when credentials are configured. */
+function twilioSender(sid: string, token: string, from: string): SmsSender {
+  return {
+    async send(to, body) {
+      const params = new URLSearchParams({ To: to, From: from, Body: body });
+      const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, {
+        method: 'POST',
+        headers: {
+          Authorization: `Basic ${btoa(`${sid}:${token}`)}`,
+          'Content-Type': 'application/x-www-form-urlencoded',
+        },
+        body: params,
+      });
+      if (!response.ok) {
+        const text = await response.text().catch(() => '');
+        throw new Error(`SMS provider responded with ${response.status}: ${text}`);
+      }
+    },
+  };
+}
+
+/** Development fallback: prints the message to the server log. */
+const consoleSender: SmsSender = {
+  async send(to, body) {
+    console.info(`[sms] (not sent – no SMS provider configured) to ${to}:\n${body}`);
+  },
+};
+
+export function getSmsSender(): SmsSender {
+  const env = import.meta.env;
+  const sid = env.TWILIO_ACCOUNT_SID;
+  const token = env.TWILIO_AUTH_TOKEN;
+  const from = env.TWILIO_FROM_NUMBER;
+  if (sid && token && from) return twilioSender(sid, token, from);
+  return consoleSender;
+}
diff --git a/src/pages/api/otp/send.ts b/src/pages/api/otp/send.ts
new file mode 100644
index 0000000..98bf6fc
--- /dev/null
+++ b/src/pages/api/otp/send.ts
@@ -0,0 +1,77 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_RESEND_COOLDOWN_MS,
+  OTP_SESSION_KEY,
+  OTP_TTL_MS,
+  VERIFIED_PHONE_SESSION_KEY,
+  buildSmsMessage,
+  createChallenge,
+  getSmsSender,
+  maskPhone,
+  normalizePhone,
+  type OtpChallenge,
+} from '../../../lib/otp';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+
+/**
+ * POST /api/otp/send  { phone: string }
+ * Generates a one-time passcode, stores its hash in the session and delivers
+ * it over SMS. Responds with the masked number and timing hints for the UI.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions are not available.' }, 500);
+
+  let body: { phone?: unknown } = {};
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Request body must be JSON.' }, 400);
+  }
+
+  const phone = normalizePhone(body.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid mobile phone number, including the country code.' }, 400);
+  }
+
+  // Throttle: if a code for this very number went out moments ago, don't send
+  // another one. The existing code is still valid, so the client can proceed.
+  const existing = (await session.get(OTP_SESSION_KEY)) as OtpChallenge | undefined;
+  if (existing && existing.phone === phone) {
+    const now = Date.now();
+    const sinceLast = now - existing.sentAt;
+    if (sinceLast < OTP_RESEND_COOLDOWN_MS && now < existing.expiresAt) {
+      return json({
+        ok: true,
+        reused: true,
+        maskedPhone: maskPhone(phone),
+        expiresInMs: existing.expiresAt - now,
+        resendAfterMs: OTP_RESEND_COOLDOWN_MS - sinceLast,
+      });
+    }
+  }
+
+  const { challenge, code } = await createChallenge(phone);
+
+  try {
+    await getSmsSender().send(phone, buildSmsMessage(code, url.host));
+  } catch (err) {
+    console.error('[otp] failed to send SMS', err);
+    return json({ error: 'We could not send a text message to that number. Please try again.' }, 502);
+  }
+
+  await session.set(OTP_SESSION_KEY, challenge);
+  // Any previously verified number is invalidated when a new challenge starts.
+  await session.delete(VERIFIED_PHONE_SESSION_KEY);
+
+  return json({
+    ok: true,
+    maskedPhone: maskPhone(phone),
+    expiresInMs: OTP_TTL_MS,
+    resendAfterMs: OTP_RESEND_COOLDOWN_MS,
+  });
+};
diff --git a/src/pages/api/otp/verify.ts b/src/pages/api/otp/verify.ts
new file mode 100644
index 0000000..e7d2e85
--- /dev/null
+++ b/src/pages/api/otp/verify.ts
@@ -0,0 +1,68 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_LENGTH,
+  OTP_SESSION_KEY,
+  VERIFIED_PHONE_SESSION_KEY,
+  verifyChallenge,
+  type OtpChallenge,
+  type VerifiedPhone,
+} from '../../../lib/otp';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+
+/**
+ * POST /api/otp/verify  { code: string }
+ * Checks the submitted code against the challenge stored in the session.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are not available.' }, 500);
+
+  let body: { code?: unknown } = {};
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Request body must be JSON.' }, 400);
+  }
+
+  const code = typeof body.code === 'string' ? body.code.replace(/\D/g, '') : '';
+  if (code.length !== OTP_LENGTH) {
+    return json({ error: `Enter the ${OTP_LENGTH}-digit code from the text message.` }, 400);
+  }
+
+  const stored = (await session.get(OTP_SESSION_KEY)) as OtpChallenge | undefined;
+  const { result, challenge } = await verifyChallenge(stored, code);
+
+  if (result.ok) {
+    const verified: VerifiedPhone = { phone: stored!.phone, verifiedAt: Date.now() };
+    await session.delete(OTP_SESSION_KEY);
+    await session.set(VERIFIED_PHONE_SESSION_KEY, verified);
+    return json({ ok: true, phone: verified.phone });
+  }
+
+  if (challenge) await session.set(OTP_SESSION_KEY, challenge);
+
+  switch (result.reason) {
+    case 'missing':
+      return json({ error: 'No verification is in progress. Request a new code.', reason: result.reason }, 400);
+    case 'expired':
+      await session.delete(OTP_SESSION_KEY);
+      return json({ error: 'That code has expired. Request a new code.', reason: result.reason }, 410);
+    case 'locked':
+      await session.delete(OTP_SESSION_KEY);
+      return json({ error: 'Too many incorrect attempts. Request a new code.', reason: result.reason }, 429);
+    case 'mismatch':
+    default:
+      return json(
+        {
+          error: `That code is incorrect. ${result.attemptsLeft} ${result.attemptsLeft === 1 ? 'attempt' : 'attempts'} left.`,
+          reason: 'mismatch',
+          attemptsLeft: result.attemptsLeft,
+        },
+        400,
+      );
+  }
+};
