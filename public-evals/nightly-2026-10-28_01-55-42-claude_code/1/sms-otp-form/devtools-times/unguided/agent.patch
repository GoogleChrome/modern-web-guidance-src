+import React, { forwardRef, useId } from 'react';
+
+export interface OneTimeCodeInputProps {
+  value: string;
+  onChange: (value: string) => void;
+  /** Called when the user has entered the full code (useful for auto-submit). */
+  onComplete?: (value: string) => void;
+  length?: number;
+  label?: string;
+  hint?: string;
+  error?: string | null;
+  disabled?: boolean;
+  id?: string;
+}
+
+/**
+ * A single, screen-reader friendly input for SMS one-time codes.
+ *
+ * Design notes:
+ * - One `<input>` rather than one box per digit: it is easier to operate with
+ *   assistive tech, supports paste, and works with `autocomplete="one-time-code"`
+ *   (iOS/macOS Safari and Android keyboards suggest the code from Messages).
+ * - `inputMode="numeric"` shows a digit keypad on mobile; we still accept
+ *   anything and strip non-digits so pasted "123 456" or "Your code is 123456" work.
+ * - Errors are linked through `aria-describedby` and `aria-invalid`.
+ */
+const OneTimeCodeInput = forwardRef<HTMLInputElement, OneTimeCodeInputProps>(function OneTimeCodeInput(
+  {
+    value,
+    onChange,
+    onComplete,
+    length = 6,
+    label = 'Verification code',
+    hint,
+    error,
+    disabled = false,
+    id,
+  },
+  ref,
+) {
+  const generatedId = useId();
+  const inputId = id ?? `otp-${generatedId}`;
+  const hintId = `${inputId}-hint`;
+  const errorId = `${inputId}-error`;
+
+  const describedBy = [hint ? hintId : null, error ? errorId : null].filter(Boolean).join(' ') || undefined;
+
+  const applyValue = (raw: string) => {
+    const digits = raw.replace(/\D/g, '').slice(0, length);
+    onChange(digits);
+    if (digits.length === length && digits !== value) onComplete?.(digits);
+  };
+
+  return (
+    <div>
+      <label htmlFor={inputId} className="block text-sm font-medium text-gray-700 mb-1">
+        {label}
+      </label>
+      <input
+        ref={ref}
+        id={inputId}
+        name="one-time-code"
+        type="text"
+        inputMode="numeric"
+        autoComplete="one-time-code"
+        pattern={`[0-9]{${length}}`}
+        maxLength={length}
+        minLength={length}
+        required
+        enterKeyHint="done"
+        spellCheck={false}
+        autoCapitalize="off"
+        autoCorrect="off"
+        value={value}
+        disabled={disabled}
+        aria-describedby={describedBy}
+        aria-invalid={error ? true : undefined}
+        onChange={(e) => applyValue(e.target.value)}
+        onPaste={(e) => {
+          const text = e.clipboardData.getData('text');
+          if (text) {
+            e.preventDefault();
+            applyValue(text);
+          }
+        }}
+        className={`w-full px-3 py-3 text-center text-2xl tracking-[0.5em] font-mono border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:bg-gray-100 ${
+          error ? 'border-red-500' : 'border-gray-300'
+        }`}
+      />
+      {hint && (
+        <p id={hintId} className="text-xs text-gray-500 mt-1">
+          {hint}
+        </p>
+      )}
+      {error && (
+        <p id={errorId} className="text-sm text-red-700 mt-1">
+          {error}
+        </p>
+      )}
+    </div>
+  );
+});
+
+export default OneTimeCodeInput;
