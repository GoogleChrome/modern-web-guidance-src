   <main class="container">
+    <!--
+      SMS one-time passcode verification.
+      Automatic code extraction uses the WebOTP API, which requires the text
+      message to end with an origin-bound line, e.g.:
+
+        Your Daily Grind code is 123456.
+
+        @dailygrind.example #123456
+
+      Browsers without WebOTP still get keyboard/autofill support through
+      autocomplete="one-time-code" and the paste handler below.
+    -->
+    <section class="otp-section" aria-labelledby="otp-heading">
+      <div class="otp-card">
+        <h2 id="otp-heading">Verify your phone number</h2>
+        <p id="otp-intro">We texted a 6-digit code to the mobile number on your account. Enter it to
+          sign in to Rewards or finish your online order.</p>
+
+        <form id="otp-form" method="post" action="/api/sms-otp/verify" novalidate
+          data-verify-url="/api/sms-otp/verify" data-resend-url="/api/sms-otp/send">
+          <fieldset>
+            <legend>What are you verifying for?</legend>
+            <div class="otp-purpose">
+              <label>
+                <input type="radio" name="purpose" value="rewards" checked>
+                Sign in to Rewards
+              </label>
+              <label>
+                <input type="radio" name="purpose" value="order">
+                Place an online order
+              </label>
+            </div>
+          </fieldset>
+
+          <div class="otp-field">
+            <label for="otp-code">6-digit verification code</label>
