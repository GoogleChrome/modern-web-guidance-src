+  <script>
+    (function () {
+      var form = document.getElementById('otp-form');
+      if (!form) return;
+
+      var input = document.getElementById('otp-code');
+      var errorEl = document.getElementById('otp-error');
+      var statusEl = document.getElementById('otp-status');
+      var submitBtn = document.getElementById('otp-submit');
+      var resendBtn = document.getElementById('otp-resend');
+      var CODE_LENGTH = 6;
+      var RESEND_COOLDOWN = 30; // seconds
+      var busy = false;
+
+      function digitsOnly(value) {
+        return (value || '').replace(/\D/g, '').slice(0, CODE_LENGTH);
+      }
+
+      function purpose() {
+        var checked = form.querySelector('input[name="purpose"]:checked');
+        return checked ? checked.value : 'rewards';
+      }
+
+      function setError(message) {
+        errorEl.textContent = message || '';
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+        if (message) input.focus();
+      }
+
+      function setStatus(message) {
+        statusEl.textContent = message || '';
+      }
+
+      // Pre-select purpose from the URL, e.g. /?for=order
+      try {
+        var params = new URLSearchParams(window.location.search);
+        var wanted = params.get('for') || params.get('purpose');
+        var radio = wanted && form.querySelector('input[name="purpose"][value="' + wanted + '"]');
+        if (radio) radio.checked = true;
+      } catch (e) { /* ignore */ }
+
+      // Keep the field numeric and clear stale errors while typing.
+      input.addEventListener('input', function () {
+        var cleaned = digitsOnly(input.value);
+        if (cleaned !== input.value) input.value = cleaned;
+        if (errorEl.textContent) setError('');
+      });
+
+      // Extract the code from pasted text such as "Your code is 123456".
+      input.addEventListener('paste', function (event) {
+        var text = (event.clipboardData || window.clipboardData).getData('text');
+        var match = text && text.match(/\d{6}/);
+        if (match) {
+          event.preventDefault();
+          input.value = match[0];
+          setError('');
+          setStatus('Code pasted. Press Verify code to continue.');
+        }
+      });
+
+      // Automatic extraction from incoming SMS via the WebOTP API.
+      var otpAbort = null;
+      if ('OTPCredential' in window && navigator.credentials && navigator.credentials.get) {
+        otpAbort = new AbortController();
+        navigator.credentials.get({ otp: { transport: ['sms'] }, signal: otpAbort.signal })
+          .then(function (credential) {
+            if (!credential || !credential.code) return;
+            input.value = digitsOnly(credential.code);
+            setError('');
+            setStatus('Code filled in from your text message. Verifying…');
+            form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', { cancelable: true }));
+          })
+          .catch(function () { /* user dismissed, timed out, or aborted */ });
+      }
+
+      function setBusy(state) {
+        busy = state;
+        submitBtn.setAttribute('aria-disabled', state ? 'true' : 'false');
+        submitBtn.textContent = state ? 'Verifying…' : 'Verify code';
+      }
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        if (busy) return;
+
+        var code = digitsOnly(input.value);
+        if (!code) {
+          setError('Enter the 6-digit code from your text message.');
+          return;
+        }
+        if (code.length !== CODE_LENGTH) {
+          setError('The code must be exactly 6 digits. You entered ' + code.length + '.');
+          return;
+        }
+
+        if (otpAbort) otpAbort.abort();
+        setError('');
+        setBusy(true);
+        setStatus('Verifying your code…');
+
+        fetch(form.getAttribute('data-verify-url'), {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ code: code, purpose: purpose() })
+        })
+          .then(function (response) {
+            if (!response.ok) throw new Error('status ' + response.status);
+            return response.json().catch(function () { return {}; });
+          })
+          .then(function (data) {
+            var next = data.redirect || (purpose() === 'order' ? '/order-online' : '/rewards');
+            setStatus('Phone number verified. Taking you to ' +
+              (purpose() === 'order' ? 'your order' : 'Rewards') + '…');
+            window.location.assign(next);
+          })
+          .catch(function () {
+            setBusy(false);
+            setStatus('');
+            setError('We couldn’t verify that code. Check the digits and try again, or request a new code.');
+          });
+      });
+
+      // Resend with a cooldown. aria-disabled keeps the button focusable so
+      // screen-reader users can still hear the countdown.
+      var cooldownTimer = null;
+      function startCooldown() {
+        var remaining = RESEND_COOLDOWN;
+        resendBtn.setAttribute('aria-disabled', 'true');
+        resendBtn.textContent = 'Resend code (' + remaining + 's)';
+        cooldownTimer = setInterval(function () {
+          remaining -= 1;
+          if (remaining <= 0) {
+            clearInterval(cooldownTimer);
+            cooldownTimer = null;
+            resendBtn.setAttribute('aria-disabled', 'false');
+            resendBtn.textContent = 'Resend code';
+            return;
+          }
+          resendBtn.textContent = 'Resend code (' + remaining + 's)';
+        }, 1000);
+      }
+
+      resendBtn.addEventListener('click', function () {
+        if (resendBtn.getAttribute('aria-disabled') === 'true') {
+          setStatus('Please wait before requesting another code.');
+          return;
+        }
+        startCooldown();
+        setStatus('Sending a new code…');
+        fetch(form.getAttribute('data-resend-url'), {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ purpose: purpose() })
+        })
+          .then(function (response) {
+            if (!response.ok) throw new Error('status ' + response.status);
+            setStatus('A new code is on its way. It can take up to a minute to arrive.');
+            input.value = '';
+            setError('');
+            input.focus();
+          })
+          .catch(function () {
+            setStatus('');
+            setError('We couldn’t send a new code right now. Please try again in a moment.');
+          });
+      });
+    })();
+  </script>
+
