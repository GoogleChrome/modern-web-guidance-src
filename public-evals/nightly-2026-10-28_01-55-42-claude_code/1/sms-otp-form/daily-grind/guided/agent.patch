+  <script>
+    (() => {
+      'use strict';
+
+      const sendForm = document.getElementById('send-form');
+      const otpForm = document.getElementById('otp-form');
+      const phoneInput = document.getElementById('phone-input');
+      const otpInput = document.getElementById('otp-input');
+      const otpPurpose = document.getElementById('otp-purpose');
+      const otpPhone = document.getElementById('otp-phone');
+      const otpPhoneDisplay = document.getElementById('otp-phone-display');
+      const sendBtn = document.getElementById('send-btn');
+      const verifyBtn = document.getElementById('verify-btn');
+      const resendBtn = document.getElementById('resend-btn');
+      const changePhoneBtn = document.getElementById('change-phone-btn');
+      const statusEl = document.getElementById('otp-status');
+      const alertEl = document.getElementById('otp-alert');
+
+      const DESTINATIONS = { rewards: '/rewards', order: '/order-online' };
+
+      const announce = (message) => { alertEl.textContent = ''; statusEl.textContent = message; };
+      const warn = (message) => { statusEl.textContent = ''; alertEl.textContent = message; };
+      const clearMessages = () => { statusEl.textContent = ''; alertEl.textContent = ''; };
+
+      // aria-disabled keeps the button focusable; activation is blocked in the handlers below.
+      const isBusy = (button) => button.getAttribute('aria-disabled') === 'true';
+      const setBusy = (button, busy) => {
+        if (busy) button.setAttribute('aria-disabled', 'true');
+        else button.removeAttribute('aria-disabled');
+      };
+
+      /* ---------- Validation messaging ---------- */
+
+      phoneInput.addEventListener('invalid', () => {
+        phoneInput.setCustomValidity('Enter the mobile number that should receive the code.');
+      });
+      phoneInput.addEventListener('input', () => phoneInput.setCustomValidity(''));
+
+      otpInput.addEventListener('invalid', () => {
+        otpInput.setCustomValidity('Enter the 6-digit code from your text message.');
+      });
+      otpInput.addEventListener('input', () => {
+        otpInput.setCustomValidity('');
+        // Keep digits only so pasted "123 456" or autofilled variants still validate.
+        const digits = otpInput.value.replace(/\D/g, '').slice(0, 6);
+        if (digits !== otpInput.value) otpInput.value = digits;
+        alertEl.textContent = '';
+      });
+
+      // Mirror the visual :user-invalid state onto aria-invalid at the same moment.
+      const syncAriaInvalid = (event) => {
+        const field = event.target;
+        if (!(field instanceof HTMLInputElement)) return;
+        if (field.matches(':user-invalid')) field.setAttribute('aria-invalid', 'true');
+        else field.removeAttribute('aria-invalid');
+      };
+      for (const form of [sendForm, otpForm]) {
+        // blur/focus do not bubble, so listen in the capture phase.
+        form.addEventListener('blur', syncAriaInvalid, true);
+        form.addEventListener('focus', syncAriaInvalid, true);
+        form.addEventListener('input', (event) => {
+          if (event.target.getAttribute('aria-invalid') === 'true') syncAriaInvalid(event);
+        });
+      }
+
+      /* ---------- WebOTP: automatic code extraction from the incoming SMS ---------- */
+
+      let otpAbortController = null;
+
+      function stopSmsOtpListener() {
+        if (otpAbortController) {
+          otpAbortController.abort();
+          otpAbortController = null;
+        }
+      }
+
+      async function startSmsOtpListener() {
+        if (!('OTPCredential' in window)) return; // Falls back to one-time-code autofill / manual entry
+        stopSmsOtpListener();
+        const ac = new AbortController();
+        otpAbortController = ac;
+        try {
+          const otp = await navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal,
+          });
+          if (!otp || ac.signal.aborted) return;
+          otpInput.value = otp.code;
+          // requestSubmit (not submit) so validation and the submit handler below still run.
+          otpForm.requestSubmit();
+        } catch (err) {
+          if (err && err.name === 'AbortError') return;
+          console.error('WebOTP verification error:', err);
+        }
+      }
+
+      window.addEventListener('pagehide', stopSmsOtpListener);
+
+      /* ---------- Step 1: request a code ---------- */
+
+      // The server behind /send-otp must end the SMS with "@<your-domain> #<code>" on its own
+      // last line so WebOTP and iOS keyboard autofill can bind the code to this origin.
+      async function requestCode() {
+        const response = await fetch(sendForm.action, {
+          method: 'POST',
+          body: new FormData(sendForm),
+          headers: { Accept: 'application/json' },
+        });
+        if (!response.ok) throw new Error(`Could not send code (HTTP ${response.status})`);
+      }
+
+      function lastFourDigits(phone) {
+        const digits = phone.replace(/\D/g, '');
+        return digits.slice(-4) || phone;
+      }
+
+      function showOtpStep() {
+        const data = new FormData(sendForm);
+        const phone = String(data.get('phone') || '').trim();
+        otpPurpose.value = String(data.get('purpose') || 'rewards');
+        otpPhone.value = phone;
+        otpPhoneDisplay.textContent = lastFourDigits(phone);
+
+        clearMessages();
+        otpInput.value = '';
+        otpInput.removeAttribute('aria-invalid');
+        sendForm.hidden = true;
+        otpForm.hidden = false;
+        otpInput.focus();
+        startSmsOtpListener();
+      }
+
+      sendForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        if (isBusy(sendBtn)) return;
+        setBusy(sendBtn, true);
+        try {
+          await requestCode();
+          showOtpStep();
+        } catch (err) {
+          console.error(err);
+          warn("We couldn't send a code right now. Check the number and try again.");
+        } finally {
+          setBusy(sendBtn, false);
+        }
+      });
+
+      /* ---------- Step 2: verify the code ---------- */
+
+      otpForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        stopSmsOtpListener(); // Abort any in-flight WebOTP request once the user submits
+        if (isBusy(verifyBtn)) return;
+        setBusy(verifyBtn, true);
+        try {
+          const response = await fetch(otpForm.action, {
+            method: 'POST',
+            body: new FormData(otpForm),
+            headers: { Accept: 'application/json' },
+          });
+
+          if (response.ok) {
+            const purpose = otpPurpose.value;
+            announce(purpose === 'order'
+              ? 'Verified. Taking you to your order…'
+              : 'Verified. Signing you in to Rewards…');
+            window.location.assign(response.redirected ? response.url : (DESTINATIONS[purpose] || '/'));
+            return;
+          }
+
+          const mismatch = [400, 401, 403, 422].includes(response.status);
+          warn(mismatch
+            ? "That code didn't match. Check your latest text message and try again."
+            : "We couldn't verify your code right now. Please try again.");
+          otpInput.setAttribute('aria-invalid', 'true');
+          otpInput.focus();
+          otpInput.select();
+        } catch (err) {
+          console.error(err);
+          warn("We couldn't reach the server. Check your connection and try again.");
+        } finally {
+          setBusy(verifyBtn, false);
+        }
+      });
+
+      resendBtn.addEventListener('click', async () => {
+        if (isBusy(resendBtn)) return;
+        setBusy(resendBtn, true);
+        try {
+          await requestCode();
+          otpInput.value = '';
+          otpInput.removeAttribute('aria-invalid');
+          announce('We sent a new code. Enter the latest one you received.');
+          startSmsOtpListener(); // Listen again for the fresh SMS
+        } catch (err) {
+          console.error(err);
+          warn("We couldn't resend the code right now. Please try again in a moment.");
+        } finally {
+          setBusy(resendBtn, false);
+        }
+      });
+
+      changePhoneBtn.addEventListener('click', () => {
+        stopSmsOtpListener();
+        clearMessages();
+        otpInput.value = '';
+        otpInput.removeAttribute('aria-invalid');
+        otpForm.hidden = true;
+        sendForm.hidden = false;
+        phoneInput.focus();
+      });
+    })();
+  </script>
+
 </body>
 
