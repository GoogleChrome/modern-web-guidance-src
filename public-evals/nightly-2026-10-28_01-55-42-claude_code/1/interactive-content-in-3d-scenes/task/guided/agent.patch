+    let velocity = 0;          // leftover drag velocity
+    let hovering = false, focused = false, dragging = false;
+    let inView = true, rafId = 0, lastTime = 0, renderOnce = false;
+
+    spinToggle.hidden = false;
+    const updateToggle = () => { spinToggle.textContent = autoSpin ? 'Pause spin' : 'Resume spin'; };
+    updateToggle();
+    spinToggle.addEventListener('click', () => { autoSpin = !autoSpin; updateToggle(); start(); });
+    reduceMotion.addEventListener('change', (e) => { autoSpin = !e.matches; updateToggle(); start(); });
+
+    // While the visitor is using the form, glide to face the camera and hold still.
+    form.addEventListener('pointerenter', () => { hovering = true; start(); });
+    form.addEventListener('pointerleave', () => { hovering = false; start(); });
+    form.addEventListener('focusin', () => { focused = true; start(); });
+    form.addEventListener('focusout', (e) => { focused = form.contains(e.relatedTarget); start(); });
+
+    // Drag on the empty canvas to rotate (the form is left to its own events).
+    let dragX = 0, dragLast = 0;
+    canvas.addEventListener('pointerdown', (e) => {
+      if (e.target !== canvas || e.button !== 0) return;
+      dragging = true;
+      dragX = e.clientX; dragLast = performance.now(); velocity = 0;
+      canvas.setPointerCapture(e.pointerId);
+      canvas.classList.add('is-dragging');
+      start();
+    });
+    canvas.addEventListener('pointermove', (e) => {
+      if (!dragging) return;
+      const dx = e.clientX - dragX;
+      const now = performance.now();
+      const dt = Math.max(now - dragLast, 1) / 1000;
+      angle += dx * 0.012;
+      velocity = (dx * 0.012) / dt;
+      dragX = e.clientX; dragLast = now;
+    });
+    const endDrag = (e) => {
+      if (!dragging) return;
+      dragging = false;
+      canvas.classList.remove('is-dragging');
+      if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
+    };
+    canvas.addEventListener('pointerup', endDrag);
+    canvas.addEventListener('pointercancel', endDrag);
+
+    // Pause the loop when the stage is off-screen or the tab is hidden.
+    new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; start(); }, { threshold: 0.05 })
+      .observe(stage);
+    document.addEventListener('visibilitychange', start);
+
+    function requestRender() { renderOnce = true; start(); }
+
+    function start() {
+      if (rafId || document.hidden || !inView) return;
+      lastTime = performance.now();
+      rafId = requestAnimationFrame(frame);
+    }
+
+    function frame(now) {
+      rafId = 0;
+      const dt = Math.min((now - lastTime) / 1000, 0.1);
+      lastTime = now;
+
+      const engaged = hovering || focused;
+      let moving = false;
+      if (dragging) {
+        moving = true;
+      } else if (engaged) {
+        // Ease to the nearest front-facing orientation.
+        const target = Math.round(angle / TAU) * TAU;
+        const diff = target - angle;
+        angle += diff * Math.min(1, dt * 7);
+        moving = Math.abs(diff) > 0.0005;
+      } else if (Math.abs(velocity) > 0.05) {
+        angle += velocity * dt;
+        velocity *= Math.exp(-dt * 3);
+        moving = true;
+      } else if (autoSpin) {
+        angle += spinSpeed * dt;
+        moving = true;
+      }
+
+      box.rotation.y = angle;
+      box.position.y = autoSpin && !engaged ? Math.sin(now / 1400) * 0.04 : box.position.y * 0.9;
+      box.updateMatrixWorld();
+
+      interactions.update();     // aligns the real DOM form with the 3D face
+      syncElementGeometry();
+      if (hasHtmlInCanvas) canvas.requestPaint();   // keeps the HTML texture fresh
+      renderer.render(scene, camera);
+
+      const bobbing = autoSpin && !engaged;
+      // In native mode the texture only refreshes from the loop, so keep it
+      // running while the visitor is typing or hovering.
+      const liveTexture = hasHtmlInCanvas && engaged;
+      if ((moving || bobbing || liveTexture || renderOnce) && !document.hidden && inView) {
+        renderOnce = false;
+        rafId = requestAnimationFrame(frame);
+      }
+    }
+
+    start();
+
+    // ----- Form behaviour ----------------------------------------------------
+    function wireForm() {
+      const qty = document.getElementById('box-qty');
+      const submit = document.getElementById('box-submit');
+      const status = document.getElementById('box-status');
+
+      const updatePrice = () => {
+        const n = Math.min(12, Math.max(1, parseInt(qty.value, 10) || 1));
+        submit.textContent = `Add ${n} ${n === 1 ? 'box' : 'boxes'} · $${n * PRICE}`;
+      };
+      document.getElementById('qty-minus').addEventListener('click', () => {
+        qty.stepDown(); qty.dispatchEvent(new Event('input', { bubbles: true }));
+      });
+      document.getElementById('qty-plus').addEventListener('click', () => {
+        qty.stepUp(); qty.dispatchEvent(new Event('input', { bubbles: true }));
+      });
+      qty.addEventListener('input', () => { qty.setCustomValidity(''); updatePrice(); });
+      qty.addEventListener('invalid', () => qty.setCustomValidity('Choose between 1 and 12 boxes.'));
+      updatePrice();
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        status.textContent = '';
+        if (!form.checkValidity()) {
+          form.reportValidity();
+          return;
+        }
+        const data = new FormData(form);
+        const n = parseInt(data.get('quantity'), 10);
+        submit.disabled = true;                      // prevent double submission
+        status.textContent = `Added ${n} × Dark Roast (${data.get('grind').toLowerCase()}) to your bag. Pickup code sent to ${data.get('email')}.`;
+        setTimeout(() => { submit.disabled = false; }, 1500);
+      });
+    }
+  </script>
+
 </body>
 
