+    // Only render while the section is near the viewport; a single rAF id guards against
+    // starting a second loop.
+    let visible = true;
+    let last = performance.now();
+    let rafId = 0;
+
+    function start() {
+      if (rafId) return;
+      last = performance.now();
+      rafId = requestAnimationFrame(tick);
+    }
+
+    new IntersectionObserver(([entry]) => {
+      visible = entry.isIntersecting;
+      if (visible) start();
+    }, { rootMargin: '100px' }).observe(container);
+
+    function tick(now) {
+      rafId = 0;
+      if (!visible) return;
+      const dt = Math.min(0.05, (now - last) / 1000);
+      last = now;
+
+      if (!dragging) {
+        if (targetAngle !== null) {
+          const diff = targetAngle - angle;
+          angle += diff * Math.min(1, dt * 4.5);
+          if (Math.abs(diff) < 0.002) { angle = targetAngle; targetAngle = null; }
+          velocity = 0;
+        } else {
+          const want = (hovering || focused || reducedMotion) ? 0 : 0.55;
+          velocity += (want - velocity) * Math.min(1, dt * 3);
+          angle += velocity * dt;
+        }
+      }
