+    const materials = [
+      cardboard(sideTex),    // +x
+      cardboard(sideTex),    // -x
+      cardboard(topTex),     // +y
+      cardboard(bottomTex),  // -y
+      holePunch,             // +z (front, carries the form)
+      cardboard(backTex),    // -z
