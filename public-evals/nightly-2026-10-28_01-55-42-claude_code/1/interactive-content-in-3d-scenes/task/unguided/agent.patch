+    document.getElementById('reserve-spin').addEventListener('click', () => {
+      const base = targetAngle ?? nearestFront(angle);
+      targetAngle = base + TWO_PI;
+    });
+
+    // ---------- Sizing & render loop ----------
+    function resize() {
+      const w = container.clientWidth;
+      const h = container.clientHeight;
+      if (!w || !h) return;
+      camera.aspect = w / h;
+      camera.updateProjectionMatrix();
+      glRenderer.setSize(w, h);
+      cssRenderer.setSize(w, h);
+    }
+    resize();
+    new ResizeObserver(resize).observe(container);
