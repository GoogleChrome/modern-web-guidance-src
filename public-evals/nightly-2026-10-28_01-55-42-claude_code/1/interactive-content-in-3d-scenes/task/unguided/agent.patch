+
+    // ---------- 3D scene ----------
+    let glRenderer;
+    try {
+      glRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
+    } catch (err) {
+      // No WebGL: leave the form in the static, centered layout.
+      throw err;
+    }
+
+    const scene = new THREE.Scene();
+    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
+    camera.position.set(0, 0.9, 7.5);
+    camera.lookAt(0, 0.1, 0);
+
+    glRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
+    glRenderer.setClearColor(0x000000, 0);
+    glRenderer.domElement.className = 'box-scene__gl';
+
+    const cssRenderer = new CSS3DRenderer();
+    cssRenderer.domElement.className = 'box-scene__css';
+
+    // CSS3D layer underneath, WebGL canvas on top. Both ignore the pointer so clicks land on
+    // the form (pointer-events: auto) or on the container (drag to rotate).
+    container.prepend(cssRenderer.domElement, glRenderer.domElement);
+    container.classList.add('is-3d');
+
+    scene.add(new THREE.HemisphereLight(0xfff4e6, 0x5d4037, 1.1));
+    const key = new THREE.DirectionalLight(0xffffff, 2.2);
+    key.position.set(4, 6, 5);
+    scene.add(key);
+    const rim = new THREE.DirectionalLight(0xffab40, 0.8);
+    rim.position.set(-5, 2, -4);
+    scene.add(rim);
+
+    // --- Textures: canvas-drawn packaging, with the stock beans photo composited in when it loads.
+    function makeCanvas(w, h) {
+      const c = document.createElement('canvas');
+      c.width = w;
+      c.height = h;
+      return [c, c.getContext('2d')];
+    }
+
+    function roundRect(ctx, x, y, w, h, r) {
+      ctx.beginPath();
+      ctx.moveTo(x + r, y);
+      ctx.arcTo(x + w, y, x + w, y + h, r);
+      ctx.arcTo(x + w, y + h, x, y + h, r);
+      ctx.arcTo(x, y + h, x, y, r);
+      ctx.arcTo(x, y, x + w, y, r);
+      ctx.closePath();
+    }
+
+    function paintPanel(ctx, w, h, beans, { title, subtitle }) {
+      ctx.fillStyle = '#3e2723';
+      ctx.fillRect(0, 0, w, h);
+
+      // subtle kraft-paper grain
+      ctx.fillStyle = 'rgba(255,255,255,0.03)';
+      for (let i = 0; i < 400; i++) {
+        ctx.fillRect(Math.random() * w, Math.random() * h, 2, 2);
+      }
+
+      const pad = Math.round(w * 0.08);
+      const bandTop = Math.round(h * 0.22);
+      const bandH = Math.round(h * 0.5);
+
+      ctx.save();
+      roundRect(ctx, pad, bandTop, w - pad * 2, bandH, Math.round(w * 0.04));
+      ctx.clip();
+      if (beans) {
+        const scale = Math.max((w - pad * 2) / beans.width, bandH / beans.height);
+        const dw = beans.width * scale, dh = beans.height * scale;
+        ctx.drawImage(beans, pad + (w - pad * 2 - dw) / 2, bandTop + (bandH - dh) / 2, dw, dh);
+      } else {
+        ctx.fillStyle = '#5d4037';
+        ctx.fillRect(pad, bandTop, w - pad * 2, bandH);
+      }
+      ctx.restore();
+
+      ctx.strokeStyle = '#ffab40';
+      ctx.lineWidth = Math.max(2, w * 0.006);
+      roundRect(ctx, pad, bandTop, w - pad * 2, bandH, Math.round(w * 0.04));
+      ctx.stroke();
+
+      ctx.fillStyle = '#ffab40';
+      ctx.fillRect(pad, Math.round(h * 0.15), w - pad * 2, Math.max(2, h * 0.004));
+
+      ctx.textAlign = 'center';
+      ctx.textBaseline = 'middle';
+      ctx.fillStyle = '#fff8f1';
+      ctx.font = `700 ${Math.round(w * 0.09)}px "Segoe UI", Tahoma, sans-serif`;
+      ctx.fillText(title, w / 2, h * 0.09, w - pad * 2);
+      ctx.fillStyle = '#d7ccc8';
+      ctx.font = `${Math.round(w * 0.055)}px "Segoe UI", Tahoma, sans-serif`;
+      ctx.fillText(subtitle, w / 2, h * 0.82, w - pad * 2);
+      ctx.fillStyle = '#ffab40';
+      ctx.font = `600 ${Math.round(w * 0.05)}px "Segoe UI", Tahoma, sans-serif`;
+      ctx.fillText('WHOLE BEAN · 12 OZ', w / 2, h * 0.9, w - pad * 2);
+    }
+
+    function paintTop(ctx, w, h, label) {
+      ctx.fillStyle = '#4e342e';
+      ctx.fillRect(0, 0, w, h);
+      ctx.strokeStyle = '#ffab40';
+      ctx.lineWidth = 4;
+      ctx.setLineDash([14, 10]);
+      ctx.strokeRect(w * 0.06, h * 0.12, w * 0.88, h * 0.76);
+      ctx.setLineDash([]);
+      ctx.textAlign = 'center';
+      ctx.textBaseline = 'middle';
+      ctx.fillStyle = '#fff8f1';
+      ctx.font = `700 ${Math.round(h * 0.22)}px "Segoe UI", Tahoma, sans-serif`;
+      ctx.fillText(label, w / 2, h / 2, w * 0.8);
+    }
+
+    function canvasTexture(canvas) {
+      const tex = new THREE.CanvasTexture(canvas);
+      tex.colorSpace = THREE.SRGBColorSpace;
+      tex.anisotropy = Math.min(8, glRenderer.capabilities.getMaxAnisotropy());
+      return tex;
+    }
+
+    const faces = {
+      side: makeCanvas(256, 704),
+      back: makeCanvas(512, 672),
+      top: makeCanvas(512, 240),
+      bottom: makeCanvas(512, 240),
+    };
+
+    function paintAll(beans) {
+      paintPanel(faces.side[1], 256, 704, beans, { title: 'DAILY GRIND', subtitle: 'Small-batch roasted' });
+      paintPanel(faces.back[1], 512, 672, beans, { title: 'THE DAILY GRIND', subtitle: 'Ethically sourced · Locally roasted' });
+      paintTop(faces.top[1], 512, 240, 'OPEN HERE ▲');
+      paintTop(faces.bottom[1], 512, 240, 'THE DAILY GRIND');
+    }
+    paintAll(null);
+
+    const sideTex = canvasTexture(faces.side[0]);
+    const backTex = canvasTexture(faces.back[0]);
+    const topTex = canvasTexture(faces.top[0]);
+    const bottomTex = canvasTexture(faces.bottom[0]);
+
+    const cardboard = (map) => new THREE.MeshStandardMaterial({ map, roughness: 0.85, metalness: 0 });
