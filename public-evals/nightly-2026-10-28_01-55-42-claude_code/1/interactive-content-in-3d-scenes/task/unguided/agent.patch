+      box.rotation.y = angle;
+      box.position.y = reducedMotion ? 0 : Math.sin(now / 1400) * 0.05;
+
+      glRenderer.render(scene, camera);
+      cssRenderer.render(scene, camera);
+      rafId = requestAnimationFrame(tick);
+    }
+    start();
+  </script>
