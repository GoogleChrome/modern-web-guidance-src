+    // ---------- Interaction: auto-spin, pause on hover/focus, drag to rotate, button-driven spin ----------
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    let angle = 0;
+    let velocity = 0;
+    let targetAngle = null;
+    let hovering = false;
+    let focused = false;
+    let dragging = false;
+    let dragLastX = 0;
+    let dragMoved = 0;
+
+    const nearestFront = (a) => Math.round(a / TWO_PI) * TWO_PI;
+
+    form.addEventListener('pointerenter', () => { hovering = true; });
