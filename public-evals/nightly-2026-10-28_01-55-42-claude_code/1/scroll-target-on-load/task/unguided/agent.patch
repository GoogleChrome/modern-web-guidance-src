+
+    /* Vertical scroll container of media cards */
+    .scroller-section {
+      margin-top: 60px;
+    }
+
+    .scroller-section h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .scroller {
+      position: relative;
+      height: 440px;
+      overflow-y: auto;
+      overflow-x: hidden;
+      /* Never animate programmatic scrolling in this container */
+      scroll-behavior: auto;
+      overscroll-behavior: contain;
+      padding: 16px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.08);
+      scrollbar-gutter: stable;
+    }
+
+    /* Hidden until the initial scroll offset has been applied, so the
+       user never sees the list jump from the first card to the target. */
+    .scroller[data-pending] {
+      visibility: hidden;
+    }
+
+    .media-card {
+      display: flex;
+      gap: 20px;
+      align-items: center;
+      background: var(--light);
+      border-radius: 8px;
+      padding: 16px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .media-card + .media-card {
+      margin-top: 16px;
+    }
+
+    .media-card img {
+      flex: none;
+      width: 240px;
+      height: 160px;
+      object-fit: cover;
+      border-radius: 6px;
+      background: var(--secondary);
+    }
+
+    .media-card h3 {
+      margin-bottom: 8px;
+      color: var(--primary);
+    }
+
+    .media-card.target {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
+    @media (max-width: 600px) {
+      .media-card {
+        flex-direction: column;
+        align-items: stretch;
+      }
+
+      .media-card img {
+        width: 100%;
+        height: auto;
+        aspect-ratio: 3 / 2;
+      }
+    }
   </style>
+  <noscript>
+    <style>
+      .scroller[data-pending] {
+        visibility: visible;
+      }
+    </style>
+  </noscript>
 </head>
 
