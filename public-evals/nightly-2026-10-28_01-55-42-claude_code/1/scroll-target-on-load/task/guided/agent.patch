+  <script>
+    // Fallback for browsers without CSS scroll-initial-target (Firefox, Safari).
+    // Runs synchronously at the end of <body>, before first paint, so there is no
+    // visible jump. Sets the container's scrollTop directly rather than using
+    // scrollIntoView(), which would also scroll the page itself.
+    if (!CSS.supports("scroll-initial-target", "nearest")) {
+      const feed = document.querySelector(".feed");
+      const target = feed && feed.querySelector(".target");
+      if (target) {
+        feed.scrollTop = target.offsetTop - (feed.clientHeight - target.offsetHeight) / 2;
+      }
+    }
+  </script>
