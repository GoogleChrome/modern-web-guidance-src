+  <script>
+    (function () {
+      var form = document.getElementById('subscription-form');
+      var email = document.getElementById('sub-email');
+      var roast = document.getElementById('roast-level');
+      var roastOutput = document.getElementById('roast-output');
+      var progress = document.getElementById('setup-progress');
+      var progressCount = document.getElementById('progress-count');
+      var frequency = form.elements.namedItem('frequency');
+
+      var ROAST_NAMES = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      var roastTouched = false;
+
+      function updateRoast() {
+        var value = Number(roast.value);
+        var name = ROAST_NAMES[value - 1] || String(value);
+        var pct = ((value - roast.min) / (roast.max - roast.min)) * 100;
+        roastOutput.value = name;
+        roast.setAttribute('aria-valuetext', name);
+        roast.style.setProperty('--pct', pct + '%');
+      }
+
+      function updateProgress() {
+        var done = 0;
+        if (email.value.trim() !== '' && email.validity.valid) done += 1;
+        if (frequency && frequency.value) done += 1;
+        if (roastTouched) done += 1;
+        progress.value = done;
+        progressCount.textContent = done + ' of ' + progress.max;
+      }
+
+      roast.addEventListener('input', function () {
+        roastTouched = true;
+        updateRoast();
+        updateProgress();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
