+  <script>
+    (() => {
+      const form = document.getElementById('subscription-form');
+      const progress = document.getElementById('setup-progress');
+      const status = document.getElementById('setup-progress-status');
+      const roast = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-value');
+
+      const ROAST_NAMES = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      const TOTAL_STEPS = Number(progress.max);
+      let roastReviewed = false;
+      let confirmed = false;
+
+      function describeRoast() {
+        const name = ROAST_NAMES[roast.valueAsNumber - 1] || roast.value;
+        roastOutput.value = name;
+        roast.setAttribute('aria-valuetext', name);
+      }
+
+      function updateProgress() {
+        let done = 0;
+        // RadioNodeList.value is "" until one radio is checked
+        if (form.elements.frequency.value) done += 1;
+        if (roastReviewed) done += 1;
+        if (confirmed) done += 1;
+
+        progress.value = done;
+        status.textContent = done === TOTAL_STEPS
+          ? 'All set! Your subscription is ready to start.'
+          : `${done} of ${TOTAL_STEPS} steps complete`;
+      }
+
+      function markRoastReviewed() {
+        roastReviewed = true;
+        updateProgress();
+      }
+
+      roast.addEventListener('input', () => {
+        describeRoast();
+        markRoastReviewed();
+      });
+      roast.addEventListener('focus', markRoastReviewed);
+      form.addEventListener('change', updateProgress);
+      form.addEventListener('submit', () => {
+        confirmed = true;
+        updateProgress();
+      });
+
+      // Fill the range track up to the thumb in WebKit browsers without accent-color
+      if (!(window.CSS && CSS.supports('accent-color', 'auto'))) {
+        const setFill = () => {
+          const min = Number(roast.min);
+          const max = Number(roast.max);
+          const pct = ((roast.valueAsNumber - min) / (max - min)) * 100;
+          roast.style.setProperty('--progress', `${pct}%`);
+        };
+        roast.addEventListener('input', setFill);
+        setFill();
+      }
+
+      // Re-sync after the browser restores form values (back navigation, reload)
+      const sync = () => {
+        describeRoast();
+        updateProgress();
+      };
+      window.addEventListener('pageshow', sync);
+      sync();
+    })();
+  </script>
