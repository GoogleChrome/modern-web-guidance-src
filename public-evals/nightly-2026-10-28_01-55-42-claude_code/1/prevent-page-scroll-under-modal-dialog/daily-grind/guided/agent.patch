+      overflow: hidden;
+      overscroll-behavior: contain;
       background: rgba(0, 0, 0, 0.5);
     }
   </style>
@@ -230,10 +231,15 @@
 
   <script>
     const noticeDialog = document.getElementById("notice-dialog");
+    const closeNotice = document.getElementById("close-notice");
     if (noticeDialog) {
-      noticeDialog.show();
-      document.body.classList.add("modal-open");
-      document.body.style.overflow = "hidden";
+      // showModal() puts the dialog in the top layer with a ::backdrop and
+      // makes the rest of the page inert. Background scroll locking is
+      // handled in CSS via overscroll-behavior on dialog:modal/::backdrop,
+      // so <body> styles are left untouched (no scrollbar removal, no
+      // layout shift, no scroll-position jump).
+      noticeDialog.showModal();
+      closeNotice?.addEventListener("click", () => noticeDialog.close());
     }
   </script>
