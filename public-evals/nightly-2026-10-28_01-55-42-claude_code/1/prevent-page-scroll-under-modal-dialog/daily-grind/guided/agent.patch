--- a/index.html
+++ b/index.html
@@ -153,17 +153,18 @@
       font-size: 0.85rem;
     }
 
-    body.modal-open {
-      overflow: hidden;
-      position: fixed;
-    }
-
-    dialog {
-      overflow: visible;
+    dialog:modal {
+      /* Keep scroll gestures inside the dialog from chaining to the page,
+         even when the dialog's own content does not overflow. */
+      overscroll-behavior: contain;
     }
 
