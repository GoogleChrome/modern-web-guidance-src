+  <script>
+    (() => {
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const nodes = Array.from(document.querySelectorAll('[data-translate]'));
+      const SOURCE_LANG = document.documentElement.lang || 'en';
+      const originals = new Map(nodes.map((el) => [el, el.textContent.trim().replace(/\s+/g, ' ')]));
+      const translators = new Map();
+      let requestId = 0;
+
+      const setStatus = (text, state) => {
+        status.textContent = text;
+        if (state) status.dataset.state = state;
+        else delete status.dataset.state;
+      };
+
+      const restoreOriginal = () => {
+        for (const [el, text] of originals) {
+          el.textContent = text;
+          el.removeAttribute('lang');
+        }
+      };
+
+      if (!('Translator' in self)) {
+        select.disabled = true;
+        select.title = 'On-device translation is not supported in this browser.';
+        setStatus('Translation unavailable in this browser', 'error');
+        return;
+      }
+
+      const getTranslator = async (targetLanguage) => {
+        if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+
+        const options = { sourceLanguage: SOURCE_LANG, targetLanguage };
+        const availability = await Translator.availability(options);
+        if (availability === 'unavailable') {
+          throw new Error('This language pair is not available on this device.');
+        }
+        if (availability !== 'available') {
+          setStatus('Downloading language pack… 0%');
+        }
+
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              setStatus(`Downloading language pack… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+        translators.set(targetLanguage, translator);
+        return translator;
+      };
+
+      const translatePage = async (targetLanguage) => {
+        const myRequest = ++requestId;
+        if (targetLanguage === SOURCE_LANG) {
+          restoreOriginal();
+          setStatus('');
+          return;
+        }
+
+        document.body.setAttribute('data-translating', '');
+        select.setAttribute('aria-busy', 'true');
+        setStatus('Translating…');
+
+        try {
+          const translator = await getTranslator(targetLanguage);
+          if (myRequest !== requestId) return;
+
+          const results = await Promise.all(
+            nodes.map((el) => translator.translate(originals.get(el)))
+          );
+          if (myRequest !== requestId) return;
+
+          nodes.forEach((el, i) => {
+            el.textContent = results[i];
+            el.lang = targetLanguage;
+          });
+          setStatus('Translated on your device');
+        } catch (err) {
+          if (myRequest !== requestId) return;
+          console.warn('Translation failed:', err);
+          restoreOriginal();
+          select.value = SOURCE_LANG;
+          const message = err && err.name === 'NotAllowedError'
+            ? 'Please choose a language again to start the download.'
+            : 'Translation unavailable for this language.';
+          setStatus(message, 'error');
+        } finally {
+          if (myRequest === requestId) {
+            document.body.removeAttribute('data-translating');
+            select.removeAttribute('aria-busy');
+          }
+        }
+      };
+
+      select.addEventListener('change', () => translatePage(select.value));
+    })();
+  </script>
+
 </body>
 
