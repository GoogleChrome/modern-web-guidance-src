diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..60f5105
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,430 @@
+/**
+ * On-device article translation engine for The DevTools Times.
+ *
+ * Translates every element marked with `data-translate` using Chrome's
+ * built-in Translator API (and LanguageDetector API, when available).
+ * Nothing leaves the browser: models are downloaded once and run locally.
+ *
+ * The engine is a tiny module-level store so that several controls on the
+ * same page (header + article action row) share one piece of state.
+ */
+
+export const ORIGINAL_LANGUAGE = 'original';
+
+export type TranslationState =
+  | 'idle'          // showing original text
+  | 'unsupported'   // browser has no Translator API
+  | 'checking'      // asking the browser whether the language pair is available
+  | 'downloading'   // language model is being downloaded
+  | 'translating'   // text nodes are being rewritten
+  | 'translated'    // page shows the target language
+  | 'error';
+
+export interface TranslationStatus {
+  state: TranslationState;
+  /** Language the page was authored in (BCP 47), detected on first use. */
+  sourceLanguage: string;
+  /** Currently requested language, or ORIGINAL_LANGUAGE. */
+  targetLanguage: string;
+  /** 0..1 progress for downloading / translating. */
+  progress: number;
+  /** Human readable error / hint, when state is 'error' or 'unsupported'. */
+  message?: string;
+}
+
+export interface LanguageOption {
+  code: string;
+  label: string;
+}
+
+const STORAGE_KEY = 'devtools-times:translation-target';
+const TRANSLATABLE_SELECTOR = '[data-translate]';
+const SKIPPED_TAGS = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'CODE', 'PRE', 'KBD', 'SAMP', 'TEXTAREA', 'SVG', 'MATH']);
+const CONCURRENCY = 4;
+
+/** Languages offered in the control. Chrome ships Translator models for all of these. */
+const TARGET_LANGUAGE_CODES = [
+  'en', 'es', 'fr', 'de', 'it', 'pt', 'nl', 'pl', 'tr', 'ru', 'uk',
+  'ja', 'ko', 'zh', 'zh-Hant', 'hi', 'bn', 'ar', 'vi', 'th', 'id',
+];
+
+const listeners = new Set<(status: TranslationStatus) => void>();
+
+let status: TranslationStatus = {
+  state: 'idle',
+  sourceLanguage: 'en',
+  targetLanguage: ORIGINAL_LANGUAGE,
+  progress: 0,
+};
+
+/** Text node -> text as authored. Recorded before the first translation. */
+const originalText = new WeakMap<Text, string>();
+/** Text node -> language code the node currently displays. */
+const displayedLanguage = new WeakMap<Text, string>();
+
+const translators = new Map<string, TranslatorInstance>();
+let detectedSource: string | null = null;
+let queue: Promise<void> = Promise.resolve();
+let requestedTarget: string | null = null;
+let autoTranslateInstalled = false;
+
+// ---------------------------------------------------------------------------
+// Public API
+// ---------------------------------------------------------------------------
+
+export function isBrowser(): boolean {
+  return typeof window !== 'undefined' && typeof document !== 'undefined';
+}
+
+export function isTranslationSupported(): boolean {
+  return isBrowser() && typeof window.Translator !== 'undefined';
+}
+
+export function getStatus(): TranslationStatus {
+  return status;
+}
+
+export function subscribe(listener: (status: TranslationStatus) => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function getStoredTargetLanguage(): string {
+  if (!isBrowser()) return ORIGINAL_LANGUAGE;
+  try {
+    return window.localStorage.getItem(STORAGE_KEY) || ORIGINAL_LANGUAGE;
+  } catch {
+    return ORIGINAL_LANGUAGE;
+  }
+}
+
+/** Builds the language list with names in the reader's own UI language. */
+export function getLanguageOptions(uiLocale?: string): LanguageOption[] {
+  const locale = uiLocale || (isBrowser() ? navigator.language : 'en');
+  let displayNames: Intl.DisplayNames | undefined;
+  try {
+    displayNames = new Intl.DisplayNames([locale], { type: 'language' });
+  } catch {
+    displayNames = undefined;
+  }
+  return TARGET_LANGUAGE_CODES
+    .map((code) => ({ code, label: displayNames?.of(code) || code }))
+    .sort((a, b) => a.label.localeCompare(b.label, locale));
+}
+
+export function getLanguageName(code: string, uiLocale?: string): string {
+  if (code === ORIGINAL_LANGUAGE) return 'Original';
+  try {
+    const locale = uiLocale || (isBrowser() ? navigator.language : 'en');
+    return new Intl.DisplayNames([locale], { type: 'language' }).of(code) || code;
+  } catch {
+    return code;
+  }
+}
+
+/**
+ * Switches the page to `target` (a BCP 47 code or ORIGINAL_LANGUAGE),
+ * remembers the choice, and translates every `[data-translate]` element.
+ * Should be called from a user gesture the first time a model needs downloading.
+ */
+export function setTargetLanguage(target: string): Promise<void> {
+  if (!isBrowser()) return Promise.resolve();
+  try {
+    if (target === ORIGINAL_LANGUAGE) {
+      window.localStorage.removeItem(STORAGE_KEY);
+    } else {
+      window.localStorage.setItem(STORAGE_KEY, target);
+    }
+  } catch {
+    // Private mode or storage disabled: translation still works for this page.
+  }
+  return applyToDocument(target);
+}
+
+/**
+ * Re-applies the stored language to the current document. Used after the
+ * ClientRouter swaps in a new page so teasers and articles stay translated.
+ */
+export function applyToDocument(target: string = getStoredTargetLanguage()): Promise<void> {
+  if (!isBrowser()) return Promise.resolve();
+  requestedTarget = target;
+  queue = queue
+    .then(() => runTranslation(target))
+    .catch((error) => {
+      console.error('[translation] unexpected failure', error);
+      setStatus({ state: 'error', message: describeError(error), progress: 0 });
+    });
+  return queue;
+}
+
+/** Hooks page lifecycle so a stored language survives client-side navigation. */
+export function installAutoTranslate(): void {
+  if (!isBrowser() || autoTranslateInstalled) return;
+  autoTranslateInstalled = true;
+
+  const reapply = () => {
+    // The swapped-in document has fresh text nodes, so drop the cached detection
+    // only if the document language changed.
+    const htmlLang = document.documentElement.lang?.split('-')[0];
+    if (htmlLang && detectedSource && htmlLang !== detectedSource) {
+      detectedSource = null;
+    }
+    const stored = getStoredTargetLanguage();
+    if (stored !== ORIGINAL_LANGUAGE) {
+      void applyToDocument(stored);
+    } else if (status.state !== 'idle' && status.state !== 'unsupported') {
+      setStatus({ state: 'idle', targetLanguage: ORIGINAL_LANGUAGE, progress: 0, message: undefined });
+    }
+  };
+
+  document.addEventListener('astro:page-load', reapply);
+  if (document.readyState === 'complete' || document.readyState === 'interactive') {
+    reapply();
+  } else {
+    document.addEventListener('DOMContentLoaded', reapply, { once: true });
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Internals
+// ---------------------------------------------------------------------------
+
+function setStatus(patch: Partial<TranslationStatus>): void {
+  status = { ...status, ...patch };
+  for (const listener of listeners) {
+    listener(status);
+  }
+}
+
+function describeError(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') {
+      return 'Pick the language again to allow the model download.';
+    }
+    if (error.name === 'NotSupportedError') {
+      return 'This language pair is not supported on this device.';
+    }
+    if (error.name === 'QuotaExceededError') {
+      return 'Not enough storage to download the language model.';
+    }
+  }
+  if (error instanceof Error && error.message) return error.message;
+  return 'Translation failed.';
+}
+
+async function runTranslation(target: string): Promise<void> {
+  if (requestedTarget !== target) return; // superseded while waiting in the queue
+
+  const source = await detectSourceLanguage();
+  if (requestedTarget !== target) return;
+
+  if (target === ORIGINAL_LANGUAGE || baseLanguage(target) === baseLanguage(source)) {
+    restoreOriginals();
+    setStatus({ state: 'idle', sourceLanguage: source, targetLanguage: target, progress: 0, message: undefined });
+    return;
+  }
+
+  if (!isTranslationSupported()) {
+    setStatus({
+      state: 'unsupported',
+      sourceLanguage: source,
+      targetLanguage: target,
+      progress: 0,
+      message: 'On-device translation needs a browser with the built-in Translator API, such as Chrome 138 or newer.',
+    });
+    return;
+  }
+
+  setStatus({ state: 'checking', sourceLanguage: source, targetLanguage: target, progress: 0, message: undefined });
+
+  let translator: TranslatorInstance;
+  try {
+    translator = await getTranslator(source, target);
+  } catch (error) {
+    if (requestedTarget === target) {
+      setStatus({ state: 'error', progress: 0, message: describeError(error) });
+    }
+    return;
+  }
+  if (requestedTarget !== target) return;
+
+  const nodes = collectTextNodes().filter((node) => displayedLanguage.get(node) !== target);
+  if (nodes.length === 0) {
+    setStatus({ state: 'translated', progress: 1 });
+    return;
+  }
+
+  setStatus({ state: 'translating', progress: 0 });
+
+  let completed = 0;
+  let cancelled = false;
+  let firstError: unknown = null;
+
+  const worker = async () => {
+    while (nodes.length > 0 && !cancelled) {
+      const node = nodes.shift()!;
+      if (requestedTarget !== target) {
+        cancelled = true;
+        return;
+      }
+      try {
+        await translateNode(node, translator, target);
+      } catch (error) {
+        firstError ??= error;
+      }
+      completed += 1;
+      if (!cancelled && requestedTarget === target) {
+        setStatus({ progress: completed / (completed + nodes.length) });
+      }
+    }
+  };
+
+  await Promise.all(Array.from({ length: CONCURRENCY }, worker));
+
+  if (cancelled || requestedTarget !== target) return;
+  if (firstError) {
+    setStatus({ state: 'error', progress: 1, message: describeError(firstError) });
+    return;
+  }
+  setStatus({ state: 'translated', progress: 1 });
+}
+
+async function translateNode(node: Text, translator: TranslatorInstance, target: string): Promise<void> {
+  if (!node.isConnected) return;
+  if (!originalText.has(node)) {
+    originalText.set(node, node.data);
+  }
+  const source = originalText.get(node)!;
+  const match = /^(\s*)([\s\S]*?)(\s*)$/.exec(source);
+  const [, leading = '', body = '', trailing = ''] = match || [];
+  if (!body) return;
+
+  const translated = await translator.translate(body);
+  if (!node.isConnected) return;
+  node.data = `${leading}${translated}${trailing}`;
+  displayedLanguage.set(node, target);
+}
+
+function restoreOriginals(): void {
+  for (const node of collectTextNodes()) {
+    const original = originalText.get(node);
+    if (original !== undefined && node.data !== original) {
+      node.data = original;
+    }
+    displayedLanguage.delete(node);
+  }
+}
+
+function collectTextNodes(): Text[] {
+  const seen = new Set<Text>();
+  const result: Text[] = [];
+  const roots = document.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR);
+
+  for (const root of roots) {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        const parent = node.parentElement;
+        if (!parent) return NodeFilter.FILTER_REJECT;
+        if (parent.closest('[data-translate="false"], [translate="no"]')) return NodeFilter.FILTER_REJECT;
+        for (let el: HTMLElement | null = parent; el && el !== root; el = el.parentElement) {
+          if (SKIPPED_TAGS.has(el.tagName.toUpperCase())) return NodeFilter.FILTER_REJECT;
+        }
+        return /\S/.test((node as Text).data) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
+      },
+    });
+    let current = walker.nextNode() as Text | null;
+    while (current) {
+      if (!seen.has(current)) {
+        seen.add(current);
+        result.push(current);
+      }
+      current = walker.nextNode() as Text | null;
+    }
+  }
+  return result;
+}
+
+function baseLanguage(code: string): string {
+  return code.toLowerCase().split('-')[0];
+}
+
+async function getTranslator(source: string, target: string): Promise<TranslatorInstance> {
+  const key = `${source}>${target}`;
+  const cached = translators.get(key);
+  if (cached) return cached;
+
+  const Translator = window.Translator!;
+  const availability = await Translator.availability({ sourceLanguage: source, targetLanguage: target });
+  if (availability === 'unavailable') {
+    throw new DOMException(`Translation from ${source} to ${target} is unavailable.`, 'NotSupportedError');
+  }
+
+  if (availability !== 'available') {
+    setStatus({ state: 'downloading', progress: 0 });
+  }
+
+  const translator = await Translator.create({
+    sourceLanguage: source,
+    targetLanguage: target,
+    monitor(monitor) {
+      monitor.addEventListener('downloadprogress', (event) => {
+        if (requestedTarget === target) {
+          setStatus({ state: 'downloading', progress: event.loaded });
+        }
+      });
+    },
+  });
+
+  translators.set(key, translator);
+  return translator;
+}
+
+/**
+ * Works out what language the page is written in. Uses the on-device
+ * LanguageDetector when its model is already present, otherwise the
+ * document's `lang` attribute, and finally English.
+ */
+async function detectSourceLanguage(): Promise<string> {
+  if (detectedSource) return detectedSource;
+
+  const htmlLang = baseLanguage(document.documentElement.lang || '') || 'en';
+  const Detector = window.LanguageDetector;
+  if (!Detector) {
+    detectedSource = htmlLang;
+    return detectedSource;
+  }
+
+  try {
+    const availability = await Detector.availability();
+    if (availability !== 'available') {
+      // Do not trigger a second model download just for detection.
+      detectedSource = htmlLang;
+      return detectedSource;
+    }
+    const sample = collectTextNodes()
+      .map((node) => originalText.get(node) ?? node.data)
+      .join(' ')
+      .replace(/\s+/g, ' ')
+      .trim()
+      .slice(0, 1000);
+    if (!sample) {
+      detectedSource = htmlLang;
+      return detectedSource;
+    }
+    const detector = await Detector.create();
+    try {
+      const [best] = await detector.detect(sample);
+      detectedSource = best && best.confidence >= 0.5 && best.detectedLanguage !== 'und'
+        ? best.detectedLanguage
+        : htmlLang;
+    } finally {
+      detector.destroy();
+    }
+  } catch (error) {
+    console.warn('[translation] language detection failed, falling back to document language', error);
+    detectedSource = htmlLang;
+  }
+  return detectedSource;
+}
