diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..9372e5e
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,167 @@
+import React, { useEffect, useId, useMemo, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  ORIGINAL_LANGUAGE,
+  applyToDocument,
+  getLanguageName,
+  getLanguageOptions,
+  getStatus,
+  getStoredTargetLanguage,
+  installAutoTranslate,
+  isTranslationSupported,
+  setTargetLanguage,
+  subscribe,
+  type LanguageOption,
+  type TranslationStatus,
+} from '../utils/translation';
+
+interface Props {
+  /** `compact` fits the header toolbar; `inline` adds a status line for the article page. */
+  variant?: 'compact' | 'inline';
+}
+
+const SERVER_SAFE_OPTIONS: LanguageOption[] = getLanguageOptions('en');
+
+export default function TranslateControl({ variant = 'compact' }: Props) {
+  const selectId = useId();
+  const [status, setStatus] = useState<TranslationStatus>(() => getStatus());
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [options, setOptions] = useState<LanguageOption[]>(SERVER_SAFE_OPTIONS);
+  const [selected, setSelected] = useState<string>(ORIGINAL_LANGUAGE);
+  // Server render and first client render both use English names; the real UI locale is applied after mount.
+  const [uiLocale, setUiLocale] = useState<string>('en');
+
+  useEffect(() => {
+    setSupported(isTranslationSupported());
+    setOptions(getLanguageOptions());
+    setUiLocale(navigator.language || 'en');
+    setSelected(getStoredTargetLanguage());
+    const unsubscribe = subscribe((next) => {
+      setStatus(next);
+      setSelected(next.targetLanguage);
+    });
+    installAutoTranslate();
+    return unsubscribe;
+  }, []);
+
+  const handleChange = (event: React.ChangeEvent<HTMLSelectElement>) => {
+    const target = event.target.value;
+    setSelected(target);
+    void setTargetLanguage(target);
+  };
+
+  const handleRetry = () => {
+    void applyToDocument(selected);
+  };
+
+  const busy = status.state === 'checking' || status.state === 'downloading' || status.state === 'translating';
+  const sourceName = useMemo(() => getLanguageName(status.sourceLanguage, uiLocale), [status.sourceLanguage, uiLocale]);
+  const targetName = useMemo(() => getLanguageName(status.targetLanguage, uiLocale), [status.targetLanguage, uiLocale]);
+  const percent = Math.round(status.progress * 100);
+
+  const statusText = (() => {
+    switch (status.state) {
+      case 'unsupported':
+        return status.message ?? 'On-device translation is not available in this browser.';
+      case 'checking':
+        return `Preparing ${targetName} translation…`;
+      case 'downloading':
+        return `Downloading ${targetName} language model… ${percent}%`;
+      case 'translating':
+        return `Translating to ${targetName}… ${percent}%`;
+      case 'translated':
+        return `Translated from ${sourceName} to ${targetName} on your device.`;
+      case 'error':
+        return status.message ?? 'Translation failed.';
+      default:
+        return supported === false
+          ? 'On-device translation is not available in this browser.'
+          : 'Translate this page on your device. Nothing is sent to a server.';
+    }
+  })();
+
+  const select = (
+    <select
+      id={selectId}
+      value={selected}
+      onChange={handleChange}
+      disabled={supported === false}
+      aria-label="Translate articles to"
+      aria-busy={busy}
+      data-translate="false"
+      className={`bg-white border border-gray-300 text-gray-800 rounded focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50 disabled:cursor-not-allowed ${
+        variant === 'compact' ? 'text-xs py-1.5 pl-2 pr-6 max-w-36' : 'text-sm py-1.5 pl-2 pr-8'
+      }`}
+    >
+      <option value={ORIGINAL_LANGUAGE}>Original ({sourceName})</option>
+      {options.map((option) => (
+        <option key={option.code} value={option.code}>
+          {option.label}
+        </option>
+      ))}
+    </select>
+  );
+
+  const icon = busy ? (
+    <div
+      className={`border-2 border-amber-400 border-t-transparent rounded-full animate-spin ${variant === 'compact' ? 'w-4 h-4' : 'w-5 h-5'}`}
+      role="status"
+      aria-label="Translating"
+    />
+  ) : (
+    <LanguageIcon
+      className={`${variant === 'compact' ? 'w-5 h-5' : 'w-5 h-5'} ${status.state === 'translated' ? 'text-amber-400' : 'text-gray-600'}`}
+      aria-hidden="true"
+    />
+  );
+
+  if (variant === 'compact') {
+    return (
+      <div className="flex items-center space-x-1.5" title={statusText} data-translate="false">
+        <label htmlFor={selectId} className="flex items-center cursor-pointer">
+          {icon}
+          <span className="sr-only">Translate articles</span>
+        </label>
+        {select}
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex flex-col items-start sm:items-end gap-1 text-sm" data-translate="false">
+      <div className="flex items-center space-x-2">
+        <label htmlFor={selectId} className="flex items-center space-x-1.5 font-semibold text-gray-800 cursor-pointer">
+          {icon}
+          <span>Translate:</span>
+        </label>
+        {select}
+      </div>
+      <p
+        className={`text-xs ${status.state === 'error' ? 'text-red-600' : 'text-gray-500'}`}
+        aria-live="polite"
+      >
+        {statusText}
+        {status.state === 'error' && (
+          <>
+            {' '}
+            <button type="button" onClick={handleRetry} className="underline hover:text-amber-500">
+              Try again
+            </button>
+          </>
+        )}
+        {status.state === 'translated' && (
+          <>
+            {' '}
+            <button
+              type="button"
+              onClick={() => void setTargetLanguage(ORIGINAL_LANGUAGE)}
+              className="underline hover:text-amber-500"
+            >
+              Show original
+            </button>
+          </>
+        )}
+      </p>
+    </div>
+  );
+}
