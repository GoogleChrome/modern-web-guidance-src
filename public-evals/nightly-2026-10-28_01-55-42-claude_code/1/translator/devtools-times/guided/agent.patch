diff --git a/src/utils/translate-page.ts b/src/utils/translate-page.ts
new file mode 100644
index 0000000..1fd7a87
--- /dev/null
+++ b/src/utils/translate-page.ts
@@ -0,0 +1,296 @@
+/**
+ * Client-side helpers for translating marked page content with the browser's
+ * on-device Translator API (Chrome 138+ / Edge 148+, desktop only).
+ *
+ * Content opts in with a `data-translate` attribute. Every text node below such
+ * an element is translated individually so inline markup (links, emphasis,
+ * lists) survives untouched. Originals are remembered so the page can be
+ * restored or re-translated into another language from the English source.
+ */
+
+export type TranslatorAvailability =
+  | 'available'
+  | 'downloadable'
+  | 'downloading'
+  | 'unavailable';
+
+export interface TranslatorInstance {
+  translate(input: string): Promise<string>;
+  destroy?(): void;
+}
+
+interface LanguagePair {
+  sourceLanguage: string;
+  targetLanguage: string;
+}
+
+interface TranslatorCreateOptions extends LanguagePair {
+  monitor?(monitor: EventTarget): void;
+}
+
+interface TranslatorStatic {
+  availability(options: LanguagePair): Promise<TranslatorAvailability>;
+  create(options: TranslatorCreateOptions): Promise<TranslatorInstance>;
+}
+
+export interface TargetLanguage {
+  code: string;
+  label: string;
+}
+
+/** The site is authored in English. */
+export const SOURCE_LANGUAGE = 'en';
+
+export const TRANSLATABLE_SELECTOR = '[data-translate]';
+
+export const STORAGE_KEY = 'devtools-times:translate-target';
+
+/** Languages supported by Chrome's Translator implementation, labelled in their own language. */
+export const TARGET_LANGUAGES: TargetLanguage[] = [
+  { code: 'ar', label: 'العربية' },
+  { code: 'bn', label: 'বাংলা' },
+  { code: 'bg', label: 'Български' },
+  { code: 'zh', label: '中文（简体）' },
+  { code: 'zh-Hant', label: '中文（繁體）' },
+  { code: 'hr', label: 'Hrvatski' },
+  { code: 'cs', label: 'Čeština' },
+  { code: 'da', label: 'Dansk' },
+  { code: 'nl', label: 'Nederlands' },
+  { code: 'fi', label: 'Suomi' },
+  { code: 'fr', label: 'Français' },
+  { code: 'de', label: 'Deutsch' },
+  { code: 'el', label: 'Ελληνικά' },
+  { code: 'he', label: 'עברית' },
+  { code: 'hi', label: 'हिन्दी' },
+  { code: 'hu', label: 'Magyar' },
+  { code: 'id', label: 'Bahasa Indonesia' },
+  { code: 'it', label: 'Italiano' },
+  { code: 'ja', label: '日本語' },
+  { code: 'kn', label: 'ಕನ್ನಡ' },
+  { code: 'ko', label: '한국어' },
+  { code: 'lt', label: 'Lietuvių' },
+  { code: 'mr', label: 'मराठी' },
+  { code: 'no', label: 'Norsk' },
+  { code: 'pl', label: 'Polski' },
+  { code: 'pt', label: 'Português' },
+  { code: 'ro', label: 'Română' },
+  { code: 'ru', label: 'Русский' },
+  { code: 'sk', label: 'Slovenčina' },
+  { code: 'sl', label: 'Slovenščina' },
+  { code: 'es', label: 'Español' },
+  { code: 'sv', label: 'Svenska' },
+  { code: 'ta', label: 'தமிழ்' },
+  { code: 'te', label: 'తెలుగు' },
+  { code: 'th', label: 'ไทย' },
+  { code: 'tr', label: 'Türkçe' },
+  { code: 'uk', label: 'Українська' },
+  { code: 'vi', label: 'Tiếng Việt' },
+];
+
+/** Access the API only through the global `Translator` interface (never `window.ai`). */
+export function getTranslatorApi(): TranslatorStatic | null {
+  if (typeof self === 'undefined') return null;
+  const api = (self as unknown as { Translator?: TranslatorStatic }).Translator;
+  return api ?? null;
+}
+
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self;
+}
+
+export function isValidTargetLanguage(code: string | null | undefined): code is string {
+  return !!code && TARGET_LANGUAGES.some((language) => language.code === code);
+}
+
+/** Original English text of every text node we've touched, keyed by node. */
+const originals = new WeakMap<Text, string>();
+
+/** Translator sessions per target language; survive client-side navigations. */
+const translators = new Map<string, TranslatorInstance>();
+
+const SKIPPED_ANCESTORS = 'script, style, noscript, code, pre, kbd, samp, [translate="no"]';
+
+function collectTextNodes(root: ParentNode): Text[] {
+  const elements = Array.from(root.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR));
+  const seen = new Set<Text>();
+  const nodes: Text[] = [];
+
+  for (const element of elements) {
+    const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        const text = node as Text;
+        if (!text.data.trim()) return NodeFilter.FILTER_REJECT;
+        if (text.parentElement?.closest(SKIPPED_ANCESTORS)) return NodeFilter.FILTER_REJECT;
+        return NodeFilter.FILTER_ACCEPT;
+      },
+    });
+
+    let current = walker.nextNode();
+    while (current) {
+      const text = current as Text;
+      if (!seen.has(text)) {
+        seen.add(text);
+        nodes.push(text);
+      }
+      current = walker.nextNode();
+    }
+  }
+
+  return nodes;
+}
+
+function originalOf(node: Text): string {
+  let original = originals.get(node);
+  if (original === undefined) {
+    original = node.data;
+    originals.set(node, original);
+  }
+  return original;
+}
+
+/** Keep the surrounding whitespace of the original so inline runs don't collapse together. */
+function withEdgeWhitespace(original: string, translated: string): string {
+  const leading = original.match(/^\s*/)?.[0] ?? '';
+  const trailing = original.match(/\s*$/)?.[0] ?? '';
+  return `${leading}${translated.trim()}${trailing}`;
+}
+
+function markElements(root: ParentNode, lang: string | null): void {
+  for (const element of root.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR)) {
+    if (lang) {
+      element.lang = lang;
+      element.dataset.translated = lang;
+    } else {
+      element.removeAttribute('lang');
+      delete element.dataset.translated;
+    }
+  }
+}
+
+export function getCachedTranslator(targetLanguage: string): TranslatorInstance | undefined {
+  return translators.get(targetLanguage);
+}
+
+export async function checkAvailability(targetLanguage: string): Promise<TranslatorAvailability> {
+  const api = getTranslatorApi();
+  if (!api) return 'unavailable';
+  try {
+    return await api.availability({ sourceLanguage: SOURCE_LANGUAGE, targetLanguage });
+  } catch {
+    return 'unavailable';
+  }
+}
+
+export interface CreateTranslatorOptions {
+  /** Called with 0..1 while a language pack downloads. */
+  onDownloadProgress?(fraction: number): void;
+}
+
+/**
+ * Create (or reuse) a translator for the given target language.
+ * Must be called from a user gesture when the language pack still needs downloading.
+ */
+export async function getOrCreateTranslator(
+  targetLanguage: string,
+  { onDownloadProgress }: CreateTranslatorOptions = {},
+): Promise<TranslatorInstance> {
+  const cached = translators.get(targetLanguage);
+  if (cached) return cached;
+
+  const api = getTranslatorApi();
+  if (!api) {
+    throw new DOMException('The Translator API is not supported in this browser.', 'NotSupportedError');
+  }
+
+  const translator = await api.create({
+    sourceLanguage: SOURCE_LANGUAGE,
+    targetLanguage,
+    monitor(monitor) {
+      monitor.addEventListener('downloadprogress', (event) => {
+        const { loaded } = event as ProgressEvent;
+        onDownloadProgress?.(Math.min(1, Math.max(0, loaded)));
+      });
+    },
+  });
+
+  translators.set(targetLanguage, translator);
+  return translator;
+}
+
+export interface TranslateContentOptions {
+  root?: ParentNode;
+  signal?: AbortSignal;
+  /** Called after each text node finishes. */
+  onProgress?(done: number, total: number): void;
+  /** How many translations run concurrently. */
+  concurrency?: number;
+}
+
+/**
+ * Translate every `data-translate` region below `root` into the translator's
+ * target language. Returns the number of text nodes translated.
+ */
+export async function translateMarkedContent(
+  translator: TranslatorInstance,
+  targetLanguage: string,
+  { root = document, signal, onProgress, concurrency = 4 }: TranslateContentOptions = {},
+): Promise<number> {
+  const nodes = collectTextNodes(root);
+  const total = nodes.length;
+  if (total === 0) return 0;
+
+  let next = 0;
+  let done = 0;
+
+  const worker = async () => {
+    while (next < nodes.length) {
+      if (signal?.aborted) return;
+      const node = nodes[next++];
+      const original = originalOf(node);
+      const translated = await translator.translate(original);
+      if (signal?.aborted) return;
+      node.data = withEdgeWhitespace(original, translated);
+      done++;
+      onProgress?.(done, total);
+    }
+  };
+
+  await Promise.all(Array.from({ length: Math.min(concurrency, total) }, worker));
+
+  if (signal?.aborted) {
+    throw new DOMException('Translation aborted.', 'AbortError');
+  }
+
+  markElements(root, targetLanguage);
+  return done;
+}
+
+/** Put the original English text back into every translated region. */
+export function restoreOriginalContent(root: ParentNode = document): void {
+  for (const node of collectTextNodes(root)) {
+    const original = originals.get(node);
+    if (original !== undefined) node.data = original;
+  }
+  markElements(root, null);
+}
+
+export function readStoredTarget(): string | null {
+  try {
+    const stored = localStorage.getItem(STORAGE_KEY);
+    return isValidTargetLanguage(stored) ? stored : null;
+  } catch {
+    return null;
+  }
+}
+
+export function writeStoredTarget(targetLanguage: string | null): void {
+  try {
+    if (targetLanguage) {
+      localStorage.setItem(STORAGE_KEY, targetLanguage);
+    } else {
+      localStorage.removeItem(STORAGE_KEY);
+    }
+  } catch {
+    // Storage may be unavailable (private mode, blocked); the control still works for this page.
+  }
+}
