diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..64f471e
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,268 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  TARGET_LANGUAGES,
+  checkAvailability,
+  getCachedTranslator,
+  getOrCreateTranslator,
+  isTranslatorSupported,
+  readStoredTarget,
+  restoreOriginalContent,
+  translateMarkedContent,
+  writeStoredTarget,
+} from '../utils/translate-page';
+
+type Support = 'unknown' | 'supported' | 'unsupported';
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'checking' }
+  | { kind: 'downloading'; fraction: number }
+  | { kind: 'translating'; done: number; total: number }
+  | { kind: 'translated'; count: number }
+  | { kind: 'needs-gesture'; reason: 'downloadable' | 'downloading' }
+  | { kind: 'unavailable' }
+  | { kind: 'error'; message: string };
+
+const ORIGINAL = '';
+
+const UNSUPPORTED_HINT =
+  'On-device translation needs Chrome 138+ or Edge 148+ on desktop. No text ever leaves your device.';
+
+/**
+ * Header control that translates every `data-translate` region on the current
+ * page with the browser's built-in, on-device Translator API.
+ */
+export default function TranslateControl() {
+  const selectId = useId();
+  const progressId = useId();
+  const [support, setSupport] = useState<Support>('unknown');
+  const [target, setTarget] = useState<string>(ORIGINAL);
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+  const runRef = useRef<AbortController | null>(null);
+
+  const cancelRun = () => {
+    runRef.current?.abort();
+    runRef.current = null;
+  };
+
+  const runTranslation = async (language: string, fromGesture: boolean) => {
+    cancelRun();
+    const controller = new AbortController();
+    runRef.current = controller;
+    const live = () => runRef.current === controller;
+
+    try {
+      let translator = getCachedTranslator(language);
+
+      if (!translator) {
+        setStatus({ kind: 'checking' });
+        const availability = await checkAvailability(language);
+        if (!live()) return;
+
+        if (availability === 'unavailable') {
+          setStatus({ kind: 'unavailable' });
+          return;
+        }
+
+        // create() kicks off (or attaches to) a language-pack download, which the
+        // browser only allows from a user gesture. Without one, ask for a click.
+        if (availability !== 'available' && !fromGesture) {
+          setStatus({ kind: 'needs-gesture', reason: availability });
+          return;
+        }
+
+        if (availability !== 'available') {
+          setStatus({ kind: 'downloading', fraction: 0 });
+        }
+
+        translator = await getOrCreateTranslator(language, {
+          onDownloadProgress(fraction) {
+            if (live()) setStatus({ kind: 'downloading', fraction });
+          },
+        });
+        if (!live()) return;
+      }
+
+      setStatus({ kind: 'translating', done: 0, total: 0 });
+      const count = await translateMarkedContent(translator, language, {
+        signal: controller.signal,
+        onProgress(done, total) {
+          if (live()) setStatus({ kind: 'translating', done, total });
+        },
+      });
+      if (!live()) return;
+
+      setStatus({ kind: 'translated', count });
+    } catch (error) {
+      if (!live()) return;
+      const domError = error as DOMException;
+      if (domError?.name === 'AbortError') return;
+      if (domError?.name === 'NotAllowedError') {
+        setStatus({ kind: 'needs-gesture', reason: 'downloadable' });
+        return;
+      }
+      console.error('On-device translation failed:', error);
+      setStatus({
+        kind: 'error',
+        message: domError?.message || 'Translation failed. Please try again.',
+      });
+    } finally {
+      if (runRef.current === controller) runRef.current = null;
+    }
+  };
+
+  const showOriginal = () => {
+    cancelRun();
+    restoreOriginalContent();
+    setStatus({ kind: 'idle' });
+  };
+
+  // Feature-detect on mount and re-apply the reader's saved language on each page.
+  useEffect(() => {
+    if (!isTranslatorSupported()) {
+      setSupport('unsupported');
+      return;
+    }
+    setSupport('supported');
+
+    const stored = readStoredTarget();
+    if (stored) {
+      setTarget(stored);
+      void runTranslation(stored, false);
+    }
+
+    return cancelRun;
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const handleChange = (event: React.ChangeEvent<HTMLSelectElement>) => {
+    const language = event.target.value;
+    setTarget(language);
+    writeStoredTarget(language || null);
+
+    if (language === ORIGINAL) {
+      showOriginal();
+    } else {
+      void runTranslation(language, true);
+    }
+  };
+
+  const handleRetry = () => {
+    if (target) void runTranslation(target, true);
+  };
+
+  const disabled = support !== 'supported';
+  const busy =
+    status.kind === 'checking' || status.kind === 'downloading' || status.kind === 'translating';
+
+  return (
+    <div
+      className="flex items-center gap-2 text-xs text-gray-700"
+      title={support === 'unsupported' ? UNSUPPORTED_HINT : undefined}
+    >
+      <label htmlFor={selectId} className="flex items-center gap-1 whitespace-nowrap">
+        <LanguageIcon className="w-5 h-5 text-gray-600" aria-hidden="true" />
+        <span className="sr-only sm:not-sr-only">Translate</span>
+      </label>
+
+      <select
+        id={selectId}
+        value={target}
+        onChange={handleChange}
+        disabled={disabled}
+        aria-busy={busy || undefined}
+        aria-describedby={progressId}
+        className="max-w-36 rounded border border-gray-300 bg-white px-1.5 py-1 text-xs text-gray-800 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 disabled:cursor-not-allowed disabled:bg-gray-100 disabled:text-gray-400"
+      >
+        <option value={ORIGINAL}>Original (English)</option>
+        {TARGET_LANGUAGES.map((language) => (
+          <option key={language.code} value={language.code} lang={language.code}>
+            {language.label}
+          </option>
+        ))}
+      </select>
+
+      <span id={progressId} role="status" aria-live="polite" className="flex items-center gap-1.5 whitespace-nowrap">
+        <StatusView
+          support={support}
+          status={status}
+          onRetry={handleRetry}
+        />
+      </span>
+    </div>
+  );
+}
+
+interface StatusViewProps {
+  support: Support;
+  status: Status;
+  onRetry(): void;
+}
+
+function StatusView({ support, status, onRetry }: StatusViewProps) {
+  if (support === 'unsupported') {
+    return <span className="text-gray-400 hidden md:inline">Not available in this browser</span>;
+  }
+
+  switch (status.kind) {
+    case 'idle':
+      return null;
+    case 'checking':
+      return <span className="text-gray-500">Checking…</span>;
+    case 'downloading':
+      return (
+        <>
+          <span className="text-gray-500 hidden md:inline">Downloading language pack</span>
+          <progress
+            value={status.fraction}
+            max={1}
+            aria-label="Language pack download"
+            className="w-16 h-2 accent-amber-400"
+          />
+          <span className="tabular-nums text-gray-500">{Math.round(status.fraction * 100)}%</span>
+        </>
+      );
+    case 'translating':
+      return (
+        <>
+          <span
+            className="inline-block w-3 h-3 border-2 border-amber-400 border-t-transparent rounded-full animate-spin"
+            aria-hidden="true"
+          />
+          <span className="text-gray-500">
+            Translating{status.total > 0 ? ` ${status.done}/${status.total}` : '…'}
+          </span>
+        </>
+      );
+    case 'translated':
+      return (
+        <span className="text-gray-500 hidden md:inline">
+          {status.count > 0 ? 'Translated on device' : 'Nothing to translate here'}
+        </span>
+      );
+    case 'needs-gesture':
+      return (
+        <button
+          type="button"
+          onClick={onRetry}
+          className="rounded bg-amber-400 px-2 py-1 font-semibold text-white hover:bg-amber-500"
+        >
+          {status.reason === 'downloading' ? 'Resume download' : 'Download & translate'}
+        </button>
+      );
+    case 'unavailable':
+      return <span className="text-red-600">This language isn’t available on this device</span>;
+    case 'error':
+      return (
+        <>
+          <span className="text-red-600 truncate max-w-48" title={status.message}>
+            {status.message}
+          </span>
+          <button type="button" onClick={onRetry} className="underline hover:text-amber-600">
+            Retry
+          </button>
+        </>
+      );
+  }
+}
