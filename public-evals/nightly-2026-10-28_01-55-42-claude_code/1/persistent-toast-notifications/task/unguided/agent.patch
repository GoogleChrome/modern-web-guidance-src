+    /* ------------------------------------------------------------------
+       Toast notifications
+       - Each toast is a `popover="manual"` element, so the browser puts it
+         in the top layer: it paints above everything (sticky nav, modals,
+         transforms...) without any z-index.
+       - Stacking uses CSS anchor positioning: every toast exposes the same
+         anchor-name, and a toast anchors to the *last preceding* toast,
+         sitting just above it. No wrapper container, no JS measurements.
+       ------------------------------------------------------------------ */
+    .toast {
+      --toast-edge: 24px;
+      --toast-gap: 12px;
+      --toast-duration: 320ms;
+
+      /* reset popover UA defaults */
+      inset: auto;
+      margin: 0;
+      border: 0;
+      padding: 0;
+      overflow: visible;
+      width: fit-content;
+      height: fit-content;
+      color: inherit;
+      background: transparent;
+
+      /* bottom-right anchoring */
+      position: fixed;
+      right: var(--toast-edge);
+      anchor-name: --toast;
+      position-anchor: --toast;
+      /* sit --toast-gap above the previous toast; with no previous toast the
+         fallback value places the first one --toast-edge from the viewport */
+      bottom: anchor(top, calc(var(--toast-edge) - var(--toast-gap)));
+      margin-bottom: var(--toast-gap);
+
+      /* visual */
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      min-width: 240px;
+      max-width: min(360px, calc(100vw - 2 * var(--toast-edge)));
+      padding: 14px 14px 14px 16px;
+      border-radius: 10px;
+      border-left: 4px solid var(--accent);
+      background: var(--primary);
+      color: white;
+      font-size: 0.95rem;
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
+      pointer-events: auto;
+
+      /* exit state + transitions (display/overlay animate discretely so the
+         element stays in the top layer until the exit animation finishes) */
+      opacity: 0;
+      translate: calc(100% + var(--toast-edge)) 0;
+      transition:
+        opacity var(--toast-duration) ease,
+        translate var(--toast-duration) cubic-bezier(0.22, 1, 0.36, 1),
+        bottom var(--toast-duration) ease,
+        display var(--toast-duration) allow-discrete,
+        overlay var(--toast-duration) allow-discrete;
+    }
+
+    .toast:popover-open {
+      opacity: 1;
+      translate: 0 0;
+
+      /* entry start state */
+      @starting-style {
+        opacity: 0;
+        translate: calc(100% + var(--toast-edge)) 0;
+      }
+    }
+
+    .toast::backdrop {
+      /* never intercept clicks on the rest of the page */
+      pointer-events: none;
+      background: transparent;
+    }
+
+    .toast-icon {
+      flex: none;
+      width: 22px;
+      height: 22px;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.8rem;
+      font-weight: bold;
+      display: grid;
+      place-items: center;
+    }
+
+    .toast-message {
+      flex: 1;
+      line-height: 1.3;
+    }
+
+    .toast-message::first-letter {
+      text-transform: uppercase;
+    }
+
+    .toast-close {
+      flex: none;
+      appearance: none;
+      border: 0;
+      background: transparent;
+      color: inherit;
+      opacity: 0.7;
+      font-size: 1.1rem;
+      line-height: 1;
+      width: 28px;
+      height: 28px;
+      border-radius: 50%;
+      cursor: pointer;
+      transition: opacity 0.2s, background 0.2s;
+    }
+
+    .toast-close:hover,
+    .toast-close:focus-visible {
+      opacity: 1;
+      background: rgba(255, 255, 255, 0.15);
+      outline: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        --toast-duration: 1ms;
+      }
+    }
