+  <!-- Persistent live region so screen readers announce each toast -->
+  <div id="toast-announcer" class="visually-hidden" role="status" aria-live="polite"></div>
+
+  <script type="module">
+    // Popover API polyfill, loaded only when native support is missing.
+    if (!('popover' in HTMLElement.prototype)) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+  </script>
+
+  <script>
+    (() => {
+      const TOAST_DURATION_MS = 3000;
+      const announcer = document.getElementById('toast-announcer');
+      let toastCount = 0;
+
+      /* --- Feature detection for animated top-layer exits ------------------ */
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+          return false;
+        }
+        // Probe: some browsers parse allow-discrete but still snap display: none.
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      function supportsTopLayerExit() {
+        return !!window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+      }
+
+      async function settleAnimations(element) {
+        const animations = element.getAnimations({ subtree: true });
+        if (animations.length === 0) return;
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((resolve) => setTimeout(resolve, 2000)),
+        ]);
+      }
+
+      /* --- Toast lifecycle ------------------------------------------------- */
+      function announce(message) {
+        // Clear first so repeating the same message is still announced.
+        announcer.textContent = '';
+        setTimeout(() => { announcer.textContent = message; }, 50);
+      }
+
+      function showToast(itemName) {
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.id = `toast-${++toastCount}`;
+        toast.setAttribute('popover', 'manual');
+
+        const icon = document.createElement('span');
+        icon.className = 'toast-icon';
+        icon.setAttribute('aria-hidden', 'true');
+        icon.textContent = '\u2713';
+
+        const message = document.createElement('p');
+        message.className = 'toast-message';
+        const strong = document.createElement('strong');
+        strong.textContent = itemName;
+        message.append(strong, ' added to cart!');
+
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Dismiss notification');
+        close.textContent = '\u00d7';
+
+        toast.append(icon, message, close);
+        document.body.append(toast);
+
+        if (typeof toast.showPopover === 'function') {
+          toast.showPopover();
+        } else {
+          toast.setAttribute('data-open', ''); // polyfill still loading
+        }
+        announce(message.textContent);
+
+        let dismissed = false;
+        const dismiss = async () => {
+          if (dismissed) return;
+          dismissed = true;
+          clearTimeout(timer);
+
+          if (!supportsTopLayerExit()) {
+            // Play the exit transition while still in the top layer, then hide.
+            toast.setAttribute('data-closing', '');
+            await settleAnimations(toast);
+          }
+
+          if (typeof toast.hidePopover === 'function') {
+            try { toast.hidePopover(); } catch { /* already hidden */ }
+          } else {
+            toast.removeAttribute('data-open');
+          }
+
+          // Let the display/overlay exit transition finish before removal so
+          // the remaining toasts only re-stack once this one is really gone.
+          await settleAnimations(toast);
+          toast.remove();
+        };
+
+        const timer = setTimeout(dismiss, TOAST_DURATION_MS);
+        close.addEventListener('click', dismiss);
+      }
+
+      document.addEventListener('click', (event) => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (!trigger) return;
+        showToast(trigger.dataset.item || 'Item');
+      });
+    })();
+  </script>
+
