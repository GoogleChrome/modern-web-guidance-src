+
+    /* Toast notifications
+       - popover="manual" promotes each toast into the browser's top layer, which
+         always paints above every other stacking context (no z-index needed).
+       - Every toast both declares AND anchors to the same anchor name. The
+         anchor resolves to the last preceding toast that is currently laid out,
+         so each toast sits above the previous visible one. When a toast hides,
+         the ones above it re-resolve to the next visible toast automatically:
+         pure CSS stacking with no wrapper and no JS layout math. */
+    .toast {
+      --toast-gap: 0.75rem;
+      position: fixed;
+      inset: auto;
+      right: 1rem;
+      bottom: calc(anchor(top, 0.25rem) + var(--toast-gap));
+      anchor-name: --toast;
+      position-anchor: --toast;
+      width: min(22rem, calc(100vw - 2rem));
+      margin: 0;
+      padding: 0.85rem 1rem;
+      border: 0;
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      overflow: visible;
+      align-items: center;
+      gap: 0.75rem;
+      background: var(--primary);
+      color: white;
+      font-size: 0.95rem;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+
+      /* Exit state + transitions. `display` and `overlay` are transitioned
+         discretely so the toast stays rendered in the top layer while fading out. */
+      opacity: 0;
+      translate: 1.5rem 0;
+      transition:
