+
+        try {
+          setStatus(sentimentStatus, 'Analysing…');
+          const raw = await worker.prompt(
+            `Customer feedback:\n"""\n${feedback}\n"""`,
+            {
+              signal,
+              responseConstraint: SENTIMENT_SCHEMA,
+              // The schema is already described in the system prompt; don't spend tokens re-sending it.
+              omitResponseConstraintInput: true,
+            },
+          );
+
+          let result;
+          try {
+            result = JSON.parse(raw);
+          } catch {
+            throw new Error('Model returned invalid JSON: ' + raw.slice(0, 120));
+          }
+
+          // Normalise/validate defensively even though the schema is enforced.
+          const score = Math.max(-1, Math.min(1, Number(result.score) || 0));
+          const category = SENTIMENT_SCHEMA.properties.category.enum.includes(result.category)
+            ? result.category
+            : (score > 0.2 ? 'positive' : score < -0.2 ? 'negative' : 'neutral');
+
+          const output = { score: Number(score.toFixed(2)), category, summary: result.summary ?? '', topics: result.topics ?? [] };
+          sentimentResult.textContent = JSON.stringify(output, null, 2);
+
+          const badge = document.createElement('span');
+          badge.className = 'sentiment-badge';
+          badge.dataset.category = category;
+          badge.textContent = `${category.toUpperCase()} · score ${output.score}`;
+          sentimentBadge.replaceChildren(badge);
+
+          setStatus(sentimentStatus, 'Analysis complete.');
+        } finally {
+          worker.destroy(); // one-shot clone, always freed
+        }
+      } catch (err) {
+        if (err?.name === 'AbortError') {
+          setStatus(sentimentStatus, 'Cancelled.');
+        } else {
+          console.error('[sentiment]', err);
+          setStatus(sentimentStatus, describeError(err), { error: true });
+        }
+      } finally {
+        if (sentimentController === controller) sentimentController = null;
+        sentimentBtn.disabled = false;
+        sentimentProgress.hidden = true;
+      }
+    });
+
+    // ---------------------------------------------------------------------
+    // Conversation Branching (clone + context tracking + cleanup)
+    // ---------------------------------------------------------------------
+
+    const cloneBtn = $('clone-btn');
+    const cleanupBtn = $('cleanup-btn');
+    const branchingStatus = $('branching-status');
+    const sessionList = $('session-list');
+
+    let cloneController = null;
+
+    cloneBtn.addEventListener('click', async () => {
+      const availability = await checkAvailability(branchingStatus);
+      if (!availability) return;
+
+      cloneController?.abort();
+      const controller = new AbortController();
+      cloneController = controller;
+      const { signal } = controller;
+
+      cloneBtn.disabled = true;
+      try {
+        // Clone the currently active session. If there is none yet, create the root
+        // barista session first so there is something meaningful to branch from.
+        const source = await ensureBaristaSession(signal);
+
+        setStatus(branchingStatus, `Cloning "${source.name}"…`);
+        const clone = await source.session.clone({ signal });
+
+        const branchCount = [...sessions.values()].filter((s) => !s.isRoot).length + 1;
+        const entry = registerSession(clone, { name: `Branch ${branchCount} (from ${source.name})` });
+
+        // The new branch becomes the active conversation for "Ask the Barista".
+        activeSessionId = entry.id;
+
+        // Keep memory bounded: drop the least-recently-used idle branches.
+        const pruned = pruneSessions();
+        const { used, quota } = usageOf(clone);
+        setStatus(branchingStatus,
+          `Created "${entry.name}" with ${used} / ${quota} tokens of inherited context.` +
+          (pruned ? ` Destroyed ${pruned} idle branch${pruned > 1 ? 'es' : ''} to stay under the ${MAX_SESSIONS}-session limit.` : ''));
+      } catch (err) {
+        if (err?.name !== 'AbortError') {
+          console.error('[clone]', err);
+          setStatus(branchingStatus, describeError(err), { error: true });
+        }
+      } finally {
+        if (cloneController === controller) cloneController = null;
+        cloneBtn.disabled = false;
+        renderSessions();
+      }
+    });
+
+    cleanupBtn.addEventListener('click', () => {
+      // Destroy every non-active branch (keep the root and the active session).
+      const victims = [...sessions.values()].filter((s) => !s.isRoot && s.id !== activeSessionId);
+      victims.forEach((v) => destroySession(v.id));
+      setStatus(branchingStatus,
+        victims.length ? `Destroyed ${victims.length} idle branch${victims.length > 1 ? 'es' : ''}.` : 'No idle branches to clean up.');
+    });
+
+    function renderSessions() {
+      sessionList.replaceChildren();
+
+      if (sessions.size === 0) {
+        const li = document.createElement('li');
+        li.className = 'meta';
+        li.textContent = 'No active sessions. Ask the Barista a question or clone to create one.';
+        sessionList.append(li);
+        return;
+      }
+
+      const ordered = [...sessions.values()].sort((a, b) => a.createdAt - b.createdAt);
+      for (const entry of ordered) {
+        const { used, quota, fraction } = usageOf(entry.session);
+        const isActive = entry.id === activeSessionId;
+
+        const li = document.createElement('li');
+        li.className = 'session-item' + (isActive ? ' active' : '');
+
+        const name = document.createElement('div');
+        name.className = 'name';
+        name.textContent = entry.name + (isActive ? ' · active' : '');
+
+        const meta = document.createElement('div');
+        meta.className = 'meta';
+        meta.textContent = `Context: ${used} / ${quota || '?'} tokens (${Math.round(fraction * 100)}%) · last used ${new Date(entry.lastUsed).toLocaleTimeString()}`;
+
+        const meter = document.createElement('meter');
+        meter.min = 0; meter.max = 1; meter.low = 0.6; meter.high = 0.9; meter.optimum = 0.1;
+        meter.value = fraction;
+        meter.setAttribute('aria-label', `Context usage for ${entry.name}`);
+
+        const actions = document.createElement('div');
+        actions.className = 'actions';
+
+        if (!isActive) {
+          const activate = document.createElement('button');
+          activate.type = 'button';
+          activate.className = 'btn secondary';
+          activate.textContent = 'Make active';
+          activate.addEventListener('click', () => {
+            activeSessionId = entry.id;
+            entry.lastUsed = Date.now();
+            setStatus(branchingStatus, `"${entry.name}" is now the active conversation.`);
+            renderSessions();
+          });
+          actions.append(activate);
+        }
+
+        const destroy = document.createElement('button');
+        destroy.type = 'button';
+        destroy.className = 'btn secondary';
+        destroy.textContent = 'Destroy';
+        destroy.addEventListener('click', () => {
+          destroySession(entry.id);
+          setStatus(branchingStatus, `Destroyed "${entry.name}".`);
+        });
+        actions.append(destroy);
+
+        li.append(name, actions, meta, meter);
+        sessionList.append(li);
+      }
+    }
+
+    // ---------------------------------------------------------------------
+    // Global cleanup
+    // ---------------------------------------------------------------------
+
+    function teardown() {
+      cancelBarista();
+      sentimentController?.abort();
+      cloneController?.abort();
+      destroyAllSessions();
+      if (sentimentSession) {
+        try { sentimentSession.destroy(); } catch { /* ignore */ }
+        sentimentSession = null;
+      }
+    }
+
+    // Free on-device model resources when the page is hidden/unloaded (bfcache-safe).
+    window.addEventListener('pagehide', teardown);
+
+    // Initial UI state.
+    renderSessions();
+    if (!hasBuiltInAI()) {
+      const note = 'Built-in AI is not supported in this browser. These features need the latest Chrome desktop with the Prompt API.';
+      [baristaStatus, sentimentStatus, branchingStatus].forEach((el) => setStatus(el, note, { error: true }));
+    }
+  </script>
 </body>
 
 </html>
