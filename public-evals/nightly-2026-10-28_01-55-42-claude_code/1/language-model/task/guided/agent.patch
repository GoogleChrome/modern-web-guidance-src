+        } finally {
+          worker?.destroy();
+          els.sentimentBtn.disabled = false;
+        }
+      });
+
+      // ---- Conversation Branching -------------------------------------------
+      els.cloneBtn.addEventListener('click', async () => {
+        els.cloneBtn.disabled = true;
+        setStatus(els.branchStatus, 'Cloning', 'busy');
+        try {
+          const source = await ensureActiveSession(els.branchStatus);
+          const clone = await source.clone();
+          const sourceMeta = branches.get(source);
+          const meta = registerBranch(clone, `Branch ${branchCounter + 1} (from ${sourceMeta.label})`);
+          const { used, quota } = usageOf(clone);
+          enforceBranchCap();
+          setStatus(
+            els.branchStatus,
+            `${meta.label} created with ${used.toLocaleString()}${quota ? ` / ${quota.toLocaleString()}` : ''} tokens of inherited context. ${branches.size} live session${branches.size === 1 ? '' : 's'}.`,
+          );
+        } catch (err) {
+          if (err?.name === 'NotSupportedError') {
+            setStatus(els.branchStatus, err.message, 'error');
+          } else {
+            console.error(err);
+            setStatus(els.branchStatus, 'Could not clone the conversation.', 'error');
+          }
+        } finally {
+          els.cloneBtn.disabled = false;
+          updateUsage();
+          renderBranches();
+        }
+      });
+
+      els.cleanupBtn.addEventListener('click', () => {
+        const removed = cleanupIdleBranches();
+        setStatus(els.branchStatus, removed
+          ? `Destroyed ${removed} idle branch${removed === 1 ? '' : 'es'}.`
+          : 'No idle branches to clean up (branches idle for 5+ minutes are reclaimable).');
+        renderBranches();
+      });
+
+      // Periodic sweep plus a refresh of "last used" timestamps.
+      setInterval(() => {
+        if (cleanupIdleBranches()) renderBranches();
+      }, 60 * 1000);
+
+      // ---- Resource cleanup --------------------------------------------------
+      function destroyAll() {
+        activeAbort?.abort();
+        for (const session of [...branches.keys()]) destroyBranch(session);
+        baseSession?.destroy();
+        sentimentBase?.destroy();
+        baseSession = sentimentBase = null;
+        baseSessionPromise = sentimentBasePromise = null;
+      }
+      window.addEventListener('pagehide', destroyAll);
+
+      // When the tab is hidden, drop idle branches early to free memory sooner.
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden' && cleanupIdleBranches()) renderBranches();
+      });
+
+      renderBranches();
+    }
+  </script>
+
+
 </body>
 
 </html>
