+    const els = {
+      question: $('barista-question'),
+      ask: $('ask-the-barista'),
+      stop: $('barista-stop'),
+      progress: $('model-progress'),
+      baristaStatus: $('barista-status'),
+      answer: $('barista-answer'),
+      usageLabel: $('context-usage-label'),
+      usageMeter: $('context-usage-meter'),
+      feedback: $('feedback-text'),
+      sentimentBtn: $('sentiment-btn'),
+      sentimentBadge: $('sentiment-badge'),
+      sentimentStatus: $('sentiment-status'),
+      sentimentResult: $('sentiment-result'),
+      cloneBtn: $('clone-btn'),
+      cleanupBtn: $('cleanup-btn'),
+      branchStatus: $('branch-status'),
+      sessionList: $('session-list'),
