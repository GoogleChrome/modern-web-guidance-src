+        baseSessionPromise ??= createSession({
+          initialPrompts: [{ role: 'system', content: BARISTA_SYSTEM_PROMPT }],
+        }, statusEl).then((s) => (baseSession = s)).catch((err) => {
+          baseSessionPromise = null;
+          throw err;
+        });
+        return baseSessionPromise;
+      }
+
+      function getSentimentBase() {
+        if (sentimentBase) return Promise.resolve(sentimentBase);
+        sentimentBasePromise ??= createSession({
+          initialPrompts: [{ role: 'system', content: SENTIMENT_SYSTEM_PROMPT }],
+        }, els.sentimentStatus).then((s) => (sentimentBase = s)).catch((err) => {
+          sentimentBasePromise = null;
+          throw err;
+        });
