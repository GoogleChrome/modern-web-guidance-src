+      }
+
+      // Pre-warm when the user shows intent, but only if no download is needed.
+      let prewarmed = false;
+      const prewarm = async () => {
+        if (prewarmed) return;
+        prewarmed = true;
+        try {
+          if ((await LanguageModel.availability()) === 'available') await getBaseSession();
+        } catch { /* surfaced on first real use */ }
+      };
+      for (const section of document.querySelectorAll('.ai-section')) {
+        section.addEventListener('pointerenter', prewarm, { once: true });
+        section.addEventListener('focusin', prewarm, { once: true });
+      }
+
+      // ---- Branch bookkeeping ----------------------------------------------
+      function registerBranch(session, label) {
+        branchCounter += 1;
+        const meta = { id: branchCounter, label: label ?? `Branch ${branchCounter}`, createdAt: Date.now(), lastUsed: Date.now() };
