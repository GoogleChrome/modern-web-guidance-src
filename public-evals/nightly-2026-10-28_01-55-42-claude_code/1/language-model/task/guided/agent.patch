+      setStatus(els.sentimentStatus, msg, 'error');
+      setStatus(els.branchStatus, msg, 'error');
+    } else {
+      init();
+    }
+
+    function init() {
+      // ---- Session registry ------------------------------------------------
+      // baseSession   : system prompt only, never prompted directly; cloned for work.
+      // activeSession : the barista conversation the user is currently in.
+      // branches      : cloned conversations (including the active one) with metadata.
+      let baseSession = null;
+      let baseSessionPromise = null;
+      let sentimentBase = null;
+      let sentimentBasePromise = null;
+      let activeSession = null;
+      let activeAbort = null;
+      let branchCounter = 0;
+      const branches = new Map(); // session -> { id, label, createdAt, lastUsed }
+      const sentimentCache = new Map(); // normalized feedback -> parsed result
+
+      for (const btn of [els.ask, els.sentimentBtn, els.cloneBtn, els.cleanupBtn]) btn.disabled = false;
+      setStatus(els.baristaStatus, 'Ready. Ask about the Maple Oat Latte or Cold Brew.');
+
+      // ---- Availability + download monitoring ------------------------------
+      async function checkAvailability() {
+        const availability = await LanguageModel.availability();
+        if (availability === 'unavailable') {
+          throw new DOMException('The on-device model cannot run on this device.', 'NotSupportedError');
+        }
+        return availability; // 'available' | 'downloadable' | 'downloading'
+      }
+
+      // statusEl is the status line of whichever section triggered the load.
+      async function createSession(options, statusEl) {
+        const availability = await checkAvailability();
+        const needsDownload = availability !== 'available';
+        if (needsDownload) {
+          els.progress.hidden = false;
+          els.progress.removeAttribute('value'); // indeterminate until first progress event
+          setStatus(statusEl, 'Preparing the on-device model (first use downloads it)', 'busy');
+        }
+        try {
+          return await LanguageModel.create({
+            ...options,
+            expectedInputs: [{ type: 'text', languages: ['en'] }],
+            expectedOutputs: [{ type: 'text', languages: ['en'] }],
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                els.progress.hidden = false;
+                els.progress.value = e.loaded;
