@@ -0,0 +1,35 @@
+---
+/**
+ * Category label coloured by newsroom desk. Links to the category page.
+ * Optionally shows a tone kicker ("Analysis", "Opinion") after the desk.
+ */
+import { getDesk, DESK_THEME, TONE_THEME, type Tone } from '../../utils/semantics';
+
+export interface Props {
+  category: string;
+  /** Pass the tone to show a kicker; omit to render the desk alone. */
+  tone?: Tone;
+  size?: 'sm' | 'md';
+  class?: string;
+}
+
+const { category, tone, size = 'sm', class: className = '' } = Astro.props;
+const desk = getDesk(category);
+const theme = DESK_THEME[desk];
+const toneTheme = tone ? TONE_THEME[tone] : null;
+const label = category.charAt(0).toUpperCase() + category.slice(1);
+const href = `${import.meta.env.BASE_URL}category/${category.toLowerCase()}`;
+const sizeClass = size === 'md' ? 'text-sm' : 'text-xs';
+---
+<span class={`inline-flex items-center gap-2 font-brand tracking-widest uppercase ${sizeClass} ${className}`} data-desk={desk}>
+  <a href={href} class={`inline-flex items-center gap-1.5 ${theme.text} hover:underline`}>
+    <span class={`inline-block w-1.5 h-1.5 rounded-full ${theme.fill}`} aria-hidden="true"></span>
+    {label}
+  </a>
+  {toneTheme && toneTheme.kicker && (
+    <>
+      <span class="text-gray-300" aria-hidden="true">/</span>
+      <span class={`normal-case tracking-normal ${toneTheme.kickerClass}`}>{toneTheme.kicker}</span>
+    </>
+  )}
+</span>
