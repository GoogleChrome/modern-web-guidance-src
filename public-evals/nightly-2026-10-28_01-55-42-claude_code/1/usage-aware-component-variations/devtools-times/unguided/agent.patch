+---
+/**
+ * A <time> element whose wording follows the story's freshness:
+ * relative while it is news, a weekday while it is recent, a full date after.
+ */
+import { formatDateline, getFreshness } from '../../utils/semantics';
+
+export interface Props {
+  date: Date;
+  now?: Date | number;
+  class?: string;
+}
+
+const { date, now, class: className = '' } = Astro.props;
+const freshness = getFreshness(date, now);
+const absolute = date.toLocaleString('en-US', {
+  weekday: 'long',
+  year: 'numeric',
+  month: 'long',
+  day: 'numeric',
+  hour: 'numeric',
+  minute: '2-digit',
+  timeZone: 'UTC',
+});
+---
+<time
+  datetime={date.toISOString()}
+  title={absolute}
+  class={`text-xs text-gray-500 ${freshness === 'breaking' ? 'text-red-700 font-semibold' : ''} ${className}`}
+  data-freshness={freshness}
+>
+  {formatDateline(date, now)}
+</time>
