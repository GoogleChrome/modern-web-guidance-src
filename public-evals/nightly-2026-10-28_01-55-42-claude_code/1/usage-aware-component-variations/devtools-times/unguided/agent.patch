+// ---------------------------------------------------------------------------
+// Dateline
+// ---------------------------------------------------------------------------
+
+/**
+ * Formats a story date in the register its freshness calls for:
+ * minutes or hours ago while it is breaking or new, the weekday while it is
+ * recent, and a full date once it is archive material.
+ */
+export function formatDateline(date: Date, now: Date | number = Date.now()): string {
+  const freshness = getFreshness(date, now);
+  const age = toMillis(now) - date.valueOf();
+
+  if (freshness === 'breaking') {
+    const minutes = Math.max(1, Math.round(age / MINUTE));
+    if (minutes < 60) return `${minutes} min ago`;
+    const hours = Math.round(age / HOUR);
+    return hours === 1 ? '1 hour ago' : `${hours} hours ago`;
+  }
+  if (freshness === 'new') {
+    const hours = Math.round(age / HOUR);
+    if (hours < 24) return hours <= 1 ? '1 hour ago' : `${hours} hours ago`;
+    return 'Yesterday';
+  }
+  if (freshness === 'recent') {
+    return date.toLocaleDateString('en-US', { weekday: 'long' });
+  }
+  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+}
