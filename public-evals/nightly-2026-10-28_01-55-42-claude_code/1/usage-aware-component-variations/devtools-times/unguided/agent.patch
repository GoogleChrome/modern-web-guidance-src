@@ -0,0 +1,29 @@
+---
+/**
+ * Pill that only appears when a story's age is worth remarking on.
+ * Breaking and new stories always get a badge. Archive material only gets one
+ * when `verbose` is set, which article pages use and card grids do not.
+ */
+import { getFreshness, FRESHNESS_THEME } from '../../utils/semantics';
+
+export interface Props {
+  date: Date;
+  now?: Date | number;
+  verbose?: boolean;
+  class?: string;
+}
+
+const { date, now, verbose = false, class: className = '' } = Astro.props;
+const freshness = getFreshness(date, now);
+const theme = FRESHNESS_THEME[freshness];
+const visible = freshness === 'breaking' || freshness === 'new' || (verbose && freshness === 'archive');
+---
+{visible && (
+  <span
+    class={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider ${theme.badge} ${className}`}
+    data-freshness={freshness}
+  >
+    {theme.dot && <span class={`inline-block w-1.5 h-1.5 rounded-full ${theme.dot}`} aria-hidden="true"></span>}
+    {theme.label}
+  </span>
+)}
