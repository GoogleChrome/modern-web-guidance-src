+---
+/**
+ * Living reference for the semantic components. Every state is produced from
+ * real articles by moving the freshness reference point, not by passing
+ * visual flags, which is the whole point of the system.
+ */
+import Layout from '../layouts/Layout.astro';
+import { getCollection } from 'astro:content';
+import StoryCard from '../components/semantic/StoryCard.astro';
+import SemanticSection from '../components/semantic/SemanticSection.astro';
+import DeskTag from '../components/semantic/DeskTag.astro';
+import FreshnessBadge from '../components/semantic/FreshnessBadge.astro';
+import Dateline from '../components/semantic/Dateline.astro';
+import ReadingDepth from '../components/semantic/ReadingDepth.astro';
+import {
+  getSemanticContext,
+  DESK_THEME,
+  FRESHNESS_WINDOWS,
+  type Desk,
+  type Freshness,
+} from '../utils/semantics';
+
+const articles = await getCollection('articles');
+articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+
+// One representative story per desk.
+const desks = Object.keys(DESK_THEME) as Desk[];
+const byDesk = desks
+  .map((desk) => ({
+    desk,
+    article: articles.find((a) => getSemanticContext({ ...a.data }).desk === desk),
+  }))
+  .filter((entry): entry is { desk: Desk; article: (typeof articles)[number] } => Boolean(entry.article));
+
+// Offsets that place a fixed story into each freshness window.
+const HOUR = 60 * 60 * 1000;
+const freshnessOffsets: Record<Freshness, number> = {
+  breaking: 2 * HOUR,
+  new: FRESHNESS_WINDOWS.breaking + 20 * HOUR,
+  recent: FRESHNESS_WINDOWS.new + 3 * 24 * HOUR,
+  archive: FRESHNESS_WINDOWS.recent + 90 * 24 * HOUR,
+};
+const sample = articles[0];
+const freshnessStates = (Object.keys(freshnessOffsets) as Freshness[]).map((state) => ({
+  state,
+  now: sample.data.date.valueOf() + freshnessOffsets[state],
+}));
+
+const byDepth = [
+  articles.find((a) => (a.data.readingTime ?? 3) <= 3),
+  articles.find((a) => (a.data.readingTime ?? 3) >= 4 && (a.data.readingTime ?? 3) <= 6),
+  articles.find((a) => (a.data.readingTime ?? 3) >= 7),
+].filter((a): a is (typeof articles)[number] => Boolean(a));
+
+const mixed = articles.slice(0, 5);
+const science = articles.filter((a) => a.data.category.toLowerCase() === 'science');
+// A set where a slightly older story is breaking relative to the chosen "now",
+// to show the section promoting it out of order.
+const promoted = [articles[3], articles[4], articles[5], articles[6]];
+const promotedNow = articles[5].data.date.valueOf() + HOUR;
+---
+<Layout title="Semantic components">
+  <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 space-y-16">
+    <header class="max-w-3xl">
+      <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Design reference</p>
+      <h1 class="text-4xl font-brand text-gray-900 mt-2">Components that read the story before they style it</h1>
+      <p class="text-lg text-gray-700 mt-4">
+        Nothing on this page was given a colour, a size or a badge. Each component derives a
+        semantic context from the article it is handed and picks its treatment from a shared token map.
+        The four axes are desk, freshness, depth and tone.
+      </p>
+    </header>
+
+    <section>
+      <h2 class="text-2xl font-bold border-b-2 border-gray-900 pb-2 mb-6">Desk</h2>
+      <p class="text-gray-600 mb-6">The category decides the accent. Six desks cover every category in the corpus.</p>
+      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
+        {byDesk.map(({ desk, article }) => (
+          <div class={`rounded-md p-4 ${DESK_THEME[desk].tint}`}>
+            <div class="mb-3 flex items-center justify-between">
+              <DeskTag category={article.data.category} />
+              <code class="text-[11px] text-gray-500">data-desk="{desk}"</code>
+            </div>
+            <StoryCard article={article} surface="compact" editionDate={article.data.date} />
+          </div>
+        ))}
+      </div>
+    </section>
+
+    <section>
+      <h2 class="text-2xl font-bold border-b-2 border-gray-900 pb-2 mb-6">Freshness</h2>
+      <p class="text-gray-600 mb-6">
+        The same story shown against four different reference times. The badge, the dateline
+        wording, the headline weight, the left rule and the image tint all follow the age.
+      </p>
+      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
+        {freshnessStates.map(({ state, now }) => (
+          <div>
+            <div class="mb-3 flex items-center justify-between">
+              <code class="text-[11px] text-gray-500">data-freshness="{state}"</code>
+              <span class="inline-flex gap-2 items-center">
+                <FreshnessBadge date={sample.data.date} now={now} verbose />
+                <Dateline date={sample.data.date} now={now} />
+              </span>
+            </div>
+            <StoryCard article={sample} surface="grid" editionDate={now} />
+          </div>
+        ))}
+      </div>
+    </section>
+
+    <section>
+      <h2 class="text-2xl font-bold border-b-2 border-gray-900 pb-2 mb-6">Depth</h2>
+      <p class="text-gray-600 mb-6">
+        Reading time sets the pips, the headline scale and whether a grid card spends space on a
+        summary. On article pages it also decides whether a progress bar is shown at all.
+      </p>
+      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
+        {byDepth.map((article) => (
+          <div>
+            <div class="mb-3">
+              <ReadingDepth readingTime={article.data.readingTime} category={article.data.category} />
+            </div>
+            <StoryCard article={article} surface="grid" editionDate={article.data.date.valueOf() + 10 * 24 * HOUR} />
+          </div>
+        ))}
+      </div>
+    </section>
+
+    <section>
+      <h2 class="text-2xl font-bold border-b-2 border-gray-900 pb-2 mb-6">Surfaces</h2>
+      <p class="text-gray-600 mb-6">One component, four placements. The semantic treatment is identical across all of them.</p>
+      <div class="space-y-10">
+        <div>
+          <code class="text-[11px] text-gray-500">surface="lead"</code>
+          <div class="mt-3"><StoryCard article={articles[1]} surface="lead" editionDate={articles[1].data.date.valueOf() + HOUR} /></div>
+        </div>
+        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
+          <div>
+            <code class="text-[11px] text-gray-500">surface="row"</code>
+            <div class="mt-3 border-t border-gray-200 divide-y divide-gray-100">
+              {articles.slice(6, 9).map((a) => <StoryCard article={a} surface="row" editionDate={articles[6].data.date} />)}
+            </div>
+          </div>
+          <div>
+            <code class="text-[11px] text-gray-500">surface="compact"</code>
+            <div class="mt-3 border-t border-gray-200 divide-y divide-gray-100">
+              {articles.slice(9, 13).map((a) => <StoryCard article={a} surface="compact" editionDate={articles[9].data.date} />)}
+            </div>
+          </div>
+        </div>
+      </div>
+    </section>
+
+    <section class="space-y-4">
+      <h2 class="text-2xl font-bold border-b-2 border-gray-900 pb-2">Sections</h2>
+      <p class="text-gray-600">
+        A section reads its own contents. Mixed desks keep the neutral rule and per-card tags.
+        A single desk colours the rule and drops the tags. A breaking story is promoted to the lead
+        slot and the heading gets a live marker.
+      </p>
+    </section>
+    <div class="-mx-4 md:-mx-6 divide-y divide-gray-200">
+      <SemanticSection title="Mixed desks" articles={mixed} />
+      <SemanticSection title="Single desk" articles={science} href={`${import.meta.env.BASE_URL}category/science`} />
+      <SemanticSection title="Breaking story promoted" articles={promoted} now={promotedNow} />
+    </div>
+  </div>
+</Layout>
diff --git a/src/utils/semantics.ts b/src/utils/semantics.ts
new file mode 100644
index 0000000..96976e3
--- /dev/null
+++ b/src/utils/semantics.ts
@@ -0,0 +1,418 @@
+/**
+ * Semantic context for editorial content.
+ *
+ * Components in `src/components/semantic/` do not receive visual props such as
+ * "red" or "large". They receive an article, derive a semantic context from it
+ * with `getSemanticContext`, and pick their visual treatment from the token
+ * maps below. Change the mapping here and every surface follows.
+ *
+ * Four axes are derived:
+ *
+ *   desk       what newsroom desk the story belongs to (from `category`)
+ *   freshness  how old the story is relative to the edition (from `date`)
+ *   depth      how much of the reader's time it asks for (from `readingTime`)
+ *   tone       what kind of piece it is (from `tags` and the headline)
+ */
+
+export type Desk =
+  | 'news'
+  | 'business'
+  | 'culture'
+  | 'science'
+  | 'sports'
+  | 'lifestyle';
+
+export type Freshness = 'breaking' | 'new' | 'recent' | 'archive';
+export type Depth = 'brief' | 'standard' | 'longform';
+export type Tone = 'report' | 'analysis' | 'feature' | 'opinion';
+
+/** The subset of article frontmatter the semantic model reads. */
+export interface SemanticSource {
+  title: string;
+  category: string;
+  date: Date;
+  readingTime?: number;
+  tags?: string[];
+}
+
+export interface SemanticContext {
+  desk: Desk;
+  freshness: Freshness;
+  depth: Depth;
+  tone: Tone;
+  /** Minutes between the story's date and the reference time. */
+  ageMinutes: number;
+  /** Reading time in minutes, defaulting to 3 when unknown. */
+  minutes: number;
+}
+
+export interface SemanticOptions {
+  /**
+   * Reference point for freshness. Defaults to the current time. Sections pass
+   * the date of their newest story so freshness means "new in this edition",
+   * which keeps the states meaningful for a static content corpus.
+   */
+  now?: Date | number;
+}
+
+// ---------------------------------------------------------------------------
+// Derivation
+// ---------------------------------------------------------------------------
+
+const DESK_BY_CATEGORY: Record<string, Desk> = {
+  news: 'news',
+  national: 'news',
+  politics: 'news',
+  labor: 'news',
+  world: 'news',
+  economy: 'business',
+  business: 'business',
+  markets: 'business',
+  culture: 'culture',
+  media: 'culture',
+  arts: 'culture',
+  science: 'science',
+  technology: 'science',
+  tech: 'science',
+  health: 'science',
+  sports: 'sports',
+  lifestyle: 'lifestyle',
+  pets: 'lifestyle',
+  travel: 'lifestyle',
+  food: 'lifestyle',
+  'urban development': 'lifestyle',
+  'web development': 'science',
+};
+
+export function getDesk(category: string): Desk {
+  return DESK_BY_CATEGORY[category.trim().toLowerCase()] ?? 'news';
+}
+
+const MINUTE = 60_000;
+const HOUR = 60 * MINUTE;
+const DAY = 24 * HOUR;
+
+export const FRESHNESS_WINDOWS = {
+  breaking: 6 * HOUR,
+  new: 2 * DAY,
+  recent: 14 * DAY,
+} as const;
+
+export function getFreshness(date: Date, now: Date | number = Date.now()): Freshness {
+  const age = toMillis(now) - date.valueOf();
+  if (age <= FRESHNESS_WINDOWS.breaking) return 'breaking';
+  if (age <= FRESHNESS_WINDOWS.new) return 'new';
+  if (age <= FRESHNESS_WINDOWS.recent) return 'recent';
+  return 'archive';
+}
+
+export function getDepth(readingTime?: number): Depth {
+  const minutes = readingTime ?? 3;
+  if (minutes <= 3) return 'brief';
+  if (minutes <= 6) return 'standard';
+  return 'longform';
+}
+
+const OPINION_TAGS = new Set(['opinion', 'editorial', 'column', 'letter']);
+const ANALYSIS_TAGS = new Set(['analysis', 'explainer', 'policy', 'economy']);
+const FEATURE_TAGS = new Set(['humor', 'profile', 'feature', 'interview', 'photo essay']);
+
+export function getTone(source: Pick<SemanticSource, 'title' | 'tags' | 'readingTime'>): Tone {
+  const tags = (source.tags ?? []).map((t) => t.toLowerCase());
+  if (tags.some((t) => OPINION_TAGS.has(t))) return 'opinion';
+  if (tags.some((t) => FEATURE_TAGS.has(t))) return 'feature';
+  // A headline that asks a question is the newsroom convention for analysis.
+  if (tags.some((t) => ANALYSIS_TAGS.has(t)) || /\?\s*$/.test(source.title)) return 'analysis';
+  if ((source.readingTime ?? 0) >= 5) return 'feature';
+  return 'report';
+}
+
+export function getSemanticContext(
+  source: SemanticSource,
+  options: SemanticOptions = {},
+): SemanticContext {
+  const now = options.now ?? Date.now();
+  return {
+    desk: getDesk(source.category),
+    freshness: getFreshness(source.date, now),
+    depth: getDepth(source.readingTime),
+    tone: getTone(source),
+    ageMinutes: Math.max(0, Math.round((toMillis(now) - source.date.valueOf()) / MINUTE)),
+    minutes: source.readingTime ?? 3,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Visual tokens
+//
+// Every class string below is written out in full so Tailwind can find it when
+// it scans the source tree. Never build class names by concatenation.
+// ---------------------------------------------------------------------------
