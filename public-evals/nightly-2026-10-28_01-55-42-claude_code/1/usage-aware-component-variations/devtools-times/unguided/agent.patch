+// ---------------------------------------------------------------------------
+// Aggregates
+// ---------------------------------------------------------------------------
+
+export interface CollectionSemantics {
+  /** The single desk shared by every story, or null when desks are mixed. */
+  sharedDesk: Desk | null;
+  /** True when at least one story is breaking. */
+  hasBreaking: boolean;
+  /** Index of the story that should lead the section. */
+  leadIndex: number;
+  /** The newest story date, used as the edition reference. */
+  editionDate: Date;
+}
+
+/**
+ * Looks across a set of stories to decide how a section should present them.
+ * A breaking story leads regardless of order. When every story comes from the
+ * same desk the section can take on that desk's identity and the cards can
+ * stop repeating it.
+ */
+export function getCollectionSemantics(
+  sources: SemanticSource[],
+  options: SemanticOptions = {},
+): CollectionSemantics {
+  if (sources.length === 0) {
+    return { sharedDesk: null, hasBreaking: false, leadIndex: 0, editionDate: new Date(0) };
+  }
+  const editionDate = new Date(Math.max(...sources.map((s) => s.date.valueOf())));
+  const now = options.now ?? editionDate;
+  const contexts = sources.map((s) => getSemanticContext(s, { now }));
+
+  const desks = new Set(contexts.map((c) => c.desk));
+  const breakingIndex = contexts.findIndex((c) => c.freshness === 'breaking');
+
+  return {
+    sharedDesk: desks.size === 1 ? contexts[0].desk : null,
+    hasBreaking: breakingIndex !== -1,
+    leadIndex: breakingIndex === -1 ? 0 : breakingIndex,
+    editionDate,
+  };
+}
+
+/** Builds the `data-*` attribute bag used for styling hooks and debugging. */
+export function semanticDataAttributes(ctx: SemanticContext) {
+  return {
+    'data-desk': ctx.desk,
+    'data-freshness': ctx.freshness,
+    'data-depth': ctx.depth,
+    'data-tone': ctx.tone,
+  };
+}
+
+function toMillis(value: Date | number): number {
+  return typeof value === 'number' ? value : value.valueOf();
+}
