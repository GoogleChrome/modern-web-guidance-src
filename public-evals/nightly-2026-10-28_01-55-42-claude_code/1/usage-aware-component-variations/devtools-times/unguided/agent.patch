+---
+/**
+ * Reading-time indicator. Three pips fill according to depth, and a label
+ * appears only at the extremes ("Quick read", "Long read") where it changes
+ * what the reader decides to do.
+ */
+import { BookOpenIcon } from '@heroicons/react/24/outline';
+import { getDepth, getDesk, DEPTH_THEME, DESK_THEME } from '../../utils/semantics';
+
+export interface Props {
+  readingTime?: number;
+  /** Colours the pips with the desk accent. Grey when omitted. */
+  category?: string;
+  class?: string;
+}
+
+const { readingTime, category, class: className = '' } = Astro.props;
+const depth = getDepth(readingTime);
+const theme = DEPTH_THEME[depth];
+const fill = category ? DESK_THEME[getDesk(category)].fill : 'bg-gray-500';
+const minutes = readingTime ?? 3;
+---
+<span
+  class={`inline-flex items-center gap-2 text-xs font-medium text-gray-500 ${className}`}
+  data-depth={depth}
+  title={`${minutes} minute read`}
+>
+  <BookOpenIcon className="w-4 h-4 -mt-px" />
+  <span>{minutes} Min.</span>
+  <span class="inline-flex items-end gap-0.5" aria-hidden="true">
+    {[1, 2, 3].map((pip) => (
+      <span class={`inline-block w-1 rounded-sm ${pip <= theme.pips ? fill : 'bg-gray-200'}`} style={`height: ${4 + pip * 3}px`}></span>
+    ))}
+  </span>
+  {theme.label && <span class="text-gray-400">{theme.label}</span>}
+</span>
diff --git a/src/components/semantic/ReadingProgress.tsx b/src/components/semantic/ReadingProgress.tsx
new file mode 100644
index 0000000..cb7b493
--- /dev/null
+++ b/src/components/semantic/ReadingProgress.tsx
@@ -0,0 +1,82 @@
+import { useEffect, useState } from 'react';
+import { getDepth, getDesk, DESK_THEME } from '../../utils/semantics';
+
+interface Props {
+  /** Reading time in minutes from the article frontmatter. */
+  readingTime?: number;
+  /** Category, used to colour the bar with the desk accent. */
+  category: string;
+  /** Selector for the element whose scroll extent counts as "the article". */
+  target?: string;
+}
+
+/**
+ * Sticky progress bar for article pages that decides for itself whether it is
+ * worth showing. Quick reads get nothing: a progress bar on a three-minute
+ * piece is noise. Standard reads get a thin bar. Long reads get the bar plus
+ * a "minutes left" counter so the reader can decide whether to keep going.
+ */
+export default function ReadingProgress({ readingTime, category, target = 'article' }: Props) {
+  const depth = getDepth(readingTime);
+  const [progress, setProgress] = useState(0);
+
+  useEffect(() => {
+    if (depth === 'brief') return;
+    const el = document.querySelector<HTMLElement>(target);
+    if (!el) return;
+
+    let frame = 0;
+    const update = () => {
+      frame = 0;
+      const rect = el.getBoundingClientRect();
+      const viewport = window.innerHeight;
+      const total = rect.height - viewport;
+      const read = total <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / total));
+      setProgress(read);
+    };
+    const onScroll = () => {
+      if (!frame) frame = window.requestAnimationFrame(update);
+    };
+    update();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    window.addEventListener('resize', onScroll);
+    return () => {
+      window.removeEventListener('scroll', onScroll);
+      window.removeEventListener('resize', onScroll);
+      if (frame) window.cancelAnimationFrame(frame);
+    };
+  }, [depth, target]);
+
+  if (depth === 'brief') return null;
+
+  const theme = DESK_THEME[getDesk(category)];
+  const minutes = readingTime ?? 3;
+  const minutesLeft = Math.max(0, Math.ceil(minutes * (1 - progress)));
+  const percent = Math.round(progress * 100);
+
+  return (
+    <div
+      className="sticky top-0 z-40 w-full"
+      data-depth={depth}
+      role="progressbar"
+      aria-label="Reading progress"
+      aria-valuemin={0}
+      aria-valuemax={100}
+      aria-valuenow={percent}
+    >
+      <div className="h-1 w-full bg-gray-100">
+        <div
+          className={`h-full ${theme.fill} transition-[width] duration-150 ease-out`}
+          style={{ width: `${percent}%` }}
+        />
+      </div>
+      {depth === 'longform' && progress > 0.02 && progress < 0.98 && (
+        <div className="pointer-events-none flex justify-end px-4">
+          <span className={`-mt-px rounded-b px-2 py-0.5 text-[11px] font-semibold text-white ${theme.fill}`}>
+            {minutesLeft} min left
+          </span>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/semantic/SemanticSection.astro b/src/components/semantic/SemanticSection.astro
new file mode 100644
index 0000000..53c0ca7
--- /dev/null
+++ b/src/components/semantic/SemanticSection.astro
@@ -0,0 +1,104 @@
+---
+/**
+ * A section that reads its own contents before deciding how to lay them out.
+ *
+ * - A breaking story is promoted to the lead slot wherever it was in the list.
+ * - When every story comes from one desk, the heading rule takes that desk's
+ *   colour and the cards stop repeating the desk tag.
+ * - The layout follows the count: one story is a lead, two or three fill a
+ *   grid, four or more get a lead, a grid of three, and the remainder as rows.
+ * - Freshness is measured against the newest story in the section unless an
+ *   explicit `now` is supplied.
+ */
+import type { CollectionEntry } from 'astro:content';
+import { getCollectionSemantics, DESK_THEME } from '../../utils/semantics';
+import StoryCard from './StoryCard.astro';
+
+export interface Props {
+  title: string;
+  articles: CollectionEntry<'articles'>[];
+  /** Override the freshness reference; defaults to the newest story's date. */
+  now?: Date | number;
+  /** Optional link shown next to the title, e.g. the desk's category page. */
+  href?: string;
+}
+
+const { title, articles, now, href } = Astro.props;
+
+const sources = articles.map((a) => ({
+  title: a.data.title,
+  category: a.data.category,
+  date: a.data.date,
+  readingTime: a.data.readingTime,
+  tags: a.data.tags,
+}));
+const agg = getCollectionSemantics(sources, { now });
+const editionDate = now ?? agg.editionDate;
+const deskTheme = agg.sharedDesk ? DESK_THEME[agg.sharedDesk] : null;
+const hideDesk = agg.sharedDesk !== null;
+
+const ordered = [
+  articles[agg.leadIndex],
+  ...articles.filter((_, i) => i !== agg.leadIndex),
+];
+
+let lead: CollectionEntry<'articles'> | null = null;
+let grid: CollectionEntry<'articles'>[] = [];
+let rows: CollectionEntry<'articles'>[] = [];
+
+if (ordered.length === 1) {
+  lead = ordered[0];
+} else if (ordered.length <= 3) {
+  grid = ordered;
+} else {
+  lead = ordered[0];
+  grid = ordered.slice(1, 4);
+  rows = ordered.slice(4);
+}
+
+const gridCols = grid.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3';
+const ruleClass = deskTheme ? deskTheme.border : 'border-gray-900';
+const headingClass = deskTheme ? deskTheme.text : 'text-gray-900';
+---
+{articles.length > 0 && (
+  <section
+    class="p-4 md:p-6"
+    data-shared-desk={agg.sharedDesk ?? 'mixed'}
+    data-has-breaking={agg.hasBreaking ? 'true' : 'false'}
+  >
+    <div class={`flex items-baseline justify-between border-b-2 ${ruleClass} pb-2 mb-6 lg:mb-8`}>
+      <h2 class={`text-3xl font-bold ${headingClass}`}>
+        {title}
+        {agg.hasBreaking && (
+          <span class="ml-3 align-middle inline-flex items-center gap-1.5 rounded-full bg-red-700 text-white px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider">
+            <span class="inline-block w-1.5 h-1.5 rounded-full bg-white animate-pulse" aria-hidden="true"></span>
+            Live
+          </span>
+        )}
+      </h2>
+      {href && <a href={href} class={`text-sm font-semibold hover:underline ${headingClass}`}>See all</a>}
+    </div>
+
+    {lead && (
+      <div class={grid.length > 0 ? 'mb-8' : ''}>
+        <StoryCard article={lead} surface="lead" editionDate={editionDate} hideDesk={hideDesk} />
+      </div>
+    )}
+
+    {grid.length > 0 && (
+      <div class={`grid grid-cols-1 ${gridCols} gap-6 lg:gap-8`}>
+        {grid.map((article) => (
+          <StoryCard article={article} surface="grid" editionDate={editionDate} hideDesk={hideDesk} />
+        ))}
+      </div>
+    )}
+
+    {rows.length > 0 && (
+      <div class="mt-6 border-t border-gray-200 divide-y divide-gray-100">
+        {rows.map((article) => (
+          <StoryCard article={article} surface="row" editionDate={editionDate} hideDesk={hideDesk} />
+        ))}
+      </div>
+    )}
+  </section>
+)}
diff --git a/src/components/semantic/StoryCard.astro b/src/components/semantic/StoryCard.astro
new file mode 100644
index 0000000..d2212ed
--- /dev/null
+++ b/src/components/semantic/StoryCard.astro
@@ -0,0 +1,158 @@
+---
+/**
+ * One card, many faces.
+ *
+ * `surface` says where the card sits (lead, grid, row, compact). Everything
+ * else about its appearance is derived from the article itself through the
+ * semantic model: the desk picks the accent, freshness picks the badge and
+ * edge treatment, depth decides whether the summary is worth the space, and
+ * tone picks the kicker, the headline typography and the image aspect ratio.
+ */
+import type { CollectionEntry } from 'astro:content';
+import StoryImage from './StoryImage.astro';
+import { getArticleImage } from '../../utils/images';
+import {
+  getSemanticContext,
+  semanticDataAttributes,
+  DESK_THEME,
+  FRESHNESS_THEME,
+  DEPTH_THEME,
+  TONE_THEME,
+} from '../../utils/semantics';
+import BookmarkButton from '../BookmarkButton';
+import DeskTag from './DeskTag.astro';
+import FreshnessBadge from './FreshnessBadge.astro';
+import Dateline from './Dateline.astro';
+import ReadingDepth from './ReadingDepth.astro';
+
+export type Surface = 'lead' | 'grid' | 'row' | 'compact';
+
+export interface Props {
+  article: CollectionEntry<'articles'>;
+  surface?: Surface;
+  /** Reference time for freshness. Defaults to now. */
+  editionDate?: Date | number;
+  /** Set by a section whose stories all share one desk, so cards stop repeating it. */
+  hideDesk?: boolean;
+}
+
+const { article, surface = 'grid', editionDate, hideDesk = false } = Astro.props;
+const { data } = article;
+
+const ctx = getSemanticContext(
+  { title: data.title, category: data.category, date: data.date, readingTime: data.readingTime, tags: data.tags },
+  { now: editionDate },
+);
+const desk = DESK_THEME[ctx.desk];
+const fresh = FRESHNESS_THEME[ctx.freshness];
+const depth = DEPTH_THEME[ctx.depth];
+const tone = TONE_THEME[ctx.tone];
+const attrs = semanticDataAttributes(ctx);
+
+const href = `${import.meta.env.BASE_URL}articles/${article.id}`;
+const image = surface === 'compact' ? null : await getArticleImage(article);
+const readingList = (await Astro.session?.get('readingList')) || [];
+const isBookmarked = readingList.includes(article.id);
+
+const headlineHover = `transition-colors ${desk.hover}`;
+const headlineTone = `${tone.headline} ${fresh.headline}`;
+const imageTreatment = `object-cover ${fresh.image}`;
+const showSummary = surface === 'lead' || surface === 'row' || depth.showSummary;
+const showByline = tone.showByline || surface === 'lead';
+---
+{surface === 'lead' && (
+  <article class={`group grid grid-cols-1 lg:grid-cols-5 gap-6 lg:gap-8 ${fresh.card}`} {...attrs} data-surface="lead">
+    <div class="lg:col-span-3 order-first">
+      <a href={href}>
+        <StoryImage src={image!} alt={data.title} width={960} height={540} class={`w-full h-auto aspect-[16/9] ${imageTreatment}`} />
+      </a>
+    </div>
+    <div class="lg:col-span-2 flex flex-col">
+      <div class="flex flex-wrap items-center gap-3 mb-3">
+        <FreshnessBadge date={data.date} now={editionDate} />
+        {!hideDesk && <DeskTag category={data.category} tone={ctx.tone} />}
+        {hideDesk && tone.kicker && <span class={`text-xs ${tone.kickerClass}`}>{tone.kicker}</span>}
+      </div>
+      <a href={href} class="flex-grow">
+        <h3 class={`text-3xl md:text-4xl leading-tight text-gray-900 ${headlineTone} ${headlineHover}`}>{data.title}</h3>
+        {showSummary && <p class="mt-4 text-lg text-gray-700">{data.summary}</p>}
+      </a>
+      {showByline && <p class="mt-4 text-sm text-gray-600">By <span class="font-semibold text-gray-800">{data.author}</span></p>}
+      <div class="flex justify-between items-center mt-4 pt-3 border-t border-gray-100">
+        <div class="flex items-center gap-4">
+          <ReadingDepth readingTime={data.readingTime} category={data.category} />
+          <Dateline date={data.date} now={editionDate} />
+        </div>
+        <BookmarkButton client:visible slug={article.id} initialIsBookmarked={isBookmarked} />
+      </div>
+    </div>
+  </article>
+)}
+
+{surface === 'grid' && (
+  <article class={`group flex flex-col h-full ${fresh.card}`} {...attrs} data-surface="grid">
+    <a href={href} class="block">
+      <StoryImage src={image!} alt={data.title} width={480} height={360} class={`w-full rounded-md ${tone.aspect} ${imageTreatment}`} />
+    </a>
+    <div class="flex flex-col flex-grow mt-3">
+      <div class="flex flex-wrap items-center gap-2 mb-1">
+        <FreshnessBadge date={data.date} now={editionDate} />
+        {!hideDesk && <DeskTag category={data.category} tone={ctx.tone} />}
+        {hideDesk && tone.kicker && <span class={`text-xs ${tone.kickerClass}`}>{tone.kicker}</span>}
+      </div>
+      <a href={href} class="flex flex-col flex-grow">
+        <h3 class={`${depth.headline} leading-snug text-gray-900 ${headlineTone} ${headlineHover}`}>{data.title}</h3>
+        {showSummary && <p class="text-gray-600 mt-1 text-sm">{data.summary}</p>}
+      </a>
+      {showByline && <p class="mt-2 text-xs text-gray-500">By {data.author}</p>}
+      <div class="flex justify-between items-center mt-2 pt-2 border-t border-gray-100">
+        <div class="flex items-center gap-3">
+          <ReadingDepth readingTime={data.readingTime} category={data.category} />
+          <Dateline date={data.date} now={editionDate} />
+        </div>
+        <BookmarkButton client:visible slug={article.id} initialIsBookmarked={isBookmarked} />
+      </div>
+    </div>
+  </article>
+)}
+
+{surface === 'row' && (
+  <article class={`group flex gap-4 py-4 ${fresh.card}`} {...attrs} data-surface="row">
+    <a href={href} class="shrink-0 w-28 sm:w-40">
+      <StoryImage src={image!} alt={data.title} width={320} height={240} class={`w-full rounded ${tone.aspect} ${imageTreatment}`} />
+    </a>
+    <div class="flex flex-col min-w-0 flex-grow">
+      <div class="flex flex-wrap items-center gap-2 mb-1">
+        <FreshnessBadge date={data.date} now={editionDate} />
+        {!hideDesk && <DeskTag category={data.category} tone={ctx.tone} />}
+        {hideDesk && tone.kicker && <span class={`text-xs ${tone.kickerClass}`}>{tone.kicker}</span>}
+      </div>
+      <a href={href}>
+        <h3 class={`text-lg leading-snug text-gray-900 ${headlineTone} ${headlineHover}`}>{data.title}</h3>
+        <p class="hidden sm:block text-gray-600 mt-1 text-sm line-clamp-2">{data.summary}</p>
+      </a>
+      <div class="flex items-center gap-3 mt-auto pt-2">
+        <ReadingDepth readingTime={data.readingTime} category={data.category} />
+        <Dateline date={data.date} now={editionDate} />
+        <span class="ml-auto"><BookmarkButton client:visible slug={article.id} initialIsBookmarked={isBookmarked} /></span>
+      </div>
+    </div>
+  </article>
+)}
+
+{surface === 'compact' && (
+  <article class={`group py-3 ${fresh.card}`} {...attrs} data-surface="compact">
+    <div class="flex flex-wrap items-center gap-2 mb-1">
+      <FreshnessBadge date={data.date} now={editionDate} />
+      {!hideDesk && <DeskTag category={data.category} tone={ctx.tone} />}
+      {hideDesk && tone.kicker && <span class={`text-xs ${tone.kickerClass}`}>{tone.kicker}</span>}
+    </div>
+    <a href={href}>
+      <h3 class={`text-base leading-snug text-gray-900 ${headlineTone} ${headlineHover}`}>{data.title}</h3>
+    </a>
+    <div class="flex items-center gap-3 mt-1">
+      <ReadingDepth readingTime={data.readingTime} category={data.category} />
+      <Dateline date={data.date} now={editionDate} />
+    </div>
+  </article>
+)}
