+  <script>
+    (function () {
+      const panel = document.getElementById('quick-order');
+      const handle = document.getElementById('quick-order-handle');
+      const toggle = document.getElementById('quick-order-toggle');
+
+      /* ---------- Dragging ---------- */
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let isDragging = false;
+      const DRAG_THRESHOLD = 4;
+      const KEY_STEP = 15;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.style.left = Math.max(0, Math.min(left, maxLeft)) + 'px';
+        panel.style.top = Math.max(0, Math.min(top, maxTop)) + 'px';
+      }
+
+      function ensurePositioned() {
+        if (panel.classList.contains('is-positioned')) return;
+        const rect = panel.getBoundingClientRect();
+        panel.classList.add('is-positioned');
+        moveTo(rect.left, rect.top);
+      }
+
+      function reclamp() {
+        if (!panel.classList.contains('is-positioned')) return;
+        moveTo(parseFloat(panel.style.left) || 0, parseFloat(panel.style.top) || 0);
+      }
+
+      handle.classList.add('is-draggable');
+      handle.setAttribute('tabindex', '0');
+      handle.setAttribute('aria-label', 'Quick order panel. Drag, or press arrow keys, to move the panel.');
+
+      handle.addEventListener('pointerdown', function (event) {
+        if (event.button !== 0 || event.target.closest('button, input, select, textarea, a')) return;
+        ensurePositioned();
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        isDragging = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', function (event) {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!isDragging) {
+          if (Math.abs(event.clientX - startX) < DRAG_THRESHOLD &&
+              Math.abs(event.clientY - startY) < DRAG_THRESHOLD) return;
+          isDragging = true;
+          handle.classList.add('dragging');
+        }
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', function () {
+        isDragging = false;
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', function (event) {
+        if (event.target !== handle) return;
+        const deltas = {
+          ArrowLeft: [-KEY_STEP, 0],
+          ArrowRight: [KEY_STEP, 0],
+          ArrowUp: [0, -KEY_STEP],
+          ArrowDown: [0, KEY_STEP]
+        };
+        const delta = deltas[event.key];
+        if (!delta) return;
+        event.preventDefault();
+        ensurePositioned();
+        moveTo((parseFloat(panel.style.left) || 0) + delta[0],
+               (parseFloat(panel.style.top) || 0) + delta[1]);
+      });
+
+      window.addEventListener('resize', reclamp);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(reclamp).observe(panel);
+      }
+
+      /* ---------- Collapse / expand ---------- */
+      toggle.addEventListener('click', function () {
+        const collapsed = panel.getAttribute('data-collapsed') === 'true';
+        panel.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
+        toggle.setAttribute('aria-expanded', String(collapsed));
+        toggle.setAttribute('aria-label', (collapsed ? 'Collapse' : 'Expand') + ' quick order panel');
+        toggle.innerHTML = collapsed ? '&minus;' : '+';
+        reclamp();
+      });
+
+      /* ---------- Quick order controls ---------- */
+      const drinkSelect = document.getElementById('qo-drink');
+      const sizeButtons = Array.from(document.querySelectorAll('.cart-panel__sizes button'));
+      const qtyOutput = document.getElementById('qo-qty');
+      const extras = Array.from(document.querySelectorAll('.qo-extra'));
+      const itemTotal = document.getElementById('qo-item-total');
+      const cartList = document.getElementById('qo-cart');
+      const cartEmpty = document.getElementById('qo-empty');
+      const cartTotal = document.getElementById('qo-cart-total');
+      const status = document.getElementById('qo-status');
+      const cart = [];
+      let qty = 1;
+
+      const money = function (n) { return '$' + n.toFixed(2); };
+
+      function currentSize() {
+        return sizeButtons.find(function (b) { return b.getAttribute('aria-pressed') === 'true'; }) || sizeButtons[0];
+      }
+
+      function unitPrice() {
+        const base = parseFloat(drinkSelect.selectedOptions[0].dataset.price);
+        const sizeExtra = parseFloat(currentSize().dataset.extra);
+        const extrasTotal = extras.filter(function (e) { return e.checked; })
+          .reduce(function (sum, e) { return sum + parseFloat(e.dataset.price); }, 0);
+        return base + sizeExtra + extrasTotal;
+      }
+
+      function updateItemTotal() {
+        itemTotal.textContent = money(unitPrice() * qty);
+      }
+
+      function renderCart() {
+        cartList.innerHTML = '';
+        let total = 0;
+        cart.forEach(function (item, index) {
+          total += item.lineTotal;
+          const li = document.createElement('li');
+          const text = document.createElement('span');
+          text.textContent = item.qty + '× ' + item.size + ' ' + item.drink +
+            (item.extras.length ? ' (' + item.extras.join(', ') + ')' : '') +
+            ' — ' + money(item.lineTotal);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.setAttribute('aria-label', 'Remove ' + item.drink + ' from order');
+          remove.textContent = '×';
+          remove.addEventListener('click', function () {
+            cart.splice(index, 1);
+            renderCart();
+            status.textContent = item.drink + ' removed.';
+          });
+          li.append(text, remove);
+          cartList.appendChild(li);
+        });
+        cartEmpty.hidden = cart.length > 0;
+        cartTotal.textContent = money(total);
+        reclamp();
+      }
+
+      drinkSelect.addEventListener('change', updateItemTotal);
+
+      sizeButtons.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          sizeButtons.forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
+          updateItemTotal();
+        });
+      });
+
+      document.getElementById('qo-qty-minus').addEventListener('click', function () {
+        qty = Math.max(1, qty - 1);
+        qtyOutput.textContent = qty;
+        updateItemTotal();
+      });
+
+      document.getElementById('qo-qty-plus').addEventListener('click', function () {
+        qty = Math.min(12, qty + 1);
+        qtyOutput.textContent = qty;
+        updateItemTotal();
+      });
+
+      extras.forEach(function (e) { e.addEventListener('change', updateItemTotal); });
+
+      document.getElementById('qo-add').addEventListener('click', function () {
+        const item = {
+          drink: drinkSelect.value,
+          size: currentSize().dataset.size,
+          qty: qty,
+          extras: extras.filter(function (e) { return e.checked; }).map(function (e) { return e.value; }),
+          lineTotal: unitPrice() * qty
+        };
+        cart.push(item);
+        renderCart();
+        status.textContent = 'Added ' + item.qty + '× ' + item.drink + ' to your order.';
+        qty = 1;
+        qtyOutput.textContent = qty;
+        extras.forEach(function (e) { e.checked = false; });
+        updateItemTotal();
+      });
+
+      updateItemTotal();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
