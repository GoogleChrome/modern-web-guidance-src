+        <legend style="font-size: 0.8rem; color: var(--primary); font-weight: 600; margin-bottom: 4px;">Extras</legend>
+        <div class="extras">
+          <label><input type="checkbox" name="qo-extra" value="Extra shot" data-price="1.00"> Extra shot</label>
+          <label><input type="checkbox" name="qo-extra" value="Vanilla" data-price="0.50"> Vanilla</label>
+          <label><input type="checkbox" name="qo-extra" value="Iced" data-price="0"> Iced</label>
+        </div>
+      </fieldset>
+
+      <div class="quick-order__row">
+        <div class="stepper" aria-label="Quantity">
+          <button type="button" id="qo-minus" aria-label="Decrease quantity">&#8722;</button>
+          <output id="qo-qty" aria-live="polite">1</output>
+          <button type="button" id="qo-plus" aria-label="Increase quantity">+</button>
+        </div>
+        <span class="quick-order__price" id="qo-price" aria-live="polite">$5.25</span>
+      </div>
+
+      <button type="submit" class="btn btn--accent" id="qo-add">Add to Order</button>
+
+      <div class="quick-order__cart">
+        <h4>Your Order</h4>
+        <ul id="qo-items" aria-live="polite"></ul>
+        <p class="quick-order__empty" id="qo-empty">Nothing here yet. Build a drink above.</p>
+        <div class="quick-order__total">
+          <span>Total</span>
+          <span id="qo-total">$0.00</span>
+        </div>
+        <div class="quick-order__actions">
+          <button type="button" class="btn btn--ghost" id="qo-clear">Clear</button>
+          <a href="/order-online" class="btn" id="qo-checkout">Checkout</a>
+        </div>
+        <p class="quick-order__status" id="qo-status" role="status"></p>
+      </div>
