+
+  <script>
+    (function () {
+      var panel = document.getElementById('quick-order');
+      var handle = document.getElementById('qo-handle');
+      var toggle = document.getElementById('qo-toggle');
+      var form = document.getElementById('qo-body');
+      var drinkEl = document.getElementById('qo-drink');
+      var milkEl = document.getElementById('qo-milk');
+      var qtyEl = document.getElementById('qo-qty');
+      var priceEl = document.getElementById('qo-price');
+      var itemsEl = document.getElementById('qo-items');
+      var emptyEl = document.getElementById('qo-empty');
+      var totalEl = document.getElementById('qo-total');
+      var badgeEl = document.getElementById('qo-badge');
+      var statusEl = document.getElementById('qo-status');
+
+      var POS_KEY = 'dg-quick-order-pos';
+      var CART_KEY = 'dg-quick-order-cart';
+      var MARGIN = 8;
+      var qty = 1;
+      var cart = [];
+
+      function money(n) { return '$' + n.toFixed(2); }
+
+      function readStorage(key, fallback) {
+        try { return JSON.parse(localStorage.getItem(key)) || fallback; } catch (e) { return fallback; }
+      }
+      function writeStorage(key, value) {
+        try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* storage unavailable */ }
+      }
+
+      /* ---------- Dragging ---------- */
+      function clamp(x, y) {
+        var rect = panel.getBoundingClientRect();
+        var maxX = window.innerWidth - rect.width - MARGIN;
+        var maxY = window.innerHeight - rect.height - MARGIN;
+        return {
+          x: Math.min(Math.max(x, MARGIN), Math.max(maxX, MARGIN)),
+          y: Math.min(Math.max(y, MARGIN), Math.max(maxY, MARGIN))
+        };
+      }
+
+      function place(x, y, save) {
+        var p = clamp(x, y);
+        panel.style.left = p.x + 'px';
+        panel.style.top = p.y + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        if (save) writeStorage(POS_KEY, p);
+      }
+
+      function currentPos() {
+        var rect = panel.getBoundingClientRect();
+        return { x: rect.left, y: rect.top };
+      }
+
+      var drag = null;
+
+      handle.addEventListener('pointerdown', function (e) {
+        if (e.target.closest('button')) return;
+        if (e.button !== undefined && e.button !== 0) return;
+        var pos = currentPos();
+        drag = { id: e.pointerId, dx: e.clientX - pos.x, dy: e.clientY - pos.y };
+        handle.setPointerCapture(e.pointerId);
+        panel.classList.add('dragging');
+        e.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        place(e.clientX - drag.dx, e.clientY - drag.dy, false);
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag = null;
+        panel.classList.remove('dragging');
+        var pos = currentPos();
+        place(pos.x, pos.y, true);
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+
+      // Keyboard: arrow keys nudge the panel (Shift for bigger steps).
+      handle.addEventListener('keydown', function (e) {
+        var step = e.shiftKey ? 40 : 10;
+        var pos = currentPos();
+        var moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
+        if (moves[e.key]) {
+          e.preventDefault();
+          place(pos.x + moves[e.key][0], pos.y + moves[e.key][1], true);
+        } else if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          setCollapsed(!panel.classList.contains('collapsed'));
+        }
+      });
+
+      // Keep the panel on-screen if the window shrinks.
+      window.addEventListener('resize', function () {
+        if (panel.style.left) {
+          var pos = currentPos();
+          place(pos.x, pos.y, true);
+        }
+      });
+
+      var savedPos = readStorage(POS_KEY, null);
+      if (savedPos && typeof savedPos.x === 'number' && typeof savedPos.y === 'number') {
+        place(savedPos.x, savedPos.y, false);
+      }
+
+      /* ---------- Collapse / expand ---------- */
+      function setCollapsed(collapsed) {
+        panel.classList.toggle('collapsed', collapsed);
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', (collapsed ? 'Expand' : 'Collapse') + ' quick order panel');
+        toggle.innerHTML = collapsed ? '+' : '&#8722;';
+        // The panel changed height; make sure it is still within the viewport.
+        if (panel.style.left) {
+          var pos = currentPos();
+          place(pos.x, pos.y, true);
+        }
+      }
+      toggle.addEventListener('click', function () {
+        setCollapsed(!panel.classList.contains('collapsed'));
+      });
+
+      /* ---------- Drink builder ---------- */
+      function selectedOption(select) { return select.options[select.selectedIndex]; }
+      function optPrice(el) { return parseFloat(el.dataset.price || '0') || 0; }
+
+      function buildItem() {
+        var drink = selectedOption(drinkEl);
+        var size = form.querySelector('input[name="qo-size"]:checked');
+        var milk = selectedOption(milkEl);
+        var extras = Array.prototype.slice.call(form.querySelectorAll('input[name="qo-extra"]:checked'));
+        var unit = optPrice(drink) + optPrice(size) + optPrice(milk);
+        extras.forEach(function (x) { unit += optPrice(x); });
+        return {
+          name: drink.textContent,
+          size: size.value,
+          milk: milk.value,
+          extras: extras.map(function (x) { return x.value; }),
+          qty: qty,
+          unit: unit
+        };
+      }
+
+      function updatePrice() {
+        var item = buildItem();
+        qtyEl.textContent = String(item.qty);
+        priceEl.textContent = money(item.unit * item.qty);
+      }
+
+      form.addEventListener('change', updatePrice);
+      document.getElementById('qo-plus').addEventListener('click', function () {
+        qty = Math.min(qty + 1, 12);
+        updatePrice();
+      });
+      document.getElementById('qo-minus').addEventListener('click', function () {
+        qty = Math.max(qty - 1, 1);
+        updatePrice();
+      });
+
+      /* ---------- Cart ---------- */
+      function itemKey(item) {
+        return [item.name, item.size, item.milk, item.extras.join(',')].join('|');
+      }
+
+      function renderCart() {
+        itemsEl.innerHTML = '';
+        var total = 0, count = 0;
+        cart.forEach(function (item, i) {
+          total += item.unit * item.qty;
+          count += item.qty;
+          var li = document.createElement('li');
+          var text = document.createElement('div');
+          var details = [item.size, item.milk !== 'None' ? item.milk + ' milk' : 'No milk'].concat(item.extras).join(' · ');
+          text.innerHTML = '<strong></strong><small></small>';
+          text.querySelector('strong').textContent = item.qty + ' × ' + item.name;
+          text.querySelector('small').textContent = details + ' — ' + money(item.unit * item.qty);
+          var remove = document.createElement('button');
+          remove.type = 'button';
+          remove.innerHTML = '&times;';
+          remove.setAttribute('aria-label', 'Remove ' + item.name);
+          remove.addEventListener('click', function () {
+            cart.splice(i, 1);
+            saveCart();
+            renderCart();
+            announce(item.name + ' removed.');
+          });
+          li.appendChild(text);
+          li.appendChild(remove);
+          itemsEl.appendChild(li);
+        });
+        emptyEl.style.display = cart.length ? 'none' : '';
+        totalEl.textContent = money(total);
+        badgeEl.textContent = String(count);
+      }
+
+      function saveCart() { writeStorage(CART_KEY, cart); }
+
+      var statusTimer;
+      function announce(msg) {
+        statusEl.textContent = msg;
+        clearTimeout(statusTimer);
+        statusTimer = setTimeout(function () { statusEl.textContent = ''; }, 2500);
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var item = buildItem();
+        var key = itemKey(item);
+        var existing = null;
+        cart.forEach(function (c) { if (itemKey(c) === key) existing = c; });
+        if (existing) existing.qty += item.qty; else cart.push(item);
+        saveCart();
+        renderCart();
+        announce('Added ' + item.qty + ' × ' + item.name + '.');
+        qty = 1;
+        updatePrice();
+      });
+
+      document.getElementById('qo-clear').addEventListener('click', function () {
+        if (!cart.length) return;
+        cart = [];
+        saveCart();
+        renderCart();
+        announce('Order cleared.');
+      });
+
+      cart = readStorage(CART_KEY, []).filter(function (c) {
+        return c && typeof c.unit === 'number' && typeof c.qty === 'number' && Array.isArray(c.extras);
+      });
+      renderCart();
+      updatePrice();
+    })();
+  </script>
+
 </body>
 
