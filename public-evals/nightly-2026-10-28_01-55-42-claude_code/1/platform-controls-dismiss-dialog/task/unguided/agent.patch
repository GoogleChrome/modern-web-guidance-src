+  <script>
+    (function () {
+      'use strict';
+
+      // True while we own a history entry pushed for the currently open dialog.
+      var ownsHistoryEntry = false;
+
+      // If the page is reloaded while a dialog's history entry is current, the
+      // dialog is no longer open, so neutralise the stale entry.
+      if (history.state && history.state.dailyGrindDialog) {
+        history.replaceState(null, '');
+      }
+
+      function openDialog(dialog) {
+        if (dialog.open) {
+          return;
+        }
+        dialog.showModal();
+        // Push a history entry so the platform back control (Android back
+        // gesture/button, iOS swipe-back, browser Back) closes the dialog
+        // instead of leaving the page.
+        try {
+          history.pushState({ dailyGrindDialog: dialog.id }, '');
+          ownsHistoryEntry = true;
+        } catch (err) {
+          ownsHistoryEntry = false;
+        }
+      }
+
+      function onDialogClosed() {
+        // Dialog closed by Escape, the close button, or a backdrop click:
+        // drop the history entry we pushed so Back doesn't need two presses.
+        if (ownsHistoryEntry) {
+          ownsHistoryEntry = false;
+          history.back();
+        }
+      }
+
+      window.addEventListener('popstate', function () {
+        // Back navigation: close whichever dialog is open. We clear the flag
+        // first so the resulting "close" event doesn't call history.back() again.
+        var openDialogEl = document.querySelector('dialog.drink-dialog[open]');
+        ownsHistoryEntry = false;
+        if (openDialogEl) {
+          openDialogEl.close();
+        }
+      });
+
+      var triggers = document.querySelectorAll('[data-dialog]');
+      Array.prototype.forEach.call(triggers, function (trigger) {
+        var dialog = document.getElementById(trigger.getAttribute('data-dialog'));
+        var fallbackHref = trigger.getAttribute('data-fallback-href');
+
+        if (!dialog || typeof dialog.showModal !== 'function') {
+          // Very old browser without <dialog>: fall back to the menu page.
+          trigger.addEventListener('click', function () {
+            if (fallbackHref) {
+              window.location.href = fallbackHref;
+            }
+          });
+          return;
+        }
+
+        trigger.addEventListener('click', function () {
+          openDialog(dialog);
+        });
+      });
+
+      var dialogs = document.querySelectorAll('dialog.drink-dialog');
+      Array.prototype.forEach.call(dialogs, function (dialog) {
+        dialog.addEventListener('close', onDialogClosed);
+
+        // Light dismiss on backdrop click for browsers that ignore closedby="any".
+        dialog.addEventListener('click', function (event) {
+          if (event.target === dialog) {
+            dialog.close();
+          }
+        });
+      });
+    })();
+  </script>
