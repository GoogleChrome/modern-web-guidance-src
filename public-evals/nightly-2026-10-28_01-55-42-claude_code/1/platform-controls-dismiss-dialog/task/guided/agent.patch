+  <script>
+    // Fallback for browsers without the Invoker Commands API (command / commandfor).
+    // Feature-detect on HTMLButtonElement.prototype; browsers with native support ignore this.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.addEventListener('click', function (event) {
+        var button = event.target.closest('button[commandfor][command]');
+        if (!button) return;
+        var target = document.getElementById(button.getAttribute('commandfor'));
+        if (!(target instanceof HTMLDialogElement)) return;
+        var command = button.getAttribute('command');
+        if (command === 'show-modal' && !target.open) {
+          // showModal() is required so Esc / back-gesture close requests work.
+          target.showModal();
+        } else if (command === 'close' && target.open) {
+          target.close();
+        }
+      });
+    }
+  </script>
