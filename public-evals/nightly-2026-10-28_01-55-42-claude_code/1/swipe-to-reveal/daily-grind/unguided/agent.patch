+  <script>
+    (function () {
+      'use strict';
+
+      var DIRECTION_LOCK_PX = 8;   // movement before we decide swipe vs. scroll
+      var CLICK_SUPPRESS_PX = 6;   // movement beyond which a release is not a tap
+      var FLICK_VELOCITY = 0.4;    // px/ms – a quick flick opens/closes regardless of distance
+
+      var items = Array.prototype.slice.call(document.querySelectorAll('.swipe-item'));
+      var toastEl = document.getElementById('toast');
+      var toastTimer = null;
+
+      function showToast(message) {
+        toastEl.textContent = message;
+        toastEl.classList.add('is-visible');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(function () {
+          toastEl.classList.remove('is-visible');
+        }, 2200);
+      }
+
+      function trayWidth(item) {
+        return item.querySelector('.swipe-actions').offsetWidth;
+      }
+
+      function setTranslate(item, x) {
+        item.querySelector('.card').style.transform = 'translateX(' + x + 'px)';
+      }
+
+      function setOpen(item, open) {
+        var toggle = item.querySelector('.swipe-toggle');
+        var buttons = item.querySelectorAll('.swipe-action');
+        item.classList.toggle('is-open', open);
+        item.classList.remove('is-dragging');
+        setTranslate(item, open ? -trayWidth(item) : 0);
+        toggle.setAttribute('aria-expanded', String(open));
+        toggle.setAttribute('aria-label', (open ? 'Hide' : 'Show') + ' actions for ' + item.dataset.drink);
+        Array.prototype.forEach.call(buttons, function (b) {
+          b.tabIndex = open ? 0 : -1;
+        });
+        if (open) {
+          items.forEach(function (other) {
+            if (other !== item && other.classList.contains('is-open')) setOpen(other, false);
+          });
+        }
+      }
+
+      function closeAll() {
+        items.forEach(function (item) {
+          if (item.classList.contains('is-open')) setOpen(item, false);
+        });
+      }
+
+      items.forEach(function (item) {
+        var card = item.querySelector('.card');
+        var toggle = item.querySelector('.swipe-toggle');
+        var state = null; // active gesture
+
+        card.addEventListener('pointerdown', function (e) {
+          // Primary button / single touch only; ignore presses that start on the toggle
+          if (e.button !== 0 || e.target.closest('.swipe-toggle')) return;
+          state = {
+            id: e.pointerId,
+            startX: e.clientX,
+            startY: e.clientY,
+            lastX: e.clientX,
+            lastT: e.timeStamp,
+            velocity: 0,
+            baseOffset: item.classList.contains('is-open') ? -trayWidth(item) : 0,
+            axis: null,     // 'x' once we commit to a horizontal swipe, 'y' to bail out
+            moved: false
+          };
+        });
+
+        card.addEventListener('pointermove', function (e) {
+          if (!state || e.pointerId !== state.id) return;
+          var dx = e.clientX - state.startX;
+          var dy = e.clientY - state.startY;
+
+          if (state.axis === null) {
+            if (Math.abs(dx) < DIRECTION_LOCK_PX && Math.abs(dy) < DIRECTION_LOCK_PX) return;
+            if (Math.abs(dy) > Math.abs(dx)) {
+              state.axis = 'y'; // vertical scroll – let the browser have it
+              return;
+            }
+            state.axis = 'x';
+            item.classList.add('is-dragging');
+            try { card.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
+          }
+          if (state.axis !== 'x') return;
+
+          state.moved = state.moved || Math.abs(dx) > CLICK_SUPPRESS_PX;
+
+          var dt = e.timeStamp - state.lastT;
+          if (dt > 0) state.velocity = (e.clientX - state.lastX) / dt;
+          state.lastX = e.clientX;
+          state.lastT = e.timeStamp;
+
+          var max = trayWidth(item);
+          var x = state.baseOffset + dx;
+          if (x > 0) x = x * 0.2;                               // rubber-band past closed
+          if (x < -max) x = -max + (x + max) * 0.2;             // rubber-band past open
+          setTranslate(item, x);
+          e.preventDefault();
+        });
+
+        function finish(e, cancelled) {
+          if (!state || e.pointerId !== state.id) return;
+          var s = state;
+          state = null;
+          try { card.releasePointerCapture(e.pointerId); } catch (err) { /* ignore */ }
+
+          if (s.axis !== 'x') {
+            item.classList.remove('is-dragging');
+            return;
+          }
+
+          var max = trayWidth(item);
+          var dx = e.clientX - s.startX;
+          var current = s.baseOffset + dx;
+          var open;
+          if (cancelled) {
+            open = s.baseOffset !== 0;
+          } else if (Math.abs(s.velocity) > FLICK_VELOCITY) {
+            open = s.velocity < 0;                      // flick left opens, flick right closes
+          } else {
+            open = -current > max / 2;
+          }
+          setOpen(item, open);
+
+          if (s.moved) {
+            // The release ends a drag, not a tap: swallow the click so the
+            // "View Details" link (or anything else) doesn't fire.
+            var swallow = function (ev) {
+              ev.preventDefault();
+              ev.stopPropagation();
+            };
+            card.addEventListener('click', swallow, true);
+            setTimeout(function () { card.removeEventListener('click', swallow, true); }, 0);
+          }
+        }
+
+        card.addEventListener('pointerup', function (e) { finish(e, false); });
+        card.addEventListener('pointercancel', function (e) { finish(e, true); });
+        card.addEventListener('lostpointercapture', function (e) {
+          if (state && e.pointerId === state.id) finish(e, true);
+        });
+        card.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+        // Keyboard / mouse fallback for revealing the same actions
+        toggle.addEventListener('click', function () {
+          var opening = !item.classList.contains('is-open');
+          setOpen(item, opening);
+          if (opening) item.querySelector('.swipe-action').focus();
+        });
+
+        item.addEventListener('keydown', function (e) {
+          if (e.key === 'Escape' && item.classList.contains('is-open')) {
+            setOpen(item, false);
+            toggle.focus();
+          }
+        });
+
+        // Actions only run on an explicit tap/click of a revealed button
+        item.querySelector('.swipe-actions').addEventListener('click', function (e) {
+          var btn = e.target.closest('.swipe-action');
+          if (!btn || !item.classList.contains('is-open')) return;
+          var drink = item.dataset.drink;
+          var slug = item.dataset.slug;
+
+          switch (btn.dataset.action) {
+            case 'order':
+              showToast(drink + ' added to your order');
+              break;
+            case 'favorite': {
+              var saved = btn.getAttribute('aria-pressed') !== 'true';
+              btn.setAttribute('aria-pressed', String(saved));
+              btn.querySelector('span').innerHTML = saved ? '&#9829;' : '&#9825;';
+              btn.lastChild.textContent = saved ? 'Saved' : 'Save';
+              showToast(saved ? drink + ' saved to favorites' : drink + ' removed from favorites');
+              break;
+            }
+            case 'share': {
+              var url = location.origin + '/menu/' + slug;
+              if (navigator.share) {
+                navigator.share({ title: drink + ' | The Daily Grind', url: url }).catch(function () {});
+              } else if (navigator.clipboard && navigator.clipboard.writeText) {
+                navigator.clipboard.writeText(url).then(function () {
+                  showToast('Link to ' + drink + ' copied');
+                }, function () {
+                  showToast(url);
+                });
+              } else {
+                showToast(url);
+              }
+              break;
+            }
+          }
+        });
+      });
+
+      // Tapping anywhere outside an open card closes it
+      document.addEventListener('pointerdown', function (e) {
+        if (!e.target.closest('.swipe-item.is-open')) closeAll();
+      });
+
+      // Keep the open offset correct if the tray width changes with layout
+      window.addEventListener('resize', function () {
+        items.forEach(function (item) {
+          if (item.classList.contains('is-open')) setTranslate(item, -trayWidth(item));
+        });
+      });
+    })();
+  </script>
+
