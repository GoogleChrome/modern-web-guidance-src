+    /* Swipe-to-reveal drink cards
+       The card is a horizontal scroll-snap container: column 1 is the drink
+       content, column 2 is the hidden action panel. Swiping left snaps the
+       panel into view; nothing is executed until a button is pressed. */
+    .SwipeReveal {
+      padding: 0;
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      /* Chain excess scroll to the page without bouncing the action panel. */
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      padding: 20px;
+      background: white;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-hint {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 8px;
+      margin-top: 12px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    .SwipeReveal-more {
+      background: none;
+      border: 1px solid var(--secondary);
+      border-radius: 999px;
+      padding: 2px 10px;
+      font: inherit;
+      font-size: 0.75rem;
+      color: var(--primary);
+      cursor: pointer;
+    }
+
+    .SwipeReveal-more:hover {
+      background: var(--secondary);
+    }
+
+    .SwipeReveal-panel {
+      /* Snap to `end` so every button is fully in view when revealed. */
+      scroll-snap-align: end;
+      display: flex;
+      align-items: stretch;
+      background: var(--secondary);
+    }
+
+    .SwipeReveal-panel button {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      gap: 6px;
+      min-inline-size: 84px;
+      padding: 12px;
+      border: 0;
+      border-inline-start: 1px solid rgba(78, 52, 46, 0.15);
+      background: transparent;
+      color: var(--primary);
+      font: inherit;
+      font-size: 0.8rem;
+      font-weight: 600;
+      cursor: pointer;
+      transition: background 0.2s;
+    }
+
+    .SwipeReveal-panel button:hover,
+    .SwipeReveal-panel button:focus-visible {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .SwipeReveal-panel button[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    .SwipeReveal-panel .icon {
+      font-size: 1.4rem;
+      line-height: 1;
+    }
+
+    .SwipeReveal-status {
+      min-height: 1.5em;
+      margin-top: 16px;
+      text-align: center;
+      font-size: 0.9rem;
+      color: var(--primary);
+    }
+
