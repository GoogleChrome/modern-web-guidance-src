+  <script>
+    (() => {
+      const status = document.querySelector('.SwipeReveal-status');
+
+      for (const card of document.querySelectorAll('.SwipeReveal')) {
+        const content = card.querySelector('.SwipeReveal-content');
+        const panel = card.querySelector('.SwipeReveal-panel');
+        const drink = card.dataset.drink;
+
+        // Keyboard: focusing the content (or anything inside it) snaps the
+        // panel closed. Pointer/touch interactions are left alone.
+        content.addEventListener('focusin', (event) => {
+          if (event.target.matches(':focus-visible')) {
+            content.scrollIntoView({ block: 'nearest', inline: 'start' });
+          }
+        });
+
+        // Mouse/keyboard affordance for users who can't swipe.
+        card.querySelector('.SwipeReveal-more').addEventListener('click', () => {
+          panel.scrollIntoView({ block: 'nearest', inline: 'end' });
+          panel.querySelector('button').focus({ preventScroll: true });
+        });
+
+        // Actions only run on an explicit button press, never on the swipe.
+        panel.addEventListener('click', (event) => {
+          const button = event.target.closest('button[data-action]');
+          if (!button) return;
+
+          let message = '';
+          switch (button.dataset.action) {
+            case 'favorite': {
+              const on = button.getAttribute('aria-pressed') !== 'true';
+              button.setAttribute('aria-pressed', String(on));
+              button.querySelector('.icon').innerHTML = on ? '&#9829;' : '&#9825;';
+              message = on ? `${drink} saved to favorites.` : `${drink} removed from favorites.`;
+              break;
+            }
+            case 'order':
+              message = `${drink} added to your order.`;
+              break;
+            case 'share':
+              message = `Share link for ${drink} copied.`;
+              if (navigator.clipboard) {
+                navigator.clipboard.writeText(location.origin + card.querySelector('.btn').getAttribute('href')).catch(() => {});
+              }
+              break;
+          }
+
+          status.textContent = message;
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        });
+      }
+    })();
+  </script>
+
 </body>
 
