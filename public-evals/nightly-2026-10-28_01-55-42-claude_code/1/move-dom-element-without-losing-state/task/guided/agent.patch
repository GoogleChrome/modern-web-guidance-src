+  <script>
+    (() => {
+      const player = document.getElementById('video-player');
+      const homeSlot = document.getElementById('video-home');
+      const theaterSlot = document.getElementById('hero-stage');
+      const hero = document.querySelector('.hero');
+      const toggle = document.getElementById('theater-toggle');
+      if (!player || !homeSlot || !theaterSlot || !hero || !toggle) return;
+
+      // moveBefore() performs an atomic move, so the <iframe> inside the player
+      // keeps its document (and playback position) instead of reloading.
+      const supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      function moveInto(parent, node) {
+        if (supportsMoveBefore) {
+          parent.moveBefore(node, null);
+          return;
+        }
+        // Fallback for browsers without moveBefore(): a classic remove + insert.
+        // The iframe will reload here, and focus is lost, so restore it manually.
+        const hadFocus = node.contains(document.activeElement);
+        parent.appendChild(node);
+        if (hadFocus) toggle.focus();
+      }
+
+      function setTheaterMode(on) {
+        if (on) {
+          // Reveal the hero stage before moving so the player never lands in a hidden parent.
+          theaterSlot.hidden = false;
+          hero.classList.add('hero--theater');
+          moveInto(theaterSlot, player);
+          homeSlot.classList.add('video-home--empty');
+        } else {
+          moveInto(homeSlot, player);
+          homeSlot.classList.remove('video-home--empty');
+          hero.classList.remove('hero--theater');
+          theaterSlot.hidden = true;
+        }
+
+        toggle.setAttribute('aria-pressed', String(on));
+        toggle.textContent = on ? 'Exit theater mode' : 'Theater mode';
+
+        const target = on ? hero : homeSlot;
+        target.scrollIntoView({ behavior: 'smooth', block: on ? 'start' : 'center' });
+      }
+
+      toggle.addEventListener('click', () => {
+        setTheaterMode(toggle.getAttribute('aria-pressed') !== 'true');
+      });
+    })();
+  </script>
+
