+  <script>
+    (function () {
+      var VIDEO_ID = 'N6BJVM5tvnw';
+      var EMBED_BASE = 'https://www.youtube-nocookie.com/embed/' + VIDEO_ID;
+
+      var iframe = document.getElementById('roast-video');
+      var homeSlot = document.getElementById('video-home');
+      var stage = document.getElementById('video-stage');
+      var hero = document.getElementById('hero');
+      var toggle = document.getElementById('theater-toggle');
+      var inTheater = false;
+
+      /*
+       * Moving an iframe with appendChild()/insertBefore() destroys its browsing
+       * context, so the video reloads and playback is lost. Node.moveBefore()
+       * (Chrome 133+, Safari 26+, Firefox 144+) performs an "atomic move" that
+       * keeps the iframe's document, playback position and focus intact.
+       */
+      var canMoveAtomically = typeof iframe.moveBefore === 'function';
+
+      /* ---------- Fallback for browsers without moveBefore() ---------- */
+      /*
+       * We can't stop the reload, so we use the YouTube IFrame Player API to
+       * read the current time / play state right before the move, prime the
+       * iframe URL with start=, autoplay= and mute= so the reload resumes where
+       * it left off, then re-attach the API to the freshly loaded document.
+       */
+      var player = null;
+      var playerReady = false;
+
+      function loadPlayerApi() {
+        window.onYouTubeIframeAPIReady = attachPlayer;
+        var script = document.createElement('script');
+        script.src = 'https://www.youtube.com/iframe_api';
+        script.async = true;
+        document.head.appendChild(script);
+      }
+
+      function attachPlayer(restore) {
+        playerReady = false;
+        if (!window.YT || !window.YT.Player) return;
+        player = new window.YT.Player(iframe, {
+          events: {
+            onReady: function () {
+              playerReady = true;
+              if (restore && restore.rate !== 1) {
+                try { player.setPlaybackRate(restore.rate); } catch (e) { /* ignore */ }
+              }
+            }
+          }
+        });
+      }
+
+      function snapshotPlayback() {
+        if (!player || !playerReady) return null;
+        try {
+          var state = player.getPlayerState();
+          return {
+            time: player.getCurrentTime() || 0,
+            playing: state === window.YT.PlayerState.PLAYING ||
+                     state === window.YT.PlayerState.BUFFERING,
+            muted: player.isMuted(),
+            rate: player.getPlaybackRate() || 1
+          };
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function legacyMove(target) {
+        var snap = snapshotPlayback();
+        var params = ['enablejsapi=1', 'rel=0'];
+        if (snap) {
+          params.push('start=' + Math.floor(snap.time));
+          if (snap.playing) params.push('autoplay=1');
+          if (snap.muted) params.push('mute=1');
+        }
+        playerReady = false;
+        // Prime the URL first so the one reload caused by the move lands on the saved position.
+        iframe.setAttribute('src', EMBED_BASE + '?' + params.join('&'));
+        target.appendChild(iframe);
+        // The old API bridge died with the old document; hook up a new one once it has loaded.
+        iframe.addEventListener('load', function onLoad() {
+          iframe.removeEventListener('load', onLoad);
+          attachPlayer(snap);
+        });
+      }
+
+      function moveVideo(target) {
+        if (canMoveAtomically) {
+          try {
+            target.moveBefore(iframe, null); // state-preserving move
+            return;
+          } catch (e) {
+            // e.g. HierarchyRequestError: fall through to the legacy path
+          }
+        }
+        legacyMove(target);
+      }
+
+      function setTheater(on) {
+        inTheater = on;
+        moveVideo(on ? stage : homeSlot);
+        hero.classList.toggle('theater', on);
+        document.body.classList.toggle('theater-mode', on);
+        toggle.setAttribute('aria-pressed', String(on));
+        toggle.textContent = on ? 'Exit theater mode' : 'Theater mode';
+        if (on) window.scrollTo({ top: 0, behavior: 'smooth' });
+      }
+
+      toggle.addEventListener('click', function () {
+        setTheater(!inTheater);
+      });
+
+      document.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape' && inTheater) setTheater(false);
+      });
+
+      // Only pull in the YouTube API when we actually need it for the fallback.
+      if (!canMoveAtomically) loadPlayerApi();
+    })();
+  </script>
