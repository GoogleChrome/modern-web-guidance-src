+    /* Customer Feedback Log */
+    .feedback-section {
+      margin-top: 60px;
+    }
+
+    .feedback-section h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .feedback-log {
+      --scrollbar-thumb: var(--accent);
+      --scrollbar-track: var(--primary);
+
+      max-height: 320px;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      padding: 20px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      scrollbar-width: thin;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+    }
+
+    /* Legacy fallback for WebKit/Blink browsers without scrollbar-color */
+    @supports not (scrollbar-color: auto) {
+      .feedback-log::-webkit-scrollbar {
+        width: 8px;
+      }
+
+      .feedback-log::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border-radius: 4px;
+      }
+
+      .feedback-log::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+    }
+
+    .feedback-log ul {
+      list-style: none;
+    }
+
+    .feedback-entry {
+      padding: 15px 0;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .feedback-entry:last-child {
+      border-bottom: none;
+      padding-bottom: 0;
+    }
+
+    .feedback-entry:first-child {
+      padding-top: 0;
+    }
+
+    .feedback-entry blockquote {
+      font-style: italic;
+      margin-bottom: 6px;
+    }
+
+    .feedback-entry figcaption {
+      font-size: 0.85rem;
+      color: var(--primary);
+      font-weight: bold;
+    }
+
+    .feedback-entry figcaption .rating {
+      color: var(--accent);
+      letter-spacing: 2px;
+      margin-left: 8px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
