+  <script>
+    (function () {
+      var STORAGE_KEY = 'daily-grind-theme';
+      var root = document.documentElement;
+      var themeSelect = document.getElementById('theme-select');
+
+      // Force the chosen theme on the root element. "system" removes the
+      // override so the prefers-color-scheme media query takes over again.
+      function applyTheme(theme) {
+        if (theme === 'light' || theme === 'dark') {
+          root.setAttribute('data-theme', theme);
+          root.style.colorScheme = theme;
+        } else {
+          theme = 'system';
+          root.removeAttribute('data-theme');
+          root.style.colorScheme = '';
+        }
+        themeSelect.value = theme;
+      }
+
+      function readSavedTheme() {
+        try {
+          return localStorage.getItem(STORAGE_KEY) || 'system';
+        } catch (e) {
+          return 'system';
+        }
+      }
+
+      function saveTheme(theme) {
+        try {
+          if (theme === 'system') {
+            localStorage.removeItem(STORAGE_KEY);
+          } else {
+            localStorage.setItem(STORAGE_KEY, theme);
+          }
+        } catch (e) { /* ignore storage errors */ }
+      }
+
+      applyTheme(readSavedTheme());
+
+      themeSelect.addEventListener('change', function () {
+        var theme = themeSelect.value;
+        applyTheme(theme);
+        saveTheme(theme);
+      });
+
+      // Keep multiple open tabs in sync.
+      window.addEventListener('storage', function (event) {
+        if (event.key === STORAGE_KEY) {
+          applyTheme(event.newValue || 'system');
+        }
+      });
+
+      // Late Night Specials filter (local to the always-dark section).
+      var filter = document.getElementById('special-filter');
+      var specials = document.querySelectorAll('#specials-list .special');
+      var emptyNote = document.getElementById('specials-empty');
+
+      filter.addEventListener('change', function () {
+        var value = filter.value;
+        var visible = 0;
+        specials.forEach(function (item) {
+          var show = value === 'all' || item.getAttribute('data-category') === value;
+          item.hidden = !show;
+          if (show) visible += 1;
+        });
+        emptyNote.hidden = visible > 0;
+      });
+    })();
+  </script>
