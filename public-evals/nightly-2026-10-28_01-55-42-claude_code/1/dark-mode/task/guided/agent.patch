+  <script>
+    (function () {
+      var STORAGE_KEY = "color-scheme";
+      var root = document.documentElement;
+      var meta = document.querySelector('meta[name="color-scheme"]');
+      var select = document.getElementById("theme-select");
+      var hint = document.getElementById("theme-hint");
+      var systemDark = window.matchMedia("(prefers-color-scheme: dark)");
+
+      function readStored() {
+        try {
+          var value = localStorage.getItem(STORAGE_KEY);
+          return value === "light" || value === "dark" ? value : null;
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function writeStored(value) {
+        try {
+          if (value) {
+            localStorage.setItem(STORAGE_KEY, value);
+          } else {
+            localStorage.removeItem(STORAGE_KEY);
+          }
+        } catch (e) { /* persistence unavailable; the theme is still applied */ }
+      }
+
+      // Force the chosen scheme on the root element. `null` restores the system default.
+      function applyScheme(value) {
+        var forced = value === "light" || value === "dark" ? value : null;
+        meta.content = forced || "light dark";
+        if (forced) {
+          root.dataset.theme = forced;
+        } else {
+          delete root.dataset.theme;
+        }
+        select.value = forced || "system";
+        updateHint();
+      }
+
+      function updateHint() {
+        var systemScheme = systemDark.matches ? "dark" : "light";
+        hint.textContent = root.dataset.theme
+          ? "Overriding system preference (" + systemScheme + ")"
+          : "Following system preference (currently " + systemScheme + ")";
+      }
+
+      select.addEventListener("change", function () {
+        var choice = select.value === "system" ? null : select.value;
+        writeStored(choice);
+        applyScheme(choice);
+      });
+
+      // Stay in sync if the preference changes in another tab.
+      window.addEventListener("storage", function (event) {
+        if (event.key === STORAGE_KEY || event.key === null) {
+          applyScheme(readStored());
+        }
+      });
+
+      // The system preference can change at any time (e.g. OS auto-switch at sunset).
+      systemDark.addEventListener("change", updateHint);
+
+      applyScheme(readStored());
+    })();
+
+    // Late night menu filter
+    (function () {
+      var filter = document.getElementById("late-night-filter");
+      var items = document.querySelectorAll(".late-night .special");
+
+      function applyFilter() {
+        var kind = filter.value;
+        items.forEach(function (item) {
