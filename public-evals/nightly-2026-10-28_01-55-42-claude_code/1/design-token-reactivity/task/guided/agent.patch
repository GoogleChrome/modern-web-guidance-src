       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Layout density (container style queries) */
+    :root {
+      /* Probe value: only readable by browsers that support style queries */
+      --style-queries-supported: check;
+    }
+
+    .density-controls {
+      text-align: center;
+      margin-top: 10px;
+    }
+
+    .density-toggle {
+      /* Hidden by default; revealed below only when style queries are supported */
+      display: none;
+      background: transparent;
+      color: var(--primary);
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+      padding: 6px 14px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: background 0.3s, color 0.3s;
+    }
+
+    .density-toggle:hover,
+    .density-toggle[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    @container style(--style-queries-supported) {
+      .density-toggle {
+        display: revert;
+      }
+    }
+
+    #target-container {
+      --density: compact;
+    }
+
+    #target-item {
+      transition: padding 0.3s;
+    }
+
+    /* The card reacts to its ancestor's --density token; no JS touches the card */
+    @container style(--density: spacious) {
+      #target-item {
+        padding: 48px 32px;
+      }
+    }
   </style>
 </head>
 
