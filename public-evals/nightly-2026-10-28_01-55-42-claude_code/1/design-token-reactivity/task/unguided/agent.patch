+  <script>
+    (function () {
+      var toggle = document.getElementById('toggle-spacious');
+      var container = document.getElementById('target-container');
+      if (!toggle || !container) return;
+
+      toggle.addEventListener('click', function () {
+        var current = getComputedStyle(container).getPropertyValue('--layout-density').trim();
+        var spacious = current !== 'spacious';
+        // Only the ancestor's custom property changes; CSS handles the card.
+        container.style.setProperty('--layout-density', spacious ? 'spacious' : 'compact');
+        toggle.setAttribute('aria-pressed', String(spacious));
+      });
+    })();
+  </script>
