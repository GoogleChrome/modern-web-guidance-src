+    /* Layout density (style-query driven) */
+    :root {
+      /* Probe value used only to feature-check style queries below */
+      --supports-style-queries: true;
+    }
+
+    .section-header {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 15px;
+      flex-wrap: wrap;
+    }
+
+    /* Hidden by default; revealed only when the browser can evaluate style queries */
+    #toggle-spacious {
+      display: none;
+      background: transparent;
+      color: var(--primary);
+      border: 1px solid var(--primary);
+      padding: 6px 14px;
+      border-radius: 5px;
+      font: inherit;
+      font-size: 0.85rem;
+      cursor: pointer;
+      transition: background 0.3s, color 0.3s;
+    }
+
+    #toggle-spacious:hover,
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    @container style(--supports-style-queries: true) {
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
+    #target-container {
+      container-name: layout;
+      --layout-density: compact;
+    }
+
+    #target-item {
+      transition: padding 0.3s ease;
+    }
+
+    /* The card reacts to its ancestor's custom property with no JS touching the card */
+    @container layout style(--layout-density: spacious) {
+      #target-item {
+        padding: 40px;
+      }
+    }
   </style>
