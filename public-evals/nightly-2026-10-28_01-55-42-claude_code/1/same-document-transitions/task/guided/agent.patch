+      animation-duration: 0.45s;
+      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
+    }
+
+    /* The thumbnail (4:5) and hero (21:9) differ in aspect ratio. Fill the pair
+       box and crop with object-fit so neither snapshot is stretched. */
+    ::view-transition-old(hero),
