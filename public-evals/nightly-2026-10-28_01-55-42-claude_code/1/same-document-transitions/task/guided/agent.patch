+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        price: '$5.75',
+        size: '12 oz / 16 oz',
+        description:
+          'Our signature autumn pour. Double-shot espresso folded into steamed oat milk and ' +
+          'sweetened with a splash of real Vermont maple syrup. Finished with a dusting of ' +
+          'cinnamon and nutmeg.',
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        price: '$3.25',
+        size: 'Single / Double',
+        description:
+          'A deep, smoky blend of Sumatran and Brazilian beans roasted past second crack. ' +
+          'Expect notes of dark chocolate, toasted walnut, and a long, velvety finish.',
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        price: '$4.50',
+        size: '16 oz / 20 oz',
+        description:
+          'Coarse-ground Ethiopian beans steeped in cold filtered water for 18 hours, then ' +
+          'served over ice. Naturally sweet, low in acidity, and impossibly smooth.',
+      },
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const hero = document.getElementById('hero');
+    const heroImg = document.getElementById('hero-img');
+    const title = document.getElementById('title');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    let currentId = null;
+
+    /**
+     * Run a DOM update inside a view transition when supported and motion is
+     * allowed; otherwise apply it immediately. Always resolves once the
+     * transition (if any) has finished so callers can clean up and route focus.
+     */
+    function transition(update) {
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        return Promise.resolve();
+      }
+      const vt = document.startViewTransition(update);
+      // `finished` rejects when a transition is skipped; cleanup must still run.
+      return vt.finished.catch(() => {});
+    }
+
+    function clearSelection() {
+      document.querySelectorAll('.thumbnail.selected').forEach((el) => {
+        el.classList.remove('selected');
+      });
+    }
+
+    function populateDetail(id) {
+      const item = ITEMS[id];
+      const thumb = listPage.querySelector(`.thumbnail[data-id="${id}"]`);
+      const thumbImg = thumb.querySelector('img');
+      heroImg.src = thumbImg.currentSrc || thumbImg.src;
+      heroImg.alt = thumbImg.alt;
+      title.textContent = item.title;
+      document.getElementById('detail-price').textContent = item.price;
+      document.getElementById('detail-size').textContent = item.size;
+      document.getElementById('detail-description').textContent = item.description;
+      document.title = `${item.title} | The Daily Grind`;
+    }
+
+    async function showDetail(id, { pushHistory = true } = {}) {
+      if (!ITEMS[id] || id === currentId) return;
+      const thumb = listPage.querySelector(`.thumbnail[data-id="${id}"]`);
+
+      // Prepare the "old" state: only the clicked card carries the shared names.
+      clearSelection();
+      thumb.classList.add('selected');
+      populateDetail(id);
+      currentId = id;
+
+      if (pushHistory) history.pushState({ id }, '', `#${id}`);
+
+      await transition(() => {
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        window.scrollTo({ top: 0, behavior: 'instant' });
+      });
+
+      // Route focus so keyboard / AT users land on the new view's heading.
+      title.focus({ preventScroll: true });
+    }
+
+    async function showList({ pushHistory = true } = {}) {
+      if (currentId === null) return;
+      currentId = null;
+      document.title = 'The Daily Grind | Artisanal Coffee';
+
+      if (pushHistory) history.pushState({}, '', location.pathname + location.search);
+
+      await transition(() => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+      });
+
+      // Clean up temporary transition hooks now that the morph is done.
+      clearSelection();
+      heroImg.removeAttribute('src');
+      heroImg.alt = '';
+
+      listHeading.focus({ preventScroll: true });
+    }
+
+    // Clicking a thumbnail opens its detail view.
+    listPage.addEventListener('click', (event) => {
+      const thumb = event.target.closest('.thumbnail');
+      if (!thumb) return;
+      event.preventDefault();
+      showDetail(thumb.dataset.id);
+    });
+
+    document.getElementById('back').addEventListener('click', () => showList());
+
+    // Keep browser back/forward in sync with the view.
+    window.addEventListener('popstate', () => {
+      const id = location.hash.slice(1);
+      if (ITEMS[id]) {
+        showDetail(id, { pushHistory: false });
+      } else {
+        showList({ pushHistory: false });
+      }
+    });
+
+    // Deep link support (e.g. index.html#cold-brew) without an animation.
+    const initialId = location.hash.slice(1);
+    if (ITEMS[initialId]) {
+      const thumb = listPage.querySelector(`.thumbnail[data-id="${initialId}"]`);
+      thumb.classList.add('selected');
+      populateDetail(initialId);
+      currentId = initialId;
+      listPage.hidden = true;
+      detailPage.hidden = false;
+    }
+  </script>
+
 </body>
 
 </html>
