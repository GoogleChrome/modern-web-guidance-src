+
+    /* Text: both titles use width: fit-content (see .title / #title above), so
+       the group keeps a stable aspect ratio and the default snapshot sizing
+       (width: 100%; height: auto) scales the text uniformly, with no stretch. */
+
+    @media (prefers-reduced-motion: reduce) {
