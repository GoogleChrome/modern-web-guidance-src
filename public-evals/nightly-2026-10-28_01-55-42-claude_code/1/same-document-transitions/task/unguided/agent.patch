+
+    ::view-transition-group(*) {
+      animation-duration: var(--morph-duration);
+      animation-timing-function: var(--morph-easing);
+    }
+
+    /* Keep the title above the hero while both groups fly. */
+    ::view-transition-group(title) {
+      z-index: 2;
+    }
+
+    /* Hero morph: the thumbnail (4:3) and hero (21:9) have different aspect
+       ratios. Make both snapshots fill the animating box and crop with
+       object-fit: cover so the photo never stretches. */
+    ::view-transition-old(hero),
+    ::view-transition-new(hero) {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    /* Title morph: text snapshots must scale uniformly. Letting each snapshot
+       fit inside the animating box (object-fit: contain, anchored to the
+       left) keeps the glyphs' proportions even when the line wraps or the
+       font size ratio differs from the box ratio. */
+    ::view-transition-old(title),
+    ::view-transition-new(title) {
+      width: 100%;
+      height: 100%;
+      object-fit: contain;
+      object-position: left center;
+    }
+
+    /* Avoid accidental interaction while a morph is running. */
+    html.is-transitioning {
+      pointer-events: none;
+    }
+
+    /* ---- Reduced motion: no animations of any kind ---- */
+    @media (prefers-reduced-motion: reduce) {
+
+      *,
+      *::before,
+      *::after {
+        animation: none !important;
+        transition: none !important;
+      }
+
+      ::view-transition-group(*),
+      ::view-transition-image-pair(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
