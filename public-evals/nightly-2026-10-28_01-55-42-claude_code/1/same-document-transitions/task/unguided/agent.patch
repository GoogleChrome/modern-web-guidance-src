+      // Warm the cache for the large hero image so the morph lands on a
+      // painted photo rather than an empty box. Resolves when decoded, or
+      // after a short cap so a slow network never blocks navigation.
+      function preloadHero(drink, maxWait) {
+        var url = imageUrl(drink.image, 1400);
+        if (!preloaded[url]) {
+          var img = new Image();
+          img.src = url;
+          preloaded[url] = (img.decode ? img.decode() : Promise.resolve()).catch(function () {});
+        }
+        if (!maxWait) return preloaded[url];
+        return Promise.race([
+          preloaded[url],
+          new Promise(function (resolve) { setTimeout(resolve, maxWait); })
+        ]);
+      }
+
+      // ---------- Render list ----------
+      function renderList() {
+        var frag = document.createDocumentFragment();
+        DRINKS.forEach(function (drink) {
+          var card = document.createElement('a');
+          card.className = 'thumbnail';
+          card.href = '#/drink/' + drink.slug;
+          card.dataset.slug = drink.slug;
+
+          var img = document.createElement('img');
