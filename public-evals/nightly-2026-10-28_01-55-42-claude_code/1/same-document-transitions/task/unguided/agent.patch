+
+          var caption = document.createElement('div');
+          caption.className = 'caption';
+
+          var h2 = document.createElement('h2');
+          h2.className = 'title';
+          h2.textContent = drink.title;
+
+          var tagline = document.createElement('p');
+          tagline.className = 'tagline';
+          tagline.textContent = drink.tagline;
+
+          caption.appendChild(h2);
+          caption.appendChild(tagline);
+          card.appendChild(img);
+          card.appendChild(caption);
+
+          // Start fetching the hero image as soon as the user shows intent.
+          var warm = function () { preloadHero(drink); };
+          card.addEventListener('pointerenter', warm, { once: true });
