+  <dialog id="logout-dialog" class="logout-dialog" closedby="any" aria-labelledby="logout-dialog-title">
+    <h2 id="logout-dialog-title">Are you sure?</h2>
+    <p>You will be signed out of your Daily Grind account.</p>
+    <form method="dialog" class="dialog-actions">
+      <button type="submit" value="cancel" class="btn btn-secondary" autofocus>Cancel</button>
+      <button type="submit" value="logout" class="btn">Log out</button>
+    </form>
+  </dialog>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('logout-dialog');
+      const trigger = document.querySelector('.test-dialog-trigger');
+
+      // Fallback for browsers without Invoker Commands (command/commandfor)
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        trigger.addEventListener('click', () => dialog.showModal());
+      }
+
+      // Fallback light dismiss for browsers without `closedby` support
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        // Test the pointer position, not event.target: the <dialog> is also the
+        // target for its own padding and the gaps between its children.
+        const outside = (e) => {
+          const r = dialog.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+        // Require press and release outside, so a drag ending on the backdrop does not dismiss
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e)) dialog.close();
+        });
+      }
+
+      // Only navigate when the user explicitly confirmed; Esc/backdrop/Cancel just close
+      dialog.addEventListener('close', () => {
+        const choice = dialog.returnValue;
+        dialog.returnValue = '';
+        if (choice === 'logout') window.location.href = '/logout';
+      });
+    })();
+  </script>
+
