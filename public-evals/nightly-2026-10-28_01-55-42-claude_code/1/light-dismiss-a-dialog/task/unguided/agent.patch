+  <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-dialog-title">
+    <div class="logout-dialog-content">
+      <h2 id="logout-dialog-title">Are you sure?</h2>
+      <p>You are about to log out of your Daily Grind account.</p>
+      <div class="logout-dialog-actions">
+        <button type="button" class="btn btn-secondary" id="logout-cancel">Cancel</button>
