+  <script>
+    (function () {
+      var trigger = document.getElementById('logout-trigger');
+      var dialog = document.getElementById('logout-dialog');
+      var cancel = document.getElementById('logout-cancel');
+
+      trigger.addEventListener('click', function (event) {
+        event.preventDefault();
+        dialog.showModal();
+      });
+
+      cancel.addEventListener('click', function () {
+        dialog.close();
+      });
+
+      // Close when the user clicks anywhere on the backdrop (outside the dialog box).
+      dialog.addEventListener('click', function (event) {
+        var rect = dialog.getBoundingClientRect();
+        var inside =
+          event.clientX >= rect.left && event.clientX <= rect.right &&
+          event.clientY >= rect.top && event.clientY <= rect.bottom;
+        if (!inside || event.target === dialog) {
+          dialog.close();
+        }
+      });
+    })();
+  </script>
