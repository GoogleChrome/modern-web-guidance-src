diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -19,15 +19,75 @@
       margin: 0;
       padding: 0;
     }
 
+    /* The root is the scroll container. Proximity snapping keeps the
+       search bar either fully revealed or fully hidden without locking
+       the rest of the page to snap points. */
+    html {
+      scroll-snap-type: y proximity;
+    }
+
     body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Pull-to-reveal search bar: sits above the nav, hidden on load */
+    .search-bar {
+      background: var(--text);
+      color: white;
+      padding: 0.75rem 5%;
+      scroll-snap-align: start;
+    }
+
+    .search-bar form {
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+      max-width: 1100px;
+      margin: 0 auto;
+    }
+
+    .search-bar label {
+      font-size: 0.85rem;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+    }
+
+    .search-bar input[type="search"] {
+      flex: 1;
+      min-width: 0;
+      padding: 0.5rem 0.75rem;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      font: inherit;
+      font-size: 0.95rem;
+      color: var(--text);
+      background: var(--light);
+    }
+
+    .search-bar input[type="search"]:focus-visible,
+    .search-bar button:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .search-bar button {
+      padding: 0.5rem 1rem;
+      border: none;
+      border-radius: 4px;
+      background: var(--accent);
+      color: var(--text);
+      font: inherit;
+      font-size: 0.9rem;
+      font-weight: 600;
+      cursor: pointer;
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
