+    /* Options dropdown: trigger */
+    .options-trigger {
+      /* Explicit anchor name so the panel can tether to this button
+         (also required by the anchor-positioning polyfill). */
+      anchor-name: --options-trigger;
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      min-block-size: 24px;
+      padding: 4px 6px;
+      background: none;
+      border: 0;
+      border-radius: 4px;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: color 0.3s;
+    }
+
+    .options-trigger:hover {
+      color: var(--accent);
+    }
+
+    .options-trigger::after {
+      content: "";
+      inline-size: 0.45em;
+      block-size: 0.45em;
+      border-inline-end: 2px solid currentColor;
+      border-block-end: 2px solid currentColor;
+      transform: translateY(-25%) rotate(45deg);
+      transition: transform 0.2s;
+    }
+
+    .options-trigger:is(:has(+ :popover-open), :has(+ .\:popover-open))::after {
+      transform: translateY(25%) rotate(-135deg);
+    }
+
+    :where(nav a, .options-trigger, .action-item):focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Options dropdown: panel (rendered in the top layer via popover="auto") */
+    .action-panel {
+      /* Tether to the trigger: directly below, aligned to its left edge. */
+      position: fixed;
+      position-anchor: --options-trigger;
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 0;
+      margin-block-start: 8px;
+
+      /* If the panel would be cut off, flip below->above, left->right, or both. */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      min-inline-size: 220px;
+      padding: 6px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    /* `:is()` keeps the rule valid in browsers that need the popover polyfill. */
+    [popover]:is(:popover-open, .\:popover-open) {
+      display: block;
+    }
+
+    .action-item {
+      display: block;
+      inline-size: 100%;
+      min-block-size: 24px;
+      padding: 10px 14px;
+      border: 0;
+      border-radius: 5px;
+      background: none;
+      color: inherit;
+      font: inherit;
+      font-size: 0.9rem;
+      text-align: start;
+      cursor: pointer;
+      transition: background 0.2s;
+    }
+
+    .action-item:hover {
+      background: var(--secondary);
+    }
+
+    @media (pointer: coarse) {
+      .action-item {
+        padding-block: 14px;
+      }
+    }
+
