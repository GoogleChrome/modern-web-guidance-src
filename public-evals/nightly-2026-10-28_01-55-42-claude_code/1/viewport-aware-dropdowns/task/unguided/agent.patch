+  <script>
+    (function () {
+      var trigger = document.getElementById('trigger-btn');
+      var panel = document.getElementById('action-panel');
+      if (!trigger || !panel) return;
+
+      var supportsPopover = typeof HTMLElement !== 'undefined' &&
+        Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover');
+      var supportsAnchor = typeof CSS !== 'undefined' && CSS.supports &&
+        CSS.supports('anchor-name: --x') &&
+        CSS.supports('position-area: bottom span-right');
+
+      var GAP = 8; // minimum distance from the viewport edge
+
+      function isOpen() {
+        return supportsPopover ? panel.matches(':popover-open') : panel.classList.contains('is-open');
+      }
+
+      // Manual positioning used only when CSS Anchor Positioning is unavailable.
+      // Mirrors the CSS: below + left-aligned, flipping vertically and/or horizontally on collision.
+      function positionPanel() {
+        if (supportsAnchor || !isOpen()) return;
+        var r = trigger.getBoundingClientRect();
+        var w = panel.offsetWidth;
+        var h = panel.offsetHeight;
+        var vw = document.documentElement.clientWidth;
+        var vh = document.documentElement.clientHeight;
+
+        var top = r.bottom;
+        if (top + h > vh - GAP && r.top - h >= GAP) {
+          top = r.top - h; // flip above
+        }
+        top = Math.max(GAP, Math.min(top, vh - h - GAP));
+
+        var left = r.left;
+        if (left + w > vw - GAP && r.right - w >= GAP) {
+          left = r.right - w; // flip to align right edges
+        }
+        left = Math.max(GAP, Math.min(left, vw - w - GAP));
+
+        panel.style.top = top + 'px';
+        panel.style.left = left + 'px';
+      }
+
+      function syncState(open) {
+        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
+        if (open) {
+          positionPanel();
+          window.addEventListener('resize', positionPanel);
+          window.addEventListener('scroll', positionPanel, true);
+        } else {
+          window.removeEventListener('resize', positionPanel);
+          window.removeEventListener('scroll', positionPanel, true);
+        }
+      }
+
+      function closePanel() {
+        if (supportsPopover) {
+          if (isOpen()) panel.hidePopover();
+        } else {
+          panel.classList.remove('is-open');
+          syncState(false);
+        }
+      }
+
+      if (supportsPopover) {
+        panel.addEventListener('toggle', function (e) {
+          syncState(e.newState === 'open');
+        });
+      } else {
+        // Fallback: emulate popover="auto" behaviour (toggle, light dismiss, Escape).
+        panel.removeAttribute('popover');
+        trigger.removeAttribute('popovertarget');
+        trigger.addEventListener('click', function () {
+          var open = !isOpen();
+          panel.classList.toggle('is-open', open);
+          syncState(open);
+        });
+        document.addEventListener('click', function (e) {
+          if (isOpen() && !panel.contains(e.target) && !trigger.contains(e.target)) closePanel();
+        });
+        document.addEventListener('keydown', function (e) {
+          if (e.key === 'Escape' && isOpen()) {
+            closePanel();
+            trigger.focus();
+          }
+        });
+      }
+
+      panel.addEventListener('click', function (e) {
+        var btn = e.target.closest('.action-btn');
+        if (!btn) return;
+        closePanel();
+        var href = btn.getAttribute('data-href');
+        if (href) window.location.assign(href);
+      });
+    })();
+  </script>
