+  <script>
+    (() => {
+      const canvas = document.getElementById('card_canvas');
+      const card = document.getElementById('export_element');
+      const form = document.getElementById('designer_form');
+      const messageInput = document.getElementById('card_message');
+      const messagePreview = document.getElementById('card_message_preview');
+      const customColor = document.getElementById('card_custom_color');
+      const exportButton = document.getElementById('export_button');
+      const status = document.getElementById('designer_status');
+
+      const setStatus = (text, tone = 'info') => {
+        status.textContent = text;
+        status.dataset.tone = tone;
+      };
+
+      // --- Feature detection ------------------------------------------------
+      const supportsHtmlInCanvas =
+        'content' in HTMLCanvasElement.prototype &&
+        typeof canvas.requestPaint === 'function' &&
+        typeof CanvasRenderingContext2D.prototype.drawElementImage === 'function';
+
+      // --- Card state -------------------------------------------------------
+      const isLightColor = (hex) => {
+        const value = hex.replace('#', '');
+        const [r, g, b] = [0, 2, 4].map((i) => parseInt(value.slice(i, i + 2), 16) / 255);
+        const lin = (c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+        const luminance = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
+        return luminance > 0.4;
+      };
+
+      const applyBackground = (hex) => {
+        card.style.setProperty('--card-bg', hex);
+        card.classList.toggle('is-light', isLightColor(hex));
+      };
+
+      const applyMessage = () => {
+        const text = messageInput.value.trim();
+        messagePreview.textContent = text || 'Your message here';
+      };
+
+      form.addEventListener('input', (event) => {
+        const target = event.target;
+        if (target === messageInput) {
+          applyMessage();
+        } else if (target === customColor) {
+          // Picking a custom colour deselects the preset swatches.
+          form.querySelectorAll('input[name="bg"]').forEach((r) => { r.checked = false; });
+          applyBackground(customColor.value);
+        } else if (target.name === 'bg') {
+          customColor.value = target.value;
+          applyBackground(target.value);
+        }
+        // The DOM changed, so ask the canvas to repaint the drawable element.
+        if (supportsHtmlInCanvas) canvas.requestPaint();
+      });
+
+      form.addEventListener('submit', (event) => event.preventDefault());
+
+      if (!supportsHtmlInCanvas) {
+        // Fallback: show the card as plain HTML (canvas fallback content is
+        // normally hidden) and explain that image export is unavailable.
+        const stage = document.createElement('div');
+        stage.className = 'gift-card-stage';
+        stage.append(card);
+        canvas.replaceWith(stage);
+        exportButton.disabled = true;
+        setStatus('Image download needs a browser that supports HTML-in-Canvas. You can still preview your design here.', 'error');
+        applyMessage();
+        applyBackground(customColor.value);
+        return;
+      }
+
+      // --- HTML-in-Canvas rendering -----------------------------------------
+      const ctx = canvas.getContext('2d');
+
+      // Paint handler: draws the latest snapshot of the card into the canvas.
+      // drawElementImage() also keeps the element's hit-test geometry in sync.
+      canvas.addEventListener('paint', () => {
+        ctx.reset();
+        try {
+          ctx.drawElementImage(card, 0, 0);
+        } catch (err) {
+          // No paint record for the element yet; try again on the next frame.
+          canvas.requestPaint();
+        }
+      });
+
+      // Keep the canvas backing store at device-pixel resolution so the
+      // exported PNG is crisp on high-DPI screens.
+      const resizeObserver = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        canvas.requestPaint();
+      });
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      resizeObserver.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      // Resolves after the next paint event so the export reflects the latest
+      // DOM state. Times out as a safety net if no paint event is delivered.
+      const afterNextPaint = () => new Promise((resolve) => {
+        const timer = setTimeout(resolve, 500);
+        canvas.addEventListener('paint', () => {
+          clearTimeout(timer);
+          // Let the paint listener above finish drawing before we read pixels.
+          requestAnimationFrame(() => resolve());
+        }, { once: true });
+        canvas.requestPaint();
+      });
+
+      const toBlob = (type) => new Promise((resolve, reject) => {
+        canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('Canvas export failed'))), type);
+      });
+
+      const fileNameFor = (text) => {
+        const slug = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40);
+        return `daily-grind-gift-card${slug ? '-' + slug : ''}.png`;
+      };
+
+      exportButton.addEventListener('click', async () => {
+        exportButton.disabled = true;
+        setStatus('Preparing your image…');
+        try {
+          await afterNextPaint();
+          const blob = await toBlob('image/png');
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = fileNameFor(messageInput.value);
+          document.body.append(link);
+          link.click();
+          link.remove();
+          // Give the browser a moment to start the download before revoking.
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          setStatus('Your gift card image has been downloaded.');
+        } catch (err) {
+          console.error(err);
+          setStatus('Sorry, the image could not be exported. Please try again.', 'error');
+        } finally {
+          exportButton.disabled = false;
+        }
+      });
+
+      applyMessage();
+      applyBackground(customColor.value);
+      canvas.requestPaint();
+    })();
+  </script>
+
 </body>
 
