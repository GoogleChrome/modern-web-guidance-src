+  <script>
+    (function () {
+      'use strict';
+
+      var canvas = document.getElementById('card_canvas');
+      var card = document.getElementById('export_element');
+      var messageEl = document.getElementById('card_message_text');
+      var messageInput = document.getElementById('card_message');
+      var customColor = document.getElementById('card_custom_color');
+      var exportBtn = document.getElementById('export_button');
+      var statusEl = document.getElementById('designer_status');
+      var rendererNote = document.getElementById('renderer_note');
+      var ctx = canvas.getContext('2d');
+
+      var DEFAULT_MESSAGE = 'Enjoy a coffee on me!';
+      var LONG_MESSAGE = 28;
+      var REF_WIDTH = 480; // design reference size in CSS px (matches the canvas max-width)
+
+      // --- Feature detection ------------------------------------------------
+      // HTML-in-Canvas needs three things: a 2D context with drawElementImage(),
+      // a canvas that fires `paint` events, and requestPaint() to force a frame.
+      var supportsDrawElement = !!ctx &&
+        typeof ctx.drawElementImage === 'function' &&
+        typeof canvas.requestPaint === 'function' &&
+        'onpaint' in canvas;
+
+      var selectedColor = '#4e342e';
+
+      // --- State -> DOM -----------------------------------------------------
+      function applyState() {
+        var text = messageInput.value.trim() || DEFAULT_MESSAGE;
+        messageEl.textContent = text;
+        card.classList.toggle('gift-card--long', text.length > LONG_MESSAGE);
+        card.style.setProperty('--card-bg', selectedColor);
+        card.style.setProperty('--card-fg', readableTextColor(selectedColor));
+        requestRepaint();
+      }
+
+      function requestRepaint() {
+        if (supportsDrawElement) {
+          // DOM changes inside a drawable element already queue a paint event;
+          // requestPaint() guarantees one even when nothing changed (e.g. resize).
+          canvas.requestPaint();
+        } else {
+          window.requestAnimationFrame(drawFallback);
+        }
+      }
+
+      // --- Canvas sizing (HiDPI aware) -------------------------------------
+      function syncCanvasSize() {
+        var dpr = window.devicePixelRatio || 1;
+        var rect = canvas.getBoundingClientRect();
+        var cssW = rect.width || REF_WIDTH;
+        var cssH = rect.height || REF_WIDTH * 7 / 12;
+        var w = Math.max(1, Math.round(cssW * dpr));
+        var h = Math.max(1, Math.round(cssH * dpr));
+        if (canvas.width !== w || canvas.height !== h) {
+          canvas.width = w;
+          canvas.height = h;
+        }
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        return { width: cssW, height: cssH };
+      }
+
+      // --- Native path: paint the HTML card into the bitmap ----------------
+      // drawElementImage() must only run inside a paint event, after the
+      // browser has recorded a snapshot of the drawable subtree.
+      function paintCard() {
+        var size = syncCanvasSize();
+        ctx.clearRect(0, 0, size.width, size.height);
+        ctx.drawElementImage(card, 0, 0);
+      }
+
+      // Resolves once the next paint event has run (our paintCard listener is
+      // registered first, so the bitmap is fresh by then). Times out rather
+      // than hanging if the browser never delivers a frame (e.g. hidden tab).
+      function nextPaint() {
+        return new Promise(function (resolve) {
+          var done = false;
+          function finish() {
+            if (done) return;
+            done = true;
+            canvas.removeEventListener('paint', finish);
+            resolve();
+          }
+          canvas.addEventListener('paint', finish, { once: true });
+          canvas.requestPaint();
+          setTimeout(finish, 1000);
+        });
+      }
+
+      // --- Fallback path: redraw the same design with 2D primitives --------
+      function drawFallback() {
+        var size = syncCanvasSize();
+        var W = size.width;
+        var H = size.height;
+        var s = W / REF_WIDTH;
+        var fg = readableTextColor(selectedColor);
+        var text = messageEl.textContent;
+        var pad = 28 * s;
+
+        ctx.clearRect(0, 0, W, H);
+
+        var grad = ctx.createLinearGradient(0, 0, W, H);
+        grad.addColorStop(0, selectedColor);
+        grad.addColorStop(1, mixWithBlack(selectedColor, 0.3));
+        ctx.fillStyle = grad;
+        roundRect(ctx, 0, 0, W, H, 16 * s);
+        ctx.fill();
+
+        ctx.fillStyle = fg;
+        ctx.strokeStyle = fg;
+        ctx.textBaseline = 'middle';
+
+        // Top row: brand + tag
+        ctx.textAlign = 'left';
+        ctx.font = '700 ' + (12.8 * s) + 'px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        var topY = 24 * s + 11 * s;
+        drawSpaced(ctx, 'THE DAILY GRIND', pad, topY, 2 * s);
+
+        ctx.font = '600 ' + (11.2 * s) + 'px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        var tag = 'GIFT CARD';
+        var tagW = spacedWidth(ctx, tag, 1 * s) + 20 * s;
+        var tagH = 22 * s;
+        ctx.lineWidth = 1;
+        roundRect(ctx, W - pad - tagW, topY - tagH / 2, tagW, tagH, tagH / 2);
+        ctx.stroke();
+        drawSpaced(ctx, tag, W - pad - tagW + 10 * s, topY, 1 * s);
+
+        // Message (wrapped)
+        var fontPx = (text.length > LONG_MESSAGE ? 19.2 : 25.6) * s;
+        ctx.font = '600 ' + fontPx + 'px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        var lines = wrapText(ctx, text, W - pad * 2).slice(0, 3);
+        var lineH = fontPx * 1.25;
+        var startY = H / 2 - ((lines.length - 1) * lineH) / 2;
+        for (var i = 0; i < lines.length; i++) {
+          ctx.fillText(lines[i], pad, startY + i * lineH);
+        }
+
+        // Bottom row
+        ctx.globalAlpha = 0.9;
+        ctx.font = '400 ' + (12 * s) + 'px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        var bottomY = H - 24 * s - 8 * s;
+        ctx.fillText('Redeem at any Daily Grind location', pad, bottomY);
+        ctx.font = '400 ' + (12 * s) + 'px "Courier New", monospace';
+        var num = '•••• 2026';
+        drawSpaced(ctx, num, W - pad - spacedWidth(ctx, num, 2 * s), bottomY, 2 * s);
+        ctx.globalAlpha = 1;
+      }
+
+      function roundRect(c, x, y, w, h, r) {
+        c.beginPath();
+        if (typeof c.roundRect === 'function') {
+          c.roundRect(x, y, w, h, r);
+          return;
+        }
+        c.moveTo(x + r, y);
+        c.arcTo(x + w, y, x + w, y + h, r);
+        c.arcTo(x + w, y + h, x, y + h, r);
+        c.arcTo(x, y + h, x, y, r);
+        c.arcTo(x, y, x + w, y, r);
+        c.closePath();
+      }
+
+      function spacedWidth(c, str, spacing) {
+        return c.measureText(str).width + spacing * Math.max(0, str.length - 1);
+      }
+
+      function drawSpaced(c, str, x, y, spacing) {
+        for (var i = 0; i < str.length; i++) {
+          c.fillText(str[i], x, y);
+          x += c.measureText(str[i]).width + spacing;
+        }
+      }
+
+      function wrapText(c, str, maxWidth) {
+        var words = str.split(/\s+/);
+        var lines = [];
+        var line = '';
+        for (var i = 0; i < words.length; i++) {
+          var test = line ? line + ' ' + words[i] : words[i];
+          if (c.measureText(test).width > maxWidth && line) {
+            lines.push(line);
+            line = words[i];
+          } else {
+            line = test;
+          }
+        }
+        if (line) lines.push(line);
+        return lines;
+      }
+
+      // --- Color helpers ----------------------------------------------------
+      function hexToRgb(hex) {
+        var m = /^#?([0-9a-f]{6})$/i.exec(hex);
+        var n = m ? parseInt(m[1], 16) : 0x4e342e;
+        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+      }
+
+      function mixWithBlack(hex, amount) {
+        var rgb = hexToRgb(hex).map(function (v) { return Math.round(v * (1 - amount)); });
+        return 'rgb(' + rgb.join(',') + ')';
+      }
+
+      function readableTextColor(hex) {
+        var lum = hexToRgb(hex).map(function (v) {
+          v /= 255;
+          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+        });
+        var L = 0.2126 * lum[0] + 0.7152 * lum[1] + 0.0722 * lum[2];
+        return L > 0.4 ? '#3e2723' : '#ffffff';
+      }
+
+      // --- Export -----------------------------------------------------------
+      function canvasToBlob(c) {
+        return new Promise(function (resolve, reject) {
+          try {
+            c.toBlob(function (blob) {
+              if (blob) resolve(blob);
+              else reject(new Error('The canvas produced no image data.'));
+            }, 'image/png');
+          } catch (err) {
+            reject(err);
+          }
+        });
+      }
+
+      function fileName() {
+        var slug = messageEl.textContent.toLowerCase()
+          .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30);
+        return 'daily-grind-gift-card' + (slug ? '-' + slug : '') + '.png';
+      }
+
+      function setStatus(msg) {
+        statusEl.textContent = msg;
+      }
+
+      async function exportCard() {
+        exportBtn.disabled = true;
+        setStatus('Preparing your card…');
+        try {
+          // Make sure the bitmap reflects the latest DOM before reading it back.
+          if (supportsDrawElement) {
+            await nextPaint();
+          } else {
+            drawFallback();
+          }
+          var blob = await canvasToBlob(canvas);
+          var url = URL.createObjectURL(blob);
+          var link = document.createElement('a');
+          link.href = url;
+          link.download = fileName();
+          document.body.appendChild(link);
+          link.click();
+          link.remove();
+          setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
+          setStatus('Downloaded ' + link.download);
+        } catch (err) {
+          console.error('Gift card export failed:', err);
+          setStatus('Sorry, the card could not be exported.' + (err && err.message ? ' ' + err.message : ''));
+        } finally {
+          exportBtn.disabled = false;
+        }
+      }
+
+      // --- Wiring -----------------------------------------------------------
+      if (!ctx) {
+        rendererNote.textContent = 'Your browser does not support canvas, so the card cannot be previewed or exported.';
+        exportBtn.disabled = true;
+        return;
+      }
+
+      if (supportsDrawElement) {
+        canvas.addEventListener('paint', paintCard);
+      } else {
+        rendererNote.textContent = 'Live HTML-to-canvas rendering is not available in this browser, so a canvas-drawn preview is shown instead.';
+      }
+
+      messageInput.addEventListener('input', applyState);
+
+      Array.prototype.forEach.call(document.querySelectorAll('input[name="card_color"]'), function (radio) {
+        radio.addEventListener('change', function () {
+          if (radio.checked) {
+            selectedColor = radio.value;
+            customColor.value = radio.value;
+            applyState();
+          }
+        });
+      });
+
+      customColor.addEventListener('input', function () {
+        selectedColor = customColor.value;
+        Array.prototype.forEach.call(document.querySelectorAll('input[name="card_color"]'), function (radio) {
+          radio.checked = false;
+        });
+        applyState();
+      });
+
+      exportBtn.addEventListener('click', exportCard);
+
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(requestRepaint).observe(canvas);
+      } else {
+        window.addEventListener('resize', requestRepaint);
+      }
+      window.matchMedia('(resolution: ' + (window.devicePixelRatio || 1) + 'dppx)')
+        .addEventListener('change', requestRepaint);
+
+      applyState();
+    })();
+  </script>
+
