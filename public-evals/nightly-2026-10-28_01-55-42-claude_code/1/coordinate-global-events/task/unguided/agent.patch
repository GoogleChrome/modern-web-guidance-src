+  <script type="module">
+    // Global Tasting Coordinator
+    // Built on the Temporal API (Temporal.PlainDateTime / Temporal.ZonedDateTime) rather than the
+    // legacy Date object. Every Temporal value is immutable: methods such as toZonedDateTime() and
+    // withTimeZone() always return a brand-new object and never alter the original.
+
+    const TARGET_ZONES = Object.freeze([
+      Object.freeze({ id: 'America/New_York', city: 'New York' }),
+      Object.freeze({ id: 'Europe/London', city: 'London' }),
+      Object.freeze({ id: 'Asia/Tokyo', city: 'Tokyo' }),
+      Object.freeze({ id: 'UTC', city: 'UTC' })
+    ]);
+
+    const WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
+    const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August',
+      'September', 'October', 'November', 'December'];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+
+    async function ensureTemporal() {
+      if (globalThis.Temporal) return globalThis.Temporal;
+      // Older browsers: fall back to the official polyfill so the planner still works.
+      try {
+        const mod = await import('https://esm.sh/@js-temporal/polyfill@0.5.1');
+        return mod.Temporal;
+      } catch (err) {
+        return null;
+      }
+    }
+
+    // Formats the wall-clock time of any Temporal date-time-like value as e.g. "3:00 AM".
+    function formatTime(value) {
+      const hour12 = value.hour % 12 === 0 ? 12 : value.hour % 12;
+      const minute = String(value.minute).padStart(2, '0');
+      return `${hour12}:${minute} ${value.hour < 12 ? 'AM' : 'PM'}`;
+    }
+
+    // Formats a date-like value as e.g. "Sun, Mar 8, 2026" (short) or "Sunday, March 8, 2026" (long).
+    function formatDate(value, style = 'short') {
+      const weekday = WEEKDAYS[value.dayOfWeek - 1];
+      const month = MONTHS[value.month - 1];
+      if (style === 'long') return `${weekday}, ${month} ${value.day}, ${value.year}`;
+      return `${weekday.slice(0, 3)}, ${month.slice(0, 3)} ${value.day}, ${value.year}`;
+    }
+
+    // Zone abbreviation such as "EDT", "BST" or "GMT+9". Intl accepts the epoch millisecond
+    // number directly, so no legacy Date object is involved.
+    function formatZoneName(zdt) {
+      try {
+        const parts = new Intl.DateTimeFormat('en-US', { timeZone: zdt.timeZoneId, timeZoneName: 'short' })
+          .formatToParts(zdt.epochMilliseconds);
+        const part = parts.find((p) => p.type === 'timeZoneName');
+        return part ? part.value : '';
+      } catch (err) {
+        return '';
+      }
+    }
+
+    function zoneLabel(zdt) {
+      const name = formatZoneName(zdt);
+      const offset = `UTC${zdt.offset}`;
+      return name && name !== offset ? `${name} (${offset})` : offset;
+    }
+
+    /**
+     * Resolves the host's wall-clock time into an exact instant and detects
+     * daylight-saving conflicts (nonexistent "gap" times and ambiguous "overlap" times).
+     * Returns a frozen result object; no input is ever mutated.
+     */
+    function resolveHostTime(Temporal, dateStr, timeStr, hostTz) {
+      const wall = Temporal.PlainDateTime.from(`${dateStr}T${timeStr}`);
+
+      // Three independent resolutions of the same wall-clock time. Each call returns a new,
+      // immutable ZonedDateTime; `wall` itself is untouched.
+      const earlier = wall.toZonedDateTime(hostTz, { disambiguation: 'earlier' });
+      const later = wall.toZonedDateTime(hostTz, { disambiguation: 'later' });
+      const resolved = wall.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+      // In a gap, the requested wall time cannot be represented, so the resolved
+      // wall time differs from what was asked for.
+      const isGap = !resolved.toPlainDateTime().equals(wall);
+      // In an overlap, the same wall time maps to two different instants.
+      const isOverlap = !isGap && Temporal.ZonedDateTime.compare(earlier, later) !== 0;
+
+      let conflict = null;
+      const requestedTime = formatTime(wall);
+      const longDate = formatDate(wall, 'long');
+
+      if (isGap) {
+        conflict = Object.freeze({
+          kind: 'gap',
+          message:
+            `<strong>Heads up: ${requestedTime} does not exist in ${hostTz} on ${longDate}.</strong> ` +
+            `Clocks spring forward at that moment, so the ${describeGap(earlier, later)} is skipped entirely. ` +
+            `We moved the tasting forward by the length of the gap to <strong>${formatTime(resolved)} ${zoneLabel(resolved)}</strong>, ` +
+            `which is the first valid time after the change. The alternative, ${formatTime(earlier)} ${zoneLabel(earlier)}, ` +
+            `would shift it earlier instead.`
+        });
+      } else if (isOverlap) {
+        conflict = Object.freeze({
+          kind: 'overlap',
+          message:
+            `<strong>Heads up: ${requestedTime} happens twice in ${hostTz} on ${longDate}.</strong> ` +
+            `Clocks fall back that morning, so the wall clock reads ${requestedTime} once before the change ` +
+            `and once after. We picked the <strong>first occurrence, ${formatTime(resolved)} ${zoneLabel(resolved)}</strong>. ` +
+            `The second occurrence would be ${formatTime(later)} ${zoneLabel(later)}, exactly ` +
+            `${later.since(earlier, { largestUnit: 'minutes' }).minutes} minutes later.`
+        });
+      }
+
+      return Object.freeze({ wall, resolved, earlier, later, conflict });
+    }
+
+    function describeGap(earlier, later) {
+      // earlier/later bracket the gap: the difference in their offsets is its length.
+      const gapMinutes = Math.round((later.offsetNanoseconds - earlier.offsetNanoseconds) / 60e9);
+      return gapMinutes === 60 ? 'hour' : `${gapMinutes}-minute window`;
+    }
+
+    function buildCards(resolved) {
+      const hostDate = resolved.toPlainDate();
+      return TARGET_ZONES.map((zone) => {
+        // withTimeZone() returns a new ZonedDateTime for the same instant; `resolved` is unchanged.
+        const local = resolved.withTimeZone(zone.id);
+        const dayShift = local.toPlainDate().since(hostDate, { largestUnit: 'days' }).days;
+        return Object.freeze({
+          id: zone.id,
+          city: zone.city,
+          isHost: zone.id === resolved.timeZoneId,
+          time: formatTime(local),
+          date: formatDate(local),
+          zone: zoneLabel(local),
+          dayShift
+        });
+      });
+    }
+
+    function renderCards(cards) {
+      grid.replaceChildren();
+      for (const card of cards) {
+        const el = document.createElement('div');
+        el.className = 'card tz-card' + (card.isHost ? ' is-host' : '');
+        el.dataset.tz = card.id;
+
+        const header = document.createElement('div');
+        header.className = 'tz-city';
+        const title = document.createElement('h3');
+        title.textContent = card.city;
+        header.appendChild(title);
+        if (card.isHost) {
+          const badge = document.createElement('span');
+          badge.className = 'tz-badge';
+          badge.textContent = 'Host';
+          header.appendChild(badge);
+        }
+
+        const time = document.createElement('div');
+        time.className = 'tz-time';
+        time.textContent = card.time;
+
+        const date = document.createElement('div');
+        date.className = 'tz-date';
+        date.textContent = card.date;
+
+        const offset = document.createElement('div');
+        offset.className = 'tz-offset';
+        offset.textContent = `${card.id} · ${card.zone}`;
+
+        el.append(header, time, date, offset);
+
+        if (card.dayShift !== 0) {
+          const shift = document.createElement('span');
+          shift.className = 'tz-shift';
+          shift.textContent = card.dayShift > 0 ? 'Next day for them' : 'Previous day for them';
+          el.appendChild(shift);
+        }
+        grid.appendChild(el);
+      }
+    }
+
+    function showWarning(html) {
+      if (html) {
+        hostWarning.innerHTML = html;
+        hostWarning.classList.add('visible');
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.classList.remove('visible');
+      }
+    }
+
+    function renderPlaceholder(text) {
+      grid.replaceChildren();
+      const note = document.createElement('p');
+      note.style.color = 'var(--secondary)';
+      note.textContent = text;
+      grid.appendChild(note);
+    }
+
+    function update(Temporal) {
+      const dateStr = dateInput.value;
+      const timeStr = timeInput.value;
+      const hostTz = hostTzSelect.value;
+
+      if (!dateStr || !timeStr || !hostTz) {
+        showWarning('');
+        renderPlaceholder('Choose a date, start time and host time zone to see the schedule.');
+        return;
+      }
+
+      let result;
+      try {
+        result = resolveHostTime(Temporal, dateStr, timeStr, hostTz);
+      } catch (err) {
+        showWarning('');
+        renderPlaceholder('That date or time could not be understood. Please check your entries.');
+        return;
+      }
+
+      showWarning(result.conflict ? result.conflict.message : '');
+      renderCards(buildCards(result.resolved));
+    }
+
+    function setDefaults(Temporal) {
+      const now = Temporal.Now.zonedDateTimeISO();
+      if (!dateInput.value) dateInput.value = now.toPlainDate().toString();
+      if (!timeInput.value) timeInput.value = '10:00';
+      const localZone = now.timeZoneId;
+      if ([...hostTzSelect.options].some((o) => o.value === localZone)) {
+        hostTzSelect.value = localZone;
+      }
+    }
+
+    const Temporal = await ensureTemporal();
+    if (!Temporal) {
+      hostWarning.textContent = 'Sorry, your browser does not support the Temporal API, which this planner needs to convert times safely. Please try a current browser.';
+      hostWarning.classList.add('visible');
+    } else {
+      setDefaults(Temporal);
+      const rerender = () => update(Temporal);
+      dateInput.addEventListener('input', rerender);
+      dateInput.addEventListener('change', rerender);
+      timeInput.addEventListener('input', rerender);
+      timeInput.addEventListener('change', rerender);
+      hostTzSelect.addEventListener('change', rerender);
+      rerender();
+    }
+  </script>
+
 </body>
 
