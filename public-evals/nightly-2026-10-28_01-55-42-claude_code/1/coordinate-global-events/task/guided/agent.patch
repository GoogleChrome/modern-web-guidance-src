+  <script type="module">
+    // Global Tasting Coordinator
+    // Built on Temporal.ZonedDateTime (immutable, time-zone-aware) rather than the legacy Date object.
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+    const cards = [...grid.querySelectorAll('[data-tz]')];
+
+    const TIME_FORMAT = { hour: 'numeric', minute: '2-digit' };
+    const DATE_FORMAT = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
+    const OFFSET_FORMAT = { timeZoneName: 'short' };
+
+    // Format a ZonedDateTime in its own zone. Intl reads the exact instant plus the zone id,
+    // so no legacy Date object is involved and the output is consistent across engines.
+    function format(zdt, options) {
+      return new Intl.DateTimeFormat('en-US', { ...options, timeZone: zdt.timeZoneId })
+        .format(zdt.epochMilliseconds);
+    }
+
+    // Just the zone abbreviation (e.g. "EDT", "GMT+9"), without the date Intl adds by default.
+    function zoneLabel(zdt) {
+      return new Intl.DateTimeFormat('en-US', { ...OFFSET_FORMAT, timeZone: zdt.timeZoneId })
+        .formatToParts(zdt.epochMilliseconds)
+        .find((part) => part.type === 'timeZoneName')?.value ?? zdt.offset;
+    }
+
+    function clearGrid() {
+      for (const card of cards) {
+        card.querySelector('.tz-time').textContent = '--:--';
+        card.querySelector('.tz-date').textContent = '';
+        card.querySelector('.tz-offset').textContent = '';
+      }
+    }
+
+    // Classify the host's wall-clock time as 'none', 'gap', or 'overlap' for its time zone.
+    // 'reject' throws a RangeError whenever the wall-clock time is skipped or repeated.
+    function detectDstConflict(plainDateTime, timeZone) {
+      try {
+        plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'reject' });
+        return 'none';
+      } catch (err) {
+        if (!(err instanceof RangeError)) throw err;
+      }
+      // In an overlap, the 'earlier' candidate still carries the requested wall-clock time.
+      // In a gap, no candidate does, because the requested time never appears on the clock.
+      const earlier = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      return earlier.toPlainDateTime().equals(plainDateTime) ? 'overlap' : 'gap';
+    }
+
+    function describeConflict(kind, requested, resolved, timeZone) {
+      // UTC has no transitions, so this prints exactly the wall-clock time the user typed.
+      const requestedText = format(requested.toZonedDateTime('UTC'), TIME_FORMAT);
+      const resolvedText = format(resolved, TIME_FORMAT);
+      const zoneName = hostTzSelect.selectedOptions[0]?.textContent ?? timeZone;
+      const offsetText = zoneLabel(resolved);
+
+      if (kind === 'gap') {
+        return `Heads up: ${requestedText} does not exist in ${zoneName} on this date. ` +
+          `Clocks spring forward past that hour, so we moved the tasting ahead by the length of the ` +
+          `skipped hour to ${resolvedText} (${offsetText}). All conversions below use that adjusted moment.`;
+      }
+      return `Heads up: ${requestedText} happens twice in ${zoneName} on this date because clocks fall back. ` +
+        `We used the first occurrence, ${resolvedText} ${offsetText}, which is the one still on ` +
+        `daylight saving time. All conversions below use that moment.`;
+    }
+
+    function update() {
+      hostWarning.textContent = '';
+
+      if (!dateInput.value || !timeInput.value) {
+        clearGrid();
+        return;
+      }
+
+      const hostTz = hostTzSelect.value;
+      let requested;
+      try {
+        requested = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+      } catch {
+        clearGrid();
+        hostWarning.textContent = 'Please enter a valid date and time.';
+        return;
+      }
+
+      const conflict = detectDstConflict(requested, hostTz);
+
+      // 'compatible' is the default: it picks the earlier instant in an overlap
+      // and shifts forward by the gap length when the time is skipped.
+      // The result is immutable; every conversion below returns a new object.
+      const hostTime = Object.freeze(
+        requested.toZonedDateTime(hostTz, { disambiguation: 'compatible' })
+      );
+
+      if (conflict !== 'none') {
+        hostWarning.textContent = describeConflict(conflict, requested, hostTime, hostTz);
+      }
+
+      for (const card of cards) {
+        const localTime = hostTime.withTimeZone(card.dataset.tz);
+        const dayShift = Temporal.PlainDate.compare(localTime.toPlainDate(), hostTime.toPlainDate());
+        const dayNote = dayShift > 0 ? ' (next day)' : dayShift < 0 ? ' (previous day)' : '';
+
+        card.querySelector('.tz-time').textContent = format(localTime, TIME_FORMAT);
+        card.querySelector('.tz-date').textContent =
+          format(localTime, DATE_FORMAT) + dayNote;
+        card.querySelector('.tz-offset').textContent = zoneLabel(localTime);
+      }
+    }
+
+    function initializePlanner() {
+      // Seed with the host zone's current date and a 9:00 AM start.
+      if (!dateInput.value) {
+        dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+      }
+      if (!timeInput.value) {
+        timeInput.value = '09:00';
+      }
+
+      for (const el of [dateInput, timeInput, hostTzSelect]) {
+        el.addEventListener('input', update);
+        el.addEventListener('change', update);
+      }
+      document.getElementById('plannerForm').addEventListener('submit', (e) => e.preventDefault());
+      update();
+    }
+
+    // Temporal is native in Chrome/Edge 144+ and Firefox 139+; load the polyfill elsewhere (e.g. Safari).
+    if (typeof Temporal === 'undefined') {
+      try {
+        const mod = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = mod.Temporal;
+      } catch {
+        hostWarning.textContent =
+          'The tasting planner needs a browser with Temporal support and could not load a fallback.';
+      }
+    }
+    if (typeof Temporal !== 'undefined') {
+      initializePlanner();
+    }
+  </script>
+
