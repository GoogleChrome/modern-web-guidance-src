+    /* Roast Selector */
+    .roast-selector {
+      position: relative;
+      display: inline-flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 6px;
+      margin-top: 1.25rem;
+      text-align: left;
+    }
+
+    .roast-label {
+      font-size: 0.8rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--accent);
+      font-weight: 600;
+    }
+
+    .roast-toggle {
+      display: inline-flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 14px;
+      min-width: 220px;
+      padding: 10px 14px;
+      background: var(--primary);
+      color: white;
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      font: inherit;
+      font-size: 1rem;
+      cursor: pointer;
+      transition: background 0.3s, box-shadow 0.3s;
+    }
+
+    .roast-toggle:hover {
+      background: #3e2723;
+    }
+
+    .roast-toggle:focus-visible {
+      outline: none;
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.45);
+    }
+
+    .roast-arrow {
+      width: 16px;
+      height: 16px;
+      flex-shrink: 0;
+      color: var(--accent);
+      transition: transform 0.25s;
+    }
+
+    .roast-selector.open .roast-arrow {
+      transform: rotate(180deg);
+    }
+
+    .roast-menu {
+      position: absolute;
+      top: calc(100% + 6px);
+      left: 0;
+      right: 0;
+      z-index: 20;
+      list-style: none;
+      margin: 0;
+      padding: 6px 0;
+      background: var(--primary);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
+      display: none;
+    }
+
+    .roast-selector.open .roast-menu {
+      display: block;
+    }
+
+    .roast-option {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+      padding: 10px 14px;
+      color: white;
+      cursor: pointer;
+      transition: background 0.2s, color 0.2s;
+    }
+
+    .roast-option:hover,
+    .roast-option.active {
+      background: var(--accent);
+      color: var(--primary);
+    }
+
+    .roast-option small {
+      display: block;
