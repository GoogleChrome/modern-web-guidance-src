       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --primary-soft: #8d6e63;
     }
 
+    /* Reusable style logic (CSS custom functions).
+       Browsers without @function support ignore these calls, so every
+       usage below declares a plain fallback value first. */
+
+    /* Brand gradient: two colors and an optional angle. */
+    @function --brand-gradient(--start <color>, --end <color>, --angle: 135deg) returns <image> {
+      result: linear-gradient(in oklab var(--angle), var(--start), var(--end));
+    }
+
+    /* Responsive columns: single column by default, --count equal
+       columns once the viewport is wide enough (~400px stacks, ~1000px splits). */
+    @function --responsive-columns(--count <number>) {
+      result: 1fr;
+
+      @media (min-width: 768px) {
+        result: repeat(var(--count), minmax(0, 1fr));
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
