+  <!--
+    Third-party script: AOS (Animate On Scroll) 2.3.4.
+    Same protections as the stylesheets: pinned version, SRI hash, anonymous
+    CORS fetch with no cookies, and no Referer header.
+  -->
+  <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"
+          integrity="sha384-n1AULnKdMJlK1oQCLNDL9qZsDgXtH6jRYFCpBtWFc+a9Yve0KSoMn575rk755NJZ"
+          crossorigin="anonymous"
+          referrerpolicy="no-referrer"
+          defer></script>
+
+  <script>
+    (function () {
+      // Load each photo through fetch() so the browser can enforce Subresource
+      // Integrity on it. Options mirror the attributes used on <link>/<script>:
+      //   integrity      -> reject the bytes if the SHA-384 digest does not match
+      //   mode: 'cors'   -> required for integrity checks on cross-origin responses
+      //   credentials    -> 'omit': never send cookies or HTTP auth to the CDN
+      //   referrerPolicy -> 'no-referrer': do not reveal this page to the CDN
+      function loadVerifiedImage(img) {
+        var src = img.dataset.src;
+        var integrity = img.dataset.integrity;
+        if (!src || !integrity) return;
+
+        fetch(src, {
+          integrity: integrity,
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: 'no-referrer',
+          cache: 'force-cache'
+        })
+          .then(function (response) {
+            if (!response.ok) throw new Error('HTTP ' + response.status);
+            return response.blob();
+          })
+          .then(function (blob) {
+            var url = URL.createObjectURL(blob);
+            img.addEventListener('load', function () {
+              img.classList.add('is-loaded');
+              URL.revokeObjectURL(url);
+            }, { once: true });
+            img.src = url;
+          })
+          .catch(function (err) {
+            // Integrity mismatch or network failure: keep the placeholder
+            // background rather than showing unverified content.
+            console.warn('Verified image load failed for ' + src + ': ' + err.message);
+          });
+      }
+
+      function init() {
+        Array.prototype.forEach.call(
+          document.querySelectorAll('img[data-src][data-integrity]'),
+          loadVerifiedImage
+        );
+        if (window.AOS) {
+          window.AOS.init({ once: true, duration: 700, offset: 60 });
+        }
+      }
+
+      // Deferred scripts (AOS above) run before DOMContentLoaded fires.
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
+
