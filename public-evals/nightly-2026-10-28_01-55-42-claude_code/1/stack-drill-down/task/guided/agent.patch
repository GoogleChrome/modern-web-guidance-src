+    }
+
+    function viewShell(title, docTitle, bodyHtml) {
+      const view = document.createElement('div');
+      view.className = 'Stack-view';
+      view.dataset.title = docTitle;
+      view.innerHTML = `
+        <div class="Stack-viewContent">
+          <header class="View-header">
+            <button class="back" type="button">${BACK_ICON}<span>Back</span></button>
+            <h1>${escapeHtml(title)}</h1>
+            <span></span>
+          </header>
+          <main class="View-body">${bodyHtml}</main>
+        </div>`;
+      return view;
+    }
+
+    function createDrinkView({ slug, drink }) {
+      const body = `
+        <figure class="View-figure">
+          <img src="${drink.image}" alt="${escapeHtml(drink.alt)}" width="1200" height="675" decoding="async">
+          <span class="View-badge">${escapeHtml(drink.badge)}</span>
+        </figure>
+        <h2 class="View-title">${escapeHtml(drink.name)}</h2>
+        <p class="View-tagline">${escapeHtml(drink.tagline)}</p>
+        <p>${escapeHtml(drink.description)}</p>
+
+        <h2>Tasting notes</h2>
+        <ul class="Notes">${drink.notes.map((n) => `<li>${escapeHtml(n)}</li>`).join('')}</ul>
+
+        <h2>Sizes</h2>
+        <table class="Sizes">
+          <thead><tr><th scope="col">Size</th><th scope="col">Volume</th><th scope="col">Price</th></tr></thead>
+          <tbody>${drink.sizes.map(([s, v, p]) =>
+            `<tr><td>${escapeHtml(s)}</td><td>${escapeHtml(v)}</td><td>${escapeHtml(p)}</td></tr>`).join('')}</tbody>
+        </table>
+
+        <a class="More-link" href="#/menu/${slug}/sourcing">
+          <span><strong>Sourcing &amp; nutrition</strong><small>Where the beans come from and what's in your cup</small></span>
+          ${CHEVRON_ICON}
+        </a>
+
+        <div class="Actions">
+          <a href="/order-online" class="btn btn--accent">Order for pickup</a>
+          <a href="/menu" class="btn">Full menu</a>
+        </div>`;
+      return viewShell(drink.name, `${drink.name} | The Daily Grind`, body);
+    }
+
+    function createSourcingView({ drink }) {
+      const body = `
+        <h2 class="View-title">Sourcing &amp; nutrition</h2>
+        <p class="View-tagline">${escapeHtml(drink.name)}</p>
+
+        <h2>Per medium serving</h2>
+        <dl class="Facts">${drink.facts.map(([k, v]) =>
+          `<div><dt>${escapeHtml(k)}</dt><dd>${escapeHtml(v)}</dd></div>`).join('')}</dl>
+
+        <h2>Where it comes from</h2>
+        <div class="Sourcing">${drink.sourcing.map((p) => `<p>${escapeHtml(p)}</p>`).join('')}</div>`;
+      return viewShell('Sourcing & nutrition', `${drink.name} sourcing | The Daily Grind`, body);
+    }
+
+    function createDrillDownView(routeData) {
+      return routeData.kind === 'sourcing' ? createSourcingView(routeData) : createDrinkView(routeData);
+    }
+
+    /* ---------- Drill down ---------- */
+    function drillDown(urlPath) {
+      const routeData = resolveUrl(urlPath);
+      if (!routeData) return;
+
+      const newDepth = currentDepth + 1;
+      history.pushState({ depth: newDepth }, '', toHref(urlPath));
+
+      // pushState discards forward entries; mirror that in our depth map.
+      for (const d of [...entriesByDepth.keys()]) {
+        if (d >= newDepth) entriesByDepth.delete(d);
+      }
+      currentDepth = newDepth;
+
+      const newView = createDrillDownView(routeData);
+      stack.appendChild(newView);
+      entriesByDepth.set(newDepth, { urlPath, view: newView });
+
+      // behavior:'auto' defers to the CSS scroll-behavior (smooth unless the
+      // user prefers reduced motion).
+      stack.scrollBy({ left: stack.clientWidth, behavior: 'auto' });
+    }
+
+    /* ---------- Clicks and back ---------- */
+    stack.addEventListener('click', (e) => {
+      if (e.target.closest('.back')) {
+        goBack();
+        return;
+      }
+
+      const link = e.target.closest('a');
+      if (!link || !stack.contains(link)) return;
+      // Preserve open-in-new-tab behaviour.
+      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+
+      const urlPath = linkUrlPath(link);
+      const parentView = link.closest('.Stack-view');
+      if (!urlPath || !resolveUrl(urlPath) || !parentView) return;
+
+      e.preventDefault();
+      returnFocus.set(parentView, link);
+      drillDown(urlPath);
+    });
+
+    document.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && activeView && activeView !== rootView && !e.defaultPrevented) {
+        goBack();
+      }
+    });
+
+    function goBack() {
+      // On a deep-link load there is no in-app entry behind the current one;
+      // history.back() would leave the site. Push a root entry instead.
+      const atDeepLinkRoot = currentDepth === 0 && entriesByDepth.get(0)?.view !== rootView;
+      if (atDeepLinkRoot) {
+        synthesizeRootEntry();
+      } else {
+        history.back();
+      }
+    }
+
+    function synthesizeRootEntry() {
+      const newDepth = currentDepth + 1;
+      history.pushState({ depth: newDepth }, '', toHref('/'));
+
+      if (!rootView) {
+        rootView = createRootView();
+        stack.prepend(rootView);
+        // Keep the deep-linked view on screen until the scroll below runs.
+        // Explicitly instant: assigning scrollLeft would honour the CSS
+        // scroll-behavior and animate the compensation.
+        stack.scrollTo({ left: stack.scrollLeft + stack.clientWidth, behavior: 'instant' });
+      }
+      entriesByDepth.set(newDepth, { urlPath: '/', view: rootView });
+      updateFromHistoryState(history.state);
+    }
+
+    /* ---------- History -> stack ---------- */
+    window.addEventListener('popstate', (event) => {
+      updateFromHistoryState(event.state);
+    });
+
+    function updateFromHistoryState(state, behaviorOverride) {
+      const newDepth = state?.depth ?? 0;
+      const urlPath = getCurrentUrlPath();
+
+      const entry = entriesByDepth.get(newDepth) ?? { view: null };
+      if (entry.urlPath !== urlPath) {
+        entry.urlPath = urlPath;
+        entry.view = urlPath === '/' ? rootView : null;
+      }
+      entriesByDepth.set(newDepth, entry);
+
+      // Rebuild views that were pruned after a swipe-back, so forward
+      // navigation has something to scroll to.
+      for (let d = 0; d <= newDepth; d++) {
+        const e = entriesByDepth.get(d);
+        if (!e || e.view) continue;
+        if (e.urlPath === '/') {
+          if (!rootView) {
+            rootView = createRootView();
+            stack.prepend(rootView);
+            // Explicitly instant: assigning scrollLeft would honour the CSS
+            // scroll-behavior and animate the compensation.
+            stack.scrollTo({ left: stack.scrollLeft + stack.clientWidth, behavior: 'instant' });
+          }
+          e.view = rootView;
+          continue;
+        }
+        const routeData = resolveUrl(e.urlPath);
+        if (!routeData) continue;
+        const rebuilt = createDrillDownView(routeData);
+        stack.appendChild(rebuilt);
+        e.view = rebuilt;
+      }
+
+      currentDepth = newDepth;
+
+      const targetView = entriesByDepth.get(newDepth)?.view;
+      if (!targetView) return;
+
+      const toIdx = [...stack.children].indexOf(targetView);
+      const fromIdx = Math.round(stack.scrollLeft / stack.clientWidth);
+      if (fromIdx === toIdx) return;
+
+      // Back (leftward, single step) animates; forward and multi-step jumps
+      // snap instantly so intermediate views don't each fire a snap change.
+      const forward = toIdx > fromIdx;
+      const multiStep = Math.abs(toIdx - fromIdx) > 1;
+      const behavior = behaviorOverride ?? (forward || multiStep ? 'instant' : 'auto');
+      stack.scrollTo({ left: toIdx * stack.clientWidth, behavior });
+    }
+
+    /* ---------- Snap change: single source of truth ---------- */
+    function onActiveViewChanged(currentView) {
+      if (!currentView || !stack.contains(currentView)) return;
+      activeView = currentView;
+
+      let seenCurrent = false;
+      for (const view of [...stack.children]) {
+        if (seenCurrent) {
+          // Swiped past: drop from the DOM; the URL stays cached for rebuild.
+          for (const e of entriesByDepth.values()) {
+            if (e.view === view) e.view = null;
+          }
+          view.remove();
+        } else {
+          view.toggleAttribute('inert', view !== currentView);
+          if (view === currentView) seenCurrent = true;
+        }
+      }
+
+      // A swipe-back changed the visible view without touching history;
+      // move the history cursor to match.
+      let currentViewDepth;
+      for (const [d, e] of entriesByDepth) {
+        if (e.view === currentView) currentViewDepth = d;
+      }
+      if (currentViewDepth !== undefined && currentViewDepth !== currentDepth) {
+        history.go(currentViewDepth - currentDepth);
+      }
+
+      if (currentView.dataset.title) document.title = currentView.dataset.title;
+
+      const stored = returnFocus.get(currentView);
+      if (stored && stored.isConnected) {
+        stored.focus({ preventScroll: true });
+        returnFocus.delete(currentView);
+      } else if (currentView !== rootView) {
+        currentView.querySelector('.back')?.focus({ preventScroll: true });
+      }
+    }
+
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      stack.addEventListener('scrollsnapchange', (event) => {
+        onActiveViewChanged(event.snapTargetInline);
+      });
+    } else {
+      // Fallback for browsers without scroll snap events: a view becoming fully
+      // visible inside the stack is the snap-commit moment.
+      const viewObserver = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (entry.intersectionRatio === 1) onActiveViewChanged(entry.target);
+        }
+      }, { root: stack, threshold: 1 });
+
+      new MutationObserver((mutations) => {
+        for (const m of mutations) {
+          for (const node of m.addedNodes) {
+            if (node.classList?.contains('Stack-view')) viewObserver.observe(node);
+          }
+          for (const node of m.removedNodes) {
+            if (node.classList?.contains('Stack-view')) viewObserver.unobserve(node);
+          }
+        }
+      }).observe(stack, { childList: true });
+
+      for (const view of stack.children) viewObserver.observe(view);
+    }
+
+    // Parallax fallback for browsers without scroll-driven animations.
+    if (!CSS.supports('animation-timeline: view()')) {
+      stack.addEventListener('scroll', () => {
+        const viewWidth = stack.clientWidth;
+        for (const view of stack.children) {
+          const offsetLeft = view.offsetLeft - stack.scrollLeft;
+          const progress = Math.min(1, Math.max(0, -offsetLeft / viewWidth));
+          const content = view.firstElementChild;
+          content.style.transform = progress ? `translateX(${progress * 60}%)` : '';
+          content.style.filter = progress ? `brightness(${1 - progress * 0.25})` : '';
+        }
+      }, { passive: true });
+    }
+
+    /* ---------- Init (handles deep links) ---------- */
+    const initialUrlPath = getCurrentUrlPath();
+    const initialRouteData = resolveUrl(initialUrlPath);
+
+    let initialView;
+    if (initialRouteData) {
+      // Deep link: show only the linked view. The root is created on demand
+      // when the user navigates back to it.
+      rootView.remove();
+      rootView = null;
+      initialView = createDrillDownView(initialRouteData);
+      stack.appendChild(initialView);
+      entriesByDepth.set(0, { urlPath: initialUrlPath, view: initialView });
+      history.replaceState({ depth: 0 }, '');
+    } else {
+      initialView = rootView;
+      entriesByDepth.set(0, { urlPath: '/', view: rootView });
+      // Normalise unknown hashes (e.g. #/menu/nope) back to the root URL.
+      history.replaceState({ depth: 0 }, '', initialUrlPath === '/' ? location.href : toHref('/'));
+    }
+    activeView = initialView;
+    if (initialView.dataset.title) document.title = initialView.dataset.title;
+
+    updateFromHistoryState(history.state, 'instant');
+  </script>
+
