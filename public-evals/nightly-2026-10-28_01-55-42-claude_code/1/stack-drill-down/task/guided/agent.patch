+       ------------------------------------------------------------------ */
+    .Stack {
+      height: 100dvh;
+      display: grid;
+      grid-auto-flow: column;
+      grid-auto-columns: 100%;
+      grid-template-rows: 100%;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      /* Keep the swipe from chaining into the browser's own back gesture. */
+      overscroll-behavior-x: none;
+      scrollbar-width: none;
+      background: var(--primary);
+    }
+
+    .Stack::-webkit-scrollbar {
+      display: none;
+    }
+
+    /* Smooth programmatic scrolling only when the OS allows motion. JS always
+       scrolls with behavior:'auto' so this rule is the single switch. */
+    @media (prefers-reduced-motion: no-preference) {
+      .Stack {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .Stack-view {
+      scroll-snap-align: start;
+      scroll-snap-stop: always;
+      min-width: 0;
+    }
+
+    /* Inner wrapper: holds the content, scrolls vertically, and carries the
+       parallax transform (never transform the snap target itself). */
+    .Stack-viewContent {
+      width: 100%;
+      height: 100%;
+      background-color: var(--light);
+      overflow-y: auto;
+      overscroll-behavior-y: contain;
