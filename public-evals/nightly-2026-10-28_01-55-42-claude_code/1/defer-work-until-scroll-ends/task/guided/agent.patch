+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const origins = Array.from(scroller.querySelectorAll('.origin'));
+
+      // Measures each card once scrolling has rested. Only reads layout here,
+      // never inside the hot scroll handler.
+      const findMostVisibleOrigin = () => {
+        const bounds = scroller.getBoundingClientRect();
+        let best = null;
+        let bestArea = -1;
+        for (const el of origins) {
+          const r = el.getBoundingClientRect();
+          const visible = Math.min(r.bottom, bounds.bottom) - Math.max(r.top, bounds.top);
+          if (visible > bestArea) {
+            bestArea = visible;
+            best = el;
+          }
+        }
+        return best ? best.dataset.origin : null;
+      };
+
+      const announceVisible = () => {
+        const name = findMostVisibleOrigin();
+        status.classList.remove('is-scrolling');
+        status.textContent = name ? `Scroll ended. Visible: ${name}` : 'Scroll ended.';
+      };
+
+      // Hot path: a single boolean check and, at most once per scroll burst,
+      // one text write and one class toggle. No layout reads, no allocations.
+      let scrolling = false;
+      const onScroll = () => {
+        if (scrolling) return;
+        scrolling = true;
+        status.classList.add('is-scrolling');
+        status.textContent = 'Scrolling…';
+      };
+
+      const onScrollEnd = () => {
+        scrolling = false;
+        announceVisible();
+      };
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      scroller.addEventListener('scrollend', onScrollEnd);
+
+      // Fallback for browsers without scrollend: debounce scroll and
+      // dispatch a synthetic scrollend so the same handler runs.
+      if (!('onscrollend' in window)) {
+        let timer;
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(() => scroller.dispatchEvent(new Event('scrollend')), 120);
+        }, { passive: true });
+      }
+
+      // Initial sync: the browser may restore a scroll position without firing events.
+      const init = () => {
+        const name = findMostVisibleOrigin();
+        if (name) status.textContent = `Visible: ${name}`;
+      };
+      if (document.readyState === 'complete') {
+        init();
+      } else {
+        window.addEventListener('load', init, { once: true });
+      }
+    })();
+  </script>
