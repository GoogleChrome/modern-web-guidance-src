+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var cards = scroller.querySelectorAll('.bean-card');
+      var SCROLL_END_DELAY = 150; // ms of inactivity before scrolling is considered finished
+      var isScrolling = false;
+      var endTimer = null;
+
+      // Called only once scrolling has settled. This is the only place that reads layout.
+      function findMostVisibleOrigin() {
+        var box = scroller.getBoundingClientRect();
+        var best = null;
+        var bestArea = 0;
+        for (var i = 0; i < cards.length; i++) {
+          var r = cards[i].getBoundingClientRect();
+          var w = Math.min(r.right, box.right) - Math.max(r.left, box.left);
+          var h = Math.min(r.bottom, box.bottom) - Math.max(r.top, box.top);
+          var area = Math.max(0, w) * Math.max(0, h);
+          if (area > bestArea) {
+            bestArea = area;
+            best = cards[i];
+          }
+        }
+        return best ? best.getAttribute('data-origin') : null;
+      }
+
+      function onScrollEnd() {
+        endTimer = null;
+        isScrolling = false;
+        var origin = findMostVisibleOrigin();
+        status.textContent = origin
+          ? 'Scroll ended. Visible: ' + origin
+          : 'Scroll ended.';
+      }
+
+      // Hot path: no layout reads, no DOM writes after the first event of a scroll burst.
+      function onScroll() {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+        if (endTimer !== null) {
+          clearTimeout(endTimer);
+        }
+        endTimer = setTimeout(onScrollEnd, SCROLL_END_DELAY);
+      }
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+    })();
+  </script>
