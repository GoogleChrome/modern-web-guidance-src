+  <script>
+    (function () {
+      var ring = document.getElementById('loyalty-ring');
+      if (!ring) return;
+      var current = Number(ring.dataset.current);
+      var goal = Number(ring.dataset.goal);
+      var fill = ring.querySelector('.ring-fill');
+      var circumference = 2 * Math.PI * fill.r.baseVal.value;
+      var pct = Math.min(Math.max(current / goal, 0), 1);
+      var remaining = Math.max(goal - current, 0);
+
+      fill.style.strokeDasharray = circumference;
+      ring.setAttribute('aria-valuenow', current);
+      ring.setAttribute('aria-valuemax', goal);
+      ring.setAttribute('aria-label', 'Loyalty progress: ' + current + ' of ' + goal + ' drinks toward a free drink');
+      ring.querySelector('.ring-current').textContent = current;
+      ring.querySelector('.ring-goal').textContent = goal;
+      ring.querySelector('.ring-remaining').textContent =
+        remaining === 0 ? 'Free drink unlocked!' : remaining + ' to your free drink';
+      if (remaining === 0) fill.classList.add('is-complete');
+
+      // Animate from empty to the current value; the static markup already holds the final
+      // offset, so the ring is correct without JavaScript or when reduced motion is preferred.
+      var target = circumference * (1 - pct);
+      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        fill.style.strokeDashoffset = target;
+        return;
+      }
+      fill.style.strokeDashoffset = circumference;
+      void fill.getBoundingClientRect();
+      requestAnimationFrame(function () {
+        fill.style.strokeDashoffset = target;
+      });
+    })();
+  </script>
