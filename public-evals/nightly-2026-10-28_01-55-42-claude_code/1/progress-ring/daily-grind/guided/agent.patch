+    /* Progress ring (native <progress> styled with conic-gradient) */
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    @property --max {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 10;
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      flex: 0 0 auto;
+    }
+
+    progress.progress-ring {
+      --size: 180px;
+      --thickness: 18px;
+      --track-color: #ffe4bf; /* lighter step of the accent ramp */
+      --fill-color: var(--accent);
+      --value: attr(value type(<number>));
+      --max: attr(max type(<number>));
+      appearance: none;
+      -webkit-appearance: none;
+      display: block;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      background: conic-gradient(
+        var(--fill-color) calc(var(--value) / var(--max) * 1turn),
+        var(--track-color) 0
+      );
+      background-clip: border-area;
+      background-origin: border-box;
+      border: var(--thickness) solid transparent;
+      transition: --value 0s ease-in-out;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.6s;
+      }
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        mask-image: radial-gradient(
+          transparent calc(50% - var(--thickness)),
+          black calc(50% - var(--thickness) + 0.5px)
+        );
+        -webkit-mask-image: radial-gradient(
+          transparent calc(50% - var(--thickness)),
+          black calc(50% - var(--thickness) + 0.5px)
+        );
+      }
+    }
+
+    /* Hide the native progress bar rendering */
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value,
+    progress.progress-ring::-moz-progress-bar,
+    progress.progress-ring::slider-fill {
+      display: none;
+      background: none;
+    }
+
+    /* Reward unlocked state */
+    progress.progress-ring[value="10"] {
+      --fill-color: var(--primary);
+    }
+
