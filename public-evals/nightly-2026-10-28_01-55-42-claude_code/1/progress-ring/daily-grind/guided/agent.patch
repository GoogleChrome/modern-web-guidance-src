+  <script>
+    // Keep the ring's custom properties in sync with the <progress> attributes
+    // for browsers without CSS attr() type support (e.g. Safari).
+    (function () {
+      var ring = document.getElementById('rewards-progress');
+      if (!ring) return;
+      var supportsAttr = window.CSS && CSS.supports && CSS.supports('width: attr(value type(<number>))');
+      if (supportsAttr) return;
+      var sync = function () {
+        ring.style.setProperty('--value', ring.getAttribute('value'));
+        ring.style.setProperty('--max', ring.getAttribute('max'));
+      };
+      sync();
+      new MutationObserver(sync).observe(ring, { attributes: true, attributeFilter: ['value', 'max'] });
+    })();
+  </script>
