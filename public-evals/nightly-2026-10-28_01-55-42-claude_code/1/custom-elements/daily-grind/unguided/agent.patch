index 0000000..475a42f
--- /dev/null
+++ b/coffee-card.js
@@ -0,0 +1,480 @@
+/**
+ * <coffee-card> — an autonomous custom element for The Daily Grind menu cards.
+ *
+ * Attributes (all reflected to/from same-named properties):
+ *
+ *   String    name          Drink name (card heading).
+ *   String    description   Short blurb. Light-DOM children are used as a
+ *                           fallback when the attribute is absent.
+ *   String    href          Link target for the call-to-action button.
+ *   String    image         Optional image URL shown above the heading.
+ *   String    cta           Button label. Defaults to "View Details".
+ *   Number    price         Price in USD; rendered as "$4.50". Negative or
+ *                           non-numeric values are rejected.
+ *   Number    rating        0–5 star rating (fractions allowed). Clamped.
+ *   Boolean   featured      Presence => highlighted border + "Seasonal" badge.
+ *   Boolean   sold-out      Presence => dimmed card, disabled button.
+ *                           Property name is `soldOut`.
+ *
+ * Events:
+ *   coffee-card-select  Bubbling, composed. Fired when the CTA is activated.
+ *                       `detail` is { name, href, price }. Cancel with
+ *                       preventDefault() to stop the navigation.
+ *
+ * Lifecycle: constructor builds the shadow tree once; connectedCallback
+ * upgrades any properties set before the element was defined, wires
+ * listeners and renders; attributeChangedCallback schedules a single batched
+ * render per microtask; disconnectedCallback tears listeners down and
+ * cancels any pending render; adoptedCallback re-renders in the new document.
+ */
+
+const TAG_NAME = 'coffee-card';
+const DEFAULT_CTA = 'View Details';
+
+const STRING_ATTRS = ['name', 'description', 'href', 'image', 'cta'];
+const NUMBER_ATTRS = ['price', 'rating'];
+const BOOLEAN_ATTRS = ['featured', 'sold-out'];
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      overflow: hidden;
+      border: 2px solid transparent;
+      transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
+    }
+
+    :host(:hover) {
+      transform: translateY(-2px);
+      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
+    }
+
+    :host([hidden]) {
+      display: none;
+    }
+
+    :host([featured]) {
+      border-color: var(--accent, #ffab40);
+    }
+
+    :host([sold-out]) {
+      opacity: 0.6;
+    }
+
+    :host([sold-out]:hover) {
+      transform: none;
+    }
+
+    .media {
+      position: relative;
+      display: none;
+      aspect-ratio: 16 / 10;
+      background: var(--secondary, #d7ccc8);
+    }
+
+    :host([image]) .media {
+      display: block;
+    }
+
+    .media img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+
+    .badge {
+      display: none;
+      padding: 3px 10px;
+      border-radius: 999px;
+      font-size: 0.75rem;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      color: var(--text, #3e2723);
+      background: var(--accent, #ffab40);
+    }
+
+    /* With an image, the badge floats over the photo... */
+    :host([featured][image]) .media .badge {
+      display: inline-block;
+      position: absolute;
+      top: 10px;
+      left: 10px;
+    }
+
+    /* ...without one, it sits inline above the heading. */
+    :host([featured]:not([image])) .badge-inline {
+      display: inline-block;
+      margin-bottom: 10px;
+    }
+
+    .body {
+      padding: 20px;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      color: var(--primary, #4e342e);
+      font-size: 1.17rem;
+    }
+
+    p {
+      margin: 0;
+    }
+
+    .meta {
+      display: flex;
+      justify-content: center;
+      gap: 14px;
+      margin-top: 12px;
+      font-size: 0.95rem;
+      min-height: 1.4em;
+    }
+
+    .meta > span:empty {
+      display: none;
+    }
+
+    .price {
+      font-weight: 600;
+    }
+
+    .rating {
+      color: var(--accent, #ffab40);
+      letter-spacing: 1px;
+    }
+
+    .rating .count {
+      color: var(--text, #3e2723);
+      opacity: 0.7;
+      letter-spacing: 0;
+      margin-left: 4px;
+      font-size: 0.85rem;
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent, #ffab40);
+      outline-offset: 2px;
+    }
+
+    .btn[aria-disabled="true"] {
+      background: #9e9e9e;
+      cursor: not-allowed;
+      pointer-events: none;
+    }
+  </style>
+
+  <article part="card">
+    <div class="media" part="media">
+      <img part="image" alt="" loading="lazy" decoding="async">
+      <span class="badge" part="badge">Seasonal</span>
+    </div>
+    <div class="body" part="body">
+      <span class="badge badge-inline" part="badge">Seasonal</span>
+      <h3 part="title"></h3>
+      <p part="description"><slot></slot></p>
+      <div class="meta" part="meta">
+        <span class="price" part="price"></span>
+        <span class="rating" part="rating"></span>
+      </div>
+      <a class="btn" part="button" href="#"></a>
+    </div>
+  </article>
+`;
+
+function toNumber(value) {
+  if (value === null || value === undefined || value === '') return NaN;
+  return Number(value);
+}
+
+function formatPrice(value) {
+  return `$${value.toFixed(2)}`;
+}
+
+function renderStars(rating) {
+  const clamped = Math.max(0, Math.min(5, rating));
+  const full = Math.floor(clamped);
+  const half = clamped - full >= 0.5 ? 1 : 0;
+  const empty = 5 - full - half;
+  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
+}
+
+export class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [...STRING_ATTRS, ...NUMBER_ATTRS, ...BOOLEAN_ATTRS];
+  }
+
+  /** @type {ShadowRoot} */
+  #root;
+  #refs;
+  #renderQueued = false;
+  #connected = false;
+  #onClick;
+
+  constructor() {
+    super();
+    this.#root = this.attachShadow({ mode: 'open' });
+    this.#root.appendChild(template.content.cloneNode(true));
+
+    this.#refs = {
+      img: this.#root.querySelector('img'),
+      title: this.#root.querySelector('h3'),
+      description: this.#root.querySelector('p'),
+      slot: this.#root.querySelector('slot'),
+      price: this.#root.querySelector('.price'),
+      rating: this.#root.querySelector('.rating'),
+      button: this.#root.querySelector('.btn'),
+    };
+
+    this.#onClick = this.#handleClick.bind(this);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Lifecycle
+  // ---------------------------------------------------------------------------
+
+  connectedCallback() {
+    this.#connected = true;
+
+    // Properties assigned before this element was upgraded live as own
+    // properties that shadow the accessors. Re-route them through the setters.
+    for (const attr of CoffeeCard.observedAttributes) {
+      this.#upgradeProperty(CoffeeCard.#propName(attr));
+    }
+
+    if (!this.hasAttribute('role')) this.setAttribute('role', 'listitem');
+
+    this.#refs.button.addEventListener('click', this.#onClick);
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#connected = false;
+    this.#renderQueued = false;
+    this.#refs.button.removeEventListener('click', this.#onClick);
+  }
+
+  adoptedCallback() {
+    // Moved to a new document (e.g. an iframe). Styles travel with the shadow
+    // root; just make sure the rendered output is current.
+    this.#scheduleRender();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    this.#scheduleRender();
+  }
+
+  // ---------------------------------------------------------------------------
+  // String attributes
+  // ---------------------------------------------------------------------------
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+  set name(value) {
+    this.#setString('name', value);
+  }
+
+  get description() {
+    return this.getAttribute('description') ?? '';
+  }
+  set description(value) {
+    this.#setString('description', value);
+  }
+
+  get href() {
+    return this.getAttribute('href') ?? '';
+  }
+  set href(value) {
+    this.#setString('href', value);
+  }
+
+  get image() {
+    return this.getAttribute('image') ?? '';
+  }
+  set image(value) {
+    this.#setString('image', value);
+  }
+
+  get cta() {
+    return this.getAttribute('cta') ?? DEFAULT_CTA;
+  }
+  set cta(value) {
+    this.#setString('cta', value);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Numeric attributes
+  // ---------------------------------------------------------------------------
+
+  /** Price in USD, or NaN when unset/invalid. */
+  get price() {
+    return toNumber(this.getAttribute('price'));
+  }
+  set price(value) {
+    const n = toNumber(value);
+    if (!Number.isFinite(n) || n < 0) {
+      this.removeAttribute('price');
+      return;
+    }
+    this.setAttribute('price', String(n));
+  }
+
+  /** Star rating from 0 to 5, or NaN when unset/invalid. */
+  get rating() {
+    return toNumber(this.getAttribute('rating'));
+  }
+  set rating(value) {
+    const n = toNumber(value);
+    if (!Number.isFinite(n)) {
+      this.removeAttribute('rating');
+      return;
+    }
+    this.setAttribute('rating', String(Math.max(0, Math.min(5, n))));
+  }
+
+  // ---------------------------------------------------------------------------
+  // Boolean attributes
+  // ---------------------------------------------------------------------------
+
+  get featured() {
+    return this.hasAttribute('featured');
+  }
+  set featured(value) {
+    this.toggleAttribute('featured', Boolean(value));
+  }
+
+  get soldOut() {
+    return this.hasAttribute('sold-out');
+  }
+  set soldOut(value) {
+    this.toggleAttribute('sold-out', Boolean(value));
+  }
+
+  // ---------------------------------------------------------------------------
+  // Internals
+  // ---------------------------------------------------------------------------
+
+  static #propName(attr) {
+    return attr.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
+  }
+
+  #upgradeProperty(prop) {
+    if (Object.prototype.hasOwnProperty.call(this, prop)) {
+      const value = this[prop];
+      delete this[prop];
+      this[prop] = value;
+    }
+  }
+
+  #setString(attr, value) {
+    if (value === null || value === undefined || value === false) {
+      this.removeAttribute(attr);
+    } else {
+      this.setAttribute(attr, String(value));
+    }
+  }
+
+  #scheduleRender() {
+    if (!this.#connected || this.#renderQueued) return;
+    this.#renderQueued = true;
+    queueMicrotask(() => {
+      if (!this.#renderQueued) return; // cancelled by disconnect
+      this.#renderQueued = false;
+      this.#render();
+    });
+  }
+
+  #render() {
+    const { img, title, description, slot, price, rating, button } = this.#refs;
+
+    // Image
+    const image = this.image;
+    if (image) {
+      if (img.getAttribute('src') !== image) img.src = image;
+      img.alt = this.name;
+    } else {
+      img.removeAttribute('src');
+      img.alt = '';
+    }
+
+    // Heading / description
+    title.textContent = this.name;
+    if (this.hasAttribute('description')) {
+      // Attribute wins over slotted light-DOM content.
+      description.replaceChildren(this.description);
+    } else if (slot.parentNode !== description) {
+      description.replaceChildren(slot);
+    }
+
+    // Numbers
+    const p = this.price;
+    price.textContent = Number.isFinite(p) ? formatPrice(p) : '';
+
+    const r = this.rating;
+    if (Number.isFinite(r)) {
+      rating.replaceChildren(renderStars(r));
+      const count = document.createElement('span');
+      count.className = 'count';
+      count.textContent = r.toFixed(1);
+      rating.appendChild(count);
+      rating.setAttribute('aria-label', `Rated ${r.toFixed(1)} out of 5`);
+    } else {
+      rating.replaceChildren();
+      rating.removeAttribute('aria-label');
+    }
+
+    // Call to action
+    const soldOut = this.soldOut;
+    button.textContent = soldOut ? 'Sold Out' : this.cta;
+    button.setAttribute('aria-disabled', String(soldOut));
+    if (soldOut) {
+      button.removeAttribute('href');
+      button.setAttribute('tabindex', '-1');
+    } else {
+      button.href = this.href || '#';
+      button.removeAttribute('tabindex');
+    }
+    button.setAttribute('aria-label', `${button.textContent}: ${this.name}`.trim());
+  }
+
+  #handleClick(event) {
+    if (this.soldOut) {
+      event.preventDefault();
+      return;
+    }
+    const detail = { name: this.name, href: this.href, price: this.price };
+    const proceed = this.dispatchEvent(
+      new CustomEvent('coffee-card-select', { detail, bubbles: true, composed: true, cancelable: true }),
+    );
+    if (!proceed) event.preventDefault();
+  }
+}
+
+if (!customElements.get(TAG_NAME)) {
+  customElements.define(TAG_NAME, CoffeeCard);
+}
+
+export default CoffeeCard;
