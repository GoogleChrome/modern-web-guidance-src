+#!/usr/bin/env node
+/**
+ * Privacy / security regression check for The Daily Grind.
+ *
+ * Run with `npm run check:privacy`. Exits non-zero on any failure so it can gate CI.
+ *
+ * What it audits:
+ *  1. Third parties — every absolute URL in HTML/CSS/JS must point at an origin listed
+ *     in ALLOWED_THIRD_PARTY_ORIGINS, and every allowed origin must be documented in
+ *     PRIVACY.md. The list is intentionally empty today.
+ *  2. DOM XSS sinks and other anti-patterns in client scripts and markup.
+ *  3. Storage/cookie writes that could persist personal data in the browser.
+ *  4. Header consistency — the CSP in package.json (`statikk --csp`), `_headers`, and
+ *     the <meta> fallback in index.html must agree, and `_headers` must carry the
+ *     baseline privacy headers.
+ */
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import { join, extname, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url));
+
+/** Origins that may be referenced from client-side code. Add an entry ONLY after
+ *  recording the audit in PRIVACY.md (what is sent, why, and the retention). */
+const ALLOWED_THIRD_PARTY_ORIGINS = new Set([]);
+
+const REQUIRED_HEADERS = [
+  'Content-Security-Policy',
+  'Referrer-Policy',
+  'Permissions-Policy',
+  'X-Content-Type-Options',
+  'X-Frame-Options',
+  'Cross-Origin-Opener-Policy',
+  'Cross-Origin-Resource-Policy',
+  'Strict-Transport-Security',
+];
+
+const REQUIRED_CSP_DIRECTIVES = {
+  'default-src': "'none'",
+  'object-src': "'none'",
+  'base-uri': "'none'",
+  'frame-ancestors': "'none'",
+  'form-action': "'self'",
+  'require-trusted-types-for': "'script'",
+};
+
+/** Directives that browsers ignore inside a <meta> CSP, so they are header-only. */
+const META_UNSUPPORTED_DIRECTIVES = new Set(['frame-ancestors', 'report-uri', 'report-to', 'sandbox']);
+
+const SCAN_EXTENSIONS = new Set(['.html', '.css', '.js', '.mjs']);
+const IGNORED_DIRS = new Set(['node_modules', '.git', 'tools']);
+
+const failures = [];
+const notes = [];
+const fail = (msg) => failures.push(msg);
+
+function walk(dir, out = []) {
+  for (const name of readdirSync(dir)) {
+    if (IGNORED_DIRS.has(name)) continue;
+    const full = join(dir, name);
+    if (statSync(full).isDirectory()) walk(full, out);
+    else if (SCAN_EXTENSIONS.has(extname(name))) out.push(full);
+  }
+  return out;
+}
+
+const files = walk(ROOT).map((f) => ({
+  path: relative(ROOT, f),
+  ext: extname(f),
+  text: readFileSync(f, 'utf8'),
+}));
+
+/* 1. Third-party origins ---------------------------------------------------- */
+const URL_RE = /(?:https?:)?\/\/[a-z0-9.-]+\.[a-z]{2,}(?::\d+)?(?=[/'"\s)?#]|$)/gi;
+const externalOrigins = new Map();
+for (const file of files) {
+  for (const match of file.text.matchAll(URL_RE)) {
+    const origin = match[0].replace(/^\/\//, 'https://').toLowerCase();
+    if (origin === 'https://www.w3.org') continue; // XML namespaces are not fetched.
+    if (!externalOrigins.has(origin)) externalOrigins.set(origin, new Set());
+    externalOrigins.get(origin).add(file.path);
+  }
+}
+const privacyDoc = readFileSync(join(ROOT, 'PRIVACY.md'), 'utf8');
+for (const [origin, where] of externalOrigins) {
+  if (!ALLOWED_THIRD_PARTY_ORIGINS.has(origin)) {
+    fail(`Unaudited third-party origin ${origin} referenced in ${[...where].join(', ')}`);
+  } else if (!privacyDoc.includes(origin)) {
+    fail(`Allowed origin ${origin} is not documented in PRIVACY.md`);
+  }
+}
+notes.push(`third-party origins referenced: ${externalOrigins.size}`);
+
+/* 2. Dangerous sinks / anti-patterns --------------------------------------- */
+const JS_SINKS = [
+  [/\.innerHTML\s*=/, 'innerHTML assignment'],
+  [/\.outerHTML\s*=/, 'outerHTML assignment'],
+  [/insertAdjacentHTML\s*\(/, 'insertAdjacentHTML'],
+  [/document\.write(ln)?\s*\(/, 'document.write'],
+  [/\beval\s*\(/, 'eval'],
+  [/new\s+Function\s*\(/, 'new Function'],
+  [/set(Timeout|Interval)\s*\(\s*['"`]/, 'setTimeout/setInterval with a string'],
+  [/navigator\.userAgent\b/, 'navigator.userAgent sniffing (use feature detection)'],
+  [/\bconsole\.(log|info|debug|warn|error)\s*\([^)]*\b(email|password|token|phone|name)\b/i, 'console output that may contain personal data'],
+];
+const HTML_PATTERNS = [
+  [/\son[a-z]+\s*=\s*["']/i, 'inline event handler attribute'],
+  [/<script(?![^>]*\ssrc=)[^>]*>[^<]*\S[^<]*<\/script>/i, 'inline <script> block'],
+  [/<style[\s>]/i, 'inline <style> block'],
+  [/\sstyle\s*=\s*["']/i, 'inline style="" attribute'],
+  [/href\s*=\s*["']\s*javascript:/i, 'javascript: URL'],
+  [/<iframe[\s>]/i, '<iframe> (third-party embed needs an audit + façade)'],
+  [/<(object|embed)[\s>]/i, 'plugin element'],
+  [/<base[\s>]/i, '<base> element'],
+  [/<form(?![^>]*method\s*=\s*["']post["'])[^>]*>/i, '<form> without method="post" (personal data must not go in a URL)'],
+  [/<input[^>]*type\s*=\s*["']hidden["'][^>]*name\s*=\s*["'][^"']*(id|uid|user)[^"']*["']/i, 'hidden identifier field'],
+];
+const stripJsComments = (text) => text.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/.*$/gm, '');
+for (const file of files) {
+  const patterns = file.ext === '.html' ? [...HTML_PATTERNS, ...JS_SINKS] : file.ext === '.css' ? [] : JS_SINKS;
+  const text = file.ext === '.html' ? file.text : stripJsComments(file.text);
+  for (const [re, label] of patterns) {
+    if (re.test(text)) fail(`${file.path}: ${label}`);
+  }
+  if (file.ext === '.html') {
+    for (const tag of file.text.matchAll(/<a\b[^>]*target\s*=\s*["']_blank["'][^>]*>/gi)) {
+      if (!/rel\s*=\s*["'][^"']*noopener/i.test(tag[0])) fail(`${file.path}: target="_blank" link without rel="noopener"`);
+    }
+  }
+}
+
+/* 3. Browser-side persistence ---------------------------------------------- */
+for (const file of files.filter((f) => f.ext !== '.css')) {
+  if (/document\.cookie\s*=/.test(file.text)) fail(`${file.path}: writes document.cookie (cookies must be set server-side with HttpOnly)`);
+  if (/(localStorage|sessionStorage)\.setItem\s*\(|(localStorage|sessionStorage)\[[^\]]+\]\s*=/.test(file.text)) {
+    fail(`${file.path}: writes to web storage (never store personal data or tokens client-side)`);
+  }
+  if (/indexedDB\.open\s*\(/.test(file.text)) fail(`${file.path}: opens IndexedDB (review for personal data)`);
+}
+
+/* 4. Header consistency ---------------------------------------------------- */
+function parseCsp(value) {
+  const map = new Map();
+  for (const part of value.split(';')) {
+    const tokens = part.trim().split(/\s+/).filter(Boolean);
+    if (tokens.length) map.set(tokens[0].toLowerCase(), tokens.slice(1).sort().join(' '));
+  }
+  return map;
+}
+function diffCsp(a, b, { ignore = new Set() } = {}) {
+  const diffs = [];
+  for (const name of new Set([...a.keys(), ...b.keys()])) {
+    if (ignore.has(name)) continue;
+    if (a.get(name) !== b.get(name)) diffs.push(name);
+  }
+  return diffs;
+}
+
+const pkg = JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf8'));
+const startCspMatch = /--csp\s+"([^"]+)"/.exec(pkg.scripts?.start ?? '');
+if (!startCspMatch) fail('package.json: start script does not pass --csp to statikk');
+
+/** Parses a Netlify/Cloudflare `_headers` file into { path -> Map(header -> value) }. */
+function parseHeadersFile(text) {
+  const blocks = new Map();
+  let current = null;
+  for (const raw of text.split('\n')) {
+    if (!raw.trim() || raw.trim().startsWith('#')) continue;
+    if (!/^\s/.test(raw)) {
+      current = new Map();
+      blocks.set(raw.trim(), current);
+      continue;
+    }
+    const idx = raw.indexOf(':');
+    if (current && idx > 0) current.set(raw.slice(0, idx).trim().toLowerCase(), raw.slice(idx + 1).trim());
+  }
+  return blocks;
+}
+
+const headerBlocks = parseHeadersFile(readFileSync(join(ROOT, '_headers'), 'utf8'));
+const globalHeaders = headerBlocks.get('/*') ?? new Map();
+for (const name of REQUIRED_HEADERS) {
+  if (!globalHeaders.has(name.toLowerCase())) fail(`_headers: missing ${name} on /*`);
+}
+if (!headerBlocks.get('/logout')?.has('clear-site-data')) {
+  fail('_headers: /logout must send Clear-Site-Data');
+}
+
+const html = files.find((f) => f.path === 'index.html')?.text ?? '';
+const metaCspMatch = /<meta\s+http-equiv=["']Content-Security-Policy["']\s+content="([^"]+)"/i.exec(html);
+if (!metaCspMatch) fail('index.html: missing <meta http-equiv="Content-Security-Policy"> fallback');
+if (!/<meta\s+name=["']referrer["']\s+content=["']strict-origin-when-cross-origin["']/i.test(html)) {
+  fail('index.html: missing <meta name="referrer" content="strict-origin-when-cross-origin">');
+}
+
+const headerCsp = globalHeaders.get('content-security-policy');
+if (headerCsp) {
+  const parsed = parseCsp(headerCsp);
+  for (const [directive, expected] of Object.entries(REQUIRED_CSP_DIRECTIVES)) {
+    if (parsed.get(directive) !== expected) fail(`CSP: expected "${directive} ${expected}"`);
+  }
+  if (/'unsafe-inline'|'unsafe-eval'|\bhttps?:(?=[\s;]|$)|\*/.test(headerCsp)) {
+    fail("CSP: contains 'unsafe-inline', 'unsafe-eval', a bare scheme, or a wildcard");
+  }
+  if (startCspMatch && diffCsp(parsed, parseCsp(startCspMatch[1])).length) {
+    fail('CSP: package.json --csp differs from _headers');
+  }
+  if (metaCspMatch) {
+    const diffs = diffCsp(parsed, parseCsp(metaCspMatch[1]), { ignore: META_UNSUPPORTED_DIRECTIVES });
+    if (diffs.length) fail(`CSP: <meta> fallback differs from _headers in: ${diffs.join(', ')}`);
+    for (const d of META_UNSUPPORTED_DIRECTIVES) {
+      if (parseCsp(metaCspMatch[1]).has(d)) fail(`CSP: <meta> fallback contains ${d}, which browsers ignore in <meta>`);
+    }
+  }
+}
+
+/* Report -------------------------------------------------------------------- */
+console.log(`privacy-check: scanned ${files.length} files (${notes.join('; ')})`);
+if (failures.length) {
+  console.error(`\n${failures.length} problem(s):`);
+  for (const f of failures) console.error(`  ✗ ${f}`);
+  process.exit(1);
+}
+console.log('privacy-check: OK — no third parties, no unsafe sinks, headers consistent');
