@@ -0,0 +1,120 @@
+/*
+ * The Daily Grind — first-party client script.
+ *
+ * Privacy-by-design rules for this file (enforced by `npm run check:privacy`):
+ *  - No third-party code, analytics, pixels, or cookies. Nothing runs on page load
+ *    except wiring up event listeners; no data leaves the browser until the visitor
+ *    explicitly submits a form.
+ *  - Personal data is never written to localStorage/sessionStorage, cookies, or the
+ *    console, and the email field is cleared from the DOM as soon as it is accepted.
+ *  - The DOM is only written through `textContent` and attributes, never innerHTML,
+ *    so the page runs under CSP `require-trusted-types-for 'script'`.
+ *  - Capability checks use feature detection, never user-agent string sniffing.
+ */
+(() => {
+  'use strict';
+
+  const NEWSLETTER_ENDPOINT = '/api/newsletter';
+  const REQUEST_TIMEOUT_MS = 10000;
+
+  /** Shows a message in a live region without leaking it anywhere else. */
+  function setStatus(statusEl, state, message) {
+    statusEl.dataset.state = state;
+    statusEl.textContent = message;
+  }
+
+  /** Minimal, same-origin-only POST. Credentials/referrer never go cross-origin. */
+  function postSameOrigin(url, body) {
+    const init = {
+      method: 'POST',
+      body,
+      mode: 'same-origin',
+      credentials: 'same-origin',
+      referrerPolicy: 'same-origin',
+      redirect: 'follow',
+      headers: { Accept: 'application/json' },
+    };
+    if ('AbortSignal' in window && typeof AbortSignal.timeout === 'function') {
+      init.signal = AbortSignal.timeout(REQUEST_TIMEOUT_MS);
+    }
+    return fetch(url, init);
+  }
+
+  function enhanceNewsletterForm() {
+    const form = document.getElementById('newsletter-form');
+    if (!form || !('fetch' in window) || !('FormData' in window)) {
+      return; // Plain HTML form submission still works without JS.
+    }
+
+    const emailInput = form.elements.namedItem('email');
+    const submitButton = form.querySelector('button[type="submit"]');
+    const statusEl = document.getElementById('newsletter-status');
+    if (!(emailInput instanceof HTMLInputElement) || !submitButton || !statusEl) return;
+
+    emailInput.addEventListener('invalid', () => {
+      emailInput.setCustomValidity('Please enter an email address like name@example.com.');
+    });
+    emailInput.addEventListener('input', () => {
+      emailInput.setCustomValidity('');
+      if (statusEl.dataset.state === 'error') setStatus(statusEl, '', '');
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      if (!form.checkValidity()) {
+        form.reportValidity();
+        return;
+      }
+
+      // Data minimisation: send exactly one field, built explicitly, so a future
+      // extra input on the form can't be submitted by accident.
+      const body = new FormData();
+      body.set('email', emailInput.value.trim());
+
+      submitButton.disabled = true; // Prevent double posts after a valid submit.
+      setStatus(statusEl, 'pending', 'Signing you up…');
+
+      try {
+        const response = await postSameOrigin(NEWSLETTER_ENDPOINT, body);
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+
+        // Remove the address from the page as soon as the server has it.
+        form.reset();
+        setStatus(
+          statusEl,
+          'success',
+          'Thanks! Check your inbox for a confirmation link to finish signing up.'
+        );
+      } catch {
+        // Never log the submitted value; a generic message is enough for the visitor.
+        setStatus(
+          statusEl,
+          'error',
+          'Sorry, we could not sign you up right now. Please try again in a moment.'
+        );
+      } finally {
+        submitButton.disabled = false;
+      }
+    });
+  }
+
+  function enhanceLogout() {
+    const logoutForm = document.getElementById('logout-form');
+    if (!logoutForm) return;
+
+    // Belt-and-braces for browsers that ignore the Clear-Site-Data response header on
+    // /logout: drop any first-party web storage before the request leaves.
+    logoutForm.addEventListener('submit', () => {
+      try {
+        if ('sessionStorage' in window) sessionStorage.clear();
+        if ('localStorage' in window) localStorage.clear();
+      } catch {
+        // Storage can be unavailable (e.g. blocked by the user); logout still proceeds.
+      }
+    });
+  }
+
+  enhanceNewsletterForm();
+  enhanceLogout();
+})();
