+# Production response headers for The Daily Grind.
+#
+# Format: Netlify / Cloudflare Pages `_headers`. For other hosts, copy the same
+# values into the equivalent config (nginx `add_header`, Vercel `headers`, Express
+# middleware, etc.). The CSP here must stay identical to the `--csp` value in
+# package.json; `npm run check:privacy` fails if they drift.
+#
+# HSTS: the 1-year max-age is intended for a stable HTTPS deployment. If this is
+# the first HTTPS rollout, start with `max-age=300`, verify every subdomain works
+# over HTTPS, then raise it. `preload` is deliberately omitted because it is
+# effectively irreversible once submitted to the browser preload list.
+
+/*
+  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'
+  Referrer-Policy: strict-origin-when-cross-origin
+  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), usb=(), xr-spatial-tracking=()
+  X-Content-Type-Options: nosniff
+  X-Frame-Options: DENY
+  Cross-Origin-Opener-Policy: same-origin-allow-popups
+  Cross-Origin-Resource-Policy: same-origin
+  Strict-Transport-Security: max-age=31536000; includeSubDomains
+
+# Session termination: wipe first-party state so nothing lingers on shared devices.
+/logout
+  Clear-Site-Data: "cookies", "storage", "cache"
+  Cache-Control: no-store
+
+# Anything personal must never land in a shared or CDN cache.
+/account/*
+  Cache-Control: no-store
+
+/api/*
+  Cache-Control: no-store
