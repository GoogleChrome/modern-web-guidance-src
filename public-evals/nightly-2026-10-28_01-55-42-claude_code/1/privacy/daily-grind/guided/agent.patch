+/*
+ * The Daily Grind — site styles.
+ *
+ * Privacy/security notes:
+ *  - All styles live in this file (no inline <style> or style="" attributes) so the
+ *    Content-Security-Policy can use `style-src 'self'` without 'unsafe-inline'.
+ *  - Every asset referenced from here is same-origin. The hero photo is self-hosted
+ *    (see PRIVACY.md) so visitors' IP addresses and referrers are not sent to an
+ *    image CDN on every page view.
+ */
+
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --focus: #0b57d0;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  align-items: center;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+/* Logout is a POST form (state change must not be a GET link); the button is
+   styled to match the previous link. */
+.logout-form {
+  display: inline;
+}
+
+.logout-link {
+  font: inherit;
+  font-size: 0.9rem;
+  color: white;
+  background: none;
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+  cursor: pointer;
+  transition: color 0.3s;
+}
+
+.logout-link:hover {
+  color: var(--accent);
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('/assets/images/hero-coffee.jpg');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  font: inherit;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border: 0;
+  border-radius: 5px;
+  margin-top: 15px;
+  cursor: pointer;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+/* Newsletter sign-up */
+.newsletter {
+  margin-top: 60px;
+  padding: 30px 20px;
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.newsletter > p {
+  max-width: 48ch;
+  margin: 10px auto 0;
+}
+
+.newsletter-form {
+  max-width: 28rem;
+  margin: 20px auto 0;
+  text-align: left;
+}
+
+.field {
+  margin-block-end: 1rem;
+}
+
+.field label {
+  display: block;
+  font-weight: 600;
+  margin-block-end: 0.25rem;
+}
+
+.field input {
+  width: 100%;
+  font: inherit;
+  font-size: 1rem;
+  padding: 0.75rem;
+  min-height: 48px;
+  border: 1px solid #8d6e63;
+  border-radius: 5px;
+  background: var(--light);
+  color: var(--text);
+}
+
+@media (pointer: coarse) {
+  .field input {
+    min-height: 52px;
+  }
+}
+
+/* Only flag a field after the user has interacted with it. */
+.field input:user-invalid {
+  border-color: #b3261e;
+  border-width: 2px;
+}
+
+.hint {
+  font-size: 0.85rem;
+  margin-block-start: 0.5rem;
+  color: #5d4037;
+}
+
+.hint a {
+  color: var(--primary);
+}
+
+.form-status {
+  min-height: 1.6em;
+  margin-top: 10px;
+  font-size: 0.95rem;
+}
+
+.form-status[data-state='error'] {
+  color: #b3261e;
+}
+
+.form-status[data-state='success'] {
+  color: #1b5e20;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.footer-note {
+  font-size: 0.8rem;
+  margin-top: 10px;
+  color: #5d4037;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * {
+    transition: none !important;
+  }
+}
