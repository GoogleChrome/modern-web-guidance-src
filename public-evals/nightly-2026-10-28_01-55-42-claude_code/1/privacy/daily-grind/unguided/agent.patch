+/*
+ * The Daily Grind – client-side privacy controls.
+ *
+ * Design rules for this file (enforced by scripts/privacy-audit.mjs):
+ *   - No network requests. Nothing here phones home, not even for "telemetry".
+ *   - No cookies, no localStorage. Only namespaced, expiring sessionStorage,
+ *     and never for personal data.
+ *   - No fingerprinting APIs (canvas, WebGL renderer, battery, fonts, …).
+ *   - No innerHTML / eval. Works under `require-trusted-types-for 'script'`.
+ *   - Fails open: any error here must never break the page.
+ *
+ * Public API (read-only): window.DailyGrindPrivacy
+ *   .optedOut()            -> true when GPC or DNT is set
+ *   .storage.get/set/remove/clear   -> safe session storage
+ *   .thirdParties()        -> list of cross-origin loads observed on this page
+ *   .allowedOrigins        -> the only non-self origins permitted (currently none)
+ */
+(function () {
+  'use strict';
+
+  /* ------------------------------------------------------------------ */
+  /* Configuration                                                       */
+  /* ------------------------------------------------------------------ */
+
+  var CONFIG = Object.freeze({
+    // Origins other than our own that are permitted to receive requests.
+    // Keep this empty unless a third party has passed the privacy audit
+    // documented in PRIVACY.md and is listed in config/third-parties.json.
+    allowedOrigins: Object.freeze([]),
+
+    // Remove injected cross-origin <script>/<iframe> elements (defence in
+    // depth behind CSP, e.g. for browser extensions or a misconfigured host).
+    enforce: true,
+
+    // sessionStorage namespace and ceiling for stored values.
+    storagePrefix: 'dg:',
+    storageMaxBytes: 4096,
+    storageDefaultTtlMs: 30 * 60 * 1000,
+
+    // Query parameters that exist only to track people across sites.
+    trackingParams: Object.freeze([
+      /^utm_/i, /^ga_/i, /^_ga$/i, /^_gl$/i, /^gclid$/i, /^gclsrc$/i, /^dclid$/i,
+      /^gbraid$/i, /^wbraid$/i, /^fbclid$/i, /^fb_action_ids$/i, /^fb_source$/i,
+      /^msclkid$/i, /^mc_eid$/i, /^mc_cid$/i, /^igshid$/i, /^twclid$/i,
+      /^ttclid$/i, /^yclid$/i, /^li_fat_id$/i, /^_hsenc$/i, /^_hsmi$/i,
+      /^hsCtaTracking$/i, /^vero_id$/i, /^oly_anon_id$/i, /^oly_enc_id$/i,
+      /^wickedid$/i, /^srsltid$/i, /^sccid$/i, /^s_kwcid$/i, /^ef_id$/i,
+      /^mkt_tok$/i, /^trk$/i, /^trkCampaign$/i, /^ref_src$/i, /^spm$/i
+    ]),
+
+    // Keys that must never be persisted client-side, even in sessionStorage.
+    sensitiveKeyPattern: /(email|phone|mobile|name|address|street|zip|postal|card|pan|cvv|cvc|iban|account|token|secret|password|passwd|pwd|ssn|dob|birth|ip|geo|lat|lng|lon)/i
+  });
+
+  var warn = function () {
+    try {
+      if (typeof console !== 'undefined' && console.warn) {
+        console.warn.apply(console, ['[privacy]'].concat([].slice.call(arguments)));
+      }
+    } catch (_) { /* ignore */ }
+  };
+
+  var sameOrigin = function (url) {
+    try {
+      var u = new URL(url, location.href);
+      return u.origin === location.origin || u.protocol === 'data:' || u.protocol === 'blob:' || u.protocol === 'about:';
+    } catch (_) {
+      return true; // relative / unparsable -> treat as ours
+    }
+  };
+
+  var isAllowedOrigin = function (url) {
+    try {
+      var origin = new URL(url, location.href).origin;
+      return CONFIG.allowedOrigins.indexOf(origin) !== -1;
+    } catch (_) {
+      return false;
+    }
+  };
+
+  /* ------------------------------------------------------------------ */
+  /* 1. Data minimisation: scrub tracking parameters from the URL         */
+  /* ------------------------------------------------------------------ */
+
+  function scrubTrackingParams() {
+    if (!window.history || !history.replaceState || !window.URLSearchParams) return;
+    var url = new URL(location.href);
+    var removed = [];
+    var keys = [];
+    url.searchParams.forEach(function (_, key) { keys.push(key); });
+    keys.forEach(function (key) {
+      for (var i = 0; i < CONFIG.trackingParams.length; i++) {
+        if (CONFIG.trackingParams[i].test(key)) {
+          url.searchParams.delete(key);
+          removed.push(key);
+          break;
+        }
+      }
+    });
+    if (removed.length) {
+      var clean = url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : '') + url.hash;
+      history.replaceState(history.state, '', clean);
+    }
+  }
+
+  /* ------------------------------------------------------------------ */
+  /* 2. Honour Global Privacy Control / Do Not Track                      */
+  /* ------------------------------------------------------------------ */
+
+  function optedOut() {
+    try {
+      if (navigator.globalPrivacyControl === true) return true;
+      var dnt = navigator.doNotTrack || window.doNotTrack || navigator.msDoNotTrack;
+      return dnt === '1' || dnt === 'yes';
+    } catch (_) {
+      return false;
+    }
+  }
+
+  function announcePrivacySignal() {
+    var el = document.getElementById('privacy-signal');
+    if (!el) return;
+    if (navigator.globalPrivacyControl === true) {
+      document.documentElement.setAttribute('data-privacy-signal', 'gpc');
+      el.textContent = 'Your browser sent a Global Privacy Control signal. We honour it: nothing about your visit is sold or shared.';
+      el.setAttribute('data-visible', 'true');
+    } else if (optedOut()) {
+      document.documentElement.setAttribute('data-privacy-signal', 'dnt');
+      el.textContent = 'Your browser sent a Do Not Track signal. We honour it: nothing about your visit is sold or shared.';
+      el.setAttribute('data-visible', 'true');
+    }
+  }
+
+  /* ------------------------------------------------------------------ */
+  /* 3. Third-party audit at runtime                                      */
+  /* ------------------------------------------------------------------ */
+
+  var observedThirdParties = [];
+
+  function recordThirdParty(kind, url, element) {
+    if (sameOrigin(url) || isAllowedOrigin(url)) return;
+    var origin;
+    try { origin = new URL(url, location.href).origin; } catch (_) { origin = String(url); }
+    if (observedThirdParties.indexOf(origin) === -1) observedThirdParties.push(origin);
+    warn('Unexpected third-party ' + kind + ' to ' + origin + '. Add it to config/third-parties.json only after an audit.');
+    try {
+      document.dispatchEvent(new CustomEvent('privacy:third-party', {
+        detail: { kind: kind, origin: origin, url: String(url) }
+      }));
+    } catch (_) { /* ignore */ }
+    if (CONFIG.enforce && element && (element.tagName === 'SCRIPT' || element.tagName === 'IFRAME')) {
+      try {
+        element.remove();
+        warn('Removed injected <' + element.tagName.toLowerCase() + '> from ' + origin + '.');
+      } catch (_) { /* ignore */ }
+    }
+  }
+
+  function watchResourceTimings() {
+    if (!('PerformanceObserver' in window)) return;
+    try {
+      var po = new PerformanceObserver(function (list) {
+        list.getEntries().forEach(function (entry) {
+          recordThirdParty(entry.initiatorType || 'resource', entry.name, null);
+        });
+      });
+      po.observe({ type: 'resource', buffered: true });
+    } catch (_) { /* unsupported options in old engines */ }
+  }
+
+  function watchDomInsertions() {
+    if (!('MutationObserver' in window)) return;
+    var attrFor = { SCRIPT: 'src', IFRAME: 'src', IMG: 'src', LINK: 'href', VIDEO: 'src', AUDIO: 'src', SOURCE: 'src', EMBED: 'src', OBJECT: 'data' };
+    var check = function (node) {
+      if (!node || node.nodeType !== 1) return;
+      var attr = attrFor[node.tagName];
+      if (attr) {
+        var value = node.getAttribute(attr);
+        if (value) recordThirdParty(node.tagName.toLowerCase(), value, node);
+      }
+      if (node.children && node.children.length) {
+        for (var i = 0; i < node.children.length; i++) check(node.children[i]);
+      }
+    };
+    var mo = new MutationObserver(function (mutations) {
+      mutations.forEach(function (m) {
+        if (m.type === 'childList') {
+          for (var i = 0; i < m.addedNodes.length; i++) check(m.addedNodes[i]);
+        } else if (m.type === 'attributes' && m.target) {
+          check(m.target);
+        }
+      });
+    });
+    mo.observe(document.documentElement, {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: ['src', 'href', 'data']
+    });
+  }
+
+  /* ------------------------------------------------------------------ */
+  /* 4. Link hygiene                                                      */
+  /* ------------------------------------------------------------------ */
+
+  function hardenLinks(root) {
+    var links = (root || document).querySelectorAll('a[href]');
+    for (var i = 0; i < links.length; i++) {
+      var a = links[i];
+      var external = !sameOrigin(a.getAttribute('href'));
+      if (external || a.target === '_blank') {
+        var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+        if (rel.indexOf('noopener') === -1) rel.push('noopener');
+        if (rel.indexOf('noreferrer') === -1) rel.push('noreferrer');
+        a.setAttribute('rel', rel.join(' '));
+        if (external && !a.hasAttribute('referrerpolicy')) a.setAttribute('referrerpolicy', 'no-referrer');
+      }
+    }
+  }
+
+  /* ------------------------------------------------------------------ */
+  /* 5. Secure, minimal client-side storage                               */
+  /* ------------------------------------------------------------------ */
