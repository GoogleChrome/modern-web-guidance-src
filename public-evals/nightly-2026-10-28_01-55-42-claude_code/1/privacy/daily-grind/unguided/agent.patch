+  /* ------------------------------------------------------------------ */
+  /* Boot                                                                 */
+  /* ------------------------------------------------------------------ */
+
+  function boot() {
+    var steps = [scrubTrackingParams, announcePrivacySignal, watchResourceTimings, watchDomInsertions, hardenLinks, storage.sweep, wireLogout];
+    steps.forEach(function (step) {
