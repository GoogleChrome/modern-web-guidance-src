+#!/usr/bin/env node
+/**
+ * Renders config/security-headers.json into deployment formats so the header
+ * set is defined once and applied everywhere:
+ *
+ *   _headers                 Netlify / Cloudflare Pages
+ *   config/nginx-headers.conf  include-able nginx snippet
+ *
+ * Usage: node scripts/build-headers.mjs
+ */
+import { readFileSync, writeFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const config = JSON.parse(readFileSync(resolve(root, 'config/security-headers.json'), 'utf8'));
+
+const banner = 'Generated by scripts/build-headers.mjs from config/security-headers.json. Do not edit by hand.';
+
+/* ---------------- Netlify / Cloudflare Pages `_headers` ---------------- */
+let netlify = `# ${banner}\n/*\n`;
+for (const [name, value] of Object.entries(config.headers)) {
+  netlify += `  ${name}: ${value}\n`;
+}
+for (const [path, headers] of Object.entries(config.paths)) {
+  if (path.startsWith('$')) continue;
+  netlify += `\n${path}\n`;
+  for (const [name, value] of Object.entries(headers)) {
+    netlify += `  ${name}: ${value}\n`;
+  }
+}
+writeFileSync(resolve(root, '_headers'), netlify);
+
+/* ---------------- nginx ---------------- */
+const esc = (v) => v.replace(/"/g, '\\"');
+let nginx = `# ${banner}\n# include this file inside the server {} block.\n\n`;
+for (const [name, value] of Object.entries(config.headers)) {
+  nginx += `add_header ${name} "${esc(value)}" always;\n`;
+}
+for (const [path, headers] of Object.entries(config.paths)) {
+  if (path.startsWith('$')) continue;
+  const locationPrefix = path.replace(/\*$/, '');
+  nginx += `\nlocation ${path.endsWith('*') ? '^~ ' : '= '}${locationPrefix} {\n`;
+  // nginx drops inherited add_header directives inside a location that sets
+  // its own, so repeat the global set here.
+  for (const [name, value] of Object.entries({ ...config.headers, ...headers })) {
+    nginx += `  add_header ${name} "${esc(value)}" always;\n`;
+  }
+  nginx += '}\n';
+}
+writeFileSync(resolve(root, 'config/nginx-headers.conf'), nginx);
+
+console.log('Wrote _headers and config/nginx-headers.conf');
diff --git a/scripts/privacy-audit.mjs b/scripts/privacy-audit.mjs
new file mode 100644
index 0000000..787f5c6
--- /dev/null
+++ b/scripts/privacy-audit.mjs
@@ -0,0 +1,221 @@
+#!/usr/bin/env node
+/**
+ * Privacy-by-design audit for The Daily Grind.
+ *
+ * Statically checks the markup, client scripts and header config against the
+ * rules in PRIVACY.md. Exits 1 on any failure so it can gate CI/deploys.
+ *
+ * Usage: node scripts/privacy-audit.mjs [--json]
+ */
+import { readFileSync, readdirSync, statSync, existsSync } from 'node:fs';
+import { dirname, extname, join, relative, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const SKIP_DIRS = new Set(['node_modules', '.git', 'dist', 'scripts']);
+
+const findings = [];
+const ok = [];
+const fail = (rule, file, detail) => findings.push({ level: 'error', rule, file, detail });
+const warn = (rule, file, detail) => findings.push({ level: 'warn', rule, file, detail });
+const pass = (rule, detail) => ok.push({ rule, detail });
+
+function walk(dir, out = []) {
+  for (const name of readdirSync(dir)) {
+    const full = join(dir, name);
+    if (SKIP_DIRS.has(name)) continue;
+    if (statSync(full).isDirectory()) walk(full, out);
+    else out.push(full);
+  }
+  return out;
+}
+
+const files = walk(root);
+const rel = (f) => relative(root, f);
+const html = files.filter((f) => extname(f) === '.html');
+const js = files.filter((f) => extname(f) === '.js' || extname(f) === '.mjs');
+const css = files.filter((f) => extname(f) === '.css');
+
+const thirdParties = JSON.parse(readFileSync(resolve(root, 'config/third-parties.json'), 'utf8'));
+const approvedOrigins = new Set((thirdParties.approved || []).map((t) => t.origin));
+const headerConfig = JSON.parse(readFileSync(resolve(root, 'config/security-headers.json'), 'utf8'));
+const headers = headerConfig.headers;
+
+/* ------------------------------------------------------------------ */
+/* 1. Third-party audit: every absolute URL must be ours or approved    */
+/* ------------------------------------------------------------------ */
+const URL_RE = /(?:https?:)?\/\/[a-z0-9.-]+\.[a-z]{2,}(?::\d+)?(?:\/[^\s"'()<>]*)?/gi;
+const DOC_ONLY = /^(?:https?:)?\/\/(?:developer\.mozilla\.org|web\.dev|www\.w3\.org|globalprivacycontrol\.org|owasp\.org|github\.com)/i;
+
+for (const file of [...html, ...css, ...js.filter((f) => !f.includes('privacy-audit'))]) {
+  const text = readFileSync(file, 'utf8');
+  const lines = text.split('\n');
+  lines.forEach((line, i) => {
+    const trimmed = line.trim();
+    const isComment = /^(\/\/|\*|\/\*|<!--|#)/.test(trimmed);
+    for (const m of line.matchAll(URL_RE)) {
+      const url = m[0].startsWith('//') ? 'https:' + m[0] : m[0];
+      let origin;
+      try { origin = new URL(url).origin; } catch { continue; }
+      if (approvedOrigins.has(origin)) continue;
+      if (isComment && DOC_ONLY.test(url)) continue;
+      if (isComment) { warn('third-party/comment', `${rel(file)}:${i + 1}`, `URL in comment: ${origin}`); continue; }
+      fail('third-party/unapproved', `${rel(file)}:${i + 1}`, `External origin ${origin} is not listed in config/third-parties.json`);
+    }
+  });
+}
+if (!findings.some((f) => f.rule === 'third-party/unapproved')) pass('third-party/unapproved', 'No unapproved external origins referenced');
+
+/* ------------------------------------------------------------------ */
+/* 2. Markup checks                                                     */
+/* ------------------------------------------------------------------ */
+for (const file of html) {
+  const text = readFileSync(file, 'utf8');
+  const f = rel(file);
+
+  if (/<script\b(?![^>]*\bsrc=)[^>]*>[\s\S]*?<\/script>/i.test(text)) fail('markup/inline-script', f, 'Inline <script> blocks defeat a strict CSP');
+  if (/<style\b[^>]*>[\s\S]*?<\/style>/i.test(text)) fail('markup/inline-style', f, 'Inline <style> blocks require style-src unsafe-inline');
+  if (/\sstyle\s*=\s*["']/i.test(text)) fail('markup/style-attr', f, 'Inline style="" attributes require style-src unsafe-inline');
+  if (/\son[a-z]+\s*=\s*["']/i.test(text)) fail('markup/inline-handler', f, 'Inline event handlers (onclick=…) defeat a strict CSP');
+  if (/javascript:/i.test(text)) fail('markup/javascript-url', f, 'javascript: URLs are blocked by CSP and are an XSS sink');
+
+  if (!/<meta\s+name=["']referrer["']\s+content=["'](no-referrer|same-origin|strict-origin|strict-origin-when-cross-origin)["']/i.test(text)) {
+    fail('markup/referrer-meta', f, 'Missing or weak <meta name="referrer">');
+  }
+  if (!/<meta\s+http-equiv=["']Content-Security-Policy["']/i.test(text)) warn('markup/csp-meta', f, 'No CSP <meta> fallback for hosts without header control');
+  if (!/rel=["'][^"']*privacy-policy[^"']*["']/i.test(text)) warn('markup/privacy-policy-rel', f, 'No rel="privacy-policy" link');
+
+  for (const m of text.matchAll(/<a\b[^>]*target=["']_blank["'][^>]*>/gi)) {
+    if (!/rel=["'][^"']*noopener/i.test(m[0]) || !/rel=["'][^"']*noreferrer/i.test(m[0])) fail('markup/blank-target', f, `target=_blank without noopener noreferrer: ${m[0]}`);
+  }
+
+  // Logout / destructive actions must not be GET links.
+  for (const m of text.matchAll(/<a\b[^>]*href=["'][^"']*\/(logout|signout|delete|remove)[^"']*["'][^>]*>/gi)) {
+    fail('markup/state-change-via-get', f, `State-changing action exposed as a GET link: ${m[0]}`);
+  }
+
+  // Forms: autocomplete off for sensitive fields; never GET for personal data.
+  for (const form of text.matchAll(/<form\b[^>]*>[\s\S]*?<\/form>/gi)) {
+    const html = form[0];
+    const method = (html.match(/method=["'](\w+)["']/i) || [])[1] || 'get';
+    const hasInput = /<(input|textarea|select)\b/i.test(html);
+    if (hasInput && method.toLowerCase() === 'get') fail('markup/form-get', f, 'Form with inputs submits via GET (data lands in URLs, logs and history)');
+    for (const input of html.matchAll(/<input\b[^>]*>/gi)) {
+      const tag = input[0];
+      const type = ((tag.match(/type=["'](\w+)["']/i) || [])[1] || 'text').toLowerCase();
+      const name = (tag.match(/name=["']([^"']+)["']/i) || [])[1] || '';
+      const sensitive = type === 'password' || /(card|cvv|cvc|ssn|passport|iban|otp|token)/i.test(name);
+      if (sensitive && !/autocomplete=["'](off|new-password|current-password|one-time-code)["']/i.test(tag)) {
+        fail('markup/sensitive-autocomplete', f, `Sensitive field "${name || type}" lacks an appropriate autocomplete attribute`);
+      }
+    }
+    if (hasInput && !/<a\b[^>]*privacy/i.test(html)) warn('markup/form-notice', f, 'Form collects data without an inline privacy notice link');
+  }
+
+  if (/<(iframe|embed|object)\b/i.test(text)) warn('markup/embeds', f, 'Embedded frames/objects can leak visitor data; confirm they are same-origin');
+  if (/<link\b[^>]*rel=["'](dns-prefetch|preconnect)["']/i.test(text)) fail('markup/preconnect', f, 'dns-prefetch/preconnect contacts third parties before any user action');
+}
+if (!findings.some((f) => f.rule.startsWith('markup/') && f.level === 'error')) pass('markup', 'No inline code, GET-based state changes, unsafe targets or leaky hints in HTML');
+
+/* ------------------------------------------------------------------ */
+/* 3. Client-side script checks                                        */
+/* ------------------------------------------------------------------ */
+const clientJs = js.filter((f) => f.includes(`${join('assets', 'js')}`));
+const BANNED = [
+  [/document\.cookie/, 'script/cookie', 'Client-side cookie access; cookies must be HttpOnly and set server-side'],
+  [/\blocalStorage\.(setItem|getItem)\b/, 'script/localstorage', 'localStorage persists indefinitely; use the expiring sessionStorage wrapper'],
+  [/\beval\s*\(|new\s+Function\s*\(/, 'script/eval', 'eval / Function constructor'],
+  [/\.innerHTML\s*=|\.outerHTML\s*=|insertAdjacentHTML|document\.write/, 'script/html-sink', 'HTML string sink; blocked by Trusted Types and an XSS vector'],
+  [/\b(fetch|XMLHttpRequest|sendBeacon|WebSocket|EventSource)\b/, 'script/network', 'Network call in client script; the privacy layer must not phone home'],
+  [/getContext\(\s*["'](2d|webgl2?|experimental-webgl)["']\s*\)|toDataURL|getBattery|enumerateDevices|AudioContext|getImageData|queryLocalFonts|RTCPeerConnection|deviceMemory|hardwareConcurrency/, 'script/fingerprinting', 'Fingerprinting-capable API'],
+  [/\bgeolocation\b/, 'script/geolocation', 'Geolocation access'],
+];
+for (const file of clientJs) {
+  const text = readFileSync(file, 'utf8');
+  text.split('\n').forEach((line, i) => {
+    const code = line.replace(/\/\/.*$/, '').replace(/\/\*.*?\*\//g, '');
+    if (/^\s*\*/.test(line)) return; // block-comment body
+    for (const [re, rule, why] of BANNED) {
+      if (re.test(code)) fail(rule, `${rel(file)}:${i + 1}`, why);
+    }
+  });
+  if (!/['"]use strict['"]/.test(text)) warn('script/strict', rel(file), 'Script does not opt into strict mode');
+}
+if (!findings.some((f) => f.rule.startsWith('script/') && f.level === 'error')) pass('script', `No cookies, localStorage, eval, HTML sinks, network calls or fingerprinting APIs in ${clientJs.length} client script(s)`);
+
+/* ------------------------------------------------------------------ */
+/* 4. Security header checks                                           */
+/* ------------------------------------------------------------------ */
+const REQUIRED = {
+  'Content-Security-Policy': (v) => /default-src 'none'|default-src 'self'/.test(v) && /frame-ancestors/.test(v) && /object-src 'none'/.test(v) && /base-uri/.test(v) && /form-action/.test(v),
+  'Referrer-Policy': (v) => /^(no-referrer|same-origin|strict-origin|strict-origin-when-cross-origin)$/.test(v),
+  'Permissions-Policy': (v) => /geolocation=\(\)/.test(v) && /camera=\(\)/.test(v) && /microphone=\(\)/.test(v) && /interest-cohort=\(\)/.test(v) && /browsing-topics=\(\)/.test(v),
+  'Strict-Transport-Security': (v) => /max-age=(\d+)/.test(v) && Number(v.match(/max-age=(\d+)/)[1]) >= 31536000,
+  'X-Content-Type-Options': (v) => v === 'nosniff',
+  'X-Frame-Options': (v) => /^(DENY|SAMEORIGIN)$/.test(v),
+  'Cross-Origin-Opener-Policy': (v) => /same-origin/.test(v),
+  'Cross-Origin-Resource-Policy': (v) => /same-origin|same-site/.test(v),
+};
+for (const [name, check] of Object.entries(REQUIRED)) {
+  if (!(name in headers)) fail('headers/missing', 'config/security-headers.json', `Missing ${name}`);
+  else if (!check(headers[name])) fail('headers/weak', 'config/security-headers.json', `${name} is weaker than policy: ${headers[name]}`);
+}
+const csp = headers['Content-Security-Policy'] || '';
+if (/unsafe-inline|unsafe-eval|unsafe-hashes/.test(csp)) fail('headers/csp-unsafe', 'config/security-headers.json', 'CSP contains an unsafe-* keyword');
+if (/\s\*(\s|;|$)|https:(\s|;)/.test(csp)) fail('headers/csp-wildcard', 'config/security-headers.json', 'CSP allows wildcard or scheme-wide sources');
+for (const m of csp.matchAll(/https?:\/\/[^\s;]+/g)) {
+  let origin; try { origin = new URL(m[0]).origin; } catch { continue; }
+  if (!approvedOrigins.has(origin)) fail('headers/csp-unapproved-origin', 'config/security-headers.json', `CSP allows ${origin} which is not in config/third-parties.json`);
+}
+if (!headers['Cache-Control'] || !/no-store/.test(headers['Cache-Control'])) warn('headers/cache', 'config/security-headers.json', 'HTML responses should be no-store so personalised pages are never cached');
+if (!headerConfig.paths?.['/logout']?.['Clear-Site-Data']) warn('headers/clear-site-data', 'config/security-headers.json', '/logout should send Clear-Site-Data');
+
+// Meta fallbacks in HTML must not be *weaker* than the headers.
+for (const file of html) {
+  const text = readFileSync(file, 'utf8');
+  const metaCsp = (text.match(/http-equiv=["']Content-Security-Policy["']\s+content=(["'])([^]*?)\1/i) || [])[2];
+  if (metaCsp) {
+    const headerDirectives = new Set(csp.split(';').map((d) => d.trim()).filter(Boolean));
+    const metaDirectives = metaCsp.split(';').map((d) => d.trim()).filter(Boolean);
+    const META_UNSUPPORTED = /^(frame-ancestors|report-uri|report-to|sandbox|upgrade-insecure-requests)\b/;
+    for (const d of metaDirectives) if (!headerDirectives.has(d)) fail('headers/meta-drift', rel(file), `Meta CSP directive "${d}" differs from config/security-headers.json`);
+    for (const d of headerDirectives) if (!META_UNSUPPORTED.test(d) && !metaDirectives.includes(d)) fail('headers/meta-drift', rel(file), `Header CSP directive "${d}" missing from <meta> fallback`);
+  }
+  const metaRef = (text.match(/<meta\s+name=["']referrer["']\s+content=["']([^"']+)["']/i) || [])[1];
+  if (metaRef && headers['Referrer-Policy'] && metaRef !== headers['Referrer-Policy']) fail('headers/meta-drift', rel(file), `Meta referrer "${metaRef}" differs from Referrer-Policy header "${headers['Referrer-Policy']}"`);
+}
+// Generated artefacts must be current.
+if (existsSync(resolve(root, '_headers'))) {
+  const generated = readFileSync(resolve(root, '_headers'), 'utf8');
+  for (const [name, value] of Object.entries(headers)) {
+    if (!generated.includes(`${name}: ${value}`)) fail('headers/stale-artifact', '_headers', `Out of date for ${name}; run npm run build:headers`);
+  }
+} else warn('headers/no-artifact', '_headers', 'Run npm run build:headers to generate host configs');
+if (!findings.some((f) => f.rule.startsWith('headers/') && f.level === 'error')) pass('headers', 'Header set complete, CSP strict, meta fallbacks in sync, artefacts current');
+
+/* ------------------------------------------------------------------ */
+/* 5. Data minimisation in shipped assets                              */
+/* ------------------------------------------------------------------ */
+for (const file of files.filter((f) => /\.(jpe?g|png|webp|gif|tiff?)$/i.test(f))) {
+  const buf = readFileSync(file);
+  const head = buf.subarray(0, Math.min(buf.length, 256 * 1024)).toString('latin1');
+  if (/Exif\0\0|http:\/\/ns\.adobe\.com\/xap\/1\.0\//.test(head)) fail('assets/metadata', rel(file), 'Image carries EXIF/XMP metadata (may include GPS, device and author data); strip it');
+}
+if (!findings.some((f) => f.rule === 'assets/metadata')) pass('assets', 'Shipped images carry no EXIF/XMP metadata');
+if (!existsSync(resolve(root, '.well-known/gpc.json'))) warn('gpc/missing', '.well-known/gpc.json', 'Publish GPC support declaration');
+
+/* ------------------------------------------------------------------ */
+/* Report                                                               */
+/* ------------------------------------------------------------------ */
+const errors = findings.filter((f) => f.level === 'error');
+const warnings = findings.filter((f) => f.level === 'warn');
+if (process.argv.includes('--json')) {
+  console.log(JSON.stringify({ errors, warnings, passed: ok }, null, 2));
+} else {
+  console.log('Privacy audit – The Daily Grind\n');
+  for (const p of ok) console.log(`  PASS  ${p.rule.padEnd(34)} ${p.detail}`);
+  for (const w of warnings) console.log(`  WARN  ${w.rule.padEnd(34)} ${w.file}: ${w.detail}`);
+  for (const e of errors) console.log(`  FAIL  ${e.rule.padEnd(34)} ${e.file}: ${e.detail}`);
+  console.log(`\n${ok.length} passed, ${warnings.length} warning(s), ${errors.length} error(s)`);
+}
+process.exit(errors.length ? 1 : 0);
diff --git a/scripts/serve.mjs b/scripts/serve.mjs
new file mode 100644
index 0000000..6b314f4
--- /dev/null
+++ b/scripts/serve.mjs
@@ -0,0 +1,31 @@
+#!/usr/bin/env node
+/**
+ * Local static server wrapper. statikk only exposes --csp and --coi, so this
+ * passes those from config/security-headers.json; the remaining headers are
+ * applied by the production host via `_headers` / nginx (see build-headers).
+ * The <meta> fallbacks in index.html cover Referrer-Policy and CSP locally.
+ *
+ * Usage: npm start  (PORT env var optional)
+ */
+import { readFileSync } from 'node:fs';
+import { spawn } from 'node:child_process';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const { headers } = JSON.parse(readFileSync(resolve(root, 'config/security-headers.json'), 'utf8'));
+
+// Header-only directives that make no sense on plain-http localhost.
+const csp = headers['Content-Security-Policy']
+  .split(';')
+  .map((d) => d.trim())
+  .filter((d) => d && d !== 'upgrade-insecure-requests')
+  .join('; ');
+
+const args = ['dlx', 'statikk', '--port', process.env.PORT || '11222', '--csp', csp];
+if (headers['Cross-Origin-Opener-Policy'] === 'same-origin' && headers['Cross-Origin-Embedder-Policy'] === 'require-corp') {
+  args.push('--coi');
+}
+
+const child = spawn('pnpm', args, { cwd: root, stdio: 'inherit' });
+child.on('exit', (code) => process.exit(code ?? 0));
