+      } catch (_) {
+        s.removeItem(CONFIG.storagePrefix + key);
+        return undefined;
+      }
+    },
+    remove: function (key) {
+      var s = storageBackend();
+      if (s) s.removeItem(CONFIG.storagePrefix + key);
+    },
+    /** Remove everything this site has stored in the browser. */
+    clear: function () {
+      try {
+        [window.sessionStorage, window.localStorage].forEach(function (s) {
+          if (!s) return;
+          var doomed = [];
+          for (var i = 0; i < s.length; i++) {
+            var k = s.key(i);
+            if (k && k.indexOf(CONFIG.storagePrefix) === 0) doomed.push(k);
