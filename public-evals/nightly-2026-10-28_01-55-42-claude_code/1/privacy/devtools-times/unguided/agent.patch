diff --git a/src/utils/consent.ts b/src/utils/consent.ts
new file mode 100644
index 0000000..23358e3
--- /dev/null
+++ b/src/utils/consent.ts
@@ -0,0 +1,85 @@
+import { ANALYTICS_SCRIPT_URL, CONSENT_STORAGE_KEY, CONSENT_VERSION } from '../config/privacy';
+
+export interface ConsentState {
+  version: number;
+  /** Opt-in for the third-party click-analytics script. Default: false (nothing loads). */
+  analytics: boolean;
+  /** ISO timestamp of the last change, so the choice can be shown back to the visitor. */
+  updatedAt: string;
+}
+
+/** Fired on `window` whenever the visitor saves a choice. `detail` is the new ConsentState. */
+export const CONSENT_CHANGE_EVENT = 'devtools-times:consent-change';
+/** Dispatch on `window` to reopen the privacy preferences dialog from anywhere. */
+export const OPEN_PREFERENCES_EVENT = 'devtools-times:open-privacy-preferences';
+
+/** Returns the stored choice, or null when the visitor has not decided yet (or storage is unavailable). */
+export function readConsent(): ConsentState | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = window.localStorage.getItem(CONSENT_STORAGE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as Partial<ConsentState>;
+    if (parsed.version !== CONSENT_VERSION || typeof parsed.analytics !== 'boolean') return null;
+    return {
+      version: CONSENT_VERSION,
+      analytics: parsed.analytics,
+      updatedAt: typeof parsed.updatedAt === 'string' ? parsed.updatedAt : '',
+    };
+  } catch {
+    return null;
+  }
+}
+
+/** Persists the choice and notifies listeners. Only the choice itself is stored, no identifier. */
+export function writeConsent(analytics: boolean): ConsentState {
+  const state: ConsentState = {
+    version: CONSENT_VERSION,
+    analytics,
+    updatedAt: new Date().toISOString(),
+  };
+  try {
+    window.localStorage.setItem(CONSENT_STORAGE_KEY, JSON.stringify(state));
+  } catch {
+    // Storage blocked (private mode, policy). The choice then only lasts for this page view,
+    // which still errs on the side of not tracking.
+  }
+  window.dispatchEvent(new CustomEvent<ConsentState>(CONSENT_CHANGE_EVENT, { detail: state }));
+  return state;
+}
+
+/** Forgets the stored choice. The visitor will be asked again on the next page load. */
+export function clearConsent(): void {
+  try {
+    window.localStorage.removeItem(CONSENT_STORAGE_KEY);
+  } catch {
+    // ignore
+  }
+}
+
+export function isAnalyticsLoaded(): boolean {
+  return typeof window !== 'undefined' && window.__devtoolsTimesAnalyticsLoaded === true;
+}
+
+/**
+ * Injects the third-party analytics script. Call ONLY after the visitor opted in.
+ *
+ * Idempotent on purpose: Astro's <ClientRouter /> keeps `window`/`document` alive across
+ * navigations and the script registers a document-level click listener, so loading it a
+ * second time would double-report every click.
+ */
+export function loadAnalyticsScript(): void {
+  if (typeof document === 'undefined' || isAnalyticsLoaded()) return;
+  window.__devtoolsTimesAnalyticsLoaded = true;
+
+  const script = document.createElement('script');
+  script.src = ANALYTICS_SCRIPT_URL;
+  script.defer = true;
+  // Do not tell the analytics host which page the visitor is on when fetching the script.
+  script.referrerPolicy = 'no-referrer';
+  // Deliberately no `crossOrigin = 'anonymous'`: the host only returns CORS headers for an
+  // allow-list of deployment origins (not localhost), so the script would fail to load there.
+  // Without it the browser may send cookies it holds for that host; the page itself sets none.
+  script.dataset.consentCategory = 'analytics';
+  document.head.appendChild(script);
+}
