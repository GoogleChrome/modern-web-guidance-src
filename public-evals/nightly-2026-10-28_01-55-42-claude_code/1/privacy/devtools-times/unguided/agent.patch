+/**
+ * Privacy-related response headers for every document and API response.
+ *
+ * - Referrer-Policy: other origins only ever learn our origin, never which article a
+ *   visitor was reading. Mirrored by <meta name="referrer"> in src/layouts/Layout.astro.
+ * - Permissions-Policy: this site never needs these powerful features, and disabling
+ *   `browsing-topics` opts every page out of Chrome's Topics API interest profiling.
+ * - X-Content-Type-Options: no MIME sniffing of responses.
+ */
+const PRIVACY_HEADERS: Record<string, string> = {
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy':
+    'browsing-topics=(), camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+  'X-Content-Type-Options': 'nosniff',
+};
+
+export const onRequest = defineMiddleware(async (_context, next) => {
+  // Data minimisation: no session cookie is created just for visiting the site.
+  // The reading-list session is only written when a visitor bookmarks an article
+  // (src/pages/api/reading-list.json.ts); every reader falls back to an empty list.
+  const response = await next();
