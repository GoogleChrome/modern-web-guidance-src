diff --git a/src/components/PrivacyConsent.tsx b/src/components/PrivacyConsent.tsx
new file mode 100644
index 0000000..3b84c1a
--- /dev/null
+++ b/src/components/PrivacyConsent.tsx
@@ -0,0 +1,125 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import { ANALYTICS_HOST } from '../config/privacy';
+import {
+  OPEN_PREFERENCES_EVENT,
+  isAnalyticsLoaded,
+  loadAnalyticsScript,
+  readConsent,
+  writeConsent,
+} from '../utils/consent';
+
+interface Props {
+  privacyPolicyUrl: string;
+}
+
+/**
+ * Consent gate for every third-party script on the site.
+ *
+ * Privacy by design: nothing is loaded until the visitor actively chooses. Both choices
+ * are equally prominent, "decline" is a first-class action and the dialog explains in
+ * plain words what is collected and where it goes. The choice can be revisited at any
+ * time through the "Manage Privacy Preferences" link in the footer.
+ */
+export default function PrivacyConsent({ privacyPolicyUrl }: Props) {
+  const [open, setOpen] = useState(false);
+  const [hasChoice, setHasChoice] = useState(false);
+  const [analytics, setAnalytics] = useState(false);
+
+  useEffect(() => {
+    const stored = readConsent();
+    if (stored) {
+      setHasChoice(true);
+      setAnalytics(stored.analytics);
+      if (stored.analytics) loadAnalyticsScript();
+    } else {
+      setOpen(true);
+    }
+
+    const openPreferences = () => {
+      const current = readConsent();
+      setHasChoice(current !== null);
+      setAnalytics(current?.analytics ?? false);
+      setOpen(true);
+    };
+
+    // The footer link is static Astro markup, so listen for it here instead of wiring props.
+    const onDocumentClick = (event: MouseEvent) => {
+      const target = event.target as Element | null;
+      if (target?.closest('[data-open-privacy-preferences]')) {
+        event.preventDefault();
+        openPreferences();
+      }
+    };
+
+    window.addEventListener(OPEN_PREFERENCES_EVENT, openPreferences);
+    document.addEventListener('click', onDocumentClick);
+    return () => {
+      window.removeEventListener(OPEN_PREFERENCES_EVENT, openPreferences);
+      document.removeEventListener('click', onDocumentClick);
+    };
+  }, []);
+
+  const save = useCallback((allowAnalytics: boolean) => {
+    const wasLoaded = isAnalyticsLoaded();
+    writeConsent(allowAnalytics);
+    setHasChoice(true);
+    setAnalytics(allowAnalytics);
+    setOpen(false);
+
+    if (allowAnalytics) {
+      loadAnalyticsScript();
+    } else if (wasLoaded) {
+      // The third-party script cannot be unloaded once it has attached its listeners,
+      // so reloading is the only way to honour the withdrawal immediately.
+      window.location.reload();
+    }
+  }, []);
+
+  if (!open) return null;
+
+  const buttonClass =
+    'rounded border border-gray-900 px-4 py-2 text-sm font-semibold text-gray-900 bg-white hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900';
+
+  return (
+    <section
+      role="dialog"
+      aria-labelledby="privacy-consent-title"
+      aria-describedby="privacy-consent-description"
+      className="fixed inset-x-0 bottom-0 z-[60] border-t border-gray-300 bg-white shadow-[0_-4px_12px_rgba(0,0,0,0.08)]"
+    >
+      <div className="mx-auto max-w-6xl px-4 py-4 md:flex md:items-start md:justify-between md:gap-8">
+        <div className="text-sm text-gray-700">
+          <h2 id="privacy-consent-title" className="text-base font-bold text-gray-900">
+            Your privacy choices
+          </h2>
+          <p id="privacy-consent-description" className="mt-1">
+            The DevTools Times works without tracking. Reading, searching and bookmarking only use a
+            first-party session cookie. If you allow it, we additionally load a third-party analytics
+            script that records the text of the links and buttons you click, together with a timestamp,
+            and sends it to <span className="font-mono">{ANALYTICS_HOST}</span>. Nothing is loaded until
+            you choose.
+          </p>
+          <p className="mt-1 text-xs text-gray-500">
+            {hasChoice && (
+              <>
+                Current setting: analytics {analytics ? 'allowed' : 'declined'}.{' '}
+              </>
+            )}
+            You can change your choice at any time via “Manage Privacy Preferences” in the footer.{' '}
+            <a href={privacyPolicyUrl} className="underline hover:text-gray-900" data-skip-tracking="true">
+              Privacy Policy
+            </a>
+          </p>
+        </div>
+        <div className="mt-3 flex shrink-0 gap-2 md:mt-0">
+          <button type="button" onClick={() => save(false)} className={buttonClass} data-skip-tracking="true">
+            Continue without analytics
+          </button>
+          <button type="button" onClick={() => save(true)} className={buttonClass} data-skip-tracking="true">
+            Allow analytics
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
