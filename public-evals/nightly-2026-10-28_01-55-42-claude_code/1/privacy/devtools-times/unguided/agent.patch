diff --git a/src/config/privacy.ts b/src/config/privacy.ts
new file mode 100644
index 0000000..d4e9368
--- /dev/null
+++ b/src/config/privacy.ts
@@ -0,0 +1,44 @@
+/**
+ * Single source of truth for every remote endpoint and third-party resource the
+ * browser may contact. Keeping them here makes the site's data flows auditable,
+ * and the Privacy Policy (src/pages/legal/privacy.astro) must stay in sync with it.
+ */
+
+/**
+ * Authentication API used by the sign-in and sign-up forms.
+ * Receives exactly two fields: username and password. Nothing else is sent.
+ * Override with PUBLIC_AUTH_API_BASE_URL at build time if the backend moves.
+ */
+export const AUTH_API_BASE_URL: string =
+  import.meta.env.PUBLIC_AUTH_API_BASE_URL ??
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+/** Human-readable host shown to users in the sign-in / sign-up privacy notice. */
+export const AUTH_API_HOST: string = new URL(AUTH_API_BASE_URL).host;
+
+/**
+ * Third-party click-analytics script.
+ * It is NEVER referenced from the HTML. It is injected at runtime by
+ * src/utils/consent.ts only after the visitor has explicitly opted in.
+ *
+ * What it does (audited 2026-10-28): registers a document-wide click listener and
+ * POSTs { tag, text, timestamp } of every clicked link/button to <origin>/api/analytics.
+ */
+export const ANALYTICS_SCRIPT_URL =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+/** Host shown to users when describing where analytics data goes. */
+export const ANALYTICS_HOST: string = new URL(ANALYTICS_SCRIPT_URL).host;
+
+/**
+ * Third-party ad client. Currently disabled. If it is ever re-enabled it must be
+ * loaded through the same consent gate as the analytics script, never from <head>.
+ */
+// export const AD_CLIENT_SCRIPT_URL =
+//   'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/ad-client.js';
+
+/** localStorage key holding the visitor's consent choice (no identifier, only the choice). */
+export const CONSENT_STORAGE_KEY = 'devtools-times.privacy-consent';
+
+/** Bump when the meaning of a consent category changes so visitors are asked again. */
+export const CONSENT_VERSION = 1;
