diff --git a/src/components/PrivacyConsent.astro b/src/components/PrivacyConsent.astro
new file mode 100644
index 0000000..7f9095b
--- /dev/null
+++ b/src/components/PrivacyConsent.astro
@@ -0,0 +1,194 @@
+---
+/**
+ * Privacy preferences banner + the only place third-party scripts are loaded.
+ *
+ * Privacy by design:
+ *  - Nothing third-party runs until the visitor explicitly opts in.
+ *  - The choice is stored only in the browser (localStorage), never sent to a server.
+ *  - Pages that handle sensitive data (sign-in / sign-up) pass allowThirdParty={false}
+ *    and never load third-party scripts, regardless of the stored preference.
+ *  - "Keep analytics off" and "Allow analytics" have equal prominence (no dark patterns).
+ *
+ * The optional analytics client records the tag name and visible text of clicked
+ * links/buttons plus a timestamp and posts it to the analytics provider. Elements with
+ * `data-skip-tracking` are ignored by it.
+ *
+ * If the ad client is ever re-enabled it must be added to THIRD_PARTY_SCRIPTS below so
+ * it goes through the same consent gate:
+ *   https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/ad-client.js
+ */
+export interface Props {
+  allowThirdParty?: boolean;
+}
+
+const { allowThirdParty = true } = Astro.props;
+const baseUrl = import.meta.env.BASE_URL;
+
+const THIRD_PARTY_SCRIPTS = [
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js',
+];
+---
+
+<section
+  data-privacy-consent
+  data-allow-third-party={allowThirdParty ? 'true' : 'false'}
+  data-third-party-scripts={JSON.stringify(THIRD_PARTY_SCRIPTS)}
+  hidden
+  role="region"
+  aria-labelledby="privacy-consent-title"
+  tabindex="-1"
+  class="fixed inset-x-0 bottom-0 z-[9999] border-t border-gray-300 bg-white p-4 text-sm text-gray-800 shadow-[0_-4px_12px_rgba(0,0,0,0.08)]"
+>
+  <div class="mx-auto flex max-w-6xl flex-col gap-3 md:flex-row md:items-center md:justify-between">
+    <div class="space-y-1">
+      <p id="privacy-consent-title" class="font-semibold">Your privacy choices</p>
+      <p class="text-gray-600">
+        We don't track you by default. If you allow it, we record which links and buttons you
+        click (the element's text and a timestamp, nothing else) and send that to our analytics
+        provider hosted on Google Cloud so we can see how the site is used. You can change your
+        mind at any time via <strong>Manage Privacy Preferences</strong> in the footer.
+        <a href={`${baseUrl}legal/privacy`} class="underline hover:text-amber-700" data-skip-tracking="true">Privacy Policy</a>
+      </p>
+    </div>
+    <div class="flex shrink-0 gap-2">
+      <button
+        type="button"
+        data-consent-choice="denied"
+        data-skip-tracking="true"
+        class="rounded border border-gray-800 px-4 py-2 text-xs font-semibold text-gray-800 hover:bg-gray-100"
+      >
+        Keep analytics off
+      </button>
+      <button
+        type="button"
+        data-consent-choice="granted"
+        data-skip-tracking="true"
+        class="rounded border border-gray-800 bg-gray-800 px-4 py-2 text-xs font-semibold text-white hover:bg-gray-700"
+      >
+        Allow analytics
+      </button>
+    </div>
+  </div>
+</section>
+
+<script>
+  type Consent = 'granted' | 'denied';
+
+  // Preference lives only in this browser. It is not a cookie, so it is never sent to a server.
+  const STORAGE_KEY = 'devtools-times:analytics-consent';
+
+  // Module state survives client-side (view transition) navigations within one document,
+  // which is exactly the lifetime of any script we inject.
+  let thirdPartyLoaded = false;
+
+  function readConsent(): Consent | null {
+    try {
+      const value = localStorage.getItem(STORAGE_KEY);
+      return value === 'granted' || value === 'denied' ? value : null;
+    } catch {
+      return null;
+    }
+  }
+
+  function writeConsent(value: Consent) {
+    try {
+      localStorage.setItem(STORAGE_KEY, value);
+    } catch {
+      // Storage unavailable (private mode, blocked): the banner will simply show again next time.
+    }
+  }
+
+  function getHost(): HTMLElement | null {
+    return document.querySelector<HTMLElement>('[data-privacy-consent]');
+  }
+
+  function loadThirdPartyScripts(host: HTMLElement) {
+    if (thirdPartyLoaded) return;
+    thirdPartyLoaded = true;
+
+    let sources: string[] = [];
+    try {
+      sources = JSON.parse(host.dataset.thirdPartyScripts ?? '[]');
+    } catch {
+      return;
+    }
+
+    for (const src of sources) {
+      const script = document.createElement('script');
+      script.src = src;
+      script.defer = true;
+      // Never tell the third party which page the visitor is on.
+      script.referrerPolicy = 'no-referrer';
+      // No `integrity`: the vendor URL is mutable (unversioned), so SRI would break on every
+      // vendor update. No `crossorigin`: the endpoint sends no CORS headers, so an anonymous
+      // CORS fetch would be blocked by the browser.
+      document.head.append(script);
+    }
+  }
+
+  function applyPreference() {
+    const host = getHost();
+    if (!host) return;
+
+    const allowThirdParty = host.dataset.allowThirdParty === 'true';
+    const consent = readConsent();
+
+    // Sensitive pages are always served clean. If a script slipped in earlier in this
+    // document (e.g. via back/forward navigation), do a full reload to drop it.
+    if (!allowThirdParty && thirdPartyLoaded) {
+      location.reload();
+      return;
+    }
+
+    host.hidden = consent !== null;
+
+    if (consent === 'granted' && allowThirdParty) {
+      loadThirdPartyScripts(host);
+    }
+  }
+
+  function openPreferences() {
+    const host = getHost();
+    if (!host) return;
+    host.hidden = false;
+    host.focus();
+  }
+
+  function choose(choice: Consent) {
+    const host = getHost();
+    writeConsent(choice);
+    if (host) host.hidden = true;
+
+    if (choice === 'denied' && thirdPartyLoaded) {
+      // The analytics client attaches document-level listeners that cannot be
+      // removed from here; a reload guarantees nothing keeps running.
+      location.reload();
+      return;
+    }
+    applyPreference();
+  }
+
+  // One delegated listener for the whole document: works for the banner buttons and for
+  // the "Manage Privacy Preferences" control in the footer, across client-side navigations.
+  document.addEventListener('click', (event) => {
+    const target = (event.target as Element | null)?.closest<HTMLElement>(
+      '[data-consent-choice], [data-open-privacy-preferences]',
+    );
+    if (!target) return;
+
+    if (target.hasAttribute('data-open-privacy-preferences')) {
+      event.preventDefault();
+      openPreferences();
+      return;
+    }
+
+    const choice = target.dataset.consentChoice;
+    if (choice === 'granted' || choice === 'denied') {
+      choose(choice);
+    }
+  });
+
+  // Runs on initial load and after every <ClientRouter /> navigation.
+  document.addEventListener('astro:page-load', applyPreference);
+  applyPreference();
+</script>
