--- /dev/null
+++ b/test/note-envelope.test.mjs
@@ -0,0 +1,113 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  SUITES,
+  detectBestSuite,
+  generateRecipientKeys,
+  seal,
+  open,
+  fingerprint,
+  toBase64,
+  fromBase64,
+} from '../js/note-envelope.js';
+
+const supports = (...args) => {
+  try {
+    return typeof SubtleCrypto?.supports === 'function' && SubtleCrypto.supports(...args);
+  } catch {
+    return false;
+  }
+};
+
+const available = {
+  'pq-hybrid-native': supports('encapsulateKey', 'MLKEM768-X25519', 'HKDF'),
+  'pq-hybrid-composed': supports('encapsulateBits', 'ML-KEM-768') && supports('generateKey', 'X25519'),
+  'classical-x25519': supports('generateKey', 'X25519'),
+  'classical-p256': true,
+};
+
+const tamperBase64 = (b64, index = 3) => {
+  const bytes = fromBase64(b64);
+  bytes[index] ^= 0x01;
+  return toBase64(bytes);
+};
+
+test('detectBestSuite returns a known suite', async () => {
+  const suite = await detectBestSuite();
+  assert.ok(SUITES[suite], `unknown suite ${suite}`);
+  console.log(`    runtime best suite: ${suite}`);
+});
+
+test('base64 helpers round-trip arbitrary bytes', () => {
+  const bytes = crypto.getRandomValues(new Uint8Array(1000));
+  assert.deepEqual(fromBase64(toBase64(bytes)), bytes);
+});
+
+test('fingerprint is 8 groups of 4 hex digits', async () => {
+  const fp = await fingerprint(new Uint8Array([1, 2, 3]));
+  assert.match(fp, /^([0-9a-f]{4} ){7}[0-9a-f]{4}$/);
+});
+
+for (const suiteId of Object.keys(SUITES)) {
+  test(`${suiteId}: encrypt/decrypt round trip and tamper rejection`, { skip: !available[suiteId] && `${suiteId} not supported by this runtime` }, async () => {
+    const suite = SUITES[suiteId];
+    const courier = await generateRecipientKeys(suiteId);
+    assert.equal(courier.publicKeyBytes.byteLength, suite.publicKeyBytes);
+
+    const note = 'Gate code 4471#, leave at side door. Severe peanut allergy — no cross-contact please. ☕';
+    const envelope = await seal(suiteId, courier.publicKeyBytes, note, { orderId: 'DG-48213' });
+
+    assert.equal(envelope.v, 1);
+    assert.equal(envelope.suite, suiteId);
+    assert.equal(envelope.orderId, 'DG-48213');
+    assert.equal(fromBase64(envelope.capsule).byteLength, suite.capsuleBytes);
+    assert.equal(fromBase64(envelope.iv).byteLength, 12);
+    // AES-GCM appends a 16-byte tag.
+    assert.equal(fromBase64(envelope.ciphertext).byteLength, new TextEncoder().encode(note).byteLength + 16);
+    assert.equal(JSON.parse(JSON.stringify(envelope)).ciphertext, envelope.ciphertext, 'envelope is JSON-safe');
+
+    assert.equal(await open(courier.privateMaterial, envelope), note);
+
+    // Fresh randomness per message: same note yields different capsule, IV and ciphertext.
+    const again = await seal(suiteId, courier.publicKeyBytes, note, { orderId: 'DG-48213' });
+    assert.notEqual(again.capsule, envelope.capsule);
+    assert.notEqual(again.iv, envelope.iv);
+    assert.notEqual(again.ciphertext, envelope.ciphertext);
+
+    // Tampering with any part is detected.
+    await assert.rejects(open(courier.privateMaterial, { ...envelope, ciphertext: tamperBase64(envelope.ciphertext) }), /Authentication failed/);
+    await assert.rejects(open(courier.privateMaterial, { ...envelope, iv: tamperBase64(envelope.iv) }), /Authentication failed/);
+    await assert.rejects(open(courier.privateMaterial, { ...envelope, orderId: 'DG-00000' }), /Authentication failed/);
+    await assert.rejects(open(courier.privateMaterial, { ...envelope, createdAt: '1999-01-01T00:00:00.000Z' }), /Authentication failed/);
+    await assert.rejects(open(courier.privateMaterial, { ...envelope, capsule: tamperBase64(envelope.capsule) }), /Authentication failed/);
+    await assert.rejects(open(courier.privateMaterial, { ...envelope, capsule: envelope.capsule.slice(0, -8) }), /capsule must be/);
+    await assert.rejects(open(courier.privateMaterial, { ...envelope, v: 2 }), /Unsupported envelope version/);
+
+    // A different courier key cannot open it.
+    const other = await generateRecipientKeys(suiteId);
+    await assert.rejects(open(other.privateMaterial, envelope), /Authentication failed/);
+
+    // Suite confusion is rejected before any crypto runs.
+    await assert.rejects(open({ ...courier.privateMaterial, suite: 'nope' }, envelope), /suite/);
+
+    // Private keys never leave the crypto implementation.
+    for (const value of Object.values(courier.privateMaterial)) {
+      if (value && typeof value === 'object' && 'privateKey' in value) {
+        assert.equal(value.privateKey.extractable, false);
+      }
+    }
+  });
+}
+
+test('composed hybrid: tampering with only the X25519 half of the capsule is rejected', { skip: !available['pq-hybrid-composed'] }, async () => {
+  const courier = await generateRecipientKeys('pq-hybrid-composed');
+  const envelope = await seal('pq-hybrid-composed', courier.publicKeyBytes, 'hello', { orderId: 'X' });
+  const capsule = fromBase64(envelope.capsule);
+  capsule[capsule.length - 1] ^= 0x80; // flip a bit in the ephemeral X25519 public key
+  await assert.rejects(open(courier.privateMaterial, { ...envelope, capsule: toBase64(capsule) }), /Authentication failed/);
+});
+
+test('seal rejects wrong-size public keys', async () => {
+  await assert.rejects(seal('classical-p256', new Uint8Array(32), 'x'), /must be 65 bytes/);
+  await assert.rejects(seal('bogus', new Uint8Array(32), 'x'), /Unknown suite/);
+});
