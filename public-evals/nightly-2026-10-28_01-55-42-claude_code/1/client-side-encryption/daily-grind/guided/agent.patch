index 0000000..e09a750
--- /dev/null
+++ b/js/note-envelope.js
@@ -0,0 +1,406 @@
+/**
+ * Envelope encryption for Daily Grind delivery notes.
+ *
+ * A customer's note is encrypted in the browser to the courier's public key so
+ * only the courier's device can read it. Every envelope is produced by:
+ *
+ *   1. Establishing a fresh shared secret with the courier's public key, using
+ *      the strongest mechanism the runtime offers (see SUITES below):
+ *        - the hybrid post-quantum KEM 'MLKEM768-X25519' (FIPS 203 ML-KEM-768
+ *          combined with classical X25519) via SubtleCrypto.encapsulateKey(),
+ *        - or the same hybrid composed by hand from standalone 'ML-KEM-768'
+ *          encapsulation plus ephemeral-static X25519 key agreement,
+ *        - or classical ephemeral-static key agreement alone (X25519, then
+ *          ECDH P-256 for older browsers).
+ *   2. Running that secret through HKDF-SHA-256 with a context string so the
+ *      AEAD key is bound to this protocol and suite.
+ *   3. Encrypting with AES-256-GCM using a fresh 96-bit IV, with the envelope
+ *      header (version, suite, order id, timestamp) as additional
+ *      authenticated data so any tampering fails decryption.
+ *
+ * The module only uses globalThis.crypto, so it runs unchanged in browsers and
+ * Node for testing.
+ */
+
+const CONTEXT = 'daily-grind/delivery-note/v1';
+const ENVELOPE_VERSION = 1;
+const IV_BYTES = 12;
+
+const ML_KEM_768_PUBLIC_BYTES = 1184;
+const ML_KEM_768_CIPHERTEXT_BYTES = 1088;
+const X25519_PUBLIC_BYTES = 32;
+const P256_PUBLIC_BYTES = 65;
+
+export const SUITES = Object.freeze({
+  'pq-hybrid-native': Object.freeze({
+    id: 'pq-hybrid-native',
+    label: 'Hybrid post-quantum (ML-KEM-768 + X25519 KEM) → HKDF-SHA-256 → AES-256-GCM',
+    short: 'ML-KEM-768 + X25519',
+    postQuantum: true,
+    publicKeyBytes: 1216,
+    capsuleBytes: 1120,
+  }),
+  'pq-hybrid-composed': Object.freeze({
+    id: 'pq-hybrid-composed',
+    label: 'Hybrid post-quantum (ML-KEM-768 encapsulation + X25519 agreement) → HKDF-SHA-256 → AES-256-GCM',
+    short: 'ML-KEM-768 + X25519',
+    postQuantum: true,
+    publicKeyBytes: ML_KEM_768_PUBLIC_BYTES + X25519_PUBLIC_BYTES,
+    capsuleBytes: ML_KEM_768_CIPHERTEXT_BYTES + X25519_PUBLIC_BYTES,
+  }),
+  'classical-x25519': Object.freeze({
+    id: 'classical-x25519',
+    label: 'Classical (X25519 key agreement) → HKDF-SHA-256 → AES-256-GCM',
+    short: 'X25519',
+    postQuantum: false,
+    publicKeyBytes: X25519_PUBLIC_BYTES,
+    capsuleBytes: X25519_PUBLIC_BYTES,
+  }),
+  'classical-p256': Object.freeze({
+    id: 'classical-p256',
+    label: 'Classical (ECDH P-256 key agreement) → HKDF-SHA-256 → AES-256-GCM',
+    short: 'ECDH P-256',
+    postQuantum: false,
+    publicKeyBytes: P256_PUBLIC_BYTES,
+    capsuleBytes: P256_PUBLIC_BYTES,
+  }),
+});
+
+const subtle = () => {
+  const s = globalThis.crypto?.subtle;
+  if (!s) throw new Error('Web Cryptography API is not available in this context.');
+  return s;
+};
+
+const encoder = new TextEncoder();
+const decoder = new TextDecoder();
+
+/* ----------------------------------------------------------------------------
+ * Byte helpers
+ * ------------------------------------------------------------------------- */
+
+export function toBase64(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toBase64 === 'function') return u8.toBase64();
+  let binary = '';
+  for (let i = 0; i < u8.length; i += 0x8000) {
+    binary += String.fromCharCode(...u8.subarray(i, i + 0x8000));
+  }
+  return btoa(binary);
+}
+
+export function fromBase64(text) {
+  if (typeof text !== 'string') throw new TypeError('Expected a Base64 string.');
+  if (typeof Uint8Array.fromBase64 === 'function') return Uint8Array.fromBase64(text);
+  const binary = atob(text);
+  const out = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) out[i] = binary.charCodeAt(i);
+  return out;
+}
+
+function concat(...parts) {
+  const arrays = parts.map((p) => (p instanceof Uint8Array ? p : new Uint8Array(p)));
+  const out = new Uint8Array(arrays.reduce((n, a) => n + a.length, 0));
+  let offset = 0;
+  for (const a of arrays) {
+    out.set(a, offset);
+    offset += a.length;
+  }
+  return out;
+}
+
+function expectLength(bytes, expected, what) {
+  if (bytes.byteLength !== expected) {
+    throw new Error(`${what} must be ${expected} bytes, got ${bytes.byteLength}.`);
+  }
+}
+
+/* ----------------------------------------------------------------------------
+ * Capability detection
+ * ------------------------------------------------------------------------- */
+
+// SubtleCrypto.supports() is a *static* method; it is absent in older engines.
+function supports(operation, ...args) {
+  const fn = globalThis.SubtleCrypto?.supports;
+  if (typeof fn !== 'function') return false;
+  try {
+    return fn.call(globalThis.SubtleCrypto, operation, ...args) === true;
+  } catch {
+    return false;
+  }
+}
+
+let x25519Probe;
+async function hasX25519() {
+  if (typeof globalThis.SubtleCrypto?.supports === 'function') {
+    return supports('generateKey', 'X25519');
+  }
+  // Engines without supports() predate it; probe by generating a throwaway key.
+  x25519Probe ??= subtle()
+    .generateKey('X25519', false, ['deriveBits'])
+    .then(() => true, () => false);
+  return x25519Probe;
+}
+
+/**
+ * Picks the strongest suite the current runtime can execute.
+ * @returns {Promise<keyof typeof SUITES>}
+ */
+export async function detectBestSuite() {
+  if (
+    supports('generateKey', 'MLKEM768-X25519') &&
+    supports('encapsulateKey', 'MLKEM768-X25519', 'HKDF')
+  ) {
+    return 'pq-hybrid-native';
+  }
+  const x25519 = await hasX25519();
+  if (x25519 && supports('generateKey', 'ML-KEM-768') && supports('encapsulateBits', 'ML-KEM-768')) {
+    return 'pq-hybrid-composed';
+  }
+  return x25519 ? 'classical-x25519' : 'classical-p256';
+}
+
+/* ----------------------------------------------------------------------------
+ * Recipient (courier) key generation
+ * ------------------------------------------------------------------------- */
+
+/**
+ * Generates a non-extractable recipient key set for `suiteId`. The returned
+ * `privateMaterial` only holds CryptoKey objects and can be persisted in
+ * IndexedDB through structured cloning without the private bytes ever leaving
+ * the crypto implementation.
+ */
+export async function generateRecipientKeys(suiteId) {
+  const suite = SUITES[suiteId];
+  if (!suite) throw new Error(`Unknown suite "${suiteId}".`);
+  const s = subtle();
+
+  switch (suiteId) {
+    case 'pq-hybrid-native': {
+      const kem = await s.generateKey('MLKEM768-X25519', false, ['encapsulateKey', 'decapsulateKey']);
+      const publicKeyBytes = new Uint8Array(await s.exportKey('raw-public', kem.publicKey));
+      expectLength(publicKeyBytes, suite.publicKeyBytes, 'MLKEM768-X25519 public key');
+      return { suite: suiteId, privateMaterial: { suite: suiteId, kem }, publicKeyBytes };
+    }
+    case 'pq-hybrid-composed': {
+      const kem = await s.generateKey('ML-KEM-768', false, ['encapsulateBits', 'decapsulateBits']);
+      const dh = await s.generateKey('X25519', false, ['deriveBits']);
+      const kemPub = new Uint8Array(await s.exportKey('raw-public', kem.publicKey));
+      const dhPub = new Uint8Array(await s.exportKey('raw', dh.publicKey));
+      expectLength(kemPub, ML_KEM_768_PUBLIC_BYTES, 'ML-KEM-768 public key');
+      expectLength(dhPub, X25519_PUBLIC_BYTES, 'X25519 public key');
+      return {
+        suite: suiteId,
+        privateMaterial: { suite: suiteId, kem, dh },
+        publicKeyBytes: concat(kemPub, dhPub),
+      };
+    }
+    case 'classical-x25519': {
+      const dh = await s.generateKey('X25519', false, ['deriveBits']);
+      const publicKeyBytes = new Uint8Array(await s.exportKey('raw', dh.publicKey));
+      return { suite: suiteId, privateMaterial: { suite: suiteId, dh }, publicKeyBytes };
+    }
+    case 'classical-p256': {
+      const dh = await s.generateKey({ name: 'ECDH', namedCurve: 'P-256' }, false, ['deriveBits']);
+      const publicKeyBytes = new Uint8Array(await s.exportKey('raw', dh.publicKey));
+      return { suite: suiteId, privateMaterial: { suite: suiteId, dh }, publicKeyBytes };
+    }
+    default:
+      throw new Error(`Unsupported suite "${suiteId}".`);
+  }
+}
+
+/** SHA-256 fingerprint of a public key, rendered as 8 groups of 4 hex digits. */
+export async function fingerprint(publicKeyBytes) {
+  const digest = new Uint8Array(await subtle().digest('SHA-256', publicKeyBytes));
+  const hex = Array.from(digest.subarray(0, 16), (b) => b.toString(16).padStart(2, '0')).join('');
+  return hex.match(/.{4}/g).join(' ');
+}
+
+/* ----------------------------------------------------------------------------
+ * Key agreement / encapsulation primitives
+ * ------------------------------------------------------------------------- */
+
+function dhAlgorithm(suiteId) {
+  return suiteId === 'classical-p256' ? { name: 'ECDH', namedCurve: 'P-256' } : 'X25519';
+}
+
+async function importDhPublic(suiteId, bytes) {
+  return subtle().importKey('raw', bytes, dhAlgorithm(suiteId), true, []);
+}
+
+async function dhSharedSecret(suiteId, privateKey, peerPublicKey) {
+  const name = suiteId === 'classical-p256' ? 'ECDH' : 'X25519';
+  return new Uint8Array(await subtle().deriveBits({ name, public: peerPublicKey }, privateKey, 256));
+}
+
+/**
+ * Ephemeral-static Diffie-Hellman. The ephemeral public key is the capsule.
+ * The input keying material binds both public keys as X-Wing does for its
+ * classical component.
+ */
+async function dhEncapsulate(suiteId, recipientPublicBytes) {
+  const s = subtle();
+  const peer = await importDhPublic(suiteId, recipientPublicBytes);
+  const ephemeral = await s.generateKey(dhAlgorithm(suiteId), false, ['deriveBits']);
+  const ephemeralPublic = new Uint8Array(await s.exportKey('raw', ephemeral.publicKey));
+  const shared = await dhSharedSecret(suiteId, ephemeral.privateKey, peer);
+  return { ikm: concat(shared, ephemeralPublic, recipientPublicBytes), capsule: ephemeralPublic };
+}
+
+async function dhDecapsulate(suiteId, dhKeyPair, ephemeralPublic) {
+  const s = subtle();
+  const peer = await importDhPublic(suiteId, ephemeralPublic);
+  const ownPublic = new Uint8Array(await s.exportKey('raw', dhKeyPair.publicKey));
+  const shared = await dhSharedSecret(suiteId, dhKeyPair.privateKey, peer);
+  return concat(shared, ephemeralPublic, ownPublic);
+}
+
+async function hkdfKeyFromBytes(ikm) {
+  return subtle().importKey('raw', ikm, 'HKDF', false, ['deriveKey']);
+}
+
+/**
+ * Sender side. Returns an HKDF base CryptoKey plus the capsule the recipient
+ * needs to recover the same secret.
+ */
+async function encapsulate(suiteId, recipientPublicBytes) {
+  const s = subtle();
+  const suite = SUITES[suiteId];
+  expectLength(recipientPublicBytes, suite.publicKeyBytes, `${suite.short} recipient public key`);
+
+  switch (suiteId) {
+    case 'pq-hybrid-native': {
+      const publicKey = await s.importKey('raw-public', recipientPublicBytes, 'MLKEM768-X25519', true, ['encapsulateKey']);
+      const { sharedKey, ciphertext } = await s.encapsulateKey('MLKEM768-X25519', publicKey, 'HKDF', false, ['deriveKey']);
+      return { hkdfKey: sharedKey, capsule: new Uint8Array(ciphertext) };
+    }
+    case 'pq-hybrid-composed': {
+      const kemPublicBytes = recipientPublicBytes.subarray(0, ML_KEM_768_PUBLIC_BYTES);
+      const dhPublicBytes = recipientPublicBytes.subarray(ML_KEM_768_PUBLIC_BYTES);
+      const kemPublic = await s.importKey('raw-public', kemPublicBytes, 'ML-KEM-768', true, ['encapsulateBits']);
+      const { sharedKey: kemSecret, ciphertext: kemCiphertext } = await s.encapsulateBits('ML-KEM-768', kemPublic);
+      const dh = await dhEncapsulate('classical-x25519', dhPublicBytes);
+      // Both secrets feed HKDF: the key stays secret while either ML-KEM or X25519 holds.
+      const ikm = concat(new Uint8Array(kemSecret), dh.ikm);
+      return { hkdfKey: await hkdfKeyFromBytes(ikm), capsule: concat(new Uint8Array(kemCiphertext), dh.capsule) };
+    }
+    case 'classical-x25519':
+    case 'classical-p256': {
+      const { ikm, capsule } = await dhEncapsulate(suiteId, recipientPublicBytes);
+      return { hkdfKey: await hkdfKeyFromBytes(ikm), capsule };
+    }
+    default:
+      throw new Error(`Unsupported suite "${suiteId}".`);
+  }
+}
+
+/** Recipient side. Recovers the HKDF base key from the capsule. */
+async function decapsulate(privateMaterial, capsule) {
+  const s = subtle();
+  const suiteId = privateMaterial.suite;
+  const suite = SUITES[suiteId];
+  if (!suite) throw new Error(`Unknown suite "${suiteId}" in private material.`);
+  expectLength(capsule, suite.capsuleBytes, `${suite.short} capsule`);
+
+  switch (suiteId) {
+    case 'pq-hybrid-native':
+      return s.decapsulateKey('MLKEM768-X25519', privateMaterial.kem.privateKey, capsule, 'HKDF', false, ['deriveKey']);
+    case 'pq-hybrid-composed': {
+      const kemCiphertext = capsule.subarray(0, ML_KEM_768_CIPHERTEXT_BYTES);
+      const ephemeralPublic = capsule.subarray(ML_KEM_768_CIPHERTEXT_BYTES);
+      const kemSecret = new Uint8Array(await s.decapsulateBits('ML-KEM-768', privateMaterial.kem.privateKey, kemCiphertext));
+      const dhIkm = await dhDecapsulate('classical-x25519', privateMaterial.dh, ephemeralPublic);
+      return hkdfKeyFromBytes(concat(kemSecret, dhIkm));
+    }
+    case 'classical-x25519':
+    case 'classical-p256':
+      return hkdfKeyFromBytes(await dhDecapsulate(suiteId, privateMaterial.dh, capsule));
+    default:
+      throw new Error(`Unsupported suite "${suiteId}".`);
+  }
+}
+
+/* ----------------------------------------------------------------------------
+ * AEAD key derivation and the envelope format
+ * ------------------------------------------------------------------------- */
+
+async function deriveAeadKey(hkdfKey, suiteId) {
+  return subtle().deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: encoder.encode(`${CONTEXT}/${suiteId}`),
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+// The header is serialized with a fixed key order so sender and recipient
+// compute byte-identical additional authenticated data.
+function headerBytes({ v, suite, orderId, createdAt }) {
+  return encoder.encode(JSON.stringify({ v, suite, orderId, createdAt }));
+}
+
+/**
+ * Encrypts `plaintext` to the recipient public key for `suiteId`.
+ * @returns {Promise<{v:number, suite:string, orderId:string, createdAt:string, capsule:string, iv:string, ciphertext:string}>}
+ *   A JSON-safe envelope. `capsule`, `iv`, and `ciphertext` are Base64.
+ */
+export async function seal(suiteId, recipientPublicBytes, plaintext, { orderId = '', createdAt = new Date().toISOString() } = {}) {
+  if (!SUITES[suiteId]) throw new Error(`Unknown suite "${suiteId}".`);
+  if (typeof plaintext !== 'string') throw new TypeError('plaintext must be a string.');
+  const header = { v: ENVELOPE_VERSION, suite: suiteId, orderId: String(orderId), createdAt: String(createdAt) };
+
+  const { hkdfKey, capsule } = await encapsulate(suiteId, recipientPublicBytes);
+  const aeadKey = await deriveAeadKey(hkdfKey, suiteId);
+  const iv = crypto.getRandomValues(new Uint8Array(IV_BYTES));
+  const ciphertext = await subtle().encrypt(
+    { name: 'AES-GCM', iv, additionalData: headerBytes(header) },
+    aeadKey,
+    encoder.encode(plaintext),
+  );
+
+  return { ...header, capsule: toBase64(capsule), iv: toBase64(iv), ciphertext: toBase64(ciphertext) };
+}
+
+/**
+ * Decrypts an envelope with the recipient's private material. Throws if the
+ * envelope was produced for another suite or key, or if any byte of the
+ * header, capsule, IV, or ciphertext was altered.
+ */
+export async function open(privateMaterial, envelope) {
+  if (!envelope || envelope.v !== ENVELOPE_VERSION) {
+    throw new Error(`Unsupported envelope version ${envelope?.v}.`);
+  }
+  if (envelope.suite !== privateMaterial?.suite) {
+    throw new Error(`Envelope uses suite "${envelope.suite}" but the key is for "${privateMaterial?.suite}".`);
+  }
+  const suite = SUITES[envelope.suite];
+  if (!suite) throw new Error(`Unknown suite "${envelope.suite}".`);
+  const iv = fromBase64(envelope.iv);
+  const capsule = fromBase64(envelope.capsule);
+  expectLength(iv, IV_BYTES, 'AES-GCM IV');
+  expectLength(capsule, suite.capsuleBytes, `${suite.short} capsule`);
+
+  let plaintext;
+  try {
+    // A corrupted capsule may already fail inside decapsulation (for example an
+    // off-curve P-256 point); report every such failure the same way so callers
+    // cannot distinguish where verification stopped.
+    const hkdfKey = await decapsulate(privateMaterial, capsule);
+    const aeadKey = await deriveAeadKey(hkdfKey, envelope.suite);
+    plaintext = await subtle().decrypt(
+      { name: 'AES-GCM', iv, additionalData: headerBytes(envelope) },
+      aeadKey,
+      fromBase64(envelope.ciphertext),
+    );
+  } catch {
+    throw new Error('Authentication failed: the note was altered or encrypted for a different key.');
+  }
+  return decoder.decode(plaintext);
+}
