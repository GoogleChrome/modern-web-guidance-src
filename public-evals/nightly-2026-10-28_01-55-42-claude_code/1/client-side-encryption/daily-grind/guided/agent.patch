diff --git a/js/delivery-notes.js b/js/delivery-notes.js
new file mode 100644
index 0000000..f0d3237
--- /dev/null
+++ b/js/delivery-notes.js
@@ -0,0 +1,266 @@
+/**
+ * "Private Delivery Notes" widget for the Daily Grind homepage.
+ *
+ * Wires the form in index.html to js/note-envelope.js. Customer notes are
+ * encrypted in the browser to the courier's public key before they leave the
+ * page; the resulting envelope is what a backend would store and forward.
+ *
+ * This site is static, so the courier key pair is generated on first visit,
+ * kept as non-extractable CryptoKeys in IndexedDB, and used for the
+ * "verify decryption" button. In production only the public key would be
+ * published to customers (e.g. inlined by the server) and the private key
+ * would live on the courier's device.
+ */
+import { SUITES, detectBestSuite, generateRecipientKeys, seal, open, fingerprint, fromBase64 } from './note-envelope.js';
+
+const DB_NAME = 'daily-grind-secure-notes';
+const DB_VERSION = 1;
+const KEY_STORE = 'courier-keys';
+const OUTBOX_KEY = 'dg-delivery-notes-outbox';
+const MAX_OUTBOX = 20;
+
+const $ = (id) => document.getElementById(id);
+const el = (tag, props = {}, children = []) => {
+  const node = Object.assign(document.createElement(tag), props);
+  for (const child of children) node.append(child);
+  return node;
+};
+
+/* ----------------------------------------------------------------------------
+ * Courier key persistence (IndexedDB stores CryptoKeys by structured clone)
+ * ------------------------------------------------------------------------- */
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    if (!('indexedDB' in globalThis)) return reject(new Error('IndexedDB unavailable'));
+    const request = indexedDB.open(DB_NAME, DB_VERSION);
+    request.onupgradeneeded = () => request.result.createObjectStore(KEY_STORE, { keyPath: 'suite' });
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+function idbRequest(db, mode, run) {
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(KEY_STORE, mode);
+    const request = run(tx.objectStore(KEY_STORE));
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+const sessionKeys = new Map(); // fallback when IndexedDB is blocked (e.g. some private modes)
+
+async function loadCourierKeys(suiteId) {
+  if (sessionKeys.has(suiteId)) return sessionKeys.get(suiteId);
+  let db = null;
+  try {
+    db = await openDb();
+    const stored = await idbRequest(db, 'readonly', (store) => store.get(suiteId));
+    if (stored) {
+      sessionKeys.set(suiteId, stored);
+      return stored;
+    }
+  } catch (error) {
+    console.warn('Courier key store unavailable; using session-only keys.', error);
+  }
+  const record = { ...(await generateRecipientKeys(suiteId)), createdAt: new Date().toISOString() };
+  sessionKeys.set(suiteId, record);
+  if (db) {
+    try {
+      await idbRequest(db, 'readwrite', (store) => store.put(record));
+    } catch (error) {
+      console.warn('Could not persist courier key; it will last for this session only.', error);
+    }
+  }
+  return record;
+}
+
+/* ----------------------------------------------------------------------------
+ * Outbox (encrypted envelopes only; plaintext is never stored)
+ * ------------------------------------------------------------------------- */
+
+function readOutbox() {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(OUTBOX_KEY) ?? '[]');
+    return Array.isArray(parsed) ? parsed : [];
+  } catch {
+    return [];
+  }
+}
+
+function writeOutbox(items) {
+  try {
+    localStorage.setItem(OUTBOX_KEY, JSON.stringify(items.slice(0, MAX_OUTBOX)));
+  } catch (error) {
+    console.warn('Could not persist outbox.', error);
+  }
+}
+
+/* ----------------------------------------------------------------------------
+ * UI
+ * ------------------------------------------------------------------------- */
+
+const ui = {
+  section: $('secure-notes'),
+  form: $('note-form'),
+  order: $('note-order'),
+  text: $('note-text'),
+  count: $('note-count'),
+  submit: $('note-submit'),
+  status: $('note-status'),
+  protection: $('note-protection'),
+  badge: $('note-badge'),
+  fingerprint: $('note-fingerprint'),
+  outbox: $('note-outbox'),
+  outboxEmpty: $('note-outbox-empty'),
+};
+
+const state = { suite: null, courier: null, outbox: readOutbox() };
+
+function setStatus(message, { error = false } = {}) {
+  ui.status.textContent = message;
+  ui.status.classList.toggle('is-error', error);
+}
+
+const timeFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+function describe(envelope) {
+  const suite = SUITES[envelope.suite];
+  let size = 'unreadable envelope';
+  try {
+    const bytes = fromBase64(envelope.capsule).byteLength + fromBase64(envelope.iv).byteLength + fromBase64(envelope.ciphertext).byteLength;
+    size = `${bytes} bytes`;
+  } catch { /* leave the fallback label */ }
+  return `${suite ? suite.short : envelope.suite} · AES-256-GCM · ${size}`;
+}
+
+function renderOutbox() {
+  ui.outbox.replaceChildren();
+  ui.outboxEmpty.hidden = state.outbox.length > 0;
+
+  state.outbox.forEach((envelope, index) => {
+    const result = el('p', { className: 'note-result', hidden: true });
+    const suite = SUITES[envelope.suite];
+
+    const verify = el('button', { type: 'button', className: 'btn btn-small', textContent: 'Verify decryption' });
+    verify.addEventListener('click', async () => {
+      verify.disabled = true;
+      result.hidden = false;
+      result.classList.remove('is-error');
+      result.textContent = 'Decrypting with the courier key on this device…';
+      try {
+        const courier = await loadCourierKeys(envelope.suite);
+        const plaintext = await open(courier.privateMaterial, envelope);
+        result.replaceChildren(el('strong', { textContent: 'Decrypted note: ' }), document.createTextNode(plaintext));
+      } catch (error) {
+        result.classList.add('is-error');
+        result.textContent = `Could not decrypt: ${error.message}`;
+      } finally {
+        verify.disabled = false;
+      }
+    });
+
+    const remove = el('button', { type: 'button', className: 'btn btn-small btn-quiet', textContent: 'Delete' });
+    remove.addEventListener('click', () => {
+      state.outbox.splice(index, 1);
+      writeOutbox(state.outbox);
+      renderOutbox();
+      setStatus(`Removed the encrypted note for order ${envelope.orderId}.`);
+    });
+
+    const created = new Date(envelope.createdAt);
+    const item = el('li', { className: 'note-item' }, [
+      el('div', { className: 'note-item-head' }, [
+        el('strong', { textContent: `Order ${envelope.orderId}` }),
+        el('time', { dateTime: envelope.createdAt, textContent: Number.isNaN(created.valueOf()) ? envelope.createdAt : timeFormat.format(created) }),
+      ]),
+      el('p', { className: 'note-meta', textContent: describe(envelope) + (suite?.postQuantum ? ' · post-quantum' : '') }),
+      el('details', { className: 'note-envelope' }, [
+        el('summary', { textContent: 'Show encrypted envelope' }),
+        el('pre', { textContent: JSON.stringify(envelope, null, 2) }),
+      ]),
+      el('div', { className: 'note-actions' }, [verify, remove]),
+      result,
+    ]);
+    ui.outbox.append(item);
+  });
+}
+
+function updateCount() {
+  const max = ui.text.maxLength > 0 ? ui.text.maxLength : 500;
+  ui.count.textContent = `${ui.text.value.length} / ${max} characters`;
+}
+
+async function initKeys() {
+  state.suite = await detectBestSuite();
+  const suite = SUITES[state.suite];
+  state.courier = await loadCourierKeys(state.suite);
+
+  ui.protection.textContent = suite.label;
+  ui.badge.textContent = suite.postQuantum ? 'Post-quantum hybrid' : 'Classical encryption';
+  ui.badge.classList.toggle('is-pq', suite.postQuantum);
+  ui.fingerprint.textContent = await fingerprint(state.courier.publicKeyBytes);
+  ui.section.dataset.ready = 'true';
+  setStatus(suite.postQuantum
+    ? 'Ready. Notes are protected even against future quantum computers.'
+    : 'Ready. This browser does not offer post-quantum key encapsulation yet, so notes use classical X25519/ECDH key agreement.');
+}
+
+async function onSubmit(event) {
+  event.preventDefault();
+  if (!ui.form.reportValidity()) return;
+  if (!state.courier) {
+    setStatus('Still preparing the courier key. Please try again in a moment.', { error: true });
+    return;
+  }
+
+  const orderId = ui.order.value.trim().toUpperCase();
+  const note = ui.text.value;
+  ui.submit.disabled = true;
+  setStatus('Encrypting your note in this browser…');
+  try {
+    const envelope = await seal(state.suite, state.courier.publicKeyBytes, note, { orderId });
+    state.outbox.unshift(envelope);
+    writeOutbox(state.outbox);
+    renderOutbox();
+    ui.form.reset();
+    updateCount();
+    setStatus(`Encrypted note attached to order ${orderId} (${describe(envelope)}). Only the courier key can read it.`);
+    ui.order.focus();
+  } catch (error) {
+    console.error(error);
+    setStatus(`Could not encrypt the note: ${error.message}`, { error: true });
+  } finally {
+    ui.submit.disabled = false;
+  }
+}
+
+function init() {
+  if (!ui.form) return;
+  if (!globalThis.crypto?.subtle || !globalThis.isSecureContext) {
+    ui.submit.disabled = true;
+    setStatus('Encrypted notes need a secure (HTTPS or localhost) connection with Web Crypto support.', { error: true });
+    return;
+  }
+
+  ui.order.addEventListener('invalid', () => {
+    if (ui.order.validity.patternMismatch) {
+      ui.order.setCustomValidity('Use 3–20 letters, digits or dashes, e.g. DG-48213.');
+    }
+  });
+  ui.order.addEventListener('input', () => ui.order.setCustomValidity(''));
+  ui.text.addEventListener('input', updateCount);
+  ui.form.addEventListener('submit', onSubmit);
+
+  updateCount();
+  renderOutbox();
+  setStatus('Preparing encryption keys…');
+  initKeys().catch((error) => {
+    console.error(error);
+    ui.submit.disabled = true;
+    setStatus(`Encryption is unavailable in this browser: ${error.message}`, { error: true });
+  });
+}
+
+init();
diff --git a/js/note-envelope.js b/js/note-envelope.js
