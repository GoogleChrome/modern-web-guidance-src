new file mode 100644
index 0000000..222cb51
--- /dev/null
+++ b/js/delivery-notes.js
@@ -0,0 +1,144 @@
+/**
+ * Homepage UI for encrypted delivery notes. Thin layer over delivery-notes-crypto.js:
+ * fetches the store's public key, encrypts the note in the browser and keeps the
+ * resulting envelope (never the plaintext) in localStorage until the next order
+ * submission picks it up.
+ */
+import {
+  SUITE,
+  MAX_NOTE_CHARS,
+  parseRecipientKeyDocument,
+  publicKeyFingerprint,
+  encryptDeliveryNote,
+  parseEnvelope,
+} from './delivery-notes-crypto.js';
+
+const KEY_URL = '/keys/delivery-recipient.json';
+const STORAGE_KEY = 'dg.deliveryNote.envelope';
+
+const $ = (id) => document.getElementById(id);
+const els = {
+  form: $('dn-form'),
+  orderRef: $('dn-order-ref'),
+  note: $('dn-note'),
+  counter: $('dn-counter'),
+  submit: $('dn-submit'),
+  status: $('dn-status'),
+  keyInfo: $('dn-key-info'),
+  result: $('dn-result'),
+  resultMeta: $('dn-result-meta'),
+  envelope: $('dn-envelope'),
+  copy: $('dn-copy'),
+  clear: $('dn-clear'),
+};
+
+let recipient = null;
+
+function setStatus(message, kind = 'info') {
+  els.status.textContent = message;
+  els.status.dataset.kind = kind;
+}
+
+function showEnvelope(envelope) {
+  const parsed = parseEnvelope(envelope);
+  const json = JSON.stringify(envelope, null, 2);
+  els.envelope.value = json;
+  els.resultMeta.textContent =
+    `Key ${parsed.kid} · ${SUITE} · KEM ciphertext ${parsed.kemCt.length} B · note ciphertext ${parsed.ct.length} B · created ${parsed.ctx.createdAt}` +
+    (parsed.ctx.orderRef ? ` · order ${parsed.ctx.orderRef}` : '');
+  els.result.hidden = false;
+}
+
+function hideEnvelope() {
+  els.envelope.value = '';
+  els.resultMeta.textContent = '';
+  els.result.hidden = true;
+}
+
+function updateCounter() {
+  els.counter.textContent = `${els.note.value.length} / ${MAX_NOTE_CHARS}`;
+}
+
+async function loadRecipientKey() {
+  if (!window.isSecureContext || !crypto.subtle) {
+    throw new Error('This page must be served over HTTPS (or localhost) to encrypt notes.');
+  }
+  const res = await fetch(KEY_URL, { cache: 'no-store' });
+  if (!res.ok) throw new Error(`Could not load the store key (${res.status})`);
+  const doc = await res.json();
+  const key = parseRecipientKeyDocument(doc);
+  const fp = await publicKeyFingerprint(key.publicKey);
+  els.keyInfo.innerHTML = '';
+  const strong = document.createElement('strong');
+  strong.textContent = 'Store key: ';
+  const code = document.createElement('code');
+  code.textContent = `${key.kid} · fingerprint ${fp}`;
+  els.keyInfo.append(strong, code, document.createTextNode(' · ML-KEM-768 + X25519 (X-Wing) · AES-256-GCM'));
+  return key;
+}
+
+async function onSubmit(event) {
+  event.preventDefault();
+  if (!recipient) return;
+  els.submit.disabled = true;
+  setStatus('Encrypting on your device…');
+  try {
+    const envelope = await encryptDeliveryNote({
+      recipient,
+      note: els.note.value,
+      context: { orderRef: els.orderRef.value },
+    });
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(envelope));
+    showEnvelope(envelope);
+    els.note.value = '';
+    updateCounter();
+    setStatus('Encrypted and attached to your next order. The plain text never left this device.', 'ok');
+  } catch (err) {
+    setStatus(err.message || String(err), 'error');
+  } finally {
+    els.submit.disabled = false;
+  }
+}
+
+async function onCopy() {
+  try {
+    await navigator.clipboard.writeText(els.envelope.value);
+    setStatus('Encrypted envelope copied to clipboard.', 'ok');
+  } catch {
+    els.envelope.select();
+    setStatus('Clipboard unavailable; the envelope text is selected so you can copy it manually.', 'info');
+  }
+}
+
+function onClear() {
+  localStorage.removeItem(STORAGE_KEY);
+  hideEnvelope();
+  setStatus('Attached note removed.', 'info');
+}
+
+async function init() {
+  if (!els.form) return;
+  updateCounter();
+  els.note.addEventListener('input', updateCounter);
+  els.form.addEventListener('submit', onSubmit);
+  els.copy.addEventListener('click', onCopy);
+  els.clear.addEventListener('click', onClear);
+
+  try {
+    const stored = localStorage.getItem(STORAGE_KEY);
+    if (stored) showEnvelope(JSON.parse(stored));
+  } catch {
+    localStorage.removeItem(STORAGE_KEY);
+  }
+
+  try {
+    recipient = await loadRecipientKey();
+    els.submit.disabled = false;
+    setStatus('Ready. Notes are encrypted in your browser before anything is sent.');
+  } catch (err) {
+    setStatus(err.message || String(err), 'error');
+    els.submit.disabled = true;
+  }
+}
+
+init();
