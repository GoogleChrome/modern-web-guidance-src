@@ -0,0 +1,43 @@
+#!/usr/bin/env node
+/**
+ * Kitchen / back-office tool: decrypt a customer's delivery-note envelope.
+ *
+ *   node scripts/decrypt-note.mjs <envelope.json | -> [keys/delivery-recipient.secret.json]
+ *
+ * Reads the envelope from a file (or stdin with "-") and prints the note.
+ */
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import { decryptDeliveryNote, base64ToBytes } from '../js/delivery-notes-crypto.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const [envelopeArg, secretArg] = process.argv.slice(2);
+if (!envelopeArg) {
+  console.error('usage: decrypt-note.mjs <envelope.json | -> [secret-key.json]');
+  process.exit(2);
+}
+
+const envelopeText = envelopeArg === '-'
+  ? await new Promise((resolve, reject) => {
+      let s = '';
+      process.stdin.setEncoding('utf8');
+      process.stdin.on('data', (d) => (s += d)).on('end', () => resolve(s)).on('error', reject);
+    })
+  : await readFile(envelopeArg, 'utf8');
+const secretDoc = JSON.parse(await readFile(secretArg || path.join(root, 'keys', 'delivery-recipient.secret.json'), 'utf8'));
+
+try {
+  const { note, ctx, kid } = await decryptDeliveryNote({
+    recipient: { kid: secretDoc.kid, secretKey: base64ToBytes(secretDoc.secretKey) },
+    envelope: envelopeText,
+  });
+  console.log(`key:      ${kid}`);
+  console.log(`order:    ${ctx.orderRef || '(none)'}`);
+  console.log(`created:  ${ctx.createdAt}`);
+  console.log('note:');
+  console.log(note);
+} catch (err) {
+  console.error(`✗ ${err.message}`);
+  process.exit(1);
+}
diff --git a/scripts/generate-recipient-keys.mjs b/scripts/generate-recipient-keys.mjs
