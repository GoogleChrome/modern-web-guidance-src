index 0000000..0e1c574
--- /dev/null
+++ b/scripts/generate-recipient-keys.mjs
@@ -0,0 +1,60 @@
+#!/usr/bin/env node
+/**
+ * Generate the store's X-Wing (ML-KEM-768 + X25519) delivery-note key pair.
+ *
+ *   node scripts/generate-recipient-keys.mjs [kid]
+ *
+ * Writes:
+ *   keys/delivery-recipient.json         – public key document served to browsers (commit this)
+ *   keys/delivery-recipient.secret.json  – 32-byte secret seed (git-ignored; keep in the kitchen/back office only)
+ */
+import { writeFile, access } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import {
+  SUITE,
+  generateRecipientKeyPair,
+  bytesToBase64,
+  publicKeyFingerprint,
+} from '../js/delivery-notes-crypto.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const publicPath = path.join(root, 'keys', 'delivery-recipient.json');
+const secretPath = path.join(root, 'keys', 'delivery-recipient.secret.json');
+
+const now = new Date();
+const kid = process.argv[2] || `dg-delivery-${now.toISOString().slice(0, 7)}`;
+const force = process.argv.includes('--force');
+
+try {
+  await access(secretPath);
+  if (!force) {
+    console.error(`Refusing to overwrite existing ${path.relative(root, secretPath)} (pass --force to rotate).`);
+    process.exit(1);
+  }
+} catch (err) {
+  if (err.code !== 'ENOENT') throw err;
+}
+
+const { publicKey, secretKey } = generateRecipientKeyPair();
+const expires = new Date(now);
+expires.setFullYear(expires.getFullYear() + 1);
+
+const publicDoc = {
+  kid,
+  suite: SUITE,
+  kem: 'X-Wing (ML-KEM-768 + X25519, draft-connolly-cfrg-xwing-kem)',
+  publicKey: bytesToBase64(publicKey),
+  createdAt: now.toISOString(),
+  expiresAt: expires.toISOString(),
+};
+const secretDoc = { kid, suite: SUITE, secretKey: bytesToBase64(secretKey), createdAt: now.toISOString() };
+
+await writeFile(publicPath, JSON.stringify(publicDoc, null, 2) + '\n');
+await writeFile(secretPath, JSON.stringify(secretDoc, null, 2) + '\n', { mode: 0o600 });
+secretKey.fill(0);
+
+console.log(`kid:         ${kid}`);
+console.log(`fingerprint: ${await publicKeyFingerprint(publicKey)}`);
+console.log(`public key:  ${path.relative(root, publicPath)}`);
+console.log(`secret key:  ${path.relative(root, secretPath)}  (NOT committed – move to the kitchen system)`);
diff --git a/test/delivery-notes-crypto.test.mjs b/test/delivery-notes-crypto.test.mjs
new file mode 100644
index 0000000..5028561
--- /dev/null
+++ b/test/delivery-notes-crypto.test.mjs
@@ -0,0 +1,145 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import {
+  SUITE,
+  PAD_BLOCK,
+  MAX_NOTE_CHARS,
+  KEM_PUBLIC_KEY_BYTES,
+  KEM_CIPHERTEXT_BYTES,
+  generateRecipientKeyPair,
+  recipientPublicKeyFromSecret,
+  parseRecipientKeyDocument,
+  publicKeyFingerprint,
+  encryptDeliveryNote,
+  decryptDeliveryNote,
+  parseEnvelope,
+  bytesToBase64,
+  base64ToBytes,
+} from '../js/delivery-notes-crypto.js';
+
+const kp = generateRecipientKeyPair();
+const recipient = { kid: 'test-key', publicKey: kp.publicKey, secretKey: kp.secretKey };
+const NOTE = 'Gate code 4471#. Severe peanut allergy – please leave at side door. 🚪☕';
+
+test('key pair has X-Wing sizes and public key is re-derivable from the seed', async () => {
+  assert.equal(kp.publicKey.length, KEM_PUBLIC_KEY_BYTES);
+  assert.equal(kp.secretKey.length, 32);
+  assert.deepEqual(recipientPublicKeyFromSecret(kp.secretKey), kp.publicKey);
+  assert.match(await publicKeyFingerprint(kp.publicKey), /^[0-9a-f]{4}( [0-9a-f]{4}){3}$/);
+});
+
+test('encrypt → decrypt round trip preserves note and context', async () => {
+  const envelope = await encryptDeliveryNote({ recipient, note: NOTE, context: { orderRef: 'DG-10422' } });
+  assert.equal(envelope.suite, SUITE);
+  assert.equal(envelope.kid, 'test-key');
+  assert.equal(base64ToBytes(envelope.kemCt).length, KEM_CIPHERTEXT_BYTES);
+  assert.equal(base64ToBytes(envelope.nonce).length, 12);
+
+  const json = JSON.stringify(envelope); // as it would travel to the server
+  const out = await decryptDeliveryNote({ recipient, envelope: json });
+  assert.equal(out.note, NOTE);
+  assert.equal(out.ctx.orderRef, 'DG-10422');
+  assert.equal(out.kid, 'test-key');
+});
+
+test('plaintext is never present in the envelope and ciphertext length is padded', async () => {
+  const short = await encryptDeliveryNote({ recipient, note: 'ring twice' });
+  const longer = await encryptDeliveryNote({ recipient, note: 'ring twice, please, and leave by the planter' });
+  const text = JSON.stringify(short);
+  assert.ok(!text.includes('ring twice'));
+  assert.equal(base64ToBytes(short.ct).length, PAD_BLOCK + 16);
+  assert.equal(base64ToBytes(short.ct).length, base64ToBytes(longer.ct).length);
+  const max = await encryptDeliveryNote({ recipient, note: 'x'.repeat(MAX_NOTE_CHARS) });
+  assert.equal(base64ToBytes(max.ct).length % PAD_BLOCK, 16);
+});
+
+test('encapsulations are fresh: two envelopes for the same note differ', async () => {
+  const a = await encryptDeliveryNote({ recipient, note: NOTE });
+  const b = await encryptDeliveryNote({ recipient, note: NOTE });
+  assert.notEqual(a.kemCt, b.kemCt);
+  assert.notEqual(a.nonce, b.nonce);
+  assert.notEqual(a.ct, b.ct);
+});
+
+test('any tampering with ciphertext or header is rejected', async () => {
+  const envelope = await encryptDeliveryNote({ recipient, note: NOTE, context: { orderRef: 'DG-1' } });
+  const flip = (b64, i = 5) => {
+    const bytes = base64ToBytes(b64);
+    bytes[i] ^= 0x01;
+    return bytesToBase64(bytes);
+  };
+  const cases = {
+    ciphertext: { ...envelope, ct: flip(envelope.ct) },
+    tag: { ...envelope, ct: flip(envelope.ct, base64ToBytes(envelope.ct).length - 1) },
+    nonce: { ...envelope, nonce: flip(envelope.nonce) },
+    kemCiphertext: { ...envelope, kemCt: flip(envelope.kemCt) },
+    orderRef: { ...envelope, ctx: { ...envelope.ctx, orderRef: 'DG-2' } },
+    createdAt: { ...envelope, ctx: { ...envelope.ctx, createdAt: '2020-01-01T00:00:00.000Z' } },
+  };
+  for (const [name, bad] of Object.entries(cases)) {
+    await assert.rejects(
+      decryptDeliveryNote({ recipient, envelope: bad }),
+      /tampered|different key/,
+      `tampered ${name} must not decrypt`,
+    );
+  }
+  // sanity: the untouched envelope still decrypts
+  assert.equal((await decryptDeliveryNote({ recipient, envelope })).note, NOTE);
+});
+
+test('wrong secret key or mismatched key id fails', async () => {
+  const other = generateRecipientKeyPair();
+  const envelope = await encryptDeliveryNote({ recipient, note: NOTE });
+  await assert.rejects(
+    decryptDeliveryNote({ recipient: { kid: 'test-key', secretKey: other.secretKey }, envelope }),
+    /tampered|different key/,
+  );
+  await assert.rejects(
+    decryptDeliveryNote({ recipient: { kid: 'other-kid', secretKey: kp.secretKey }, envelope }),
+    /encrypted to key "test-key"/,
+  );
+});
+
+test('malformed envelopes and inputs are rejected before any crypto runs', async () => {
+  const envelope = await encryptDeliveryNote({ recipient, note: NOTE });
+  assert.throws(() => parseEnvelope({ ...envelope, v: 2 }), /version/);
+  assert.throws(() => parseEnvelope({ ...envelope, suite: 'AES-128-CBC' }), /suite/);
+  assert.throws(() => parseEnvelope({ ...envelope, ctx: { ...envelope.ctx, purpose: 'other' } }), /purpose/);
+  assert.throws(() => parseEnvelope({ ...envelope, kemCt: envelope.kemCt.slice(0, -4) }), /kemCt|base64/);
+  assert.throws(() => parseEnvelope({ ...envelope, ct: 'not base64!' }), /base64/);
+  assert.throws(() => parseEnvelope({ ...envelope, ct: bytesToBase64(new Uint8Array(20)) }), /too short/);
+
+  await assert.rejects(encryptDeliveryNote({ recipient, note: '   ' }), /empty/);
+  await assert.rejects(encryptDeliveryNote({ recipient, note: 'x'.repeat(MAX_NOTE_CHARS + 1) }), /at most/);
+  await assert.rejects(encryptDeliveryNote({ recipient, note: NOTE, context: { orderRef: 'a\nb' } }), /orderRef/);
+  await assert.rejects(
+    encryptDeliveryNote({ recipient: { kid: 'k', publicKey: kp.publicKey.slice(0, 100) }, note: NOTE }),
+    /1216 bytes/,
+  );
+});
+
+test('published key document validation', () => {
+  const doc = { kid: 'dg-delivery-2026-10', suite: SUITE, publicKey: bytesToBase64(kp.publicKey) };
+  assert.deepEqual(parseRecipientKeyDocument(doc).publicKey, kp.publicKey);
+  assert.throws(() => parseRecipientKeyDocument({ ...doc, suite: 'RSA' }), /suite/);
+  assert.throws(() => parseRecipientKeyDocument({ ...doc, kid: 'bad kid!' }), /kid/);
+  assert.throws(() => parseRecipientKeyDocument({ ...doc, publicKey: bytesToBase64(kp.publicKey.slice(1)) }), /1216/);
+  assert.throws(() => parseRecipientKeyDocument({ ...doc, expiresAt: '2000-01-01T00:00:00Z' }), /expired/);
+});
+
+test('the committed store key document is valid and matches the local secret (if present)', async () => {
+  const doc = JSON.parse(await readFile(new URL('../keys/delivery-recipient.json', import.meta.url), 'utf8'));
+  const pub = parseRecipientKeyDocument(doc);
+  let secretDoc;
+  try {
+    secretDoc = JSON.parse(await readFile(new URL('../keys/delivery-recipient.secret.json', import.meta.url), 'utf8'));
+  } catch {
+    return; // secret stays out of the repo; nothing more to check
+  }
+  const secretKey = base64ToBytes(secretDoc.secretKey);
+  assert.deepEqual(recipientPublicKeyFromSecret(secretKey), pub.publicKey);
+  const envelope = await encryptDeliveryNote({ recipient: pub, note: NOTE });
+  const out = await decryptDeliveryNote({ recipient: { kid: secretDoc.kid, secretKey }, envelope });
+  assert.equal(out.note, NOTE);
+});
