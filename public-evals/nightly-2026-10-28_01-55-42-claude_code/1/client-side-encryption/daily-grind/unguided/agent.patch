+#!/bin/sh
+# Rebuilds vendor/noble-xwing.js from the pinned @noble/post-quantum release.
+# Run from the repo root. Requires network access for the one-off install.
+set -eu
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+cd "$WORK"
+printf '{"name":"vendor-build","private":true,"type":"module"}\n' > package.json
+pnpm add --silent @noble/post-quantum@0.7.1 esbuild@0.28.2
+cat > entry.js <<'JS'
+// Entry for vendored bundle: X-Wing hybrid KEM (ML-KEM-768 + X25519) from @noble/post-quantum.
+export { ml_kem768_x25519 as xwing } from '@noble/post-quantum/hybrid.js';
+export { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+JS
+node node_modules/esbuild/bin/esbuild entry.js --bundle --format=esm --platform=browser --target=es2022 --legal-comments=none \
+  --banner:js="/* Vendored bundle of @noble/post-quantum 0.7.1 (+ @noble/curves, @noble/hashes 2.4.0), MIT License, (c) Paul Miller (paulmillr.com). Built with esbuild; exports: xwing (X-Wing hybrid KEM = ML-KEM-768 + X25519, draft-connolly-cfrg-xwing-kem), ml_kem768. Regenerate with scripts/build-vendor.sh */" \
+  --outfile="$ROOT/vendor/noble-xwing.js"
