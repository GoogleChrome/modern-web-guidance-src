+/**
+ * Daily Grind – encrypted delivery notes (shared browser/Node module).
+ *
+ * Construction (suite "XWING-HKDF-SHA256-AES256GCM"):
+ *
+ *   1. Key establishment: X-Wing hybrid KEM = ML-KEM-768 (post-quantum, FIPS 203)
+ *      combined with X25519 (classical ECDH) as specified in
+ *      draft-connolly-cfrg-xwing-kem. The customer's browser encapsulates to the
+ *      store's published public key; the combined 32-byte shared secret is only
+ *      recoverable with the store's secret key. An attacker must break BOTH
+ *      ML-KEM-768 and X25519 to recover it.
+ *   2. Key derivation: HKDF-SHA-256 over the KEM shared secret. The `info`
+ *      parameter is a label plus SHA-256 of the envelope header (version, suite,
+ *      key id, context and the KEM ciphertext) so a key derived for one envelope
+ *      cannot be reused for another.
+ *   3. Authenticated encryption: AES-256-GCM (WebCrypto, non-extractable key)
+ *      with a fresh 96-bit nonce and the same header as additional
+ *      authenticated data. Any change to ciphertext *or* header fails decryption.
+ *   4. The plaintext is length-prefixed and padded to a multiple of PAD_BLOCK
+ *      bytes so ciphertext length reveals little about note length.
+ *
+ * The KEM is provided by the vendored, audited @noble/post-quantum bundle; HKDF
+ * and AES-GCM come from the platform WebCrypto implementation.
+ *
+ * Limitations: X-Wing provides no sender authentication, so the envelope proves
+ * confidentiality/integrity, not who wrote it. Authentication of the customer is
+ * left to the (logged-in) ordering session that submits the envelope.
+ */
+import { xwing } from '../vendor/noble-xwing.js';
+
+export const SUITE = 'XWING-HKDF-SHA256-AES256GCM';
+export const ENVELOPE_VERSION = 1;
+export const PURPOSE = 'delivery-note';
+export const MAX_NOTE_CHARS = 500;
+export const PAD_BLOCK = 128;
+
+export const KEM_PUBLIC_KEY_BYTES = xwing.lengths.publicKey;  // 1216
+export const KEM_SECRET_KEY_BYTES = xwing.lengths.secretKey;  // 32 (seed)
+export const KEM_CIPHERTEXT_BYTES = xwing.lengths.cipherText; // 1120
+
+const HKDF_SALT = utf8('the-daily-grind/delivery-note/v1');
+const NONCE_BYTES = 12;
+const subtle = () => {
+  const s = globalThis.crypto && globalThis.crypto.subtle;
+  if (!s) throw new Error('WebCrypto (crypto.subtle) is not available; a secure context (HTTPS or localhost) is required.');
+  return s;
+};
+
+// ---------- encoding helpers ----------
+
+export function utf8(str) {
+  return new TextEncoder().encode(str);
+}
+
+export function bytesToBase64(bytes) {
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin);
+}
+
+export function base64ToBytes(b64) {
+  if (typeof b64 !== 'string' || !/^[A-Za-z0-9+/]*={0,2}$/.test(b64) || b64.length % 4 !== 0) {
+    throw new Error('Invalid base64 value');
+  }
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+function bytesToHex(bytes) {
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+function concat(...parts) {
+  const len = parts.reduce((n, p) => n + p.length, 0);
+  const out = new Uint8Array(len);
+  let o = 0;
+  for (const p of parts) { out.set(p, o); o += p.length; }
+  return out;
+}
+
+function assertBytes(value, length, name) {
+  if (!(value instanceof Uint8Array)) throw new TypeError(`${name} must be a Uint8Array`);
+  if (length !== undefined && value.length !== length) {
+    throw new RangeError(`${name} must be ${length} bytes, got ${value.length}`);
+  }
+  return value;
+}
+
+// ---------- recipient (store) keys ----------
+
+/** Generate a new X-Wing key pair for the store. secretKey is a 32-byte seed. */
+export function generateRecipientKeyPair() {
+  const { publicKey, secretKey } = xwing.keygen();
+  return { publicKey, secretKey };
+}
+
+/** Re-derive the public key from a stored secret seed. */
+export function recipientPublicKeyFromSecret(secretKey) {
+  return xwing.getPublicKey(assertBytes(secretKey, KEM_SECRET_KEY_BYTES, 'secretKey'));
+}
+
+/** Short human-comparable fingerprint of a public key (first 16 hex chars of SHA-256). */
+export async function publicKeyFingerprint(publicKey) {
+  assertBytes(publicKey, KEM_PUBLIC_KEY_BYTES, 'publicKey');
+  const digest = new Uint8Array(await subtle().digest('SHA-256', publicKey));
+  return bytesToHex(digest.subarray(0, 8)).replace(/(.{4})(?=.)/g, '$1 ');
+}
+
+/**
+ * Parse and validate a published recipient key document, e.g. keys/delivery-recipient.json:
+ *   { "kid": "...", "suite": SUITE, "kem": "X-Wing", "publicKey": "<base64>", "createdAt": "..." }
+ */
+export function parseRecipientKeyDocument(doc) {
+  if (!doc || typeof doc !== 'object') throw new Error('Recipient key document is not an object');
+  if (doc.suite !== SUITE) throw new Error(`Unsupported suite "${doc.suite}" (expected ${SUITE})`);
+  if (typeof doc.kid !== 'string' || !/^[A-Za-z0-9._-]{1,64}$/.test(doc.kid)) {
+    throw new Error('Recipient key id (kid) is missing or malformed');
+  }
+  const publicKey = base64ToBytes(doc.publicKey);
+  assertBytes(publicKey, KEM_PUBLIC_KEY_BYTES, 'recipient publicKey');
+  if (doc.expiresAt && Date.parse(doc.expiresAt) < Date.now()) {
+    throw new Error(`Recipient key ${doc.kid} expired on ${doc.expiresAt}`);
+  }
+  return { kid: doc.kid, publicKey, createdAt: doc.createdAt || null, expiresAt: doc.expiresAt || null };
+}
+
+// ---------- envelope header / AAD ----------
+
+function normaliseContext(ctx = {}) {
+  const orderRef = String(ctx.orderRef ?? '').trim();
+  if (orderRef.length > 64 || /[\u0000-\u001f\u007f]/.test(orderRef)) {
+    throw new Error('orderRef must be at most 64 printable characters');
+  }
+  const createdAt = ctx.createdAt ?? new Date().toISOString();
+  if (Number.isNaN(Date.parse(createdAt))) throw new Error('createdAt must be an ISO-8601 timestamp');
+  return { purpose: PURPOSE, orderRef, createdAt };
+}
+
+/**
+ * Canonical header bytes used both as HKDF info and AES-GCM AAD. Fields are
+ * length-prefixed to avoid ambiguity; the KEM ciphertext is included so the
+ * derived key and the tag are bound to this exact encapsulation.
+ */
+function headerBytes({ v, suite, kid, ctx, kemCt }) {
+  const fields = [String(v), suite, kid, ctx.purpose, ctx.orderRef, ctx.createdAt].map(utf8);
+  const parts = [];
+  for (const f of fields) {
+    const len = new Uint8Array(4);
+    new DataView(len.buffer).setUint32(0, f.length);
+    parts.push(len, f);
+  }
+  parts.push(kemCt);
+  return concat(...parts);
+}
+
+// ---------- padding ----------
+
+function padPlaintext(bytes) {
+  if (bytes.length > 0xffff) throw new RangeError('note too long');
+  const total = Math.ceil((2 + bytes.length) / PAD_BLOCK) * PAD_BLOCK;
+  const out = new Uint8Array(total);
+  new DataView(out.buffer).setUint16(0, bytes.length);
+  out.set(bytes, 2);
+  return out;
+}
+
+function unpadPlaintext(padded) {
+  if (padded.length < 2 || padded.length % PAD_BLOCK !== 0) throw new Error('Malformed padded plaintext');
+  const len = new DataView(padded.buffer, padded.byteOffset).getUint16(0);
+  if (2 + len > padded.length) throw new Error('Malformed padded plaintext');
+  for (let i = 2 + len; i < padded.length; i++) {
+    if (padded[i] !== 0) throw new Error('Malformed padding');
+  }
+  return padded.slice(2, 2 + len);
+}
+
+// ---------- key derivation ----------
+
+const HKDF_INFO_LABEL = utf8('the-daily-grind/delivery-note/v1/aes-256-gcm');
+
+/**
+ * HKDF info = label || SHA-256(header). Hashing keeps info under the 1024-byte
+ * limit some WebCrypto implementations enforce while still binding the derived
+ * key to the full header (including the KEM ciphertext).
+ */
+async function deriveAesKey(sharedSecret, header, usage) {
+  const s = subtle();
+  try {
+    const info = concat(HKDF_INFO_LABEL, new Uint8Array(await s.digest('SHA-256', header)));
+    const ikm = await s.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+    return await s.deriveKey(
+      { name: 'HKDF', hash: 'SHA-256', salt: HKDF_SALT, info },
+      ikm,
+      { name: 'AES-GCM', length: 256 },
+      false,
+      [usage],
+    );
+  } finally {
+    sharedSecret.fill(0); // best-effort zeroisation; the imported key is non-extractable
+  }
+}
+
+// ---------- public API ----------
+
+/**
+ * Encrypt a delivery note to the store's public key.
+ * @param {{ recipient: { kid: string, publicKey: Uint8Array }, note: string, context?: { orderRef?: string, createdAt?: string }, randomness?: Uint8Array }} args
+ * @returns {Promise<object>} JSON-serialisable envelope
+ */
+export async function encryptDeliveryNote({ recipient, note, context, randomness }) {
+  if (!recipient || typeof recipient.kid !== 'string') throw new Error('recipient.kid is required');
+  assertBytes(recipient.publicKey, KEM_PUBLIC_KEY_BYTES, 'recipient.publicKey');
+  if (typeof note !== 'string') throw new TypeError('note must be a string');
+  const trimmed = note.trim();
+  if (!trimmed) throw new Error('Note is empty');
+  if (trimmed.length > MAX_NOTE_CHARS) throw new Error(`Note must be at most ${MAX_NOTE_CHARS} characters`);
+
+  const ctx = normaliseContext(context);
+  const { sharedSecret, cipherText: kemCt } = xwing.encapsulate(recipient.publicKey, randomness);
+  const header = { v: ENVELOPE_VERSION, suite: SUITE, kid: recipient.kid, ctx, kemCt };
+  const aad = headerBytes(header);
+
+  const key = await deriveAesKey(sharedSecret, aad, 'encrypt');
+  const nonce = globalThis.crypto.getRandomValues(new Uint8Array(NONCE_BYTES));
+  const padded = padPlaintext(utf8(trimmed));
+  const ct = new Uint8Array(await subtle().encrypt({ name: 'AES-GCM', iv: nonce, additionalData: aad, tagLength: 128 }, key, padded));
+  padded.fill(0);
+
+  return {
+    v: ENVELOPE_VERSION,
+    suite: SUITE,
+    kid: recipient.kid,
+    ctx,
+    kemCt: bytesToBase64(kemCt),
+    nonce: bytesToBase64(nonce),
+    ct: bytesToBase64(ct),
+  };
+}
+
+/** Validate envelope structure and decode binary fields. Throws on any problem. */
+export function parseEnvelope(envelope) {
+  const e = typeof envelope === 'string' ? JSON.parse(envelope) : envelope;
+  if (!e || typeof e !== 'object') throw new Error('Envelope is not an object');
+  if (e.v !== ENVELOPE_VERSION) throw new Error(`Unsupported envelope version ${e.v}`);
+  if (e.suite !== SUITE) throw new Error(`Unsupported suite "${e.suite}"`);
+  if (typeof e.kid !== 'string' || !e.kid) throw new Error('Envelope kid missing');
+  if (!e.ctx || e.ctx.purpose !== PURPOSE) throw new Error('Envelope purpose mismatch');
+  const ctx = normaliseContext(e.ctx);
+  const kemCt = assertBytes(base64ToBytes(e.kemCt), KEM_CIPHERTEXT_BYTES, 'kemCt');
+  const nonce = assertBytes(base64ToBytes(e.nonce), NONCE_BYTES, 'nonce');
+  const ct = base64ToBytes(e.ct);
+  if (ct.length < 16 + PAD_BLOCK) throw new Error('Ciphertext too short');
+  return { v: e.v, suite: e.suite, kid: e.kid, ctx, kemCt, nonce, ct };
+}
+
+/**
+ * Decrypt an envelope with the store's secret key (kitchen / back-office side).
+ * @param {{ recipient: { kid: string, secretKey: Uint8Array }, envelope: object|string }} args
+ * @returns {Promise<{ note: string, ctx: object, kid: string }>}
+ */
+export async function decryptDeliveryNote({ recipient, envelope }) {
+  if (!recipient || typeof recipient.kid !== 'string') throw new Error('recipient.kid is required');
+  assertBytes(recipient.secretKey, KEM_SECRET_KEY_BYTES, 'recipient.secretKey');
+  const parsed = parseEnvelope(envelope);
+  if (parsed.kid !== recipient.kid) {
+    throw new Error(`Envelope was encrypted to key "${parsed.kid}", but secret key is "${recipient.kid}"`);
+  }
+  const aad = headerBytes(parsed);
+  // X-Wing decapsulation is implicit-rejection: an invalid KEM ciphertext yields a
+  // random secret rather than an error, and AES-GCM then fails authentication.
+  const sharedSecret = xwing.decapsulate(parsed.kemCt, recipient.secretKey);
+  const key = await deriveAesKey(sharedSecret, aad, 'decrypt');
+  let padded;
+  try {
+    padded = new Uint8Array(await subtle().decrypt({ name: 'AES-GCM', iv: parsed.nonce, additionalData: aad, tagLength: 128 }, key, parsed.ct));
+  } catch {
+    throw new Error('Decryption failed: envelope has been tampered with or was encrypted to a different key');
+  }
+  const plain = unpadPlaintext(padded);
+  padded.fill(0);
+  return { note: new TextDecoder().decode(plain), ctx: parsed.ctx, kid: parsed.kid };
+}
