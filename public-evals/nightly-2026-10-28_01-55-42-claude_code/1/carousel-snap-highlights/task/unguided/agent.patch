+  <script>
+    // Highlight whichever carousel item is currently snapped (closest to the
+    // horizontal center of the carousel viewport).
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+      var items = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-item'));
+      var ticking = false;
+
+      function updateActive() {
+        ticking = false;
+        var rect = carousel.getBoundingClientRect();
+        var center = rect.left + rect.width / 2;
+        var closest = null;
+        var closestDist = Infinity;
+
+        items.forEach(function (item) {
+          var r = item.getBoundingClientRect();
+          var dist = Math.abs((r.left + r.width / 2) - center);
+          if (dist < closestDist) {
+            closestDist = dist;
+            closest = item;
+          }
+        });
+
+        items.forEach(function (item) {
+          var card = item.querySelector('.card');
+          if (!card) return;
+          var active = item === closest;
+          card.classList.toggle('is-active', active);
+          if (active) {
+            item.setAttribute('aria-current', 'true');
+          } else {
+            item.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function requestUpdate() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(updateActive);
+        }
+      }
+
+      carousel.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate);
+      updateActive();
+    })();
+  </script>
+
