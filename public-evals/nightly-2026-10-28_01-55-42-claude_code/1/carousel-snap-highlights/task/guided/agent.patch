+  <script>
+    // Fallback for browsers without CSS scroll-state queries (Firefox, Safari):
+    // mark the item sitting in the center 2% of the carousel as snapped.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const carousel = document.querySelector('.carousel');
+      if (carousel) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            entry.target.classList.toggle('is-snapped', entry.isIntersecting);
+          });
+        }, { root: carousel, rootMargin: '0px -49%' });
+        carousel.querySelectorAll('.carousel-item').forEach((item) => observer.observe(item));
+      }
+    }
+  </script>
