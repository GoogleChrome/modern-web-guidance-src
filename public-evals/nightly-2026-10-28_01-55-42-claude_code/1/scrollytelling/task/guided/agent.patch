+    }
+
+    #tracked h3 {
+      font-size: 2rem;
+      line-height: 1.2;
+      color: var(--primary);
+    }
+
+    /* Visual sections: static fallback layout (no scroll-driven animation support,
+       or reduced motion) simply lines each visual up beside its text section. */
+    #animated {
+      display: grid;
+    }
+
+    #animated section {
+      position: relative;
+      min-height: calc(100vh - 20px);
+      min-height: calc(100dvh - 20px);
+      margin: 10px 0;
+      border-radius: 12px;
+      overflow: hidden;
+      background: var(--primary);
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #animated img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      position: absolute;
+      inset: 0;
+    }
+
+    #animated figcaption {
+      position: absolute;
+      inset: auto 0 0 0;
+      padding: 16px 20px;
+      color: white;
+      font-size: 0.9rem;
+      background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
+    }
+
+    /* Progressive enhancement: sticky visual column with scroll-driven crossfades.
+       Only enabled when the browser fully supports scroll-driven animations and
+       the user has not asked for reduced motion. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+        #animated {
+          display: grid;
+          align-self: start;
+          position: sticky;
+          top: 5.5rem;
+          height: calc(100vh - 7rem);
+          height: calc(100dvh - 7rem);
+          order: -1;
+        }
+
+        @media (min-width: 800px) {
+          #animated {
+            order: 0;
+          }
+        }
+
+        #animated section {
+          grid-area: 1 / 1;
+          min-height: 0;
+          height: 100%;
+          margin: 0;
+          /* Compositor-friendly properties only (opacity + individual transforms). */
+          animation:
+            story-in auto linear both,
+            story-out auto linear forwards;
+          /* Declared after the shorthand so it is not reset by it. */
+          animation-range:
+            entry 30% entry 100%,
+            exit 0% exit 70%;
+        }
+
+        #animated section:nth-child(1) { animation-timeline: --story-1; }
+        #animated section:nth-child(2) { animation-timeline: --story-2; }
+        #animated section:nth-child(3) { animation-timeline: --story-3; }
+        #animated section:nth-child(4) { animation-timeline: --story-4; }
+
+        /* On narrow screens the visual sits above the text, so push text below it. */
+        @media (max-width: 799px) {
+          #animated {
+            height: 38vh;
+            height: 38dvh;
+            z-index: 1;
+          }
+
+          #tracked section {
+            align-content: end;
+            padding-bottom: 15vh;
+          }
+        }
+      }
+    }
+
+    @keyframes story-in {
+      from {
+        opacity: 0;
+        scale: 0.94;
+        translate: 0 2rem;
+      }
+      to {
+        opacity: 1;
+        scale: 1;
+        translate: 0 0;
+      }
+    }
+
+    @keyframes story-out {
+      to {
+        opacity: 0;
+        scale: 1.04;
+        translate: 0 -2rem;
+      }
+    }
