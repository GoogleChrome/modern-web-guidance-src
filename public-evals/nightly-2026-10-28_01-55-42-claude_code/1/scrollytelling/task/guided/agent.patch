+    /* Scrollytelling: "From Farm to Cup" */
+    .scrolly {
+      margin-top: 60px;
+      /* Hoist the view-timeline names so #animated (a sibling branch) can reference them. */
+      timeline-scope: --story-1, --story-2, --story-3, --story-4;
