+    /* Drink customization checkboxes */
+    .customize {
+      position: relative;
+      border: 0;
+      margin: 18px 0 0;
+      padding: 14px 0 0;
+      text-align: left;
+      min-width: 0;
+    }
+
+    .customize::before {
+      content: "";
+      position: absolute;
+      top: 0;
+      left: 10%;
+      right: 10%;
+      border-top: 1px dashed var(--secondary);
+    }
+
+    .customize legend {
+      padding: 0;
+      font-size: 0.72rem;
+      font-weight: 600;
+      letter-spacing: 0.14em;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .options {
+      list-style: none;
+      display: grid;
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      gap: 8px;
+      margin-top: 10px;
+    }
+
+    .option {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 8px;
+      padding: 8px 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: var(--light);
+      cursor: pointer;
+      user-select: none;
+      transition: background-color 0.25s, border-color 0.25s, box-shadow 0.25s;
+    }
+
+    .option:hover {
+      border-color: var(--accent);
+      background: #fff;
+    }
+
+    /* The real checkbox stays in the DOM, focusable and clickable; it is only
+       visually hidden (never display:none / visibility:hidden). */
+    .option input[type="checkbox"] {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      margin: -1px;
+      padding: 0;
+      border: 0;
+      overflow: hidden;
+      clip: rect(0 0 0 0);
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    .option .box {
+      flex: none;
+      display: grid;
+      place-items: center;
+      width: 22px;
+      height: 22px;
+      border: 2px solid var(--primary);
+      border-radius: 6px;
+      background: #fff;
+      /* uncheck: fill drains after the tick retracts */
+      transition: background-color 0.2s ease 0.12s, border-color 0.2s ease 0.12s, transform 0.2s ease;
+    }
+
+    .option .box svg {
+      width: 14px;
+      height: 14px;
+      overflow: visible;
+    }
+
+    .option .box path {
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 22;
+      stroke-dashoffset: 22;
+      /* uncheck: tick retracts along its own path */
+      transition: stroke-dashoffset 0.18s ease-in;
+    }
+
+    .option .icon {
+      flex: none;
+      width: 18px;
+      height: 18px;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 1.8;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      color: var(--primary);
+      opacity: 0.7;
+      transition: color 0.25s, opacity 0.25s, transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
+    }
+
+    .option .text {
+      font-size: 0.9rem;
+      line-height: 1.25;
+      color: var(--text);
+    }
+
+    .option .price {
+      display: block;
+      font-size: 0.72rem;
+      color: #7a5c52;
+    }
+
+    /* Checked state */
+    .option input:checked ~ .box {
+      background: var(--primary);
+      border-color: var(--primary);
+      transition-delay: 0s;
+      animation: check-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
+    }
+
+    .option input:checked ~ .box path {
+      stroke-dashoffset: 0;
+      transition: stroke-dashoffset 0.25s ease-out 0.1s;
+    }
+
+    .option input:checked ~ .icon {
+      color: var(--accent);
+      opacity: 1;
+      transform: scale(1.15) rotate(-6deg);
+    }
+
+    .option:has(input:checked) {
+      border-color: var(--primary);
+      background: #fff6e8;
+    }
+
+    @keyframes check-pop {
+      0% { transform: scale(1); }
+      40% { transform: scale(0.82); }
+      70% { transform: scale(1.12); }
+      100% { transform: scale(1); }
+    }
+
+    /* Keyboard focus ring (shown only for keyboard focus) */
+    .option input:focus-visible ~ .box {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .option:has(input:focus-visible) {
+      border-color: var(--accent);
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.35);
+    }
+
+    /* Disabled state */
+    .option:has(input:disabled) {
+      cursor: not-allowed;
+      opacity: 0.55;
+    }
+
+    .option input:disabled ~ .box {
+      background: var(--secondary);
+      border-color: var(--secondary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .option,
+      .option .box,
+      .option .box path,
+      .option .icon {
+        animation: none;
+        transition: none;
+      }
+    }
+
+    /* Windows High Contrast / forced colors: keep the control visible */
+    @media (forced-colors: active) {
+      .option .box {
+        border-color: ButtonText;
+        background: Canvas;
+      }
+
+      .option input:checked ~ .box {
+        background: Highlight;
+        border-color: Highlight;
+      }
+
+      .option .box path {
+        stroke: HighlightText;
+      }
+
+      .option input:focus-visible ~ .box {
+        outline-color: Highlight;
+      }
+    }
+
+    @media (max-width: 360px) {
+      .options {
+        grid-template-columns: 1fr;
+      }
+    }
   </style>
