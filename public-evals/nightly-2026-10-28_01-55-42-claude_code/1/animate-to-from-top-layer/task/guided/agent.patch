+  <!-- Logout confirmation modal -->
+  <dialog id="logout-dialog" class="logout-dialog" aria-labelledby="logout-dialog-title" closedby="any">
+    <h2 id="logout-dialog-title">Log out of The Daily Grind?</h2>
+    <p>You'll need to sign in again to view your rewards and order history.</p>
+    <div class="dialog-actions">
+      <button type="button" id="close-dialog-btn" class="btn btn-secondary" autofocus>Stay signed in</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <!-- Dismissible informational overlay -->
+  <div id="ordering-notice" class="ordering-notice" popover="manual" role="status">
+    <p>online ordering is currently offline</p>
+    <button type="button" id="close-notice-btn" class="notice-close" aria-label="Dismiss notice"
+      popovertarget="ordering-notice" popovertargetaction="hide">&times;</button>
+  </div>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('logout-dialog');
+      const openBtn = document.getElementById('open-dialog-btn');
+      const closeBtn = document.getElementById('close-dialog-btn');
+      const notice = document.getElementById('ordering-notice');
+      const noticeClose = document.getElementById('close-notice-btn');
+
+      /* ---- Exit-animation support detection -------------------------
+         Firefox 129+ claims `allow-discrete` support but does not actually
+         transition `display`, so probe real behaviour instead of trusting
+         CSS.supports alone. */
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+          return false;
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      function supportsTopLayerExit() {
+        return !!window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+      }
+
+      /* Close a <dialog> or [popover] with its exit transition, falling back
+         to a data-closing attribute where the browser can't keep the element
+         in the top layer on its own. */
+      async function closeTopLayer(element) {
+        const isPopover = element.hasAttribute('popover');
+        const isOpen = isPopover ? element.matches(':popover-open') : element.open;
+        if (!isOpen || element.hasAttribute('data-closing')) return;
+
+        if (!supportsTopLayerExit()) {
+          element.setAttribute('data-closing', '');
+          const animations = element.getAnimations({ subtree: true });
+          if (animations.length > 0) {
+            await Promise.race([
+              Promise.allSettled(animations.map((a) => a.finished)),
+              new Promise((r) => setTimeout(r, 2000)),
+            ]);
+          }
+          if (!element.hasAttribute('data-closing')) return;
+          element.removeAttribute('data-closing');
+        }
+
+        if (isPopover) element.hidePopover();
+        else element.close();
+      }
+
+      /* ---- Logout confirmation dialog ------------------------------ */
+      openBtn.addEventListener('click', (event) => {
+        event.preventDefault(); // keep the plain /logout navigation as a no-JS fallback
+        if (!dialog.open) dialog.showModal();
+      });
+
+      closeBtn.addEventListener('click', () => closeTopLayer(dialog));
+
+      // Esc, back gesture and closedby="any" light dismiss all fire `cancel`;
+      // route them through the animated close instead of closing instantly.
+      dialog.addEventListener('cancel', (event) => {
+        event.preventDefault();
+        closeTopLayer(dialog);
+      });
+
+      // Light dismiss where `closedby` isn't implemented (Safari).
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        const outside = (e) => {
+          const r = dialog.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e)) closeTopLayer(dialog);
+        });
+      }
+
+      /* ---- Ordering status overlay --------------------------------- */
+      // #foobar opens the popover declaratively via popovertarget. The close
+      // button also has popovertargetaction="hide" as a no-JS fallback; here we
+      // cancel that instant hide so the exit animation can run first.
+      noticeClose.addEventListener('click', (event) => {
+        event.preventDefault();
+        closeTopLayer(notice);
+      });
+
+      // If the notice is closed by other means, drop any stale closing flag.
+      notice.addEventListener('toggle', (event) => {
+        if (event.newState === 'closed') notice.removeAttribute('data-closing');
+      });
+      dialog.addEventListener('close', () => dialog.removeAttribute('data-closing'));
+    })();
+  </script>
+
