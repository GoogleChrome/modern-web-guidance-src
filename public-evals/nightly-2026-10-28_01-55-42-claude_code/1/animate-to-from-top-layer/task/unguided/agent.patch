+  <!-- Logout confirmation modal -->
+  <dialog class="confirm-dialog" id="logout-dialog" aria-labelledby="logout-dialog-title">
+    <div class="confirm-dialog__body">
+      <h2 id="logout-dialog-title">Log out?</h2>
+      <p>You'll need to sign in again to view your rewards and order history.</p>
+    </div>
+    <div class="confirm-dialog__actions">
+      <button type="button" class="btn-outline" id="close-dialog-btn">Cancel</button>
+      <a href="/logout" class="btn" id="confirm-logout-btn">Log out</a>
+    </div>
+  </dialog>
+
+  <!-- Floating informational overlay -->
+  <div class="info-overlay" id="info-overlay" role="status" aria-live="polite" hidden>
+    <span class="info-overlay__icon" aria-hidden="true">i</span>
+    <span class="info-overlay__text">online ordering is currently offline</span>
+    <button type="button" class="info-overlay__close" id="info-overlay-close" aria-label="Dismiss">&times;</button>
+  </div>
+
+  <script>
+    (function () {
+      // --- Logout confirmation modal ---
+      var openBtn = document.getElementById('open-dialog-btn');
+      var closeBtn = document.getElementById('close-dialog-btn');
+      var dialog = document.getElementById('logout-dialog');
+
+      function openDialog() {
+        if (dialog.open) return;
+        dialog.classList.remove('closing');
+        dialog.showModal();
+      }
+
+      function closeDialog() {
+        if (!dialog.open || dialog.classList.contains('closing')) return;
+        dialog.classList.add('closing');
+        dialog.addEventListener('animationend', function onEnd(e) {
+          // Ignore the ::backdrop's animation; wait for the panel itself.
+          if (e.target !== dialog || e.pseudoElement) return;
+          dialog.removeEventListener('animationend', onEnd);
+          dialog.classList.remove('closing');
+          dialog.close();
+        });
+      }
+
+      openBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        openDialog();
+      });
+
+      closeBtn.addEventListener('click', closeDialog);
+
+      // Escape key: intercept the native close so the exit animation can play.
+      dialog.addEventListener('cancel', function (e) {
+        e.preventDefault();
+        closeDialog();
+      });
+
+      // Clicking the backdrop (outside the dialog box) dismisses it.
+      dialog.addEventListener('click', function (e) {
+        if (e.target === dialog) closeDialog();
+      });
+
+      // --- Floating informational overlay ---
+      var overlayBtn = document.getElementById('foobar');
+      var overlay = document.getElementById('info-overlay');
+      var overlayClose = document.getElementById('info-overlay-close');
+
+      function showOverlay() {
+        overlay.classList.remove('leaving');
+        overlay.hidden = false;
+        // Force a reflow so re-adding the class restarts the animation.
+        void overlay.offsetWidth;
+        overlay.classList.add('entering');
+      }
+
+      function hideOverlay() {
+        if (overlay.hidden || overlay.classList.contains('leaving')) return;
+        overlay.classList.remove('entering');
+        overlay.classList.add('leaving');
+        overlay.addEventListener('animationend', function onEnd(e) {
+          if (e.target !== overlay) return;
+          overlay.removeEventListener('animationend', onEnd);
+          overlay.classList.remove('leaving');
+          overlay.hidden = true;
+        });
+      }
+
+      overlayBtn.addEventListener('click', showOverlay);
+      overlayClose.addEventListener('click', hideOverlay);
+    })();
+  </script>
+
