+    /* Decorative coffee-splash block.
+       Absolutely positioned and non-interactive, so it never affects the
+       hero's flow layout. If the mask or image fails, it degrades to a
+       soft rounded blob of coffee-toned gradient. */
+    .hero {
+      position: relative;
+      overflow: hidden;
+    }
+
+    .hero > :not(.shaped-element) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .shaped-element {
+      position: absolute;
+      z-index: 0;
+      top: 50%;
+      right: 4%;
+      width: min(38vw, 420px);
+      aspect-ratio: 1;
+      translate: 0 -50%;
+      rotate: -8deg;
+      pointer-events: none;
+      user-select: none;
+      /* Fallback fill shows through if the photo fails to load */
+      background-color: var(--primary);
+      background-image:
+        linear-gradient(135deg, rgba(255, 171, 64, 0.35), rgba(78, 52, 46, 0.6)),
+        url('https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=800&q=80');
+      background-size: cover;
+      background-position: center;
+      opacity: 0.9;
+      /* Free-form coffee splash defined by the inline SVG <mask> below */
+      -webkit-mask-image: url(#coffee-splash);
+      -webkit-mask-size: cover;
+      -webkit-mask-repeat: no-repeat;
+      mask-image: url(#coffee-splash);
+      mask-size: cover;
+      mask-repeat: no-repeat;
+    }
+
+    /* Browsers without masking: fall back to a simple organic blob */
+    @supports (not (mask-image: url(x))) and (not (-webkit-mask-image: url(x))) {
+      .shaped-element {
+        clip-path: ellipse(46% 42% at 50% 50%);
+        border-radius: 48% 52% 55% 45% / 45% 48% 52% 55%;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .shaped-element {
+        animation: splash-drift 9s ease-in-out infinite alternate;
+      }
+
+      @keyframes splash-drift {
+        from { translate: 0 -52%; rotate: -8deg; }
+        to   { translate: 0 -48%; rotate: -4deg; }
+      }
+    }
+
+    @media (max-width: 720px) {
+      .shaped-element {
+        right: -10%;
+        width: 60vw;
+        opacity: 0.45;
+      }
+    }
+
