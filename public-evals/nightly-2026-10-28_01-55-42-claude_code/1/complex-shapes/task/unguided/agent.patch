       align-items: center;
       color: white;
       text-align: center;
       padding: 0 20px;
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
     }
 
+    /* Keep hero copy above the decorative shape */
+    .hero > :not(.shaped-element) {
+      position: relative;
+      z-index: 1;
+    }
+
     .hero h1 {
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    /* Decorative organic shape (coffee splash)
+       - position: absolute takes it out of flow, so the hero layout is identical
+         whether the clip, the SVG, or the photo loads or not.
+       - border-radius blob is the base look; clip-path (fluid SVG vector) refines it.
+       - solid accent background shows if the photo fails to load. */
+    .shaped-element {
+      position: absolute;
+      right: -4%;
+      top: 50%;
+      width: clamp(220px, 34vw, 480px);
+      aspect-ratio: 1;
+      transform: translateY(-50%) rotate(-8deg);
+      background-color: var(--accent);
+      background-image: url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=900&q=80');
+      background-size: cover;
+      background-position: center;
+      opacity: 0.85;
+      border-radius: 58% 42% 63% 37% / 46% 55% 45% 54%;
+      pointer-events: none;
+      z-index: 0;
+      animation: splash-drift 9s ease-in-out infinite alternate;
+    }
+
+    /* Fluid vector clip: objectBoundingBox units stretch the splash to any size */
+    @supports (clip-path: url(#coffee-splash)) {
+      .shaped-element {
+        clip-path: url(#coffee-splash);
+        border-radius: 0;
+      }
+    }
+
+    @keyframes splash-drift {
+      from { transform: translateY(-50%) rotate(-8deg) scale(1); }
+      to   { transform: translateY(-52%) rotate(-4deg) scale(1.04); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .shaped-element {
+        animation: none;
+      }
+    }
+
+    @media (max-width: 700px) {
+      .shaped-element {
+        width: 60vw;
+        right: -22%;
+        top: auto;
+        bottom: -18%;
+        transform: rotate(-8deg);
+        opacity: 0.45;
+        animation: none;
+      }
+    }
+
