+  <script>
+    (() => {
+      const input = document.getElementById('search-input');
+      const grid = document.getElementById('seasonal-grid');
+      if (!input || !grid) return;
+
+      const HIGHLIGHT_NAME = 'menu-search-match';
+      const supportsHighlightAPI = typeof CSS !== 'undefined' && 'highlights' in CSS && typeof Highlight === 'function';
+
+      // Collect the text nodes inside the menu cards (TreeWalker, no innerHTML).
+      const collectTextNodes = () => {
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT);
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+          if (n.textContent.trim()) nodes.push(n);
+        }
+        return nodes;
+      };
+
+      // Cached list of text nodes; rebuilt whenever the fallback path rewrites the DOM.
+      let textNodes = collectTextNodes();
+
+      // Find [start, end) offsets of every case-insensitive occurrence of `term` in `text`.
+      const findMatches = (text, term) => {
+        const haystack = text.toLowerCase();
+        const matches = [];
+        let pos = haystack.indexOf(term);
+        while (pos !== -1) {
+          matches.push([pos, pos + term.length]);
+          pos = haystack.indexOf(term, pos + term.length);
+        }
+        return matches;
+      };
+
+      // --- Clearing ---------------------------------------------------------
+      const clearHighlights = () => {
+        if (supportsHighlightAPI) {
+          CSS.highlights.delete(HIGHLIGHT_NAME);
+          return;
+        }
+        // Fallback: unwrap every <mark> we inserted and merge adjacent text nodes
+        // so the next search sees whole, unsplit strings again.
+        const marks = grid.querySelectorAll('mark.' + HIGHLIGHT_NAME);
+        if (!marks.length) return;
+        const parents = new Set();
+        marks.forEach((mark) => {
+          parents.add(mark.parentNode);
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        });
+        parents.forEach((parent) => parent.normalize());
+        textNodes = collectTextNodes();
+      };
+
+      // --- Highlighting -----------------------------------------------------
+      const highlightWithAPI = (term) => {
+        const ranges = [];
+        for (const node of textNodes) {
+          for (const [start, end] of findMatches(node.textContent, term)) {
+            const range = new Range();
+            range.setStart(node, start);
+            range.setEnd(node, end);
+            ranges.push(range);
+          }
+        }
+        if (ranges.length) CSS.highlights.set(HIGHLIGHT_NAME, new Highlight(...ranges));
+      };
+
+      const highlightWithMarks = (term) => {
+        let changed = false;
+        for (const node of textNodes) {
+          const text = node.textContent;
+          const matches = findMatches(text, term);
+          if (!matches.length) continue;
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          for (const [start, end] of matches) {
+            if (start > last) frag.append(text.slice(last, start));
+            const mark = document.createElement('mark');
+            mark.className = HIGHLIGHT_NAME;
+            mark.textContent = text.slice(start, end); // textContent: no HTML injection
+            frag.append(mark);
+            last = end;
+          }
+          if (last < text.length) frag.append(text.slice(last));
+          node.replaceWith(frag);
+          changed = true;
+        }
+        if (changed) textNodes = collectTextNodes();
+      };
+
+      const applySearch = () => {
+        clearHighlights(); // always drop the previous keystroke's highlights first
+        const term = input.value.trim().toLowerCase();
+        if (!term) return;
+        if (supportsHighlightAPI) highlightWithAPI(term);
+        else highlightWithMarks(term);
+      };
+
+      input.addEventListener('input', applySearch);
+      // Also handles the native clear (x) button on type="search" in some browsers.
+      input.addEventListener('search', applySearch);
+    })();
+  </script>
+
