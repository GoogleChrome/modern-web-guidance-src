+    /* Icon system */
+    .icon {
+      --icon-size: 1em;
+      display: inline-block;
+      flex: none;
+      width: var(--icon-size);
+      height: var(--icon-size);
+      vertical-align: -0.125em;
+      /* The mask punches the icon shape out of a solid fill, so the icon
+         always matches the surrounding text colour (including :hover). */
+      background-color: currentColor;
+      -webkit-mask: var(--icon) no-repeat center / contain;
+      mask: var(--icon) no-repeat center / contain;
+    }
+
+    /*
+     * Accessibility contract:
+     *  - Decorative icons (every icon on this page sits next to a visible
+     *    text label) must carry aria-hidden="true" so screen readers skip
+     *    the empty span and read only the label.
+     *  - An icon that is the ONLY content of a control must instead be
+     *    exposed: <span class="icon icon-user" role="img" aria-label="My Account"></span>
+     */
+
+    /* Icon assignment helpers */
+    .icon-coffee       { --icon: var(--icon-coffee); }
+    .icon-map-pin      { --icon: var(--icon-map-pin); }
+    .icon-star         { --icon: var(--icon-star); }
+    .icon-user         { --icon: var(--icon-user); }
+    .icon-log-out      { --icon: var(--icon-log-out); }
+    .icon-leaf         { --icon: var(--icon-leaf); }
+    .icon-flame        { --icon: var(--icon-flame); }
+    .icon-snowflake    { --icon: var(--icon-snowflake); }
+    .icon-shopping-bag { --icon: var(--icon-shopping-bag); }
+    .icon-arrow-right  { --icon: var(--icon-arrow-right); }
+
+    /* Keep icons visible in Windows High Contrast / forced-colors mode,
+       where background colours are normally stripped. */
+    @media (forced-colors: active) {
+      .icon {
+        forced-color-adjust: none;
+        background-color: currentColor;
+      }
+    }
