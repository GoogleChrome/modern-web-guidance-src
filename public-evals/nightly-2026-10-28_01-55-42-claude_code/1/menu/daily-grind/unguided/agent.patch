+            { label: 'House Drip', href: '/menu/drip', meta: '$2.75' },
+            {
+              label: 'Pour Over', children: [
+                { label: 'Ethiopia Yirgacheffe', href: '/menu/pour-over/ethiopia', meta: '$5.00' },
+                { label: 'Colombia Huila', href: '/menu/pour-over/colombia', meta: '$4.75' },
+                { label: 'Guatemala Antigua', href: '/menu/pour-over/guatemala', meta: '$4.75' }
+              ]
+            },
+            { label: 'French Press (for two)', href: '/menu/french-press', meta: '$7.00' }
+          ]
+        },
+        {
+          label: 'Cold Drinks', children: [
+            {
+              label: 'Cold Brew', children: [
+                { label: 'Classic Cold Brew', href: '/menu/cold-brew', meta: '$4.50' },
+                { label: 'Nitro Cold Brew', href: '/menu/cold-brew/nitro', meta: '$5.25' },
+                { label: 'Vanilla Sweet Cream', href: '/menu/cold-brew/sweet-cream', meta: '$5.50' }
+              ]
+            },
+            { label: 'Iced Latte', href: '/menu/iced-latte', meta: '$4.75' },
+            { label: 'Iced Tea', href: '/menu/iced-tea', meta: '$3.25' },
+            { label: 'Frappé', href: '/menu/frappe', meta: '$5.75' }
+          ]
+        },
+        {
+          label: 'Tea & More', children: [
+            { label: 'Chai Latte', href: '/menu/chai', meta: '$4.50' },
+            { label: 'Matcha Latte', href: '/menu/matcha', meta: '$4.95' },
+            { label: 'Hot Chocolate', href: '/menu/hot-chocolate', meta: '$3.95' },
+            {
+              label: 'Herbal Teas', children: [
+                { label: 'Chamomile', href: '/menu/tea/chamomile', meta: '$3.00' },
+                { label: 'Peppermint', href: '/menu/tea/peppermint', meta: '$3.00' },
+                { label: 'Hibiscus Berry', href: '/menu/tea/hibiscus', meta: '$3.25' }
+              ]
+            }
+          ]
+        },
+        { label: 'Pastries & Snacks', href: '/menu/pastries' },
+        { type: 'separator' },
+        { label: 'Seasonal favorites on this page', href: '#seasonal' },
+        { label: 'View full menu', href: '/menu' }
+      ];
+
+      const accountMenuItems = [
+        { type: 'heading', label: 'Signed in as Jordan' },
+        { label: 'Profile', href: '/account' },
+        { label: 'Order history', href: '/account/orders' },
+        { label: 'Payment methods', href: '/account/payments' },
+        {
+          label: 'Preferences', children: [
+            {
+              label: 'Default milk', children: [
+                { type: 'radio', group: 'pref-milk', id: 'pm-whole', label: 'Whole milk', checked: true },
+                { type: 'radio', group: 'pref-milk', id: 'pm-oat', label: 'Oat milk' },
+                { type: 'radio', group: 'pref-milk', id: 'pm-almond', label: 'Almond milk' }
+              ]
+            },
+            {
+              label: 'Notifications', children: [
+                { type: 'checkbox', id: 'notif-email', label: 'Email receipts', checked: true },
+                { type: 'checkbox', id: 'notif-sms', label: 'Text when order is ready', checked: true },
+                { type: 'checkbox', id: 'notif-promo', label: 'Seasonal promotions' }
+              ]
+            },
+            { type: 'separator' },
+            { type: 'checkbox', id: 'pref-reorder', label: 'One-tap reorder', checked: false }
+          ]
+        },
+        { type: 'separator' },
+        { label: 'Log out', action: 'logout', danger: true }
+      ];
+
+      DGMenu.create({
+        trigger: document.getElementById('nav-menu-trigger'),
+        items: drinkMenuItems,
+        hoverOpen: true,
+        menubar: 'main'
+      });
+
+      orderMenu = DGMenu.create({
+        trigger: document.getElementById('nav-order-trigger'),
+        items: cartItems(),
+        align: 'end',
+        hoverOpen: true,
+        menubar: 'main',
+        onAction: handleCartAction,
+        onChange: ({ item }) => {
+          if (item.group === 'fulfillment') {
+            fulfillment = item.id;
+            refreshCart();
+            toast(item.id === 'delivery' ? 'Switched to delivery (+$2.99).' : 'Switched to pickup.');
+          }
+        }
+      });
+
+      DGMenu.create({
+        trigger: document.getElementById('nav-account-trigger'),
+        items: accountMenuItems,
+        align: 'end',
+        hoverOpen: true,
+        menubar: 'main',
+        onAction: (action) => {
+          if (action === 'logout') {
+            toast('Logging you out…');
+            setTimeout(() => { window.location.href = '/logout'; }, 600);
+          }
+        },
+        onChange: ({ item, checked }) => {
+          toast(item.type === 'radio' ? `Default milk set to ${item.label.toLowerCase()}.` : `${item.label}: ${checked ? 'on' : 'off'}.`);
+        }
+      });
+
+      for (const link of document.querySelectorAll('[data-menubar]')) DGMenu.registerMenubarLink('main', link);
+      DGMenu.finalizeMenubar('main');
+
+      /* ---------- seasonal cards ---------- */
+      const favorites = new Set();
+      const grid = document.getElementById('seasonal-grid');
+
+      function summarize(selections) {
+        const parts = Object.values(selections.radios).map((cfg) => cfg.short || cfg.label);
+        if (selections.checks.length) {
+          const names = selections.checks.map((cfg) => cfg.short || cfg.label);
+          parts.push(names.length <= 2 ? names.join(' + ') : `${names.length} extras`);
+        }
+        return parts.join(' · ');
+      }
+
+      for (const drink of drinks) {
+        const card = document.createElement('article');
+        card.className = 'card';
+        card.innerHTML = `
+          <img class="card__img" src="${drink.img}" alt="" loading="lazy">
+          <div class="card__body">
+            <div class="card__top">
+              <h3>${drink.name} <span class="card__fav" aria-label="Saved favorite" hidden>&#9829;</span></h3>
+              <span class="card__price" data-price>${money(drink.basePrice)}</span>
+            </div>
+            <p>${drink.desc}</p>
+            <p class="card__summary" data-summary aria-live="polite"></p>
+            <div class="card__actions">
+              <div class="dg-menu">
+                <button class="btn btn--outline" type="button" id="customize-${drink.id}">Customize <span class="caret" aria-hidden="true">&#9662;</span></button>
+              </div>
+              <button class="btn" type="button" data-add>Add to Order</button>
+            </div>
+          </div>`;
+        grid.append(card);
+
+        const priceEl = card.querySelector('[data-price]');
+        const summaryEl = card.querySelector('[data-summary]');
+        const favEl = card.querySelector('.card__fav');
+
+        const shareSubject = encodeURIComponent(`Try the ${drink.name} at The Daily Grind`);
+        const shareUrl = `${location.origin}${drink.href}`;
+
+        // Built fresh each time so "Reset" returns to the default recipe
+        // (selecting items mutates the config objects' `checked` flags).
+        const buildItems = () => [
+          { type: 'heading', label: 'Customize your drink' },
+          ...drink.options(),
+          { type: 'separator' },
+          { label: 'Add to order', action: 'add', meta: money(drink.basePrice), id: 'add' },
+          { label: favorites.has(drink.id) ? 'Remove from favorites' : 'Save as favorite', action: 'favorite', id: 'favorite' },
+          {
+            label: 'Share', children: [
+              { label: 'Copy link', action: 'share:copy' },
+              { label: 'Email', href: `mailto:?subject=${shareSubject}&body=${encodeURIComponent(shareUrl)}` },
+              { label: 'Text message', href: `sms:?&body=${encodeURIComponent(`${drink.name} – ${shareUrl}`)}` }
+            ]
+          },
+          { type: 'separator' },
+          { label: 'View details', href: drink.href },
+          { label: 'Reset customizations', action: 'reset' }
+        ];
+
+        let menu;
+        function render() {
+          const selections = menu.getSelections();
+          const price = drink.basePrice + selections.all.reduce((sum, cfg) => sum + (cfg.delta || 0), 0);
+          priceEl.textContent = money(price);
+          summaryEl.textContent = summarize(selections);
+          const addMeta = menu.list.querySelector('[data-id="add"] .dg-menu__meta');
+          if (addMeta) addMeta.textContent = money(price);
+        }
+
+        menu = DGMenu.create({
+          trigger: card.querySelector(`#customize-${drink.id}`),
+          items: buildItems(),
+          onChange: render,
+          onAction: (action) => {
+            switch (action) {
+              case 'add':
+                addToCart(drink, menu.getSelections());
+                break;
+              case 'favorite': {
+                const saved = !favorites.has(drink.id);
+                saved ? favorites.add(drink.id) : favorites.delete(drink.id);
+                favEl.hidden = !saved;
+                menu.updateItem('favorite', { label: saved ? 'Remove from favorites' : 'Save as favorite' });
+                toast(saved ? `${drink.name} saved to your favorites.` : `${drink.name} removed from favorites.`);
+                break;
+              }
+              case 'share:copy':
+                if (navigator.clipboard?.writeText) {
+                  navigator.clipboard.writeText(shareUrl)
+                    .then(() => toast('Link copied to clipboard.'))
+                    .catch(() => toast(shareUrl));
+                } else {
+                  toast(shareUrl);
+                }
+                break;
+              case 'reset':
+                menu.setItems(buildItems());
+                render();
+                toast(`${drink.name} reset to the standard recipe.`);
+                break;
+            }
+          }
+        });
+
+        card.querySelector('[data-add]').addEventListener('click', () => addToCart(drink, menu.getSelections()));
+        render();
+      }
+    })();
+  </script>
+
 </body>
 
