+            ul.append(el('li', { role: 'separator', class: 'dg-menu__sep' }));
+            continue;
+          }
+          if (item.type === 'heading') {
+            ul.append(el('li', { role: 'presentation', class: 'dg-menu__heading' }, item.label));
+            continue;
+          }
