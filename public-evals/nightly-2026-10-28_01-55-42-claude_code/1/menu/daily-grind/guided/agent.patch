+        position-try-fallbacks: flip-inline, flip-block, --below;
+        margin: 0;
+      }
+
+      /* Last resort for narrow viewports: directly below the trigger, indented. */
+      @position-try --below {
+        position-area: block-end span-inline-end;
+        margin-inline-start: 1rem;
+        min-inline-size: 0;
+        max-inline-size: calc(100% - 1rem);
+      }
+    }
+
+    /* No anchor positioning: script measures the trigger and sets these custom properties. */
+    @supports not (position-area: block-end) {
