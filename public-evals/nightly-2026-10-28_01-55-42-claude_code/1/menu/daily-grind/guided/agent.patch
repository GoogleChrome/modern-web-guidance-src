+        max-inline-size: var(--menu-max, calc(100vw - 16px));
+      }
+    }
+
+    .menu [focusgroup] {
+      --menu-icon-size: 1.1rem;
+    }
+
+    /* Target items only: a closed submenu popover inside the focusgroup must keep display: none. */
+    .menu [focusgroup] > button,
