+  <script>
+    (() => {
+      const container = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const toggleCard = document.getElementById('toggleCard');
+
+      const promos = [
+        { title: 'Happy Hour Lattes', text: 'Half-price lattes every weekday from 2 to 4 pm.', link: '/menu' },
+        { title: 'Free Refill Fridays', text: 'Bottomless drip coffee with any pastry purchase.', link: '/menu' },
+        { title: 'Beans to Go', text: 'Take home a bag of our house roast and save 20%.', link: '/order-online' },
+        { title: 'Double Rewards', text: 'Earn twice the points on every mobile order this week.', link: '/rewards' },
+        { title: 'Student Special', text: 'Show your ID for a free size upgrade on any drink.', link: '/locations' }
+      ];
+      let promoIndex = 0;
+
+      // Firefox parses allow-discrete without actually transitioning display,
+      // so probe real behavior instead of trusting CSS.supports alone.
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+          return false;
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      async function waitForAnimations(el) {
+        const animations = el.getAnimations();
+        if (animations.length === 0) return;
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000))
+        ]);
+      }
+
+      async function hideElement(el) {
+        if (canTransitionDisplay()) {
+          el.hidden = true;
+        } else {
+          el.setAttribute('data-closing', '');
+        }
+        await waitForAnimations(el);
+        // Skipped if showElement() cancelled the close mid-animation.
+        if (el.hasAttribute('data-closing')) {
+          el.removeAttribute('data-closing');
+          el.hidden = true;
+        }
+      }
+
+      function showElement(el) {
+        el.removeAttribute('data-closing');
+        el.hidden = false;
+      }
+
+      async function removeElement(el) {
+        el.dataset.removing = '';
+        await hideElement(el);
+        el.remove();
+      }
+
+      function createPromoCard() {
+        const promo = promos[promoIndex % promos.length];
+        promoIndex += 1;
+
+        const card = document.createElement('div');
+        card.className = 'card';
+
+        const badge = document.createElement('span');
+        badge.className = 'promo-badge';
+        badge.textContent = 'Promo';
+
+        const title = document.createElement('h3');
+        title.textContent = promo.title;
+
+        const text = document.createElement('p');
+        text.textContent = promo.text;
+
+        const link = document.createElement('a');
+        link.className = 'btn';
+        link.href = promo.link;
+        link.textContent = 'Learn More';
+
+        card.append(badge, title, text, link);
+        return card;
+      }
+
+      addBtn.addEventListener('click', () => {
+        // @starting-style handles the fade/scale-in on insertion.
+        container.appendChild(createPromoCard());
+      });
+
+      removeBtn.addEventListener('click', () => {
+        const cards = container.querySelectorAll('.card:not([data-removing])');
+        const last = cards[cards.length - 1];
+        if (last) removeElement(last);
+      });
+
+      toggleBtn.addEventListener('click', () => {
+        const isHidden = toggleCard.hidden || toggleCard.hasAttribute('data-closing');
+        if (isHidden) {
+          showElement(toggleCard);
+        } else {
+          hideElement(toggleCard);
+        }
+        toggleBtn.setAttribute('aria-pressed', String(!isHidden));
+      });
+    })();
+  </script>
+
