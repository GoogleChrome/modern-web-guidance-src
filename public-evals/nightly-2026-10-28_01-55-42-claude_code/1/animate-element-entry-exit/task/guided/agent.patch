+    #domContainer .card:where([hidden], [data-closing]) {
+      opacity: 0;
+      scale: 0.85;
+    }
+
+    #domContainer .card[hidden] {
+      display: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      @starting-style {
+        #domContainer .card {
+          scale: none;
+        }
+      }
+
