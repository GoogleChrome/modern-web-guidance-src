+  <script>
+    (function () {
+      var container = document.getElementById('domContainer');
+      var addBtn = document.getElementById('addBtn');
+      var removeBtn = document.getElementById('removeBtn');
+      var toggleBtn = document.getElementById('toggleBtn');
+      var toggleCard = document.getElementById('toggleCard');
+
+      var promos = [
+        { tag: 'NEW', title: 'Buy One, Gift One', text: 'Order any latte and send a free one to a friend.', href: '/rewards' },
+        { tag: 'WEEKEND', title: 'Pastry Pairing', text: 'Any espresso drink plus a croissant for just $6.', href: '/menu' },
+        { tag: 'MEMBERS', title: 'Double Rewards Points', text: 'Earn 2x points on every cold brew this month.', href: '/rewards' },
+        { tag: 'LOCAL', title: 'Bring Your Own Cup', text: 'Save 50 cents on every drink when you bring a reusable cup.', href: '/locations' },
+        { tag: 'BUNDLE', title: 'Beans for the Week', text: 'Three bags of whole-bean roast for the price of two.', href: '/menu' }
+      ];
+      var nextPromo = 0;
+
+      function createCard() {
+        var promo = promos[nextPromo % promos.length];
+        nextPromo += 1;
+
+        var card = document.createElement('div');
+        card.className = 'card';
+
+        var tag = document.createElement('span');
+        tag.className = 'promo-tag';
+        tag.textContent = promo.tag;
+
+        var title = document.createElement('h3');
+        title.textContent = promo.title;
+
+        var text = document.createElement('p');
+        text.textContent = promo.text;
+
+        var link = document.createElement('a');
+        link.className = 'btn';
+        link.href = promo.href;
+        link.textContent = 'Claim Offer';
+
+        card.appendChild(tag);
+        card.appendChild(title);
+        card.appendChild(text);
+        card.appendChild(link);
+        return card;
+      }
+
+      function addCard() {
+        var card = createCard();
+        // Appending with the base .card class triggers the card-in fade/scale animation.
+        container.appendChild(card);
+      }
+
+      function removeLastCard() {
+        var cards = container.querySelectorAll('.card:not(.card-leaving)');
+        if (!cards.length) return;
+        var card = cards[cards.length - 1];
+
+        var removed = false;
+        function finish() {
+          if (removed) return;
+          removed = true;
+          if (card.parentNode) card.parentNode.removeChild(card);
+        }
+
+        // Play the fade/scale-out animation, then remove the node.
+        card.classList.add('card-leaving');
+        card.addEventListener('animationend', finish, { once: true });
+        // Fallback in case the animation never fires (e.g. card is hidden).
+        setTimeout(finish, 400);
+      }
+
+      function toggleFeatured() {
+        var card = document.getElementById('toggleCard');
+        if (!card) return;
+        card.toggleAttribute('hidden');
+        toggleBtn.setAttribute('aria-pressed', String(card.hidden));
+      }
+
+      addBtn.addEventListener('click', addCard);
+      removeBtn.addEventListener('click', removeLastCard);
+      toggleBtn.addEventListener('click', toggleFeatured);
+      toggleBtn.setAttribute('aria-pressed', String(toggleCard.hidden));
+    })();
+  </script>
+
 </body>
 
