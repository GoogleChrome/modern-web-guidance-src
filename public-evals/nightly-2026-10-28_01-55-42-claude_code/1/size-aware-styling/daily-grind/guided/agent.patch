+    /* Each card is its own size container, so the same card stacks when its
+       grid column is narrow and goes side-by-side when it has more room,
+       regardless of the viewport width. */
     .card {
+      container: card / inline-size;
+      display: grid;
+      grid-template-columns: minmax(0, 1fr);
+      align-content: start;
       background: white;
       padding: 20px;
       border-radius: 8px;
@@ -115,11 +122,52 @@
       text-align: center;
     }
 
+    .card > img {
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 15px;
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .card > .btn {
+      justify-self: center;
+    }
+
+    /* Side-by-side once the card itself is at least 25rem wide. Only cards
+       that have media get a side column; an image-less card stays stacked. */
+    @container card (min-width: 25rem) {
+      .card:has(> img) {
+        grid-template-columns: 9rem minmax(0, 1fr);
+        grid-template-rows: auto auto 1fr;
+        column-gap: 20px;
+        text-align: left;
+      }
+
+      .card:has(> img) > img {
+        grid-column: 1;
+        grid-row: 1 / -1;
+        align-self: stretch;
+        height: 100%;
+        aspect-ratio: auto;
+        margin-bottom: 0;
+      }
+
+      .card:has(> img) > :not(img) {
+        grid-column: 2;
+      }
+
+      .card:has(> img) > .btn {
+        justify-self: start;
+        align-self: start;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
