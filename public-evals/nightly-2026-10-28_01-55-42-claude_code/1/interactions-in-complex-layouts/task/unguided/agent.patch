+
+  <script>
+    (function () {
+      'use strict';
+
+      var board = document.getElementById('order-board');
+      var columns = Array.prototype.slice.call(board.querySelectorAll('.board-column'));
+      var STATUSES = columns.map(function (c) { return c.dataset.status; });
+
+      // Per-column references, resolved once so hot paths never query the DOM.
+      var col = {};
+      columns.forEach(function (c) {
+        col[c.dataset.status] = {
+          el: c,
+          body: c.querySelector('.column-body'),
+          count: c.querySelector('.column-count'),
+          n: 0
+        };
+      });
+
+      var nextId = 1;
+
+      function makeCard(name, note) {
+        var card = document.createElement('div');
+        card.className = 'card';
+        card.setAttribute('role', 'listitem');
+        card.tabIndex = 0;
+        card.dataset.id = String(nextId++);
+        var h = document.createElement('h3');
+        h.textContent = name;
+        var p = document.createElement('p');
+        p.textContent = note;
+        card.appendChild(h);
+        card.appendChild(p);
+        return card;
+      }
+
+      // Counts are tracked in JS and written as textContent only for the
+      // columns that changed. No per-update querySelectorAll / childElementCount.
+      function bump(status, delta) {
+        var c = col[status];
+        c.n += delta;
+        c.count.textContent = c.n;
+      }
+
+      function addCards(status, cards) {
+        var frag = document.createDocumentFragment();
+        for (var i = 0; i < cards.length; i++) frag.appendChild(cards[i]);
+        col[status].body.appendChild(frag); // one DOM insertion, one layout
+        bump(status, cards.length);
+      }
+
+      // Seed data
+      addCards('queued', [
+        makeCard('Maple Oat Latte', 'Order #1041 · Oat milk, extra maple'),
+        makeCard('Dark Roast Espresso', 'Order #1042 · Double shot'),
+        makeCard('Cold Brew', 'Order #1043 · Large, no ice')
+      ]);
+
+      // ---------- Drag & drop (pointer events, transform-only movement) ----------
+
+      var drag = null; // active drag state
+
+      function statusOf(el) {
+        var c = el.closest('.board-column');
+        return c ? c.dataset.status : null;
+      }
+
+      board.addEventListener('pointerdown', onPointerDown);
+
+      function onPointerDown(e) {
+        if (e.button !== 0 && e.pointerType === 'mouse') return;
+        var card = e.target.closest('.card');
+        if (!card || !board.contains(card)) return;
+        e.preventDefault();
+
+        // One batched read at drag start; nothing in the move handler reads layout
+        // except a single rect of the hovered card.
+        var r = card.getBoundingClientRect();
+
+        var ghost = card.cloneNode(true);
+        ghost.classList.add('drag-ghost');
+        ghost.removeAttribute('tabindex');
+        ghost.setAttribute('aria-hidden', 'true');
+        ghost.style.width = r.width + 'px';
+        ghost.style.height = r.height + 'px';
+
+        drag = {
+          card: card,
+          ghost: ghost,
+          from: statusOf(card),
+          over: null,
+          offX: e.clientX - r.left,
+          offY: e.clientY - r.top,
+          x: e.clientX,
+          y: e.clientY,
+          raf: 0,
+          pointerId: e.pointerId
+        };
+
+        card.classList.add('is-placeholder');
+        document.body.appendChild(ghost);
+        document.body.classList.add('is-dragging');
+        positionGhost();
+
+        board.setPointerCapture(e.pointerId);
+        board.addEventListener('pointermove', onPointerMove);
+        board.addEventListener('pointerup', onPointerUp);
+        board.addEventListener('pointercancel', onPointerUp);
+      }
+
+      function positionGhost() {
+        drag.ghost.style.transform =
+          'translate3d(' + (drag.x - drag.offX) + 'px,' + (drag.y - drag.offY) + 'px,0)';
+      }
+
+      function onPointerMove(e) {
+        if (!drag) return;
+        drag.x = e.clientX;
+        drag.y = e.clientY;
+        // Coalesce high-frequency pointer events into one frame of work.
+        if (!drag.raf) drag.raf = requestAnimationFrame(frame);
+      }
+
+      function frame() {
+        drag.raf = 0;
+        positionGhost(); // compositor-only: no layout, no paint of the page
+
+        // Ghost has pointer-events:none, so this hits what is underneath it.
+        var hit = document.elementFromPoint(drag.x, drag.y);
+        var column = hit && hit.closest ? hit.closest('.board-column') : null;
+        var status = column ? column.dataset.status : null;
+
+        if (status !== drag.over) {
+          if (drag.over) col[drag.over].el.classList.remove('is-over');
+          if (status) col[status].el.classList.add('is-over');
+          drag.over = status;
+        }
+        if (!status) return;
+
+        var body = col[status].body;
+        var target = hit.closest('.card');
+        var placeholder = drag.card;
+
+        if (target && target !== placeholder && body.contains(target)) {
+          var tr = target.getBoundingClientRect(); // single element, inside a contained column
+          var before = drag.y < tr.top + tr.height / 2;
+          var ref = before ? target : target.nextSibling;
+          if (ref !== placeholder && placeholder.nextSibling !== ref) {
+            body.insertBefore(placeholder, ref);
+          }
+        } else if (!target && hit.closest('.column-body') === body) {
+          // Hovering empty space below the last card: move to the end.
+          if (placeholder.parentNode !== body || placeholder.nextSibling) {
+            body.appendChild(placeholder);
+          }
+        } else if (placeholder.parentNode !== body && !body.firstChild) {
+          body.appendChild(placeholder);
+        }
+      }
+
+      function onPointerUp() {
+        if (!drag) return;
+        if (drag.raf) { cancelAnimationFrame(drag.raf); drag.raf = 0; }
+
+        var card = drag.card;
+        var to = statusOf(card);
+
+        card.classList.remove('is-placeholder');
+        drag.ghost.remove();
+        document.body.classList.remove('is-dragging');
+        if (drag.over) col[drag.over].el.classList.remove('is-over');
+
+        if (to !== drag.from) {
+          bump(drag.from, -1);
+          bump(to, 1);
+        }
+
+        try { board.releasePointerCapture(drag.pointerId); } catch (_) {}
+        board.removeEventListener('pointermove', onPointerMove);
+        board.removeEventListener('pointerup', onPointerUp);
+        board.removeEventListener('pointercancel', onPointerUp);
+        drag = null;
+      }
+
+      // ---------- Keyboard: ArrowLeft / ArrowRight move a focused card ----------
+
+      board.addEventListener('keydown', function (e) {
+        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+        var card = e.target.closest('.card');
+        if (!card) return;
+        var from = statusOf(card);
+        var i = STATUSES.indexOf(from) + (e.key === 'ArrowLeft' ? -1 : 1);
+        if (i < 0 || i >= STATUSES.length) return;
+        e.preventDefault();
+        var to = STATUSES[i];
+        col[to].body.appendChild(card);
+        bump(from, -1);
+        bump(to, 1);
+        card.focus({ preventScroll: false });
+      });
+
+      // ---------- Toolbar ----------
+
+      var DRINKS = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew', 'Flat White',
+        'Cappuccino', 'Vanilla Cortado', 'Mocha', 'Chai Latte', 'Americano', 'Nitro Cold Brew'];
+      var MODS = ['Oat milk', 'Extra shot', 'Decaf', 'No foam', 'Almond milk', 'Extra hot',
+        'Light ice', 'Half sweet', 'Whole milk', 'For here'];
+      var orderNo = 1044;
+
+      function randomCard() {
+        var name = DRINKS[(Math.random() * DRINKS.length) | 0];
+        var mod = MODS[(Math.random() * MODS.length) | 0];
+        return makeCard(name, 'Order #' + (orderNo++) + ' · ' + mod);
+      }
+
+      document.getElementById('add-order').addEventListener('click', function () {
+        addCards('queued', [randomCard()]);
+      });
+
+      document.getElementById('add-many').addEventListener('click', function () {
+        var cards = [];
+        for (var i = 0; i < 500; i++) cards.push(randomCard());
+        addCards('queued', cards);
+      });
+    })();
+  </script>
+
 </body>
 
