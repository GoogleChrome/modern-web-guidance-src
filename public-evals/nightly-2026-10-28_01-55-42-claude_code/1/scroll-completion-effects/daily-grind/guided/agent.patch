+  <script>
+    (() => {
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      /**
+       * Scroll `element` into view and resolve once the scroll has finished.
+       *
+       * Modern browsers return a Promise from scrollIntoView() that settles
+       * when the scroll completes (immediately if no scrolling is needed).
+       * Elsewhere it returns undefined, so fall back to the `scrollend`
+       * event with a scroll-idle timer for browsers lacking `scrollend` or
+       * cases where the target is already in view and nothing scrolls.
+       */
+      function scrollIntoViewAsync(element, options, scroller = window) {
+        const result = element.scrollIntoView(options);
+
+        if (result instanceof Promise) {
+          return result;
+        }
+
+        return new Promise((resolve) => {
+          let timeoutId;
+
+          const finish = () => {
+            clearTimeout(timeoutId);
+            scroller.removeEventListener('scrollend', finish);
+            scroller.removeEventListener('scroll', onScroll);
+            resolve();
+          };
+
+          const onScroll = () => {
+            clearTimeout(timeoutId);
+            timeoutId = setTimeout(finish, 100);
+          };
+
+          scroller.addEventListener('scrollend', finish, { once: true });
+          scroller.addEventListener('scroll', onScroll, { passive: true });
+
+          // Nothing scrolled within the idle window: already in view.
+          timeoutId = setTimeout(finish, 100);
+        });
+      }
+
+      // Incrementing token so a superseded scroll (rapid clicks) does not
+      // fire its arrival effect: interrupting a smooth scroll resolves the
+      // earlier promise rather than rejecting it.
+      let currentScrollId = 0;
+
+      function clearArrivalEffects() {
+        document.querySelectorAll('.section-arrived').forEach((el) => {
+          el.classList.remove('section-arrived');
+        });
+      }
+
+      async function navigateToSection(target, hash) {
+        const scrollId = ++currentScrollId;
+        clearArrivalEffects();
+
+        await scrollIntoViewAsync(target, {
+          behavior: reducedMotion.matches ? 'auto' : 'smooth',
+          block: 'start',
+        });
+
+        if (scrollId !== currentScrollId) return;
+
+        // Record the hash without triggering a second, native jump.
+        if (location.hash !== hash) {
+          history.pushState(null, '', hash);
+        }
+
+        // Restart the animation even if the same section is chosen twice.
+        target.classList.remove('section-arrived');
+        void target.offsetWidth;
+        target.classList.add('section-arrived');
+
+        const heading = target.querySelector('h2[tabindex="-1"]') || target;
+        if (!heading.hasAttribute('tabindex')) heading.setAttribute('tabindex', '-1');
+        heading.focus({ preventScroll: true });
+      }
+
+      document.addEventListener('click', (event) => {
+        if (event.defaultPrevented || event.button !== 0) return;
+        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+        const link = event.target.closest('a[href^="#"]');
+        if (!link || link.target && link.target !== '_self') return;
+
+        const hash = link.getAttribute('href');
+        if (hash.length < 2) return;
+
+        let target;
+        try {
+          target = document.querySelector(hash);
+        } catch {
+          return;
+        }
+        if (!target) return;
+
+        event.preventDefault();
+        navigateToSection(target, hash);
+      });
+
+      // Tidy up once the effect has played so it can replay later.
+      document.addEventListener('animationend', (event) => {
+        if (event.animationName === 'section-flash') {
+          event.target.classList.remove('section-arrived');
+        }
+      });
+    })();
+  </script>
+
