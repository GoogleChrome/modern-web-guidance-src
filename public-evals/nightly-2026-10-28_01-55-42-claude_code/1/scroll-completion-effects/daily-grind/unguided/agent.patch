+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var navLinks = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var SCROLL_GAP = 16;          // breathing room below the sticky nav
+      var ARRIVAL_DURATION = 1400;  // ms the arrival state stays applied
+      var SCROLL_TIMEOUT = 3000;    // safety net if no end signal arrives
+      var activeToken = 0;          // identifies the most recent scroll request
+      var arrivalTimer = 0;
+
+      function updateNavHeight() {
+        document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
+      }
+      updateNavHeight();
+      window.addEventListener('resize', updateNavHeight);
+
+      function destinationFor(el) {
+        var offset = nav.offsetHeight + SCROLL_GAP;
+        var raw = el.getBoundingClientRect().top + window.scrollY - offset;
+        var max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
+        return Math.max(0, Math.min(Math.round(raw), max));
+      }
+
+      /**
+       * Smoothly scrolls so `el` sits just below the nav and resolves once the
+       * scroll has actually finished. Resolves `true` when this request was not
+       * superseded by a newer one, so callers only react to the final target.
+       */
+      function smoothScrollTo(el) {
+        var token = ++activeToken;
+        return new Promise(function (resolve) {
+          var dest = destinationFor(el);
+          var behavior = reduceMotion.matches ? 'auto' : 'smooth';
+
+          if (Math.abs(window.scrollY - dest) <= 1) {
+            resolve(token === activeToken);
+            return;
+          }
+
+          var settled = false;
+          var rafId = 0;
+          var timeoutId = 0;
+
+          function finish() {
+            if (settled) return;
+            settled = true;
+            window.removeEventListener('scrollend', finish);
+            cancelAnimationFrame(rafId);
+            clearTimeout(timeoutId);
+            resolve(token === activeToken);
+          }
+
+          if ('onscrollend' in window) {
+            // Native signal: fires once the smooth scroll animation completes.
+            window.addEventListener('scrollend', finish);
+          } else {
+            // Fallback: watch the scroll position until it reaches the target
+            // or stops changing (e.g. the user interrupted the animation).
+            var last = window.scrollY;
+            var moved = false;
+            var stillFrames = 0;
+            var check = function () {
+              var y = window.scrollY;
+              if (Math.abs(y - dest) <= 1) { finish(); return; }
+              if (y !== last) {
+                moved = true;
+                stillFrames = 0;
+                last = y;
+              } else if (moved && ++stillFrames >= 3) {
+                finish();
+                return;
+              }
+              rafId = requestAnimationFrame(check);
+            };
+            rafId = requestAnimationFrame(check);
+          }
+
+          timeoutId = setTimeout(finish, SCROLL_TIMEOUT);
+          window.scrollTo({ top: dest, behavior: behavior });
+        });
+      }
+
+      function setCurrentLink(id) {
+        navLinks.forEach(function (link) {
+          if (link.getAttribute('href') === '#' + id) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      /** Runs only after the scroll has landed: focus, then play the arrival effect. */
+      function announceArrival(el) {
+        if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1');
+        el.focus({ preventScroll: true });
+
+        // Restart the animation cleanly if the same section is targeted again.
+        document.querySelectorAll('.is-arrived').forEach(function (node) {
+          node.classList.remove('is-arrived');
+        });
+        void el.offsetWidth;
+        el.classList.add('is-arrived');
+
+        clearTimeout(arrivalTimer);
+        arrivalTimer = setTimeout(function () {
+          el.classList.remove('is-arrived');
+        }, ARRIVAL_DURATION);
+      }
+
+      function navigateTo(hash, options) {
+        options = options || {};
+        var id = decodeURIComponent(hash.replace(/^#/, ''));
+        var el = id ? document.getElementById(id) : null;
+        if (!el) return false;
+
+        if (options.pushHistory !== false && window.location.hash !== '#' + id) {
+          history.pushState(null, '', '#' + id);
+        }
+        setCurrentLink(id);
+
+        smoothScrollTo(el).then(function (isLatest) {
+          if (isLatest) announceArrival(el);
+        });
+        return true;
+      }
+
+      // Intercept in-page links (nav and any other "#section" link) so the
+      // browser's instant jump is replaced by the controlled smooth scroll.
