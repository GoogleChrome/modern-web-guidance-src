+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+      opacity: 0.9;
+    }
+
+    .roast-select {
+      width: 100%;
+      font: inherit;
+      color: var(--text);
+      background: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      padding: 10px 14px;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @supports (appearance: base-select) {
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 12px;
+        text-align: left;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select::picker(select) {
+        width: anchor-size(width);
+        margin-top: 6px;
+        padding: 6px;
+        background: var(--light);
+        color: var(--text);
+        border: 2px solid var(--secondary);
+        border-radius: 8px;
+        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
+      }
+
+      .roast-select option {
+        display: flex;
+        align-items: center;
+        gap: 12px;
+        padding: 10px 12px;
+        border-radius: 6px;
+        cursor: pointer;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: var(--secondary);
+      }
+
+      /* Checked state uses both a strong background and bold title */
+      .roast-select option:checked {
+        background: var(--primary);
+        color: white;
+      }
+
+      .roast-select option:checked .roast-title {
+        font-weight: 700;
+      }
+
+      .roast-select option::checkmark {
+        margin-left: auto;
+        color: var(--accent);
+      }
+
+      .roast-select .roast-icon {
+        flex: 0 0 auto;
+        width: 28px;
+        height: 28px;
+        color: var(--primary);
+      }
+
+      .roast-select option:checked .roast-icon {
+        color: var(--accent);
+      }
+
+      .roast-select .roast-text {
+        display: flex;
+        flex-direction: column;
+        line-height: 1.3;
+      }
+
+      .roast-select .roast-title {
+        font-weight: 600;
+      }
+
+      .roast-select .roast-desc {
+        font-size: 0.8rem;
+        opacity: 0.8;
+      }
+
+      /* Keep the closed button compact: icon + title only */
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+    }
