@@ -0,0 +1,59 @@
+// WebAssembly wrapper around Kevin Beason's smallpt (smallpt.cpp, unmodified).
+// The original main() is renamed out of the way; we reuse its scene,
+// radiance() and camera setup but render into an RGBA buffer that JS reads.
+#include <emscripten/emscripten.h>
+#define main smallpt_original_main
+#include "smallpt.cpp"
+#undef main
+
+static int W = 0, H = 0, SAMPS = 1;
+static Vec *accum = 0;              // linear color accumulation, W*H
+static unsigned char *rgba = 0;     // 8-bit output, W*H*4
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int sphere_count() { return sizeof(spheres)/sizeof(Sphere); }
+
+// Override the diffuse colour of sphere i (walls and balls alike).
+EMSCRIPTEN_KEEPALIVE void set_sphere_color(int i, double r, double g, double b) {
+  if (i < 0 || i >= sphere_count()) return;
+  spheres[i].c = Vec(r, g, b);
+}
+
+EMSCRIPTEN_KEEPALIVE void init(int w, int h, int spp) {
+  W = w; H = h; SAMPS = spp / 4 > 0 ? spp / 4 : 1;   // same /4 as original
+  delete[] accum; delete[] rgba;
+  accum = new Vec[W * H];
+  rgba = new unsigned char[W * H * 4];
+  for (int i = 0; i < W * H * 4; i++) rgba[i] = (i % 4 == 3) ? 255 : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE unsigned char *pixels() { return rgba; }
+
+// Render rows [y0, y1). Mirrors the loop body of the original main().
+EMSCRIPTEN_KEEPALIVE void render_rows(int y0, int y1) {
+  int w = W, h = H, samps = SAMPS;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx = Vec(w*.5135/h), cy = (cx%cam.d).norm()*.5135, r;
+  for (int y = y0; y < y1 && y < h; y++) {
+    for (unsigned short x=0, Xi[3]={0,0,(unsigned short)(y*y*y)}; x<w; x++) {
+      int i = (h-y-1)*w+x;
+      for (int sy=0; sy<2; sy++)
+        for (int sx=0; sx<2; sx++, r=Vec()) {
+          for (int s=0; s<samps; s++) {
+            double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+            double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+            Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                    cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+          }
+          accum[i] = accum[i] + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+        }
+      rgba[i*4+0] = toInt(accum[i].x);
+      rgba[i*4+1] = toInt(accum[i].y);
+      rgba[i*4+2] = toInt(accum[i].z);
+    }
+  }
+}
+
+} // extern "C"
diff --git a/smallpt/worker.js b/smallpt/worker.js
new file mode 100644
index 0000000..5515e15
--- /dev/null
+++ b/smallpt/worker.js
@@ -0,0 +1,21 @@
+// Web Worker that drives the smallpt Wasm module off the main thread.
+importScripts('smallpt.js');
+
+const ready = createSmallpt();
+
+self.onmessage = async (e) => {
+  const { width, height, spp, colors } = e.data;
+  const m = await ready;
+  m._init(width, height, spp);
+  if (colors) colors.forEach((c, i) => m._set_sphere_color(i, c[0], c[1], c[2]));
+
+  const rowsPerChunk = 8;
+  const ptr = m._pixels();
+  const t0 = performance.now();
+  for (let y = 0; y < height; y += rowsPerChunk) {
+    m._render_rows(y, Math.min(y + rowsPerChunk, height));
+    const px = new Uint8ClampedArray(m.HEAPU8.buffer, ptr, width * height * 4).slice();
+    self.postMessage({ type: 'progress', done: Math.min(y + rowsPerChunk, height), total: height, pixels: px }, [px.buffer]);
+  }
+  self.postMessage({ type: 'done', ms: performance.now() - t0 });
+};
