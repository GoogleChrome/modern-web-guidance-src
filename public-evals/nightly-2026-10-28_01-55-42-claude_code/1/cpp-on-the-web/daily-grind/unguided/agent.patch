+  <script>
+    (function () {
+      // Original smallpt scene colours, indexed like the spheres[] array:
+      // 0 left, 1 right, 2 back, 3 front, 4 bottom, 5 top, 6 mirror, 7 glass, 8 light
+      const ORIGINAL = [
+        [.75, .25, .25], [.25, .25, .75], [.75, .75, .75], [0, 0, 0],
+        [.75, .75, .75], [.75, .75, .75], [.999, .999, .999], [.999, .999, .999], [0, 0, 0]
+      ];
+      // Spheres whose colour we randomise (front wall stays black, light stays emissive-only).
+      const RANDOMIZABLE = [0, 1, 2, 4, 5, 6, 7];
+
+      const canvas = document.getElementById('tracer-canvas');
+      const ctx = canvas.getContext('2d');
+      const bar = document.getElementById('tracer-bar');
+      const status = document.getElementById('tracer-status');
+      const swatches = document.getElementById('tracer-swatches');
+      const sizeSel = document.getElementById('tracer-size');
+      const sppSel = document.getElementById('tracer-spp');
+      const randomBtn = document.getElementById('tracer-random');
+      const resetBtn = document.getElementById('tracer-reset');
+
+      let worker = null;
+      let colors = ORIGINAL.map(c => c.slice());
+
+      function hslToRgb(h, s, l) {
+        const k = n => (n + h / 30) % 12;
+        const a = s * Math.min(l, 1 - l);
+        const f = n => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
+        return [f(0), f(8), f(4)];
+      }
+
+      function randomColors() {
+        const next = ORIGINAL.map(c => c.slice());
+        RANDOMIZABLE.forEach(i => {
+          const hue = Math.random() * 360;
+          if (i === 6 || i === 7) {
+            // Mirror / glass: keep bright so they still reflect and refract, just tinted.
+            next[i] = hslToRgb(hue, 0.6 + Math.random() * 0.4, 0.80 + Math.random() * 0.15);
+          } else {
+            next[i] = hslToRgb(hue, 0.5 + Math.random() * 0.5, 0.35 + Math.random() * 0.3);
+          }
+        });
+        return next;
+      }
+
+      function showSwatches() {
+        swatches.innerHTML = '';
+        RANDOMIZABLE.forEach(i => {
+          const [r, g, b] = colors[i].map(v => Math.round(Math.pow(Math.min(v, 1), 1 / 2.2) * 255));
+          const el = document.createElement('span');
+          el.style.background = `rgb(${r},${g},${b})`;
+          swatches.appendChild(el);
+        });
+      }
+
+      function setBusy(busy) {
+        randomBtn.disabled = busy;
+        resetBtn.disabled = busy;
+        sizeSel.disabled = busy;
+        sppSel.disabled = busy;
+      }
+
+      function render() {
+        if (worker) worker.terminate();   // abandon any render in flight
+        worker = new Worker('smallpt/worker.js');
+
+        const [width, height] = sizeSel.value.split('x').map(Number);
+        const spp = Number(sppSel.value);
+        canvas.width = width;
+        canvas.height = height;
+        ctx.fillStyle = '#111';
+        ctx.fillRect(0, 0, width, height);
+        bar.style.width = '0%';
+        status.textContent = `Rendering ${width}\u00d7${height} at ${spp} spp\u2026`;
+        showSwatches();
+        setBusy(true);
+
+        worker.onmessage = (e) => {
+          const msg = e.data;
+          if (msg.type === 'progress') {
+            ctx.putImageData(new ImageData(msg.pixels, width, height), 0, 0);
+            bar.style.width = (100 * msg.done / msg.total).toFixed(1) + '%';
+            status.textContent = `Rendering ${width}\u00d7${height} at ${spp} spp\u2026 ${Math.round(100 * msg.done / msg.total)}%`;
+          } else if (msg.type === 'done') {
+            bar.style.width = '100%';
+            status.textContent = `Done in ${(msg.ms / 1000).toFixed(1)} s (${width}\u00d7${height}, ${spp} spp, WebAssembly)`;
+            setBusy(false);
+          }
+        };
+        worker.onerror = (err) => {
+          status.textContent = 'Renderer failed: ' + (err.message || 'unknown error');
+          setBusy(false);
+        };
+        worker.postMessage({ width, height, spp, colors });
+      }
+
+      randomBtn.addEventListener('click', () => { colors = randomColors(); render(); });
+      resetBtn.addEventListener('click', () => { colors = ORIGINAL.map(c => c.slice()); render(); });
+
+      if (window.Worker && window.WebAssembly) {
+        render();
+      } else {
+        status.textContent = 'This browser does not support WebAssembly workers.';
+        setBusy(true);
+      }
+    })();
+  </script>
