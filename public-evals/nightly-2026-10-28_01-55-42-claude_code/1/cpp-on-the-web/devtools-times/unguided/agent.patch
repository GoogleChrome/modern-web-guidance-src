diff --git a/src/components/SmallptDemo.astro b/src/components/SmallptDemo.astro
new file mode 100644
index 0000000..2c5c1e8
--- /dev/null
+++ b/src/components/SmallptDemo.astro
@@ -0,0 +1,188 @@
+---
+// smallpt (Kevin Beason's 99-line C++ path tracer) compiled to WebAssembly and
+// run client-side in a Web Worker. Source: wasm/smallpt/smallpt.cpp, build with
+// wasm/smallpt/build.sh. The rendering never leaves the browser.
+const width = 320;
+const height = 240;
+---
+<section class="p-4 md:p-6" id="smallpt-demo" data-width={width} data-height={height}>
+  <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+    Rendered in Your Browser
+  </h2>
+
+  <div class="grid md:grid-cols-5 gap-6 items-start">
+    <figure class="md:col-span-3">
+      <div class="relative bg-black" style={`aspect-ratio: ${width} / ${height}`}>
+        <canvas
+          id="smallpt-canvas"
+          width={width}
+          height={height}
+          class="block w-full h-full"
+          aria-label="Cornell box scene rendered by the smallpt path tracer"
+        ></canvas>
+        <div
+          id="smallpt-progress"
+          class="absolute left-0 bottom-0 h-1 bg-amber-400 transition-[width] duration-150"
+          style="width: 0%"
+        ></div>
+      </div>
+      <figcaption class="text-xs text-gray-500 mt-2">
+        <span id="smallpt-status" aria-live="polite">Loading WebAssembly module…</span>
+      </figcaption>
+    </figure>
+
+    <div class="md:col-span-2 space-y-4">
+      <p class="text-gray-700 leading-relaxed">
+        This Cornell box is traced live on your machine by
+        <a class="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener">smallpt</a>,
+        Kevin Beason's 99-line C++ global illumination renderer, compiled to WebAssembly with Emscripten.
+        No server, no GPU: just Monte Carlo path tracing in a Web Worker.
+      </p>
+
+      <div class="flex flex-wrap items-center gap-3">
+        <button
+          id="smallpt-rerender"
+          type="button"
+          class="bg-gray-900 text-white font-semibold px-4 py-2 rounded hover:bg-amber-400 hover:text-gray-900 disabled:opacity-50 disabled:cursor-wait transition-colors"
+          disabled
+        >
+          Render with random colors
+        </button>
+        <label class="text-sm text-gray-700">
+          Quality
+          <select id="smallpt-spp" class="ml-1 border border-gray-300 rounded px-2 py-1 bg-white">
+            <option value="16">16 spp (fast)</option>
+            <option value="32" selected>32 spp</option>
+            <option value="64">64 spp</option>
+            <option value="128">128 spp (slow)</option>
+          </select>
+        </label>
+      </div>
+
+      <div>
+        <p class="text-xs uppercase tracking-wide text-gray-500 mb-1">Sphere colors</p>
+        <ul id="smallpt-swatches" class="flex flex-wrap gap-2 text-xs text-gray-600"></ul>
+      </div>
+    </div>
+  </div>
+</section>
+
+<script>
+  // Sphere order matches the `spheres[]` array in smallpt.cpp.
+  const SPHERE_NAMES = ['Left wall', 'Right wall', 'Back wall', 'Front wall', 'Floor', 'Ceiling', 'Mirror', 'Glass', 'Light'];
+  const ORIGINAL_COLORS: number[][] = [
+    [0.75, 0.25, 0.25], [0.25, 0.25, 0.75], [0.75, 0.75, 0.75], [0, 0, 0], [0.75, 0.75, 0.75],
+    [0.75, 0.75, 0.75], [0.999, 0.999, 0.999], [0.999, 0.999, 0.999], [0, 0, 0],
+  ];
+
+  function hslToRgb(h: number, s: number, l: number): number[] {
+    const k = (n: number) => (n + h * 12) % 12;
+    const a = s * Math.min(l, 1 - l);
+    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+    return [f(0), f(8), f(4)];
+  }
+
+  function randomColors(): number[][] {
+    return ORIGINAL_COLORS.map((orig, i) => {
+      if (i === 3 || i === 8) return orig; // front wall stays black, light is emission-only
+      if (i === 6 || i === 7) {
+        // Mirror / glass: a light tint so reflections and refractions stay bright.
+        return hslToRgb(Math.random(), 0.6 + Math.random() * 0.4, 0.86 + Math.random() * 0.1);
+      }
+      // Diffuse walls: saturated-ish colours, capped so the scene stays well behaved.
+      return hslToRgb(Math.random(), 0.45 + Math.random() * 0.5, 0.3 + Math.random() * 0.3).map((c) => Math.min(c, 0.85));
+    });
+  }
+
+  function toCss(c: number[]): string {
+    return `rgb(${c.map((v) => Math.round(Math.pow(v, 1 / 2.2) * 255)).join(',')})`;
+  }
+
+  function setup(root: HTMLElement) {
+    if (root.dataset.ready) return;
+    root.dataset.ready = '1';
+
+    const canvas = root.querySelector<HTMLCanvasElement>('#smallpt-canvas')!;
+    const ctx = canvas.getContext('2d')!;
+    const status = root.querySelector<HTMLElement>('#smallpt-status')!;
+    const progress = root.querySelector<HTMLElement>('#smallpt-progress')!;
+    const button = root.querySelector<HTMLButtonElement>('#smallpt-rerender')!;
+    const sppSelect = root.querySelector<HTMLSelectElement>('#smallpt-spp')!;
+    const swatches = root.querySelector<HTMLUListElement>('#smallpt-swatches')!;
+    const width = Number(root.dataset.width);
+    const height = Number(root.dataset.height);
+
+    const base = import.meta.env.BASE_URL;
+    const worker = new Worker(`${base}smallpt/smallpt-worker.js`);
+    let jobId = 0;
+    let colors = ORIGINAL_COLORS;
+
+    function showSwatches() {
+      swatches.innerHTML = '';
+      colors.forEach((c, i) => {
+        if (i === 3 || i === 8) return;
+        const li = document.createElement('li');
+        li.className = 'flex items-center gap-1';
+        const dot = document.createElement('span');
+        dot.className = 'inline-block w-4 h-4 rounded-full border border-gray-300';
+        dot.style.background = toCss(c);
+        li.append(dot, document.createTextNode(SPHERE_NAMES[i]));
+        swatches.append(li);
+      });
+    }
+
+    function render(newColors: number[][]) {
+      colors = newColors;
+      showSwatches();
+      const id = ++jobId;
+      const spp = Number(sppSelect.value);
+      button.disabled = true;
+      progress.style.width = '0%';
+      status.textContent = `Rendering ${width}×${height} at ${spp} samples per pixel…`;
+      ctx.fillStyle = '#000';
+      ctx.fillRect(0, 0, width, height);
+      worker.postMessage({
+        type: 'render',
+        id,
+        width,
+        height,
+        spp,
+        seed: (Math.random() * 0xffffffff) >>> 0,
+        colors: Float64Array.from(colors.flat()),
+      });
+    }
+
+    worker.onmessage = (event: MessageEvent) => {
+      const msg = event.data;
+      if (msg.type === 'ready') {
+        render(ORIGINAL_COLORS);
+      } else if (msg.type === 'rows') {
+        if (msg.id !== jobId) return;
+        const image = new ImageData(msg.data, msg.width, msg.row1 - msg.row0);
+        ctx.putImageData(image, 0, msg.row0);
+        progress.style.width = `${(msg.row1 / height) * 100}%`;
+      } else if (msg.type === 'done') {
+        if (msg.id !== jobId) return;
+        progress.style.width = '0%';
+        button.disabled = false;
+        status.textContent = `Rendered ${width}×${height} at ${sppSelect.value} spp in ${(msg.ms / 1000).toFixed(1)} s, entirely in your browser via WebAssembly.`;
+      } else if (msg.type === 'error') {
+        button.disabled = false;
+        status.textContent = `Render failed: ${msg.message}`;
+      }
+    };
+    worker.onerror = (e) => {
+      status.textContent = `Could not start the WebAssembly worker: ${e.message}`;
+    };
+
+    button.addEventListener('click', () => render(randomColors()));
+    sppSelect.addEventListener('change', () => render(colors));
+  }
+
+  function init() {
+    const root = document.getElementById('smallpt-demo');
+    if (root) setup(root);
+  }
+  init();
+  document.addEventListener('astro:page-load', init);
+</script>
