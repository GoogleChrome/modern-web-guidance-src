+++ b/public/smallpt/smallpt-worker.js
@@ -0,0 +1,55 @@
+// Web Worker that drives the smallpt WebAssembly module (smallpt.js, built from
+// wasm/smallpt/smallpt.cpp). Rendering happens here so the page stays
+// responsive; rows are streamed back to the main thread as they finish.
+//
+// Messages in:  { type: 'render', id, width, height, spp, seed, colors }
+//               colors: Float64Array of r,g,b per sphere (or null = keep)
+// Messages out: { type: 'ready', spheres }
+//               { type: 'rows', id, row0, row1, width, data }  (RGBA rows)
+//               { type: 'done', id, ms }
+//               { type: 'error', id, message }
+importScripts('./smallpt.js');
+
+const ROWS_PER_CHUNK = 6;
+let mod = null;
+let currentJob = 0;
+
+const ready = createSmallpt().then((m) => {
+  mod = m;
+  postMessage({ type: 'ready', spheres: m._smallpt_sphere_count() });
+  return m;
+});
+
+self.onmessage = async (event) => {
+  const msg = event.data;
+  if (msg.type !== 'render') return;
+  const m = await ready;
+  const id = (currentJob = msg.id);
+  try {
+    if (msg.colors) {
+      const n = m._smallpt_sphere_count() * 3;
+      const ptr = m._malloc(n * 8);
+      m.HEAPF64.set(msg.colors.subarray(0, n), ptr / 8);
+      m._smallpt_set_colors(ptr);
+      m._free(ptr);
+    }
+    const { width, height, spp, seed } = msg;
+    const pixels = m._smallpt_setup(width, height, spp, seed >>> 0);
+    const start = performance.now();
+    for (let row0 = 0; row0 < height; row0 += ROWS_PER_CHUNK) {
+      if (currentJob !== id) return; // superseded by a newer render request
+      const row1 = Math.min(height, row0 + ROWS_PER_CHUNK);
+      m._smallpt_render_rows(row0, row1);
+      // HEAPU8 may be replaced on memory growth, so re-read it each time.
+      const data = new Uint8ClampedArray(
+        m.HEAPU8.buffer.slice(pixels + row0 * width * 4, pixels + row1 * width * 4),
+      );
+      postMessage({ type: 'rows', id, row0, row1, width, data }, [data.buffer]);
+      // Yield so a newer 'render' message can cancel this job.
+      await new Promise((r) => setTimeout(r, 0));
+    }
+    if (currentJob === id) postMessage({ type: 'done', id, ms: performance.now() - start });
+  } catch (err) {
+    postMessage({ type: 'error', id, message: String(err && err.message || err) });
+  }
+};
