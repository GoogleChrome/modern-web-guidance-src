diff --git a/wasm/smallpt/README.md b/wasm/smallpt/README.md
new file mode 100644
index 0000000..c8b84a8
--- /dev/null
+++ b/wasm/smallpt/README.md
@@ -0,0 +1,15 @@
+# smallpt → WebAssembly
+
+`smallpt.cpp` is Kevin Beason's [smallpt](http://www.kevinbeason.com/smallpt/)
+path tracer with `main()` replaced by a tiny C API (`smallpt_setup`,
+`smallpt_set_colors`, `smallpt_render_rows`, `smallpt_pixels`). The rendering
+code itself is unchanged.
+
+`./build.sh` (requires Emscripten's `em++`) produces `public/smallpt/smallpt.js`,
+a single self-contained file with the `.wasm` embedded. It is loaded by
+`public/smallpt/smallpt-worker.js`, which the `SmallptDemo.astro` component
+on the home page runs in a Web Worker.
+
+Note: `-sSTACK_SIZE=16MB` is required. smallpt's `radiance()` recurses once per
+bounce and Russian roulette lets mirror/glass paths run deep; Emscripten's
+default 64 KB stack overflows.
diff --git a/wasm/smallpt/build.sh b/wasm/smallpt/build.sh
new file mode 100755
index 0000000..0fa1944
--- /dev/null
+++ b/wasm/smallpt/build.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Compiles smallpt to WebAssembly. Requires the Emscripten SDK (em++).
+# Output: public/smallpt/smallpt.js — a single self-contained file (the .wasm
+# binary is embedded) exposing a `createSmallpt()` factory, loaded from
+# public/smallpt/smallpt-worker.js.
+set -eu
+cd "$(dirname "$0")"
+OUT=../../public/smallpt/smallpt.js
+em++ -O3 -std=c++17 smallpt.cpp -o "$OUT" \
+  --no-entry \
+  -sWASM=1 \
+  -sSINGLE_FILE=1 \
+  -sMODULARIZE=1 \
+  -sEXPORT_NAME=createSmallpt \
+  -sENVIRONMENT=web,worker \
+  -sALLOW_MEMORY_GROWTH=1 \
+  -sINITIAL_MEMORY=64MB \
+  -sSTACK_SIZE=16MB \
+  -sFILESYSTEM=0 \
+  -sEXPORTED_FUNCTIONS=_smallpt_sphere_count,_smallpt_set_colors,_smallpt_setup,_smallpt_pixels,_smallpt_width,_smallpt_height,_smallpt_render_rows,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8,HEAPF64
+echo "built $OUT ($(wc -c < "$OUT") bytes)"
diff --git a/wasm/smallpt/smallpt.cpp b/wasm/smallpt/smallpt.cpp
new file mode 100644
index 0000000..724b2d4
--- /dev/null
+++ b/wasm/smallpt/smallpt.cpp
@@ -0,0 +1,155 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008  (http://www.kevinbeason.com/smallpt/)
+// WebAssembly port: the rendering code below is the original smallpt.cpp, with
+// main() replaced by a small C API (smallpt_setup / smallpt_render_rows /
+// smallpt_pixels) so the browser can drive it row-by-row from a Web Worker and
+// supply its own sphere colours.
+//
+// Build: see build.sh (em++ ... -o public/smallpt/smallpt.js)
+#include <math.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <emscripten/emscripten.h>
+
+struct Vec {
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(const Vec&b)const{return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+static const int NUM_SPHERES = sizeof(spheres)/sizeof(Sphere);
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) { if (erand48(Xi)<p) f=f*(1/p); else return obj.e; } //R.R.
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// ---------------------------------------------------------------------------
+// C API used from JavaScript (replaces the original main()).
+// ---------------------------------------------------------------------------
+static int g_w = 0, g_h = 0, g_samps = 1;
+static unsigned g_seed = 0;
+static unsigned char *g_pixels = 0;   // RGBA, g_w * g_h * 4, top row first
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int smallpt_sphere_count(){ return NUM_SPHERES; }
+
+// Replace the diffuse/reflective colour of every sphere. `colors` holds
+// 3 doubles (r,g,b in 0..1) per sphere, NUM_SPHERES spheres in scene order.
+// Emission (the light) is left untouched so the scene stays lit.
+EMSCRIPTEN_KEEPALIVE void smallpt_set_colors(const double *colors){
+  for (int i = 0; i < NUM_SPHERES; i++)
+    spheres[i].c = Vec(colors[i*3], colors[i*3+1], colors[i*3+2]);
+}
+
+// Prepare a render of a w x h image with spp = samps*4 samples per pixel.
+// Returns a pointer to the RGBA output buffer (also available via
+// smallpt_pixels()). Memory is reused across calls when the size matches.
+EMSCRIPTEN_KEEPALIVE unsigned char *smallpt_setup(int w, int h, int spp, unsigned seed){
+  if (w != g_w || h != g_h) {
+    free(g_pixels);
+    g_pixels = (unsigned char*)calloc((size_t)w * h * 4, 1);
+    g_w = w; g_h = h;
+  }
+  g_samps = spp / 4 > 0 ? spp / 4 : 1;
+  g_seed = seed;
+  return g_pixels;
+}
+
+EMSCRIPTEN_KEEPALIVE unsigned char *smallpt_pixels(){ return g_pixels; }
+EMSCRIPTEN_KEEPALIVE int smallpt_width(){ return g_w; }
+EMSCRIPTEN_KEEPALIVE int smallpt_height(){ return g_h; }
+
+// Render image rows [row0, row1) counted from the TOP of the image, writing
+// gamma-corrected RGBA into the pixel buffer. This is the body of smallpt's
+// main() loop; the row index is mapped back to smallpt's bottom-up `y`.
+EMSCRIPTEN_KEEPALIVE void smallpt_render_rows(int row0, int row1){
+  int w = g_w, h = g_h, samps = g_samps;
+  if (!g_pixels || w <= 0 || h <= 0) return;
+  if (row0 < 0) row0 = 0; if (row1 > h) row1 = h;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+  for (int row = row0; row < row1; row++){
+    int y = h - 1 - row;                             // smallpt's row index
+    unsigned short Xi[3]={ (unsigned short)g_seed, (unsigned short)(g_seed>>16),
+                           (unsigned short)(y*y*y) };
+    for (unsigned short x=0; x<w; x++){                          // Loop cols
+      Vec c;
+      for (int sy=0; sy<2; sy++)                     // 2x2 subpixel rows
+        for (int sx=0; sx<2; sx++, r=Vec()){         // 2x2 subpixel cols
+          for (int s=0; s<samps; s++){
+            double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+            double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+            Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                    cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+          } // Camera rays are pushed ^^^^^ forward to start in interior
+          c = c + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+        }
+      unsigned char *px = g_pixels + ((size_t)row * w + x) * 4;
+      px[0] = toInt(c.x); px[1] = toInt(c.y); px[2] = toInt(c.z); px[3] = 255;
+    }
+  }
+}
+
+} // extern "C"
